---
import { ClientRouter } from 'astro:transitions';
import SanctuaryGame from '../../components/SanctuaryGame.astro';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Заповедный Лес: Тайны Древней Рощи | 3D Игра | Моррис Град</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ClientRouter />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;800;900&display=swap" rel="stylesheet">
    <script is:inline src="/js/three.min.js"></script>
    <script is:inline src="/js/OrbitControls.js"></script>
    <script is:inline src="/js/GLTFLoader.js"></script>
    <style>
      *, *::before, *::after {
        box-sizing: border-box;
      }
      html, body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        background-color: #06090e;
        font-family: 'Cinzel', system-ui, -apple-system, sans-serif;
      }
      #game-wrapper {
        width: 100%;
        height: 100%;
        display: flex;
        flex-direction: column;
        position: relative;
      }
      .top-nav {
        position: absolute;
        top: 12px;
        left: 15px;
        z-index: 1000;
        pointer-events: auto;
      }
      .back-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #ffd700;
        text-decoration: none;
        font-size: 0.85rem;
        font-weight: 800;
        background: rgba(15, 23, 42, 0.85);
        border: 1.5px solid rgba(212, 175, 55, 0.6);
        padding: 6px 14px;
        border-radius: 20px;
        backdrop-filter: blur(6px);
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.5);
        transition: all 0.2s;
        letter-spacing: 0.5px;
      }
      .back-link:hover {
        color: #fff;
        border-color: #ffd700;
        box-shadow: 0 0 15px rgba(255, 215, 0, 0.5);
        transform: translateY(-1px);
      }
    </style>
  </head>
  <body>
    <div id="game-wrapper">
      <SanctuaryGame />
    </div>
  </body>
</html>
