---
import SeoHead from '../../components/seo/SeoHead.astro';
import CrateClickerGame from '../../components/CrateClickerGame.astro';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Ящик: 3D Кликер-RPG | Моррис Град</title>
    <SeoHead title="Ящик: 3D Кликер-RPG | Моррис Град" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@600;800;900&display=swap" rel="stylesheet">
    <script is:inline src="/js/three.min.js"></script>
    <style>
      *, *::before, *::after { box-sizing: border-box; }
      html, body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        background-color: #07050a;
        overscroll-behavior: none;
      }
      .top-nav {
        position: fixed;
        top: 10px;
        left: 12px;
        z-index: 1000;
      }
      .back-link {
        display: inline-flex;
        align-items: center;
        color: #f6efe8;
        text-decoration: none;
        font: 700 0.85rem system-ui, -apple-system, sans-serif;
        background: rgba(16, 12, 13, 0.82);
        border: 1px solid rgba(224, 177, 90, 0.45);
        padding: 6px 12px;
        border-radius: 20px;
      }
      .back-link:hover { color: #e0b15a; border-color: #e0b15a; }
    </style>
  </head>
  <body>
    <CrateClickerGame />
    <nav class="top-nav">
      <a href="/games" class="back-link">← К мини-играм</a>
    </nav>
  </body>
</html>
