---
const gameUrl = "https://cherta-kupola.alexseylyou.workers.dev";
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Черта купола | Моррис Град</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style>
      *, *::before, *::after { box-sizing: border-box; }
      html, body {
        margin: 0;
        padding: 0;
        width: 100%;
        height: 100%;
        overflow: hidden;
        background: #100c0d;
        font-family: system-ui, -apple-system, sans-serif;
      }
      .stage {
        position: fixed;
        inset: 0;
      }
      iframe {
        width: 100%;
        height: 100%;
        border: 0;
        background: #100c0d;
      }
      .top-nav {
        position: absolute;
        top: 10px;
        left: 12px;
        z-index: 5;
        display: flex;
        gap: 8px;
      }
      .back-link, .fill-btn {
        display: inline-flex;
        align-items: center;
        color: #f6efe8;
        text-decoration: none;
        font-size: 0.85rem;
        font-weight: 700;
        background: rgba(16, 12, 13, 0.82);
        border: 1px solid rgba(224, 177, 90, 0.45);
        padding: 6px 12px;
        border-radius: 20px;
        cursor: pointer;
      }
      .back-link:hover, .fill-btn:hover {
        color: #e0b15a;
        border-color: #e0b15a;
      }
    </style>
  </head>
  <body>
    <div class="stage" id="stage">
      <nav class="top-nav">
        <a href="/games" class="back-link">← К мини-играм</a>
        <button type="button" class="fill-btn" id="fill">На весь экран</button>
      </nav>
      <iframe
        title="Черта купола"
        src={gameUrl}
        allow="fullscreen; autoplay"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
    <script>
      document.getElementById("fill")?.addEventListener("click", () => {
        const stage = document.getElementById("stage");
        if (!stage) return;
        if (document.fullscreenElement) document.exitFullscreen();
        else stage.requestFullscreen?.();
      });
    </script>
  </body>
</html>
