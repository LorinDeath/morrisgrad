---
// «Партия Чёрных королей» — пошаговая стратегия на доске. Логика — server/strat (StratMatch DO + StratIndex),
// клиент — src/scripts/strat/client.ts. Оформление — арт-деко «комикс C» по UI-набору Художника (public/strat/ui, ui-v1).
import SeoHead from '../../components/seo/SeoHead.astro';
import '../../styles/strat-ui.css';
const title = 'Партия Чёрных королей | Моррис Град';
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{title}</title>
  <SeoHead title={title} description="Пошаговая стратегия на доске: шесть рас, Вождь, города и технологии. Играйте с другом по ссылке или с ботом." />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preload" href="/strat/fonts/oswald-cyrillic-700-normal.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/strat/fonts/playfair-display-cyrillic-900-normal.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body data-screen="home">
<div class="app">
  <header class="gtop">
    <a class="back btn ghost sm" href="/games"><svg class="ic" aria-hidden="true"><use href="#i-back"/></svg><span>Мини-игры</span></a>
    <div class="logo"><img src="/strat/ui/ornaments/ornament_fan.png" alt="" /><h1>Партия Чёрных королей</h1></div>
    <span id="me" class="who"></span>
  </header>

  <!-- ===== главное меню ===== -->
  <section id="home" class="home">
    <div class="hero">
      <div class="hero-crests">
        <img src="/strat/ui/crests/crest_fire.png" alt="" /><img src="/strat/ui/crests/crest_ice.png" alt="" /><img src="/strat/ui/crests/crest_water.png" alt="" />
        <img src="/strat/ui/crests/crest_stone.png" alt="" /><img src="/strat/ui/crests/crest_nature.png" alt="" /><img src="/strat/ui/crests/crest_lightning.png" alt="" />
      </div>
      <p class="tagline">Шесть рас. Один Вождь. Три цели из пяти — и корона ваша.</p>
      <img class="divider" src="/strat/ui/ornaments/divider_ornate.png" alt="" />
    </div>
    <div id="resume" class="panel resume" hidden></div>
    <div class="menu-grid">
      <div class="panel newgame">
        <h2 class="plate">Новая партия</h2>
        <label class="fld"><span>Поле</span>
          <select id="size"><option value="8" selected>8×8 — быстрая</option><option value="15">15×15 — большая</option><option value="5">5×5 — дуэль</option></select></label>
        <label class="chk"><input type="checkbox" id="pub" checked /><span>Показывать лобби в общем списке</span></label>
        <button class="btn gold big" id="create"><svg class="ic" aria-hidden="true"><use href="#i-crown"/></svg><span>Создать лобби</span></button>
        <img class="divider sm" src="/strat/ui/ornaments/divider_h.png" alt="" />
        <h3 class="deco-h"><span>Войти по коду</span></h3>
        <div class="joinrow"><input id="joincode" maxlength="6" placeholder="КОД" autocomplete="off" spellcheck="false" /><button class="btn" id="joinbtn"><span>Войти</span></button></div>
        <label class="fld"><span>Имя для игры гостем</span><input id="nick" maxlength="24" placeholder="необязательно" autocomplete="nickname" /></label>
        <button class="btn ghost" id="topbtn"><svg class="ic" aria-hidden="true"><use href="#i-glory"/></svg><span>Таблицы лиг</span></button>
        <button class="btn ghost" id="rulesbtn"><svg class="ic" aria-hidden="true"><use href="#i-book"/></svg><span>Правила</span></button>
      </div>
      <div class="panel lobbies">
        <h2 class="plate">Ждут соперника</h2>
        <button class="btn sq ghost refresh" id="refresh" aria-label="Обновить"><svg class="ic" aria-hidden="true"><use href="#i-refresh"/></svg></button>
        <div id="open" class="openlist"></div>
        <h3 class="deco-h"><span>Сейчас на странице</span></h3>
        <div id="online" class="onlinelist"></div>
      </div>
    </div>
  </section>

  <!-- ===== лобби и партия ===== -->
  <section id="match" hidden>
    <div id="lobby" class="lobby">
      <div class="panel lobby-h">
        <div class="codewrap"><small>Код лобби</small><b class="codebox" id="code"></b></div>
        <p id="status" class="status"></p>
        <div class="lh-btns"><button class="btn" id="copy"><svg class="ic" aria-hidden="true"><use href="#i-copy"/></svg><span>Ссылка</span></button>
          <button class="btn ghost" id="leave"><svg class="ic" aria-hidden="true"><use href="#i-back"/></svg><span>Выйти</span></button></div>
      </div>
      <div id="modes" class="modes panel"></div>
      <div id="slots" class="seats"></div>
      <div class="panel racepick">
        <h2 class="plate">Выберите расу</h2>
        <p class="muted center">Соперник увидит вашу расу только на старте партии.</p>
        <div id="races" class="races"></div>
        <div id="chiefpick" class="chiefpick" hidden></div>
      </div>
      <div class="panel hostpanel" id="hostpanel">
        <h2 class="plate">Настройки партии</h2>
        <div class="hp-grid">
          <div>
            <div class="rankrow"><label class="chk tog"><input type="checkbox" id="ranked" /><span>Рейтинговая</span></label><span id="league" class="league"></span></div>
            <h3 class="deco-h"><span>Размер поля</span></h3>
            <div id="sizes" class="sizes"></div>
            <label class="fld inline"><span>Свой размер</span><input id="csize" type="number" min="4" max="100" step="1" inputmode="numeric" /></label>
            <label class="fld inline"><span>Лимит ходов</span><select id="tl"><option value="">по умолчанию</option><option value="10">10</option><option value="15">15</option><option value="20">20</option><option value="25">25</option><option value="30">30</option><option value="40">40</option></select></label>
            <label class="fld inline"><span>Время на ход</span><select id="tsec"><option value="">по размеру карты</option><option value="60">1 мин</option><option value="120">2 мин</option><option value="180">3 мин</option><option value="300">5 мин</option><option value="600">10 мин</option><option value="900">15 мин</option><option value="1200">20 мин</option><option value="1800">30 мин</option></select></label>
            <div id="sizeinfo" class="sizeinfo"></div>
            <button class="btn" id="bot"><svg class="ic" aria-hidden="true"><use href="#i-user"/></svg><span>Играть с ботом</span></button>
          </div>
          <div>
            <h3 class="deco-h"><span>Карта</span></h3>
            <div id="maps" class="maps"></div>
          </div>
          <div class="mapview">
            <div class="pvframe"><canvas id="mappv" width="300" height="300"></canvas></div>
            <b id="mapname0" class="mapname0"></b>
            <span class="xpbadge" id="mapbadge" hidden>карта не проверена — без опыта</span>
            <div id="mapdesc" class="schips"></div>
          </div>
        </div>
      </div>
      <div class="readybar"><button class="btn gold big" id="ready"><svg class="ic" aria-hidden="true"><use href="#i-flag"/></svg><span>Готов к бою</span></button></div>
    </div>

    <div id="play" class="game" hidden>
      <div class="topbar">
        <button class="btn sq" id="menubtn" aria-label="Меню"><svg class="ic" aria-hidden="true"><use href="#i-menu"/></svg></button>
        <div id="ecbar" class="ecbar" hidden></div>
        <div class="apbox" data-tip="Очки действий: каждое действие фигуры или города тратит 1 ОД"><span class="lbl">ОД</span><span id="appips" class="appips"></span><b id="aptxt"></b></div>
        <div class="turnplate"><span>Ход</span><b id="turnno"></b></div>
        <div id="clock" class="clock"></div>
      </div>
      <div class="stagewrap">
        <div id="stage" class="stage">
          <canvas id="board" aria-label="Игровая доска"></canvas>
          <div id="turnbanner" class="turnbanner" aria-live="polite"></div>
          <div id="hint" class="hint" hidden></div>
          <div id="checkwarn" class="checkwarn" hidden><svg class="ic" aria-hidden="true"><use href="#i-warn"/></svg><span>Вождь под ударом!</span></div>
          <div id="camctl" class="camctl" hidden>
            <button class="btn sq" id="zin" aria-label="Приблизить" data-tip="Приблизить"><svg class="ic" aria-hidden="true"><use href="#i-plus"/></svg></button>
            <button class="btn sq" id="zout" aria-label="Отдалить" data-tip="Отдалить"><span class="minus">−</span></button>
            <button class="btn sq" id="zfit" aria-label="Вся карта" data-tip="Вся карта"><svg class="ic" aria-hidden="true"><use href="#i-map"/></svg></button>
            <button class="btn sq" id="cenking" aria-label="К Вождю" data-tip="К Вождю"><svg class="ic" aria-hidden="true"><use href="#i-crown"/></svg></button>
            <button class="btn sq" id="cencity" aria-label="К городу" data-tip="К городу (по кругу)"><svg class="ic" aria-hidden="true"><use href="#i-castle"/></svg></button>
          </div>
          <div id="minimapbox" class="minimapbox" hidden><canvas id="minimap" width="180" height="180" aria-label="Мини-карта"></canvas></div>
          <div id="log" class="log" aria-live="polite"></div>
          <button type="button" class="chatfab" id="chatfab" hidden aria-label="Чат"><svg class="ic" aria-hidden="true"><use href="#i-chat"/></svg><b class="chat-unread" hidden></b></button>
          <div class="maptag"><span id="mapname"></span><span class="xpbadge" id="mapbadge2" hidden>без опыта</span></div>
        </div>
      </div>
      <aside class="side">
        <div id="score" class="score"></div>
        <div id="chief" class="chief"></div>
        <div id="info" class="info"></div>
        <div id="lvdock" class="lvdock" hidden></div>
        <div id="goals" class="goals"></div>
        <div class="viewrow">
          <button class="btn sm" id="pstyle"><svg class="ic" aria-hidden="true"><use href="#i-eye"/></svg><span>Фигуры ⇄ фишки</span></button>
          <label class="chk sm"><input type="checkbox" id="pbadge" /><span>значки</span></label>
        </div>
        <section id="chat" class="chat" hidden aria-label="Чат партии">
          <button type="button" class="chat-h" id="chathead"><svg class="ic" aria-hidden="true"><use href="#i-chat"/></svg><span>Чат</span><b class="chat-unread" hidden></b><span class="ctabs"><span role="button" tabindex="0" data-ctab="all" class="on">Все</span><span role="button" tabindex="0" data-ctab="team" hidden>Союз</span><span role="button" tabindex="0" data-ctab="w">Шёпот</span></span><svg class="ic chev" aria-hidden="true"><use href="#i-chevron"/></svg></button>
          <div class="chat-b">
            <div id="chatlog" class="chatlog" aria-live="polite"></div>
            <form id="chatform" class="chatform" autocomplete="off"><div id="chatac" class="chatac"></div><input id="chatin" placeholder="Сообщение · /w Имя текст — шёпот" spellcheck="false" /><button class="btn sq" type="submit" aria-label="Отправить"><svg class="ic" aria-hidden="true"><use href="#i-play"/></svg></button></form>
          </div>
        </section>
        <div class="endzone">
          <div id="turnbox" class="turnbox"><span id="turnwho"></span></div>
          <button class="endturn" id="end"><span>Конец хода</span></button>
          <small id="endsub" class="endsub"></small>
          <div class="endbtns">
            <button class="btn sm claim" id="claim" hidden><svg class="ic" aria-hidden="true"><use href="#i-warn"/></svg><span>Соперник не за столом — завершить</span></button>
            <button class="btn ghost sm" id="forfeit"><svg class="ic" aria-hidden="true"><use href="#i-flag"/></svg><span>Сдаться</span></button>
            <button class="btn gold sm" id="rematch" hidden><svg class="ic" aria-hidden="true"><use href="#i-refresh"/></svg><span>Реванш</span></button>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <!-- панель модерации: монтируется клиентом из шаблона только для админа (сервер: roles.isAdmin) и только в меню/лобби -->
  <div id="adminslot"></div>
  <template id="admintpl">
    <div class="panel admin" id="admin">
      <h2 class="plate">Модерация карт</h2>
      <button class="btn sq ghost refresh" id="modrefresh" aria-label="Обновить"><svg class="ic" aria-hidden="true"><use href="#i-refresh"/></svg></button>
      <p class="muted">Карты игроков попадают в общий список только после одобрения. До этого автор играет на них по ссылке или коду, без опыта.</p>
      <div id="modq"></div>
    </div>
  </template>

  <div id="rulestext" hidden>
    <div class="rules">
      <h4 class="deco-h"><span>Победа</span></h4>
      <p>Побеждает тот, кто первым выполнит <b>3 цели из 5</b>: сразить вражеского Вождя, взять его столицу, набрать порог Славы, возвести Великое чудо, изучить финальную технологию III эпохи. Выполненная цель остаётся засчитанной.</p>
      <h4 class="deco-h"><span>Ход</span></h4>
      <ul>
        <li>За ход — несколько <b>очков действий</b> (ОД). Каждая фигура и каждый город действуют раз за ход.</li>
        <li>Удар снимает HP (атака − броня). Добив врага вплотную, фигура встаёт на его клетку.</li>
        <li>Ополченец ходит на 1 вперёд или вбок и бьёт по диагонали вперёд; дойдя до края, становится Конём, Магом или Ладьёй. Конь прыгает буквой «Г», Маг стреляет на 2 клетки, Ладья ходит по прямым до 4, Герой — в любую сторону до 3.</li>
      </ul>
      <h4 class="deco-h"><span>Вождь</span></h4>
      <ul><li>Вождь набирает опыт, растёт до 5-го уровня и выбирает навыки в древе. Если он пал — новый Вождь родится через несколько ходов, а пока у вас на 1 ОД меньше.</li></ul>
      <h4 class="deco-h"><span>Города и технологии</span></h4>
      <ul><li>Города приносят золото и знания, нанимают фигуры и строят здания. Технологии открывают новые здания и бойцов; выбор одной ветви навсегда закрывает соседнюю.</li></ul>
      <h4 class="deco-h"><span>Местность</span></h4>
      <ul><li><b>Река</b> непроходима, кроме мостов; <b>стены</b> и <b>горы</b> закрывают путь и обстрел; <b>лес</b> даёт броню; <b>башня</b> — ещё больше брони; <b>колодец</b> лечит в начале вашего хода. Наведите на значок пассивки — увидите точные числа.</li></ul>
      <h4 class="deco-h"><span>Время</span></h4>
      <ul><li>На ход — таймер и общий запас времени. Не успели — ход передаётся сам.</li></ul>
    </div>
  </div>
</div>
<div id="tip" class="tip" role="tooltip"></div>
<div id="toasts" class="toasts" aria-live="polite"></div>
<div id="modals"></div>
<script>
  import { boot } from '../../scripts/strat/client';
  boot();
</script>
</body>
</html>
