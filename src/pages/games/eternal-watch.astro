---
// «Вечная стража» — клиентская мини-игра. Без входа, без API, без worker.
import SeoHead from '../../components/seo/SeoHead.astro';
const title = 'Вечная стража | Моррис Град';
const description = 'Ночь у Врат искры: пиксельные башни на неоновой сетке, опыт, древо и десять режимов.';
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover" />
  <title>{title}</title>
  <SeoHead title={title} description={description} image="/games/eternal-watch/cover.png" imageAlt="Вечная стража — неон над тёмной сеткой у Врат искры" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="theme-color" content="#070b16" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <link rel="preload" href="/fonts/Shket-Regular.otf" as="font" type="font/otf" crossorigin />
  <style is:global>
    @font-face {
      font-family: "Shket";
      src: url("/fonts/Shket-Regular.otf") format("opentype");
      font-display: swap;
    }
    *, *::before, *::after { box-sizing: border-box; }
    html, body {
      margin: 0;
      width: 100%;
      max-width: 100%;
      background: #070b16;
      color: #d7e7ff;
      font-family: "Exo 2", system-ui, sans-serif;
      overflow: hidden;
    }
    body {
      height: 100dvh;
      min-height: 100dvh;
    }
    button, a { -webkit-tap-highlight-color: transparent; }
    #ew-app {
      width: 100%;
      max-width: 100%;
      min-width: 0;
      height: 100dvh;
      min-height: 100dvh;
      overflow: hidden;
      display: grid;
      grid-template-rows: auto auto minmax(42dvh, 1fr) auto;
      padding:
        env(safe-area-inset-top)
        env(safe-area-inset-right)
        env(safe-area-inset-bottom)
        env(safe-area-inset-left);
    }
    #ew-app > * { min-width: 0; max-width: 100%; }
    #ew-app:not(.in-battle) .battle-hud { display: none; }
    #ew-app:not(.in-battle) #ew-dock { display: none; }
    .top {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 6px 10px 0;
      min-height: 36px;
      min-width: 0;
      max-width: 100%;
    }
    .top a { color: #8ecbff; text-decoration: none; font-weight: 700; }
    .top h1 {
      margin: 0;
      flex: 1;
      text-align: center;
      font-family: Shket, Cinzel, Georgia, serif;
      font-weight: 400;
      font-size: clamp(1.15rem, 3vw, 1.6rem);
      letter-spacing: 0.04em;
      color: #e7f6ff;
    }
    .hud { display: flex; flex-direction: column; gap: 2px; padding: 2px 8px 4px; min-width: 0; max-width: 100%; }
    .battle-hud, .meta-hud, .speeds, .hud-acts {
      display: flex; flex-wrap: wrap; align-items: center; gap: 4px;
      min-width: 0; max-width: 100%;
    }
    .battle-hud { flex-wrap: wrap; gap: 4px; }
    #ew-fight, #ew-res { flex-wrap: nowrap; gap: 6px; overflow: hidden; }
    .meta-hud { justify-content: flex-start; }
    .battle-acts { display: flex; flex-wrap: nowrap; align-items: center; gap: 4px; min-width: 0; max-width: 100%; }
    .hud-acts { margin-left: auto; }
    #ew-menu { display: none; }
    #ew-fight, #ew-res {
      display: flex; flex-wrap: nowrap; gap: 6px; min-width: 0; max-width: 100%;
      font-weight: 700; font-variant-numeric: tabular-nums;
    }
    #ew-fight b { color: #ffe1a3; }
    #ew-res b { color: #9ad7ff; font-weight: 700; }
    .icon-btn {
      width: 36px;
      min-width: 36px;
      min-height: 36px;
      padding: 0;
      display: grid;
      place-items: center;
    }
    .icon-btn img { width: 20px; height: 20px; }
    #ew-globals {
      position: absolute;
      top: 8px;
      right: 8px;
      z-index: 3;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    #ew-app:not(.in-battle) #ew-globals { display: none !important; }
    #ew-globals .ability {
      position: relative;
      width: 46px;
      height: 46px;
      min-width: 46px;
      min-height: 46px;
      padding: 0;
      border-radius: 50%;
      display: grid;
      place-items: center;
      background: rgba(8, 16, 32, 0.9);
    }
    #ew-globals .ability img { width: 26px; height: 26px; margin: 0; }
    #ew-globals .ability .ring {
      position: absolute;
      inset: -2px;
      border-radius: 50%;
      background: conic-gradient(#7ee0ff var(--p), rgba(126, 224, 255, 0.18) 0);
      -webkit-mask: radial-gradient(circle, transparent 60%, #000 63%);
      mask: radial-gradient(circle, transparent 60%, #000 63%);
      pointer-events: none;
    }
    #ew-globals .ability.cooling { opacity: 0.5; }
    .announce {
      flex: 1 0 100%;
      margin: 0;
      padding: 3px 10px;
      border: 1px solid #e0b15a;
      background: #1a1408;
      color: #fff4d2;
      font: 700 0.82rem/1.3 system-ui, sans-serif;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .announce[hidden] { display: none !important; }
    button {
      appearance: none;
      border: 1px solid rgba(120, 190, 255, 0.45);
      background: rgba(8, 16, 32, 0.9);
      color: #e7f3ff;
      font: 700 0.78rem/1.2 system-ui, sans-serif;
      min-height: 36px;
      padding: 6px 8px;
      cursor: pointer;
      max-width: 100%;
    }
    button.on {
      border-color: #9aefff;
      box-shadow: inset 0 0 0 1px #7ee0ff, 0 0 12px rgba(126, 224, 255, 0.28);
      background: #123044;
      color: #f4fbff;
    }
    button:hover { border-color: #d7f6ff; }
    button:disabled { opacity: 0.45; cursor: default; }
    button img, .chip img {
      width: 28px;
      height: 28px;
      image-rendering: pixelated;
      image-rendering: crisp-edges;
      pointer-events: none;
      flex-shrink: 0;
    }
    .chip {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      min-height: 28px;
      padding: 0 2px;
      font-variant-numeric: tabular-nums;
    }
    .chip b { color: #ffe1a3; }
    .chip span { display: none; }
    .chip img { width: 20px; height: 20px; }
    .main {
      min-height: 0;
      min-width: 0;
      max-width: 100%;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      position: relative;
      overflow: hidden;
    }
    #ew-app.panel-open .main { grid-template-columns: minmax(0, 1fr) minmax(260px, 320px); }
    .stage {
      position: relative;
      min-width: 0;
      min-height: 0;
      height: 100%;
      overflow: hidden;
      background: #070b16;
    }
    .panel {
      overflow-x: hidden;
      overflow-y: auto;
      background: #0b1426;
      border-left: 1px solid rgba(120, 190, 255, 0.28);
      padding: 10px 12px 16px;
      min-height: 0;
      min-width: 0;
      max-height: 100%;
    }
    @media (min-width: 801px) {
      #ew-app.panel-open .panel { height: 100%; }
    }
    .panel[hidden] { display: none !important; }
    .xp {
      height: 8px; border-radius: 99px; background: #172033; overflow: hidden; margin: 6px 0 8px;
    }
    .xp span { display: block; height: 100%; background: linear-gradient(90deg, #3ee0ff, #ffe08a); }
    .ability-card {
      display: block; width: 100%; text-align: left; margin: 0 0 6px; min-height: 64px;
    }
    .ability-card b { display: block; font-family: Shket, Georgia, serif; font-weight: 400; font-size: 1.05rem; }
    .ability-card span { display: block; font-weight: 500; color: #c5d7ee; }
    #ew-preview {
      position: relative;
      inset: auto;
      width: 100%;
      height: 150px;
      display: block;
      background: #070b16;
      margin: 6px 0 8px;
      border: 1px solid rgba(120, 190, 255, 0.25);
    }
    canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      display: block;
      touch-action: none;
      background: #070b16;
    }
    #ew-dock {
      padding: 6px 8px 8px;
      background: #0a1222;
      border-top: 1px solid rgba(120, 190, 255, 0.28);
      min-width: 0;
      max-width: 100%;
      overflow: hidden;
    }
    .dock { display: flex; gap: 6px; overflow-x: auto; max-width: 100%; min-width: 0; padding-bottom: 2px; }
    .dock button {
      flex: 0 0 92px;
      width: 92px;
      min-height: 84px;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: 2px;
      position: relative;
    }
    .dock button img.lock {
      position: absolute;
      top: 4px;
      right: 4px;
      width: 16px;
      height: 16px;
    }
    .dock-handle {
      display: none;
      width: 44px;
      min-width: 44px;
      min-height: 22px;
      height: 22px;
      margin: 0 auto 2px;
      padding: 0;
      line-height: 1;
      color: #9ad7ff;
    }
    #ew-app.dock-collapsed .dock { display: none; }
    .swatch { width: 18px; height: 18px; border-radius: 50%; box-shadow: 0 0 10px currentColor; }
    .dock button small { font-weight: 600; color: #9ad7ff; }
    .dock button.locked { opacity: 0.55; }
    .panel h2, .panel h3 {
      margin: 0 0 4px;
      font-family: Shket, Georgia, serif;
      font-weight: 400;
      color: #e7f6ff;
    }
    .panel p { margin: 0 0 4px; color: #c5d7ee; font-size: 0.92rem; }
    .statgrid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4px 10px;
      margin: 6px 0 8px;
      font-size: 0.86rem;
    }
    .statgrid b { display: block; color: #8eb4d8; font-weight: 600; font-size: 0.72rem; }
    .statgrid span { color: #f2f7ff; font-weight: 700; }
    .sheet-toggle { display: none; margin: 0 0 8px; }
    .acts { display: flex; flex-wrap: wrap; gap: 6px; }
    #ew-tip {
      position: fixed;
      z-index: 30;
      max-width: min(340px, calc(100vw - 16px));
      padding: 8px 10px;
      background: rgba(6, 10, 20, 0.96);
      border: 1px solid #7ee0ff;
      color: #e7f3ff;
      font-size: 0.82rem;
      line-height: 1.35;
      white-space: pre-line;
      pointer-events: none;
    }
    #ew-tip[hidden] { display: none !important; }
    #ew-overlay {
      position: absolute;
      inset: 0;
      z-index: 4;
      overflow: auto;
      padding: 12px 12px 20px;
      background: rgba(5, 8, 16, 0.94);
    }
    #ew-overlay[hidden] { display: none !important; }
    .mode-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
      gap: 10px;
      max-width: 1080px;
      margin: 0 auto;
    }
    .mode-intro {
      grid-column: 1 / -1;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px 12px;
    }
    .mode-intro h2 {
      margin: 0;
      font-family: Shket, Georgia, serif;
      font-weight: 400;
      font-size: 1.6rem;
    }
    .mode-intro p { margin: 0; flex: 1 1 220px; color: #c5d7ee; }
    .mode-card {
      display: grid;
      grid-template-columns: 56px 1fr;
      grid-template-rows: auto auto auto;
      gap: 2px 10px;
      text-align: left;
      min-height: 112px;
      align-items: center;
    }
    .mode-card img { width: 56px; height: 56px; grid-row: 1 / span 3; }
    .mode-card b { font-family: Shket, Georgia, serif; font-weight: 400; font-size: 1.15rem; }
    .mode-card span { color: #c5d7ee; font-weight: 500; font-size: 0.82rem; }
    .mode-card small { color: #9ad7ff; font-weight: 700; }
    .tower-head { display: flex; align-items: center; gap: 10px; margin-bottom: 6px; }
    .tower-head img { width: 56px; height: 56px; image-rendering: pixelated; }
    .tower-head h2 { margin: 0; }
    .ability img { width: 22px; height: 22px; margin-right: 4px; }
    .toast {
      position: absolute;
      left: 50%;
      bottom: 10px;
      top: auto;
      transform: translateX(-50%);
      margin: 0;
      padding: 6px 10px;
      background: rgba(6, 10, 20, 0.92);
      border: 1px solid rgba(126, 224, 255, 0.7);
      z-index: 5;
      pointer-events: none;
    }
    .toast[hidden] { display: none !important; }
    @media (max-width: 900px) {
      #ew-menu { display: inline-flex; }
      .hud-acts { display: none; margin-left: 0; flex-basis: 100%; }
      #ew-app.nav-open .hud-acts { display: flex; }
    }
    @media (max-width: 800px) {
      #ew-app.panel-open .main {
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: minmax(0, 1fr) auto;
      }
      #ew-app.panel-open .panel {
        position: relative;
        left: auto; right: auto; bottom: auto;
        max-height: min(45dvh, 340px);
        border-left: 0;
        border-top: 1px solid rgba(120, 190, 255, 0.35);
      }
      .top { min-height: 26px; padding: 1px 8px 0; }
      .hud { gap: 2px; padding: 1px 6px 2px; }
      button { min-height: 36px; padding: 4px 7px; }
      .icon-btn { min-height: 36px; }
      #ew-fight, #ew-res { font-size: 0.78rem; gap: 4px 6px; }
      .dock button { min-height: 64px; }
      .dock-handle { display: grid; place-items: center; }
      #ew-app.panel-open.sheet-collapsed .panel { max-height: 52px; overflow: hidden; padding-top: 6px; padding-bottom: 6px; }
      .sheet-toggle { display: inline-flex; width: 100%; }
      .top h1 { font-size: 1.05rem; }
      .dock button { width: 84px; flex-basis: 84px; }
      .ability { min-width: 0; }
    }
    @media (max-height: 520px) {
      .top { min-height: 24px; padding-top: 0; }
      .top h1 { font-size: 1rem; }
      button { min-height: 34px; padding: 3px 6px; }
      .dock button { min-height: 56px; width: 76px; flex-basis: 76px; }
      .dock button img { width: 22px; height: 22px; }
      #ew-dock { padding: 2px 6px 4px; }
    }
  </style>
</head>
<body>
  <div id="ew-app">
    <header class="top">
      <a href="/games" data-tip="Вернуться к списку мини-игр.">← Мини-игры</a>
      <h1>Вечная стража</h1>
    </header>
    <div class="hud" id="ew-hud">
      <div class="battle-hud">
        <div id="ew-fight"></div>
        <div class="battle-acts">
          <button type="button" class="icon-btn" id="ew-call" data-tip="Вызвать следующую волну сразу, не дожидаясь таймера. Пока волна ещё выходит из портала, вызов ждёт.">Волна</button>
          <div class="speeds">
            <button type="button" class="icon-btn" id="ew-pause" data-tip="Пауза. Ночь стоит на месте, башни можно ставить и улучшать. Перезарядка умений не идёт.">Пауза</button>
            <button type="button" class="icon-btn" id="ew-x1" data-tip="Обычная скорость ночи, 1×.">1×</button>
            <button type="button" class="icon-btn" id="ew-x2" data-tip="Ускорить ночь вдвое, 2×.">2×</button>
            <button type="button" class="icon-btn" id="ew-x4" data-tip="Ускорить ночь вчетверо, 4×.">4×</button>
          </div>
        </div>
        <p id="ew-banner" class="announce" hidden></p>
      </div>
      <div class="meta-hud">
        <div id="ew-res"></div>
        <button type="button" id="ew-menu" data-tip="Показать или спрятать переходы: цифры урона, древо, бесконечная ночь и карта.">Ещё</button>
        <div class="hud-acts">
          <button type="button" id="ew-nums" data-tip="Показывать или прятать цифры урона над тварями.">Цифры</button>
          <button type="button" id="ew-tree" data-tip="Открыть древо. Искры, пепел и руда тратятся здесь и не сгорают между ночами.">Древо</button>
          <button type="button" id="ew-endless" data-tip="Бесконечная ночь на уже открытых картах. Рекорд волны хранится на этом устройстве, без таблицы лидеров.">Бесконечная</button>
          <button type="button" id="ew-world" data-tip="Карта ночей кампании. Следующая ночь открывается после хотя бы одной звезды.">Карта</button>
          <button type="button" id="ew-modes" data-tip="Десять режимов: блиц, парад боссов, пять башен, лабиринт, туман, два потока, одна жизнь, испытание дня, хаос и песочница. У каждого свой рекорд на этом устройстве.">Режимы</button>
        </div>
      </div>
    </div>
    <div class="main" id="ew-main">
      <div class="stage" id="ew-stage">
        <canvas id="ew-canvas" aria-label="Тёмная сетка у Врат искры"></canvas>
        <div id="ew-globals"></div>
        <p class="toast" id="ew-toast" hidden></p>
        <div id="ew-overlay" hidden></div>
      </div>
      <aside class="panel" id="ew-panel" hidden></aside>
    </div>
    <div id="ew-dock" hidden></div>
  </div>
  <p id="ew-tip" hidden></p>
  <noscript><p>Для игры нужен JavaScript. Вход не требуется.</p></noscript>
  <script>
    import '../../scripts/eternal-watch/client';
  </script>
</body>
</html>
