---
// «Вечная стража» — клиентская мини-игра. Без входа, без API, без worker.
import SeoHead from '../../components/seo/SeoHead.astro';
const title = 'Вечная стража | Моррис Град';
const description = 'Ночь у Врат искры: свободная сетка, опыт башен и древо, которое не сгорает.';
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover" />
  <title>{title}</title>
  <SeoHead title={title} description={description} image="/games/eternal-watch/cover.png" imageAlt="Вечная стража — неон над тёмной сеткой у Врат искры" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="theme-color" content="#070b16" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <link rel="preload" href="/fonts/Shket-Regular.otf" as="font" type="font/otf" crossorigin />
  <style is:global>
    @font-face {
      font-family: "Shket";
      src: url("/fonts/Shket-Regular.otf") format("opentype");
      font-display: swap;
    }
    *, *::before, *::after { box-sizing: border-box; }
    html, body {
      margin: 0;
      background: #070b16;
      color: #d7e7ff;
      font-family: "Exo 2", system-ui, sans-serif;
    }
    body {
      height: 100dvh;
      min-height: 100dvh;
      overflow: hidden;
    }
    button, a { -webkit-tap-highlight-color: transparent; }
    #ew-app {
      height: 100dvh;
      min-height: 100dvh;
      display: grid;
      grid-template-rows: auto auto minmax(42dvh, 1fr) 148px;
      padding:
        env(safe-area-inset-top)
        env(safe-area-inset-right)
        env(safe-area-inset-bottom)
        env(safe-area-inset-left);
    }
    .top {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 6px 10px 0;
      min-height: 36px;
    }
    .top a { color: #8ecbff; text-decoration: none; font-weight: 700; }
    .top h1 {
      margin: 0;
      flex: 1;
      text-align: center;
      font-family: Shket, Cinzel, Georgia, serif;
      font-weight: 400;
      font-size: clamp(1.15rem, 3vw, 1.6rem);
      letter-spacing: 0.04em;
      color: #e7f6ff;
    }
    .hud {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 4px 8px;
      min-height: 40px;
    }
    #ew-res {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 12px;
      font-weight: 700;
      font-variant-numeric: tabular-nums;
    }
    #ew-res b { color: #9ad7ff; font-weight: 700; }
    .speeds, .hud-acts { display: flex; gap: 4px; flex-wrap: wrap; }
    button {
      appearance: none;
      border: 1px solid rgba(120, 190, 255, 0.45);
      background: rgba(8, 16, 32, 0.9);
      color: #e7f3ff;
      font: 700 0.82rem/1.2 system-ui, sans-serif;
      min-height: 40px;
      padding: 8px 10px;
      cursor: pointer;
    }
    button.on, button:hover { background: #7ee0ff; color: #071018; }
    button:disabled { opacity: 0.45; cursor: default; }
    .stage {
      position: relative;
      min-height: 42dvh;
      height: 100%;
      overflow: hidden;
      background: #070b16;
    }
    canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      display: block;
      touch-action: none;
      background: #070b16;
    }
    .foot {
      min-height: 132px;
      overflow: auto;
      padding: 6px 8px 8px;
      background: #0a1222;
      border-top: 1px solid rgba(120, 190, 255, 0.28);
      -webkit-overflow-scrolling: touch;
    }
    .dock, .row { display: flex; gap: 6px; overflow-x: auto; padding-bottom: 4px; }
    .dock button {
      flex: 0 0 84px;
      width: 84px;
      min-height: 64px;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: 2px;
    }
    .dock button small { font-weight: 600; color: #9ad7ff; }
    .dock button.locked { opacity: 0.55; }
    .card h3, .foot h2 {
      margin: 0 0 4px;
      font-family: Shket, Georgia, serif;
      font-weight: 400;
      color: #e7f6ff;
    }
    .card p, .foot p { margin: 0 0 4px; color: #c5d7ee; font-size: 0.92rem; }
    .acts { display: flex; flex-wrap: wrap; gap: 6px; }
    #ew-tip {
      position: fixed;
      z-index: 30;
      max-width: min(340px, calc(100vw - 16px));
      padding: 8px 10px;
      background: rgba(6, 10, 20, 0.96);
      border: 1px solid #7ee0ff;
      color: #e7f3ff;
      font-size: 0.82rem;
      line-height: 1.35;
      white-space: pre-line;
      pointer-events: none;
    }
    #ew-tip[hidden] { display: none !important; }
    .toast {
      position: absolute;
      left: 50%;
      top: 8px;
      transform: translateX(-50%);
      margin: 0;
      padding: 6px 10px;
      background: rgba(6, 10, 20, 0.92);
      border: 1px solid rgba(126, 224, 255, 0.7);
      z-index: 5;
      pointer-events: none;
    }
    .toast[hidden] { display: none !important; }
    @media (max-width: 800px) {
      #ew-app { grid-template-rows: auto auto minmax(42dvh, 1fr) 136px; }
      .top h1 { font-size: 1.15rem; }
      .dock button { width: 76px; }
    }
  </style>
</head>
<body>
  <div id="ew-app">
    <header class="top">
      <a href="/games" data-tip="Вернуться к списку мини-игр.">← Мини-игры</a>
      <h1>Вечная стража</h1>
    </header>
    <div class="hud" id="ew-hud">
      <div id="ew-res"></div>
      <div class="speeds">
        <button type="button" id="ew-pause" data-tip="Пауза. Ночь стоит на месте, башни можно ставить и улучшать. Перезарядка умений не идёт.">Пауза</button>
        <button type="button" id="ew-x1" data-tip="Обычная скорость ночи, 1×.">1×</button>
        <button type="button" id="ew-x2" data-tip="Ускорить ночь вдвое, 2×.">2×</button>
        <button type="button" id="ew-x4" data-tip="Ускорить ночь вчетверо, 4×.">4×</button>
      </div>
      <div class="hud-acts">
        <button type="button" id="ew-nums" data-tip="Показывать или прятать цифры урона над тварями.">Цифры</button>
        <button type="button" id="ew-tree" data-tip="Открыть древо. Искры, пепел и руда тратятся здесь и не сгорают между ночами.">Древо</button>
        <button type="button" id="ew-endless" data-tip="Бесконечная ночь на уже открытых картах. Рекорд волны хранится на этом устройстве, без таблицы лидеров.">Бесконечная</button>
        <button type="button" id="ew-world" data-tip="Карта ночей кампании. Следующая ночь открывается после хотя бы одной звезды.">Карта</button>
      </div>
    </div>
    <div class="stage" id="ew-stage">
      <canvas id="ew-canvas" aria-label="Тёмная сетка у Врат искры"></canvas>
      <p class="toast" id="ew-toast" hidden></p>
    </div>
    <div class="foot" id="ew-foot"></div>
  </div>
  <p id="ew-tip" hidden></p>
  <noscript><p>Для игры нужен JavaScript. Вход не требуется.</p></noscript>
  <script>
    import '../../scripts/eternal-watch/client';
  </script>
</body>
</html>
