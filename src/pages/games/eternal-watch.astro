---
// «Вечная стража» — клиентская мини-игра. Без входа, без API, без worker.
import SeoHead from '../../components/seo/SeoHead.astro';
const title = 'Вечная стража | Моррис Град';
const description = 'Ночь за ночью держите Врата искры. Башни, руны, резонанс и Рассвет.';
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover" />
  <title>{title}</title>
  <SeoHead title={title} description={description} image="/games/eternal-watch/cover.png" imageAlt="Вечная стража — сумеречная крепость у Врат искры" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="theme-color" content="#14110e" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <link rel="preload" href="/fonts/Shket-Regular.otf" as="font" type="font/otf" crossorigin />
  <style is:global>
    @font-face {
      font-family: "Shket";
      src: url("/fonts/Shket-Regular.otf") format("opentype");
      font-display: swap;
    }
    *, *::before, *::after { box-sizing: border-box; }
    html, body {
      margin: 0;
      height: 100%;
      background: #100e0c;
      color: #f3e6d4;
      font-family: "Exo 2", system-ui, sans-serif;
    }
    body {
      min-height: 100dvh;
      height: 100dvh;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      padding:
        env(safe-area-inset-top)
        env(safe-area-inset-right)
        env(safe-area-inset-bottom)
        env(safe-area-inset-left);
      overscroll-behavior: none;
    }
    button, a { -webkit-tap-highlight-color: transparent; }
    .top {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 8px;
      padding: 8px 12px 0;
      flex-shrink: 0;
    }
    .top a {
      color: #e0a15a;
      text-decoration: none;
      font-weight: 700;
      font-size: 0.92rem;
      justify-self: start;
    }
    .top a:hover { color: #ffd7a4; }
    .top h1 {
      margin: 0;
      font-family: Shket, Cinzel, Georgia, serif;
      font-size: clamp(1.25rem, 3vw, 1.7rem);
      font-weight: 400;
      letter-spacing: 0.04em;
      color: #f0d090;
      text-align: center;
    }
    .blurb {
      margin: 2px 12px 6px;
      text-align: center;
      color: #cbb79a;
      font-size: 0.92rem;
      flex-shrink: 0;
    }
    .ew-frame {
      position: relative;
      flex: 1;
      min-height: 0;
      width: min(1100px, calc(100% - 12px));
      margin: 0 auto 8px;
      display: flex;
      flex-direction: column;
      padding: 10px;
      background: linear-gradient(180deg, rgba(42, 32, 24, 0.96), rgba(16, 12, 10, 0.98));
      border: 1px solid rgba(196, 122, 64, 0.7);
      box-shadow:
        0 0 0 4px #100e0c,
        0 0 0 5px rgba(196, 122, 64, 0.35),
        inset 0 0 0 1px rgba(240, 208, 144, 0.16),
        0 18px 40px rgba(0, 0, 0, 0.5);
    }
    .corner {
      position: absolute;
      width: 16px;
      height: 16px;
      border: 2px solid #e0a15a;
      pointer-events: none;
    }
    .corner.tl { top: 5px; left: 5px; border-right: 0; border-bottom: 0; }
    .corner.tr { top: 5px; right: 5px; border-left: 0; border-bottom: 0; }
    .corner.bl { bottom: 5px; left: 5px; border-right: 0; border-top: 0; }
    .corner.br { bottom: 5px; right: 5px; border-left: 0; border-top: 0; }
    .hud {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: 6px 10px;
      padding: 2px 4px 6px;
      flex-shrink: 0;
    }
    .stat {
      display: flex;
      align-items: center;
      gap: 4px;
      color: #f6e7c8;
      font-variant-numeric: tabular-nums;
      font-weight: 700;
    }
    .stat img, .veil img, .dock img, .card img {
      image-rendering: pixelated;
      image-rendering: crisp-edges;
    }
    .stat img { width: 24px; height: 24px; }
    .stat b { font-weight: 700; }
    .speeds { display: flex; gap: 4px; }
    .speeds button, .hud .shop {
      appearance: none;
      border: 1px solid rgba(224, 161, 90, 0.7);
      background: rgba(20, 14, 10, 0.7);
      color: #f0d090;
      font: 700 0.82rem/1 system-ui, sans-serif;
      min-width: 40px;
      min-height: 36px;
      padding: 8px 10px;
      cursor: pointer;
    }
    .speeds button.on, .hud .shop:hover, .speeds button:hover {
      background: #e0a15a;
      color: #1a120c;
    }
    .stage {
      position: relative;
      flex: 1 1 auto;
      min-height: 168px;
      overflow: hidden;
      background: #1a1612;
      touch-action: none;
      display: grid;
      place-items: center;
    }
    canvas {
      display: block;
      background: #241c16;
      image-rendering: pixelated;
      image-rendering: crisp-edges;
      touch-action: none;
    }
    .veil {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 16px;
      text-align: center;
      background: rgba(16, 12, 10, 0.72);
      overflow: auto;
    }
    .veil[hidden] { display: none !important; }
    .veil h2 {
      margin: 0;
      font-family: Shket, Cinzel, Georgia, serif;
      font-size: clamp(1.5rem, 4vw, 2.3rem);
      font-weight: 400;
      color: #f6e2b4;
      letter-spacing: 0.03em;
    }
    .veil p { margin: 0; max-width: 38rem; color: #f0e2cc; font-size: 1rem; }
    .row { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; }
    button.gold, .law {
      appearance: none;
      border: 1px solid #e0a15a;
      background: transparent;
      color: #f6e2b4;
      font: 700 1rem/1.3 system-ui, sans-serif;
      letter-spacing: 0.03em;
      padding: 12px 18px;
      cursor: pointer;
      min-height: 48px;
    }
    button.gold:hover, button.gold:focus-visible, .law:hover {
      background: #e0a15a;
      color: #1a120c;
      outline: none;
    }
    .laws { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; width: min(640px, 100%); }
    .law {
      flex: 1 1 180px;
      text-align: left;
      background: rgba(28, 20, 14, 0.9);
    }
    .law b, .law span { display: block; }
    .law b { font-family: Shket, Georgia, serif; font-weight: 400; font-size: 1.15rem; margin-bottom: 4px; }
    .law span { font-weight: 500; }
    .shop-list { width: min(520px, 100%); display: flex; flex-direction: column; gap: 6px; }
    .shop-row {
      display: flex;
      gap: 8px;
      align-items: center;
      text-align: left;
      background: rgba(28, 20, 14, 0.9);
      border: 1px solid rgba(224, 161, 90, 0.45);
      color: #f6e7c8;
      padding: 8px 10px;
      cursor: pointer;
      width: 100%;
    }
    .shop-row:hover { border-color: #f0d090; }
    .shop-row .cost { margin-left: auto; color: #f0d090; font-weight: 800; white-space: nowrap; }
    .shop-row small { display: block; color: #d9c4a4; font-weight: 500; }
    .toast {
      position: absolute;
      left: 50%;
      top: 8px;
      transform: translateX(-50%);
      margin: 0;
      padding: 6px 12px;
      background: rgba(16, 12, 10, 0.92);
      border: 1px solid rgba(224, 161, 90, 0.7);
      color: #f6e7c8;
      z-index: 4;
      pointer-events: none;
      max-width: calc(100% - 24px);
    }
    .toast[hidden] { display: none !important; }
    .card {
      flex: 0 1 auto;
      max-height: 38vh;
      overflow: auto;
      margin-top: 6px;
      padding: 8px 10px;
      background: rgba(22, 16, 12, 0.96);
      border: 1px solid rgba(224, 161, 90, 0.45);
      color: #f6e7c8;
      touch-action: pan-y;
    }
    .card[hidden] { display: none !important; }
    .card h3 {
      margin: 0 0 4px;
      font-family: Shket, Georgia, serif;
      font-weight: 400;
      color: #f0d090;
      font-size: 1.2rem;
    }
    .card p { margin: 0 0 4px; font-size: 0.92rem; }
    .card .acts, .card .glyphs, .card .runes { display: flex; flex-wrap: wrap; gap: 6px; margin: 6px 0; }
    .card button {
      appearance: none;
      border: 1px solid rgba(224, 161, 90, 0.65);
      background: #24180f;
      color: #f6e2b4;
      font: 700 0.86rem/1.2 system-ui, sans-serif;
      padding: 8px 10px;
      min-height: 40px;
      cursor: pointer;
    }
    .card button:hover { background: #e0a15a; color: #1a120c; }
    .card button.on { box-shadow: inset 0 0 0 2px #f0d090; }
    .dock {
      flex: 0 0 auto;
      display: flex;
      gap: 8px;
      overflow-x: auto;
      padding: 8px 2px 2px;
      touch-action: pan-x;
    }
    .dock[hidden] { display: none !important; }
    .dock button {
      flex: 0 0 auto;
      width: 84px;
      min-height: 84px;
      padding: 4px;
      border: 1px solid rgba(224, 161, 90, 0.45);
      background: url("/games/eternal-watch/sprites/16/ui_button.png") center / 84px 84px no-repeat;
      image-rendering: pixelated;
      color: #f8e7c4;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 1px;
      font: 700 0.72rem/1.1 system-ui, sans-serif;
      text-shadow: 0 1px 0 #1a120c;
    }
    .dock button img { width: 32px; height: 32px; }
    .dock button.on { outline: 2px solid #f0d090; outline-offset: -2px; }
    .dock button.locked { filter: grayscale(0.7) brightness(0.75); }
    .hint {
      margin: 4px 8px 0;
      text-align: center;
      color: #b7a48c;
      font-size: 0.78rem;
      flex-shrink: 0;
    }
    #ew-tip {
      position: fixed;
      z-index: 20;
      max-width: min(320px, calc(100vw - 16px));
      padding: 8px 10px;
      background: rgba(16, 12, 10, 0.96);
      border: 1px solid #e0a15a;
      color: #f6e7c8;
      font-size: 0.82rem;
      line-height: 1.35;
      white-space: pre-line;
      pointer-events: none;
      box-shadow: 0 8px 24px rgba(0, 0, 0, 0.45);
    }
    #ew-tip[hidden] { display: none !important; }
    @media (max-width: 720px) {
      .top { grid-template-columns: auto 1fr; }
      .top h1 { font-size: 1.15rem; text-align: right; }
      .blurb { display: none; }
      .card { max-height: 34vh; }
      .dock button { width: 76px; min-height: 76px; background-size: 76px 76px; }
    }
  </style>
</head>
<body>
  <header class="top">
    <a href="/games" data-tip="Вернуться к списку мини-игр">← Мини-игры</a>
    <h1>Вечная стража</h1>
    <span></span>
  </header>
  <p class="blurb">Ночь за ночью держите Врата искры. Золото живёт одну ночь, искры и законы остаются.</p>
  <div class="ew-frame" id="ew-frame">
    <span class="corner tl" aria-hidden="true"></span>
    <span class="corner tr" aria-hidden="true"></span>
    <span class="corner bl" aria-hidden="true"></span>
    <span class="corner br" aria-hidden="true"></span>
    <div class="hud" id="ew-hud">
      <span class="stat" id="ew-hearts"><img src="/games/eternal-watch/sprites/32/ui_heart.png" alt="" /> <b>20</b></span>
      <span class="stat" id="ew-gold"><img src="/games/eternal-watch/sprites/32/ui_gold.png" alt="" /> <b>0</b></span>
      <span class="stat" id="ew-sparks"><img src="/games/eternal-watch/sprites/32/ui_spark.png" alt="" /> <b>0</b></span>
      <span class="stat" id="ew-wave"><img src="/games/eternal-watch/sprites/32/ui_rune.png" alt="" /> <b>Волна 1</b></span>
      <div class="speeds">
        <button type="button" id="ew-pause" data-tip="Пауза. Ночь стоит на месте, башни можно ставить и улучшать.">Пауза</button>
        <button type="button" id="ew-x1" data-tip="Обычная скорость ночи.">1×</button>
        <button type="button" id="ew-x2" data-tip="Ускорить ночь вдвое.">2×</button>
      </div>
      <button type="button" class="shop" id="ew-shop-btn" data-tip="Лавка искр. Покупки остаются навсегда.">Лавка</button>
    </div>
    <div class="stage" id="ew-stage">
      <canvas id="ew-canvas" width="256" height="160" aria-label="Крепость и каменный серпантин"></canvas>
      <div class="veil" id="ew-title">
        <h2>Вечная стража</h2>
        <p>Твари идут по серпантину к Вратам искры. Ставьте башни на площадки. На третьем уровне башня выбирает глиф. Соседи одного типа входят в резонанс, разные типы складываются в сочетания. После длинной ночи можно встретить Рассвет.</p>
        <div class="row">
          <button class="gold" id="ew-start" type="button" data-tip="Начать ночь: золото и башни этой ночи, искры и законы уже ваши.">Начать ночь</button>
          <button class="gold" id="ew-title-shop" type="button" data-tip="Открыть лавку искр до начала ночи.">Лавка искр</button>
        </div>
      </div>
      <div class="veil" id="ew-defeat" hidden>
        <h2>Ночь кончилась</h2>
        <p id="ew-defeat-text"></p>
        <div class="row">
          <button class="gold" id="ew-again" type="button" data-tip="Новая ночь. Искры и законы сохраняются, золото и башни начинаются заново.">Новая ночь</button>
          <button class="gold" id="ew-defeat-dawn" type="button" data-tip="Встретить Рассвет: обменять золото на искры и выбрать закон.">Рассвет</button>
        </div>
      </div>
      <div class="veil" id="ew-dawn" hidden>
        <h2>Рассвет</h2>
        <p id="ew-dawn-text"></p>
        <div class="laws" id="ew-laws"></div>
        <button class="gold" id="ew-dawn-back" type="button" data-tip="Вернуться к ночи, не встречая Рассвет.">Ещё постоять</button>
      </div>
      <div class="veil" id="ew-shop" hidden>
        <h2>Лавка искр</h2>
        <p>Искры не сгорают. Здесь открываются башни, слоты рун и сила следующих ночей.</p>
        <div class="shop-list" id="ew-shop-list"></div>
        <button class="gold" id="ew-shop-close" type="button" data-tip="Закрыть лавку.">Закрыть</button>
      </div>
      <p class="toast" id="ew-toast" hidden></p>
    </div>
    <section class="card" id="ew-card" hidden></section>
    <div class="dock" id="ew-dock" hidden></div>
    <p class="hint">Площадка ставит выбранную башню. Карточка не прячет карту. Подсказка: наведите курсор или удерживайте кнопку.</p>
  </div>
  <p class="tip" id="ew-tip" hidden></p>
  <noscript><p class="hint">Для игры нужен JavaScript. Вход не требуется.</p></noscript>
  <script>
    import '../../scripts/eternal-watch/client';
  </script>
</body>
</html>
