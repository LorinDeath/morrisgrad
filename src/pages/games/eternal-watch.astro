---
// «Вечная стража» — клиентская мини-игра. Без входа, без API, без worker.
import SeoHead from '../../components/seo/SeoHead.astro';
const title = 'Вечная стража | Моррис Град';
const description = 'Ночь у Врат искры: свободная сетка, опыт башен и древо, которое не сгорает.';
---
<!doctype html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover" />
  <title>{title}</title>
  <SeoHead title={title} description={description} image="/games/eternal-watch/cover.png" imageAlt="Вечная стража — неон над тёмной сеткой у Врат искры" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <meta name="theme-color" content="#070b16" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <link rel="preload" href="/fonts/Shket-Regular.otf" as="font" type="font/otf" crossorigin />
  <style is:global>
    @font-face {
      font-family: "Shket";
      src: url("/fonts/Shket-Regular.otf") format("opentype");
      font-display: swap;
    }
    *, *::before, *::after { box-sizing: border-box; }
    html, body {
      margin: 0;
      background: #070b16;
      color: #d7e7ff;
      font-family: "Exo 2", system-ui, sans-serif;
    }
    body {
      height: 100dvh;
      min-height: 100dvh;
      overflow: hidden;
    }
    button, a { -webkit-tap-highlight-color: transparent; }
    #ew-app {
      height: 100dvh;
      min-height: 100dvh;
      display: grid;
      grid-template-rows: auto auto minmax(42dvh, 1fr) auto;
      padding:
        env(safe-area-inset-top)
        env(safe-area-inset-right)
        env(safe-area-inset-bottom)
        env(safe-area-inset-left);
    }
    #ew-app:not(.in-battle) .battle-hud { display: none; }
    #ew-app:not(.in-battle) #ew-dock { display: none; }
    .top {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 6px 10px 0;
      min-height: 36px;
    }
    .top a { color: #8ecbff; text-decoration: none; font-weight: 700; }
    .top h1 {
      margin: 0;
      flex: 1;
      text-align: center;
      font-family: Shket, Cinzel, Georgia, serif;
      font-weight: 400;
      font-size: clamp(1.15rem, 3vw, 1.6rem);
      letter-spacing: 0.04em;
      color: #e7f6ff;
    }
    .hud { display: flex; flex-direction: column; gap: 4px; padding: 4px 8px 6px; }
    .battle-hud, .meta-hud, .speeds, .hud-acts, #ew-globals {
      display: flex; flex-wrap: wrap; align-items: center; gap: 6px;
    }
    .meta-hud { justify-content: space-between; }
    #ew-fight, #ew-res {
      display: flex; flex-wrap: wrap; gap: 8px 12px;
      font-weight: 700; font-variant-numeric: tabular-nums;
    }
    #ew-fight b { color: #ffe1a3; }
    #ew-res b { color: #9ad7ff; font-weight: 700; }
    .ability {
      position: relative; min-width: 74px; overflow: hidden;
    }
    .ability .ring {
      position: absolute; inset: 2px auto auto 2px; width: 16px; height: 16px; border-radius: 50%;
      background: conic-gradient(#7ee0ff var(--p), rgba(126, 224, 255, 0.15) 0);
    }
    button {
      appearance: none;
      border: 1px solid rgba(120, 190, 255, 0.45);
      background: rgba(8, 16, 32, 0.9);
      color: #e7f3ff;
      font: 700 0.82rem/1.2 system-ui, sans-serif;
      min-height: 40px;
      padding: 8px 10px;
      cursor: pointer;
    }
    button.on, button:hover { background: #7ee0ff; color: #071018; }
    button:disabled { opacity: 0.45; cursor: default; }
    .main {
      min-height: 42dvh;
      min-height: 0;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      position: relative;
    }
    #ew-app.panel-open .main { grid-template-columns: minmax(0, 1fr) minmax(280px, 360px); }
    .stage {
      position: relative;
      min-height: 42dvh;
      height: 100%;
      overflow: hidden;
      background: #070b16;
    }
    .panel {
      overflow: auto;
      background: #0b1426;
      border-left: 1px solid rgba(120, 190, 255, 0.28);
      padding: 10px 12px 16px;
      min-height: 0;
    }
    .panel[hidden] { display: none !important; }
    .xp {
      height: 8px; border-radius: 99px; background: #172033; overflow: hidden; margin: 6px 0 8px;
    }
    .xp span { display: block; height: 100%; background: linear-gradient(90deg, #3ee0ff, #ffe08a); }
    .ability-card {
      display: block; width: 100%; text-align: left; margin: 0 0 6px; min-height: 64px;
    }
    .ability-card b { display: block; font-family: Shket, Georgia, serif; font-weight: 400; font-size: 1.05rem; }
    .ability-card span { display: block; font-weight: 500; color: #c5d7ee; }
    #ew-preview { width: 100%; height: 150px; display: block; background: #070b16; margin: 6px 0 8px; border: 1px solid rgba(120, 190, 255, 0.25); }
    canvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      display: block;
      touch-action: none;
      background: #070b16;
    }
    #ew-dock {
      padding: 6px 8px 8px;
      background: #0a1222;
      border-top: 1px solid rgba(120, 190, 255, 0.28);
    }
    .dock { display: flex; gap: 6px; overflow-x: auto; padding-bottom: 2px; }
    .dock button {
      flex: 0 0 96px;
      width: 96px;
      min-height: 74px;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: 2px;
    }
    .swatch { width: 18px; height: 18px; border-radius: 50%; box-shadow: 0 0 10px currentColor; }
    .dock button small { font-weight: 600; color: #9ad7ff; }
    .dock button.locked { opacity: 0.55; }
    .panel h2, .panel h3 {
      margin: 0 0 4px;
      font-family: Shket, Georgia, serif;
      font-weight: 400;
      color: #e7f6ff;
    }
    .panel p { margin: 0 0 4px; color: #c5d7ee; font-size: 0.92rem; }
    .acts { display: flex; flex-wrap: wrap; gap: 6px; }
    #ew-tip {
      position: fixed;
      z-index: 30;
      max-width: min(340px, calc(100vw - 16px));
      padding: 8px 10px;
      background: rgba(6, 10, 20, 0.96);
      border: 1px solid #7ee0ff;
      color: #e7f3ff;
      font-size: 0.82rem;
      line-height: 1.35;
      white-space: pre-line;
      pointer-events: none;
    }
    #ew-tip[hidden] { display: none !important; }
    .toast {
      position: absolute;
      left: 50%;
      top: 8px;
      transform: translateX(-50%);
      margin: 0;
      padding: 6px 10px;
      background: rgba(6, 10, 20, 0.92);
      border: 1px solid rgba(126, 224, 255, 0.7);
      z-index: 5;
      pointer-events: none;
    }
    .toast[hidden] { display: none !important; }
    @media (max-width: 800px) {
      #ew-app.panel-open .main { grid-template-columns: minmax(0, 1fr); }
      #ew-app.panel-open .stage { height: 58%; min-height: 200px; }
      #ew-app.panel-open .panel {
        position: absolute;
        left: 0; right: 0; bottom: 0;
        max-height: 46%;
        z-index: 6;
        border-left: 0;
        border-top: 1px solid rgba(120, 190, 255, 0.35);
      }
      .top h1 { font-size: 1.15rem; }
      .dock button { width: 88px; flex-basis: 88px; }
    }
  </style>
</head>
<body>
  <div id="ew-app">
    <header class="top">
      <a href="/games" data-tip="Вернуться к списку мини-игр.">← Мини-игры</a>
      <h1>Вечная стража</h1>
    </header>
    <div class="hud" id="ew-hud">
      <div class="battle-hud">
        <div id="ew-fight"></div>
        <button type="button" id="ew-call" data-tip="Вызвать следующую волну сразу, не дожидаясь таймера. Пока волна ещё выходит из портала, вызов ждёт.">Волна</button>
        <div class="speeds">
          <button type="button" id="ew-pause" data-tip="Пауза. Ночь стоит на месте, башни можно ставить и улучшать. Перезарядка умений не идёт.">Пауза</button>
          <button type="button" id="ew-x1" data-tip="Обычная скорость ночи, 1×.">1×</button>
          <button type="button" id="ew-x2" data-tip="Ускорить ночь вдвое, 2×.">2×</button>
          <button type="button" id="ew-x4" data-tip="Ускорить ночь вчетверо, 4×.">4×</button>
        </div>
        <div id="ew-globals"></div>
      </div>
      <div class="meta-hud">
        <div id="ew-res"></div>
        <div class="hud-acts">
          <button type="button" id="ew-nums" data-tip="Показывать или прятать цифры урона над тварями.">Цифры</button>
          <button type="button" id="ew-tree" data-tip="Открыть древо. Искры, пепел и руда тратятся здесь и не сгорают между ночами.">Древо</button>
          <button type="button" id="ew-endless" data-tip="Бесконечная ночь на уже открытых картах. Рекорд волны хранится на этом устройстве, без таблицы лидеров.">Бесконечная</button>
          <button type="button" id="ew-world" data-tip="Карта ночей кампании. Следующая ночь открывается после хотя бы одной звезды.">Карта</button>
        </div>
      </div>
    </div>
    <div class="main" id="ew-main">
      <div class="stage" id="ew-stage">
        <canvas id="ew-canvas" aria-label="Тёмная сетка у Врат искры"></canvas>
        <p class="toast" id="ew-toast" hidden></p>
      </div>
      <aside class="panel" id="ew-panel" hidden></aside>
    </div>
    <div id="ew-dock" hidden></div>
  </div>
  <p id="ew-tip" hidden></p>
  <noscript><p>Для игры нужен JavaScript. Вход не требуется.</p></noscript>
  <script>
    import '../../scripts/eternal-watch/client';
  </script>
</body>
</html>
