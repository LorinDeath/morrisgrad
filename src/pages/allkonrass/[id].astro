---
import Layout from '../../layouts/Layout.astro';

export const prerender = false;

const { id } = Astro.params;
const runtime = (Astro.locals as any).runtime?.env || (Astro.locals as any).env;
const db = runtime?.DB;
const bucket = runtime?.konkursbook;

if (!db || !bucket || !id) {
  return Astro.redirect('/allkonrass');
}

// 1. Получаем запись из SQLite D1
interface KonkursRow {
  rowid: number;
  author: string;
  name: string;
  urlrasskaz: string;
  created_at: string;
}

const storyMeta = (await db.prepare(
  'SELECT rowid, author, name, urlrasskaz, created_at FROM konkurs WHERE rowid = ?'
).bind(id).first()) as KonkursRow | null;

if (!storyMeta) {
  return Astro.redirect('/404');
}

// 2. Читаем JSON файл из R2
let storyText = '';

try {
  const r2Object = await bucket.get(storyMeta.urlrasskaz);
  if (r2Object) {
    const rawJson = await r2Object.text();
    const parsedData = JSON.parse(rawJson);
    storyText = parsedData.text || '';
  }
} catch (err) {
  console.error('Ошибка получения файла из R2:', err);
}
---

<Layout title={`${storyMeta.name} — ${storyMeta.author} | Моррис Град`}>
  <main class="container story-view">
    <nav class="breadcrumb">
      <a href="/allkonrass" class="back-link">← Ко всем рассказам</a>
    </nav>

    <article class="reader-card">
      <header class="reader-header">
        <h1 class="story-heading">{storyMeta.name}</h1>
        
        <div class="reader-meta">
          <div class="author-block">
            <span class="label">Автор:</span>
            <span class="author-name">{storyMeta.author}</span>
          </div>

          {storyMeta.created_at && (
            <time class="publish-date">
              {new Date(storyMeta.created_at).toLocaleDateString('ru-RU', {
                day: 'numeric',
                month: 'long',
                year: 'numeric'
              })}
            </time>
          )}
        </div>

        <div class="shimmer-line"></div>
      </header>

      <section class="story-content">
        {storyText ? (
          storyText.split('\n').map((paragraph: string) => (
            paragraph.trim() ? <p>{paragraph}</p> : <br />
          ))
        ) : (
          <p class="error-text">Не удалось загрузить текст произведения.</p>
        )}
      </section>
    </article>
  </main>
</Layout>

<style>
  .story-view {
    max-width: 820px;
    margin: 0 auto;
    padding: 2rem 1rem;
  }

  .breadcrumb {
    margin-bottom: 1.5rem;
  }

  .back-link {
    color: #a1a1aa;
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: #ef4444;
  }

  .reader-card {
    background: #18181b;
    border: 1px solid #27272a;
    border-radius: 12px;
    padding: 2.5rem;
  }

  .reader-header {
    margin-bottom: 2rem;
  }

  .story-heading {
    font-size: 2rem;
    margin: 0 0 1rem;
    color: #fafafa;
    line-height: 1.3;
  }

  .reader-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: #a1a1aa;
    font-size: 0.95rem;
    margin-bottom: 1rem;
  }

  .author-name {
    color: #f87171;
    font-weight: 600;
    margin-left: 0.25rem;
  }

  .story-content {
    color: #d4d4d8;
    font-size: 1.1rem;
    line-height: 1.8;
  }

  .story-content p {
    margin: 0 0 1.25rem;
    text-indent: 1.5rem;
  }

  .error-text {
    color: #f87171;
    font-style: italic;
  }

  @media (max-width: 640px) {
    .reader-card {
      padding: 1.5rem;
    }
    .story-heading {
      font-size: 1.5rem;
    }
    .reader-meta {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.5rem;
    }
  }
</style>