---
import Layout from '../layouts/Layout.astro';
import Notes from '../components/Notes.astro';

export const prerender = false;

const R2_PUBLIC_BASE = 'https://pub-becc7b2187614cf1bfb6cabab35271d2.r2.dev';

export interface ArtItem {
  id: string;
  name: string;
  filename: string;
  url: string;
  category: string;
  tag: string;
  size: number;
  uploaded: string;
}

let galleryItems: ArtItem[] = [];

// Динамическое получение актуального списка артов из Cloudflare R2 на сервере
try {
  const localsAny = Astro.locals as any;
  const env = localsAny.runtime?.env || localsAny.cloudflare?.env || localsAny.env || {};
  const bucket = env.ARTCOLLECTION_BUCKET;

  if (bucket) {
    let truncated = true;
    let cursor: string | undefined = undefined;
    const allObjects: any[] = [];

    while (truncated) {
      const res: any = await bucket.list({
        prefix: 'art/',
        limit: 1000,
        cursor,
      });

      if (res?.objects) {
        allObjects.push(...res.objects);
      }

      truncated = !!res.truncated;
      cursor = res.cursor;
    }

    const imageExtensions = ['.png', '.jpg', '.jpeg', '.webp', '.gif', '.svg'];
    const validObjects = allObjects.filter((obj) => {
      if (!obj.key || obj.key.endsWith('/') || obj.size === 0) return false;
      const lower = obj.key.toLowerCase();
      return imageExtensions.some((ext) => lower.endsWith(ext));
    });

    galleryItems = validObjects.map((obj, index) => {
      const filename = obj.key.replace(/^art\//, '');
      const rawName = filename.replace(/\.[^/.]+$/, '');
      const cleanName = rawName.replace(/_/g, ' ').trim();

      let category = 'all';
      let tag = 'Архив';

      const lower = filename.toLowerCase();
      if (lower.includes('lorin') || lower.includes('лорин') || lower.includes('girl')) {
        category = 'lorin';
        tag = 'Лорин';
      } else if (lower.includes('veles') || lower.includes('велес') || lower.includes('man') || lower.includes('guy')) {
        category = 'veles';
        tag = 'Велес & Стражи';
      } else if (lower.includes('noir') || lower.includes('dark') || lower.includes('арт-деко')) {
        category = 'artdeco';
        tag = 'Тёмное Арт-деко';
      } else if (lower.includes('combat') || lower.includes('sword') || lower.includes('арен')) {
        category = 'combat';
        tag = 'Боевые Арены';
      }

      const encodedKey = obj.key
        .split('/')
        .map((segment: string) => encodeURIComponent(segment))
        .join('/');

      return {
        id: `art-${index + 1}`,
        name: cleanName || `Экспонат #${index + 1}`,
        filename,
        url: `${R2_PUBLIC_BASE}/${encodedKey}`,
        category,
        tag,
        size: obj.size,
        uploaded: obj.uploaded ? new Date(obj.uploaded).toISOString() : new Date().toISOString(),
      };
    });

    // Сортировка: новые загрузки вверху
    galleryItems.sort((a, b) => new Date(b.uploaded).getTime() - new Date(a.uploaded).getTime());
  }
} catch (err) {
  console.error('Ошибка прямого SSR чтения R2 бакета artcollection:', err);
}
---

<Layout title="Галерея Персонажей | МоррисГрад">
  <main class="container">
    
    <!-- Шапка галереи в стиле Арт-Деко -->
    <header class="gallery-page-header">
      <div class="artdeco-filigree" aria-hidden="true">
        <span class="filigree-line"></span>
        <span class="filigree-glyph">❖ ⚜ ❖</span>
        <span class="filigree-line"></span>
      </div>

      <h1 class="gallery-main-title">Галерея Персонажей</h1>
      <p class="gallery-subtitle">Визуальные архивы и хроники жителей Обители Смерти</p>
      
      <div class="gallery-count-badge">
        <span class="badge-dot"></span> 
        <span>Найдено работ: <strong id="gallery-total-count">{galleryItems.length}</strong></span>
      </div>
    </header>

    <div class="shimmer-line"></div>

    <!-- Загрузочный спиннер (если данные подгружаются на клиенте) -->
    <div id="gallery-loader" class="gallery-loader" style={galleryItems.length > 0 ? "display: none;" : "display: flex;"}>
      <div class="spinner-core"></div>
      <p>Синхронизация с хранилищем Cloudflare R2...</p>
    </div>

    <!-- Сетка артов галереи -->
    <section class="gallery-masonry-grid" id="gallery-grid">
      {galleryItems.map((item, index) => (
        <article class="gallery-art-card" data-index={index} data-src={item.url} data-name={item.name} data-tag={item.tag}>
          <!-- Арт-деко уголки -->
          <div class="deco-bracket br-top-left"></div>
          <div class="deco-bracket br-top-right"></div>
          <div class="deco-bracket br-bot-left"></div>
          <div class="deco-bracket br-bot-right"></div>

          <div class="art-img-box">
            <img 
              src={item.url} 
              alt={item.name} 
              class="art-real-img" 
              loading="lazy" 
            />
            <div class="art-overlay-sheen"></div>
            <div class="art-zoom-cue">
              <span class="zoom-icon">🔍</span>
            </div>
          </div>

          <div class="art-card-info">
            <span class="art-card-tag">{item.tag}</span>
            <h3 class="art-card-name" title={item.name}>{item.name}</h3>
          </div>
        </article>
      ))}
    </section>

    <!-- Сообщение, если бакет пока пуст -->
    <div id="gallery-empty-state" class="gallery-empty-state" style={galleryItems.length === 0 ? "display: none;" : "display: none;"}>
      <div class="empty-icon">🎨</div>
      <h3>Коллекция обновляется</h3>
      <p>Новые иллюстрации появятся здесь сразу после загрузки в бакет Cloudflare R2.</p>
    </div>

    <div class="shimmer-line"></div>

    <Notes />
  </main>

  <!-- Полноэкранный просмотрщик (Lightbox) с переключением на стрелочки -->
  <div id="art-lightbox-modal" class="art-lightbox" aria-hidden="true" role="dialog">
    <div class="lightbox-overlay"></div>
    
    <!-- Кнопка «Назад» (стрелочка влево) -->
    <button class="lightbox-arrow-btn arrow-prev" id="lightbox-prev-btn" aria-label="Предыдущий арт" title="Предыдущий арт (←)">
      <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
    </button>

    <!-- Кнопка «Вперёд» (стрелочка вправо) -->
    <button class="lightbox-arrow-btn arrow-next" id="lightbox-next-btn" aria-label="Следующий арт" title="Следующий арт (→)">
      <svg viewBox="0 0 24 24" width="32" height="32" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <polyline points="9 18 15 12 9 6"></polyline>
      </svg>
    </button>

    <div class="lightbox-content">
      <button class="lightbox-close" id="lightbox-close-btn" aria-label="Закрыть" title="Закрыть (Esc)">&times;</button>
      
      <div class="lightbox-image-wrap">
        <img id="lightbox-img" src="" alt="Просмотр работы" />
      </div>

      <div class="lightbox-caption">
        <div class="lightbox-meta-row">
          <span id="lightbox-tag" class="art-card-tag"></span>
          <span id="lightbox-counter" class="lightbox-counter"></span>
        </div>
        <h2 id="lightbox-title" class="lightbox-title"></h2>
        <a id="lightbox-download-link" href="#" target="_blank" rel="noopener noreferrer" class="lightbox-dl-btn">
          Открыть оригинал ↗
        </a>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Клиентский скрипт: динамическая подгрузка и просмотрщик Lightbox с поддержкой стрелок
  document.addEventListener('astro:page-load', () => {
    const grid = document.getElementById('gallery-grid');
    const loader = document.getElementById('gallery-loader');
    const emptyState = document.getElementById('gallery-empty-state');
    const totalCountEl = document.getElementById('gallery-total-count');

    // Lightbox элементы
    const lightbox = document.getElementById('art-lightbox-modal');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const lightboxTitle = document.getElementById('lightbox-title');
    const lightboxTag = document.getElementById('lightbox-tag');
    const lightboxCounter = document.getElementById('lightbox-counter');
    const lightboxDl = document.getElementById('lightbox-download-link') as HTMLAnchorElement;
    const closeBtn = document.getElementById('lightbox-close-btn');
    const prevBtn = document.getElementById('lightbox-prev-btn');
    const nextBtn = document.getElementById('lightbox-next-btn');

    let currentArtList: { url: string; name: string; tag: string }[] = [];
    let currentIndex = 0;

    // Сбор текущего списка артов со страницы
    const collectArtItems = () => {
      const cards = document.querySelectorAll('.gallery-art-card');
      currentArtList = Array.from(cards).map((card) => ({
        url: card.getAttribute('data-src') || '',
        name: card.getAttribute('data-name') || '',
        tag: card.getAttribute('data-tag') || '',
      })).filter(item => Boolean(item.url));
    };

    // Функция отображения арта по индексу в Lightbox
    const showImage = (index: number) => {
      if (currentArtList.length === 0) return;
      if (index < 0) index = currentArtList.length - 1;
      if (index >= currentArtList.length) index = 0;
      currentIndex = index;

      const item = currentArtList[currentIndex];
      if (!item) return;

      if (lightboxImg) lightboxImg.src = item.url;
      if (lightboxTitle) lightboxTitle.textContent = item.name;
      if (lightboxTag) lightboxTag.textContent = item.tag;
      if (lightboxDl) lightboxDl.href = item.url;
      if (lightboxCounter) {
        lightboxCounter.textContent = `${currentIndex + 1} / ${currentArtList.length}`;
      }
    };

    // Функция привязки кликов на карточки для открытия Lightbox
    const attachCardClickListeners = () => {
      collectArtItems();
      const cards = document.querySelectorAll('.gallery-art-card');
      cards.forEach((card, index) => {
        card.addEventListener('click', () => {
          currentIndex = index;
          showImage(currentIndex);
          if (lightbox) {
            lightbox.classList.add('active');
            document.body.style.overflow = 'hidden';
          }
        });
      });
    };

    // Закрытие Lightbox
    const closeLightbox = () => {
      if (lightbox) {
        lightbox.classList.remove('active');
        document.body.style.overflow = '';
      }
    };

    if (closeBtn) closeBtn.addEventListener('click', closeLightbox);
    if (prevBtn) {
      prevBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        showImage(currentIndex - 1);
      });
    }
    if (nextBtn) {
      nextBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        showImage(currentIndex + 1);
      });
    }

    if (lightbox) {
      lightbox.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).classList.contains('lightbox-overlay')) {
          closeLightbox();
        }
      });
    }

    // Управление клавишами: Стрелка влево, Стрелка вправо, Escape
    document.addEventListener('keydown', (e) => {
      if (!lightbox || !lightbox.classList.contains('active')) return;

      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        showImage(currentIndex - 1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        showImage(currentIndex + 1);
      } else if (e.key === 'Escape') {
        closeLightbox();
      }
    });

    // Проверяем существующие SSR карточки
    const existingCards = document.querySelectorAll('.gallery-art-card');
    if (existingCards.length > 0) {
      if (loader) loader.style.display = 'none';
      attachCardClickListeners();
    } else {
      // Клиентский fetch к /api/arts при отсутствии карточек в SSR
      if (loader) loader.style.display = 'flex';
      fetch('/api/arts')
        .then((res) => res.json())
        .then((data) => {
          if (loader) loader.style.display = 'none';

          if (data?.items && Array.isArray(data.items) && data.items.length > 0) {
            if (totalCountEl) totalCountEl.textContent = data.items.length;

            if (grid) {
              grid.innerHTML = data.items
                .map(
                  (item: any, idx: number) => `
                <article class="gallery-art-card" data-index="${idx}" data-src="${item.url}" data-name="${item.name}" data-tag="${item.tag}">
                  <div class="deco-bracket br-top-left"></div>
                  <div class="deco-bracket br-top-right"></div>
                  <div class="deco-bracket br-bot-left"></div>
                  <div class="deco-bracket br-bot-right"></div>

                  <div class="art-img-box">
                    <img src="${item.url}" alt="${item.name}" class="art-real-img" loading="lazy" />
                    <div class="art-overlay-sheen"></div>
                    <div class="art-zoom-cue">
                      <span class="zoom-icon">🔍</span>
                    </div>
                  </div>

                  <div class="art-card-info">
                    <span class="art-card-tag">${item.tag}</span>
                    <h3 class="art-card-name" title="${item.name}">${item.name}</h3>
                  </div>
                </article>
              `
                )
                .join('');
            }
            attachCardClickListeners();
          } else {
            if (emptyState) emptyState.style.display = 'block';
          }
        })
        .catch((err) => {
          console.error('Ошибка загрузки артов из /api/arts:', err);
          if (loader) loader.style.display = 'none';
          if (emptyState) emptyState.style.display = 'block';
        });
    }
  });
</script>

<style>
  .gallery-page-header {
    text-align: center;
    margin-bottom: 1.5rem;
  }

  .artdeco-filigree {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    margin-bottom: 0.8rem;
  }
  .filigree-line {
    flex: 1;
    max-width: 140px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--accent-gold), transparent);
  }
  .filigree-glyph {
    color: var(--accent-gold);
    font-size: 0.9rem;
    letter-spacing: 4px;
    text-shadow: 0 0 10px var(--gold-glow);
  }

  .gallery-main-title {
    font-size: 2.8rem;
    margin-bottom: 0.4rem;
    color: #fff;
    background: linear-gradient(135deg, #ffffff 40%, var(--accent-gold) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    text-shadow: 0 0 25px rgba(245, 208, 97, 0.3);
  }

  .gallery-subtitle {
    color: var(--text-muted);
    font-size: 1.05rem;
    font-style: italic;
    margin: 0 0 1.2rem;
  }

  .gallery-count-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(28, 14, 46, 0.8);
    border: 1px solid rgba(245, 208, 97, 0.3);
    padding: 6px 20px;
    border-radius: 999px;
    font-size: 0.88rem;
    color: #e5def0;
    font-family: monospace;
    box-shadow: 0 0 15px rgba(245, 208, 97, 0.1);
  }
  .badge-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 8px #22c55e;
    animation: live-pulse 2s infinite ease-in-out;
  }
  @keyframes live-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(0.85); }
  }
  .gallery-count-badge strong {
    color: var(--accent-gold);
    font-size: 1rem;
  }

  /* Спинер загрузки */
  .gallery-loader {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    padding: 3rem 1rem;
    color: var(--accent-gold);
    font-family: monospace;
    font-size: 0.95rem;
  }
  .spinner-core {
    width: 44px;
    height: 44px;
    border: 3px solid rgba(245, 208, 97, 0.2);
    border-top-color: var(--accent-gold);
    border-radius: 50%;
    animation: spin-r2 1s linear infinite;
  }
  @keyframes spin-r2 {
    to { transform: rotate(360deg); }
  }

  /* Сетка галереи */
  .gallery-masonry-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 24px;
    margin: 2rem 0;
  }

  .gallery-art-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: linear-gradient(135deg, rgba(26, 12, 44, 0.88) 0%, rgba(12, 6, 22, 0.95) 100%);
    border: 1px solid rgba(245, 208, 97, 0.25);
    border-radius: 14px;
    overflow: hidden;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.7);
    transition: all 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
    cursor: pointer;
  }
  .gallery-art-card:hover {
    transform: translateY(-6px);
    border-color: var(--accent-gold);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.85), 0 0 25px var(--gold-glow);
  }

  /* Угловые арт-деко скобы */
  .deco-bracket {
    position: absolute;
    width: 12px;
    height: 12px;
    border-color: rgba(245, 208, 97, 0.4);
    border-style: solid;
    pointer-events: none;
    z-index: 5;
    transition: all 0.25s ease;
  }
  .br-top-left { top: 6px; left: 6px; border-width: 2px 0 0 2px; }
  .br-top-right { top: 6px; right: 6px; border-width: 2px 2px 0 0; }
  .br-bot-left { bottom: 6px; left: 6px; border-width: 0 0 2px 2px; }
  .br-bot-right { bottom: 6px; right: 6px; border-width: 0 2px 2px 0; }

  .gallery-art-card:hover .deco-bracket {
    border-color: var(--accent-gold);
    box-shadow: 0 0 8px var(--accent-gold);
  }

  .art-img-box {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #090511;
  }
  .art-real-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }
  .gallery-art-card:hover .art-real-img {
    transform: scale(1.06);
  }

  .art-overlay-sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(12, 6, 22, 0.95) 0%, transparent 40%);
    pointer-events: none;
  }

  .art-zoom-cue {
    position: absolute;
    top: 14px;
    right: 14px;
    background: rgba(12, 6, 22, 0.8);
    border: 1px solid rgba(245, 208, 97, 0.4);
    width: 34px;
    height: 34px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.9rem;
    opacity: 0;
    transform: scale(0.8);
    transition: all 0.25s ease;
    pointer-events: none;
  }
  .gallery-art-card:hover .art-zoom-cue {
    opacity: 1;
    transform: scale(1);
  }

  .art-card-info {
    padding: 1rem 1.2rem;
    display: flex;
    flex-direction: column;
    gap: 4px;
    position: relative;
    z-index: 2;
  }
  .art-card-tag {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--energy-purple-bright);
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  .art-card-name {
    margin: 0;
    font-size: 1.05rem;
    color: #fff;
    font-family: var(--font-heading);
    letter-spacing: 0.5px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .gallery-empty-state {
    text-align: center;
    padding: 4rem 1rem;
    color: var(--text-muted);
  }
  .empty-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
  }

  /* Полноэкранный Lightbox */
  .art-lightbox {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .art-lightbox.active {
    opacity: 1;
    pointer-events: auto;
  }
  .lightbox-overlay {
    position: absolute;
    inset: 0;
    background: rgba(5, 2, 10, 0.94);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  /* Стрелки переключения */
  .lightbox-arrow-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(26, 12, 44, 0.85);
    border: 1px solid var(--accent-gold);
    color: var(--accent-gold);
    width: 58px;
    height: 58px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 10001;
    box-shadow: 0 0 25px rgba(0, 0, 0, 0.8), 0 0 15px var(--gold-glow);
    transition: all 0.25s ease;
  }
  .lightbox-arrow-btn:hover {
    background: linear-gradient(135deg, var(--accent-gold) 0%, #caa43a 100%);
    color: #06040a;
    transform: translateY(-50%) scale(1.12);
    box-shadow: 0 0 35px var(--accent-gold);
  }
  .arrow-prev {
    left: 28px;
  }
  .arrow-next {
    right: 28px;
  }

  .lightbox-content {
    position: relative;
    z-index: 10000;
    max-width: 88vw;
    max-height: 92vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    background: linear-gradient(135deg, rgba(28, 14, 46, 0.96) 0%, rgba(12, 6, 22, 0.98) 100%);
    border: 2px solid var(--accent-gold);
    border-radius: 18px;
    padding: 1.5rem 1.8rem 1.2rem;
    box-shadow: 0 0 60px rgba(0, 0, 0, 0.95), 0 0 30px var(--gold-glow);
    animation: zoom-in-modal 0.3s ease-out;
  }
  @keyframes zoom-in-modal {
    from { transform: scale(0.94); opacity: 0; }
    to { transform: scale(1); opacity: 1; }
  }

  .lightbox-close {
    position: absolute;
    top: 10px;
    right: 18px;
    background: transparent;
    border: none;
    color: var(--accent-gold);
    font-size: 2.2rem;
    cursor: pointer;
    line-height: 1;
    transition: transform 0.2s, color 0.2s;
  }
  .lightbox-close:hover {
    color: #fff;
    transform: scale(1.25);
  }

  .lightbox-image-wrap {
