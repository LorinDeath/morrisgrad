---
import Layout from '../../layouts/Layout.astro';

export const prerender = false;

const { id } = Astro.params;

// 1. Подключение к БД
const cfRuntime = (Astro.locals as any)?.runtime;
const env = cfRuntime?.env as any;
const db = env?.PROFILES_DB;

if (!db) {
    return new Response("Database error", { status: 500 });
}

// 2. Загрузка данных (Только чтение)
const user = await db.prepare('SELECT * FROM users WHERE id = ?').bind(id).first();

if (!user) {
    return new Response("Пользователь не найден", { status: 404 });
}

// 3. Загрузка инвентаря
const { results: inventory } = await db.prepare('SELECT * FROM inventory WHERE user_id = ?').bind(id).all();
---

<Layout title={`Профиль: ${user.username}`}>
    <main class="container profile-page">
        
        <!-- Шапка профиля (Только просмотр) -->
        <div class="profile-header">
            <div class="avatar-section">
                <img src={user.avatar_url || `https://api.dicebear.com/9.x/bottts-neutral/svg?seed=${id}`} alt="Avatar" class="profile-avatar" />
            </div>
            
            <div class="info-section">
                <h1 class="username">{user.username || 'Без имени'}</h1>
                <p class="user-id">ID: <span class="code">{id?.slice(0, 10)}...</span></p>
                
                <div class="bio-box">
                    <span class="bio-label">ЛИЧНОЕ ДЕЛО:</span>
                    <p class="user-bio">{user.description || "Информация засекречена."}</p>
                </div>

                <div class="stats-row">
                    <div class="stat">
                        <span class="label">В городе с:</span>
                        <span class="val">{user.created_at ? new Date(user.created_at).toLocaleDateString('ru-RU') : 'Неизвестно'}</span>
                    </div>
                    <div class="stat">
                        <span class="label">Был(а):</span>
                        <span class="val">{user.last_seen ? new Date(user.last_seen).toLocaleDateString('ru-RU') : 'Давно'}</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="shimmer-line"></div>

        <!-- Инвентарь (Только просмотр) -->
        <div class="inventory-section">
            <h2>Инвентарь Оператора</h2>
            <div class="inventory-grid">
                {inventory && inventory.length > 0 ? (
                    inventory.map((item: any) => (
                        <div class="inv-card">
                            <div class="inv-icon">📦</div>
                            <div class="inv-name">{item.item_id}</div>
                            <div class="inv-count">x{item.amount}</div>
                        </div>
                    ))
                ) : (
                    <div class="empty-state">Хранилище пусто.</div>
                )}
            </div>
        </div>

        <a href="/" class="back-link">← В город</a>
    </main>
</Layout>

<style>
    .profile-page { padding-top: 40px; color: #fff; }
    
    .profile-header {
        display: flex; gap: 30px; background: rgba(255, 255, 255, 0.03);
        padding: 30px; border-radius: 16px; border: 1px solid rgba(255, 255, 255, 0.1);
        flex-wrap: wrap; align-items: center;
    }
    
    .profile-avatar {
        width: 150px; height: 150px; border-radius: 12px;
        border: 2px solid #ffd700; box-shadow: 0 0 20px rgba(255, 215, 0, 0.2);
        object-fit: cover;
    }
    
    .info-section { flex: 1; min-width: 300px; }
    .username { margin: 0; font-size: 2.5rem; color: #ffd700; text-transform: uppercase; letter-spacing: 2px; }
    .user-id { color: #666; font-size: 0.9rem; margin-bottom: 20px; }
    .code { font-family: monospace; background: #222; padding: 2px 6px; border-radius: 4px; }
    
    .bio-box { background: rgba(0,0,0,0.3); padding: 15px; border-radius: 8px; border-left: 3px solid #0ff; margin-bottom: 20px; }
    .bio-label { font-size: 0.7rem; color: #0ff; display: block; margin-bottom: 5px; letter-spacing: 1px; }
    .user-bio { margin: 0; color: #eee; font-style: italic; line-height: 1.4; }

    .stats-row { display: flex; gap: 20px; font-size: 0.85rem; color: #888; }
    .stat .val { color: #fff; margin-left: 5px; }

    .inventory-section { margin-top: 40px; }
    .inventory-section h2 { color: #ffd700; margin-bottom: 20px; font-size: 1.5rem; }
    
    .inventory-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 15px; }
    .inv-card {
        background: rgba(255,255,255,0.05); border: 1px solid #333; border-radius: 8px;
        padding: 20px; text-align: center; transition: transform 0.2s;
    }
    .inv-card:hover { transform: translateY(-5px); border-color: #ffd700; }
    .inv-icon { font-size: 2rem; margin-bottom: 10px; }
    .inv-name { font-weight: bold; font-size: 0.9rem; }
    .inv-count { color: #888; font-size: 0.8rem; margin-top: 5px; }
    .empty-state { color: #666; font-style: italic; grid-column: 1 / -1; text-align: center; padding: 40px; }
    
    .back-link { display: inline-block; margin-top: 40px; color: #666; text-decoration: none; }
    .back-link:hover { color: #fff; }
</style>
```

### Как это работает:
1.  **Личный кабинет (`/profile`)**:
   *   Ты видишь своё описание текстом (как оно выглядит для других).
   *   Ниже есть форма, где его можно поменять.
   *   Появилась кнопка **"👁️ Посмотреть как видят другие"**.
2.  **Публичный профиль (`/u/user_123...`)**:
   *   Открывается по кнопке или прямой ссылке.
   *   Показывает аватар, ник, описание, дату регистрации и инвентарь.
   *   **Нет кнопок редактирования**. Даже если ты хозяин профиля, на этой странице ты просто зритель.

Теперь у каждого пользователя есть своя уникальная ссылка, которую можно скинуть другу!
