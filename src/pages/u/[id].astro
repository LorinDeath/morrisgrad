---
import Layout from '../../layouts/Layout.astro';

export const prerender = false;

const { id } = Astro.params;

// 1. Подключение к БД
const cfRuntime = (Astro.locals as any)?.runtime;
const env = cfRuntime?.env as any;
const db = env?.PROFILES_DB;

if (!db) {
    return new Response("Database error", { status: 500 });
}

// МИГРАЦИЯ: Убеждаемся, что колонка hellfire существует (для старых баз)
try { await db.prepare("ALTER TABLE users ADD COLUMN hellfire INTEGER DEFAULT 0").run(); } catch (e) {}

// 2. Загрузка данных (Только чтение)
const user = await db.prepare('SELECT * FROM users WHERE id = ?').bind(id).first();

if (!user) {
    return new Response("Пользователь не найден", { status: 404 });
}

// 3. Загрузка инвентаря (Последние 10)
const invRes = await db.prepare('SELECT * FROM user_items WHERE user_id = ? ORDER BY created_at DESC LIMIT 10').bind(id).all();
const inventory = (invRes?.results || []).map((item: any) => ({
    ...item,
    stats: typeof item.stats === 'string' ? JSON.parse(item.stats) : (item.stats || {}),
    setId: item.set_id,
    setStats: typeof item.set_stats === 'string' ? JSON.parse(item.set_stats) : (item.set_stats || {})
}));
---

<Layout title={`Профиль: ${user.username}`}>
    <main class="container profile-page">
        
        <!-- Шапка профиля (Только просмотр) -->
        <div class="profile-header">
            <div class="avatar-section">
                <img src={user.avatar_url || `https://api.dicebear.com/9.x/bottts-neutral/svg?seed=${id}`} alt="Avatar" class="profile-avatar" />
            </div>
            
            <div class="info-section">
                <h1 class="username">{user.username || 'Без имени'}</h1>
                <p class="user-id">ID: <span class="code">{id?.slice(0, 10)}...</span></p>
                
                <div class="bio-box">
                    <span class="bio-label">ЛИЧНОЕ ДЕЛО:</span>
                    <p class="user-bio">{user.description || "Информация засекречена."}</p>
                </div>

                <div style="color: #a020f0; font-weight: bold; margin-bottom: 15px; text-shadow: 0 0 10px #a020f0;">🔥 АДСКИЙ ОГОНЬ: {user.hellfire || 0}</div>

                <div class="stats-row">
                    <div class="stat">
                        <span class="label">В городе с:</span>
                        <span class="val">{user.created_at ? new Date(user.created_at).toLocaleDateString('ru-RU') : 'Неизвестно'}</span>
                    </div>
                    <div class="stat">
                        <span class="label">Был(а):</span>
                        <span class="val">{user.last_seen ? new Date(user.last_seen).toLocaleDateString('ru-RU') : 'Давно'}</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="shimmer-line"></div>

        <!-- Инвентарь (Только просмотр) -->
        <div class="inventory-section">
            <h2>Инвентарь Оператора (Последние 10)</h2>
            <div class="inventory-grid">
                {inventory && inventory.length > 0 ? (
                    inventory.map((item: any) => (
                        <div class={`inv-card rarity-${item.rarity || 'common'}`} data-json={JSON.stringify(item)}>
                            <div class="inv-icon">
                                {item.icon && item.icon.startsWith('http') ? 
                                    <img src={item.icon} alt={item.name} style="width: 100%; height: 100%; object-fit: cover; border-radius: 4px;" /> 
                                    : (item.icon || '📦')}
                            </div>
                            <div class="inv-name" style={item.rarity === 'legendary' ? 'color: #ffd700' : item.rarity === 'mythic' ? 'color: #ff3333' : item.rarity === 'divine' ? 'color: #00ffff' : item.rarity === 'epic' ? 'color: #a020f0' : item.rarity === 'rare' ? 'color: #00f' : 'color: #fff'}>{item.name}</div>
                            <div class="inv-count">{item.type ? item.type.toUpperCase() : 'ITEM'}</div>
                        </div>
                    ))
                ) : (
                    <div class="empty-state">Хранилище пусто.</div>
                )}
            </div>
        </div>

        <a href="/" class="back-link">← В город</a>
    </main>

    <!-- Модальное окно предмета -->
    <div id="item-modal" class="modal hidden">
        <div class="modal-content">
            <span class="close-modal">&times;</span>
            <div class="item-header">
                <div id="modal-icon" class="item-icon-large"></div>
                <div class="item-title-block">
                    <h2 id="modal-name">Название</h2>
                    <div id="modal-rarity" class="item-rarity-badge">RARITY</div>
                </div>
            </div>
            <div class="item-body">
                <p id="modal-source" class="item-source">Источник: ...</p>
                <p id="modal-desc" class="item-desc">Описание...</p>
                <div class="shimmer-line"></div>
                <div id="modal-stats" class="item-stats-list"></div>
            </div>
        </div>
    </div>
</Layout>

<style>
    .profile-page { padding-top: 40px; color: #fff; }
    
    .profile-header {
        display: flex; gap: 30px; background: rgba(255, 255, 255, 0.03);
        padding: 30px; border-radius: 16px; border: 1px solid rgba(255, 255, 255, 0.1);
        flex-wrap: wrap; align-items: center;
    }
    
    .profile-avatar {
        width: 150px; height: 150px; border-radius: 12px;
        border: 2px solid #ffd700; box-shadow: 0 0 20px rgba(255, 215, 0, 0.2);
        object-fit: cover;
    }
    
    .info-section { flex: 1; min-width: 300px; }
    .username { margin: 0; font-size: 2.5rem; color: #ffd700; text-transform: uppercase; letter-spacing: 2px; }
    .user-id { color: #666; font-size: 0.9rem; margin-bottom: 20px; }
    .code { font-family: monospace; background: #222; padding: 2px 6px; border-radius: 4px; }
    
    .bio-box { background: rgba(0,0,0,0.3); padding: 15px; border-radius: 8px; border-left: 3px solid #0ff; margin-bottom: 20px; }
    .bio-label { font-size: 0.7rem; color: #0ff; display: block; margin-bottom: 5px; letter-spacing: 1px; }
    .user-bio { margin: 0; color: #eee; font-style: italic; line-height: 1.4; }

    .stats-row { display: flex; gap: 20px; font-size: 0.85rem; color: #888; }
    .stat .val { color: #fff; margin-left: 5px; }

    .inventory-section { margin-top: 40px; }
    .inventory-section h2 { color: #ffd700; margin-bottom: 20px; font-size: 1.5rem; }
    
    .inventory-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 15px; }
    .inv-card {
        background: rgba(0,0,0,0.6); border: 1px solid #333; border-radius: 8px;
        aspect-ratio: 1; padding: 5px; text-align: center; transition: transform 0.2s, box-shadow 0.2s;
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        cursor: pointer; position: relative; overflow: hidden;
    }
    .inv-card:hover { transform: translateY(-5px); z-index: 2; }
    .inv-icon { font-size: 2.5rem; margin-bottom: 5px; }
    .inv-name { font-weight: bold; font-size: 0.7rem; width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding: 0 5px; }
    .inv-count { color: #666; font-size: 0.7rem; margin-top: 5px; }
    .empty-state { color: #666; font-style: italic; grid-column: 1 / -1; text-align: center; padding: 40px; }
    
    .back-link { display: inline-block; margin-top: 40px; color: #666; text-decoration: none; }
    .back-link:hover { color: #fff; }

    /* Rarities */
    .rarity-common { border-color: #fff; }
    .rarity-rare { border-color: #00f; box-shadow: inset 0 0 10px rgba(0,0,255,0.2); }
    .rarity-epic { border-color: #a020f0; box-shadow: inset 0 0 10px rgba(160,32,240,0.2); }
    .rarity-legendary { border-color: #ffd700; box-shadow: inset 0 0 10px rgba(255,215,0,0.2); animation: glow 2s infinite; }
    .rarity-mythic { border-color: #ff3333; box-shadow: inset 0 0 15px rgba(255,51,51,0.3); }
    .rarity-divine { border-color: #00ffff; box-shadow: inset 0 0 15px #00ffff; animation: glow 1s infinite alternate; }
    
    @keyframes glow { 0% { box-shadow: inset 0 0 5px currentColor; } 50% { box-shadow: inset 0 0 20px currentColor; } 100% { box-shadow: inset 0 0 5px currentColor; } }

    /* Modal Styles */
    .modal { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); display: flex; justify-content: center; align-items: center; z-index: 1000; backdrop-filter: blur(5px); }
    .modal.hidden { display: none; }
    .modal-content { background: #111; border: 1px solid #444; width: 400px; max-width: 90%; padding: 30px; border-radius: 12px; position: relative; box-shadow: 0 0 50px rgba(0,0,0,0.8); }
    .close-modal { position: absolute; top: 10px; right: 20px; font-size: 2rem; cursor: pointer; color: #666; }
    .close-modal:hover { color: #fff; }

    .item-header { display: flex; gap: 20px; align-items: center; margin-bottom: 20px; }
    .item-icon-large { font-size: 4rem; background: rgba(255,255,255,0.05); width: 80px; height: 80px; display: flex; align-items: center; justify-content: center; border-radius: 8px; border: 1px solid #333; }
    .item-title-block h2 { margin: 0; font-size: 1.5rem; color: #fff; }
    .item-rarity-badge { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 0.7rem; font-weight: bold; margin-top: 5px; text-transform: uppercase; background: #333; }
    
    .item-source { color: #888; font-size: 0.8rem; font-style: italic; margin-bottom: 10px; }
    .item-desc { color: #ccc; line-height: 1.4; margin-bottom: 20px; }
    
    .item-stats-list { display: flex; flex-direction: column; gap: 8px; }
    :global(.stat-row) { display: flex; justify-content: space-between; border-bottom: 1px solid #222; padding-bottom: 4px; }
    :global(.stat-key) { color: #aaa; }
    :global(.stat-val) { color: #0ff; font-weight: bold; }
</style>

<script>
document.addEventListener('astro:page-load', () => {
    const modal = document.getElementById('item-modal');
    const closeBtn = document.querySelector('.close-modal');

    function getColor(rarity: string) {
        const colors: any = { common: '#fff', rare: '#00f', epic: '#a020f0', legendary: '#ffd700', mythic: '#ff3333', divine: '#00ffff' };
        return colors[rarity] || '#fff';
    }

    document.querySelectorAll('.inv-card').forEach(card => {
        card.addEventListener('click', () => {
            const json = card.getAttribute('data-json');
            if (json) {
                const item = JSON.parse(json);
                openModal(item);
            }
        });
    });

    function openModal(item: any) {
        if (!modal) return;
        
        const iconEl = document.getElementById('modal-icon');
        const nameEl = document.getElementById('modal-name');
        const rarityEl = document.getElementById('modal-rarity');
        const sourceEl = document.getElementById('modal-source');
        const descEl = document.getElementById('modal-desc');
        const statsEl = document.getElementById('modal-stats');
        
        if (iconEl) {
            if (item.icon && item.icon.startsWith('http')) {
                iconEl.innerHTML = `<img src="${item.icon}" style="width: 100%; height: 100%; object-fit: cover; border-radius: 6px;">`;
            } else {
                iconEl.innerText = item.icon || '📦';
            }
            iconEl.className = `item-icon-large rarity-${item.rarity}`;
            iconEl.style.borderColor = getColor(item.rarity);
            iconEl.style.boxShadow = `0 0 15px ${getColor(item.rarity)}`;
        }
        if (nameEl) {
            nameEl.innerText = item.name;
            nameEl.style.color = getColor(item.rarity);
        }
        if (rarityEl) {
            rarityEl.innerText = item.rarity;
            rarityEl.style.color = getColor(item.rarity);
            rarityEl.style.borderColor = getColor(item.rarity);
            rarityEl.style.background = 'rgba(0,0,0,0.5)';
        }
        if (sourceEl) {
            sourceEl.innerHTML = `Источник: ${item.source || 'Неизвестно'}`;
            if (item.setId) {
                sourceEl.innerHTML += `<br><span style="color:#0f0; font-weight:bold; text-shadow: 0 0 5px #0f0;">СЕТ: ${item.setId.toUpperCase()}</span>`;
            }
        }
        if (descEl) descEl.innerText = item.description || "Нет описания";
        
        if (statsEl) {
            statsEl.innerHTML = '';
            if (item.stats) {
                for (const [key, val] of Object.entries(item.stats)) {
                    const row = document.createElement('div');
                    row.className = 'stat-row';
                    row.innerHTML = `<span class="stat-key">${key.toUpperCase()}</span><span class="stat-val">+${val}</span>`;
                    statsEl.appendChild(row);
                }
            }
            if (item.setStats) {
                const row = document.createElement('div');
                row.innerHTML = `<div style="color:#0f0; margin-top:5px; border-top:1px dashed #333;">СЕТОВЫЕ БОНУСЫ:</div>`;
                statsEl.appendChild(row);
                for (const [key, val] of Object.entries(item.setStats)) {
                    const r = document.createElement('div');
                    r.className = 'stat-row';
                    r.innerHTML = `<span class="stat-key" style="color:#0f0">${key.toUpperCase()}</span><span class="stat-val" style="color:#0f0">+${val}</span>`;
                    statsEl.appendChild(r);
                }
            }
        }

        modal.classList.remove('hidden');
    }

    if (closeBtn) closeBtn.addEventListener('click', () => modal?.classList.add('hidden'));
    if (modal) modal.addEventListener('click', (e) => {
        if (e.target === modal) modal.classList.add('hidden');
    });
});
</script>