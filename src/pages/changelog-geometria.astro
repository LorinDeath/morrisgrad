---
import Layout from '../layouts/Layout.astro';

const updates = [
  {
    version: "v1.1.0",
    date: "30.09.2026",
    title: "МЕГА-ОБНОВЛЕНИЕ: ПОЛНЫЙ ВАМПАРИК & БЕЗУМИЕ ПРОКАЧКИ",
    description: "Колоссальное расширение арсенала: 20 видов оружия, 10 эволюций, 20 пассивных модулей и 4 революционные механики прогресса!",
    changes: [
      "🐛 БАГФИКС: Исправлено застревание модального окна смерти при нажатии на «Главное меню» и «В Лабораторию». Цикл анимации теперь корректно сбрасывается.",
      "⚔️ 20 ВИДОВ ОРУЖИЯ: Игольчатый Излучатель, Орбитальные Диски, Искатели Пустоты, Фрактальные Мины, Кольцо Сингулярности, Тесла-Полигон, Призматический Луч, Гео-Сюрикен, Гравитационная Воронка, Плазменная Мортира, Гекса-Дрон, Звуковые Кольца, Зеркальный Бумеранг, Ядовитая Матрица, Метеоритный Ливень, Лазерный Спутник, Крио-Шипы, Пила Измерений, Кластерная Граната, Искра Хаоса.",
      "💥 10 ЭВОЛЮЦИЙ В СВЕРХОРУЖИЕ: Фотонный Рельсотрон, Горизонт Событий, Квантовый Рой, Сверхновая Тетраэдра, Цунами Энтропии, Матрица Громовержца, Призма Смерти, Бесконечный Рикошет, Истинная Черная Дыра, Орбитальный Катаклизм.",
      "🛡️ 20 ПАССИВНЫХ МОДУЛЕЙ: от Кинетического Вектора и Кристаллической Брони до Фазового Разветвителя (+1 снаряд ко всем орудиям!), Вампиризма, Энергощита, Хроно-Дилатации и Резонатора Берсерка.",
      "🔥 МЕХАНИКА 1 — ГИПЕР-РЕЗОНАНС: каждые 25 комбо ядро входит в состояние Овердрайва на 6 сек (удвоенная скорострельность, неоновые шлейфы, x2 крит-урон).",
      "🚫 МЕХАНИКА 2 — МАТРИЦА ИЗГНАНИЯ (BANISH): возможность навсегда вычеркнуть нежелательную карточку из пула выбора прямо во время левел-апа!",
      "🔮 МЕХАНИКА 3 — ПАКТЫ ИЗМЕРЕНИЙ: после победы над каждым Боссом выбирайте одну из 3 экстремальных квантовых мутаций с мощными благословениями и проклятиями.",
      "⚛️ МЕХАНИКА 4 — ДРЕВО РЕАКТОРА: в Лаборатории открыто разветвленное Древо Мастерства (Штурм, Бастион, Сингулярность) с глобальными перманентными узлами.",
      "🎒 ИНВЕНТАРЬ 6+6: классический вампирский интерфейс в HUD — до 6 активных орудий и до 6 пассивных предметов одновременно."
    ]
  },
  {
    version: "v1.0.0",
    date: "30.09.2026",
    title: "РЕЛИЗ: ГЕОМЕТРИЯ ХАОСА",
    description: "Первый релиз экшен-роглайта на чистой неоновой SVG-графике с динамической шкалой сложностей x1..x64^.",
    changes: [
      "⚡ SVG РЕНДЕРЕР: Вся игра отрисована на векторной геометрии с динамическими фильтрами свечения.",
      "🔥 МНОЖИТЕЛИ СЛОЖНОСТИ (x1..x64^): от евклидова баланса до экстремального Bullet Hell Danmaku.",
      "🔷 4 БОЕВЫХ ЯДРА: Дельта-3, Тетра-4, Гекса-6, Окта-8 с уникальными ультимейтами.",
      "💎 ЛАБОРАТОРИЯ КВАНТОВОГО ЯДРА: Перманентная мета-прокачка за осколки.",
      "🎵 WEB AUDIO СИНТЕЗАТОР: Процедурный саундтрек и звуковые эффекты без внешних файлов."
    ]
  }
];
---

<Layout title="История обновлений | Геометрия Хаоса">
  <main class="container">
    <div class="header-section">
      <a href="/games" class="back-btn">← Назад к играм</a>
      <h1 class="comic-title">ПАТЧНОУТ: ГЕОМЕТРИЯ ХАОСА</h1>
    </div>

    <div class="comic-grid">
      {updates.map((update) => (
        <div class="comic-panel">
          <div class="caption-box">
            <span class="version">{update.version}</span>
            <span class="sep">|</span>
            <span class="date">{update.date}</span>
          </div>

          <div class="panel-content">
            <h2 class="update-title">{update.title}</h2>
            <p class="update-desc">{update.description}</p>
            <div class="divider"></div>
            <ul class="changes-list">
              {update.changes.map(change => (
                <li>{change}</li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </main>
</Layout>

<style>
  .header-section {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 2rem 0 3rem 0;
    border-bottom: 4px solid #00ffcc;
    padding-bottom: 1rem;
  }
  .comic-title {
    font-size: 2.2rem;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: 2px;
    text-shadow: 0 0 15px #00ffcc, 0 0 30px #38bdf8;
    margin: 0;
  }
  .back-btn {
    color: #00ffcc;
    text-decoration: none;
    font-weight: bold;
    font-size: 1.1rem;
    transition: transform 0.2s;
  }
  .back-btn:hover { transform: translateX(-5px); }

  .comic-grid {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
    max-width: 850px;
    margin: 0 auto;
  }
  .comic-panel {
    background: #0b0f19;
    border: 2px solid #00ffcc;
    box-shadow: 0 0 25px rgba(0, 255, 204, 0.25);
    position: relative;
    padding: 2rem;
    border-radius: 12px;
    transition: transform 0.3s;
  }
  .comic-panel:hover {
    transform: scale(1.01);
    box-shadow: 0 0 35px rgba(0, 255, 204, 0.4);
  }
  .caption-box {
    position: absolute;
    top: -15px;
    left: 20px;
    background: #06070a;
    color: #00ffcc;
    border: 1px solid #00ffcc;
    padding: 5px 15px;
    font-weight: 900;
    font-family: monospace;
    border-radius: 4px;
  }
  .update-title {
    margin: 0.5rem 0;
    color: #fff;
    font-size: 1.6rem;
    text-shadow: 0 0 10px rgba(0, 255, 204, 0.5);
  }
  .update-desc {
    color: #94a3b8;
    font-style: italic;
    margin-bottom: 1rem;
  }
  .divider {
    height: 1px;
    background: #1e293b;
    margin: 1rem 0;
  }
  .changes-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .changes-list li {
    position: relative;
    padding-left: 1.5rem;
    margin-bottom: 0.8rem;
    color: #e2e8f0;
    line-height: 1.5;
  }
  .changes-list li::before {
    content: '▶';
    position: absolute;
    left: 0;
    color: #00ffcc;
    font-size: 0.8rem;
    top: 2px;
  }
</style>
