---
import Layout from '../layouts/Layout.astro';

// Проверка авторизации на сервере
const { userId } = (Astro.locals as any).auth ? (Astro.locals as any).auth() : { userId: null };
if (!userId) return Astro.redirect('/');
---

<Layout title="Инвентарь Оператора">
    <main class="container inventory-page">
        <div class="inv-header">
            <h1>ЛИЧНОЕ ХРАНИЛИЩЕ</h1>
            <a href="/profile" class="back-link">← В ПРОФИЛЬ</a>
        </div>

        <!-- Фильтры -->
        <div class="filters-bar">
            <div class="filter-group">
                <span class="label">ИСТОЧНИК:</span>
                <button class="filter-btn active" data-filter="source" data-val="all">ВСЕ</button>
                <button class="filter-btn" data-filter="source" data-val="Neon Protocol">NEON PROTOCOL</button>
                <button class="filter-btn" data-filter="source" data-val="Market">РЫНОК</button>
            </div>
            <div class="filter-group">
                <span class="label">ТИП:</span>
                <button class="filter-btn active" data-filter="type" data-val="all">ВСЕ</button>
                <button class="filter-btn" data-filter="type" data-val="weapon">ОРУЖИЕ</button>
                <button class="filter-btn" data-filter="type" data-val="armor">БРОНЯ</button>
                <button class="filter-btn" data-filter="type" data-val="chip">ЧИПЫ</button>
            </div>
        </div>

        <div id="loading" class="loading">Загрузка данных...</div>
        
        <!-- Сетка предметов -->
        <div id="inventory-grid" class="inventory-grid"></div>

        <!-- Модальное окно предмета -->
        <div id="item-modal" class="modal hidden">
            <div class="modal-content">
                <span class="close-modal">&times;</span>
                <div class="item-header">
                    <div id="modal-icon" class="item-icon-large"></div>
                    <div class="item-title-block">
                        <h2 id="modal-name">Название</h2>
                        <div id="modal-rarity" class="item-rarity-badge">RARITY</div>
                    </div>
                </div>
                <div class="item-body">
                    <p id="modal-source" class="item-source">Источник: ...</p>
                    <p id="modal-desc" class="item-desc">Описание...</p>
                    <div class="shimmer-line"></div>
                    <div id="modal-stats" class="item-stats-list"></div>
                </div>
                <div class="item-actions">
                    <button id="btn-transfer" class="action-btn">ОТПРАВИТЬ В ИГРУ</button>
                </div>
            </div>
        </div>
    </main>
</Layout>

<style>
    .inventory-page { padding-top: 40px; color: #fff; min-height: 80vh; }
    .inv-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px; border-bottom: 1px solid #333; padding-bottom: 20px; }
    h1 { color: #ffd700; margin: 0; letter-spacing: 2px; }
    .back-link { color: #888; text-decoration: none; border: 1px solid #444; padding: 5px 15px; border-radius: 4px; transition: all 0.2s; }
    .back-link:hover { color: #fff; border-color: #fff; }

    /* Filters */
    .filters-bar { display: flex; flex-wrap: wrap; gap: 20px; margin-bottom: 30px; background: rgba(255,255,255,0.05); padding: 15px; border-radius: 8px; }
    .filter-group { display: flex; align-items: center; gap: 10px; }
    .label { color: #666; font-size: 0.8rem; font-weight: bold; }
    .filter-btn { 
        background: transparent; border: 1px solid #444; color: #aaa; padding: 5px 10px; 
        cursor: pointer; font-size: 0.8rem; border-radius: 4px; transition: all 0.2s; 
    }
    .filter-btn:hover { border-color: #888; color: #fff; }
    .filter-btn.active { background: #ffd700; color: #000; border-color: #ffd700; font-weight: bold; }

    /* Grid */
    .inventory-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(100px, 1fr)); gap: 15px; }
    .inv-item { 
        background: rgba(0,0,0,0.6); border: 1px solid #333; border-radius: 8px; 
        aspect-ratio: 1; display: flex; flex-direction: column; align-items: center; justify-content: center;
        cursor: pointer; transition: transform 0.2s, box-shadow 0.2s; position: relative; overflow: hidden;
    }
    .inv-item:hover { transform: translateY(-5px); z-index: 2; }
    .inv-item .icon { font-size: 2.5rem; margin-bottom: 5px; }
    .inv-item .name { font-size: 0.7rem; text-align: center; padding: 0 5px; width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .inv-item .type { color: #666; font-size: 0.7rem; margin-top: 5px; }
    
    /* Rarities */
    .rarity-common { border-color: #fff; }
    .rarity-rare { border-color: #00f; box-shadow: inset 0 0 10px rgba(0,0,255,0.2); }
    .rarity-epic { border-color: #a020f0; box-shadow: inset 0 0 10px rgba(160,32,240,0.2); }
    .rarity-legendary { border-color: #ffd700; box-shadow: inset 0 0 10px rgba(255,215,0,0.2); animation: glow 2s infinite; }
    .rarity-mythic { border-color: #ff3333; box-shadow: inset 0 0 15px rgba(255,51,51,0.3); }
    .rarity-divine { border-color: #00ffff; box-shadow: inset 0 0 15px #00ffff; animation: glow 1s infinite alternate; }

    @keyframes glow { 0% { box-shadow: inset 0 0 5px currentColor; } 50% { box-shadow: inset 0 0 20px currentColor; } 100% { box-shadow: inset 0 0 5px currentColor; } }

    .loading { text-align: center; color: #666; margin-top: 50px; }

    /* Modal */
    .modal { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); display: flex; justify-content: center; align-items: center; z-index: 1000; backdrop-filter: blur(5px); }
    .modal.hidden { display: none; }
    .modal-content { background: #111; border: 1px solid #444; width: 400px; max-width: 90%; padding: 30px; border-radius: 12px; position: relative; box-shadow: 0 0 50px rgba(0,0,0,0.8); }
    .close-modal { position: absolute; top: 10px; right: 20px; font-size: 2rem; cursor: pointer; color: #666; }
    .close-modal:hover { color: #fff; }

    .item-header { display: flex; gap: 20px; align-items: center; margin-bottom: 20px; }
    .item-icon-large { font-size: 4rem; background: rgba(255,255,255,0.05); width: 80px; height: 80px; display: flex; align-items: center; justify-content: center; border-radius: 8px; border: 1px solid #333; }
    .item-title-block h2 { margin: 0; font-size: 1.5rem; color: #fff; }
    .item-rarity-badge { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 0.7rem; font-weight: bold; margin-top: 5px; text-transform: uppercase; background: #333; }
    
    .item-source { color: #888; font-size: 0.8rem; font-style: italic; margin-bottom: 10px; }
    .item-desc { color: #ccc; line-height: 1.4; margin-bottom: 20px; }
    
    .item-stats-list { display: flex; flex-direction: column; gap: 8px; }
    .stat-row { display: flex; justify-content: space-between; border-bottom: 1px solid #222; padding-bottom: 4px; }
    .stat-key { color: #aaa; }
    .stat-val { color: #0ff; font-weight: bold; }

    .item-actions { margin-top: 30px; display: flex; justify-content: center; }
    .action-btn { background: #ffd700; color: #000; border: none; padding: 10px 20px; font-weight: bold; cursor: pointer; border-radius: 4px; transition: transform 0.2s; }
    .action-btn:hover { transform: scale(1.05); background: #fff; }
</style>

<script>
    let currentItems: any[] = [];
    let filters = { source: 'all', type: 'all' };

    const grid = document.getElementById('inventory-grid');
    const loading = document.getElementById('loading');
    const modal = document.getElementById('item-modal');

    // Загрузка данных
    async function loadInventory() {
        if (loading) loading.style.display = 'block';
        if (grid) grid.innerHTML = '';
        
        try {
            const params = new URLSearchParams(filters);
            const res = await fetch(`/api/inventory?${params.toString()}`);
            const data = await res.json();
            currentItems = data.items || [];
            renderGrid();
        } catch (e) {
            console.error(e);
            if (grid) grid.innerHTML = '<div style="color:red; text-align:center">Ошибка загрузки</div>';
        } finally {
            if (loading) loading.style.display = 'none';
        }
    }

    function renderGrid() {
        if (!grid) return;
        grid.innerHTML = '';
        
        if (currentItems.length === 0) {
            grid.innerHTML = '<div style="grid-column: 1/-1; text-align:center; color:#666; padding: 50px;">Пусто... Пока что.</div>';
            return;
        }

        currentItems.forEach(item => {
            const el = document.createElement('div');
            el.className = `inv-item rarity-${item.rarity}`;
            el.innerHTML = `
                <div class="icon">${item.icon}</div>
                <div class="name" style="color:${getColor(item.rarity)}">${item.name}</div>
                <div class="type">${item.type ? item.type.toUpperCase() : 'ITEM'}</div>
            `;
            el.onclick = () => openModal(item);
            grid.appendChild(el);
        });
    }

    function getColor(rarity: string) {
        const colors: any = { common: '#fff', rare: '#00f', epic: '#a020f0', legendary: '#ffd700', mythic: '#ff3333', divine: '#00ffff' };
        return colors[rarity] || '#fff';
    }

    function openModal(item: any) {
        if (!modal) return;
        
        const iconEl = document.getElementById('modal-icon');
        const nameEl = document.getElementById('modal-name');
        const rarityEl = document.getElementById('modal-rarity');
        const sourceEl = document.getElementById('modal-source');
        const descEl = document.getElementById('modal-desc');
        const statsEl = document.getElementById('modal-stats');
        
        if (iconEl) {
            iconEl.innerText = item.icon;
            iconEl.className = `item-icon-large rarity-${item.rarity}`;
            iconEl.style.borderColor = getColor(item.rarity);
            iconEl.style.boxShadow = `0 0 15px ${getColor(item.rarity)}`;
        }
        if (nameEl) {
            nameEl.innerText = item.name;
            nameEl.style.color = getColor(item.rarity);
        }
        if (rarityEl) {
            rarityEl.innerText = item.rarity;
            rarityEl.style.color = getColor(item.rarity);
            rarityEl.style.borderColor = getColor(item.rarity);
            rarityEl.style.background = 'rgba(0,0,0,0.5)';
        }
        if (sourceEl) sourceEl.innerText = `Источник: ${item.source}`;
        if (descEl) descEl.innerText = item.description || "Нет описания";
        
        if (statsEl) {
            statsEl.innerHTML = '';
            if (item.stats) {
                for (const [key, val] of Object.entries(item.stats)) {
                    const row = document.createElement('div');
                    row.className = 'stat-row';
                    row.innerHTML = `<span class="stat-key">${key.toUpperCase()}</span><span class="stat-val">+${val}</span>`;
                    statsEl.appendChild(row);
                }
            }
            if (item.setStats) {
                const row = document.createElement('div');
                row.innerHTML = `<div style="color:#0f0; margin-top:5px; border-top:1px dashed #333;">СЕТОВЫЕ БОНУСЫ:</div>`;
                statsEl.appendChild(row);
                for (const [key, val] of Object.entries(item.setStats)) {
                    const r = document.createElement('div');
                    r.className = 'stat-row';
                    r.innerHTML = `<span class="stat-key" style="color:#0f0">${key.toUpperCase()}</span><span class="stat-val" style="color:#0f0">+${val}</span>`;
                    statsEl.appendChild(r);
                }
            }
        }

        modal.classList.remove('hidden');
    }

    // Event Listeners
    document.querySelectorAll('.filter-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
            const target = e.target as HTMLElement;
            const type = target.dataset.filter;
            const val = target.dataset.val;
            
            // Update UI
            target.parentElement?.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
            target.classList.add('active');
            
            // Update State
            if (type === 'source') filters.source = val || 'all';
            if (type === 'type') filters.type = val || 'all';
            
            loadInventory();
        });
    });

    document.querySelector('.close-modal')?.addEventListener('click', () => modal?.classList.add('hidden'));
    modal?.addEventListener('click', (e) => {
        if (e.target === modal) modal.classList.add('hidden');
    });

    // Init
    loadInventory();
</script>
