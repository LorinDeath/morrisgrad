---
import Layout from '../layouts/Layout.astro';

export const prerender = false;

const localsAny = Astro.locals as any;
const env = localsAny.runtime?.env || localsAny.cloudflare?.env || localsAny.env || {};
const db = env.PROFILES_DB;

let stories: Array<{ rowid: number; author: string; name: string; created_at: string }> = [];

if (db) {
  try {
    const { results } = await db.prepare(
      'SELECT rowid, author, name, created_at FROM konkurs ORDER BY rowid DESC'
    ).all();
    stories = (results as typeof stories) || [];
  } catch (error) {
    console.error('Ошибка загрузки рассказов из PROFILES_DB:', error);
  }
}
---

<Layout title="Рассказы | Моррис Град">
  <main class="container">
    <header class="page-header">
      <h1>Рассказы</h1>
      <div class="shimmer-line"></div>
    </header>

    {stories.length === 0 ? (
      <div class="empty-message">
        <p>Рассказов пока нет. Будьте первым, кто подаст заявку!</p>
      </div>
    ) : (
      <div class="stories-grid">
        {stories.map((story) => (
          <a href={`/allkonrass/${story.rowid}`} class="story-card">
            <div class="story-main">
              <h2 class="story-title">{story.name}</h2>
              <p class="story-author">Автор: <span>{story.author}</span></p>
            </div>
            {story.created_at && (
              <span class="story-date">
                {new Date(story.created_at).toLocaleDateString('ru-RU', {
                  day: 'numeric',
                  month: 'long',
                  year: 'numeric'
                })}
              </span>
            )}
          </a>
        ))}
      </div>
    )}
  </main>
</Layout>

<style>
  .page-header {
    margin-bottom: 2rem;
  }

  .stories-grid {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .story-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.5rem;
    background: #18181b;
    border: 1px solid #27272a;
    border-radius: 10px;
    text-decoration: none;
    transition: transform 0.15s ease, border-color 0.15s ease, background 0.15s ease;
  }

  .story-card:hover {
    background: #202024;
    border-color: #dc2626;
    transform: translateY(-2px);
  }

  .story-title {
    margin: 0 0 0.35rem;
    font-size: 1.25rem;
    color: #f4f4f5;
  }

  .story-author {
    margin: 0;
    font-size: 0.9rem;
    color: #a1a1aa;
  }

  .story-author span {
    color: #e4e4e7;
    font-weight: 500;
  }

  .story-date {
    font-size: 0.85rem;
    color: #71717a;
    white-space: nowrap;
    margin-left: 1rem;
  }

  .empty-message {
    padding: 3rem 1rem;
    text-align: center;
    color: #71717a;
  }

  @media (max-width: 640px) {
    .story-card {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }
    .story-date {
      margin-left: 0;
    }
  }
</style>