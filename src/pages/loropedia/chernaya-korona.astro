---
import LpShell from '../../components/loropedia/LpShell.astro';
import LpClosed from '../../components/loropedia/LpClosed.astro';
import { CLOSED_DESCRIPTION, CLOSED_TITLE } from '../../lib/loropedia/guard';
import { pageMode } from '../../lib/loropedia/select';
import crown from '../../data/loropedia/crown.json';

const mode = pageMode(Astro.cookies);
const protect = mode === 'closed';
const spoil = mode === 'spoil';
const desc = '«Моррис Град: Чёрная корона». Книга «Начало»: ночь Фиолетовой Луны, пепел и корона. Путь по частям, спойлеры закрыты.';
function tidy(s: string) {
  const cut = s.replace(/\s+/g, ' ').trim();
  const end = Math.max(cut.lastIndexOf('. '), cut.lastIndexOf('.'));
  if (end > 40 && end < cut.length - 1) return cut.slice(0, end + 1);
  return cut;
}
---
{protect ? (
  <LpShell title={CLOSED_TITLE} description={CLOSED_DESCRIPTION} active="crown" noindex>
    <LpClosed />
  </LpShell>
) : (
<LpShell title="Начало — Моррис Град: Чёрная корона" description={desc} active="crown" crumbs={[['Чёрная корона', '/loropedia/chernaya-korona']]} noindex={spoil}>
  <article class="ck">
    <header class="ck-hero">
      <div class="ck-moon" aria-hidden="true"></div>
      <div class="ck-ash" aria-hidden="true"></div>
      <p class="ck-series">{crown.series}</p>
      <h1 class="ck-title">{crown.book}</h1>
      <p class="ck-crown" aria-hidden="true"><i></i><i></i><i></i></p>
      <p class="ck-by">{crown.authors}</p>
      <p class="ck-ann">{tidy(crown.annotation)}</p>
      <div class="ck-actions">
        <a class="ck-btn" href="#put" data-tip="Перейти к частям книги. Названия глав видны, пересказ закрыт.">Путь по частям</a>
        {crown.bookSlug && <a class="ck-btn ck-btn-ghost" href={`/loropedia/${crown.bookSlug}`} data-tip="Открыть статью энциклопедии об этой книге.">Статья книги</a>}
        {crown.chronoSlug && <a class="ck-btn ck-btn-ghost" href={`/loropedia/${crown.chronoSlug}`} data-tip="Хронология приквела. Поздние события под спойлером.">Хронология</a>}
      </div>
    </header>

    <section class="ck-night" id="noch">
      <h2>Ночь Фиолетовой Луны</h2>
      <p class="ck-safe">{tidy(crown.prologue.blurb)}</p>
      {crown.prologue.slug && <p><a class="lp-link" href={`/loropedia/${crown.prologue.slug}`} data-tip="Открыть статью пролога. Спойлер внутри статьи закрыт.">{crown.prologue.title}</a></p>}
      {crown.prologue.shutter && <div set:html={crown.prologue.shutter} />}
    </section>

    <section class="ck-path" id="put">
      <h2>Путь</h2>
      <p class="ck-safe">Восемь частей и то, что идёт после них. Здесь названия и безопасный контур. Что происходит внутри главы — только в её статье, под закрытым спойлером.</p>
      <ol class="ck-parts">
        {crown.parts.map((part, i) => (
          <li class="ck-part">
            <span class="ck-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{part.published ? <a href={`/loropedia/${part.slug}`} data-tip={`Открыть обзор «${part.title}». Канва части под спойлером.`}>{part.title}</a> : part.title}</h3>
              <p class="ck-range">{part.range}</p>
              <p class="ck-safe">{tidy(part.blurb)}</p>
              <ul class="ck-chapters">
                {part.chapters.map((ch) => (
                  <li>
                    {ch.published && ch.slug
                      ? <a href={`/loropedia/${ch.slug}`} data-tip={`Глава ${ch.n}. Пересказ закрыт, пока вы его не откроете.`}>{ch.title}</a>
                      : <span class="ck-gap" data-tip="Эта глава в открытой энциклопедии не выведена.">Глава {ch.n}</span>}
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="ck-after" id="posle">
      <h2>После шестидесяти четырёх</h2>
      <p class="ck-safe">Эпилог и записи, которые книга ставит следом. Названия без пересказа.</p>
      {crown.epilogueSlug && <p><a class="lp-link" href={`/loropedia/${crown.epilogueSlug}`} data-tip="Обзор эпилога и последних записей. Спойлеры закрыты.">Эпилог и «Последнее зеркало»</a></p>}
      <ul class="ck-chapters">
        {crown.after.map((ch) => (
          <li>
            {ch.published && ch.slug
              ? <a href={`/loropedia/${ch.slug}`} data-tip={`Открыть «${ch.title}». Спойлер внутри статьи закрыт.`}>{ch.title}</a>
              : <span>{ch.title}</span>}
          </li>
        ))}
      </ul>
    </section>
  </article>
</LpShell>
)}
