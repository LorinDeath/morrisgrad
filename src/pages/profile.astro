<Layout title="Профиль Оператора">
    <main class="container profile-page">
        
        <!-- Шапка профиля -->
        <div class="profile-header">
            <div class="avatar-section">
                <!-- Генерируем аватар по ID, если нет своего -->
                <img src={user.avatar_url || `https://api.dicebear.com/9.x/bottts-neutral/svg?seed=${userId}`} alt="Avatar" class="profile-avatar" />
            </div>
            
            <div class="info-section">
                <h1 class="username">{user.username || 'Без имени'}</h1>
                <p class="user-id">ID: <span class="code">{userId.slice(0, 10)}...</span></p>
                
                <!-- Отображение описания текстом -->
                <p class="user-bio">{user.description || "Нет описания"}</p>

                <div style="color: #a020f0; font-weight: bold; margin-bottom: 15px; text-shadow: 0 0 10px #a020f0;">🔥 АДСКИЙ ОГОНЬ: {user.hellfire || 0}</div>

                <a href={`/u/${userId}`} class="public-btn" target="_blank">👁️ Посмотреть как видят другие</a>
                <a href="/inventory" class="public-btn" style="border-color: #ffd700; color: #ffd700; margin-left: 10px;">📦 Полный Инвентарь</a>
                
                {message && (
                    <div class={`alert ${messageType}`}>
                        {message}
                    </div>
                )}
                
                <form method="POST" class="desc-form" enctype="multipart/form-data">
                    <div class="form-group">
                        <label for="username">Позывной (Никнейм):</label>
                        <input type="text" id="username" name="username" value={user.username} placeholder="Введите имя" required maxlength="20" />
                    </div>

                    <div class="form-group">
                        <label for="description">Личное дело (макс 50):</label>
                        <input type="text" id="description" name="description" value={user.description || ''} placeholder="Краткий статус..." maxlength="50" />
                    </div>
                    
                    <div class="form-group">
                        <label for="avatar_file">Загрузить аватар (Макс 5МБ):</label>
                        <input type="file" id="avatar_file" name="avatar_file" accept="image/png, image/jpeg" />
                        <small>Рекомендуется квадратное изображение (1000x1000)</small>
                    </div>

                    <button type="submit" class="save-btn">СОХРАНИТЬ ДАННЫЕ</button>
                </form>
            </div>
        </div>

        <div class="shimmer-line"></div>

        <!-- Секция инвентаря -->
        <div class="inventory-section">
            <h2>Хранилище предметов (Последние 10)</h2>
            <div class="inventory-grid">
                {inventory && inventory.length > 0 ? (
                    inventory.map((item: any) => (
                        <div class={`inv-card rarity-${item.rarity || 'common'}`} data-json={JSON.stringify(item)}>
                            <div class="inv-icon">{item.icon || '📦'}</div>
                            <div class="inv-name" style={item.rarity === 'legendary' ? 'color: #ffd700' : item.rarity === 'mythic' ? 'color: #ff3333' : item.rarity === 'divine' ? 'color: #00ffff' : item.rarity === 'epic' ? 'color: #a020f0' : item.rarity === 'rare' ? 'color: #00f' : 'color: #fff'}>{item.name}</div>
                            <div class="inv-count">{item.type ? item.type.toUpperCase() : 'ITEM'}</div>
                        </div>
                    ))
                ) : (
                    <div class="empty-state">Инвентарь пуст. Посетите магазин или сыграйте в игру.</div>
                )}
            </div>
        </div>

        <a href="/" class="back-link">← Вернуться в город</a>
    </main>

    <!-- Модальное окно предмета (Только просмотр) -->
    <div id="item-modal" class="modal hidden">
        <div class="modal-content">
            <span class="close-modal">&times;</span>
            <div class="item-header">
                <div id="modal-icon" class="item-icon-large"></div>
                <div class="item-title-block">
                    <h2 id="modal-name">Название</h2>
                    <div id="modal-rarity" class="item-rarity-badge">RARITY</div>
                </div>
            </div>
            <div class="item-body">
                <p id="modal-source" class="item-source">Источник: ...</p>
                <p id="modal-desc" class="item-desc">Описание...</p>
                <div class="shimmer-line"></div>
                <div id="modal-stats" class="item-stats-list"></div>
            </div>
        </div>
    </div>
</Layout>

<style>
    .profile-page { padding-top: 40px; color: #fff; }
    
    .profile-header {
        display: flex; gap: 30px; background: rgba(255, 255, 255, 0.03);
        padding: 30px; border-radius: 16px; border: 1px solid rgba(255, 255, 255, 0.1);
        flex-wrap: wrap;
    }
    
    .profile-avatar {
        width: 150px; height: 150px; border-radius: 12px;
        border: 2px solid #0ff; box-shadow: 0 0 20px rgba(0, 255, 255, 0.2);
        object-fit: cover; /* Чтобы картинка не сплющивалась */
    }
    
    .info-section { flex: 1; min-width: 300px; }
    .username { margin: 0; font-size: 2.5rem; color: #0ff; text-transform: uppercase; letter-spacing: 2px; }
    .user-id { color: #666; font-size: 0.9rem; margin-bottom: 20px; }
    .code { font-family: monospace; background: #222; padding: 2px 6px; border-radius: 4px; }
    
    .user-bio { 
        font-style: italic; color: #ddd; margin-bottom: 20px; 
        border-left: 3px solid #ffd700; padding-left: 15px;
    }

    .public-btn {
        display: inline-block; margin-bottom: 20px; color: #0ff; text-decoration: none; font-size: 0.9rem; border: 1px solid #0ff; padding: 5px 10px; border-radius: 4px; transition: all 0.2s;
    }
    .public-btn:hover { background: rgba(0, 255, 255, 0.1); }
    
    .desc-form { display: flex; flex-direction: column; gap: 15px; }
    
    .form-group { display: flex; flex-direction: column; gap: 5px; }
    .form-group label { color: #aaa; font-size: 0.9rem; }
    .form-group small { color: #555; font-size: 0.75rem; }
    
    .desc-form input, .desc-form textarea {
        background: rgba(0,0,0,0.5); border: 1px solid #444; color: #fff;
        padding: 12px; border-radius: 8px; resize: vertical; font-family: inherit;
        font-size: 1rem;
    }
    .desc-form input:focus, .desc-form textarea:focus { 
        outline: none; border-color: #0ff; box-shadow: 0 0 10px rgba(0, 255, 255, 0.1); 
    }
    
    .save-btn {
        align-self: flex-start; background: #0ff; color: #000; border: none;
        padding: 10px 25px; border-radius: 6px; font-weight: bold; cursor: pointer;
        text-transform: uppercase; transition: all 0.2s;
    }
    .save-btn:hover { background: #fff; box-shadow: 0 0 15px rgba(0, 255, 255, 0.5); }

    .inventory-section { margin-top: 40px; }
    .inventory-section h2 { color: #ffd700; margin-bottom: 20px; }
    
    .inventory-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(120px, 1fr)); gap: 15px; }
    .inv-card {
        background: rgba(0,0,0,0.6); border: 1px solid #333; border-radius: 8px;
        aspect-ratio: 1; padding: 5px; text-align: center; transition: transform 0.2s, box-shadow 0.2s;
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        cursor: pointer; position: relative; overflow: hidden;
    }
    .inv-card:hover { transform: translateY(-5px); z-index: 2; }
    .inv-icon { font-size: 2.5rem; margin-bottom: 5px; }
    .inv-name { font-weight: bold; font-size: 0.7rem; width: 100%; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding: 0 5px; }
    .inv-count { color: #666; font-size: 0.7rem; margin-top: 5px; }

    /* Rarities */
    .rarity-common { border-color: #fff; }
    .rarity-rare { border-color: #00f; box-shadow: inset 0 0 10px rgba(0,0,255,0.2); }
    .rarity-epic { border-color: #a020f0; box-shadow: inset 0 0 10px rgba(160,32,240,0.2); }
    .rarity-legendary { border-color: #ffd700; box-shadow: inset 0 0 10px rgba(255,215,0,0.2); animation: glow 2s infinite; }
    .rarity-mythic { border-color: #ff3333; box-shadow: inset 0 0 15px rgba(255,51,51,0.3); }
    .rarity-divine { border-color: #00ffff; box-shadow: inset 0 0 15px #00ffff; animation: glow 1s infinite alternate; }
    
    @keyframes glow { 0% { box-shadow: inset 0 0 5px currentColor; } 50% { box-shadow: inset 0 0 20px currentColor; } 100% { box-shadow: inset 0 0 5px currentColor; } }

    .empty-state { color: #666; font-style: italic; grid-column: 1 / -1; text-align: center; padding: 40px; }
    
    .back-link { display: inline-block; margin-top: 40px; color: #666; text-decoration: none; }
    .back-link:hover { color: #fff; }
    
    .alert { padding: 10px; border-radius: 6px; margin-bottom: 15px; font-weight: bold; }
    .alert.success { background: rgba(0, 255, 0, 0.2); border: 1px solid #0f0; color: #0f0; }
    .alert.error { background: rgba(255, 0, 0, 0.2); border: 1px solid #f00; color: #f00; }

    /* Modal Styles */
