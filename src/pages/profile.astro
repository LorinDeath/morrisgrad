import Layout from '../layouts/Layout.astro';

// 1. Получаем доступ к базе данных Cloudflare D1
const cfRuntime = (Astro.locals as any)?.runtime;
const env = cfRuntime?.env as any;
const db = env?.PROFILES_DB;
const bucket = env?.AVATARS_BUCKET;

// ВАЖНО: Вставьте сюда ваш публичный домен R2 (из настроек бакета в Cloudflare)
const R2_PUBLIC_DOMAIN = "https://pub-c6960920bfb44496a89753f220db1147.r2.dev"; 

// 2. Получаем ID пользователя через Clerk
// Если middleware настроен, auth() вернет объект с userId
const { userId } = (Astro.locals as any).auth ? (Astro.locals as any).auth() : { userId: null };

// Если не авторизован — редирект на главную (или на вход)
if (!userId) {
    return Astro.redirect('/');
}

// Если база не подключена (например, локально без wrangler)
if (!db) {
    return new Response("Database not connected. Run with 'wrangler dev'", { status: 500 });
}

// Переменные для сообщений пользователю
let message = "";
let messageType = ""; // 'success' | 'error'
let user = null;
let inventory = [];

try {
    // 0. АВТОМАТИЧЕСКОЕ СОЗДАНИЕ ТАБЛИЦ (Self-healing)
    // Если таблиц нет, этот код их создаст и ошибка исчезнет.
    await db.prepare(`
        CREATE TABLE IF NOT EXISTS users (
            id TEXT PRIMARY KEY,
            username TEXT,
            description TEXT,
            last_seen INTEGER,
            created_at INTEGER,
            avatar_url TEXT,
            last_username_update INTEGER,
            last_avatar_update INTEGER
            hellfire INTEGER DEFAULT 0
        )
    `).run();

    await db.prepare(`
        CREATE TABLE IF NOT EXISTS user_items (
            uuid TEXT PRIMARY KEY,
            user_id TEXT,
            item_id TEXT,
            name TEXT,
            description TEXT,
            source TEXT,
            type TEXT,
            rarity TEXT,
            stats JSON,
            icon TEXT,
            is_transferred INTEGER DEFAULT 0,
            created_at INTEGER
        )
    `).run();

    await db.prepare(`
        CREATE TABLE IF NOT EXISTS inventory (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            user_id TEXT,
            item_id TEXT,
            amount INTEGER
        )
    `).run();

    // МИГРАЦИЯ: Добавляем hellfire для старых пользователей
    try { await db.prepare("ALTER TABLE users ADD COLUMN hellfire INTEGER DEFAULT 0").run(); } catch (e) {}

    // 3. Логика получения данных (аналогично API)
    user = await db.prepare('SELECT * FROM users WHERE id = ?').bind(userId).first();

    // Если профиля нет в базе — создаем на лету
    if (!user) {
        const now = Date.now();
        await db.prepare(
            'INSERT INTO users (id, username, description, last_seen, created_at) VALUES (?, ?, ?, ?, ?)'
        ).bind(userId, 'Новичок', 'Житель МоррисГрада', now, now).run();
        user = await db.prepare('SELECT * FROM users WHERE id = ?').bind(userId).first();
    }

    // 4. Обработка формы (Сохранение профиля)
    if (Astro.request.method === "POST") {
        try {
            const formData = await Astro.request.formData();
            const newDesc = (formData.get("description") as string)?.slice(0, 50) || '';
            let newName = formData.get("username") as string;
            newName = newName ? newName.trim() : user.username;
            
            // Обработка загрузки файла
            const avatarFile = formData.get("avatar_file") as File;
            
            // Текущие данные
            let newAvatar = user.avatar_url; // Оставляем старый, если новый не загружен
            let lastUserUpdate = user.last_username_update || 0;
            let lastAvatarUpdate = user.last_avatar_update || 0;
            
            const NOW = Date.now();
            const ONE_DAY = 24 * 60 * 60 * 1000;
            const FIFTEEN_DAYS = 15 * ONE_DAY;
            
            // Список запрещенных слов (пример)
            const BAD_WORDS = ['admin', 'mod', 'support', 'fuck', 'bitch', 'shit', 'админ', 'модер', 'сука', 'бля', 'хер'];
            
            // --- ПРОВЕРКА НИКНЕЙМА ---
            if (newName !== user.username) {
                // ВРЕМЕННО ОТКЛЮЧЕНО: Проверка времени (15 дней)
                // if (NOW - lastUserUpdate < FIFTEEN_DAYS) {
                //    const daysLeft = Math.ceil((FIFTEEN_DAYS - (NOW - lastUserUpdate)) / ONE_DAY);
                //    message = `Никнейм можно менять раз в 15 дней. Осталось дней: ${daysLeft}`;
                //    messageType = "error";
                // } else 
                if (BAD_WORDS.some(w => newName.toLowerCase().includes(w))) {
                    message = "Никнейм содержит недопустимые слова.";
                    messageType = "error";
                } else if (newName.length < 3 || newName.length > 20) {
                    message = "Никнейм должен быть от 3 до 20 символов.";
                    messageType = "error";
                } else {
                    // Проверка на уникальность (игнорируем регистр)
                    const existing = await db.prepare('SELECT id FROM users WHERE lower(username) = lower(?) AND id != ?').bind(newName, userId).first();
                    if (existing) {
                        message = "Этот позывной уже занят.";
                        messageType = "error";
                    } else {
                        // Разрешаем смену
                        lastUserUpdate = NOW;
                    }
                }
            }

            // --- ПРОВЕРКА АВАТАРА ---
            if (messageType !== "error" && avatarFile && avatarFile.size > 0) {
                console.log(`[Profile] Попытка загрузки аватара. Размер: ${avatarFile.size} байт`);
                
                // ВРЕМЕННО ОТКЛЮЧЕНО: Проверка времени (24 часа)
                // if (NOW - lastAvatarUpdate < ONE_DAY) {
                //    message = "Аватар можно менять не чаще 1 раза в сутки.";
                //    messageType = "error";
                // } else 
                if (avatarFile.size > 5 * 1024 * 1024) {
                    message = "Файл слишком большой (макс 5МБ).";
                    messageType = "error";
                } else {
                    // Загрузка в R2
                    if (bucket) {
                        try {
                            const key = `${userId}-${Date.now()}`;
                            await bucket.put(key, await avatarFile.arrayBuffer(), {
                                httpMetadata: { contentType: avatarFile.type }
                            });

                            // Удаляем старый аватар из R2, если он там есть, чтобы не занимать место
                            if (user.avatar_url && user.avatar_url.startsWith(R2_PUBLIC_DOMAIN)) {
                                const oldKey = user.avatar_url.slice(R2_PUBLIC_DOMAIN.length + 1);
                                if (oldKey) {
                                    await bucket.delete(oldKey);
                                    console.log(`[Profile] Старый аватар удален: ${oldKey}`);
                                }
                            }

                            newAvatar = `${R2_PUBLIC_DOMAIN}/${key}`;
                            lastAvatarUpdate = NOW;
                            console.log(`[Profile] Аватар успешно загружен: ${newAvatar}`);
                        } catch (err) {
                            console.error("[Profile] Ошибка R2:", err);
                            message = "Ошибка загрузки файла в хранилище.";
                            messageType = "error";
                        }
                    } else {
                        console.error("[Profile] Ошибка: R2 Bucket не найден в env.");
                        // Вывод доступных ключей для отладки
                        console.log("[Profile] Доступные ключи env:", env ? Object.keys(env) : "env is undefined");
                        
                        message = "Ошибка сервера: Хранилище файлов (R2) не подключено. Попробуйте 'wrangler dev --remote'";
                        messageType = "error";
                    }
                }
            }

            // Если нет ошибок, сохраняем в БД
            if (messageType !== "error") {
                await db.prepare(`
                    UPDATE users SET description = ?, username = ?, avatar_url = ?, last_username_update = ?, last_avatar_update = ? WHERE id = ?
                `).bind(newDesc, newName, newAvatar, lastUserUpdate, lastAvatarUpdate, userId).run();

                // Обновляем локальные данные для отображения
                user.description = newDesc;
                user.username = newName;
                user.avatar_url = newAvatar;
                
                message = "Профиль успешно обновлен!";
                messageType = "success";
            }
            
        } catch (e) {
            console.error("Error saving profile:", e);
            message = "Ошибка сохранения. Попробуйте позже.";
            messageType = "error";
        }
    }

    // 5. Загружаем инвентарь
    const invRes = await db.prepare('SELECT * FROM user_items WHERE user_id = ? ORDER BY created_at DESC LIMIT 10').bind(userId).all();
    inventory = (invRes?.results || []).map((item: any) => ({
        ...item,
        stats: typeof item.stats === 'string' ? JSON.parse(item.stats) : (item.stats || {}),
        setId: item.set_id,
        setStats: typeof item.set_stats === 'string' ? JSON.parse(item.set_stats) : (item.set_stats || {})
    }));

} catch (e: any) {
    console.error("Profile Error:", e);
    return new Response(`Ошибка загрузки профиля: ${e.message || e}. \n\nВозможно, не созданы таблицы в базе данных. Попробуйте выполнить команды создания таблиц (users, inventory).`, { status: 500 });
}
