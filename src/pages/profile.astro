    .modal.hidden { display: none; }
    .modal-content { background: #111; border: 1px solid #444; width: 400px; max-width: 90%; padding: 30px; border-radius: 12px; position: relative; box-shadow: 0 0 50px rgba(0,0,0,0.8); }
    .close-modal { position: absolute; top: 10px; right: 20px; font-size: 2rem; cursor: pointer; color: #666; }
    .close-modal:hover { color: #fff; }

    .item-header { display: flex; gap: 20px; align-items: center; margin-bottom: 20px; }
    .item-icon-large { font-size: 4rem; background: rgba(255,255,255,0.05); width: 80px; height: 80px; display: flex; align-items: center; justify-content: center; border-radius: 8px; border: 1px solid #333; }
    .item-title-block h2 { margin: 0; font-size: 1.5rem; color: #fff; }
    .item-rarity-badge { display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 0.7rem; font-weight: bold; margin-top: 5px; text-transform: uppercase; background: #333; }
    
    .item-source { color: #888; font-size: 0.8rem; font-style: italic; margin-bottom: 10px; }
    .item-desc { color: #ccc; line-height: 1.4; margin-bottom: 20px; }
    
    .item-stats-list { display: flex; flex-direction: column; gap: 8px; }
    :global(.stat-row) { display: flex; justify-content: space-between; border-bottom: 1px solid #222; padding-bottom: 4px; }
    :global(.stat-key) { color: #aaa; }
    :global(.stat-val) { color: #0ff; font-weight: bold; }
</style>

<script>
document.addEventListener('astro:page-load', () => {
    // Проверка размера файла на клиенте
    const fileInput = document.getElementById('avatar_file') as HTMLInputElement | null;
    
    // Функция сжатия изображения (Client-side compression)
    const compressImage = async (file: File): Promise<File> => {
        return new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.readAsDataURL(file);
            reader.onload = (event) => {
                const img = new Image();
                img.src = event.target?.result as string;
                img.onload = () => {
                    const canvas = document.createElement('canvas');
                    const MAX_WIDTH = 500;
                    const MAX_HEIGHT = 500;
                    let width = img.width;
                    let height = img.height;

                    // Сохраняем пропорции
                    if (width > height) {
                        if (width > MAX_WIDTH) { height *= MAX_WIDTH / width; width = MAX_WIDTH; }
                    } else {
                        if (height > MAX_HEIGHT) { width *= MAX_HEIGHT / height; height = MAX_HEIGHT; }
                    }

                    canvas.width = width;
                    canvas.height = height;
                    const ctx = canvas.getContext('2d');
                    ctx?.drawImage(img, 0, 0, width, height);

                    canvas.toBlob((blob) => {
                        if (!blob) return reject(new Error('Canvas error'));
                        // Создаем новый файл (всегда JPG для экономии)
                        const newFile = new File([blob], file.name.replace(/\.[^/.]+$/, ".jpg"), {
                            type: 'image/jpeg',
                            lastModified: Date.now(),
                        });
                        resolve(newFile);
                    }, 'image/jpeg', 0.8); // Качество 80%
                };
            };
            reader.onerror = (err) => reject(err);
        });
    };

    if (fileInput) {
        fileInput.addEventListener('change', async function() {
            if (this.files && this.files[0]) {
                const file = this.files[0];
                
                // Если файл гигантский (>10МБ), лучше сразу отказать, браузер может зависнуть при сжатии
                if (file.size > 10 * 1024 * 1024) {
                    alert("Файл слишком большой! Максимум 10 МБ.");
                    this.value = ''; 
                    return;
                }

                try {
                    // Сжимаем
                    const compressed = await compressImage(file);
                    
                    // Подменяем файл в инпуте через DataTransfer
                    const dt = new DataTransfer();
                    dt.items.add(compressed);
                    this.files = dt.files;
                    
                    console.log(`Сжатие аватара: ${(file.size/1024).toFixed(1)}KB -> ${(compressed.size/1024).toFixed(1)}KB`);
                } catch (e) {
                    console.error("Ошибка сжатия:", e);
                }
            }
        });
    }

    // Индикатор загрузки при отправке формы
    const form = document.querySelector('.desc-form') as HTMLFormElement | null;
    const saveBtn = document.querySelector('.save-btn') as HTMLButtonElement | null;
    
    if (form && saveBtn) {
        form.addEventListener('submit', () => {
            // Меняем текст кнопки и блокируем её, чтобы было видно процесс
            saveBtn.textContent = 'ЗАГРУЗКА...';
            saveBtn.disabled = true;
            saveBtn.style.opacity = '0.7';
            saveBtn.style.cursor = 'wait';
        });
    }

    // Modal Logic
    const modal = document.getElementById('item-modal');
    const closeBtn = document.querySelector('.close-modal');

    function getColor(rarity: string) {
        const colors: any = { common: '#fff', rare: '#00f', epic: '#a020f0', legendary: '#ffd700', mythic: '#ff3333', divine: '#00ffff' };
        return colors[rarity] || '#fff';
    }

    document.querySelectorAll('.inv-card').forEach(card => {
        card.addEventListener('click', () => {
            const json = card.getAttribute('data-json');
            if (json) {
                const item = JSON.parse(json);
                openModal(item);
            }
        });
    });

    function openModal(item: any) {
        if (!modal) return;
        
        const iconEl = document.getElementById('modal-icon');
        const nameEl = document.getElementById('modal-name');
        const rarityEl = document.getElementById('modal-rarity');
        const sourceEl = document.getElementById('modal-source');
        const descEl = document.getElementById('modal-desc');
        const statsEl = document.getElementById('modal-stats');
        
        if (iconEl) {
            iconEl.innerText = item.icon || '📦';
            iconEl.className = `item-icon-large rarity-${item.rarity}`;
            iconEl.style.borderColor = getColor(item.rarity);
            iconEl.style.boxShadow = `0 0 15px ${getColor(item.rarity)}`;
        }
        if (nameEl) {
            nameEl.innerText = item.name;
            nameEl.style.color = getColor(item.rarity);
        }
        if (rarityEl) {
            rarityEl.innerText = item.rarity;
            rarityEl.style.color = getColor(item.rarity);
            rarityEl.style.borderColor = getColor(item.rarity);
            rarityEl.style.background = 'rgba(0,0,0,0.5)';
        }
        if (sourceEl) {
            sourceEl.innerHTML = `Источник: ${item.source || 'Неизвестно'}`;
            if (item.setId) {
                sourceEl.innerHTML += `<br><span style="color:#0f0; font-weight:bold; text-shadow: 0 0 5px #0f0;">СЕТ: ${item.setId.toUpperCase()}</span>`;
            }
        }
        if (descEl) descEl.innerText = item.description || "Нет описания";
        
        if (statsEl) {
            statsEl.innerHTML = '';
            if (item.stats) {
                for (const [key, val] of Object.entries(item.stats)) {
                    const row = document.createElement('div');
                    row.className = 'stat-row';
                    row.innerHTML = `<span class="stat-key">${key.toUpperCase()}</span><span class="stat-val">+${val}</span>`;
                    statsEl.appendChild(row);
                }
            }
            if (item.setStats) {
                const row = document.createElement('div');
                row.innerHTML = `<div style="color:#0f0; margin-top:5px; border-top:1px dashed #333;">СЕТОВЫЕ БОНУСЫ:</div>`;
                statsEl.appendChild(row);
                for (const [key, val] of Object.entries(item.setStats)) {
                    const r = document.createElement('div');
                    r.className = 'stat-row';
                    r.innerHTML = `<span class="stat-key" style="color:#0f0">${key.toUpperCase()}</span><span class="stat-val" style="color:#0f0">+${val}</span>`;
                    statsEl.appendChild(r);
                }
            }
        }

        modal.classList.remove('hidden');
    }

    if (closeBtn) closeBtn.addEventListener('click', () => modal?.classList.add('hidden'));
    if (modal) modal.addEventListener('click', (e) => {
        if (e.target === modal) modal.classList.add('hidden');
    });
});
</script>