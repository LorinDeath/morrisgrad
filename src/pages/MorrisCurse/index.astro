---
import Layout from '../../layouts/Layout.astro';
import './_core/styles/game-theme.css';
import './_core/styles/game-modals.css';
// вход: SSR уже знает, вошёл ли игрок (cookie Clerk) — вошедшему не ждём Clerk и не грузим оверлей входа вовсе
let ssrSigned = false;
try { ssrSigned = !!(Astro.locals as any).auth?.()?.userId; } catch (_) {}
---

<Layout title="Проклятые | Моррис Град" viewportFit bare>
  <!-- Игра на всё окно (100vw × 100dvh): без шапки/подвала сайта, без кнопки «Начать игру» — загрузка стартует сразу при открытии.
       Полный экран — по первому клику/касанию/клавише (ui/fullscreen.js), Esc возвращает в «на всё окно» без сдвига раскладки. -->
  <div class="game-window mc-full" id="game-window" data-signed={ssrSigned ? "1" : "0"}>
    <div class="game-screen" id="game-screen">
      <div class="launcher-overlay" id="launcher-overlay">
        <span class="auth-back" id="auth-back" hidden>✓ Вход выполнен</span>
        <span class="hint">Загрузка…</span>
      </div>
      <canvas id="game-canvas" width="300" height="300" tabindex="0"></canvas>
    </div>
  </div>
</Layout>

<!-- Сторож запуска (MC-L09): если сам загрузчик игры (модуль ниже) не скачался — связь оборвалась на первой загрузке страницы,
     — кода, который покажет ошибку, ещё нет. Этот крошечный встроенный скрипт показывает окно с кодом и «Повторить», а не пустой экран. -->
<script is:inline>
  (function () {
    if (window.__mcGuard) return; window.__mcGuard = 1;
    var shown = false, t0 = Date.now();
    function box(why) {
      if (shown || window.__mcLaunch) return; shown = true;
      var d = document.createElement('div'); d.setAttribute('role', 'alertdialog'); d.className = 'mcl-err mcl-guard'; d.dataset.code = 'MC-L09';
      d.style.cssText = 'position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);z-index:99999;max-width:min(92vw,380px);padding:18px 20px;background:#160c10;color:#e8d8c0;border:2px solid #7a2a2a;font:15px/1.4 system-ui,sans-serif;text-align:center;box-shadow:0 0 0 100vmax rgba(0,0,0,.55)';
      var code = 'MC-L09', line = code + ' · ' + why + ' · ' + new Date().toISOString();
      d.innerHTML = '<div style="font:700 28px/1 monospace;letter-spacing:2px;color:#ff8a6a">' + code + '</div><div style="margin:10px 0 14px">Страница загрузилась не полностью</div>';
      var b1 = document.createElement('button'), b2 = document.createElement('button');
      [b1, b2].forEach(function (b) { b.style.cssText = 'margin:4px;padding:8px 14px;font:inherit;background:#2a1418;color:inherit;border:1px solid #7a2a2a;cursor:pointer'; d.appendChild(b); });
      b1.textContent = 'Скопировать код'; b1.onclick = function () { try { navigator.clipboard.writeText(line); b1.textContent = 'Скопировано'; } catch (_) {} };
      b2.textContent = 'Повторить'; b2.onclick = function () { location.reload(); };
      (document.body || document.documentElement).appendChild(d);
    }
    // модуль загрузчика (/_astro/*.js) не скачался — сразу; иначе — если за 20 с загрузчик так и не запустился
    document.addEventListener('error', function (e) { var t = e.target; if (t && t.tagName === 'SCRIPT' && /\/_astro\//.test(t.src || '')) setTimeout(function () { box('script ' + (t.src || '').split('/').pop()); }, 300); }, true);
    window.addEventListener('load', function () { setTimeout(function () { box('timeout ' + Math.round((Date.now() - t0) / 1000) + 's'); }, 20000); });
  })();
</script>

<script>
  (window as any).__mcLaunch = 1; // сторож MC-L09 выше: загрузчик дошёл
  import { syncAssets, AC } from './_core/boot/assetCache.js';
  import { showError, hookGlobalErrors } from './_core/boot/errorBox.js';
  import { armAutoFullscreen, fsActive } from './_core/ui/fullscreen.js';
  import { unlockAudioOnGesture } from './_core/boot/audioUnlock.js';
  // Вход (гости): оверлей с формой Clerk грузится лениво (src/scripts/mcAuthGate.ts) — только если входа нет.
  // Вошедший игрок стартует как раньше: без ожидания Clerk и без лишнего кода.
  const PENDING = 'mc-auth-pending';
  const W = window as any;
  const clerkReady = (ms: number) => new Promise<any>((res) => {
    const t0 = performance.now();
    const tick = () => { const c = W.Clerk; if (c?.loaded) return res(c); if (performance.now() - t0 > ms) return res(c?.loaded ? c : null); setTimeout(tick, 80); };
    tick();
  });
  const gate = () => import('../../scripts/mcAuthGate');

  // Во время игры: потеря сессии → «Сессия истекла» (связь и состояние игры сохраняются, перезаход — только если сменился аккаунт);
  // гость вошёл (кнопка «Войти» в шапке или оверлей) → переподключение с токеном, без перезагрузки; сервер не принял токен → свежий токен, затем оверлей.
  async function watchSession(api: any, gameWindow: HTMLElement, startedUid: string) {
    if (W.__MC_AUTH_WATCH__) return; W.__MC_AUTH_WATCH__ = true;
    const c = await clerkReady(20000); if (!c?.addListener) { W.__MC_AUTH_WATCH__ = false; return; }
    // 'ssr' — вошёл по cookie, Clerk на клиенте ещё грузился: первый id просто запоминаем (без переподключения)
    let uid = startedUid === 'ssr' ? (c.user?.id || '') : startedUid, asking = false, retryAt = 0;
    const rejoin = () => { W.__MC_AUTH_GUEST__ = false; W.__MC_AUTH_FRESH__ = true; api.reconnect?.({ userId: W.Clerk?.user?.id || '' }); };
    c.addListener(({ user }: any) => {
      const now = user?.id || '';
      if (now === uid || asking) return;
      if (!now && uid) {
        asking = true;
        gate().then((g) => g.openAuthGate({ host: gameWindow, mode: 'expired', code: 'MC-A02' })).then((r) => {
          asking = false;
          const nu = W.Clerk?.user?.id || '';
          if (r === 'signed-in' && nu && nu !== uid) { uid = nu; rejoin(); } else if (r === 'signed-in') uid = nu;
        }).catch((e) => { asking = false; console.warn('[mc-auth]', e); });
      } else { uid = now; rejoin(); } // гость → аккаунт или другой аккаунт
    });
    window.addEventListener('mc-auth', (ev: any) => {
      if (ev.detail?.state !== 'invalid' || asking) return;
      if (W.Clerk?.user && Date.now() - retryAt > 30000) { retryAt = Date.now(); rejoin(); return; } // один тихий повтор со свежим токеном
      asking = true;
      gate().then((g) => g.openAuthGate({ host: gameWindow, mode: 'invalid', code: ev.detail.code || 'MC-A03' })).then((r) => {
        asking = false;
        if (r === 'guest') { W.__MC_AUTH_GUEST__ = true; uid = ''; api.reconnect?.({ userId: '' }); }
        else { uid = W.Clerk?.user?.id || ''; rejoin(); }
      }).catch((e) => { asking = false; console.warn('[mc-auth]', e); });
    });
  }

  function initLauncher() {
    const overlay = document.getElementById('launcher-overlay');
    const canvas = document.getElementById('game-canvas') as HTMLCanvasElement;
    const gameWindow = document.getElementById('game-window');
    if (!canvas || !gameWindow || W.__MC_LAUNCHED__ === canvas) return; // astro:page-load + DOMContentLoaded — запуск один раз на этот канвас
    W.__MC_LAUNCHED__ = canvas;
    let gameStarted = false;

    // вернулись со входа через Google/Discord/Twitch (страница перезагрузилась) — короткая отметка «Вход выполнен»
    let pending = false;
    try { const t = Number(sessionStorage.getItem(PENDING)); pending = t > 0 && Date.now() - t < 20 * 60_000; } catch (_) {}
    if (pending || location.hash === '#mc-auth-done') {
      clerkReady(6000).then((c) => {
        if (!c?.user) return;
        try { sessionStorage.removeItem(PENDING); } catch (_) {}
        if (location.hash === '#mc-auth-done') history.replaceState(history.state, '', location.pathname + location.search);
        const ok = document.getElementById('auth-back'); if (ok) ok.hidden = false;
      });
    }

    const startGame = async () => {
      gameStarted = true;
      let username = 'Странник';
      let userId = null;
      hookGlobalErrors(); // коды ошибок (src/errors/codes.js): непредвиденное → MC-X00
      // ник — только для вошедшего (свой профиль по сессии; гостю сервер ответит 401 — не спрашиваем)
      const signed = !W.__MC_AUTH_GUEST__ && (!!W.Clerk?.user || gameWindow.dataset.signed === '1');
      // ресурсы: один раз скачать, дальше — только изменения (boot/assetCache.js + public/mc-sw.js); параллельно — кто вошёл
      const userP = !signed ? Promise.resolve() : fetch('/api/get-user', { credentials: 'same-origin' }).then(async (res) => {
        if (!res.ok) throw new Error('HTTP ' + res.status);
        const data = await res.json();
        if (data.username) username = data.username;
      }).catch((err) => { console.warn('Не удалось загрузить пользователя', err); showError('MC-A06', { soft: true, autoClose: 8000, detail: String(err?.message || err) }); });
      await syncAssets();
      await userP;
      if (!userId && !W.__MC_AUTH_GUEST__ && W.Clerk?.user?.id) userId = W.Clerk.user.id; // только подсказка: сервер верит токену, не этому полю
      const ld = AC.loader && AC.loader.el.isConnected ? AC.loader : null; // экран первого визита/обновления: последняя стадия
      ld?.stage('world');
      let initGame;
      try { ({ initGame } = await import('./_core/game.js')); }
      catch (err) { ld?.close(); showError('MC-L05', { detail: String(err?.message || err) }); return; } // «Повторить» = перезагрузка (неудачный import браузер запоминает)
      if (ld) { const done = () => ld.close(); window.addEventListener('mc:first-frame', done, { once: true }); setTimeout(done, 20000); }
      if (overlay) overlay.style.display = 'none'; // дальше — экран загрузки самой игры
      // Передача userId третьим аргументом обязательна!
      const api = (initGame)(canvas.id, username, userId);
      watchSession(api, gameWindow, W.__MC_AUTH_GUEST__ ? '' : (W.Clerk?.user?.id || (gameWindow.dataset.signed === '1' ? 'ssr' : '')));
    };

    // Запуск — сразу при открытии страницы (меню сайта, ссылка, прямой заход): без кнопки «Начать игру».
    // Звук разблокируется первым жестом (boot/audioUnlock.js), полный экран — тоже первым жестом (ui/fullscreen.js).
    const launch = async () => {
      if (gameStarted) return;
      try {
        if (gameWindow.dataset.signed !== '1') {
          const c = await clerkReady(5000);
          if (!c?.user) {
            const g = await gate(); // гость: окно «Войти / Играть гостем» (как и раньше, только без лишнего нажатия перед ним)
            const r = await g.openAuthGate({ host: gameWindow, mode: c ? 'start' : 'error', code: c ? undefined : 'MC-A01' });
            W.__MC_AUTH_GUEST__ = r === 'guest';
          }
        }
        await startGame();
      } catch (err) { console.warn('[mc-launch]', err); showError('MC-X00', { detail: String((err as any)?.message || err), step: 'запуск игры' }); }
    };
    unlockAudioOnGesture();
    armAutoFullscreen();
    canvas.addEventListener('pointerdown', () => canvas.focus());
    launch();
  }

  // Поддержка стандартной загрузки и переходов View Transitions в Astro
  document.addEventListener('DOMContentLoaded', initLauncher);
  document.addEventListener('astro:page-load', initLauncher);

  window.addEventListener('keydown', (e) => {
    const canvas = document.getElementById('game-canvas');
    if (document.activeElement === canvas) {
      if (['Space', 'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].includes(e.code) || e.key === ' ') {
        e.preventDefault();
      }
    }
  }, { passive: false });

  // вход/выход из полного экрана (в т. ч. Esc): окно остаётся «на всё окно», фокус — на игре (клавиши продолжают работать)
  document.addEventListener('fullscreenchange', () => {
    const canvas = document.getElementById('game-canvas') as HTMLElement | null;
    document.documentElement.classList.toggle('mc-fs', fsActive());
    const a = document.activeElement as HTMLElement | null;
    if (!a || a === document.body) canvas?.focus({ preventScroll: true });
    window.dispatchEvent(new Event('resize')); // HUD (перетаскиваемые блоки, чат) пересчитывает положение
  });
</script>

<style is:global>
  /* Страница игры: всё окно, без прокрутки (Layout bare — без шапки/подвала сайта) */
  html:has(body.mc-bare), body.mc-bare { margin: 0; padding: 0; width: 100%; height: 100%; overflow: hidden; overscroll-behavior: none; background: #000; }
  body.mc-bare { position: fixed; inset: 0; touch-action: manipulation; }

  .game-window.mc-full, .game-window:fullscreen {
    position: fixed; inset: 0; width: 100vw; height: 100vh; height: 100dvh; margin: 0; padding: 0;
    border: 0; border-radius: 0; box-shadow: none; overflow: hidden; background: #06050b; display: block;
  }
  /* одна раскладка в обоих режимах — вход/выход из полного экрана не сдвигает канвас и HUD */
  #game-window .game-screen, #game-window .game-screen.mc3d-mobile {
    position: absolute !important; inset: 0 !important; width: 100% !important; height: 100% !important; min-height: 0 !important; max-width: none !important;
    margin: 0 !important; border: 0; display: flex; flex-direction: row; justify-content: space-between; align-items: stretch;
    background: #07050d; overflow: hidden;
  }
  #game-canvas {
    width: 100%; height: 100%; display: block; flex: 1 1 auto; min-width: 0;
    image-rendering: pixelated; outline: none; touch-action: none;
  }

  .game-hud-panel { display: none; }

  /* старые боковые панели (Настройки → «Старые панели»): как раньше в полном экране — теперь всегда */
  .game-window.mc-full .game-hud-panel {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 250px;
    max-width: 320px;
    background: #0c0915;
    padding: 16px 14px;
    box-sizing: border-box;
    gap: 14px;
    overflow-y: auto;
    font-family: monospace;
    z-index: 2;
  }
  .game-window.mc-full .hud-left { border-right: 1px solid #231b33; }
  .game-window.mc-full .hud-right { border-left: 1px solid #231b33; }
  .hud-card {
    background: #120d20;
    border: 1px solid #2d2242;
    border-radius: 6px;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.5);
  }

  .hud-header {
    font-size: 11px;
    font-weight: bold;
    color: #c59b27;
    letter-spacing: 1.5px;
    border-bottom: 1px solid #261c38;
    padding-bottom: 4px;
  }

  .hud-player-name, .hud-target-title {
    font-size: 14px;
    font-weight: bold;
    color: #ffd700;
  }

  .hud-player-class {
    font-size: 11px;
    color: #c084fc;
  }

  .hud-bar-bg {
    width: 100%;
    height: 8px;
    background: #090610;
    border: 1px solid #3b2c52;
    border-radius: 3px;
    overflow: hidden;
  }

  .hud-bar-fill {
    height: 100%;
    transition: width 0.2s ease-out;
  }

  .hud-hp-fill { background: linear-gradient(90deg, #ef4444, #f87171); }
  .hud-dash-fill { background: linear-gradient(90deg, #38bdf8, #818cf8); }

  .hud-bar-val {
    font-size: 11px;
    color: #cbd5e1;
    text-align: right;
  }

  .hud-row {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    color: #94a3b8;
  }

  .hud-row b { color: #f1f5f9; }
  .hud-ready { color: #4ade80 !important; font-weight: bold; }
  .hud-cd { color: #f59e0b !important; font-weight: bold; }

  .hud-controls { margin-top: auto; }
  .hud-ctrl-item {
    font-size: 10px;
    color: #a1a1aa;
    display: flex;
    justify-content: space-between;
  }
  .hud-ctrl-item span { color: #e9d5ff; }

  .hud-empty {
    font-size: 11px;
    color: #64748b;
    font-style: italic;
    line-height: 1.4;
  }

  .hud-duel-btn {
    background: #7c3aed;
    border: 1px solid #a855f7;
    color: #fff;
    padding: 8px 10px;
    font-family: monospace;
    font-weight: bold;
    font-size: 11px;
    border-radius: 4px;
    cursor: pointer;
    margin-top: 6px;
    transition: all 0.2s;
  }

  .hud-duel-btn:hover {
    background: #9333ea;
    box-shadow: 0 0 10px rgba(168, 85, 247, 0.5);
  }

  .hud-btn-disabled {
    background: #374151 !important;
    border-color: #4b5563 !important;
    color: #9ca3af !important;
    cursor: not-allowed !important;
    box-shadow: none !important;
  }

  .hud-nearby-box {
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-height: 120px;
    overflow-y: auto;
  }

  .hud-nearby-item {
    display: flex;
    justify-content: space-between;
    padding: 5px 8px;
    background: #171129;
    border: 1px solid #281d3d;
    border-radius: 4px;
    font-size: 11px;
    cursor: pointer;
  }

  .hud-nearby-item:hover {
    border-color: #ffd700;
    background: #201738;
  }

  .hud-nearby-item span { color: #38bdf8; font-weight: bold; }
  .hud-nearby-item b { color: #f5d77f; font-weight: normal; }

  .hud-near-name { font-size: 12px; font-weight: bold; color: #e9d5ff; }
  .hud-near-hint { font-size: 11px; color: #94a3b8; line-height: 1.3; }

  .launcher-overlay {
    position: absolute;
    inset: 0;
    background: rgba(8, 5, 14, 0.92);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 14px;
    z-index: 10;
  }

  .auth-back { font: 600 0.85rem 'Exo 2', system-ui, sans-serif; color: #8fd6a0; }
  .auth-back[hidden] { display: none; }

  .hint {
    font-size: 0.85rem;
    color: #9d8ba9;
    font-family: monospace;
  }
</style>