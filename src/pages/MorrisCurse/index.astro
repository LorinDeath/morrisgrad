---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Проклятые | Моррис Град">
  <main class="container">
    <h1>ПРОКЛЯТЫЕ</h1>
    <div class="shimmer-line"></div>

    <div class="game-wrapper">
      <div class="game-window" id="game-window">
        <div class="game-header">
          <span class="game-title">Альказак // Viewport (300x300)</span>
          <button id="btn-fullscreen" class="btn-fullscreen" title="На весь экран" aria-label="Развернуть">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/>
            </svg>
          </button>
        </div>

        <div class="game-screen" id="game-screen">
          <div class="launcher-overlay" id="launcher-overlay">
            <button class="btn-start" id="btn-start">Начать игру</button>
            <span class="hint">Управление: WASD / Зум: +/-</span>
          </div>

          <canvas id="game-canvas" width="300" height="300" tabindex="0"></canvas>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  const startBtn = document.getElementById('btn-start');
  const overlay = document.getElementById('launcher-overlay');
  const canvas = document.getElementById('game-canvas') as HTMLCanvasElement;
  const gameWindow = document.getElementById('game-window');
  const fsBtn = document.getElementById('btn-fullscreen');

  let gameStarted = false;

  startBtn?.addEventListener('click', async () => {
    if (overlay) overlay.style.display = 'none';
    canvas?.focus();

    if (!document.fullscreenElement && gameWindow) {
      gameWindow.requestFullscreen().catch((err) => {
        console.warn('Fullscreen отклонен:', err);
      });
    }

    if (!gameStarted) {
      gameStarted = true;

      let username = 'Странник';
      let userId: string | null = null;

      try {
        const res = await fetch('/api/get-user');
        if (res.ok) {
          const data = await res.json();
          if (data.username) username = data.username;
          userId = data.userId || data.id || null;
        }
      } catch (err) {
        console.warn('Не удалось загрузить пользователя');
      }

      const { initGame } = await import('./core/game.js');
      (initGame as any)('game-canvas', username, userId);
    }
  });

  canvas?.addEventListener('click', () => canvas.focus());

  window.addEventListener('keydown', (e) => {
    if (document.activeElement === canvas) {
      if (['Space', 'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].includes(e.code) || e.key === ' ') {
        e.preventDefault();
      }
    }
  }, { passive: false });

  fsBtn?.addEventListener('click', () => {
    if (!document.fullscreenElement) {
      gameWindow?.requestFullscreen().catch(err => console.error(err));
    } else {
      document.exitFullscreen();
    }
  });

  document.addEventListener('fullscreenchange', () => {
    if (document.fullscreenElement) {
      canvas?.focus();
    }
  });
</script>

<style is:global>
  .shimmer-line {
    height: 2px;
    background: linear-gradient(90deg, transparent, rgba(255, 215, 0, 0.5), transparent);
    margin: 2rem 0;
  }

  .game-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 2rem 0;
  }

  .game-window {
    width: 360px;
    background: #0d0a14;
    border: 2px solid #332742;
    border-radius: 8px;
    box-shadow: 0 0 25px rgba(0, 0, 0, 0.8), 0 0 10px rgba(160, 32, 240, 0.2);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .game-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #181224;
    padding: 8px 14px;
    border-bottom: 1px solid #332742;
  }

  .game-title {
    font-size: 0.9rem;
    font-weight: 700;
    color: #cbbbd9;
    font-family: monospace;
    letter-spacing: 0.5px;
  }

  .btn-fullscreen {
    background: transparent;
    border: 1px solid #443755;
    color: #cbbbd9;
    padding: 4px 8px;
    border-radius: 4px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .btn-fullscreen:hover {
    color: #ffd700;
    border-color: #ffd700;
    background: rgba(255, 215, 0, 0.1);
  }

  .game-screen {
    position: relative;
    width: 340px;
    height: 340px;
    margin: 10px auto;
    background: #050408;
    border: 1px solid #221830;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  #game-canvas {
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    outline: none;
  }

  .game-hud-panel {
    display: none;
  }

  /* Fullscreen: адаптивная разметка дашборда */
  .game-window:fullscreen {
    width: 100vw;
    height: 100vh;
    border-radius: 0;
    border: none;
    background: #06050b;
  }

  .game-window:fullscreen .game-screen {
    width: 100%;
    height: calc(100vh - 46px);
    margin: 0;
    border: none;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: stretch;
    background: #07050d;
    overflow: hidden;
  }

  .game-window:fullscreen #game-canvas {
    width: auto;
    height: 100%;
    max-width: calc(100vw - 520px);
    aspect-ratio: 1 / 1;
    z-index: 1;
    border-left: 2px solid #c59b27;
    border-right: 2px solid #c59b27;
    box-shadow: 0 0 35px rgba(0, 0, 0, 0.95);
  }

  .game-window:fullscreen .game-hud-panel {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 250px;
    max-width: 320px;
    background: #0c0915;
    padding: 16px 14px;
    box-sizing: border-box;
    gap: 14px;
    overflow-y: auto;
    font-family: monospace;
    z-index: 2;
  }

  .game-window:fullscreen .hud-left { border-right: 1px solid #231b33; }
  .game-window:fullscreen .hud-right { border-left: 1px solid #231b33; }

  .hud-card {
    background: #120d20;
    border: 1px solid #2d2242;
    border-radius: 6px;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.5);
  }

  .hud-header {
    font-size: 11px;
    font-weight: bold;
    color: #c59b27;
    letter-spacing: 1.5px;
    border-bottom: 1px solid #261c38;
    padding-bottom: 4px;
  }

  .hud-player-name, .hud-target-title {
    font-size: 14px;
    font-weight: bold;
    color: #ffd700;
  }

  .hud-player-class {
    font-size: 11px;
    color: #c084fc;
  }

  .hud-bar-bg {
    width: 100%;
    height: 8px;
    background: #090610;
    border: 1px solid #3b2c52;
    border-radius: 3px;
    overflow: hidden;
  }

  .hud-bar-fill {
    height: 100%;
    transition: width 0.2s ease-out;
  }

  .hud-hp-fill { background: linear-gradient(90deg, #ef4444, #f87171); }
  .hud-dash-fill { background: linear-gradient(90deg, #38bdf8, #818cf8); }

  .hud-bar-val {
    font-size: 11px;
    color: #cbd5e1;
    text-align: right;
  }

  .hud-row {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    color: #94a3b8;
  }

  .hud-row b { color: #f1f5f9; }
  .hud-ready { color: #4ade80 !important; font-weight: bold; }
  .hud-cd { color: #f59e0b !important; font-weight: bold; }

  .hud-controls { margin-top: auto; }
  .hud-ctrl-item {
    font-size: 10px;
    color: #a1a1aa;
    display: flex;
    justify-content: space-between;
  }
  .hud-ctrl-item span { color: #e9d5ff; }

  .hud-empty {
    font-size: 11px;
    color: #64748b;
    font-style: italic;
    line-height: 1.4;
  }

  .hud-duel-btn {
    background: #7c3aed;
    border: 1px solid #a855f7;
    color: #fff;
    padding: 8px 10px;
    font-family: monospace;
    font-weight: bold;
    font-size: 11px;
    border-radius: 4px;
    cursor: pointer;
    margin-top: 6px;
    transition: all 0.2s;
  }

  .hud-duel-btn:hover {
    background: #9333ea;
    box-shadow: 0 0 10px rgba(168, 85, 247, 0.5);
  }

  .hud-btn-disabled {
    background: #374151 !important;
    border-color: #4b5563 !important;
    color: #9ca3af !important;
    cursor: not-allowed !important;
    box-shadow: none !important;
  }

  .hud-nearby-box {
    display: flex;
    flex-direction: column;
    gap: 6px;
    max-height: 120px;
    overflow-y: auto;
  }

  .hud-nearby-item {
    display: flex;
    justify-content: space-between;
    padding: 5px 8px;
    background: #171129;
    border: 1px solid #281d3d;
    border-radius: 4px;
    font-size: 11px;
    cursor: pointer;
  }

  .hud-nearby-item:hover {
    border-color: #ffd700;
    background: #201738;
  }

  .hud-nearby-item span { color: #38bdf8; font-weight: bold; }
  .hud-nearby-item b { color: #f5d77f; font-weight: normal; }

  .hud-near-name { font-size: 12px; font-weight: bold; color: #e9d5ff; }
  .hud-near-hint { font-size: 11px; color: #94a3b8; line-height: 1.3; }

  .launcher-overlay {
    position: absolute;
    inset: 0;
    background: rgba(8, 5, 14, 0.92);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 14px;
    z-index: 10;
  }

  .btn-start {
    background: #ffd700;
    color: #111;
    border: none;
    padding: 10px 24px;
    font-weight: 800;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    border-radius: 4px;
    transition: transform 0.1s, box-shadow 0.2s;
  }

  .btn-start:hover {
    transform: scale(1.05);
    box-shadow: 0 0 15px rgba(255, 215, 0, 0.6);
  }

  .hint {
    font-size: 0.85rem;
    color: #9d8ba9;
    font-family: monospace;
  }
</style>