---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Проклятые | Моррис Град">
  <main class="container">
    <h1>ПРОКЛЯТЫЕ</h1>
    <div class="shimmer-line"></div>

    <div class="game-wrapper">
      <div class="game-window" id="game-window">
        <div class="game-header">
          <span class="game-title">Альказак // Viewport (300x300)</span>
          <button id="btn-fullscreen" class="btn-fullscreen" title="На весь экран" aria-label="Развернуть">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/>
            </svg>
          </button>
        </div>

        <div class="game-screen" id="game-screen">
          <div class="launcher-overlay" id="launcher-overlay">
            <button class="btn-start" id="btn-start">Начать игру</button>
            <span class="hint">Управление: WASD / Зум: +/-</span>
          </div>
          
          <canvas id="game-canvas" width="300" height="300" tabindex="0"></canvas>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script>
  const startBtn = document.getElementById('btn-start');
  const overlay = document.getElementById('launcher-overlay');
  const canvas = document.getElementById('game-canvas') as HTMLCanvasElement;
  const gameWindow = document.getElementById('game-window');
  const fsBtn = document.getElementById('btn-fullscreen');

  let gameStarted = false;

  startBtn?.addEventListener('click', async () => {
    if (overlay) overlay.style.display = 'none';
    canvas?.focus();

    if (!gameStarted) {
      gameStarted = true;

      let username = 'Странник';
      try {
        const res = await fetch('/api/get-user');
        if (res.ok) {
          const data = await res.json();
          if (data.username) username = data.username;
        }
      } catch (err) {
        console.warn('Не удалось загрузить ник, ставим дефолтный');
      }

      const { initGame } = await import('./core/game.js');
      initGame('game-canvas', username);
    }
  });

  canvas?.addEventListener('click', () => {
    canvas.focus();
  });

  window.addEventListener('keydown', (e) => {
    if (document.activeElement === canvas) {
      if (['Space', 'ArrowUp', 'ArrowDown', 'ArrowLeft', 'ArrowRight'].includes(e.code) || e.key === ' ') {
        e.preventDefault();
      }
    }
  }, { passive: false });

  fsBtn?.addEventListener('click', () => {
    if (!document.fullscreenElement) {
      gameWindow?.requestFullscreen().catch(err => console.error(err));
    } else {
      document.exitFullscreen();
    }
  });

  document.addEventListener('fullscreenchange', () => {
    if (document.fullscreenElement) {
      canvas?.focus();
    }
  });
</script>

<style>
  .shimmer-line {
    height: 2px;
    background: linear-gradient(90deg, transparent, rgba(255, 215, 0, 0.5), transparent);
    margin: 2rem 0;
  }

  .game-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 2rem 0;
  }

  .game-window {
    width: 360px;
    background: #0d0a14;
    border: 2px solid #332742;
    border-radius: 8px;
    box-shadow: 0 0 25px rgba(0, 0, 0, 0.8), 0 0 10px rgba(160, 32, 240, 0.2);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .game-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #181224;
    padding: 8px 14px;
    border-bottom: 1px solid #332742;
  }

  .game-title {
    font-size: 0.9rem;
    font-weight: 700;
    color: #cbbbd9;
    font-family: monospace;
    letter-spacing: 0.5px;
  }

  .btn-fullscreen {
    background: transparent;
    border: 1px solid #443755;
    color: #cbbbd9;
    padding: 4px 8px;
    border-radius: 4px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .btn-fullscreen:hover {
    color: #ffd700;
    border-color: #ffd700;
    background: rgba(255, 215, 0, 0.1);
  }

  .game-screen {
    position: relative;
    width: 340px;
    height: 340px;
    margin: 10px auto;
    background: #050408;
    border: 1px solid #221830;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  #game-canvas {
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
    outline: none;
  }

  /* Режим Fullscreen (строго 100vw/100vh) */
  .game-window:fullscreen {
    width: 100vw;
    height: 100vh;
    border-radius: 0;
    border: none;
    background: #050408;
  }

  .game-window:fullscreen .game-screen {
    width: 100%;
    height: calc(100vh - 46px);
    margin: 0;
    border: none;
  }

  .game-window:fullscreen #game-canvas {
    width: auto;
    height: 100%;
    max-width: 100vw;
    aspect-ratio: 1 / 1;
  }

  .launcher-overlay {
    position: absolute;
    inset: 0;
    background: rgba(8, 5, 14, 0.92);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 14px;
    z-index: 10;
  }

  .btn-start {
    background: #ffd700;
    color: #111;
    border: none;
    padding: 10px 24px;
    font-weight: 800;
    font-size: 1rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    cursor: pointer;
    border-radius: 4px;
    transition: transform 0.1s, box-shadow 0.2s;
  }

  .btn-start:hover {
    transform: scale(1.05);
    box-shadow: 0 0 15px rgba(255, 215, 0, 0.6);
  }

  .hint {
    font-size: 0.85rem;
    color: #9d8ba9;
    font-family: monospace;
  }
</style>