---
import Layout from '../layouts/Layout.astro';
import NavCard from '../components/NavCard.astro';
import Notes from '../components/Notes.astro';

// Массив категорий
const mainCategories = [
  { title: "Книги", img: "/images/books.jpg", url: "/books" },
  { title: "Музыка", img: "/images/music.jpg", url: "/music" },
  { title: "Мини-игры", img: "/images/games.jpg", url: "/games" },
  { title: "Арты", img: "/images/arts.jpg", url: "/arts" },
  { title: "Рассказы", img: "/images/stories.jpg", url: "/stories" },
  { title: "Заявка", url: "/zayavka" },
  { title: "Рассказы", url: "/allkonrass" },
];

// Массив кнопок для удобного рендера списком
const actionButtons = [
  { title: "КОНКУРС", url: "/konkurs" },
  { title: "ВИКТОРИНА", url: "/quiz_obitel_smerti.html" },
  { title: "БИБЛИОТЕКА ЗНАНИЙ", url: "/gemini-code-1786123660299.html" },
  { title: "МУЗЫКАЛЬНАЯ КАРУСЕЛЬ", url: "/lorin_death_carousel_final.html" },
  { title: "ТЁМНЫЙ МИР", url: "/Darks.html" },
  { title: "ТЁМНЫЙ МИР 2", url: "/shadow-world/index.html" },
];
---

<Layout title="Моррис Град - Время движется лишь вперёд">

  <main class="container">
    <section class="music-banner-container">
      <div class="banner-left">
        <img 
          src="https://via.placeholder.com/400x400.png?text=New+Track" 
          alt="Обложка трека" 
          class="album-cover" 
          loading="lazy"
        />
      </div>

      <div class="banner-right">
        <div class="video-responsive">
          <iframe 
            width="560" 
            height="315" 
            src="https://www.youtube.com/embed?listType=playlist&list=PL8dSqpGZDZjYy2by-U3dQvZr_7ho7-fmA" 
            title="YouTube video player" 
            allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
            allowfullscreen>
          </iframe>
        </div>
      </div>
    </section>

    <h1 class="welcome-text">Добро пожаловать, Элфдид!</h1>

    <!-- Рендер кнопок через map для чистоты кода -->
    {actionButtons.map((btn) => (
      <a href={btn.url} class="quiz-button">
        {btn.title}
      </a>
    ))}

    <div class="main-grid">
      {mainCategories.map((item) => (
        <NavCard title={item.title} img={item.img} url={item.url} />
      ))}
    </div>

    <Notes transition:persist />
  </main>

</Layout>

<style>
  .music-banner-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 30px;
    padding: 20px 0;
    width: 100%;
  }

  .banner-left {
    flex: 1;
    min-width: 300px;
    display: flex;
    justify-content: center;
  }

  .album-cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  }

  .banner-right {
    flex: 1;
    min-width: 300px;
  }

  .video-responsive {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
  }

  .video-responsive iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (max-width: 768px) {
    .music-banner-container {
      flex-direction: column;
    }
  }

  .quiz-button {
    display: block;
    max-width: 600px;
    width: 80%;
    margin: 40px auto;
    padding: 20px 40px;
    font-size: 1.8rem;
    font-weight: 700;
    text-align: center;
    text-decoration: none;
    color: #fff;
    background-image: url('/images/4242424.png');
    background-size: cover;
    background-position: center;
    border: 2px solid rgba(160, 32, 240, 0.5);
    border-radius: 15px;
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
    box-shadow: 0 0 20px rgba(160, 32, 240, 0.5);
    z-index: 1;
  }

  .quiz-button::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(46, 9, 78, 0.75);
    opacity: 0;
    transition: opacity 0.5s ease;
    backdrop-filter: blur(3px);
    z-index: -1;
  }

  .quiz-button:hover {
    transform: translateY(-3px);
    box-shadow: 0 0 30px rgba(160, 32, 240, 0.8), 0 0 50px rgba(160, 32, 240, 0.6);
    border-color: var(--accent-gold);
    color: #fff;
  }

  .quiz-button:hover::before {
    opacity: 1;
  }
</style>