---
import Layout from '../layouts/Layout.astro';
import NavCard from '../components/NavCard.astro';
import SecondaryBtn from '../components/SecondaryBtn.astro';
import Notes from '../components/Notes.astro';

// Массив для основных кнопок (Книги, Музыка и т.д.)
const mainCategories = [
  { title: "Книги", img: "/images/books.jpg", url: "/books" },
  { title: "Музыка", img: "/images/music.jpg", url: "/music" },
  { title: "Мини-игры", img: "/images/games.jpg", url: "/games" },
  { title: "Арты", img: "/images/arts.jpg", url: "/arts" },
  { title: "Рассказы", img: "/images/stories.jpg", url: "/stories" },
];

// Массив для горизонтальных кнопок (Герои, Миры и т.д.)
const secondaryLinks = [
  { title: "Профиль", url: "/profile" },
  { title: "Герои", url: "/heroes" },
  { title: "Миры", url: "/worlds" },
  { title: "Города", url: "/cities" },
];
---

<Layout title="Моррис Град - Время движется лишь вперёд">

  <main class="container">
    <section class="music-banner-container">
      <!-- ЛЕВАЯ ЧАСТЬ: Картинка -->
      <div class="banner-left">
        <!-- Замените src на путь к вашей картинке -->
        <img src="https://via.placeholder.com/400x400.png?text=New+Track" alt="Когда то тут была надпись (Обложка трека), но решила убрать чтобы люди не путались)" class="album-cover">
      </div>

      <!-- ПРАВАЯ ЧАСТЬ: YouTube плеер -->
      <div class="banner-right">
        <div class="video-responsive">
          <iframe width="560" height="315" src="https://www.youtube.com/embed?listType=playlist&list=PL8dSqpGZDZjYy2by-U3dQvZr_7ho7-fmA" title="YouTube video player" allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
        </div>
      </div>
    </section>

    <h1 class="welcome-text">Добро пожаловать, Элфдид!</h1>

    <a href="/quiz_obitel_smerti.html" class="quiz-button">
      ВИКТОРИНА
    </a>
    
    <a href="/gemini-code-1786123660299.html" class="quiz-button">
      БИБЛИОТЕКА ЗНАНИЙ
    </a>

    <a href="/lorin_death_carousel_final.html" class="quiz-button">
      МУЗЫКАЛЬНАЯ КАРУСЕЛЬ
    </a>

    <div class="main-grid">
      {mainCategories.map((item) => (
        <NavCard title={item.title} img={item.img} url={item.url} />
      ))}
    </div>

    <!-- Компонент со случайными заметками -->
    <Notes transition:persist />
  </main>

</Layout>

<style>
  /* Стили для нового баннера */
  .music-banner-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 30px;
    padding: 20px 0;
    width: 100%;
  }

  .banner-left {
    flex: 1;
    min-width: 300px;
    display: flex;
    justify-content: center;
  }

  .album-cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
  }

  .banner-right {
    flex: 1;
    min-width: 300px;
  }

  .video-responsive {
    position: relative;
    padding-bottom: 56.25%; /* 16:9 */
    height: 0;
    overflow: hidden;
    border-radius: 12px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.5);
  }

  .video-responsive iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (max-width: 768px) {
    .music-banner-container {
      flex-direction: column;
    }
  }

  .quiz-button {
    display: block;
    max-width: 600px; /* Максимальная ширина */
    width: 80%;       /* Ширина относительно родителя */
    margin: 40px auto;
    padding: 20px 40px;
    font-size: 1.8rem;
    font-weight: 700;
    text-align: center;
    text-decoration: none;
    color: #fff;
    /* Убираем фон и ставим картинку */
    background-image: url('/images/4242424.png');
    background-size: cover;
    background-position: center;
    border: 2px solid rgba(160, 32, 240, 0.5);
    border-radius: 15px;
    position: relative;
    overflow: hidden;
    transition: all 0.3s ease;
    box-shadow: 0 0 20px rgba(160, 32, 240, 0.5);
    z-index: 1; /* Для корректной работы псевдо-элемента */
  }

  /* Псевдо-элемент для фиолетового фильтра */
  .quiz-button::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    /* Темно-фиолетовый с прозрачностью для затемнения */
    background-color: rgba(46, 9, 78, 0.75);
    opacity: 0; /* Изначально фильтр прозрачный */
    transition: opacity 0.5s ease; /* Плавный переход */
    backdrop-filter: blur(3px); /* Размытие фона под фильтром */
    z-index: -1; /* Размещаем под текстом, но над фоновой картинкой */
  }

  .quiz-button:hover {
    transform: translateY(-3px);
    box-shadow: 0 0 30px rgba(160, 32, 240, 0.8), 0 0 50px rgba(160, 32, 240, 0.6);
    border-color: var(--accent-gold);
    color: #fff; /* Убедимся, что текст всегда белый */
  }

  .quiz-button:hover::before {
    opacity: 1; /* При наведении делаем фильтр полностью видимым */
  }

</style>