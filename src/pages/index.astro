---
import Layout from '../layouts/Layout.astro';
import NavCard from '../components/NavCard.astro';
import Notes from '../components/Notes.astro';
import BookReader from '../components/BookReader.astro';
import { getAllBooks } from '../utils/fb2';

// Динамическая загрузка всех книг цикла из FB2
const allBooks = await getAllBooks();
const book = allBooks[0];

// Основные разделы вселенной
const mainCategories = [
  { title: "Книги", img: "/images/1.jpg", url: "/books" },
  { title: "Мини-игры", img: "/images/3.jpg", url: "/games" },
  { title: "Галерея", img: "/images/4.jpeg", url: "/arts" },
  { title: "Заявка", img: "/images/6.jpeg", url: "/zayavka" },
  { title: "Архив", img: "/images/7.jpeg", url: "/allkonrass" },
];

// Активности и интерактивные модули с фоновыми артами персонажей
const activities = [
  { 
    title: "ТЁМНЫЙ МИР 2", 
    desc: "Испытательный полигон механик", 
    tag: "Beta", 
    icon: "🌌", 
    url: "/shadow-world/index.html",
    bg: "/images/all/characters/Girl_standing_in_purple_light_2K_20260926123035.jpg"
  },
  { 
    title: "МУЗЫКАЛЬНАЯ КАРУСЕЛЬ", 
    desc: "Интерактивный плеер песен Lorin Death", 
    tag: "Аудио", 
    icon: "🎵", 
    url: "/lorin_death_carousel_final.html",
    bg: "/images/all/characters/Lorine_dancing_with_singer_2K_202608132046.jpeg"
  },
];
---

<Layout title="Моррис Град — Время движется лишь вперёд">
  <main class="container">
    
    <!-- Hero / Медиа-секция -->
    <section class="hero-section">
      <div class="hero-header">
        <span class="hero-badge">✦ ХРОНИКИ МОРРИСГРАДА // ПРЯМОЙ ЭФИР ✦</span>
        <h1 class="welcome-text">Добро пожаловать, Элфдид!</h1>
        
        <!-- Арт-деко орнаментальная линия -->
        <div class="hero-artdeco-ornament" aria-hidden="true">
          <span class="artdeco-line"></span>
          <span class="artdeco-diamond">◆</span>
          <span class="artdeco-symbol">❖ ⚜ ❖</span>
          <span class="artdeco-diamond">◆</span>
          <span class="artdeco-line"></span>
        </div>

        <p class="hero-subtitle">«Время движется лишь вперёд, а тени прошлого обретают плоть»</p>
      </div>

      <div class="music-banner-container">
        <!-- Медиа-карточка слева: Интерактивная Книга (Летопись «Обитель Смерти») -->
        <div class="banner-left">
          <article class="book-card-artdeco" id="main-book-card">
            <!-- Угловые орнаменты в стиле Арт-Деко -->
            <div class="deco-bracket br-top-left"></div>
            <div class="deco-bracket br-top-right"></div>
            <div class="deco-bracket br-bot-left"></div>
            <div class="deco-bracket br-bot-right"></div>

            <!-- Фоновый мистический арт персонажа для глубины -->
            <div class="book-ambient-art-layer" aria-hidden="true">
              <img 
                src="/images/all/characters/Dark_art_minimal_anime_style_202609021820.jpeg" 
                alt="" 
                class="book-ambient-img" 
                loading="lazy"
              />
              <div class="book-ambient-vignette"></div>
            </div>

            <!-- 3D Обложка книги с золотым арт-деко тиснением -->
            <div class="book-spine-wrapper" data-open-book data-book-mode="read" title="Нажмите, чтобы открыть летопись">
              <div class="book-cover-3d">
                <img 
                  src={book.coverImage} 
                  alt={book.title} 
                  class="book-cover-img" 
                  loading="lazy"
                />
                <div class="book-cover-gilded-frame">
                  <span class="cover-gold-crest">⚜</span>
                </div>
                <div class="book-spine-strip"></div>
                <div class="cover-shine-sheen"></div>
              </div>
            </div>

            <!-- Информационная часть книги -->
            <div class="book-card-info">
              <div class="book-card-top-row">
                <span class="book-pill-flame">
                  <span class="flame-dot"></span> ЛЕТОПИСЬ // ТОМ I
                </span>
                <span class="book-chapters-pill">📜 {book.totalChapters} глав</span>
              </div>

              <span class="book-series-sub">✦ {book.series}</span>
              <h3 class="book-title-heading">{book.title}</h3>
              <p class="book-author-txt">Летописец: <strong>{book.author}</strong></p>

              <p class="book-excerpt-txt">
                «В ледяных пустошах Альказака больше не действуют старые законы. Привычный фарм оборачивается столкновением с Черной магией, а мертвый интерфейс неожиданно начинает откликаться на команды...»
              </p>

              <!-- Кнопки действий -->
              <div class="book-actions-row">
                <button class="btn-book-action btn-read-action" data-open-book data-book-mode="read" data-target-chapter="0" title="Начать чтение с первой главы">
                  <span class="btn-action-icon">📖</span> Читать книгу
                </button>
                <button class="btn-book-action btn-toc-action" data-open-book data-book-mode="toc" title="Открыть оглавление со списком всех глав">
                  <span class="btn-action-icon">📜</span> Содержание
                </button>
              </div>
            </div>
          </article>
        </div>

        <!-- Видеоплеер плейлиста YouTube справа с арт-деко оформлением -->
        <div class="banner-right">
          <div class="video-card-frame">
            <!-- Угловые орнаменты в стиле Арт-Деко -->
            <div class="deco-bracket br-top-left"></div>
            <div class="deco-bracket br-top-right"></div>
            <div class="deco-bracket br-bot-left"></div>
            <div class="deco-bracket br-bot-right"></div>

            <div class="video-top-bar">
              <span class="video-status-dot"></span>
              <span class="video-bar-title">LORIN DEATH // ВИДЕОХРОНИКИ</span>
            </div>

            <div class="video-responsive">
              <iframe 
                width="560" 
                height="315" 
                src="https://www.youtube.com/embed/listType=playlist&list=PL8dSqpGZDZjYy2by-U3dQvZr_7ho7-fmA" 
                title="Lorin Death Music Player" 
                allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                allowfullscreen>
              </iframe>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Разделительная руническая линия -->
    <div class="shimmer-line"></div>

    <!-- ФЛАГМАНСКИЙ БЛОК: «ПРОКЛЯТЫЕ» -->
    <section class="flagship-section">
      <a href="/MorrisCurse" class="flagship-card" title="Запустить игру ПРОКЛЯТЫЕ">
        <div class="flagship-corners top-l"></div>
        <div class="flagship-corners top-r"></div>
        <div class="flagship-corners bot-l"></div>
        <div class="flagship-corners bot-r"></div>

        <div class="flagship-aura"></div>

        <div class="flagship-content">
          <div class="flagship-badge">
            <span class="badge-dot"></span> ОНЛАЙН РПГ // СЕРВЕР АКТИВЕН
          </div>

          <h2 class="flagship-title">ПРОКЛЯТЫЕ</h2>
          <p class="flagship-desc">
            Многопользовательское 2D-приключение в пустошах Адского Пламени. Выбирайте класс, сражайтесь в дуэлях, бросайте вызов Кейт и Дару, исследуйте порталы неизведанных миров в реальном времени.
          </p>

          <div class="flagship-meta">
            <span class="meta-tag">⚔️ 4 Боевых Класса</span>
            <span class="meta-tag">⚡ Real-Time WebSocket</span>
            <span class="meta-tag">👑 Боссы и Дуэли</span>
            <span class="meta-tag">🌐 Cloudflare Durable Objects</span>
          </div>
        </div>

        <div class="flagship-cta">
          <div class="btn-play">
            <span class="btn-text">ВОЙТИ В ИГРУ</span>
            <span class="btn-arrow">→</span>
          </div>
          <span class="cta-hint">Запуск на весь экран • WASD управление</span>
        </div>
      </a>
    </section>

    <div class="shimmer-line"></div>

    <!-- Сетка активностей и мини-игр -->
    <section class="activities-section">
      <div class="section-header-block">
        <h2 class="block-title">Испытания и Хроники</h2>
        <span class="block-subtitle">Интерактивные порталы и знания Обители Смерти</span>
      </div>

      <!-- ВЫДЕЛЕННЫЙ БЛОК: СЮЖЕТНЫЙ КВЕСТ-КОНКУРС (ВЫДЕЛЕН КАК ИГРА) -->
      <article class="konkurs-quest-banner">
        <!-- Угловые арт-деко скобы -->
        <div class="deco-bracket br-top-left"></div>
        <div class="deco-bracket br-top-right"></div>
        <div class="deco-bracket br-bot-left"></div>
        <div class="deco-bracket br-bot-right"></div>

        <!-- Фоновый атмосферный арт персонажей -->
        <div class="konkurs-bg-layer" aria-hidden="true">
          <img src="/images/all/characters/Three_characters_posing_with_rose_2K_20260910204518.jpeg" alt="" class="konkurs-bg-img" loading="lazy" />
          <div class="konkurs-bg-vignette"></div>
        </div>

        <div class="konkurs-content">
          <div class="konkurs-top-row">
            <span class="konkurs-game-badge">
              <span class="badge-gem">✦</span> 🎮 ИГРОВОЙ КВЕСТ // ГЛАВНОЕ СОБЫТИЕ
            </span>
            <span class="konkurs-timer-badge">⏳ До 26 октября 2026</span>
          </div>

          <h3 class="konkurs-title">КОНКУРС-КВЕСТ: ЛУЧШИЙ ПЕРСОНАЖ</h3>
          <p class="konkurs-series-tag">✦ Интерактивное сюжетное состязание вселенной МоррисГрад</p>

          <p class="konkurs-desc">
            «Я хочу предложить тебе игру. А точнее даже конкурс!» Создайте персонажа для государства Альказак и клана «Праведные коты». Пропишите его характер и внешность, соблюдайте законы мира без магии, проведите героя через роковое предзнаменование в зеркале смерти и заберите реальные трофеи!
          </p>

          <div class="konkurs-prizes-grid">
            <div class="prize-pill">
              <span class="prize-trophy">👑</span>
              <div class="prize-info">
                <strong>1 МЕСТО</strong>
                <span>3000 ₽ • Дакимакура с Lorin • 100🔥</span>
              </div>
            </div>
            <div class="prize-pill">
              <span class="prize-trophy">🥈</span>
              <div class="prize-info">
                <strong>2 МЕСТО</strong>
                <span>2000 ₽ • Арт с Lorin • 50🔥</span>
              </div>
            </div>
            <div class="prize-pill">
              <span class="prize-trophy">🥉</span>
              <div class="prize-info">
                <strong>3 МЕСТО</strong>
                <span>1000 ₽ • 10🔥 на аккаунт</span>
              </div>
            </div>
          </div>

          <div class="konkurs-actions">
            <a href="/konkurs" class="btn-konkurs-primary" title="Правила, механики и условия участия в квесте">
              <span class="btn-rune">⚔️</span> ПРИНЯТЬ УЧАСТИЕ В ИГРЕ
            </a>
            <a href="/zayavka" class="btn-konkurs-secondary" title="Подать анкету персонажа">
              <span>✍️</span> Подать анкету героя
            </a>
            <a href="/allkonrass" class="btn-konkurs-ghost" title="Читать работы жителей">
              <span>📜</span> Летопись работ
            </a>
          </div>
        </div>
      </article>

      <div class="activities-grid">
        {activities.map((item) => (
          <a href={item.url} class="activity-card">
            <!-- Фоновый атмосферный арт персонажа -->
            {item.bg && (
              <div class="act-card-bg-layer" aria-hidden="true">
                <img src={item.bg} alt="" class="act-card-bg-img" loading="lazy" />
                <div class="act-card-bg-vignette"></div>
              </div>
            )}

            <!-- Угловые арт-деко засечки -->
            <div class="card-deco-corner c-tl"></div>
            <div class="card-deco-corner c-tr"></div>
            <div class="card-deco-corner c-bl"></div>
            <div class="card-deco-corner c-br"></div>

            <div class="act-card-top">
              <span class="act-icon">{item.icon}</span>
              <span class="act-tag">{item.tag}</span>
            </div>
            <h3 class="act-title">{item.title}</h3>
            <p class="act-desc">{item.desc}</p>
            <div class="act-footer">
              <span class="act-link-label">Открыть портал</span>
              <span class="act-arrow">→</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <div class="shimmer-line"></div>

    <!-- Основные разделы вселенной -->
    <section class="categories-section">
      <div class="section-header-block">
        <h2 class="block-title">Архивы Вселенной</h2>
        <span class="block-subtitle">Литература, галереи, музыка и летописи</span>
      </div>

      <div class="main-grid">
        {mainCategories.map((item) => (
          <NavCard title={item.title} img={item.img} url={item.url} />
        ))}
      </div>
    </section>

    <div class="shimmer-line"></div>

    <!-- Заметки создателя мира -->
    <section class="notes-section">
      <div class="section-header-block">
        <h2 class="block-title">Эхо Мыслей</h2>
        <span class="block-subtitle">Случайные заметки и фрагменты хроник Lorin Death</span>
      </div>
      <Notes transition:persist />
    </section>

    <!-- Арт-Деко Модальный Ридер Книг Цикла -->
    <BookReader books={allBooks} />

  </main>
</Layout>

<style>
  /* ==========================================================================\n     HERO СЕКЦИЯ С АРТ-ДЕКО ЭСТЕТИКОЙ\n     ========================================================================== */
  .hero-section {
    padding-top: 1rem;
    margin-bottom: 2rem;
  }

  .hero-header {
    text-align: center;
    margin-bottom: 2.5rem;
    position: relative;
  }

  .hero-badge {
    display: inline-block;
    color: var(--accent-gold);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 2.5px;
    background: rgba(245, 208, 97, 0.08);
    border: 1px solid rgba(245, 208, 97, 0.3);
    padding: 4px 14px;
    border-radius: 999px;
    margin-bottom: 1.2rem;
    text-shadow: 0 0 10px var(--gold-glow);
  }

  .welcome-text {
    font-size: 2.9rem;
    margin: 0.2rem 0 0.5rem;
    color: #fff;
    background: linear-gradient(135deg, #ffffff 30%, var(--accent-gold) 90%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    text-shadow: 0 0 35px rgba(245, 208, 97, 0.3);
    letter-spacing: 1.5px;
  }

  /* Арт-деко орнамент под заголовком */
  .hero-artdeco-ornament {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin: 0.8rem auto 1.2rem;
    max-width: 480px;
  }
  .artdeco-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(245, 208, 97, 0.5), transparent);
  }
  .artdeco-diamond {
    color: var(--accent-gold);
    font-size: 0.55rem;
    opacity: 0.8;
  }
  .artdeco-symbol {
    color: var(--accent-gold);
    font-size: 0.95rem;
    letter-spacing: 4px;
    text-shadow: 0 0 10px var(--gold-glow);
  }

  .hero-subtitle {
    font-size: 1.05rem;
    color: var(--text-muted);
    font-style: italic;
    margin: 0 auto;
    max-width: 640px;
    letter-spacing: 0.4px;
    line-height: 1.6;
  }

  .music-banner-container {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: stretch;
    gap: 28px;
    margin-top: 2rem;
  }

  .banner-left, .banner-right {
    flex: 1;
    min-width: 320px;
    display: flex;
  }

  /* ==========================================================================\n     АРТ-ДЕКО КАРТОЧКА КНИГИ (ЛЕВАЯ КАРТОЧКА)\n     ========================================================================== */
  .book-card-artdeco {
    width: 100%;
    background: linear-gradient(135deg, rgba(26, 12, 44, 0.92) 0%, rgba(12, 6, 22, 0.96) 60%, rgba(6, 3, 12, 0.98) 100%);
    border: 1px solid rgba(245, 208, 97, 0.35);
    border-radius: 18px;
    padding: 1.8rem;
    display: flex;
    align-items: center;
    gap: 24px;
    position: relative;
    overflow: hidden;
    box-shadow: 
      0 14px 40px rgba(0, 0, 0, 0.8),
      0 0 30px rgba(168, 85, 247, 0.15),
      inset 0 0 30px rgba(245, 208, 97, 0.05);
    backdrop-filter: blur(14px);
    transition: all 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .book-card-artdeco:hover {
    transform: translateY(-5px);
    border-color: var(--accent-gold);
    box-shadow: 
      0 18px 50px rgba(0, 0, 0, 0.9),
      0 0 35px var(--gold-glow),
      inset 0 0 25px rgba(168, 85, 247, 0.15);
  }

  /* Угловые арт-деко скобы */
  .deco-bracket {
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: var(--accent-gold);
    border-style: solid;
    pointer-events: none;
    z-index: 5;
    transition: all 0.3s ease;
  }
  .br-top-left { top: 8px; left: 8px; border-width: 2px 0 0 2px; }
  .br-top-right { top: 8px; right: 8px; border-width: 2px 2px 0 0; }
  .br-bot-left { bottom: 8px; left: 8px; border-width: 0 0 2px 2px; }
  .br-bot-right { bottom: 8px; right: 8px; border-width: 0 2px 2px 0; }

  .book-card-artdeco:hover .deco-bracket {
    box-shadow: 0 0 8px var(--accent-gold);
  }

  /* Фоновый слой арта персонажа */
  .book-ambient-art-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 0;
  }
  .book-ambient-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.15;
    filter: contrast(1.2) brightness(0.9);
    transition: opacity 0.5s ease, transform 0.6s ease;
  }
  .book-card-artdeco:hover .book-ambient-img {
    opacity: 0.28;
    transform: scale(1.05);
  }
  .book-ambient-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 70% 50%, rgba(14, 7, 24, 0.5) 0%, rgba(6, 3, 12, 0.95) 100%);
  }

  /* 3D Обложка книги */
  .book-spine-wrapper {
    flex-shrink: 0;
    cursor: pointer;
    perspective: 800px;
    z-index: 2;
  }

  .book-cover-3d {
    position: relative;
    width: 135px;
    height: 195px;
    border-radius: 6px 10px 10px 6px;
    overflow: hidden;
    box-shadow: 
      -5px 5px 20px rgba(0, 0, 0, 0.9),
      5px 8px 25px rgba(0, 0, 0, 0.7),
      0 0 15px rgba(245, 208, 97, 0.3);
    border: 1px solid rgba(245, 208, 97, 0.5);
    transform: rotateY(-8deg);
    transition: all 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .book-card-artdeco:hover .book-cover-3d {
    transform: rotateY(0deg) scale(1.04);
    box-shadow: 
      0 12px 30px rgba(0, 0, 0, 0.9),
      0 0 25px var(--gold-glow);
    border-color: var(--accent-gold);
  }

  .book-cover-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .book-spine-strip {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 8px;
    background: linear-gradient(90deg, rgba(0,0,0,0.85) 0%, rgba(245,208,97,0.3) 50%, rgba(0,0,0,0.5) 100%);
    box-shadow: 1px 0 3px rgba(0,0,0,0.6);
  }

  .book-cover-gilded-frame {
    position: absolute;
    inset: 6px;
    border: 1px solid rgba(245, 208, 97, 0.4);
    pointer-events: none;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 8px;
  }
  .cover-gold-crest {
    color: var(--accent-gold);
    font-size: 0.9rem;
    text-shadow: 0 0 6px var(--accent-gold);
  }

  .cover-shine-sheen {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.2) 0%, transparent 45%, rgba(0, 0, 0, 0.6) 100%);
    pointer-events: none;
  }

  /* Информация о книге */
  .book-card-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
    z-index: 2;
  }

  .book-card-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    flex-wrap: wrap;
  }

  .book-pill-flame {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.75rem;
    font-weight: 800;
    color: var(--accent-gold);
    background: rgba(245, 208, 97, 0.1);
    border: 1px solid rgba(245, 208, 97, 0.35);
    padding: 3px 10px;
    border-radius: 999px;
    font-family: monospace;
    letter-spacing: 1px;
  }
  .flame-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #f59e0b;
    box-shadow: 0 0 8px #f59e0b;
    animation: flamePulse 1.8s infinite;
  }
  @keyframes flamePulse {
    0%, 100% { opacity: 0.8; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.3); }
  }

  .book-chapters-pill {
    font-size: 0.75rem;
    color: var(--energy-purple-bright);
    background: rgba(168, 85, 247, 0.12);
    border: 1px solid rgba(168, 85, 247, 0.3);
    padding: 3px 9px;
    border-radius: 999px;
    font-weight: 600;
  }

  .book-series-title, .book-series-sub {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--energy-purple-bright);
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .book-main-title {
    margin: 2px 0 0;
    font-size: 1.55rem;
    color: #fff;
    font-family: var(--font-heading);
    letter-spacing: 0.8px;
    line-height: 1.25;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.7);
  }

  .book-author-txt {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
  .book-author-txt strong {
    color: var(--accent-gold);
  }

  .book-excerpt-txt {
    margin: 4px 0 10px;
    font-size: 0.84rem;
    color: #cdc4dc;
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .book-actions-row {
    display: flex;
    gap: 10px;
    margin-top: 4px;
    flex-wrap: wrap;
  }

  .btn-book-action {
    padding: 8px 16px;
    border-radius: 8px;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: all 0.25s ease;
  }

  .btn-read-action {
    background: linear-gradient(135deg, #ffd700 0%, #f59e0b 100%);
    color: #0c0617;
    border: none;
    box-shadow: 0 4px 15px rgba(245, 208, 97, 0.4);
  }
  .btn-read-action:hover {
    transform: translateY(-2px);
    background: linear-gradient(135deg, #fff176 0%, #ffd700 100%);
    box-shadow: 0 6px 20px rgba(245, 208, 97, 0.65);
  }

  .btn-toc-action {
    background: rgba(32, 16, 54, 0.8);
    border: 1px solid rgba(245, 208, 97, 0.4);
    color: var(--accent-gold);
  }
  .btn-toc-action:hover {
    background: rgba(45, 22, 75, 0.9);
    border-color: var(--accent-gold);
    color: #fff;
    box-shadow: 0 0 12px var(--gold-glow);
    transform: translateY(-2px);
  }

  .btn-action-icon {
    font-size: 0.95rem;
  }

  /* ==========================================================================\n     КАРКАС ДЛЯ ВИДЕО (ПРАВАЯ КАРТОЧКА)\n     ========================================================================== */
  .video-card-frame {
    width: 100%;
    border-radius: 18px;
    overflow: hidden;
    border: 1px solid rgba(245, 208, 97, 0.35);
    background: #08040f;
    box-shadow: 0 14px 40px rgba(0, 0, 0, 0.8), 0 0 30px rgba(168, 85, 247, 0.15);
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    transition: all 0.35s ease;
  }
  .video-card-frame:hover {
    transform: translateY(-5px);
    border-color: var(--accent-gold);
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.9), 0 0 25px var(--purple-glow);
  }

  .video-card-frame:hover .deco-bracket {
    box-shadow: 0 0 8px var(--accent-gold);
  }

  .video-top-bar {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    background: rgba(14, 7, 24, 0.85);
    border-bottom: 1px solid rgba(245, 208, 97, 0.2);
    z-index: 2;
  }
  .video-status-dot {
    width: 7px;
    height: 7px;
    background: #ef4444;
    border-radius: 50%;
    box-shadow: 0 0 6px #ef4444;
  }
  .video-bar-title {
    font-size: 0.74rem;
    font-family: monospace;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: var(--accent-gold);
  }

  .video-responsive {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
    overflow: hidden;
    flex: 1;
  }
  .video-responsive iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* ==========================================================================\n     ФЛАГМАНСКАЯ КАРТОЧКА: «ПРОКЛЯТЫЕ»\n     ========================================================================== */
  .flagship-section {
    margin: 2.5rem 0;
  }

  .flagship-card {
    position: relative;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    padding: 2.5rem 3rem;
    background: linear-gradient(135deg, rgba(38, 16, 68, 0.88) 0%, rgba(18, 9, 34, 0.94) 60%, rgba(10, 5, 18, 0.98) 100%);
    border: 2px solid var(--accent-gold);
    border-radius: 20px;
    text-decoration: none;
    color: inherit;
    overflow: hidden;
    box-shadow: 0 15px 45px rgba(0, 0, 0, 0.8), 0 0 35px rgba(245, 208, 97, 0.25), inset 0 0 30px rgba(168, 85, 247, 0.15);
    transition: all 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .flagship-card:hover {
    transform: translateY(-6px);
    border-color: #ffe600;
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.9), 0 0 50px rgba(245, 208, 97, 0.4), 0 0 30px rgba(168, 85, 247, 0.5);
  }

  .flagship-aura {
    position: absolute;
    top: -50%;
    left: -20%;
    width: 140%;
    height: 200%;
    background: radial-gradient(circle at 30% 50%, rgba(168, 85, 247, 0.22) 0%, transparent 60%);
    pointer-events: none;
    transition: opacity 0.4s ease;
  }
  .flagship-card:hover .flagship-aura {
    opacity: 1;
  }

  .flagship-corners {
    position: absolute;
    width: 16px;
    height: 16px;
    border-color: var(--accent-gold);
    border-style: solid;
    pointer-events: none;
    z-index: 2;
  }
  .top-l { top: 10px; left: 10px; border-width: 3px 0 0 3px; }
  .top-r { top: 10px; right: 10px; border-width: 3px 3px 0 0; }
  .bot-l { bottom: 10px; left: 10px; border-width: 0 0 3px 3px; }
  .bot-r { bottom: 10px; right: 10px; border-width: 0 3px 3px 0; }

  .flagship-content {
    flex: 1;
    z-index: 1;
  }

  .flagship-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 1.5px;
    color: var(--accent-gold);
    background: rgba(245, 208, 97, 0.12);
    border: 1px solid rgba(245, 208, 97, 0.4);
    padding: 4px 12px;
    border-radius: 999px;
    margin-bottom: 1rem;
    font-family: monospace;
  }
  .badge-dot {
    width: 6px;
    height: 6px;
    background: #22c55e;
    border-radius: 50%;
    box-shadow: 0 0 8px #22c55e;
  }

  .flagship-title {
    font-size: 2.6rem;
    margin: 0 0 0.8rem;
    color: #fff;
    letter-spacing: 2px;
    text-shadow: 0 0 25px rgba(245, 208, 97, 0.4);
  }

  .flagship-desc {
    color: #ded6ed;
    font-size: 1.05rem;
    line-height: 1.6;
    max-width: 620px;
    margin: 0 0 1.5rem;
  }

  .flagship-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .meta-tag {
    font-size: 0.82rem;
    font-weight: 600;
    color: #f3e8ff;
    background: rgba(36, 17, 62, 0.7);
    border: 1px solid rgba(168, 85, 247, 0.35);
    padding: 5px 12px;
    border-radius: 8px;
    backdrop-filter: blur(4px);
  }

  .flagship-cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    z-index: 1;
    flex-shrink: 0;
  }

  .btn-play {
    background: linear-gradient(135deg, #ffd700 0%, #f59e0b 100%);
    color: #0c0617;
    font-weight: 800;
    font-size: 1.15rem;
    letter-spacing: 1.2px;
    padding: 18px 36px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    gap: 10px;
    box-shadow: 0 8px 25px rgba(245, 208, 97, 0.45);
    transition: all 0.3s ease;
  }
  .flagship-card:hover .btn-play {
    transform: scale(1.05);
    box-shadow: 0 10px 35px rgba(245, 208, 97, 0.75);
    background: linear-gradient(135deg, #fff176 0%, #ffd700 100%);
  }

  .btn-arrow {
    font-size: 1.3rem;
    transition: transform 0.3s ease;
  }
  .flagship-card:hover .btn-arrow {
    transform: translateX(4px);
  }

  .cta-hint {
    font-size: 0.78rem;
    color: var(--text-dim);
    font-family: monospace;
    letter-spacing: 0.3px;
  }

  /* ==========================================================================\n     СЕТКА АКТИВНОСТЕЙ (ACTIVITIES GRID) С ФОНАМИ ПЕРСОНАЖЕЙ\n     ========================================================================== */
  .section-header-block {
    text-align: center;
    margin-bottom: 2rem;
  }
  .block-title {
    font-size: 1.85rem;
    color: var(--accent-gold);
    margin: 0 0 0.4rem;
  }
  .block-subtitle {
    color: var(--text-muted);
    font-size: 0.95rem;
  }

  .activities-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 20px;
    margin: 1.5rem 0;
  }

  .activity-card {
    background: linear-gradient(135deg, rgba(28, 17, 46, 0.85) 0%, rgba(13, 8, 22, 0.95) 100%);
    border: 1px solid rgba(245, 208, 97, 0.25);
    border-radius: 14px;
    padding: 1.5rem 1.6rem;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 10px;
    position: relative;
    overflow: hidden;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.65);
    transition: all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  /* Фоновые персонажи для карточек */
  .act-card-bg-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 0;
  }
  .act-card-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.14;
    filter: saturate(0.7) contrast(1.15);
    transition: opacity 0.4s ease, transform 0.6s ease;
  }
  .activity-card:hover .act-card-bg-img {
    opacity: 0.32;
    transform: scale(1.08);
  }
  .act-card-bg-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at center, rgba(14, 8, 24, 0.4) 0%, rgba(10, 5, 18, 0.92) 80%);
  }

  /* Угловые засечки арт-деко */
  .card-deco-corner {
    position: absolute;
    width: 8px;
    height: 8px;
    border-color: rgba(245, 208, 97, 0.3);
    border-style: solid;
    pointer-events: none;
    z-index: 2;
    transition: all 0.25s ease;
  }
  .c-tl { top: 6px; left: 6px; border-width: 2px 0 0 2px; }
  .c-tr { top: 6px; right: 6px; border-width: 2px 2px 0 0; }
  .c-bl { bottom: 6px; left: 6px; border-width: 0 0 2px 2px; }
  .c-br { bottom: 6px; right: 6px; border-width: 0 2px 2px 0; }

  .activity-card:hover {
    transform: translateY(-5px);
    border-color: var(--accent-gold);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.8), 0 0 22px var(--gold-glow);
  }
  .activity-card:hover .card-deco-corner {
    border-color: var(--accent-gold);
    box-shadow: 0 0 6px var(--accent-gold);
  }

  .act-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    position: relative;
    z-index: 1;
  }
  .act-icon {
    font-size: 1.6rem;
    filter: drop-shadow(0 0 6px var(--energy-purple));
  }
  .act-tag {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: var(--accent-gold);
    background: rgba(245, 208, 97, 0.1);
    border: 1px solid rgba(245, 208, 97, 0.35);
    padding: 2px 8px;
    border-radius: 999px;
  }

  .act-title {
    font-size: 1.3rem;
    margin: 0;
    color: #fff;
    letter-spacing: 1px;
    position: relative;
    z-index: 1;
    transition: color 0.25s ease;
  }
  .activity-card:hover .act-title {
    color: var(--accent-gold);
  }

  .act-desc {
    color: var(--text-muted);
    font-size: 0.88rem;
    line-height: 1.5;
    margin: 0;
    flex: 1;
    position: relative;
    z-index: 1;
  }

  .act-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-top: 1px solid rgba(168, 85, 247, 0.2);
    padding-top: 10px;
    margin-top: 4px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--energy-purple-bright);
    position: relative;
    z-index: 1;
    transition: color 0.25s ease;
  }
  .activity-card:hover .act-footer {
    color: var(--accent-gold);
  }
  .act-arrow {
    transition: transform 0.25s ease;
  }
  .activity-card:hover .act-arrow {
    transform: translateX(4px);
  }

  /* ==========================================================================
     ВЫДЕЛЕННЫЙ БЛОК: СЮЖЕТНЫЙ КВЕСТ-КОНКУРС (ВЫДЕЛЕН КАК ИГРА)
     ========================================================================== */
  .konkurs-quest-banner {
    width: 100%;
    margin-bottom: 2rem;
    position: relative;
    border-radius: 18px;
    border: 2px solid var(--accent-gold);
    background: linear-gradient(135deg, rgba(34, 15, 60, 0.92) 0%, rgba(16, 8, 30, 0.96) 60%, rgba(8, 4, 16, 0.98) 100%);
    overflow: hidden;
    padding: 2.2rem 2.5rem;
    box-shadow: 
      0 16px 45px rgba(0, 0, 0, 0.85),
      0 0 35px var(--gold-glow),
      inset 0 0 30px rgba(168, 85, 247, 0.18);
    transition: all 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .konkurs-quest-banner:hover {
    transform: translateY(-4px);
    border-color: #ffe600;
    box-shadow: 
      0 20px 55px rgba(0, 0, 0, 0.92),
      0 0 45px rgba(245, 208, 97, 0.5),
      inset 0 0 35px rgba(168, 85, 247, 0.25);
  }

  .konkurs-bg-layer {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
    z-index: 0;
  }
  .konkurs-bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.16;
    filter: saturate(0.8) contrast(1.2);
    transition: opacity 0.5s ease, transform 0.6s ease;
  }
  .konkurs-quest-banner:hover .konkurs-bg-img {
    opacity: 0.32;
    transform: scale(1.04);
  }
  .konkurs-bg-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at 75% 50%, rgba(20, 9, 38, 0.45) 0%, rgba(8, 4, 16, 0.95) 85%);
  }

  .konkurs-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .konkurs-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }

  .konkurs-game-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 1.5px;
    color: var(--accent-gold);
    background: rgba(245, 208, 97, 0.15);
    border: 1px solid rgba(245, 208, 97, 0.45);
    padding: 5px 14px;
    border-radius: 999px;
    font-family: monospace;
    text-shadow: 0 0 10px var(--gold-glow);
  }
  .badge-gem {
    color: var(--accent-gold);
    animation: flamePulse 1.6s infinite;
  }

  .konkurs-timer-badge {
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--energy-purple-bright);
    background: rgba(168, 85, 247, 0.14);
    border: 1px solid rgba(168, 85, 247, 0.35);
    padding: 4px 12px;
    border-radius: 999px;
  }

  .konkurs-title {
    font-size: 2.1rem;
    margin: 4px 0 0;
    color: #fff;
    letter-spacing: 1.2px;
    text-shadow: 0 0 25px rgba(245, 208, 97, 0.35);
  }

  .konkurs-series-tag {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--energy-purple-bright);
    text-transform: uppercase;
    letter-spacing: 1.2px;
    margin: 0;
  }

  .konkurs-desc {
    color: #e2daf0;
    font-size: 0.98rem;
    line-height: 1.6;
    max-width: 820px;
    margin: 2px 0 8px;
  }

  .konkurs-prizes-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin: 4px 0 10px;
  }

  .prize-pill {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(24, 12, 42, 0.85);
    border: 1px solid rgba(245, 208, 97, 0.3);
    border-radius: 10px;
    padding: 8px 14px;
    backdrop-filter: blur(6px);
  }
  .prize-trophy {
    font-size: 1.4rem;
  }
  .prize-info {
    display: flex;
    flex-direction: column;
    font-size: 0.78rem;
  }
  .prize-info strong {
    color: var(--accent-gold);
    letter-spacing: 1px;
  }
  .prize-info span {
    color: #f3e8ff;
  }

  .konkurs-actions {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 6px;
    flex-wrap: wrap;
  }

  .btn-konkurs-primary {
    background: linear-gradient(135deg, #ffd700 0%, #f59e0b 100%);
    color: #0c0617;
    font-weight: 800;
    font-size: 0.98rem;
    letter-spacing: 1px;
    padding: 12px 26px;
    border-radius: 10px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    box-shadow: 0 6px 20px rgba(245, 208, 97, 0.4);
    transition: all 0.3s ease;
  }
  .btn-konkurs-primary:hover {
    transform: translateY(-2px);
    background: linear-gradient(135deg, #fff176 0%, #ffd700 100%);
    box-shadow: 0 8px 25px rgba(245, 208, 97, 0.7);
  }

  .btn-konkurs-secondary {
    background: rgba(36, 18, 62, 0.8);
    border: 1px solid rgba(245, 208, 97, 0.4);
    color: var(--accent-gold);
    font-weight: 700;
    font-size: 0.92rem;
    padding: 11px 20px;
    border-radius: 10px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.25s ease;
  }
  .btn-konkurs-secondary:hover {
    background: rgba(50, 25, 85, 0.9);
    border-color: var(--accent-gold);
    color: #fff;
    transform: translateY(-2px);
    box-shadow: 0 0 14px var(--gold-glow);
  }

  .btn-konkurs-ghost {
    color: var(--energy-purple-bright);
    border: 1px solid rgba(168, 85, 247, 0.35);
    background: rgba(20, 10, 36, 0.6);
    font-weight: 600;
    font-size: 0.88rem;
    padding: 11px 18px;
    border-radius: 10px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.25s ease;
  }
  .btn-konkurs-ghost:hover {
    border-color: var(--energy-purple-bright);
    color: #fff;
    background: rgba(35, 17, 60, 0.8);
    transform: translateY(-2px);
  }

  /* ==========================================================================\n     ОСНОВНАЯ СЕТКА КАТЕГОРИЙ (NAVCARD GRID)\n     ========================================================================== */
  .main-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 1.5rem;
    width: 100%;
    margin: 2rem 0;
  }

  /* Адаптивность для мобильных */
  @media (max-width: 900px) {
    .book-card-artdeco {
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 1.5rem;
    }
    .book-card-top-row {
      justify-content: center;
    }
    .book-actions-row {
      justify-content: center;
    }
    .flagship-card {
      flex-direction: column;
      align-items: flex-start;
      padding: 2rem;
    }
    .flagship-cta {
      width: 100%;
      align-items: stretch;
    }
    .btn-play {
      justify-content: center;
    }
    .cta-hint {
      text-align: center;
    }
    .welcome-text {
