---
import ForumShell from "../../../components/forum/ForumShell.astro";
import TopicCard from "../../../components/forum/TopicCard.astro";
import { forumPage } from "../../../lib/forum/page";
import { getAuthor, isMod } from "../../../lib/forum/service";
import { date, ago, roleLabel, plural } from "../../../lib/forum/fmt";
import Ava from "../../../components/forum/Ava.astro";
import { breadcrumbs, abs } from "../../../lib/seo";
export const prerender = false;
const { db, v } = await forumPage(Astro);
const key = decodeURIComponent(String(Astro.params.id));
const page = Math.max(1, Number(Astro.url.searchParams.get("page")) | 0 || 1);
const a = await getAuthor(db, v, key, page);
if (!a) { (Astro.locals as any).notFound = { title: "Участник не найден", text: "Такого профиля на форуме нет.", back: ["/forum", "← На форум"] }; return Astro.rewrite("/404"); }
const u = a.user;
// Старые адреса /forum/u/<Clerk id> → постоянный публичный /forum/u/<номер>
if (!/^\d+$/.test(key)) return Astro.redirect(`/forum/u/${u.pid}${page > 1 ? "?page=" + page : ""}`, 301);
const self = a.self;
const mod = isMod(v);
const onlineNow = Date.now() - u.last_seen < 5 * 60_000;
const st: any = a.stats;
// Профили без записей — «тонкие» страницы: noindex (ссылки всё равно проходят)
const thin = !((u.topics_count || 0) + (st?.comments || 0));
const profPath = `/forum/u/${u.pid}`;
const profDesc = `${u.nick} — ${u.rank || "участник"} форума МоррисГрада: ${u.topics_count} ${plural(u.topics_count, "тема", "темы", "тем")}, ${st?.comments ?? 0} ${plural(st?.comments ?? 0, "комментарий", "комментария", "комментариев")}, карма ${u.karma}.`;
const profLd = [{ "@context": "https://schema.org", "@type": "ProfilePage", url: abs(profPath), dateCreated: new Date(u.first_seen).toISOString(),
  mainEntity: { "@type": "Person", name: u.nick, url: abs(profPath), ...(u.avatar ? { image: abs("/api/forum/media/" + u.avatar) } : {}),
    interactionStatistic: [{ "@type": "InteractionCounter", interactionType: "https://schema.org/WriteAction", userInteractionCount: (u.topics_count || 0) + (st?.comments || 0) },
      { "@type": "InteractionCounter", interactionType: "https://schema.org/LikeAction", userInteractionCount: u.karma || 0 }] } },
  breadcrumbs([["Форум", "/forum"], [u.nick, profPath]])];
// Мини-график активности за 30 дней (inline SVG, без библиотек)
const W = 600, Hh = 70, bw = W / 30;
const maxN = Math.max(1, ...(st?.activity || []).map((x: any) => x.n));
const dLabel = (d: string) => new Date(d + "T12:00:00Z").toLocaleDateString("ru-RU", { day: "numeric", month: "short", timeZone: "UTC" });
---
<ForumShell title={page > 1 ? `${u.nick} — страница ${page}` : u.nick} viewer={v} active={self ? "me" : ""} description={profDesc} canonical={page > 1 ? `${profPath}?page=${page}` : profPath} type="profile" image={u.avatar ? "/api/forum/media/" + u.avatar : null} imageAlt={u.nick} robots={thin ? "noindex,follow" : null} jsonLd={thin ? [] : profLd}>
  <div class="f-grid">
    <main>
      <div class="f-box" style="margin-bottom:1rem">
        <div class="f-profile">
          <span class="f-author f-author-l"><Ava u={u} link={false} eager /></span>
          <div style="flex:1;min-width:220px">
            <h1 class="f-h1" style="font-family:var(--font-body)!important;letter-spacing:0">{u.nick} {u.role && <span class={`f-role f-role-${u.role}`} style="font-size:.8rem;vertical-align:middle">{roleLabel(u.role)}</span>}</h1>
            <div class="f-muted"><span class="f-rank" style="font-size:.85rem">{u.rank}</span> · на форуме с {date(u.first_seen)} · {onlineNow ? <span style="color:#4ade80">● сейчас на форуме</span> : <>был(а) {ago(u.last_seen)}</>}</div>
            <div class="f-pstats">
              <span class="f-pstat"><b>{u.topics_count}</b>{plural(u.topics_count, "тема", "темы", "тем")}</span>
              <span class="f-pstat"><b>{u.posts_count}</b>{plural(u.posts_count, "сообщение", "сообщения", "сообщений")}</span>
              <span class="f-pstat"><b style="color:var(--f-red)">♥ {u.karma}</b>карма</span>
            </div>
            {u.signature && <div class="f-sig" style="margin-top:.8rem">{u.signature}</div>}
          </div>
        </div>
        <div class="f-actions">
          {self && <a class="f-btn" href="/forum/me">⚙ Настройки профиля</a>}
          {!self && v.uid && <button class="f-btn f-btn-s" data-block={u.pid} data-value={a.blocked ? "0" : "1"}>{a.blocked ? "Показывать записи" : "Скрыть записи автора"}</button>}
          {mod && !self && u.role !== "admin" && (a.ban
            ? <><span class="f-badge f-badge-warn">ограничен {a.ban.until ? "до " + new Date(a.ban.until).toLocaleString("ru-RU", { timeZone: "Europe/Kiev" }) : "бессрочно"}</span><button class="f-btn f-btn-s" data-unban={u.pid}>Снять ограничение</button></>
            : <button class="f-btn f-btn-s f-btn-danger" data-ban={u.pid}>Ограничить на форуме</button>)}
          {mod && !self && u.avatar && (u.role !== "admin" && (u.role !== "moderator" || v.role === "admin")) && <button class="f-btn f-btn-s f-btn-danger" data-ava-remove={u.pid}>🖼 Убрать аватар</button>}
        </div>
      </div>
      {st && (
        <div class="f-box" style="margin-bottom:1rem" data-stats>
          <h2 style="font-size:1.1rem;margin-top:0">Статистика</h2>
          <div>
            <div style="display:flex;justify-content:space-between;gap:.5rem;flex-wrap:wrap"><span>Звание: <b class="f-rank">{st.rank.name}</b></span>
              <span class="f-muted" style="font-size:.85rem">{st.rank.next ? `до «${st.rank.next.name}» — ещё ${st.rank.next.left} ${plural(st.rank.next.left, "сообщение", "сообщения", "сообщений")} (${st.rank.pct}%)` : "высшее звание ✦"}</span></div>
            <div class="f-rankbar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow={st.rank.pct}><i style={`width:${st.rank.pct}%`}></i></div>
          </div>
          <div class="f-stats">
            <div class="f-stat"><b>{st.topics}</b><span>{plural(st.topics, "тема", "темы", "тем")}</span></div>
            <div class="f-stat"><b>{st.comments}</b><span>{plural(st.comments, "комментарий", "комментария", "комментариев")}</span></div>
            <div class="f-stat"><b style="color:var(--f-red)">♥ {st.likes_received}</b><span>оценок получено (карма)</span></div>
            <div class="f-stat"><b>{st.likes_given}</b><span>оценок поставлено</span></div>
            <div class="f-stat"><b style="font-size:.95rem">{date(st.first_seen)}</b><span>на форуме с</span></div>
            <div class="f-stat"><b style="font-size:.95rem">{onlineNow ? "сейчас" : ago(st.last_seen)}</b><span>последний визит</span></div>
          </div>
          {(st.best_topic || st.top_section) && (
            <div class="f-muted" style="display:flex;flex-direction:column;gap:.25rem;margin-bottom:.7rem">
              {st.best_topic && <span>🏆 Лучшая тема: <a href={`/forum/t/${st.best_topic.id}`}>{st.best_topic.title}</a> · ♥ {st.best_topic.likes} · 💬 {st.best_topic.comments}</span>}
              {st.top_section && <span>📍 Чаще всего пишет в разделе <a href={`/forum/s/${st.top_section.slug}`}>{st.top_section.icon} {st.top_section.title}</a></span>}
            </div>
          )}
          <div style="margin-bottom:.7rem">
            <div class="f-muted" style="font-size:.82rem;margin-bottom:.25rem">Активность за 30 дней: {st.activity_total} {plural(st.activity_total, "запись", "записи", "записей")}</div>
            <svg class="f-chart" viewBox={`0 0 ${W} ${Hh + 16}`} role="img" aria-label={`Активность за 30 дней: ${st.activity_total}`}>
              <line x1="0" x2={W} y1={Hh + .5} y2={Hh + .5} stroke="currentColor" stroke-opacity=".15" />
              {st.activity.map((x: any, i: number) => {
                const h = x.n ? Math.max(3, Math.round((x.n / maxN) * (Hh - 4))) : 1.5;
                return <rect x={i * bw + 1} y={Hh - h} width={bw - 2} height={h} rx="1.5" fill={x.n ? "#d4af37" : "currentColor"} fill-opacity={x.n ? .85 : .12}><title>{dLabel(x.d)}: {x.n}</title></rect>;
              })}
              <text x="0" y={Hh + 14} font-size="13" fill="currentColor" fill-opacity=".5">{dLabel(st.activity[0].d)}</text>
              <text x={W} y={Hh + 14} font-size="13" fill="currentColor" fill-opacity=".5" text-anchor="end">сегодня</text>
            </svg>
          </div>
          <div class="f-achs">
            {st.achievements.map((x: any) => <span class={`f-ach ${x.got ? "on" : "off"}`} title={x.got ? x.title : "Пока не получено: " + x.title}>{x.icon} {x.title}</span>)}
          </div>
        </div>
      )}
      <h2 style="font-size:1.2rem">Записи автора</h2>
      <div class="f-feed">
        {a.items.length ? a.items.map((t: any) => <TopicCard t={t} viewerUid={v.uid} />) : <div class="f-empty">Пока ни одной темы.</div>}
      </div>
      {(page > 1 || a.more) && <div class="f-pager">{page > 1 && <a class="f-btn" href={`?page=${page - 1}`}>← Назад</a>}{a.more && <a class="f-btn" href={`?page=${page + 1}`}>Дальше →</a>}</div>}
    </main>
    <aside class="f-side">
      <div class="f-box">
        <h3>Звания форума</h3>
        <p class="f-muted" style="margin:0">Звание растёт с числом сообщений, карма — с лайками от других участников.</p>
      </div>
    </aside>
  </div>
</ForumShell>
