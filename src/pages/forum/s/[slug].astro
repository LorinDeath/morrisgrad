---
import ForumShell from "../../../components/forum/ForumShell.astro";
import Author from "../../../components/forum/Author.astro";
import { forumPage } from "../../../lib/forum/page";
import { getSection, sectionTopics, isMod, sectionSubscribed } from "../../../lib/forum/service";
import { ago, plural } from "../../../lib/forum/fmt";
export const prerender = false;
const { db, v } = await forumPage(Astro);
const sec = await getSection(db, String(Astro.params.slug));
if (!sec) return new Response("Раздел не найден", { status: 404 });
const sort = Astro.url.searchParams.get("sort") === "top" ? "top" : "new";
const page = Math.max(1, Number(Astro.url.searchParams.get("page")) | 0 || 1);
const data = await sectionTopics(db, v, sec.id, sort, page);
const canPost = !sec.admin_only || isMod(v);
const subbed = await sectionSubscribed(db, v, sec.id);
---
<ForumShell title={sec.title} viewer={v} active="sections">
  <div class="f-crumbs"><a href="/forum">Форум</a> › <a href="/forum/sections">Разделы</a> › {sec.title}</div>
  <div style="display:flex;justify-content:space-between;align-items:flex-end;gap:1rem;flex-wrap:wrap;margin-bottom:1rem">
    <div>
      <h1 class="f-h1">{sec.icon} {sec.title}</h1>
      <p class="f-muted" style="margin:0">{sec.description} · {sec.topics_count} {plural(sec.topics_count, "тема", "темы", "тем")}, {sec.posts_count} {plural(sec.posts_count, "сообщение", "сообщения", "сообщений")}</p>
    </div>
    <div style="display:flex;gap:.5rem;flex-wrap:wrap;align-items:center">
      {v.uid && v.user && <button type="button" class={`f-btn f-sub${subbed ? " on" : ""}`} data-sub="s" data-id={sec.id} data-value={subbed ? "0" : "1"} title="Уведомлять о новых темах в разделе">{subbed ? "🔕 Не следить" : "🔔 Следить за разделом"}</button>}
      {canPost ? <a class="f-btn f-btn-primary" href={`/forum/new?section=${sec.id}`}>✎ Новая тема</a> : <span class="f-muted">🔒 Темы создают администраторы</span>}
    </div>
  </div>
  <nav class="f-tabs" style="max-width:420px">
    <a class={`f-tab${sort === "new" ? " on" : ""}`} href="?sort=new">Последние</a>
    <a class={`f-tab${sort === "top" ? " on" : ""}`} href="?sort=top">Популярные</a>
  </nav>
  {data.items.length ? (
    <div class="f-rows">
      {data.items.map((t: any) => (
        <div class="f-row">
          <div>
            <a class="f-row-title" href={`/forum/t/${t.id}`}>{t.pinned ? "📌 " : ""}{t.locked ? "🔒 " : ""}{t.kind === "article" ? <span class="f-kind">Статья</span> : null}{t.title}</a>
            <div class="f-row-meta"><Author a={t.author} /> <span>· {ago(t.created_at)}</span>{t.featured ? <span class="f-badge f-badge-feat">★</span> : null}{t.hidden ? <span class="f-badge f-badge-warn">скрыто</span> : null}</div>
          </div>
          <div class="f-row-cnt">💬 {t.comments_count}<br />♥ {t.likes_count}</div>
          <div class="f-row-last">{t.last_comment_user ? <>последний: <b>{t.last_nick}</b><br />{ago(t.last_activity)}</> : <>без ответов</>}</div>
        </div>
      ))}
    </div>
  ) : <div class="f-empty">В разделе пока нет тем.</div>}
  {(page > 1 || data.more) && (
    <div class="f-pager">
      {page > 1 && <a class="f-btn" href={`?sort=${sort}&page=${page - 1}`}>← Назад</a>}
      <span class="f-muted" style="align-self:center">стр. {page}</span>
      {data.more && <a class="f-btn" href={`?sort=${sort}&page=${page + 1}`}>Дальше →</a>}
    </div>
  )}
</ForumShell>
