---
import { ViewTransitions } from 'astro:transitions';
import { SignedIn, SignedOut, UserButton, SignInButton } from "@clerk/astro/components";
import RadioPlayer from '../components/RadioPlayer.astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="МоррисГрад — интерактивная вселенная тёмного фэнтези" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <ViewTransitions />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700;900&family=Exo+2:ital,wght@0,300;0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
  </head>
  <body>
    <!-- Фоновые мистические свечения -->
    <div class="ambient-glow ambient-glow-top" aria-hidden="true"></div>
    <div class="ambient-glow ambient-glow-bottom" aria-hidden="true"></div>

    <div class="top-radio-bar">
      <RadioPlayer />
    </div>

    <header class="header">
      <div class="header-controls">
        <button id="back-btn" class="nav-btn" aria-label="Назад" title="Вернуться назад">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
        </button>

        <a href="/" class="logo-area" title="На главную МоррисГрад">
          <div class="logo-crest">
            <svg viewBox="0 0 40 40" width="34" height="34" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M20 2L36 9V21C36 30 29 36.5 20 39C11 36.5 4 30 4 21V9L20 2Z" fill="url(#crest-grad)" stroke="#ffd700" stroke-width="1.5" stroke-opacity="0.8"/>
              <path d="M12 28V15L20 23L28 15V28" stroke="#ffd700" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="20" cy="11" r="2" fill="#ffd700" filter="drop-shadow(0 0 4px #ffd700)"/>
              <defs>
                <linearGradient id="crest-grad" x1="4" y1="2" x2="36" y2="39" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#2d124d"/>
                  <stop offset="0.6" stop-color="#140824"/>
                  <stop offset="1" stop-color="#07030d"/>
                </linearGradient>
              </defs>
            </svg>
          </div>
          <div class="brand-text">
            <span class="site-name">МоррисГрад</span>
            <span class="version-chip">v0.007</span>
          </div>
        </a>

        <!-- Быстрые навигационные кнопки: Книги и Галерея -->
        <nav class="header-nav-links">
          <a href="/books" class="header-nav-btn" title="Летописи и книги вселенной">
            <span class="nav-icon">📖</span> <span class="nav-btn-text">Книги</span>
          </a>
          <a href="/arts" class="header-nav-btn" title="Галерея персонажей">
            <span class="nav-icon">🖼</span> <span class="nav-btn-text">Галерея</span>
          </a>
        </nav>
      </div>

      <div class="auth-controls">
        <a href="/chat" class="header-chat-link" title="Открыть чат жителей">
          <span class="chat-icon">💬</span>
          <span class="chat-text">Чат</span>
          <span id="chat-notify-dot" class="notify-dot hidden" aria-label="Новые сообщения"></span>
        </a>

        <SignedOut>
          <SignInButton mode="modal" class="login-btn">
            <span class="btn-rune">✦</span> Войти
          </SignInButton>
        </SignedOut>

        <SignedIn>
          <a href="/profile" class="profile-link">
            <span class="profile-icon">⚜</span> Профиль
          </a>
          <div class="user-btn-wrapper">
            <UserButton />
          </div>
        </SignedIn>
      </div>
    </header>

    <div class="main-content-slot">
      <slot />
    </div>

    <footer class="footer">
      <div class="footer-ornament">
        <div class="ornament-line"></div>
        <div class="ornament-gem">✦ ⚜ ✦</div>
        <div class="ornament-line"></div>
      </div>

      <div class="socials">
        <a href="https://author.today/u/alex_seylor/works/" target="_blank" rel="noopener noreferrer" class="social-badge">
          <span class="social-icon">📖</span> Author.Today
        </a>
        <a href="https://t.me/LorinDeath" target="_blank" rel="noopener noreferrer" class="social-badge">
          <span class="social-icon">✈️</span> Telegram
        </a>
        <a href="https://www.youtube.com/@Lorin_Death" target="_blank" rel="noopener noreferrer" class="social-badge">
          <span class="social-icon">▶</span> YouTube
        </a>
        <a href="https://boosty.to/alexseylormusic" target="_blank" rel="noopener noreferrer" class="social-badge">
          <span class="social-icon">⚡</span> Boosty
        </a>
      </div>

      <p class="copy">&copy; 2026 Lorin Death • Alex Seylor production</p>
      <div class="footer-links">
        <a href="/changelog-site" class="site-version-link">
          <span class="link-bullet">❖</span> Хроники обновлений МоррисГрада
        </a>
      </div>
    </footer>

    <!-- Глобальный Лайтбокс -->
    <div id="lightbox" class="lightbox">
      <span class="close-btn" title="Закрыть">&times;</span>
      <button id="prev-btn" class="lightbox-nav prev-btn" title="Назад">&#10094;</button>
      <img class="lightbox-content" id="lightbox-img" alt="Просмотр" />
      <button id="next-btn" class="lightbox-nav next-btn" title="Вперед">&#10095;</button>
    </div>

    <script>
      // Инициализация кнопки "Назад", лайтбокса и проверки чата
      document.addEventListener('astro:page-load', () => {
        const backBtn = document.getElementById('back-btn');
        if (backBtn) {
          if (window.location.pathname === '/' || window.location.pathname === '/index.html') {
            backBtn.style.display = 'none';
          } else {
            backBtn.style.display = 'inline-flex';
          }
          backBtn.onclick = () => window.history.back();
        }

        // Лайтбокс
        const lightbox = document.getElementById('lightbox');
        const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
        const closeBtn = document.querySelector('.close-btn');
        const prevBtn = document.getElementById('prev-btn');
        const nextBtn = document.getElementById('next-btn');
        
        const galleryImages = Array.from(document.querySelectorAll('.gallery-item img'));
        let currentIndex = 0;

        const showImage = (index: number) => {
          if (index < 0) index = galleryImages.length - 1;
          if (index >= galleryImages.length) index = 0;
          currentIndex = index;
          if (lightboxImg && galleryImages[currentIndex]) {
            lightboxImg.src = (galleryImages[currentIndex] as HTMLImageElement).src;
          }
        };

        if (lightbox && lightboxImg && closeBtn && prevBtn && nextBtn) {
          galleryImages.forEach((img, index) => {
            if (img instanceof HTMLElement) {
              img.style.cursor = 'zoom-in';
            }
            img.addEventListener('click', (e) => {
              lightbox.classList.add('active');
              currentIndex = index;
              if (e.target instanceof HTMLImageElement) {
                lightboxImg.src = e.target.src;
              }
            });
          });

          closeBtn.addEventListener('click', () => lightbox.classList.remove('active'));
          lightbox.addEventListener('click', (e) => {
            if (e.target === lightbox) lightbox.classList.remove('active');
          });

          prevBtn.addEventListener('click', (e) => { e.stopPropagation(); showImage(currentIndex - 1); });
          nextBtn.addEventListener('click', (e) => { e.stopPropagation(); showImage(currentIndex + 1); });

          document.addEventListener('keydown', (e) => {
            if (lightbox.classList.contains('active')) {
              if (e.key === 'ArrowLeft') showImage(currentIndex - 1);
              if (e.key === 'ArrowRight') showImage(currentIndex + 1);
              if (e.key === 'Escape') lightbox.classList.remove('active');
            }
          });
        }

        // Проверка непрочитанных сообщений в чате
        const checkChat = async () => {
          if (window.location.pathname === '/chat') return;
          try {
            const res = await fetch('/api/chat');
            if (!res.ok) return;
            const data = await res.json();
            if (data.messages && data.messages.length > 0) {
              const latestMsg = data.messages[data.messages.length - 1];
              const lastRead = localStorage.getItem('chat_last_read') || '0';
              const dot = document.getElementById('chat-notify-dot');
              if (dot && latestMsg.created_at > Number(lastRead)) {
                dot.classList.remove('hidden');
              }
            }
          } catch (_) {}
        };
        checkChat();
      });
    </script>
  </body>
</html>

<style is:global>
  /* ==========================================================================
     ДИЗАЙН-ТОКЕНЫ МОРРИСГРАД: DARK FANTASY (PURPLE & GOLD)
     ========================================================================== */
  :root {
    --bg-dark: #06040a;
    --bg-dark-rgb: 6, 4, 10;
    --bg-purple: #130822;
    --bg-surface: #0e0817;
    --bg-surface-elevated: #170d26;
    --bg-surface-card: rgba(22, 13, 38, 0.72);
    
    --accent-gold: #f5d061;
    --accent-gold-bright: #ffd700;
    --accent-gold-dark: #b8912c;
    --gold-glow: rgba(245, 208, 97, 0.35);
    --gold-border: rgba(245, 208, 97, 0.3);
    --gold-border-soft: rgba(245, 208, 97, 0.15);

    --energy-purple: #a855f7;
    --energy-purple-bright: #c084fc;
    --purple-deep: #250943;
    --purple-glow: rgba(168, 85, 247, 0.4);
    --purple-border: rgba(168, 85, 247, 0.35);

    --btn-gray: #1a1424;
    --border-subtle: #291c3d;
    --border-card: rgba(168, 85, 247, 0.2);

    --text-light: #f5f2fb;
    --text-main: #e2daf0;
    --text-muted: #9f91b8;
    --text-dim: #73648a;

    --font-heading: 'Shket', 'Cinzel', serif;
    --font-body: 'Exo 2', -apple-system, BlinkMacSystemFont, sans-serif;
  }

  @font-face {
    font-family: 'Shket';
    src: url('/fonts/Shket-Regular.otf') format('opentype');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }

  /* Базовый сброс и типографика */
  *, *::before, *::after {
    box-sizing: border-box;
  }

  html {
    height: 100%;
    font-family: var(--font-body);
    background-color: var(--bg-dark);
    color: var(--text-main);
    color-scheme: dark;
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    padding: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
    position: relative;
    background-color: var(--bg-dark);
    background-image: 
      radial-gradient(ellipse 90% 60% at 50% -10%, rgba(120, 35, 200, 0.22), transparent 75%),
      radial-gradient(ellipse 70% 50% at 50% 100%, rgba(65, 15, 120, 0.25), transparent 80%),
      linear-gradient(rgba(6, 4, 10, 0.88), rgba(12, 6, 22, 0.92)),
      url('/images/main-bg.webp');
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    background-repeat: no-repeat;
  }

  /* Декоративные световые ореолы */
  .ambient-glow {
    position: fixed;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
    filter: blur(140px);
    opacity: 0.18;
  }
  .ambient-glow-top {
    top: -200px;
    left: 50%;
    transform: translateX(-50%);
    background: radial-gradient(circle, var(--energy-purple) 0%, transparent 70%);
  }
  .ambient-glow-bottom {
    bottom: -200px;
    right: 5%;
    background: radial-gradient(circle, var(--accent-gold-dark) 0%, transparent 70%);
    opacity: 0.12;
  }

  h1, h2, h3, .site-name, .welcome-text {
    font-family: var(--font-heading) !important;
    letter-spacing: 1px;
    color: var(--text-light);
  }

  .main-content-slot {
    flex: 1;
    position: relative;
    z-index: 1;
  }

  /* ==========================================================================
     ШАПКА (HEADER)
     ========================================================================== */
  .top-radio-bar {
    position: sticky;
    top: 0;
    z-index: 1000;
    width: 100%;
  }

  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.9rem 2.2rem;
    background: rgba(10, 6, 18, 0.82);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--gold-border-soft);
    box-shadow: 0 4px 25px rgba(0, 0, 0, 0.65), 0 1px 0 rgba(168, 85, 247, 0.15);
    position: relative;
    z-index: 900;
  }

  .header-controls {
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }

  .header-nav-links {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: 0.5rem;
  }

  .header-nav-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border-radius: 8px;
    background: rgba(28, 14, 46, 0.6);
    border: 1px solid var(--border-subtle);
    color: var(--text-main);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    transition: all 0.25s ease;
  }
  .header-nav-btn:hover {
    color: var(--accent-gold);
    border-color: var(--accent-gold);
    background: rgba(45, 25, 75, 0.7);
    box-shadow: 0 0 10px var(--gold-glow);
    transform: translateY(-2px);
  }
  .header-nav-btn .nav-icon {
    font-size: 0.95rem;
  }

  .nav-btn {
    background: rgba(26, 17, 43, 0.6);
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.25s ease;
  }
  .nav-btn:hover {
    border-color: var(--accent-gold);
    color: var(--accent-gold);
    transform: translateX(-3px);
    box-shadow: 0 0 12px var(--gold-glow);
    background: rgba(45, 25, 75, 0.7);
  }

  .logo-area {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    text-decoration: none;
    color: inherit;
    transition: transform 0.25s ease;
  }
  .logo-area:hover {
    transform: scale(1.02);
  }
  .logo-area:hover .logo-crest {
    box-shadow: 0 0 20px var(--gold-glow), 0 0 12px var(--purple-glow);
    border-color: var(--accent-gold);
  }

  .logo-crest {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: linear-gradient(135deg, #1c0d30 0%, #0d0617 100%);
    border: 1px solid var(--gold-border);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 15px rgba(0, 0, 0, 0.7);
    transition: all 0.3s ease;
  }

  .brand-text {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .site-name {
    font-size: 1.35rem;
    font-weight: 700;
    text-transform: uppercase;
    background: linear-gradient(135deg, #ffffff 40%, var(--accent-gold) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    text-shadow: 0 0 20px rgba(245, 208, 97, 0.25);
  }

  .version-chip {
    font-size: 0.68rem;
    font-family: monospace;
    color: var(--accent-gold);
    background: rgba(245, 208, 97, 0.1);
    border: 1px solid rgba(245, 208, 97, 0.3);
    padding: 2px 7px;
    border-radius: 999px;
    letter-spacing: 0.5px;
  }

  .auth-controls {
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }

  .header-chat-link {
    color: var(--text-main);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.88rem;
    padding: 6px 14px;
    border-radius: 8px;
    background: rgba(26, 17, 43, 0.6);
    border: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    gap: 7px;
    position: relative;
    transition: all 0.25s ease;
  }
  .header-chat-link:hover {
    color: var(--accent-gold);
    border-color: var(--energy-purple);
    background: rgba(45, 25, 75, 0.65);
    box-shadow: 0 0 14px var(--purple-glow);
  }

  .notify-dot {
    width: 8px;
    height: 8px;
    background: #4ade80;
    border-radius: 50%;
    display: inline-block;
    box-shadow: 0 0 8px #4ade80;
    animation: pulse-dot 1.8s infinite;
  }
  .notify-dot.hidden { display: none; }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.3); }
  }

  .login-btn {
    background: linear-gradient(135deg, rgba(147, 51, 234, 0.3) 0%, rgba(88, 28, 135, 0.5) 100%);
    border: 1px solid var(--energy-purple);
    color: var(--text-light);
    padding: 0.45rem 1.2rem;
    border-radius: 8px;
    font-family: var(--font-body);
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 1px;
    cursor: pointer;
    transition: all 0.25s ease;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    box-shadow: 0 0 15px rgba(168, 85, 247, 0.2);
  }
  .login-btn:hover {
    background: linear-gradient(135deg, var(--energy-purple) 0%, #7e22ce 100%);
    color: #fff;
    border-color: var(--accent-gold);
    box-shadow: 0 0 20px var(--purple-glow), 0 0 8px var(--gold-glow);
    transform: translateY(-2px);
  }
  .btn-rune {
    color: var(--accent-gold);
  }

  .profile-link {
    color: var(--text-main);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    padding: 6px 14px;
    border-radius: 8px;
    background: rgba(26, 17, 43, 0.6);
    border: 1px solid var(--border-subtle);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: all 0.25s;
  }
  .profile-link:hover {
    color: var(--accent-gold);
    border-color: var(--accent-gold);
    box-shadow: 0 0 12px var(--gold-glow);
  }
  .profile-icon {
    color: var(--accent-gold);
  }

  /* ==========================================================================
     КОНТЕЙНЕРЫ И ОБЩИЕ ЭЛЕМЕНТЫ
     ========================================================================== */
  .container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem;
  }

  .shimmer-line {
    height: 2px;
    background: linear-gradient(90deg, transparent 0%, rgba(168, 85, 247, 0.4) 20%, var(--accent-gold) 50%, rgba(168, 85, 247, 0.4) 80%, transparent 100%);
    margin: 2.5rem 0;
    box-shadow: 0 0 12px var(--gold-glow);
    width: 100%;
    position: relative;
  }

  .section-title {
    color: var(--accent-gold);
    font-size: 1.9rem;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .section-title::before {
    content: "❖";
    color: var(--energy-purple-bright);
    font-size: 1.3rem;
  }

  /* ==========================================================================
     ФУТЕР (FOOTER)
     ========================================================================== */
  .footer {
    text-align: center;
    padding: 3.5rem 1.5rem 3rem;
    background: #040307;
    border-top: 1px solid var(--gold-border-soft);
    position: relative;
    width: 100%;
    z-index: 10;
    box-shadow: 0 100vh 0 100vh #040307;
  }

  .footer-ornament {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    max-width: 450px;
    margin: 0 auto 2rem;
  }
  .ornament-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gold-border), transparent);
  }
  .ornament-gem {
    color: var(--accent-gold);
    font-size: 0.85rem;
    letter-spacing: 3px;
    text-shadow: 0 0 8px var(--gold-glow);
  }

  .socials {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1.2rem;
    margin-bottom: 1.8rem;
  }

  .social-badge {
    background: rgba(22, 13, 38, 0.8);
    border: 1px solid var(--border-subtle);
    color: var(--text-main);
    text-decoration: none;
    padding: 8px 16px;
    border-radius: 999px;
    font-size: 0.88rem;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.25s ease;
  }
  .social-badge:hover {
    color: var(--accent-gold);
    border-color: var(--accent-gold);
    background: rgba(45, 25, 75, 0.7);
    box-shadow: 0 0 16px var(--gold-glow);
    transform: translateY(-2px);
  }
  .social-icon {
    font-size: 0.95rem;
  }

  .copy {
    color: var(--text-dim);
    font-size: 0.88rem;
    margin: 0.5rem 0 0.8rem;
    letter-spacing: 0.5px;
  }

  .site-version-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text-muted);
    font-size: 0.82rem;
    text-decoration: none;
    transition: color 0.25s ease;
    border-bottom: 1px dotted rgba(245, 208, 97, 0.3);
    padding-bottom: 2px;
  }
  .site-version-link:hover {
    color: var(--accent-gold);
    border-color: var(--accent-gold);
  }
  .link-bullet {
    color: var(--energy-purple);
    font-size: 0.75rem;
  }

  /* ==========================================================================
     СТИЛИ ДЛЯ ЗАМЕТОК, КАРТОЧЕК И ЛАЙТБОКСА
