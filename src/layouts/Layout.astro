---
import { ClientRouter } from "astro:transitions";
import { Show, UserButton, SignInButton } from "@clerk/astro/components";
import RadioPlayer from '../components/RadioPlayer.astro';
import '../styles/tokens.css';
import SeoHead from '../components/seo/SeoHead.astro';
import type { SeoInput } from '../lib/seo';

interface Props extends Partial<Omit<SeoInput, 'title'>> {
  title: string;
  viewportFit?: boolean; // игра: viewport-fit=cover, чтобы safe-area-inset (вырез, полоска «домой») работали
}

const { title, viewportFit = false, ...seo } = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="google-site-verification" content="btZYW-SgLGLi6YgpZtgNR7AjM1iU3GqUYuTpHilFd8U" />
    <meta name="viewport" content={`width=device-width, initial-scale=1.0${viewportFit ? ', viewport-fit=cover' : ''}`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <SeoHead title={title} {...seo} />
    <ClientRouter />
    <script>
      // «Проклятые» (/MorrisCurse) — всегда полной загрузкой, не мягким переходом ClientRouter: документ, созданный на другой странице сайта,
      // вне scope сервис-воркера кэша (/MorrisCurse) — воркер не управляет им и navigator.serviceWorker.ready не наступает (MC-L04, 22.10).
      // Отмена подготовки → роутер Astro сам делает location.href = to (ссылки, формы, navigate(), назад/вперёд).
      document.addEventListener('astro:before-preparation', (ev) => {
        const to = (ev as Event & { to?: URL }).to;
        if (to && /^\/MorrisCurse(\/|$)/.test(to.pathname)) ev.preventDefault();
      });
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;700;900&family=Exo+2:ital,wght@0,300;0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
  </head>
  <body>
    <!-- Фоновые мистические свечения -->
    <div class="ambient-glow ambient-glow-top" aria-hidden="true"></div>
    <div class="ambient-glow ambient-glow-bottom" aria-hidden="true"></div>

    <div class="top-radio-bar">
      <RadioPlayer />
    </div>

    <header class="header">
      <div class="header-controls">
        <button id="back-btn" class="nav-btn" aria-label="Назад" title="Вернуться назад">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
        </button>

        <a href="/" class="logo-area" title="На главную МоррисГрад" aria-label="МоррисГрад — на главную">
          <div class="logo-crest">
            <svg viewBox="0 0 40 40" width="34" height="34" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M20 2L36 9V21C36 30 29 36.5 20 39C11 36.5 4 30 4 21V9L20 2Z" fill="url(#crest-grad)" stroke="#c9a86c" stroke-width="1.5" stroke-opacity="0.8"/>
              <path d="M12 28V15L20 23L28 15V28" stroke="#c9a86c" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
              <circle cx="20" cy="11" r="2" fill="#c9a86c" filter="drop-shadow(0 0 4px #c9a86c)"/>
              <defs>
                <linearGradient id="crest-grad" x1="4" y1="2" x2="36" y2="39" gradientUnits="userSpaceOnUse">
                  <stop stop-color="#1a0a12"/>
                  <stop offset="0.6" stop-color="#0c0608"/>
                  <stop offset="1" stop-color="#050304"/>
                </linearGradient>
              </defs>
            </svg>
          </div>
          <div class="brand-text">
            <span class="site-name">МоррисГрад</span>
            <span class="version-chip">v0.1</span>
          </div>
        </a>

        <nav class="header-nav-links" aria-label="Основные разделы">
          <a href="/books" class="header-nav-btn" title="Летописи и книги вселенной" aria-label="Книги">
            <span class="nav-icon">📖</span> <span class="nav-btn-text">Книги</span>
          </a>
          <a href="/arts" class="header-nav-btn" title="Галерея персонажей" aria-label="Галерея">
            <span class="nav-icon">🖼</span> <span class="nav-btn-text">Галерея</span>
          </a>
          <a href="/forum" class="header-nav-btn" title="Форум жителей МоррисГрада" aria-label="Форум">
            <span class="nav-icon">🗨</span> <span class="nav-btn-text">Форум</span>
          </a>
        </nav>
      </div>

      <div class="auth-controls">
        <a href="/chat" class="header-chat-link" title="Открыть чат жителей" aria-label="Чат" rel="nofollow">
          <span class="chat-icon">💬</span>
          <span class="chat-text">Чат</span>
          <span id="chat-notify-dot" class="notify-dot hidden" aria-label="Новые сообщения"></span>
        </a>

        <Show when="signed-out">
          <SignInButton mode="modal" class="login-btn">
            <span class="btn-rune">✦</span> Войти
          </SignInButton>
        </Show>

        <Show when="signed-in">
          <a href="/forum/notifications" class="site-bell" title="Уведомления форума" aria-label="Уведомления форума">
            <span aria-hidden="true">🔔</span><span class="site-bell-n" data-bell-n hidden></span>
          </a>
          <a href="/profile" class="profile-link">
            <span class="profile-icon">⚜</span> <span class="profile-text">Профиль</span>
          </a>
          <div class="user-btn-wrapper">
            <UserButton />
          </div>
        </Show>
      </div>
    </header>

    <div class="main-content-slot">
      <slot />
    </div>

    <footer class="footer">
      <div class="footer-ornament">
        <div class="ornament-line"></div>
        <div class="ornament-gem">✦ ⚜ ✦</div>
        <div class="ornament-line"></div>
      </div>

      <div class="socials">
        <a href="https://author.today/u/alex_seylor/works/" target="_blank" rel="noopener noreferrer" class="social-badge">
          <span class="social-icon">📖</span> Author.Today
        </a>
        <a href="https://t.me/LorinDeath" target="_blank" rel="noopener noreferrer" class="social-badge">
          <span class="social-icon">✈️</span> Telegram
        </a>
        <a href="https://www.youtube.com/@Lorin_Death" target="_blank" rel="noopener noreferrer" class="social-badge">
          <span class="social-icon">▶</span> YouTube
        </a>
        <a href="https://boosty.to/alexseylormusic" target="_blank" rel="noopener noreferrer" class="social-badge">
          <span class="social-icon">⚡</span> Boosty
        </a>
      </div>

      <nav class="footer-nav" aria-label="Разделы сайта">
        <a href="/MorrisCurse">Игра «Проклятые»</a>
        <a href="/forum">Форум</a>
        <a href="/books">Книги</a>
        <a href="/heroes">Герои</a>
        <a href="/games">Мини-игры</a>
        <a href="/music">Музыка</a>
        <a href="/cities">Города</a>
        <a href="/worlds">Миры</a>
      </nav>

      <p class="copy">&copy; 2026 Lorin Death • Alex Seylor production</p>
      <div class="footer-links">
        <a href="/changelog-site" class="site-version-link">
          <span class="link-bullet">❖</span> Хроники обновлений МоррисГрада
        </a>
      </div>
    </footer>

    <script>
      document.addEventListener('astro:page-load', () => {
        const backBtn = document.getElementById('back-btn');
        if (backBtn) {
          if (window.location.pathname === '/' || window.location.pathname === '/index.html') {
            backBtn.style.display = 'none';
          } else {
            backBtn.style.display = 'inline-flex';
          }
          backBtn.onclick = () => window.history.back();
        }

        const checkChat = async () => {
          if (window.location.pathname === '/chat') return;
          try {
            const res = await fetch('/api/chat');
            if (!res.ok) return;
            const data = await res.json();
            if (data.messages && data.messages.length > 0) {
              const latestMsg = data.messages[data.messages.length - 1];
              const lastRead = localStorage.getItem('chat_last_read') || '0';
              const dot = document.getElementById('chat-notify-dot');
              if (dot && latestMsg.created_at > Number(lastRead)) {
                dot.classList.remove('hidden');
              }
            }
          } catch (_) {}
        };
        checkChat();
      });

      // Колокольчик форума: один лёгкий запрос раз в минуту и только пока вкладка видна.
      type BellWin = Window & { __bellBound?: boolean; __bellAt?: number };
      const w = window as BellWin;
      if (!w.__bellBound) {
        w.__bellBound = true;
        const paint = (n: number | null) => {
          document.querySelectorAll<HTMLElement>('[data-bell-n]').forEach((el) => {
            el.textContent = n && n > 99 ? '99+' : String(n || '');
            el.hidden = !n;
          });
        };
        const poll = async (force = false) => {
          if (document.visibilityState !== 'visible') return;
          if (!document.querySelector('[data-bell-n]')) return;
          if (!force && w.__bellAt && Date.now() - w.__bellAt < 55000) return;
          w.__bellAt = Date.now();
          try {
            const r = await fetch('/api/forum/notifs/count', { credentials: 'same-origin', cache: 'no-store' });
            if (!r.ok) return;
            const d = await r.json();
            if (d && typeof d.n === 'number') paint(d.n);
          } catch (_) {}
        };
        (window as any).__bellPaint = paint;
        document.addEventListener('astro:page-load', () => poll(true));
        document.addEventListener('visibilitychange', () => poll());
        setInterval(() => poll(), 60000);
      }
    </script>
  </body>
</html>

<style is:global>
  @font-face {
    font-family: 'Shket';
    src: url('/fonts/Shket-Regular.otf') format('opentype');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }

  *, *::before, *::after {
    box-sizing: border-box;
  }

  html {
    height: 100%;
    font-family: var(--font-body);
    background-color: var(--bg-dark);
    color: var(--text-main);
    color-scheme: dark;
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    padding: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: hidden;
    position: relative;
    background-color: var(--bg-dark);
    background-image: 
      radial-gradient(ellipse 90% 60% at 50% -10%, rgba(225, 29, 72, 0.12), transparent 75%),
      radial-gradient(ellipse 70% 50% at 50% 100%, rgba(192, 132, 252, 0.08), transparent 80%),
      linear-gradient(rgba(12, 10, 13, 0.92), rgba(18, 12, 16, 0.94)),
      url('/images/main-bg.webp');
    background-size: cover;
    background-position: center;
    background-attachment: fixed;
    background-repeat: no-repeat;
  }

  .ambient-glow {
    position: fixed;
    width: 600px;
    height: 600px;
    border-radius: 50%;
    pointer-events: none;
    z-index: 0;
    filter: blur(140px);
    opacity: 0.15;
  }
  .ambient-glow-top {
    top: -200px;
    left: 50%;
    transform: translateX(-50%);
    background: radial-gradient(circle, var(--accent-crimson) 0%, transparent 70%);
  }
  .ambient-glow-bottom {
    bottom: -200px;
    right: 5%;
    background: radial-gradient(circle, var(--energy-purple) 0%, transparent 70%);
    opacity: 0.1;
  }

  h1, h2, h3, .site-name, .welcome-text {
    font-family: var(--font-heading) !important;
    letter-spacing: 1px;
    color: var(--text-light);
  }

  .main-content-slot {
    flex: 1;
    position: relative;
    z-index: 1;
  }

  .top-radio-bar {
    position: sticky;
    top: 0;
    z-index: 1000;
    width: 100%;
  }

  .header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.9rem 2.2rem;
    background: rgba(12, 10, 13, 0.85);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--gold-border-soft);
    box-shadow: 0 4px 25px rgba(0, 0, 0, 0.7), 0 1px 0 rgba(225, 29, 72, 0.1);
    position: relative;
    z-index: 900;
  }

  .header-controls {
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }

  .header-nav-links {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: 0.5rem;
  }

  .header-nav-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    border-radius: 8px;
    background: rgba(26, 16, 32, 0.6);
    border: 1px solid var(--border-subtle);
    color: var(--text-main);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    transition: all 0.25s ease;
  }
  .header-nav-btn:hover {
    color: var(--accent-gold);
    border-color: var(--accent-gold);
    background: rgba(45, 25, 40, 0.7);
    box-shadow: 0 0 10px var(--gold-glow);
    transform: translateY(-2px);
  }

  .nav-btn {
    background: rgba(26, 16, 32, 0.6);
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.25s ease;
  }
  .nav-btn:hover {
    border-color: var(--accent-gold);
    color: var(--accent-gold);
    transform: translateX(-3px);
    box-shadow: 0 0 12px var(--gold-glow);
  }

  .logo-area {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    text-decoration: none;
    color: inherit;
    transition: transform 0.25s ease;
  }
  .logo-area:hover {
    transform: scale(1.02);
  }

  .logo-crest {
    width: 42px;
    height: 42px;
    border-radius: 10px;
    background: linear-gradient(135deg, #1a0a12 0%, #0c0608 100%);
    border: 1px solid var(--gold-border);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 15px rgba(0, 0, 0, 0.7);
    transition: all 0.3s ease;
  }

  .brand-text {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }

  .site-name {
    font-size: 1.35rem;
    font-weight: 700;
    text-transform: uppercase;
    background: linear-gradient(135deg, #f3e8e0 40%, var(--accent-gold) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .version-chip {
    font-size: 0.68rem;
    font-family: monospace;
    color: var(--accent-gold);
    background: rgba(201, 168, 108, 0.1);
    border: 1px solid rgba(201, 168, 108, 0.3);
    padding: 2px 7px;
    border-radius: 999px;
  }

  .auth-controls {
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }

  .header-chat-link {
    color: var(--text-main);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.88rem;
    padding: 6px 14px;
    border-radius: 8px;
    background: rgba(26, 16, 32, 0.6);
    border: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    gap: 7px;
    position: relative;
    transition: all 0.25s ease;
  }
  .header-chat-link:hover {
    color: var(--accent-gold);
    border-color: var(--accent-crimson);
    box-shadow: 0 0 14px var(--crimson-glow);
  }

  .notify-dot {
    width: 8px;
    height: 8px;
    background: #4ade80;
    border-radius: 50%;
    display: inline-block;
    box-shadow: 0 0 8px #4ade80;
    animation: pulse-dot 1.8s infinite;
  }
  .notify-dot.hidden { display: none; }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.3); }
  }

  .login-btn {
    background: linear-gradient(135deg, rgba(225, 29, 72, 0.25) 0%, rgba(159, 18, 57, 0.4) 100%);
    border: 1px solid var(--accent-crimson);
    color: var(--text-light);
    padding: 0.45rem 1.2rem;
    border-radius: 8px;
    font-family: var(--font-body);
    font-weight: 600;
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 1px;
    cursor: pointer;
    transition: all 0.25s ease;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .login-btn:hover {
    background: linear-gradient(135deg, var(--accent-crimson) 0%, #9f1239 100%);
    color: #fff;
    border-color: var(--accent-gold);
    box-shadow: 0 0 20px var(--crimson-glow);
    transform: translateY(-2px);
  }

  .profile-link {
    color: var(--text-main);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    padding: 6px 14px;
    border-radius: 8px;
    background: rgba(26, 16, 32, 0.6);
    border: 1px solid var(--border-subtle);
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: all 0.25s;
  }
  .profile-link:hover {
    color: var(--accent-gold);
    border-color: var(--accent-gold);
    box-shadow: 0 0 12px var(--gold-glow);
  }

  .footer-nav { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.35rem 1.1rem; margin: 0 auto 1.2rem; max-width: 760px; font-size: 0.9rem; }
  .footer-nav a { color: var(--text-muted); text-decoration: none; transition: color 0.2s; display: inline-block; min-height: 24px; padding: 0.2rem 0.15rem; line-height: 1.4; }
  .footer-nav a:hover { color: var(--accent-gold); }
  /* Только для читалок и поисковиков (заголовок страницы без визуального дубля) */
  .sr-only, .f-sr { position: absolute !important; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .site-bell {
    position: relative; display: inline-flex; align-items: center; justify-content: center;
    width: 36px; height: 34px; border-radius: 8px; text-decoration: none; font-size: 1rem;
    border: 1px solid rgba(212, 175, 55, 0.25); transition: all 0.25s;
  }
  .site-bell:hover { border-color: var(--accent-gold); box-shadow: 0 0 12px var(--gold-glow); }
  .site-bell-n {
    position: absolute; top: -6px; right: -7px; min-width: 18px; height: 18px; padding: 0 5px;
    border-radius: 9px; background: #e11d48; color: #fff; font-size: 0.68rem; font-weight: 700;
    line-height: 18px; text-align: center; box-shadow: 0 0 0 2px #0b0710;
  }
  .site-bell-n[hidden] { display: none; }

  /* Узкие экраны: шапка не должна раздвигать страницу (кнопки — только иконки) */
  @media (max-width: 720px) {
    .header { padding: 0.6rem 0.7rem; gap: 0.5rem; }
    .header-controls, .auth-controls { gap: 0.45rem; }
    .header-nav-links { margin-left: 0; gap: 4px; }
    .header-nav-btn { padding: 5px 8px; }
    .header-nav-btn .nav-btn-text, .chat-text, .version-chip { display: none; }
    .logo-crest { width: 36px; height: 36px; }
    .site-name { font-size: 1rem; }
    .header-chat-link, .profile-link { padding: 6px 9px; }
    .profile-link .profile-text { display: none; }
    .site-bell { width: 32px; height: 32px; }
    .login-btn { padding: 0.4rem 0.7rem; }
  }
  @media (max-width: 420px) {
    .brand-text { display: none; }
  }

  .container {
    max-width: 1180px;
    margin: 0 auto;
    padding: 2.5rem 1.5rem;
  }

  .shimmer-line {
    height: 2px;
    background: linear-gradient(90deg, transparent 0%, rgba(225, 29, 72, 0.3) 20%, var(--accent-gold) 50%, rgba(192, 132, 252, 0.3) 80%, transparent 100%);
    margin: 2.5rem 0;
    box-shadow: 0 0 12px var(--crimson-glow);
    width: 100%;
  }

  .section-title {
    color: var(--accent-gold);
    font-size: 1.9rem;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .section-title::before {
    content: "❖";
    color: var(--accent-crimson);
    font-size: 1.3rem;
  }

  .footer {
    text-align: center;
    padding: 3.5rem 1.5rem 3rem;
    background: #08060a;
    border-top: 1px solid var(--gold-border-soft);
    position: relative;
    width: 100%;
    z-index: 10;
  }

  .footer-ornament {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    max-width: 450px;
    margin: 0 auto 2rem;
  }
  .ornament-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gold-border), transparent);
  }
  .ornament-gem {
    color: var(--accent-gold);
    font-size: 0.85rem;
    letter-spacing: 3px;
  }

  .socials {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1.2rem;
    margin-bottom: 1.8rem;
  }

  .social-badge {
    background: rgba(18, 16, 22, 0.8);
    border: 1px solid var(--border-subtle);
    color: var(--text-main);
    text-decoration: none;
    padding: 8px 16px;
    border-radius: 999px;
    font-size: 0.88rem;
    font-weight: 500;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: all 0.25s ease;
  }
  .social-badge:hover {
    color: var(--accent-gold);
    border-color: var(--accent-gold);
