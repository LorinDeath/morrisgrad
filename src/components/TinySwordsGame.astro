  .mode-icon {
    font-size: 1.8rem;
  }

  .mode-name {
    display: block;
    font-weight: 800;
    font-size: 0.95rem;
    color: #f8fafc;
  }

  .mode-desc {
    display: block;
    font-size: 0.72rem;
    color: #94a3b8;
  }

  .difficulty-box {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: 1.4rem;
  }

  .diff-label {
    font-size: 0.85rem;
    color: #94a3b8;
    font-weight: 800;
  }

  .diff-chip {
    background: rgba(30, 41, 59, 0.8);
    border: 1px solid #475569;
    color: #cbd5e1;
    padding: 6px 14px;
    border-radius: 16px;
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s;
  }

  .diff-chip:hover {
    border-color: #ffd700;
    color: #ffd700;
  }

  .diff-chip:active {
    transform: translateY(2px) scale(0.97);
  }

  .diff-chip.active {
    background: #d4af37;
    color: #07090e;
    border-color: #ffd700;
    box-shadow: 0 0 12px rgba(212, 175, 55, 0.4);
  }

  .btn-primary-action {
    background: linear-gradient(135deg, #d4af37 0%, #b8860b 100%);
    color: #000;
    border: 2px solid #ffe066;
    padding: 15px 48px;
    border-radius: 35px;
    cursor: pointer;
    font-weight: 900;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    box-shadow: 0 6px 25px rgba(212, 175, 55, 0.5), inset 0 2px 3px rgba(255, 255, 255, 0.4);
    transition: all 0.15s ease;
  }

  .btn-primary-action:hover {
    transform: translateY(-2px) scale(1.04);
    box-shadow: 0 8px 35px rgba(212, 175, 55, 0.8);
    background: linear-gradient(135deg, #ffd700 0%, #d4af37 100%);
  }

  .btn-primary-action:active {
    transform: translateY(4px) scale(0.97);
    box-shadow: 0 2px 10px rgba(212, 175, 55, 0.4);
  }

  .btn-main-text {
    font-size: 1.35rem;
    letter-spacing: 2px;
  }

  .btn-sub-text {
    font-size: 0.72rem;
    letter-spacing: 2px;
    opacity: 0.9;
  }

  .menu-hotkeys-help {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 6px;
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.1);
    padding: 8px 12px;
    border-radius: 8px;
    margin-top: 1.4rem;
    font-size: 0.75rem;
    color: #94a3b8;
  }

  .hotkey-col b {
    color: #ffd700;
  }

  .menu-quick-stats {
    display: flex;
    justify-content: center;
    gap: 2rem;
    margin-top: 1.2rem;
    font-size: 0.85rem;
    color: #94a3b8;
  }

  .menu-quick-stats b {
    color: #ffd700;
  }

  /* HUD HEADER */
  .hud-header {
    position: absolute;
    top: 10px;
    left: 15px;
    right: 15px;
    height: 70px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 100;
    pointer-events: none;
  }

  .hud-left, .hud-center, .hud-right {
    display: flex;
    align-items: center;
    gap: 10px;
    pointer-events: auto;
  }

  .hero-status-pill, .castle-status-pill {
    background: rgba(15, 23, 42, 0.92);
    border: 2px solid rgba(212, 175, 55, 0.5);
    border-radius: 12px;
    padding: 6px 12px;
    display: flex;
    align-items: center;
    gap: 10px;
    backdrop-filter: blur(6px);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.7);
  }

  .hero-avatar {
    width: 44px;
    height: 44px;
    border-radius: 8px;
    border: 2px solid #ffd700;
    background: #000;
    object-fit: cover;
    image-rendering: pixelated;
  }

  .hero-bars {
    display: flex;
    flex-direction: column;
    gap: 3px;
    width: 150px;
  }

  .hero-name-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.72rem;
    font-weight: 800;
    color: #ffd700;
  }

  .bar-track {
    position: relative;
    width: 100%;
    height: 10px;
    background: #090d16;
    border-radius: 5px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .bar-fill {
    height: 100%;
    transition: width 0.15s ease-out;
  }

  .hp-fill { background: linear-gradient(90deg, #ef4444, #f87171); }
  .xp-fill { background: linear-gradient(90deg, #06b6d4, #3b82f6); }
  .castle-fill { background: linear-gradient(90deg, #10b981, #34d399); }
  .boss-fill { background: linear-gradient(90deg, #8b5cf6, #ec4899); }

  .bar-text {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.62rem;
    font-weight: 900;
    color: #fff;
    text-shadow: 0 1px 2px #000;
  }

  .castle-icon {
    font-size: 1.8rem;
  }

  .castle-info {
    width: 140px;
  }

  .castle-label {
    font-size: 0.72rem;
    font-weight: 800;
    color: #34d399;
    margin-bottom: 2px;
  }

  /* Center Wave Display */
  .wave-box {
    background: rgba(15, 23, 42, 0.95);
    border: 2px solid #ffd700;
    border-radius: 12px;
    padding: 6px 18px;
    text-align: center;
    box-shadow: 0 0 25px rgba(212, 175, 55, 0.4);
  }

  .phase-badge {
    font-size: 0.75rem;
    font-weight: 900;
    letter-spacing: 1px;
    margin-bottom: 2px;
  }

  .phase-badge.day { color: #f59e0b; }
  .phase-badge.night { color: #ef4444; text-shadow: 0 0 8px #ef4444; }

  .time-countdown {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    font-size: 0.8rem;
    color: #94a3b8;
  }

  .timer-digits {
    font-size: 1.25rem;
    font-weight: 900;
    color: #fff;
    font-family: monospace;
  }

  .wave-count {
    font-size: 0.72rem;
    color: #ffd700;
    font-weight: 800;
  }

  .boss-hud-bar {
    width: 260px;
    background: rgba(15, 23, 42, 0.95);
    border: 2px solid #a855f7;
    border-radius: 8px;
    padding: 4px 8px;
    text-align: center;
    box-shadow: 0 0 20px rgba(168, 85, 247, 0.5);
  }

  .boss-title {
    font-size: 0.68rem;
    font-weight: 900;
    color: #d8b4fe;
    letter-spacing: 1px;
    margin-bottom: 2px;
  }

  /* Resources */
  .resources-row {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(15, 23, 42, 0.92);
    border: 2px solid rgba(212, 175, 55, 0.5);
    border-radius: 12px;
    padding: 6px 14px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.7);
  }

  .res-item {
    display: flex;
    align-items: center;
    gap: 5px;
    font-weight: 800;
    font-size: 0.9rem;
  }

  .res-item.wood { color: #86efac; }
  .res-item.gold { color: #fde047; }
  .res-item.food { color: #fca5a5; }
  .res-item.pop { color: #93c5fd; }

  .res-icon {
    width: 22px;
    height: 22px;
    object-fit: contain;
    image-rendering: pixelated;
  }

  .res-icon-text {
    font-size: 1.1rem;
  }

  .hud-mini-btn {
    background: rgba(15, 23, 42, 0.9);
    border: 1.5px solid #475569;
    color: #fff;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    cursor: pointer;
    font-size: 1.1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s;
  }

  .hud-mini-btn:hover {
    border-color: #ffd700;
    transform: translateY(-2px);
  }

  .hud-mini-btn:active {
    transform: translateY(2px) scale(0.95);
  }

  /* CANVAS PLAYFIELD */
  .canvas-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  #game-canvas {
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
  }

  /* Quest Tracker Card */
  .quest-tracker-pill {
    position: absolute;
    top: 90px;
    left: 15px;
    width: 250px;
    background: linear-gradient(135deg, rgba(22, 28, 44, 0.94) 0%, rgba(12, 16, 26, 0.96) 100%);
    border: 2px solid #d4af37;
    border-radius: 12px;
    padding: 8px 12px;
    box-shadow: 0 4px 18px rgba(0, 0, 0, 0.8);
    pointer-events: auto;
    z-index: 50;
  }

  .quest-header {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-bottom: 3px;
  }

  .quest-icon {
    font-size: 1rem;
  }

  .quest-badge {
    font-size: 0.65rem;
    font-weight: 900;
    color: #ffd700;
    letter-spacing: 1px;
  }

  .quest-title {
    font-size: 0.78rem;
    font-weight: 800;
    color: #f8fafc;
    margin-bottom: 2px;
  }

  .quest-desc {
    font-size: 0.68rem;
    color: #94a3b8;
    line-height: 1.3;
    margin-bottom: 6px;
  }

  .quest-progress-track {
    width: 100%;
    height: 5px;
    background: #000;
    border-radius: 3px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .quest-progress-fill {
    height: 100%;
    background: linear-gradient(90deg, #d4af37, #ffd700);
    transition: width 0.2s ease;
  }

  /* Minimap */
  .minimap-container {
    position: absolute;
    top: 90px;
    right: 15px;
    background: rgba(10, 15, 25, 0.9);
    border: 2px solid #d4af37;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.8);
    pointer-events: auto;
  }

  #minimap-canvas {
    display: block;
    background: #0f172a;
  }

  .minimap-title {
    font-size: 0.65rem;
    text-align: center;
    background: #000;
    color: #ffd700;
    font-weight: 800;
    padding: 2px 0;
    letter-spacing: 1px;
  }

  /* Army Command Bar */
  .army-command-bar {
    position: absolute;
    top: 200px;
    left: 15px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    z-index: 50;
    pointer-events: auto;
  }

  .cmd-group {
    display: flex;
    gap: 6px;
  }

  .cmd-btn {
    background: rgba(15, 23, 42, 0.9);
    border: 1.5px solid #475569;
    color: #e2e8f0;
    padding: 6px 12px;
    border-radius: 8px;
    font-size: 0.75rem;
    font-weight: 800;
    cursor: pointer;
    transition: all 0.15s;
  }

  .cmd-btn:hover {
    border-color: #ffd700;
    color: #ffd700;
  }

  .cmd-btn:active {
    transform: translateY(2px) scale(0.97);
  }

  .cmd-btn.active {
    background: rgba(212, 175, 55, 0.3);
    border-color: #ffd700;
    color: #ffd700;
    box-shadow: 0 0 12px rgba(212, 175, 55, 0.4);
  }

  .recruit-group {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    background: rgba(15, 23, 42, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 4px 6px;
    border-radius: 8px;
  }

  .recruit-btn {
    background: rgba(30, 41, 59, 0.85);
    border: 1px solid #475569;
    color: #e2e8f0;
    padding: 4px 8px;
    border-radius: 6px;
    font-size: 0.72rem;
    font-weight: 800;
    cursor: pointer;
    transition: all 0.15s;
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .recruit-btn:hover {
    border-color: #34d399;
    color: #34d399;
  }

  .recruit-btn:active {
    transform: translateY(2px) scale(0.96);
  }

  .rec-key {
    background: #000;
    color: #ffd700;
    font-size: 0.6rem;
    padding: 1px 4px;
    border-radius: 3px;
  }

  /* Hero Skills Bar */
  .hero-skills-bar {
    position: absolute;
    bottom: 85px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 8px;
    background: rgba(15, 23, 42, 0.95);
    border: 2px solid rgba(212, 175, 55, 0.55);
    padding: 6px 14px;
    border-radius: 12px;
    backdrop-filter: blur(8px);
    z-index: 50;
    pointer-events: auto;
  }

  .skill-slot {
    position: relative;
    width: 65px;
    height: 65px;
    background: #090d16;
    border: 2px solid #334155;
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    cursor: pointer;
    transition: all 0.15s;
  }

  .skill-slot:hover {
    border-color: #ffd700;
  }

  .skill-slot:active {
    transform: translateY(2px) scale(0.96);
  }

  .skill-key {
    font-size: 0.52rem;
    color: #94a3b8;
    font-weight: 800;
  }

  .skill-icon {
    font-size: 1.35rem;
    margin: 2px 0;
  }

  .skill-name {
    font-size: 0.5rem;
    color: #cbd5e1;
    text-align: center;
    font-weight: 700;
  }

  .skill-cd-mask {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
    height: 0%;
    bottom: 0;
    top: auto;
    pointer-events: none;
    transition: height 0.1s linear;
  }

  /* Construction Bar */
  .building-bar {
    position: absolute;
    bottom: 10px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(15, 23, 42, 0.95);
    border: 2px solid #d4af37;
    border-radius: 12px;
    padding: 8px 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.8);
    z-index: 50;
    pointer-events: auto;
  }

  .build-bar-header {
    font-size: 0.68rem;
    font-weight: 800;
    color: #d4af37;
    letter-spacing: 1px;
  }

  .build-slots {
    display: flex;
    gap: 8px;
  }

  .build-card {
    background: rgba(30, 41, 59, 0.8);
    border: 1.5px solid #475569;
    border-radius: 8px;
    padding: 4px 8px;
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    transition: all 0.15s;
  }

  .build-card:hover {
    border-color: #ffd700;
    background: rgba(212, 175, 55, 0.2);
    transform: translateY(-2px);
  }

  .build-card:active {
    transform: translateY(2px) scale(0.97);
  }

  .build-card.selected {
    border-color: #ffd700;
    background: rgba(212, 175, 55, 0.35);
    box-shadow: 0 0 12px rgba(212, 175, 55, 0.6);
  }

  .build-card img {
    width: 32px;
    height: 32px;
    object-fit: contain;
    image-rendering: pixelated;
  }

  .build-card-info {
    display: flex;
    flex-direction: column;
    text-align: left;
  }

  .build-name {
    font-size: 0.72rem;
    font-weight: 800;
    color: #f8fafc;
  }

  .build-cost {
    font-size: 0.65rem;
    color: #ffd700;
    font-weight: 700;
  }

  /* Interaction Tooltip */
  .interaction-tip {
    position: absolute;
    bottom: 95px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0, 0, 0, 0.85);
    border: 1.5px solid #ffd700;
    color: #ffd700;
    padding: 6px 16px;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 800;
    display: none;
    pointer-events: none;
    z-index: 60;
  }

  /* Mobile Touch Controls */
  .mobile-controls {
    display: none;
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 40;
  }

  .joystick-base {
    position: absolute;
    bottom: 25px;
    left: 25px;
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    border: 2px solid rgba(255, 255, 255, 0.3);
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .joystick-thumb {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #ffd700;
    box-shadow: 0 0 10px #ffd700;
  }

  .mobile-actions {
    position: absolute;
    bottom: 25px;
    right: 25px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    pointer-events: auto;
  }

  .touch-action-btn {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    background: rgba(15, 23, 42, 0.85);
    border: 2px solid #ffd700;
    color: #fff;
    font-weight: 800;
    font-size: 0.75rem;
    cursor: pointer;
  }

  @media (max-width: 900px) {
    .mobile-controls { display: block; }
    .hero-skills-bar { bottom: 100px; }
    .building-bar { bottom: 5px; }
    .army-command-bar { top: 180px; left: 10px; }
    .quest-tracker-pill { top: 75px; left: 10px; width: 220px; }
  }

  /* MODALS */
  .game-modal-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    display: none;
    justify-content: center;
    align-items: center;
    z-index: 1000;
    backdrop-filter: blur(8px);
  }

  .game-modal-overlay.active {
    display: flex;
  }

  .modal-box {
    background: linear-gradient(135deg, #161b26 0%, #0b0e14 100%);
    border: 3px solid #d4af37;
    border-radius: 16px;
    padding: 2.2rem;
    max-width: 600px;
    width: 90%;
    text-align: center;
    box-shadow: 0 0 50px rgba(212, 175, 55, 0.3), inset 0 0 20px rgba(0, 0, 0, 0.85);
    position: relative;
  }

  .modal-ribbon {
    position: absolute;
    top: -16px;
    left: 50%;
    transform: translateX(-50%);
    background: #d4af37;
    color: #000;
    font-weight: 900;
    font-size: 0.8rem;
    padding: 4px 20px;
    border-radius: 20px;
    letter-spacing: 2px;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.5);
  }

  .modal-heading {
    color: #ffd700;
    font-size: 1.6rem;
    margin: 0.5rem 0;
    letter-spacing: 1px;
  }

  .modal-heading.text-defeat {
    color: #ef4444;
  }

  .modal-sub {
    color: #94a3b8;
    font-size: 0.88rem;
    margin-bottom: 1.5rem;
  }

  .upgrade-cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .upgrade-card {
    background: rgba(30, 41, 59, 0.8);
    border: 2px solid #475569;
    border-radius: 12px;
    padding: 1rem 0.8rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    transition: all 0.2s;
    text-align: center;
  }

  .upgrade-card:hover {
    border-color: #ffd700;
    background: rgba(212, 175, 55, 0.2);
    transform: translateY(-4px);
    box-shadow: 0 8px 20px rgba(212, 175, 55, 0.3);
  }

  .upgrade-card:active {
    transform: translateY(2px) scale(0.97);
  }

  .upgrade-icon {
    font-size: 2rem;
  }

  .upgrade-title {
    font-size: 0.85rem;
    font-weight: 800;
    color: #f8fafc;
  }

  .upgrade-desc {
    font-size: 0.72rem;
    color: #94a3b8;
    line-height: 1.3;
  }

  .gameover-stats-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px 16px;
    background: rgba(0, 0, 0, 0.5);
    padding: 1rem 1.4rem;
    border-radius: 10px;
    margin-bottom: 1.5rem;
    text-align: left;
  }

  .go-stat {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    color: #cbd5e1;
  }

  .go-stat.highlight {
    grid-column: span 2;
    border-top: 1px solid rgba(212, 175, 55, 0.4);
    padding-top: 6px;
    margin-top: 4px;
    color: #ffd700;
    font-size: 1rem;
    font-weight: 800;
  }

  .modal-actions-column {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .btn-action {
    padding: 12px 24px;
    border-radius: 30px;
    font-size: 0.95rem;
    font-weight: 800;
    cursor: pointer;
    border: none;
    transition: all 0.15s;
  }

  .btn-action.primary {
    background: #d4af37;
    color: #000;
  }

  .btn-action.primary:hover {
    background: #ffd700;
    box-shadow: 0 0 20px #ffd700;
    transform: translateY(-2px);
  }

  .btn-action.primary:active {
    transform: translateY(2px) scale(0.97);
  }

  .btn-action.warning {
    background: #f59e0b;
    color: #000;
  }

  .btn-action.warning:hover {
    background: #fbbf24;
    transform: translateY(-2px);
  }

  .btn-action.warning:active {
    transform: translateY(2px) scale(0.97);
  }

  .btn-action.secondary {
    background: rgba(255, 255, 255, 0.1);
    color: #e2e8f0;
    border: 1px solid #475569;
  }

  .btn-action.secondary:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: #ffd700;
    transform: translateY(-2px);
  }

  .btn-action.secondary:active {
    transform: translateY(2px) scale(0.97);
  }
</style>

<script>
  import { TinySwordsEngine } from './tinyswords/engine';

  let engineInstance: TinySwordsEngine | null = null;

  function initTinySwords() {
    const root = document.getElementById('ascetic-game-container');
    const canvas = document.getElementById('game-canvas') as HTMLCanvasElement;
    const minimapCanvas = document.getElementById('minimap-canvas') as HTMLCanvasElement;
    if (!root || !canvas || !minimapCanvas) return;

    if (engineInstance) {
      engineInstance.destroy();
      engineInstance = null;
    }

    engineInstance = new TinySwordsEngine(canvas, minimapCanvas, root);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTinySwords);
  } else {
    initTinySwords();
  }

  document.addEventListener('astro:page-load', initTinySwords);
</script>
