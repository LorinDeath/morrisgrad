---
// TinySwordsGame.astro - "Путь Аскетов: Осада МоррисГрад"
// Полная RTS / Action-RPG стратегия с защитой цитадели на базе ассетов Tiny Swords
---

<div id="ascetic-game-container" class="ascetic-game-root">
  <!-- START / MENU SCREEN -->
  <div id="screen-menu" class="game-screen active">
    <div class="menu-overlay">
      <div class="menu-card">
        <div class="menu-badge">ОРДЕН АСКЕТОВ • МОРРИСГРАД</div>
        <h1 class="game-title">ПУТЬ АСКЕТОВ</h1>
        <div class="game-subtitle">ОСАДА ЦИТАДЕЛИ: ДРЕВНИЙ ОСТРОВ</div>
        
        <div class="menu-intro">
          В суровых землях МоррисГрада орден Аскетов охраняет древний Источник Света.
          Черный Легион идет войной. Возводите крепость, добывайте дерево и золото, 
          нанимайте верных послушников, лучников и монахов, и встаньте плечом к плечу 
          с верными воинами на защиту цитадели!
        </div>

        <div class="mode-select-box">
          <div class="mode-btn active" data-mode="campaign">
            <span class="mode-icon">🛡️</span>
            <div class="mode-text">
              <span class="mode-name">Священная Кампания</span>
              <span class="mode-desc">10 волн испытаний с финальным Владыкой Тьмы</span>
            </div>
          </div>
          <div class="mode-btn" data-mode="endless">
            <span class="mode-icon">⚔️</span>
            <div class="mode-text">
              <span class="mode-name">Бесконечная Осада</span>
              <span class="mode-desc">Выживайте против нарастающих полчищ Черного Легиона</span>
            </div>
          </div>
        </div>

        <div class="difficulty-box">
          <span class="diff-label">Сложность:</span>
          <button class="diff-chip" data-diff="easy">Послушник (Легко)</button>
          <button class="diff-chip active" data-diff="normal">Рыцарь (Норма)</button>
          <button class="diff-chip" data-diff="hard">Аскет (Хардкор)</button>
        </div>

        <div class="menu-actions">
          <button id="btn-start-game" class="btn-primary-action">
            <span class="btn-main-text">ВСТУПИТЬ В БОЙ</span>
            <span class="btn-sub-text">ПРИНЯТЬ ОБЕТ АСКЕТА</span>
          </button>
        </div>

        <div class="menu-quick-stats">
          <span>🏆 Рекорд волн: <b id="stat-high-wave">0</b></span>
          <span>💀 Уничтожено врагов: <b id="stat-high-kills">0</b></span>
        </div>
      </div>
    </div>
  </div>

  <!-- MAIN GAME CANVAS & WORLD -->
  <div id="screen-game" class="game-screen">
    <!-- Top HUD Bar -->
    <header class="hud-header">
      <div class="hud-left">
        <!-- Hero Status -->
        <div class="hero-status-pill">
          <img src="/Tiny Swords/UI Elements/UI Elements/Human Avatars/Avatars_01.png" alt="Hero Avatar" class="hero-avatar" />
          <div class="hero-bars">
            <div class="hero-name-row">
              <span class="hero-title">Архистратиг Аскетов</span>
              <span class="hero-lvl">Ур. <b id="hud-hero-lvl">1</b></span>
            </div>
            <div class="bar-track hp-track">
              <div id="hud-hero-hp" class="bar-fill hp-fill" style="width: 100%;"></div>
              <span id="hud-hero-hp-text" class="bar-text">100 / 100</span>
            </div>
            <div class="bar-track xp-track">
              <div id="hud-hero-xp" class="bar-fill xp-fill" style="width: 0%;"></div>
              <span id="hud-hero-xp-text" class="bar-text">0 / 100 XP</span>
            </div>
          </div>
        </div>

        <!-- Castle Health -->
        <div class="castle-status-pill">
          <span class="castle-icon">🏰</span>
          <div class="castle-info">
            <div class="castle-label">Цитадель Аскетов</div>
            <div class="bar-track castle-track">
              <div id="hud-castle-hp" class="bar-fill castle-fill" style="width: 100%;"></div>
              <span id="hud-castle-hp-text" class="bar-text">2000 / 2000</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Time & Wave Center Indicator -->
      <div class="hud-center">
        <div class="wave-box">
          <div id="hud-phase-indicator" class="phase-badge day">☀️ ДЕНЬ (СБОР)</div>
          <div class="time-countdown">
            <span id="hud-timer-label">До атаки:</span>
            <span id="hud-countdown" class="timer-digits">00:45</span>
          </div>
          <div class="wave-count">Волна <span id="hud-current-wave">1</span> / <span id="hud-max-wave">10</span></div>
        </div>
        
        <!-- Boss Bar (Hidden until boss arrives) -->
        <div id="hud-boss-wrap" class="boss-hud-bar" style="display: none;">
          <div class="boss-title">ВЛАДЫКА ПУСТОТЫ: ВЕЛИКИЙ ЕРЕТИК</div>
          <div class="bar-track boss-track">
            <div id="hud-boss-hp" class="bar-fill boss-fill" style="width: 100%;"></div>
          </div>
        </div>
      </div>

      <!-- Resources & Controls Right -->
      <div class="hud-right">
        <div class="resources-row">
          <div class="res-item wood" title="Древесина">
            <img src="/Tiny Swords/Terrain/Resources/Wood/Wood Resource/Wood Resource.png" alt="Wood" class="res-icon" />
            <span id="res-wood-val">120</span>
          </div>
          <div class="res-item gold" title="Золото">
            <img src="/Tiny Swords/Terrain/Resources/Gold/Gold Stones/Gold Stone 1.png" alt="Gold" class="res-icon" />
            <span id="res-gold-val">150</span>
          </div>
          <div class="res-item food" title="Провизия">
            <img src="/Tiny Swords/Terrain/Resources/Meat/Meat Resource/Meat Resource.png" alt="Food" class="res-icon" />
            <span id="res-food-val">40</span>
          </div>
          <div class="res-item pop" title="Население">
            <span class="res-icon-text">👥</span>
            <span id="res-pop-val">3/10</span>
          </div>
        </div>

        <div class="hud-controls-btns">
          <button id="btn-toggle-sound" class="hud-mini-btn" title="Звук">🔊</button>
          <button id="btn-pause" class="hud-mini-btn" title="Пауза">⏸️</button>
        </div>
      </div>
    </header>

    <!-- Canvas Playfield -->
    <div id="canvas-wrapper" class="canvas-wrapper">
      <canvas id="game-canvas"></canvas>

      <!-- Mini-map Radar -->
      <div class="minimap-container">
        <canvas id="minimap-canvas" width="160" height="120"></canvas>
        <div class="minimap-title">КАРТА ЗЕМЕЛЬ</div>
      </div>

      <!-- Quick Command Buttons -->
      <div class="army-command-bar">
        <button id="cmd-follow" class="cmd-btn active" title="Приказ: Все солдаты следуют за Архистратигом">
          🛡️ ЗА МНОЙ! (F)
        </button>
        <button id="cmd-defend" class="cmd-btn" title="Приказ: Оборонять Цитадель">
          🏰 ОБОРОНА (G)
        </button>
        <button id="cmd-attack" class="cmd-btn" title="Приказ: Свободная охота на врагов">
          ⚔️ В АТАКУ! (T)
        </button>
        <button id="cmd-hire-pawn" class="cmd-btn recruit-pawn" title="Нанять послушника (30 Золота, 10 Еды)">
          ➕ ПОСЛУШНИК (1)
        </button>
      </div>

      <!-- Action Hero Skills Toolbar -->
      <div class="hero-skills-bar">
        <div id="skill-attack" class="skill-slot">
          <div class="skill-key">ЛКМ / ПРОБЕЛ</div>
          <div class="skill-icon">🗡️</div>
          <div class="skill-name">УДАР МЕЧОМ</div>
        </div>
        <div id="skill-guard" class="skill-slot">
          <div class="skill-key">ПКМ / SHIFT</div>
          <div class="skill-icon">🛡️</div>
          <div class="skill-name">БЛОК ЩИТОМ</div>
        </div>
        <div id="skill-whirl" class="skill-slot">
          <div class="skill-key">Q</div>
          <div class="skill-icon">🌪️</div>
          <div class="skill-name">ВИХРЬ АСКЕТА</div>
          <div id="cd-whirl" class="skill-cd-mask"></div>
        </div>
        <div id="skill-dash" class="skill-slot">
          <div class="skill-key">SPACE / E</div>
          <div class="skill-icon">⚡</div>
          <div class="skill-name">РЫВОК ВЕРЫ</div>
          <div id="cd-dash" class="skill-cd-mask"></div>
        </div>
        <div id="skill-rally" class="skill-slot">
          <div class="skill-key">R</div>
          <div class="skill-icon">🎺</div>
          <div class="skill-name">КЛИЧ ПОБЕДЫ</div>
          <div id="cd-rally" class="skill-cd-mask"></div>
        </div>
      </div>

      <!-- Construction / Recruitment Building Panel -->
      <div class="building-bar">
        <div class="build-bar-header">СТРОИТЕЛЬСТВО И НАЙМ (КЛИК ДЛЯ РАЗМЕЩЕНИЯ):</div>
        <div class="build-slots">
          <button class="build-card" data-build="barracks">
            <img src="/Tiny Swords/Buildings/Blue Buildings/Barracks.png" alt="Barracks" />
            <div class="build-card-info">
              <span class="build-name">Казармы</span>
              <span class="build-cost">🪵 80 🪙 50</span>
            </div>
          </button>

          <button class="build-card" data-build="archery">
            <img src="/Tiny Swords/Buildings/Blue Buildings/Archery.png" alt="Archery" />
            <div class="build-card-info">
              <span class="build-name">Стрельбище</span>
              <span class="build-cost">🪵 70 🪙 60</span>
            </div>
          </button>

          <button class="build-card" data-build="monastery">
            <img src="/Tiny Swords/Buildings/Blue Buildings/Monastery.png" alt="Monastery" />
            <div class="build-card-info">
              <span class="build-name">Монастырь</span>
              <span class="build-cost">🪵 100 🪙 90</span>
            </div>
          </button>

          <button class="build-card" data-build="tower">
            <img src="/Tiny Swords/Buildings/Blue Buildings/Tower.png" alt="Tower" />
            <div class="build-card-info">
              <span class="build-name">Башня Лучников</span>
              <span class="build-cost">🪵 60 🪙 40</span>
            </div>
          </button>

          <button class="build-card" data-build="house">
            <img src="/Tiny Swords/Buildings/Blue Buildings/House1.png" alt="House" />
            <div class="build-card-info">
              <span class="build-name">Хижина (+5 Поп.)</span>
              <span class="build-cost">🪵 40 🪙 20</span>
            </div>
          </button>
        </div>
      </div>

      <!-- Mobile Touch Controls -->
      <div id="mobile-touch-controls" class="mobile-controls">
        <div id="virtual-joystick" class="joystick-base">
          <div id="joystick-knob" class="joystick-thumb"></div>
        </div>
        <div class="mobile-actions">
          <button id="touch-btn-attack" class="touch-action-btn btn-atk">⚔️ Удар</button>
          <button id="touch-btn-guard" class="touch-action-btn btn-def">🛡️ Блок</button>
          <button id="touch-btn-dash" class="touch-action-btn btn-dash">⚡ Рывок</button>
          <button id="touch-btn-whirl" class="touch-action-btn btn-whirl">🌪️ Вихрь</button>
        </div>
      </div>

      <!-- Interactive Tooltip Overlay -->
      <div id="hud-interaction-tip" class="interaction-tip">
        Кликните, чтобы разместить здание (ESC — отмена)
      </div>
    </div>
  </div>

  <!-- UPGRADE / PERK MODAL (Between waves) -->
  <div id="modal-upgrade" class="game-modal-overlay">
    <div class="modal-box upgrade-box">
      <div class="modal-ribbon">СВЯЩЕННЫЙ КОДЕКС АСКЕТОВ</div>
      <h2 class="modal-heading">ВОЛНА ВЫДЕРЖАНА! ВЫБЕРИТЕ БЛАГОСЛОВЕНИЕ</h2>
      <p class="modal-sub">Укрепите свою армию и королевство силой молитв и ратного мастерства</p>
      
      <div id="upgrade-cards-list" class="upgrade-cards-grid">
        <!-- Populated via script -->
      </div>
    </div>
  </div>

  <!-- PAUSE MODAL -->
  <div id="modal-pause" class="game-modal-overlay">
    <div class="modal-box">
      <h2 class="modal-heading">СВЯЩЕННАЯ ПАУЗА</h2>
      <p class="modal-sub">Битва приостановлена. Время составить тактический план.</p>
      
      <div class="modal-actions-column">
        <button id="btn-resume" class="btn-action primary">ПРОДОЛЖИТЬ СРАЖЕНИЕ</button>
        <button id="btn-restart" class="btn-action warning">НАЧАТЬ ЗАНОВО</button>
        <button id="btn-to-menu" class="btn-action secondary">ВЫЙТИ В МЕНЮ</button>
      </div>
    </div>
  </div>

  <!-- GAME OVER / VICTORY MODAL -->
  <div id="modal-gameover" class="game-modal-overlay">
    <div class="modal-box gameover-box">
      <div id="gameover-ribbon" class="modal-ribbon">ПАДЕНИЕ ЦИТАДЕЛИ</div>
      <h2 id="gameover-title" class="modal-heading text-defeat">ТЬМА ПОГЛОТИЛА МОРРИСГРАД</h2>
      <p id="gameover-desc" class="modal-sub">Цитадель Аскетов пала под натиском Черного Легиона...</p>

      <div class="gameover-stats-grid">
        <div class="go-stat">
          <span class="go-label">Выдержано волн:</span>
          <b id="go-wave-val">0</b>
        </div>
        <div class="go-stat">
          <span class="go-label">Уничтожено врагов:</span>
          <b id="go-kills-val">0</b>
        </div>
        <div class="go-stat">
          <span class="go-label">Собрано древесины:</span>
          <b id="go-wood-val">0</b>
        </div>
        <div class="go-stat">
          <span class="go-label">Добыто золота:</span>
          <b id="go-gold-val">0</b>
        </div>
        <div class="go-stat">
          <span class="go-label">Обучено воинов:</span>
          <b id="go-recruits-val">0</b>
        </div>
        <div class="go-stat highlight">
          <span class="go-label">ИТОГОВЫЙ СЧЕТ:</span>
          <b id="go-score-val">0</b>
        </div>
      </div>

      <div class="modal-actions-column">
        <button id="btn-try-again" class="btn-action primary">ПОПРОБОВАТЬ СНОВА</button>
        <button id="btn-go-menu" class="btn-action secondary">В ГЛАВНОЕ МЕНЮ</button>
      </div>
    </div>
  </div>
</div>

<style>
  *, *::before, *::after {
    box-sizing: border-box;
  }

  .ascetic-game-root {
    position: relative;
    width: 100vw;
    height: 100vh;
    background: #0a0b10;
    color: #f1f5f9;
    font-family: 'Cinzel', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, serif;
    overflow: hidden;
    user-select: none;
    -webkit-user-select: none;
  }

  .game-screen {
    position: absolute;
    inset: 0;
    display: none;
    flex-direction: column;
    overflow: hidden;
  }

  .game-screen.active {
    display: flex;
  }

  /* MENU SCREEN */
  #screen-menu {
    background: radial-gradient(circle at center, #1b2030 0%, #07090e 100%);
    justify-content: center;
    align-items: center;
    padding: 1.5rem;
  }

  .menu-overlay {
    width: 100%;
    max-width: 680px;
    background: rgba(15, 20, 32, 0.95);
    border: 3px solid #d4af37;
    border-radius: 16px;
    padding: 2.2rem 2rem;
    box-shadow: 0 0 50px rgba(212, 175, 55, 0.25), inset 0 0 30px rgba(0, 0, 0, 0.8);
    text-align: center;
    position: relative;
    backdrop-filter: blur(8px);
  }

  .menu-badge {
    display: inline-block;
    background: rgba(212, 175, 55, 0.15);
    color: #ffd700;
    border: 1px solid #d4af37;
    padding: 4px 16px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 2px;
    margin-bottom: 0.8rem;
  }

  .game-title {
    font-size: 2.6rem;
    font-weight: 900;
    color: #ffd700;
    margin: 0;
    letter-spacing: 4px;
    text-shadow: 0 0 20px rgba(255, 215, 0, 0.5), 0 2px 4px #000;
  }

  .game-subtitle {
    font-size: 0.95rem;
    color: #94a3b8;
    letter-spacing: 3px;
    margin-top: 0.3rem;
    margin-bottom: 1.2rem;
    font-weight: 700;
  }

  .menu-intro {
    font-size: 0.9rem;
    line-height: 1.6;
    color: #cbd5e1;
    margin-bottom: 1.6rem;
    background: rgba(0, 0, 0, 0.4);
    padding: 0.8rem 1.2rem;
    border-radius: 8px;
    border-left: 3px solid #d4af37;
    text-align: left;
  }

  .mode-select-box {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-bottom: 1.2rem;
  }

  .mode-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(30, 41, 59, 0.6);
    border: 2px solid #475569;
    border-radius: 10px;
    padding: 0.75rem 1rem;
    cursor: pointer;
    text-align: left;
    transition: all 0.2s;
  }

  .mode-btn:hover {
    border-color: #ffd700;
    background: rgba(212, 175, 55, 0.1);
  }

  .mode-btn.active {
    border-color: #ffd700;
    background: rgba(212, 175, 55, 0.2);
    box-shadow: 0 0 15px rgba(212, 175, 55, 0.3);
  }

  .mode-icon {
    font-size: 1.6rem;
  }

  .mode-name {
    display: block;
    font-weight: 800;
    font-size: 0.95rem;
    color: #f8fafc;
  }

  .mode-desc {
    display: block;
    font-size: 0.72rem;
    color: #94a3b8;
  }

  .difficulty-box {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: 1.5rem;
  }

  .diff-label {
    font-size: 0.85rem;
    color: #94a3b8;
    font-weight: 700;
  }

  .diff-chip {
    background: rgba(30, 41, 59, 0.8);
    border: 1px solid #475569;
    color: #cbd5e1;
    padding: 6px 14px;
    border-radius: 16px;
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
  }

  .diff-chip:hover {
    border-color: #ffd700;
    color: #ffd700;
  }

  .diff-chip.active {
    background: #d4af37;
    color: #07090e;
    border-color: #ffd700;
    box-shadow: 0 0 12px rgba(212, 175, 55, 0.4);
  }

  .btn-primary-action {
    background: linear-gradient(135deg, #d4af37 0%, #b8860b 100%);
    color: #000;
    border: none;
    padding: 14px 40px;
    border-radius: 30px;
    cursor: pointer;
    font-weight: 900;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    box-shadow: 0 0 30px rgba(212, 175, 55, 0.5);
    transition: all 0.25s ease;
  }

  .btn-primary-action:hover {
    transform: scale(1.05);
    box-shadow: 0 0 45px rgba(212, 175, 55, 0.8);
    background: linear-gradient(135deg, #ffd700 0%, #d4af37 100%);
  }

  .btn-main-text {
    font-size: 1.25rem;
    letter-spacing: 2px;
  }

  .btn-sub-text {
    font-size: 0.7rem;
    letter-spacing: 2px;
    opacity: 0.85;
  }

  .menu-quick-stats {
    display: flex;
    justify-content: center;
    gap: 2rem;
    margin-top: 1.5rem;
    font-size: 0.85rem;
    color: #94a3b8;
  }

  .menu-quick-stats b {
    color: #ffd700;
  }

  /* HUD HEADER */
  .hud-header {
    position: absolute;
    top: 10px;
    left: 15px;
    right: 15px;
    height: 70px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    z-index: 100;
    pointer-events: none;
  }

  .hud-left, .hud-center, .hud-right {
    display: flex;
    align-items: center;
    gap: 10px;
    pointer-events: auto;
  }

  .hero-status-pill, .castle-status-pill {
    background: rgba(15, 23, 42, 0.88);
    border: 2px solid rgba(212, 175, 55, 0.4);
    border-radius: 12px;
    padding: 6px 12px;
    display: flex;
    align-items: center;
    gap: 10px;
    backdrop-filter: blur(6px);
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.6);
  }

  .hero-avatar {
    width: 44px;
    height: 44px;
    border-radius: 8px;
    border: 2px solid #ffd700;
    background: #000;
    object-fit: cover;
    image-rendering: pixelated;
  }

  .hero-bars {
    display: flex;
    flex-direction: column;
    gap: 3px;
    width: 150px;
  }

  .hero-name-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.72rem;
    font-weight: 800;
    color: #ffd700;
  }

  .bar-track {
    position: relative;
    width: 100%;
    height: 10px;
    background: #090d16;
    border-radius: 5px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
