---
// Каркас всех страниц Лоропедии: общий Layout сайта + своя навигация, крошки и поиск.
import Layout from '../../layouts/Layout.astro';
import LpReader from './LpReader.astro';
import { breadcrumbs } from '../../lib/seo';
import { PROTECT_COOKIE, protectionOn } from '../../lib/loropedia/guard';
import { LP } from '../../lib/loropedia';
import { rarity } from '../../lib/loropedia/play';
import '../../styles/loropedia.css';

interface Props {
  title: string;            // полный <title>
  description?: string;
  image?: string | null;
  type?: 'website' | 'article';
  crumbs?: [string, string][]; // без «Лоропедии» — она добавляется сама
  active?: 'home' | 'cats' | 'timeline' | 'map' | 'gallery' | 'search' | 'play';
  jsonLd?: any[];
  noindex?: boolean;
}
const { title, description, image = null, type = 'website', crumbs = [], active, jsonLd = [], noindex = false } = Astro.props;
const protect = protectionOn(Astro.cookies.get(PROTECT_COOKIE)?.value);
const trail: [string, string][] = [['Лоропедия', '/loropedia'], ...crumbs];
const q = Astro.url.searchParams.get('q') || '';
const nav = [
  { id: 'home', href: '/loropedia', label: 'Главная', icon: '❖' },
  { id: 'timeline', href: '/loropedia/khronologiya', label: 'Хронология', icon: '⏳' },
  { id: 'map', href: '/loropedia/karta', label: 'Ментальная карта', icon: '✶' },
  { id: 'play', href: '/loropedia/igry', label: 'Испытания', icon: '🏆' },
  { id: 'gallery', href: '/loropedia/galereya', label: 'Галерея', icon: '🖼' },
];
const ctx = {
  people: LP.articles.filter((a) => a.cat === 'personazhi').map((a) => a.slug),
  ds: LP.articles.filter((a: any) => a.layer === 'book:darg-sirrom').map((a) => a.slug),
  rare: LP.articles.filter((a) => rarity(new Set([...a.links, ...a.backlinks]).size, !!a.image) !== 'common').map((a) => a.slug),
  day: LP.articles.filter((a) => a.cat !== 'glavy' && a.cat !== 'khronologiya-razdel' && a.excerpt.length > 60 && a.status !== 'idea' && !(a as any).historianGuess).map((a) => a.slug).sort(),
};
---
<Layout title={title} description={description} image={image} type={type} robots={noindex ? 'noindex,follow' : null}
  jsonLd={[breadcrumbs([['Главная', '/'], ...trail]), ...jsonLd]}>
  <div class="lp container" data-lp-protect={protect ? '1' : '0'}>
    <div class="lp-topbar">
      <a class="lp-brand" href="/loropedia">
        <span class="lp-brand-mark" aria-hidden="true">📜</span>
        <span class="lp-brand-text">Лоропедия <small>МоррисГрада</small></span>
      </a>
      <nav class="lp-nav" aria-label="Разделы Лоропедии">
        {nav.map((n) => <a href={n.href} class:list={['lp-nav-link', { active: active === n.id }]}><span aria-hidden="true">{n.icon}</span> {n.label}</a>)}
      </nav>
      <form class="lp-search-mini" action="/loropedia/poisk" method="get" role="search">
        <input type="search" name="q" value={q} placeholder="Найти в летописи…" aria-label="Поиск по Лоропедии" autocomplete="off" />
        <button type="submit" aria-label="Искать" data-tip="Искать по названиям, прозвищам и тексту статей">⌕</button>
      </form>
      {!protect && (
        <a class="lp-xp" href="/loropedia/igry#dostizheniya" data-lp-xp data-tip="Ранг читателя и опыт. Прогресс хранится только в этом браузере.">
          <span class="lp-xp-rank" data-rank>Новичок у фонтана</span>
          <span class="lp-xp-bar"><i data-bar></i></span>
          <span class="lp-xp-num"><b data-xpnum>0</b> оп.</span>
        </a>
      )}
    </div>
    <LpReader />
    {trail.length > 1 && (
      <nav class="lp-crumbs" aria-label="Навигационная цепочка">
        {trail.map(([name, path], i) => i < trail.length - 1
          ? <><a href={path}>{name}</a><span class="lp-crumb-sep" aria-hidden="true">◆</span></>
          : <span aria-current="page">{name}</span>)}
      </nav>
    )}
    <slot />
    {!protect && <script type="application/json" id="lp-play-ctx" set:html={JSON.stringify(ctx)} />}
    <div class="lp-foot">
      <div class="lp-foot-orn" aria-hidden="true"><span></span>✦ ⚜ ✦<span></span></div>
      <p>Лоропедия собрана из летописи «Обитель смерти». <span class="lp-pill lp-pill-canon">✅ Канон</span> — есть в тексте книги; <span class="lp-pill lp-pill-idea">💡 Не канон</span> — замыслы и додумки автора; <span class="lp-pill lp-pill-disputed">⚠️ Спорно</span> — текст не подтверждает однозначно.</p>
    </div>
  </div>
</Layout>
<script>
  import { boot } from '../../scripts/loropedia/play';
  document.addEventListener('astro:page-load', () => { if (document.querySelector('.lp')?.getAttribute('data-lp-protect') !== '1') boot(); });
</script>
