---
// CrateClickerGame.astro — «Ящик»: 3D инкрементальная RPG.
// Логика: /js/crate/core.js (данные и формулы), /js/crate/skins.js (процедурные текстуры), /js/crate/game.js (сцена и интерфейс).
// Three.js r128 подключается глобально на странице игры из /js/three.min.js.
const v = '1.0.0';
---

<div id="cr-app" class="cr-app">
  <section class="cr-stage" id="cr-stage">
    <canvas id="cr-canvas" aria-label="3D ящик — бей по нему!"></canvas>

    <div class="cr-zonebar">
      <button type="button" id="cr-zone-prev" class="cr-zbtn" aria-label="Предыдущая зона">◀</button>
      <div class="cr-zinfo">
        <b id="cr-zone-name">Зона 1</b>
        <small id="cr-zone-region">Старый сарай</small>
        <div id="cr-kills" class="cr-kills"></div>
      </div>
      <button type="button" id="cr-zone-next" class="cr-zbtn" aria-label="Следующая зона">▶</button>
      <button type="button" id="cr-auto" class="cr-zbtn cr-auto" title="Автопродвижение">⏩</button>
    </div>

    <div class="cr-hpwrap">
      <div id="cr-crate-name" class="cr-crate-name">Ящик</div>
      <div class="cr-hpbar"><div id="cr-hp-fill"></div><span id="cr-hp-text">10 / 10</span></div>
      <div class="cr-bossbar" id="cr-boss-timer" style="display:none"><div id="cr-boss-fill"></div><span id="cr-boss-text"></span></div>
    </div>

    <div id="cr-buffs" class="cr-buffs"></div>
    <button type="button" id="cr-daily" class="cr-daily" title="Ежедневная награда">🎁<small></small></button>
    <div id="cr-floaters" class="cr-floaters" aria-hidden="true"></div>
    <div id="cr-toasts" class="cr-toasts" aria-live="polite"></div>
    <div id="cr-skills" class="cr-skills"></div>
  </section>

  <aside class="cr-panel">
    <div class="cr-res">
      <div class="cr-cur" title="Щепки — основная валюта"><span>🪵</span><b id="cr-chips">0</b></div>
      <div class="cr-cur" title="Самоцветы — за боссов, достижения и уровни"><span>💎</span><b id="cr-gems">0</b></div>
      <div class="cr-cur" title="Искры — валюта перерождения"><span>✨</span><b id="cr-sparks">0</b></div>
      <div class="cr-lvlbox" title="Уровень героя и опыт">
        <span class="cr-lvl">Ур. <b id="cr-lvl">1</b></span>
        <div class="cr-xpbar"><div id="cr-xp-fill"></div><span id="cr-xp-text"></span></div>
      </div>
      <div class="cr-dmg"><span title="Урон клика">👊 <b id="cr-click">1</b></span><span title="Урон помощников в секунду">⚙️ <b id="cr-dps">0</b>/с</span></div>
    </div>
    <nav id="cr-tabs" class="cr-tabs"></nav>
    <div id="cr-tabbody" class="cr-tabbody"></div>
  </aside>

  <div id="cr-modal" class="cr-modal"><div class="cr-modal-card"><button type="button" class="cr-modal-x" data-close aria-label="Закрыть">×</button><div id="cr-modal-body"></div></div></div>
</div>

<script is:inline src={`/js/crate/core.js?v=${v}`}></script>
<script is:inline src={`/js/crate/skins.js?v=${v}`}></script>
<script is:inline src={`/js/crate/game.js?v=${v}`}></script>

<style is:global>
  .cr-app {
    --gold: #c9a86c; --gold-b: #ffd978; --wood: #e0a868; --ink: #f3e8e0; --muted: #a89a92;
    --panel: rgba(18, 12, 16, 0.94); --card: rgba(255, 255, 255, 0.04); --line: rgba(201, 168, 108, 0.22);
    position: fixed; inset: 0; display: flex; color: var(--ink);
    font-family: system-ui, -apple-system, 'Segoe UI', sans-serif; font-size: 14px;
    background: #07050a; user-select: none; -webkit-user-select: none; -webkit-tap-highlight-color: transparent;
  }
  .cr-app button { font: inherit; color: inherit; }
  .cr-stage { position: relative; flex: 1; min-width: 0; overflow: hidden; transition: background 0.8s; }
  #cr-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: none; }

  /* --- зоны --- */
  .cr-zonebar { position: absolute; top: 10px; left: 50%; transform: translateX(-50%); display: flex; align-items: center; gap: 6px; z-index: 5;
    background: rgba(12, 8, 12, 0.72); border: 1px solid var(--line); border-radius: 16px; padding: 5px 8px; backdrop-filter: blur(6px); }
  .cr-zinfo { text-align: center; min-width: 150px; }
  .cr-zinfo b { display: block; font-family: 'Cinzel', serif; color: var(--gold-b); font-size: 1.05rem; letter-spacing: 0.05em; }
  .cr-zinfo small { display: block; color: var(--muted); font-size: 0.72rem; }
  .cr-kills { display: flex; gap: 3px; justify-content: center; margin-top: 3px; min-height: 8px; font-size: 0.7rem; }
  .cr-kills i { width: 9px; height: 6px; border-radius: 2px; background: rgba(255, 255, 255, 0.15); }
  .cr-kills i.on { background: var(--gold-b); box-shadow: 0 0 6px var(--gold); }
  .cr-farm { color: #8fd; } .cr-bossmark { color: #ff5a6a; font-weight: 700; }
  .cr-zbtn { width: 32px; height: 32px; border-radius: 10px; border: 1px solid var(--line); background: rgba(255, 255, 255, 0.05); cursor: pointer; }
  .cr-zbtn:disabled { opacity: 0.3; cursor: default; }
  .cr-zbtn:not(:disabled):hover { border-color: var(--gold); }
  .cr-auto { opacity: 0.45; } .cr-auto.on { opacity: 1; border-color: var(--gold); background: rgba(201, 168, 108, 0.18); }

  /* --- здоровье --- */
  .cr-hpwrap { position: absolute; left: 50%; transform: translateX(-50%); bottom: 86px; width: min(420px, 82%); z-index: 4; pointer-events: none; text-align: center; }
  .cr-crate-name { font-family: 'Cinzel', serif; font-weight: 800; color: var(--wood); text-shadow: 0 2px 6px #000; margin-bottom: 4px; }
  .cr-crate-name.boss { color: #ff5a6a; font-size: 1.15rem; animation: cr-pulse 0.8s infinite alternate; }
  .cr-hpbar, .cr-bossbar, .cr-xpbar { position: relative; height: 16px; border-radius: 8px; background: rgba(0, 0, 0, 0.6); border: 1px solid rgba(255, 255, 255, 0.12); overflow: hidden; }
  #cr-hp-fill { height: 100%; background: linear-gradient(90deg, #b3261e, #e5533d 60%, #ff8a5a); transition: width 0.08s linear; }
  .cr-hpbar span, .cr-bossbar span, .cr-xpbar span { position: absolute; inset: 0; font-size: 0.72rem; font-weight: 700; line-height: 16px; text-shadow: 0 1px 2px #000; }
  .cr-bossbar { margin-top: 4px; height: 12px; }
  .cr-bossbar span { line-height: 12px; font-size: 0.66rem; }
  #cr-boss-fill { height: 100%; background: linear-gradient(90deg, #7e22ce, #c084fc); }
  @keyframes cr-pulse { to { text-shadow: 0 0 14px #ff2a3a; } }

  /* --- навыки, баффы, ежедневка --- */
  .cr-skills { position: absolute; left: 50%; bottom: 14px; transform: translateX(-50%); display: flex; gap: 7px; z-index: 5; }
  .cr-skill { position: relative; width: 50px; height: 50px; border-radius: 14px; border: 1px solid var(--line); background: rgba(14, 10, 14, 0.85); cursor: pointer; padding: 0; }
  .cr-skill .ic { font-size: 1.45rem; line-height: 50px; }
  .cr-skill .cd { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.95rem; }
  .cr-skill .cd:not(:empty) { background: rgba(0, 0, 0, 0.62); border-radius: 14px; }
  .cr-skill .lock { display: none; position: absolute; right: 2px; bottom: 1px; font-size: 0.6rem; color: var(--muted); }
  .cr-skill.locked { opacity: 0.35; filter: grayscale(1); } .cr-skill.locked .lock { display: block; }
  .cr-skill.ready { border-color: var(--gold); box-shadow: 0 0 10px rgba(201, 168, 108, 0.35); }
  .cr-skill.active { border-color: #4ade80; box-shadow: 0 0 14px rgba(74, 222, 128, 0.6); }
  .cr-skill.active .cd:not(:empty) { background: rgba(20, 80, 40, 0.55); }
  .cr-buffs { position: absolute; left: 10px; top: 58px; display: flex; flex-direction: column; gap: 4px; z-index: 4; pointer-events: none; }
  .cr-buffs span { background: rgba(14, 10, 14, 0.8); border: 1px solid var(--line); border-radius: 10px; padding: 3px 8px; font-size: 0.75rem; }
  .cr-daily { position: absolute; right: 10px; top: 10px; z-index: 5; width: 56px; padding: 6px 0 4px; border-radius: 14px; border: 1px solid var(--line); background: rgba(14, 10, 14, 0.8); cursor: pointer; font-size: 1.4rem; line-height: 1.1; }
  .cr-daily small { display: block; font-size: 0.58rem; color: var(--muted); }
  .cr-daily.ready { border-color: var(--gold-b); animation: cr-glow 1.2s infinite alternate; }
  .cr-daily.ready small { color: var(--gold-b); font-weight: 700; }
  @keyframes cr-glow { to { box-shadow: 0 0 18px rgba(255, 217, 120, 0.7); } }

  /* --- всплывашки --- */
  .cr-floaters { position: absolute; inset: 0; pointer-events: none; z-index: 6; overflow: hidden; }
  .cr-floater { position: absolute; font-weight: 900; font-size: 1.25rem; color: #ffe9b0; text-shadow: 0 0 8px rgba(255, 200, 90, 0.7), 0 2px 0 #3b1a10; transform: translate(-50%, -50%); animation: cr-float 1s ease-out forwards; white-space: nowrap; }
  .cr-floater.crit { color: #ff6a5a; font-size: 1.7rem; text-shadow: 0 0 12px rgba(255, 60, 40, 0.8), 0 2px 0 #300; }
  .cr-floater.auto { font-size: 0.9rem; opacity: 0.8; }
  .cr-floater.reward { color: #b5ff8f; font-size: 1.35rem; }
  @keyframes cr-float { 0% { opacity: 0; transform: translate(-50%, -30%) scale(0.6); } 15% { opacity: 1; transform: translate(-50%, -70%) scale(1.12); } 100% { opacity: 0; transform: translate(-50%, -230%) scale(1); } }
  .cr-toasts { position: absolute; top: 92px; left: 50%; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: 5px; z-index: 7; pointer-events: none; width: min(92%, 440px); }
  .cr-toast { background: rgba(20, 12, 18, 0.92); border: 1px solid var(--line); border-radius: 12px; padding: 6px 12px; font-size: 0.85rem; text-align: center; animation: cr-in 0.25s ease-out; transition: opacity 0.4s, transform 0.4s; }
  .cr-toast.out { opacity: 0; transform: translateY(-8px); }
  .cr-toast.good { border-color: #4ade80; } .cr-toast.bad { border-color: #f43f5e; } .cr-toast.boss { border-color: #ff5a6a; color: #ffb0b8; }
  .cr-toast.level, .cr-toast.gold { border-color: var(--gold-b); color: var(--gold-b); } .cr-toast.ach { border-color: #c084fc; } .cr-toast.skill { border-color: #60a5fa; }
  @keyframes cr-in { from { opacity: 0; transform: translateY(-8px) scale(0.96); } }

  /* --- панель --- */
  .cr-panel { width: 430px; flex-shrink: 0; display: flex; flex-direction: column; background: var(--panel); border-left: 1px solid var(--line); min-height: 0; }
  .cr-res { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; padding: 10px; border-bottom: 1px solid var(--line); }
  .cr-cur { display: flex; align-items: center; gap: 6px; background: var(--card); border-radius: 10px; padding: 6px 8px; min-width: 0; }
  .cr-cur b { font-size: 0.95rem; color: var(--gold-b); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cr-lvlbox { grid-column: span 2; display: flex; align-items: center; gap: 8px; }
  .cr-lvl { white-space: nowrap; font-family: 'Cinzel', serif; } .cr-lvl b { color: var(--gold-b); }
  .cr-xpbar { flex: 1; height: 14px; } .cr-xpbar span { line-height: 14px; font-size: 0.64rem; }
  #cr-xp-fill { height: 100%; background: linear-gradient(90deg, #7e22ce, #c084fc); transition: width 0.2s; }
  .cr-dmg { display: flex; flex-direction: column; font-size: 0.72rem; color: var(--muted); justify-content: center; }
  .cr-dmg b { color: var(--ink); }
  .cr-tabs { display: flex; gap: 2px; overflow-x: auto; padding: 6px 6px 0; border-bottom: 1px solid var(--line); scrollbar-width: none; }
  .cr-tabs::-webkit-scrollbar { display: none; }
  .cr-tab { position: relative; flex: 1 0 auto; display: flex; flex-direction: column; align-items: center; gap: 1px; padding: 6px 4px; border: 0; border-radius: 10px 10px 0 0; background: transparent; cursor: pointer; opacity: 0.6; }
  .cr-tab span { font-size: 1.15rem; } .cr-tab b { font-size: 0.64rem; font-weight: 600; white-space: nowrap; }
  .cr-tab.on { opacity: 1; background: rgba(201, 168, 108, 0.14); box-shadow: inset 0 -2px 0 var(--gold); }
  .cr-badge { position: absolute; top: 2px; right: 2px; min-width: 16px; height: 16px; padding: 0 4px; border-radius: 8px; background: #e11d48; font-size: 0.62rem; font-style: normal; font-weight: 800; line-height: 16px; }
  .cr-tabbody { flex: 1; overflow-y: auto; overscroll-behavior: contain; padding: 10px; min-height: 0; -webkit-overflow-scrolling: touch; }
  .cr-tabpage h4 { margin: 14px 0 6px; font-family: 'Cinzel', serif; color: var(--gold); font-size: 0.9rem; letter-spacing: 0.04em; }
  .cr-tabpage h4 small { font-family: system-ui, sans-serif; color: var(--muted); font-size: 0.72rem; margin-left: 6px; letter-spacing: 0; }
  .cr-tabpage h4:first-child { margin-top: 4px; }
  .cr-note, .cr-empty { color: var(--muted); font-size: 0.8rem; margin: 6px 0; }

  .cr-card { display: flex; align-items: center; gap: 10px; background: var(--card); border: 1px solid rgba(255, 255, 255, 0.06); border-radius: 12px; padding: 8px; margin-bottom: 6px; }
  .cr-card.locked { opacity: 0.45; }
  .cr-ico { font-size: 1.6rem; width: 40px; text-align: center; flex-shrink: 0; }
  .cr-info { flex: 1; min-width: 0; }
  .cr-info b { display: block; font-size: 0.88rem; } .cr-info small { display: block; color: var(--muted); font-size: 0.74rem; margin-top: 1px; }
  .lv { color: var(--gold-b); font-weight: 600; font-size: 0.74rem; margin-left: 4px; }
  .cr-ms { position: relative; height: 10px; border-radius: 5px; background: rgba(0, 0, 0, 0.45); margin-top: 4px; overflow: hidden; }
  .cr-ms i { position: absolute; left: 0; top: 0; bottom: 0; background: rgba(201, 168, 108, 0.45); }
  .cr-ms span { position: relative; display: block; font-size: 0.58rem; line-height: 10px; text-align: center; color: #ddd; }

  .cr-btn { border: 1px solid var(--line); background: rgba(255, 255, 255, 0.06); border-radius: 10px; padding: 7px 10px; cursor: pointer; font-size: 0.8rem; font-weight: 600; transition: background 0.15s, transform 0.08s; }
  .cr-btn:hover { background: rgba(201, 168, 108, 0.16); } .cr-btn:active { transform: scale(0.96); }
  .cr-btn:disabled { opacity: 0.35; cursor: default; }
  .cr-btn.buy { min-width: 92px; flex-shrink: 0; line-height: 1.2; border-color: rgba(74, 222, 128, 0.5); background: rgba(74, 222, 128, 0.12); }
  .cr-btn.buy.cant, .cr-upg.cant { opacity: 0.4; filter: grayscale(0.6); border-color: var(--line); background: rgba(255, 255, 255, 0.03); }
  .cr-btn.gold { border-color: var(--gold-b); color: var(--gold-b); background: rgba(201, 168, 108, 0.16); }
  .cr-btn.danger { border-color: #f43f5e; color: #ff8a9a; background: rgba(244, 63, 94, 0.12); }
  .cr-btn.ghost { background: transparent; } .cr-btn.small { padding: 5px 9px; }
  .cr-row-btns { display: flex; flex-wrap: wrap; gap: 6px; margin: 10px 0; }
  .cr-statbtns { display: flex; gap: 4px; }
  .cr-bulk { display: flex; gap: 5px; align-items: center; flex-wrap: wrap; font-size: 0.8rem; color: var(--muted); }
  .cr-chip { border: 1px solid var(--line); background: transparent; border-radius: 999px; padding: 4px 11px; cursor: pointer; font-size: 0.78rem; }
  .cr-chip.on { background: rgba(201, 168, 108, 0.22); border-color: var(--gold); color: var(--gold-b); }

  .cr-upgs { display: grid; grid-template-columns: repeat(auto-fill, minmax(118px, 1fr)); gap: 6px; }
  .cr-upg { display: flex; flex-direction: column; align-items: flex-start; gap: 1px; text-align: left; padding: 7px; border-radius: 10px; border: 1px solid rgba(255, 217, 120, 0.5); background: rgba(201, 168, 108, 0.1); cursor: pointer; }
  .cr-upg span { font-size: 1.1rem; } .cr-upg b { font-size: 0.72rem; line-height: 1.15; } .cr-upg small { font-size: 0.64rem; color: var(--muted); } .cr-upg em { font-style: normal; font-size: 0.72rem; color: var(--gold-b); font-weight: 700; margin-top: 2px; }

  .cr-hero { display: flex; gap: 12px; align-items: center; margin-bottom: 10px; }
  .cr-hero-lvl { width: 70px; height: 70px; border-radius: 50%; border: 2px solid var(--gold); display: flex; flex-direction: column; align-items: center; justify-content: center; font-family: 'Cinzel', serif; font-size: 1.6rem; color: var(--gold-b); flex-shrink: 0; box-shadow: 0 0 16px rgba(201, 168, 108, 0.3); }
  .cr-hero-lvl small { font-size: 0.55rem; color: var(--muted); font-family: system-ui; }
  .cr-hero b { display: block; } .cr-hero small { color: var(--muted); font-size: 0.75rem; } .cr-pts { color: var(--gold-b); }
  .cr-kv { display: grid; grid-template-columns: 1fr 1fr; gap: 4px; }
  .cr-kv div { display: flex; justify-content: space-between; gap: 6px; background: var(--card); border-radius: 8px; padding: 6px 8px; font-size: 0.76rem; }
  .cr-kv span { color: var(--muted); } .cr-kv b { text-align: right; }

  .cr-slots { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
  .cr-item { position: relative; display: flex; gap: 8px; align-items: flex-start; padding: 7px; border-radius: 10px; background: var(--card); border: 1px solid var(--rc, rgba(255,255,255,0.1)); box-shadow: inset 0 0 14px color-mix(in srgb, var(--rc, #000) 18%, transparent); font-size: 0.74rem; cursor: pointer; height: 100%; box-sizing: border-box; }
  .cr-item.empty { opacity: 0.5; cursor: default; border-style: dashed; }
  .cr-item .ic { font-size: 1.4rem; }
  .cr-item b { display: block; color: var(--rc, var(--ink)); font-size: 0.78rem; line-height: 1.15; }
  .cr-item small { color: var(--muted); font-size: 0.66rem; }
  .cr-item ul { margin: 3px 0 0; padding: 0 0 0 14px; color: #d8ccc4; } .cr-item li { font-size: 0.68rem; }
  .cr-inv { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 6px; }
  .cr-invcell { position: relative; }
  .cr-better { position: absolute; right: 6px; top: 4px; color: #4ade80; font-weight: 900; text-shadow: 0 0 6px #4ade80; }
  .cr-modal .cr-item { margin: 6px 0; cursor: default; }
  .cr-cmp { color: var(--muted); font-size: 0.78rem; margin: 10px 0 0; }
  .cr-setting { display: flex; align-items: center; gap: 8px; font-size: 0.8rem; color: var(--muted); }
  .cr-setting select { background: #1a1218; color: var(--ink); border: 1px solid var(--line); border-radius: 8px; padding: 4px; }

  .cr-skins { display: grid; grid-template-columns: repeat(auto-fill, minmax(116px, 1fr)); gap: 8px; margin-top: 6px; }
  .cr-skin { display: flex; flex-direction: column; align-items: center; gap: 5px; padding: 8px; border-radius: 12px; background: var(--card); border: 1px solid rgba(255, 255, 255, 0.07); text-align: center; }
  .cr-skin.cur { border-color: var(--gold); box-shadow: 0 0 12px rgba(201, 168, 108, 0.3); }
  .cr-skin img, .cr-skin > i { width: 72px; height: 72px; border-radius: 10px; object-fit: cover; display: block; border: 1px solid rgba(255, 255, 255, 0.1); }
  .cr-skin.locked img, .cr-skin.locked > i { filter: grayscale(0.85) brightness(0.55); }
  .cr-skin b { font-size: 0.8rem; }
  .cr-tag { font-size: 0.66rem; color: var(--muted); line-height: 1.2; } .cr-tag.on { color: var(--gold-b); font-weight: 700; }
  .fxprev { background: #120c10; position: relative; overflow: hidden; }
  .fx-chips { background: radial-gradient(circle at 30% 40%, #b07a44 0 5px, transparent 6px), radial-gradient(circle at 70% 60%, #6a3e1c 0 6px, transparent 7px), radial-gradient(circle at 50% 25%, #8a5a2e 0 4px, transparent 5px), #120c10; }
  .fx-sparks { background: radial-gradient(circle at 30% 40%, #ffd24a 0 3px, transparent 6px), radial-gradient(circle at 70% 60%, #ff8a1a 0 3px, transparent 7px), radial-gradient(circle at 55% 25%, #fff2a0 0 2px, transparent 5px), #120c10; }
  .fx-confetti { background: linear-gradient(45deg, transparent 40%, #ff3d7a 40% 48%, transparent 48%), linear-gradient(-30deg, transparent 55%, #3dd6ff 55% 62%, transparent 62%), linear-gradient(80deg, transparent 25%, #ffe14a 25% 31%, transparent 31%), #120c10; }
  .fx-snow { background: radial-gradient(circle at 30% 40%, #fff 0 3px, transparent 4px), radial-gradient(circle at 70% 65%, #cff4ff 0 4px, transparent 5px), radial-gradient(circle at 50% 20%, #fff 0 2px, transparent 3px), #0c1420; }
  .fx-gems { background: radial-gradient(circle at 30% 40%, #60a5fa 0 5px, transparent 6px), radial-gradient(circle at 70% 60%, #c084fc 0 5px, transparent 6px), radial-gradient(circle at 50% 25%, #4ade80 0 4px, transparent 5px), #120c10; }
  .fx-hearts { background: radial-gradient(circle at 40% 45%, #ff3d7a 0 7px, transparent 8px), radial-gradient(circle at 60% 45%, #ff3d7a 0 7px, transparent 8px), #120c10; }

  .cr-prest { display: flex; flex-direction: column; gap: 10px; background: linear-gradient(135deg, rgba(126, 34, 206, 0.18), rgba(201, 168, 108, 0.1)); border: 1px solid rgba(192, 132, 252, 0.4); border-radius: 14px; padding: 12px; }
