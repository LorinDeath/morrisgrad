    4: [
      { name: "РЫВОК", desc: "ПРОБЕЛ: Рывок (100 ядер)", cost: 100, type: 'unlock', id: 'ult_dash', effect: () => { if(!meta.unlocks.includes('ult_dash')) meta.unlocks.push('ult_dash'); } },
      { name: "ЦИКЛЕР", desc: "+15% Скорострельности", cost: 50, type: 'stat', effect: p => p.fireRate *= 0.85 },
