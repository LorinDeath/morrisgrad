---
---
<div id="app-window" class="app-window">
  <div class="window-header">
    <div class="window-controls">
      <button id="win-close" class="win-btn close" title="Close"></button>
      <button id="win-maximize" class="win-btn maximize" title="Fullscreen"></button>
    </div>
    <div class="window-title">NEON_PROTOCOL_RUS_V2.1.exe</div>
  </div>
  
  <div id="game-container" class="game-container">
    <canvas id="game-canvas" width="1040" height="720"></canvas>

    <!-- UI Layer -->
    <div id="ui-layer" class="ui-layer">
      
      <!-- Main Menu -->
      <div id="menu-screen" class="screen active">
        <h1 class="title glitch" data-text="НЕОНОВЫЙ ПРОТОКОЛ">НЕОНОВЫЙ ПРОТОКОЛ</h1>
        <div class="meta-stats">
          <div class="stat-box">
            <span class="label">РЕКОРД</span>
            <span id="menu-best-score" class="value">0</span>
          </div>
          <div class="stat-box">
            <span class="label">ОСКОЛКИ</span>
            <span id="menu-currency" class="value text-purple">0</span>
          </div>
          <div class="stat-box">
            <span class="label">ЯДРА</span>
            <span id="menu-boss-currency" class="value text-gold">0</span>
          </div>
        </div>
        
        <!-- Main Menu Buttons -->
        <div class="menu-buttons-row">
            <button id="btn-open-core" class="btn-secondary">СИСТЕМНОЕ ЯДРО</button>
            <button id="btn-tree" class="btn-secondary">НЕЙРОСЕТЬ</button>
            <button id="btn-inventory" class="btn-secondary text-gold">ИНВЕНТАРЬ [NEW]</button>
            <button id="btn-raids" class="btn-secondary text-red">РЕЙДЫ [BOSS]</button>
            <button id="btn-profile" class="btn-secondary text-blue">ПРОФИЛЬ</button>
            <button id="btn-leaderboard" class="btn-secondary text-purple">РЕЙТИНГ</button>
            <button id="btn-ascension" class="btn-secondary" style="border-color: #a020f0; color: #a020f0; display: none;">ВОЗВЫШЕНИЕ</button>
            <button id="btn-help" class="btn-secondary text-gold">СПРАВКА</button>
        </div>

        <div class="menu-columns">
          <!-- Basic Shop -->
          <!-- Removed from here, moved to separate screens -->
        </div>

        <button id="btn-start" class="btn-primary">НАЧАТЬ ПРОТОКОЛ</button>
      </div>

      <!-- Core Shop Screen -->
      <div id="core-screen" class="screen hidden">
          <h2>СИСТЕМНОЕ ЯДРО</h2>
          <div class="meta-stats">
            <span>ОСКОЛКИ: <span id="core-currency" class="text-purple">0</span></span>
          </div>
          <div class="upgrades-shop">
            <div class="shop-scroll">
              <!-- Shop Items -->
              <div class="upgrade-row"><div class="upg-info"><span class="upg-name">ЦЕЛОСТНОСТЬ (HP)</span><span id="lvl-hp" class="upg-lvl">Lvl 0</span></div><button id="btn-upg-hp" class="btn-small">УЛУЧШИТЬ</button></div>
              <div class="upgrade-row"><div class="upg-info"><span class="upg-name">ПЛАЗМА (УРОН)</span><span id="lvl-dmg" class="upg-lvl">Lvl 0</span></div><button id="btn-upg-dmg" class="btn-small">УЛУЧШИТЬ</button></div>
              <div class="upgrade-row"><div class="upg-info"><span class="upg-name">ДВИГАТЕЛИ (СКОР.)</span><span id="lvl-spd" class="upg-lvl">Lvl 0</span></div><button id="btn-upg-spd" class="btn-small">УЛУЧШИТЬ</button></div>
              <div class="upgrade-row"><div class="upg-info"><span class="upg-name">ЦИКЛЕР (СКОР.СТР.)</span><span id="lvl-rate" class="upg-lvl">Lvl 0</span></div><button id="btn-upg-rate" class="btn-small">УЛУЧШИТЬ</button></div>
              <div class="upgrade-row"><div class="upg-info"><span class="upg-name">МАГНИТНОЕ ПОЛЕ</span><span id="lvl-mag" class="upg-lvl">Lvl 0</span></div><button id="btn-upg-mag" class="btn-small">УЛУЧШИТЬ</button></div>
              <div class="upgrade-row"><div class="upg-info"><span class="upg-name">ЭНТРОПИЯ (УДАЧА)</span><span id="lvl-luck" class="upg-lvl">Lvl 0</span></div><button id="btn-upg-luck" class="btn-small">УЛУЧШИТЬ</button></div>
              <div class="upgrade-row"><div class="upg-info"><span class="upg-name">ИМПУЛЬС (ОТТАЛК.)</span><span id="lvl-knock" class="upg-lvl">Lvl 0</span></div><button id="btn-upg-knock" class="btn-small">УЛУЧШИТЬ</button></div>
            </div>
          </div>
          <button id="btn-core-back" class="btn-secondary">НАЗАД</button>
      </div>

      <!-- Inventory Screen (RPG) -->
      <div id="inventory-screen" class="screen hidden">
        <h2>ЭКИПИРОВКА</h2>
        <div class="inv-layout">
            <div class="char-slots">
                <div class="slot-label">ОРУЖИЕ</div>
                <div id="slot-weapon" class="equip-slot" data-type="weapon">ПУСТО</div>
                <div class="slot-label">БРОНЯ</div>
                <div id="slot-armor" class="equip-slot" data-type="armor">ПУСТО</div>
                <div class="slot-label">ЧИП</div>
                <div id="slot-chip" class="equip-slot" data-type="chip">ПУСТО</div>
            </div>
            <div class="inv-grid-container">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:10px;">
                    <h3 style="margin:0;">ХРАНИЛИЩЕ</h3>
                    <button id="btn-upload-mode" class="btn-small" style="font-size:0.7rem; border-color:#a020f0; color:#a020f0;">ОТПРАВКА: ВЫКЛ</button>
                </div>
                <div id="inv-grid" class="inv-grid"></div>
            </div>
        </div>
        <button id="btn-inv-back" class="btn-secondary">НАЗАД</button>
      </div>

      <!-- Profile Screen -->
      <div id="profile-screen" class="screen hidden">
        <h2>ПРОФИЛЬ ОПЕРАТОРА</h2>
        <div id="profile-stats" class="profile-stats-grid"></div>
        <button id="btn-profile-back" class="btn-secondary">НАЗАД</button>
      </div>

      <!-- Character Selection Screen -->
      <div id="character-screen" class="screen hidden">
        <h2>ВЫБЕРИТЕ ОПЕРАТОРА</h2>
        <div class="char-layout">
            <div id="char-list" class="char-list"></div>
            <div class="char-info-panel">
                <h3 id="char-name-display" class="text-gold" style="font-size: 2rem; margin-bottom: 10px;">МОРПЕХ</h3>
                <div id="char-desc-display" class="char-desc" style="color: #ccc; margin-bottom: 20px; line-height: 1.5;">Описание...</div>
                <button id="btn-char-confirm" class="btn-primary">ВЫБРАТЬ</button>
            </div>
        </div>
        <button id="btn-char-back" class="btn-secondary">НАЗАД</button>
      </div>

      <!-- Raid Selection Screen -->
      <div id="raid-screen" class="screen hidden">
        <h2>ДОСТУПНЫЕ МИССИИ</h2>
        <div id="raid-list" class="raid-list"></div>
        <button id="btn-raid-back" class="btn-secondary">НАЗАД</button>
      </div>

      <!-- Victory Screen -->
      <div id="victory-screen" class="screen hidden">
        <h1 class="text-gold">МИССИЯ ВЫПОЛНЕНА</h1>
        <div class="final-stats">
          <p>ЦЕЛЬ УНИЧТОЖЕНА</p>
          <p>НАГРАДА: <span id="vic-reward" class="text-gold"></span></p>
        </div>
        <button id="btn-vic-menu" class="btn-secondary">В ГЛАВНОЕ МЕНЮ</button>
      </div>

      <!-- Merchant Screen -->
      <div id="merchant-screen" class="screen hidden">
        <h2 class="text-gold">ТОРГОВЕЦ</h2>
        <p>ОБМЕНЯЙ ОСКОЛКИ НА УСИЛЕНИЯ</p>
        <div id="merchant-items" class="merchant-grid">
           <!-- Items injected via JS -->
        </div>
        <button id="btn-merchant-close" class="btn-secondary">УЙТИ</button>
      </div>

      <!-- Leaderboard Screen -->
      <div id="leaderboard-screen" class="screen hidden">
        <h2>ГЛОБАЛЬНЫЙ РЕЙТИНГ</h2>
        <div class="lb-columns">
          <div class="lb-col">
            <h3 class="text-gold">ТОП ЗА ДЕНЬ</h3>
            <div id="lb-daily" class="lb-list">Загрузка...</div>
          </div>
          <div class="lb-col">
            <h3 class="text-purple">ТОП НЕДЕЛИ</h3>
            <div id="lb-weekly" class="lb-list">Загрузка...</div>
          </div>
        </div>
        <button id="btn-lb-back" class="btn-secondary">НАЗАД</button>
      </div>

      <!-- Ascension Screen -->
      <div id="ascension-screen" class="screen hidden">
        <h2 style="color: #a020f0; text-shadow: 0 0 15px #a020f0;">ВОЗВЫШЕНИЕ</h2>
        <p style="color: #ccc; max-width: 600px; text-align: center; margin-bottom: 20px;">
            Выберите предмет для переноса в реальность. <br>
            <span style="color: #f00;">ВНИМАНИЕ:</span> Весь прогресс игры будет сброшен. Вы получите Адский Огонь за рекорд.
        </p>
        
        <div class="ascension-layout" style="display: flex; gap: 40px; align-items: flex-start;">
            <div class="asc-slots" style="display: flex; flex-direction: column; gap: 15px;">
                <div id="asc-slot-weapon" class="equip-slot" data-type="weapon">ОРУЖИЕ</div>
                <div id="asc-slot-armor" class="equip-slot" data-type="armor">БРОНЯ</div>
                <div id="asc-slot-chip" class="equip-slot" data-type="chip">ЧИП</div>
            </div>
            
            <div class="asc-preview" style="width: 350px; background: rgba(0,0,0,0.8); border: 1px solid #a020f0; padding: 20px; border-radius: 8px;">
                <h3 id="asc-preview-title" style="color: #a020f0; margin-top: 0;">ПРЕДПРОСМОТР</h3>
                <div id="asc-preview-content" style="font-size: 0.8rem; color: #aaa; min-height: 150px;">Выберите предмет...</div>
                
                <div id="asc-upload-section" class="hidden" style="margin-top: 15px; border-top: 1px solid #333; padding-top: 10px;">
                    <label style="display: block; color: #fff; margin-bottom: 5px; font-size: 0.8rem;">Своя иконка (Квадрат, макс 2МБ, 3000x3000):</label>
                    <input type="file" id="asc-icon-input" accept="image/png, image/jpeg, image/webp" style="font-size: 0.8rem; color: #888;" />
                    
                    <label style="display: block; color: #fff; margin-bottom: 5px; margin-top: 10px; font-size: 0.8rem;">Имя предмета (Макс 15):</label>
                    <input type="text" id="asc-name-input" maxlength="15" placeholder="Название..." style="width: 100%; background: #000; border: 1px solid #444; color: #fff; padding: 5px; font-size: 0.8rem;" />
                </div>
            </div>
        </div>
        
        <button id="btn-ascension-confirm" class="btn-primary" style="margin-top: 30px; border-color: #a020f0; color: #a020f0; display: none;">ВОЗВЫСИТЬ (1 ЯДРО)</button>
        <button id="btn-ascension-back" class="btn-secondary">ОТМЕНА</button>
      </div>

      <!-- Help Screen -->
      <div id="help-screen" class="screen hidden">
        <h2>БАЗА ЗНАНИЙ</h2>
        <div class="help-content" style="max-width: 800px; width: 90%; text-align: left; overflow-y: auto; max-height: 60vh; padding: 20px; background: rgba(0,0,0,0.8); border: 1px solid #333; font-size: 0.9rem; line-height: 1.6;">
            <h3 class="text-gold">УПРАВЛЕНИЕ</h3>
            <p>• <b>WASD / Стрелки</b>: Перемещение персонажа.</p>
            <p>• <b>Мышь</b>: Прицеливание. <b>ЛКМ</b>: Стрельба (Зажать, но следите за перегревом!).</p>
            <p>• <b>SPACE</b>: Рывок (Требуется разблокировка в Нейросети).</p>
            <p>• <b>E</b>: Активный навык класса (Турель, Щит, Невидимость и др.).</p>
            <p>• <b>F</b>: Ультимативная способность (Ядерный удар - требует разблокировки).</p>
            
            <h3 class="text-purple" style="margin-top: 20px;">РЕСУРСЫ</h3>
            <p>• <span style="color:#a020f0">ОСКОЛКИ</span>: Начисляются автоматически при уничтожении врагов. Используются для улучшения характеристик в "Системном Ядре".</p>
            <p>• <span style="color:#ffd700">ЯДРА (Золотые)</span>: Редкий ресурс с Боссов. Нужны для изучения талантов в "Нейросети".</p>
            
            <h3 class="text-blue" style="margin-top: 20px;">ПОГОДА И УСЛОВИЯ</h3>
            <p>• <b>ДОЖДЬ</b>: Поверхность становится скользкой, скорость передвижения снижается.</p>
            <p>• <b>ВЕТЕР</b>: Сильные порывы сносят персонажа и снаряды в сторону.</p>
            <p>• <b>ТУМАН</b>: Ухудшает видимость, скрывая врагов вдалеке.</p>
            <p>• <b>АНОМАЛИИ</b>: Случайные события (Гравитация, Турбо-режим, Берсерк), временно меняющие физику игры.</p>

            <h3 class="text-gold" style="margin-top: 20px;">ХАРАКТЕРИСТИКИ</h3>
            <p>• <b>УДАЧА</b>: Влияет на шанс выпадения редких предметов и критических ударов.</p>
            <p>• <b>ВАМПИРИЗМ</b>: Восстанавливает здоровье в % от нанесенного урона.</p>
            <p>• <b>ШИПЫ</b>: Возвращают часть полученного урона обратно врагу.</p>
            <p>• <b>МАГНИТ</b>: Увеличивает радиус сбора опыта и предметов.</p>
            <p>• <b>ПРОКЛЯТИЕ (Метка)</b>: Увеличивает входящий по вам урон (будьте осторожны с предметами, дающими этот стат).</p>

            <h3 class="text-blue" style="margin-top: 20px;">МЕХАНИКИ</h3>
            <p>• <b>ПЕРЕГРЕВ</b>: Оружие нагревается при стрельбе. Если шкала заполнится, оружие заклинит на несколько секунд. Делайте паузы!</p>
            <p>• <b>КОМБО</b>: Быстрое уничтожение врагов заполняет шкалу комбо. Высокое комбо (x50+) включает режим "ПЕРЕГРУЗКА" (ускорение стрельбы).</p>
            <p>• <b>ПОГЛОЩЕНИЕ (Инвентарь)</b>: Вы можете "скормить" ненужный предмет другому предмету того же типа. При этом 10% характеристик уничтожаемого предмета перейдут к основному навсегда.</p>
            <p>• <b>СЕТЫ</b>: Соберите 3 предмета с одинаковым названием сета (например, "CURSED"), чтобы активировать мощные бонусы.</p>

            <h3 class="text-red" style="margin-top: 20px;">БЕСТИАРИЙ (ВРАГИ)</h3>
            <p>• <b>БЕГУНЫ (Оранжевые)</b>: Слабые, но очень быстрые.</p>
            <p>• <b>ТАНКИ (Синие)</b>: Медленные, много здоровья.</p>
            <p>• <b>СТРЕЛКИ (Зеленые)</b>: Стреляют обычными снарядами издалека.</p>
            <p>• <b>СНАЙПЕРЫ (Фиолетовые)</b>: Бьют редко, но больно. Следите за лазерным прицелом!</p>
            <p>• <b>ЩИТОВИКИ (Голубой щит)</b>: Неуязвимы спереди. Заходите им в спину.</p>
            <p>• <b>СТРОИТЕЛИ (Фиолетовые)</b>: Строят турели или лагеря спавна. Уничтожайте их первыми!</p>
            <p>• <b>КАМИКАДЗЕ (Мигающие)</b>: Взрываются при приближении.</p>
            <p>• <b>ХИЛЕРЫ (Голубые)</b>: Лечат других врагов.</p>
            <p>• <b>ПРИЗРАКИ (Серые)</b>: Периодически становятся невидимыми.</p>
            <p>• <b>ВАМПИРЫ (Темные)</b>: Восстанавливают свое здоровье при атаке по вам.</p>
            <p>• <b>ЗАХВАТЧИКИ (Красные)</b>: "Игроки" с уникальными способностями (Рывок, Хил, Ракеты).</p>
            <p>• <b>МАСТЕР КЛЕТКИ (Синий)</b>: Создает купол-ловушку. Убейте его, чтобы выйти.</p>
            <p>• <b>СТЕНОБЕГ (Зеленый)</b>: Быстро бегает и ставит тонкие защитные стены.</p>

            <h3 class="text-red" style="margin-top: 20px;">БОССЫ</h3>
            <p>• <b>БОСС 1 (Красный)</b>: Призывает толпы миньонов.</p>
            <p>• <b>БОСС 2 (Снайпер)</b>: Стреляет мощным лазером. Следите за линией прицела.</p>
            <p>• <b>БОСС 3 (Танк)</b>: Огромный запас здоровья и щит. Бьет по площади.</p>
            <p>• <b>БОСС 4 (Чарджер)</b>: Очень быстрый, таранит игрока.</p>
            <p>• <b>БОСС 5 (Ад)</b>: Стреляет спиралями снарядов.</p>
            <p>• <b>БОСС 6 (Власть)</b>: Призывает элитных врагов и миньонов.</p>
            <p>• <b>БОСС 7 (Псих)</b>: Телепортируется и создает хаос.</p>
        </div>
        <button id="btn-help-back" class="btn-secondary">НАЗАД</button>
      </div>

      <!-- Difficulty Selection -->
      <div id="difficulty-screen" class="screen hidden">
        <h2>ВЫБЕРИТЕ УРОВЕНЬ УГРОЗЫ</h2>
        <div class="diff-grid">
          <!-- Buttons injected via JS -->
        </div>
        <div class="diff-info" id="diff-desc">
          МНОЖИТЕЛЬ НАГРАД: x1
        </div>
        <button id="btn-diff-back" class="btn-secondary">НАЗАД</button>
      </div>

      <!-- Skill Tree Screen -->
      <div id="tree-screen" class="screen hidden">
        <div class="tree-header">
          <h2>НЕЙРОСЕТЬ</h2>
          <div class="tree-stats">
            <span>ЯДРА: <span id="tree-currency" class="text-gold">0</span></span>
            <button id="btn-tree-back" class="btn-small">НАЗАД</button>
          </div>
        </div>
        <div id="tree-canvas-container" class="tree-container">
          <canvas id="tree-canvas"></canvas>
          <div id="tree-tooltip" class="tree-tooltip hidden"></div>
        </div>
        <div class="tree-controls-hint">ТЯНИ ЧТОБЫ ДВИГАТЬ • КЛИК ЧТОБЫ ИЗУЧИТЬ</div>
      </div>

      <!-- HUD -->
      <div id="hud-screen" class="screen hidden">
        <!-- Top Right: Wave & Level -->
        <div class="hud-top-right">
          <div class="wave-display">ВОЛНА <span id="hud-wave">1</span></div>
          <div class="level-display">УР. <span id="hud-level">1</span></div>
          <div class="enemy-count">ВРАГИ: <span id="hud-enemies">0</span></div>
        </div>
        
        <!-- Bottom Center: HP & XP -->
        <div class="hud-bottom-center">
          <div class="hp-bar-wrap">
            <div id="hud-hp-bar" class="hp-bar-fill"></div>
            <span id="hud-hp-text">100/100</span>
          </div>
          <div class="heat-bar-wrap">
            <div id="hud-heat-bar" class="heat-bar-fill"></div>
            <span style="position:absolute; width:100%; text-align:center; font-size:10px; top:-1px; color:rgba(255,255,255,0.7); pointer-events:none;">НАГРЕВ</span>
          </div>
          <div id="hud-proj-count" style="font-size: 0.8rem; color: #0ff; margin-top: 2px;">x1 СНАРЯДОВ</div>
          <div class="skills-hud">
             <div id="skill-q" class="skill-box">Q <div id="cd-q" class="cd-overlay"></div></div>
             <div id="skill-e" class="skill-box">E <div id="cd-e" class="cd-overlay"></div></div>
          </div>
          <div id="hud-combo-container" class="combo-container hidden">
             <div id="hud-combo-count" class="combo-count">x0</div>
          </div>
          <div id="hud-quest-container" class="quest-container hidden">
             <div id="hud-quest-text" class="quest-text">ЗАДАНИЕ: УБИТЬ 10 ВРАГОВ</div>
          </div>
          <div class="xp-bar-wrap">
            <div id="hud-xp-bar" class="xp-bar-fill"></div>
            <span id="hud-xp-text" style="position:absolute; width:100%; text-align:center; font-size:10px; top:-2px; color:#000; font-weight:bold; pointer-events:none;">XP</span>
          </div>
          
          <!-- In-Game Upgrade UI (No Pause) -->
          <div id="ingame-upgrades" class="ingame-upgrades hidden">
             <div class="upgrade-header">
                <span class="blink">СИСТЕМА ГОТОВА</span>
                <span id="pending-count" class="pending-count"></span>
             </div>
             <div id="ingame-cards" class="ingame-cards"></div>
          </div>
        </div>

