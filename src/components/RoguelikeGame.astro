---
---
<div id="app-window" class="app-window">
  <div class="window-header">
    <div class="window-controls">
      <button id="win-close" class="win-btn close" title="Close"></button>
      <button id="win-maximize" class="win-btn maximize" title="Fullscreen"></button>
    </div>
    <div class="window-title">NEON_PROTOCOL_RUS_V2.1.exe</div>
  </div>
  
  <div id="game-container" class="game-container">
    <canvas id="game-canvas" width="1040" height="720"></canvas>

    <!-- UI Layer -->
    <div id="ui-layer" class="ui-layer">
      
      <!-- Main Menu -->
      <div id="menu-screen" class="screen active">
        <h1 class="title glitch" data-text="НЕОНОВЫЙ ПРОТОКОЛ">НЕОНОВЫЙ ПРОТОКОЛ</h1>
        <div class="meta-stats">
          <div class="stat-box">
            <span class="label">РЕКОРД</span>
            <span id="menu-best-score" class="value">0</span>
          </div>
          <div class="stat-box">
            <span class="label">ОСКОЛКИ</span>
            <span id="menu-currency" class="value text-purple">0</span>
          </div>
          <div class="stat-box">
            <span class="label">ЯДРА</span>
            <span id="menu-boss-currency" class="value text-gold">0</span>
          </div>
        </div>
        
        <!-- Main Menu Buttons -->
        <div class="menu-buttons-row">
            <button id="btn-open-core" class="btn-secondary">СИСТЕМНОЕ ЯДРО</button>
            <button id="btn-tree" class="btn-secondary">НЕЙРОСЕТЬ</button>
            <button id="btn-inventory" class="btn-secondary text-gold">ИНВЕНТАРЬ [NEW]</button>
            <button id="btn-raids" class="btn-secondary text-red">РЕЙДЫ [BOSS]</button>
            <button id="btn-leaderboard" class="btn-secondary text-purple">РЕЙТИНГ</button>
        </div>

        <div class="menu-columns">
          <!-- Basic Shop -->
          <!-- Removed from here, moved to separate screens -->
        </div>

        <button id="btn-start" class="btn-primary">НАЧАТЬ ПРОТОКОЛ</button>
      </div>

      <!-- Core Shop Screen -->
      <div id="core-screen" class="screen hidden">
          <h2>СИСТЕМНОЕ ЯДРО</h2>
          <div class="meta-stats">
            <span>ОСКОЛКИ: <span id="core-currency" class="text-purple">0</span></span>
          </div>
          <div class="upgrades-shop">
            <div class="shop-scroll">
              <!-- Shop Items -->
              <div class="upgrade-row"><div class="upg-info"><span class="upg-name">ЦЕЛОСТНОСТЬ (HP)</span><span id="lvl-hp" class="upg-lvl">Lvl 0</span></div><button id="btn-upg-hp" class="btn-small">УЛУЧШИТЬ</button></div>
              <div class="upgrade-row"><div class="upg-info"><span class="upg-name">ПЛАЗМА (УРОН)</span><span id="lvl-dmg" class="upg-lvl">Lvl 0</span></div><button id="btn-upg-dmg" class="btn-small">УЛУЧШИТЬ</button></div>
              <div class="upgrade-row"><div class="upg-info"><span class="upg-name">ДВИГАТЕЛИ (СКОР.)</span><span id="lvl-spd" class="upg-lvl">Lvl 0</span></div><button id="btn-upg-spd" class="btn-small">УЛУЧШИТЬ</button></div>
              <div class="upgrade-row"><div class="upg-info"><span class="upg-name">ЦИКЛЕР (СКОР.СТР.)</span><span id="lvl-rate" class="upg-lvl">Lvl 0</span></div><button id="btn-upg-rate" class="btn-small">УЛУЧШИТЬ</button></div>
              <div class="upgrade-row"><div class="upg-info"><span class="upg-name">МАГНИТНОЕ ПОЛЕ</span><span id="lvl-mag" class="upg-lvl">Lvl 0</span></div><button id="btn-upg-mag" class="btn-small">УЛУЧШИТЬ</button></div>
              <div class="upgrade-row"><div class="upg-info"><span class="upg-name">ЭНТРОПИЯ (УДАЧА)</span><span id="lvl-luck" class="upg-lvl">Lvl 0</span></div><button id="btn-upg-luck" class="btn-small">УЛУЧШИТЬ</button></div>
              <div class="upgrade-row"><div class="upg-info"><span class="upg-name">ИМПУЛЬС (ОТТАЛК.)</span><span id="lvl-knock" class="upg-lvl">Lvl 0</span></div><button id="btn-upg-knock" class="btn-small">УЛУЧШИТЬ</button></div>
            </div>
          </div>
          <button id="btn-core-back" class="btn-secondary">НАЗАД</button>
      </div>

      <!-- Inventory Screen (RPG) -->
      <div id="inventory-screen" class="screen hidden">
        <h2>ЭКИПИРОВКА</h2>
        <div class="inv-layout">
            <div class="char-slots">
                <div class="slot-label">ОРУЖИЕ</div>
                <div id="slot-weapon" class="equip-slot" data-type="weapon">ПУСТО</div>
                <div class="slot-label">БРОНЯ</div>
                <div id="slot-armor" class="equip-slot" data-type="armor">ПУСТО</div>
                <div class="slot-label">ЧИП</div>
                <div id="slot-chip" class="equip-slot" data-type="chip">ПУСТО</div>
            </div>
            <div class="inv-grid-container">
                <h3>ХРАНИЛИЩЕ ДАННЫХ</h3>
                <div id="inv-grid" class="inv-grid"></div>
            </div>
        </div>
        <button id="btn-inv-back" class="btn-secondary">НАЗАД</button>
      </div>

      <!-- Raid Selection Screen -->
      <div id="raid-screen" class="screen hidden">
        <h2>ДОСТУПНЫЕ МИССИИ</h2>
        <div id="raid-list" class="raid-list"></div>
        <button id="btn-raid-back" class="btn-secondary">НАЗАД</button>
      </div>

      <!-- Victory Screen -->
      <div id="victory-screen" class="screen hidden">
        <h1 class="text-gold">МИССИЯ ВЫПОЛНЕНА</h1>
        <div class="final-stats">
          <p>ЦЕЛЬ УНИЧТОЖЕНА</p>
          <p>НАГРАДА: <span id="vic-reward" class="text-gold"></span></p>
        </div>
        <button id="btn-vic-menu" class="btn-secondary">В ГЛАВНОЕ МЕНЮ</button>
      </div>

      <!-- Leaderboard Screen -->
      <div id="leaderboard-screen" class="screen hidden">
        <h2>ГЛОБАЛЬНЫЙ РЕЙТИНГ</h2>
        <div class="lb-columns">
          <div class="lb-col">
            <h3 class="text-gold">ТОП ЗА ДЕНЬ</h3>
            <div id="lb-daily" class="lb-list">Загрузка...</div>
          </div>
          <div class="lb-col">
            <h3 class="text-purple">ТОП НЕДЕЛИ</h3>
            <div id="lb-weekly" class="lb-list">Загрузка...</div>
          </div>
        </div>
        <button id="btn-lb-back" class="btn-secondary">НАЗАД</button>
      </div>

      <!-- Difficulty Selection -->
      <div id="difficulty-screen" class="screen hidden">
        <h2>ВЫБЕРИТЕ УРОВЕНЬ УГРОЗЫ</h2>
        <div class="diff-grid">
          <!-- Buttons injected via JS -->
        </div>
        <div class="diff-info" id="diff-desc">
          МНОЖИТЕЛЬ НАГРАД: x1
        </div>
        <button id="btn-diff-back" class="btn-secondary">НАЗАД</button>
      </div>

      <!-- Skill Tree Screen -->
      <div id="tree-screen" class="screen hidden">
        <div class="tree-header">
          <h2>НЕЙРОСЕТЬ</h2>
          <div class="tree-stats">
            <span>ЯДРА: <span id="tree-currency" class="text-gold">0</span></span>
            <button id="btn-tree-back" class="btn-small">НАЗАД</button>
          </div>
        </div>
        <div id="tree-canvas-container" class="tree-container">
          <canvas id="tree-canvas"></canvas>
          <div id="tree-tooltip" class="tree-tooltip hidden"></div>
        </div>
        <div class="tree-controls-hint">ТЯНИ ЧТОБЫ ДВИГАТЬ • КЛИК ЧТОБЫ ИЗУЧИТЬ</div>
      </div>

      <!-- HUD -->
      <div id="hud-screen" class="screen hidden">
        <!-- Top Right: Wave & Level -->
        <div class="hud-top-right">
          <div class="wave-display" style="color: #ff3333; text-shadow: 0 0 10px #f00;">ВОЛНА <span id="hud-wave">1</span></div>
          <div class="level-display">УР. <span id="hud-level">1</span></div>
        </div>
        
        <!-- Bottom Center: HP & XP -->
        <div class="hud-bottom-center">
          <div class="hp-bar-wrap">
            <div id="hud-hp-bar" class="hp-bar-fill"></div>
            <span id="hud-hp-text">100/100</span>
          </div>
          <div class="xp-bar-wrap">
            <div id="hud-xp-bar" class="xp-bar-fill"></div>
          </div>
          
          <!-- In-Game Upgrade UI (No Pause) -->
          <div id="ingame-upgrades" class="ingame-upgrades hidden">
             <div class="upgrade-header">
                <span class="blink">СИСТЕМА ГОТОВА</span>
                <span id="pending-count" class="pending-count"></span>
             </div>
             <div id="ingame-cards" class="ingame-cards"></div>
          </div>
        </div>

        <!-- Bottom Left: Score -->
        <div class="hud-bottom-left">
          <div class="score-display">СЧЕТ: <span id="hud-score">0</span></div>
        </div>

        <!-- Fake MMO Chat -->
        <div class="hud-chat">
            <div id="chat-log" class="chat-log">
            </div>
        </div>
      </div>

      <!-- Observer UI -->
      <div id="observer-ui" class="observer-ui hidden">
        <div id="obs-face" class="obs-face">😐</div>
        <div class="obs-info">
          <div id="obs-mood" class="obs-mood">НЕЙТРАЛЬНЫЙ</div>
          <div id="obs-influence" class="obs-influence">ВЛИЯНИЕ: 0</div>
        </div>
      </div>

      <!-- Game Over -->
      <div id="gameover-screen" class="screen hidden">
        <h1 class="red-glow">КРИТИЧЕСКИЙ СБОЙ</h1>
        <div class="final-stats">
          <p>СЧЕТ: <span id="go-score">0</span></p>
          <p>СОБРАНО ОСКОЛКОВ: <span id="go-currency" class="text-purple">0</span></p>
          <p>СОБРАНО ЯДЕР: <span id="go-cores" class="text-gold">0</span></p>
        </div>
        <button id="btn-restart" class="btn-primary">ПЕРЕЗАГРУЗКА</button>
        
        <!-- High Score Input -->
        <div id="highscore-input" class="highscore-input hidden">
            <p class="text-gold blink">НОВЫЙ РЕКОРД!</p>
            <input type="text" id="player-name-input" placeholder="NAME (A-Z)" maxlength="6" />
            <button id="btn-submit-score" class="btn-small">СОХРАНИТЬ</button>
        </div>

        <button id="btn-menu" class="btn-secondary">В ГЛАВНОЕ МЕНЮ</button>
      </div>

    </div>
  </div>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&display=swap');

  /* Window Container */
  .app-window {
    position: relative;
    width: 100%;
    aspect-ratio: 1040 / 720;
    margin: 20px auto;
    max-width: 1040px;
    background: #050505;
    border: 2px solid #0ff;
    border-radius: 12px;
    box-shadow: 0 0 40px rgba(0, 255, 255, 0.15);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    z-index: 10;
    font-family: 'Orbitron', sans-serif;
  }

  /* Fullscreen Fixes */
  :global(:fullscreen) #app-window {
    width: 100vw !important;
    height: 100vh !important;
    max-width: none !important;
    margin: 0 !important;
    border: none;
    border-radius: 0;
  }
  :global(:fullscreen) canvas {
    width: 100%;
    height: 100%;
    object-fit: contain; /* Preserves aspect ratio */
  }

  .window-header {
    height: 36px;
    background: #111;
    border-bottom: 1px solid #333;
    display: flex;
    align-items: center;
    padding: 0 15px;
    justify-content: space-between;
    flex-shrink: 0;
  }

  .window-controls { display: flex; gap: 8px; }
  .win-btn {
    width: 14px; height: 14px;
    border-radius: 50%;
    border: none;
    cursor: pointer;
    transition: transform 0.1s;
    z-index: 100;
    pointer-events: auto;
  }
  .win-btn:hover { transform: scale(1.1); }
  .win-btn.close { background: #ff5f56; }
  .win-btn.maximize { background: #27c93f; }

  .window-title {
    color: #666;
    font-size: 12px;
    letter-spacing: 2px;
    font-weight: bold;
  }

  .game-container {
    position: relative;
    width: 100%;
    height: 100%;
    background: #000;
    overflow: hidden;
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ui-layer {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    pointer-events: none;
  }

  .screen {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background: rgba(0,0,0,0.85);
    backdrop-filter: blur(5px);
    transition: opacity 0.3s;
    pointer-events: auto;
  }

  .screen.hidden { opacity: 0; pointer-events: none; }
  .screen.active { opacity: 1; }

  /* Typography & Colors */
  .text-purple { color: #a020f0; text-shadow: 0 0 10px #a020f0; }
  .text-gold { color: #ffd700; text-shadow: 0 0 10px #ffd700; }
  .red-glow { color: #ff3333; text-shadow: 0 0 20px #ff0000; }
  .text-red { color: #ff3333; text-shadow: 0 0 10px #f00; }
  
  h1.title {
    font-size: 5rem;
    color: #fff;
    text-shadow: 0 0 10px #0ff, 0 0 20px #0ff;
    margin-bottom: 2rem;
    letter-spacing: 5px;
  }

  /* Buttons */
  button {
    font-family: 'Orbitron', sans-serif;
    border: none;
    cursor: pointer;
    transition: all 0.2s;
    text-transform: uppercase;
    font-weight: bold;
  }

  .btn-primary {
    padding: 15px 40px;
    font-size: 1.5rem;
    background: transparent;
    border: 2px solid #0ff;
    color: #0ff;
    box-shadow: 0 0 10px rgba(0, 255, 255, 0.2);
  }
  .btn-primary:hover {
    background: #0ff;
    color: #000;
    box-shadow: 0 0 30px rgba(0, 255, 255, 0.6);
    transform: scale(1.05);
  }

  .btn-secondary {
    margin-top: 10px;
    padding: 10px 30px;
    background: transparent;
    border: 1px solid #666;
    color: #888;
  }
  .btn-secondary:hover { border-color: #fff; color: #fff; }
  .btn-secondary.full-width { width: 100%; margin-top: 15px; border-color: #ffd700; color: #ffd700; }
  .btn-secondary.full-width:hover { background: #ffd700; color: #000; }

  .btn-small {
    padding: 5px 15px;
    font-size: 0.8rem;
    background: #222;
    color: #fff;
    border: 1px solid #444;
  }
  .btn-small:hover { border-color: #0f0; color: #0f0; }

  /* Menu Stats */
  .meta-stats { display: flex; gap: 40px; margin-bottom: 30px; }
  .stat-box { display: flex; flex-direction: column; align-items: center; }
  .stat-box .label { font-size: 0.8rem; color: #666; }
  .stat-box .value { font-size: 2rem; font-weight: 900; }

  .menu-columns { display: flex; gap: 20px; }
  .menu-buttons-row { display: flex; gap: 20px; margin-bottom: 20px; }
  .menu-buttons-row button { min-width: 200px; }
  
  /* Inventory Styles */
  .inv-layout { display: flex; gap: 40px; margin-bottom: 20px; }
  .char-slots { display: flex; flex-direction: column; gap: 10px; width: 200px; }
  .equip-slot { 
    width: 100%; height: 80px; border: 2px dashed #444; 
    display: flex; align-items: center; justify-content: center;
    font-size: 0.8rem; color: #666; cursor: pointer;
    background: rgba(0,0,0,0.5); text-align: center; padding: 5px;
  }
  .equip-slot.filled { border-style: solid; border-color: #ffd700; color: #fff; background: rgba(255, 215, 0, 0.1); }
  .slot-label { font-size: 0.7rem; color: #888; margin-bottom: -5px; }
  
  .inv-grid-container { width: 400px; }
  .inv-grid { 
    display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; 
    max-height: 300px; overflow-y: auto;
  }
  .inv-item {
    width: 70px; height: 70px; border: 1px solid #333; background: #111;
    display: flex; flex-direction: column; align-items: center; justify-content: center;
    font-size: 0.6rem; cursor: pointer; position: relative;
  }
  .inv-item:hover { border-color: #fff; }
  .inv-item.rarity-common { border-color: #fff; }
  .inv-item.rarity-rare { border-color: #00f; box-shadow: inset 0 0 10px #00f; }
  .inv-item.rarity-epic { border-color: #a020f0; box-shadow: inset 0 0 10px #a020f0; }
  .inv-item.rarity-legendary { border-color: #ffd700; box-shadow: inset 0 0 10px #ffd700; animation: glow 2s infinite; }
  
  /* Chat Styles */
  .hud-chat {
    position: absolute; bottom: 100px; left: 10px;
    width: 300px; height: 150px;
    pointer-events: none; overflow: hidden;
    display: flex; flex-direction: column; justify-content: flex-end;
  }
  .chat-log { display: flex; flex-direction: column; gap: 5px; }
  :global(.chat-msg) { font-size: 12px; color: rgba(255,255,255,0.7); text-shadow: 1px 1px 0 #000; }
  :global(.chat-msg .name) { font-weight: bold; color: #0ff; }
  :global(.chat-msg.system) { color: #ffd700; font-style: italic; }

  /* Raid Styles */
  .raid-list { display: flex; flex-direction: column; gap: 15px; max-height: 400px; overflow-y: auto; width: 600px; }
  :global(.raid-card) {
    background: rgba(20, 0, 0, 0.8); border: 1px solid #500; padding: 15px;
    display: flex; justify-content: space-between; align-items: center;
    cursor: pointer; transition: all 0.2s;
  }
  :global(.raid-card:hover) { background: rgba(50, 0, 0, 0.9); border-color: #f00; transform: scale(1.02); }
  :global(.raid-info h3) { margin: 0 0 5px 0; color: #f00; }
  :global(.raid-info p) { margin: 0; font-size: 0.8rem; color: #aaa; }
  :global(.raid-reward) { text-align: right; }
  :global(.raid-reward .val) { color: #ffd700; font-weight: bold; }
  :global(.raid-card.locked) { opacity: 0.5; filter: grayscale(1); cursor: not-allowed; }
  :global(.raid-card.locked:hover) { transform: none; border-color: #500; }

  /* Leaderboard Styles */
  .lb-columns { display: flex; gap: 40px; margin-bottom: 20px; width: 800px; justify-content: center; }
  .lb-col { flex: 1; background: rgba(255,255,255,0.05); padding: 20px; border-radius: 8px; }
  .lb-list { display: flex; flex-direction: column; gap: 10px; min-height: 200px; }
  :global(.lb-item) { display: flex; align-items: center; border-bottom: 1px solid #333; padding-bottom: 5px; font-size: 0.9rem; width: 100%; }
  :global(.lb-item .rank) { color: #666; width: 40px; flex-shrink: 0; }
  :global(.lb-item .name) { color: #fff; font-weight: bold; text-align: left; margin-right: auto; }
  :global(.lb-item .score) { color: #ffd700; margin-left: 10px; flex-shrink: 0; }
  :global(.lb-item.me) { background: rgba(0, 255, 255, 0.1); }

  .upgrades-shop {
    background: rgba(255,255,255,0.05);
    padding: 20px;
    border-radius: 8px;
    margin-bottom: 30px;
    width: 350px;
    max-height: 350px;
    display: flex;
    flex-direction: column;
  }
  
  .tree-access {
    background: rgba(255, 215, 0, 0.05);
    padding: 20px;
    border-radius: 8px;
    margin-bottom: 30px;
    width: 300px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    border: 1px solid rgba(255, 215, 0, 0.2);
  }
  .desc-text { font-size: 0.8rem; color: #aaa; margin-bottom: 10px; line-height: 1.4; }

  .shop-scroll {
    overflow-y: auto;
    padding-right: 10px;
    max-height: 300px;
  }
  .upgrade-row {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 15px;
    padding-bottom: 10px;
    border-bottom: 1px solid #333;
    color: #ccc;
  }
  .upg-info { display: flex; flex-direction: column; align-items: flex-start; }
  .upg-name { font-size: 0.9rem; color: #fff; }
  .upg-lvl { font-size: 0.7rem; color: #666; }
  
  /* Scrollbar */
  .shop-scroll::-webkit-scrollbar { width: 6px; }
  .shop-scroll::-webkit-scrollbar-thumb { background: #333; border-radius: 3px; }
  .shop-scroll::-webkit-scrollbar-thumb:hover { background: #0ff; }

  /* Difficulty Screen */
  .diff-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; margin-bottom: 30px; }
  :global(.diff-btn) {
    padding: 20px; background: #111; border: 2px solid #333; color: #666;
    font-family: 'Orbitron', sans-serif; font-size: 1.2rem; cursor: not-allowed;
    transition: all 0.2s;
  }
  :global(.diff-btn.unlocked) { border-color: #0ff; color: #0ff; cursor: pointer; }
  :global(.diff-btn.unlocked:hover) { background: #0ff; color: #000; transform: scale(1.1); }
  .diff-info { margin-bottom: 20px; color: #ffd700; font-size: 1.2rem; }

  /* Skill Tree UI */
  .tree-header {
    position: absolute; top: 20px; left: 20px; right: 20px;
    display: flex; justify-content: space-between; align-items: center;
    z-index: 10; pointer-events: none;
  }
  .tree-header h2 { margin: 0; color: #ffd700; text-shadow: 0 0 10px #b8860b; }
  .tree-stats { pointer-events: auto; display: flex; gap: 20px; align-items: center; background: rgba(0,0,0,0.8); padding: 10px; border-radius: 8px; border: 1px solid #333; }
  
  .tree-container {
    width: 100%; height: 100%;
    background: #080808;
    background-image: radial-gradient(#1a1a1a 1px, transparent 1px);
