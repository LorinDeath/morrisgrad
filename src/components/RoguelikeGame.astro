  ];

  // --- CORE UTILS ---
  class Vector {
    constructor(public x: number, public y: number) {}
    add(v: Vector) { return new Vector(this.x + v.x, this.y + v.y); }
    sub(v: Vector) { return new Vector(this.x - v.x, this.y - v.y); }
    mult(n: number) { return new Vector(this.x * n, this.y * n); }
    mag() { return Math.sqrt(this.x * this.x + this.y * this.y); }
    normalize() {
      const m = this.mag();
      return m === 0 ? new Vector(0, 0) : new Vector(this.x / m, this.y / m);
    }
  }

  // --- INPUTS ---
  // --- GLOBALS (Moved Top) ---
  const keys: { [key: string]: boolean } = {};
  const mouse = { pos: new Vector(0,0), down: false };

  // Initialize Global Listeners Once
  if (typeof window !== 'undefined' && !(window as any)._neon_inputs_init) {
    window.addEventListener('keydown', e => {
      // Don't capture keys if typing in an input (e.g. High Score)
      if ((e.target as HTMLElement).tagName === 'INPUT') return;

      keys[e.code] = true;
      // Prevent scrolling with game keys ONLY when playing
      if (gameInstance && gameInstance.state === 'PLAYING') {
        if(['ArrowUp','ArrowDown','ArrowLeft','ArrowRight', 'Space', 'KeyW', 'KeyA', 'KeyS', 'KeyD'].includes(e.code)) {
           e.preventDefault();
        }
      }
    });
    window.addEventListener('keyup', e => keys[e.code] = false);
    window.addEventListener('mouseup', () => mouse.down = false); // Catch mouse up outside canvas
    (window as any)._neon_inputs_init = true;
  }

  // --- META ---
  // --- META PROGRESSION ---
  const META_KEY = 'neon_protocol_save_v1';
  
  interface Item {
    id: string;
    name: string;
    desc?: string;
    type: 'weapon' | 'armor' | 'chip';
    rarity: 'common' | 'rare' | 'epic' | 'legendary';
    stats: { hp?: number, dmg?: number, spd?: number, crit?: number };
    icon: string;
  }

  interface MetaData {
    bestScore: number;
    currency: number;
    bossCurrency: number;
    upgrades: {
      startHp: number;
      baseDmg: number;
      moveSpeed: number;
      fireRate: number;
      magnet: number;
      luck: number;
      knockback: number;
    };
    skillTree: string[]; // IDs of unlocked nodes
    unlocks: string[]; // "sniper", "boss2", "skin_neon", etc.
    inventory: Item[];
    equipment: { weapon: Item | null, armor: Item | null, chip: Item | null };
    username: string;
  }
  
  let meta: MetaData = { 
    bestScore: 0, 
    currency: 0, 
    bossCurrency: 0,
    upgrades: { startHp: 0, baseDmg: 0, moveSpeed: 0, fireRate: 0, magnet: 0, luck: 0, knockback: 0 },
    skillTree: ['root'],
    unlocks: [],
    inventory: [],
    equipment: { weapon: null, armor: null, chip: null },
    username: `Player_${Math.floor(Math.random()*9999)}`
  };

  // Harder progression scaling
  const COST_BASE = {
    startHp: 100,
    baseDmg: 200,
    moveSpeed: 150,
    fireRate: 300,
    magnet: 50,
    luck: 500,
    knockback: 200
  };

  function getCost(type: keyof typeof COST_BASE, lvl: number) {
    return Math.floor(COST_BASE[type] * Math.pow(1.6, lvl)); // Steep curve
  }

  function loadMeta() {
    const raw = localStorage.getItem(META_KEY);
    if (raw) {
        const loaded = JSON.parse(raw);
        // Merge to ensure new fields exist
        meta = { 
          ...meta, 
          ...loaded, 
          upgrades: { ...meta.upgrades, ...(loaded.upgrades || {}) },
          skillTree: loaded.skillTree || ['root'],
          unlocks: loaded.unlocks || [],
          inventory: loaded.inventory || [],
          equipment: loaded.equipment || { weapon: null, armor: null, chip: null },
          username: loaded.username || meta.username
        };
    }
    updateMenuStats();
  }

  function saveMeta() {
    localStorage.setItem(META_KEY, JSON.stringify(meta));
    updateMenuStats();
  }

  function updateMenuStats() {
    const elScore = document.getElementById('menu-best-score');
    const elCurr = document.getElementById('menu-currency');
    const elBoss = document.getElementById('menu-boss-currency');
    const elTreeCurr = document.getElementById('tree-currency');
    const elCoreCurr = document.getElementById('core-currency');
    
    if(elScore) elScore.innerText = meta.bestScore.toString();
    if(elCurr) elCurr.innerText = meta.currency.toString();
    if(elBoss) elBoss.innerText = meta.bossCurrency.toString();
    if(elTreeCurr) elTreeCurr.innerText = meta.bossCurrency.toString();
    if(elCoreCurr) elCoreCurr.innerText = meta.currency.toString();

    // Update Shop Buttons
    const types = ['hp', 'dmg', 'spd', 'rate', 'mag', 'luck', 'knock'];
    const keys = ['startHp', 'baseDmg', 'moveSpeed', 'fireRate', 'magnet', 'luck', 'knockback'];
    
    types.forEach((t, i) => {
        const key = keys[i] as keyof typeof meta.upgrades;
        const lvl = meta.upgrades[key];
        const cost = getCost(key as any, lvl);
        const btn = document.getElementById(`btn-upg-${t}`);
        const lbl = document.getElementById(`lvl-${t}`);
        
        if (lbl) lbl.innerText = `Lvl ${lvl}`;
        if (btn) {
            btn.innerText = `УЛУЧШИТЬ (${cost})`;
            if (meta.currency < cost) {
                btn.style.opacity = '0.5';
                btn.style.cursor = 'not-allowed';
            } else {
                btn.style.opacity = '1';
                btn.style.cursor = 'pointer';
            }
        }
    });
  }

