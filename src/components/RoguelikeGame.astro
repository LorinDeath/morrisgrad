  ];

  // --- CORE UTILS ---
  class Vector {
    constructor(public x: number, public y: number) {}
    add(v: Vector) { return new Vector(this.x + v.x, this.y + v.y); }
    sub(v: Vector) { return new Vector(this.x - v.x, this.y - v.y); }
    mult(n: number) { return new Vector(this.x * n, this.y * n); }
    mag() { return Math.sqrt(this.x * this.x + this.y * this.y); }
    dot(v: Vector) { return this.x * v.x + this.y * v.y; }
    normalize() {
      const m = this.mag();
      return m === 0 ? new Vector(0, 0) : new Vector(this.x / m, this.y / m);
    }
  }

  // --- INPUTS ---
  // --- GLOBALS (Moved Top) ---
  const keys: { [key: string]: boolean } = {};
  const mouse = { pos: new Vector(0,0), down: false };

  // Initialize Global Listeners Once
  if (typeof window !== 'undefined' && !(window as any)._neon_inputs_init) {
    window.addEventListener('keydown', e => {
      // Don't capture keys if typing in an input (e.g. High Score)
      if ((e.target as HTMLElement).tagName === 'INPUT') return;

      keys[e.code] = true;
      // Prevent scrolling with game keys ONLY when playing
      if (gameInstance && gameInstance.state === 'PLAYING') {
        if(['ArrowUp','ArrowDown','ArrowLeft','ArrowRight', 'Space', 'KeyW', 'KeyA', 'KeyS', 'KeyD'].includes(e.code)) {
           e.preventDefault();
        }
        if (gameInstance.activeUpgradeChoices.length > 0) {
            if (e.code === 'Digit1') gameInstance.selectUpgrade(0);
            if (e.code === 'Digit2') gameInstance.selectUpgrade(1);
            if (e.code === 'Digit3') gameInstance.selectUpgrade(2);
        }
      }
    });
    window.addEventListener('keyup', e => keys[e.code] = false);
    window.addEventListener('mouseup', () => mouse.down = false); // Catch mouse up outside canvas
    (window as any)._neon_inputs_init = true;
  }

  // --- META ---
  // --- META PROGRESSION ---
  const META_KEY = 'neon_protocol_save_v1';
  
  interface Item {
    id: string;
    name: string;
    desc?: string;
    type: 'weapon' | 'armor' | 'chip';
    rarity: 'common' | 'rare' | 'epic' | 'legendary' | 'mythic' | 'divine';
    stats: { [key: string]: number };
    icon: string;
    level?: number;
    modified?: boolean;
    setId?: string;
    setStats?: { [key: string]: number };
    source?: string;
    isCorrupted?: boolean;
  }

  interface MetaData {
    bestScore: number;
    currency: number;
    bossCurrency: number;
    upgrades: {
      startHp: number;
      baseDmg: number;
      moveSpeed: number;
      fireRate: number;
      magnet: number;
      luck: number;
      knockback: number;
    };
    skillTree: string[]; // IDs of unlocked nodes
    unlocks: string[]; // "sniper", "boss2", "skin_neon", etc.
    inventory: Item[];
    equipment: { weapon: Item | null, armor: Item | null, chip: Item | null };
    username: string;
  }
  
  let meta: MetaData = { 
    bestScore: 0, 
    currency: 0, 
    bossCurrency: 0,
    upgrades: { startHp: 0, baseDmg: 0, moveSpeed: 0, fireRate: 0, magnet: 0, luck: 0, knockback: 0 },
    skillTree: ['root'],
    unlocks: [],
    inventory: [],
    equipment: { weapon: null, armor: null, chip: null },
    username: `Player_${Math.floor(Math.random()*9999)}`
  };

  // Harder progression scaling
  const COST_BASE = {
    startHp: 100,
    baseDmg: 200,
    moveSpeed: 150,
    fireRate: 300,
    magnet: 50,
    luck: 500,
    knockback: 200
  };

  function getCost(type: keyof typeof COST_BASE, lvl: number) {
    return Math.floor(COST_BASE[type] * Math.pow(1.6, lvl)); // Steep curve
  }

  // Helper to round stats
  function roundStat(key: string, val: number): number {
      // Percentage stats need more precision (e.g. 0.05 is 5%)
      // We want 2 decimal places for the displayed percentage (0.0543 -> 5.43% -> 0.0543)
      // So we round to 4 decimal places for raw value.
      if (['crit', 'cooldown', 'area', 'lifesteal', 'curse', 'slow', 'frag', 'projSpeed', 'dodge'].includes(key)) {
          return Math.floor(val * 10000) / 10000;
      }
      return Math.floor(val * 100) / 100;
  }

  function sanitizeItem(item: Item | null): Item | null {
      if (!item) return null;
      if (!item.stats) item.stats = {};
      if (!item.setStats) item.setStats = {};
      if (!item.setId) item.setId = undefined;
      return item;
  }

  function loadMeta() {
    const raw = localStorage.getItem(META_KEY);
    if (raw) {
        const loaded = JSON.parse(raw);
        // Merge to ensure new fields exist
        meta = { 
          ...meta, 
          ...loaded, 
          upgrades: { ...meta.upgrades, ...(loaded.upgrades || {}) },
          skillTree: loaded.skillTree || ['root'],
          unlocks: loaded.unlocks || [],
          inventory: loaded.inventory || [],
          equipment: loaded.equipment || { weapon: null, armor: null, chip: null },
          username: loaded.username || meta.username
        };
        
        // Sanitize Items to prevent crashes
        meta.inventory = meta.inventory.map(i => sanitizeItem(i)!);
        meta.equipment.weapon = sanitizeItem(meta.equipment.weapon);
        meta.equipment.armor = sanitizeItem(meta.equipment.armor);
        meta.equipment.chip = sanitizeItem(meta.equipment.chip);

        // Migration: Fix Multishot ID shift
        if (meta.skillTree.includes('node_0_18') && !meta.skillTree.includes('tree_multishot_1')) {
            meta.skillTree = meta.skillTree.filter(id => id !== 'node_0_18');
            meta.skillTree.push('tree_multishot_1');
        }
    }
    updateMenuStats();
  }

  function saveMeta() {
    localStorage.setItem(META_KEY, JSON.stringify(meta));
    updateMenuStats();
  }

  function updateMenuStats() {
    const elScore = document.getElementById('menu-best-score');
