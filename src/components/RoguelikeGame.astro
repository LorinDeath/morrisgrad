  // Deterministic Tree Layout
  function buildTree() {
      TREE_NODES.length = 0; // Clear
      TREE_NODES.push({ id: 'root', x: 0, y: 0, name: 'ЯДРО', desc: 'Начало.', cost: 0, parents: [], effect: () => {}, type: 'mechanic' });

      const branchCount = 5;
      
      for (let b = 0; b < branchCount; b++) {
          const defs = BRANCH_DEFS[b];
          if (!defs) continue;

          let parentId = 'root';
          // Spread 5 branches evenly starting from -90deg (Up)
          const baseAngle = (b * (Math.PI * 2) / branchCount) - (Math.PI / 2);
          
          defs.forEach((def, i) => {
              const id = def.id || `node_${b}_${i}`;
              const dist = 90; // Increased distance for better spacing
              
              // Organic Zig-Zag Wiggle
              const wiggle = (i % 2 === 0 ? 0.3 : -0.3);
              const nodeAngle = baseAngle + wiggle;
              
              const pNode = TREE_NODES.find(n => n.id === parentId)!;
              const x = pNode.x + Math.cos(nodeAngle) * dist;
              const y = pNode.y + Math.sin(nodeAngle) * dist;
              
              TREE_NODES.push({
                  id, x, y,
                  name: def.name, desc: def.desc, cost: def.cost,
                  parents: [parentId],
                  effect: def.effect,
                  type: def.type
              });
              
              parentId = id;
          });
          
          // --- SIDE BRANCHES (4 per branch = 20 total) ---
          const sideStats = [
              { name: 'АТОМ', desc: '+3 Урона', effect: (p:Player) => p.damage += 3 }, // Branch 0 (Attack)
              { name: 'ПЛАСТИНА', desc: '+15 HP', effect: (p:Player) => p.maxHp += 15 }, // Branch 1 (Defense)
              { name: 'ДАННЫЕ', desc: '+5% XP', effect: (p:Player) => p.xpMult += 0.05 }, // Branch 2 (Xenology)
              { name: 'УДАЧА', desc: '+1 Удачa', effect: (p:Player) => p.luck += 1 }, // Branch 3 (Threat)
              { name: 'СМАЗКА', desc: '-2% Кулдаун', effect: (p:Player) => p.cooldownMult *= 0.98 } // Branch 4 (Arsenal)
          ];
          
          const mainNodes = TREE_NODES.filter(n => n.id.startsWith(`node_${b}_`));
          const stat = sideStats[b];
          
          // Attach to every 2nd node starting from index 1
          for(let k=0; k<4; k++) {
              const parentIdx = 1 + k*2;
              if (parentIdx < mainNodes.length) {
                  const parent = mainNodes[parentIdx];
                  const sideAngle = baseAngle + (k % 2 === 0 ? 0.6 : -0.6); // Branch out
                  const dist = 60;
                  
                  TREE_NODES.push({
                      id: `side_${b}_${k}`,
                      x: parent.x + Math.cos(sideAngle) * dist,
                      y: parent.y + Math.sin(sideAngle) * dist,
                      name: `${stat.name} ${k+1}`, desc: stat.desc, cost: 10 * (k+1),
                      parents: [parent.id], effect: stat.effect, type: 'stat'
                  });
              }
          }
      }
  }
  
  buildTree();

  class SkillTreeRenderer {
    canvas: HTMLCanvasElement;
    ctx: CanvasRenderingContext2D;
    offsetX = 0; offsetY = 0;
    isDragging = false;
    lastMouse = {x:0, y:0};
    selectedNode: TreeNode | null = null;

    constructor() {
      this.canvas = document.getElementById('tree-canvas') as HTMLCanvasElement;
      this.ctx = this.canvas.getContext('2d')!;
      this.resize();
      
      // Center view
      this.offsetX = this.canvas.width / 2;
      this.offsetY = this.canvas.height / 2;

      // Events
      const container = document.getElementById('tree-canvas-container')!;
      container.addEventListener('mousedown', e => {
        // Ignore clicks inside tooltip to prevent deselection
        if ((e.target as HTMLElement).closest('#tree-tooltip')) return;

        this.isDragging = true;
        this.lastMouse = {x: e.clientX, y: e.clientY};
        this.selectedNode = null;
        
        // Check click on node
        const rect = this.canvas.getBoundingClientRect();
        const mx = e.clientX - rect.left - this.offsetX;
        const my = e.clientY - rect.top - this.offsetY;
        
        for(const n of TREE_NODES) {
          if (Math.hypot(n.x - mx, n.y - my) < 20) {
            this.selectedNode = n;
            this.isDragging = false; // Stop dragging if clicked node
            break;
          }
        }
        this.updateTooltip();
      });
      
      window.addEventListener('mouseup', () => this.isDragging = false);
      window.addEventListener('mousemove', e => {
        if (this.isDragging) {
          this.offsetX += e.clientX - this.lastMouse.x;
          this.offsetY += e.clientY - this.lastMouse.y;
          this.lastMouse = {x: e.clientX, y: e.clientY};
        }
        // Hide tooltip on drag
        if (this.isDragging) this.updateTooltip();
      });
    }

    resize() {
      const rect = this.canvas.parentElement!.getBoundingClientRect();
      this.canvas.width = rect.width;
      this.canvas.height = rect.height;
    }

    tryUnlock(node: TreeNode) {
      if (meta.skillTree.includes(node.id)) return; // Already unlocked
      
      // Check parents
      const hasParent = node.parents.some(pid => meta.skillTree.includes(pid));
      if (!hasParent) return; // Locked
      
      if (meta.bossCurrency >= node.cost) {
        meta.bossCurrency -= node.cost;
        meta.skillTree.push(node.id);
        
        // Execute unlock immediately so it saves to meta.unlocks
        if (node.type === 'unlock') {
            node.effect(null as any); 
        }
        
        saveMeta();
      }
    }

    updateTooltip() {
      const el = document.getElementById('tree-tooltip');
      if (!el) return;
      
      if (this.selectedNode && !this.isDragging) {
        const n = this.selectedNode;
        const unlocked = meta.skillTree.includes(n.id);
        const reachable = n.parents.some(pid => meta.skillTree.includes(pid));
        const canAfford = meta.bossCurrency >= n.cost;
        
        let actionBtn = '';
        if (unlocked) {
            actionBtn = '<button class="btn-small" disabled style="width:100%; color:#0f0; border-color:#0f0">ИЗУЧЕНО</button>';
        } else if (reachable) {
            if (canAfford) {
                actionBtn = `<button id="btn-unlock-node" class="btn-small" style="width:100%; background:#ffd700; color:#000; font-weight:bold">ИЗУЧИТЬ</button>`;
            } else {
                actionBtn = '<button class="btn-small" disabled style="width:100%; opacity:0.5">НЕДОСТАТОЧНО ЯДЕР</button>';
            }
        } else {
            actionBtn = '<button class="btn-small" disabled style="width:100%; opacity:0.5">НЕДОСТУПНО</button>';
        }

        el.innerHTML = `
          <h4>${n.name}</h4>
          <p>${n.desc}</p>
          <div class="cost">СТОИМОСТЬ: ${n.cost} ЯДЕР</div>
          <div style="margin-top:10px;">${actionBtn}</div>
        `;
        
        // Position relative to node (projected to screen)
        const screenX = n.x + this.offsetX;
        const screenY = n.y + this.offsetY;
        
        el.style.left = (screenX + 20) + 'px';
        el.style.top = screenY + 'px';
        el.classList.remove('hidden');
      } else {
        el.classList.add('hidden');
      }
    }

    draw() {
      this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);
      this.ctx.save();
      this.ctx.translate(this.offsetX, this.offsetY);

      // Draw Connections
      this.ctx.strokeStyle = '#333';
      this.ctx.lineWidth = 2;
      this.ctx.beginPath();
      TREE_NODES.forEach(n => {
        n.parents.forEach(pid => {
          const p = TREE_NODES.find(x => x.id === pid);
          if (p) {
            this.ctx.moveTo(p.x, p.y);
            this.ctx.lineTo(n.x, n.y);
          }
        });
      });
      this.ctx.stroke();

      // Draw Active Connections
      this.ctx.strokeStyle = '#ffd700';
      this.ctx.lineWidth = 2;
      this.ctx.beginPath();
      TREE_NODES.forEach(n => {
        if (meta.skillTree.includes(n.id)) {
          n.parents.forEach(pid => {
            if (meta.skillTree.includes(pid)) {
              const p = TREE_NODES.find(x => x.id === pid);
              if (p) {
                this.ctx.moveTo(p.x, p.y);
                this.ctx.lineTo(n.x, n.y);
              }
            }
          });
        }
      });
      this.ctx.stroke();

      // Draw Nodes
      TREE_NODES.forEach(n => {
        const unlocked = meta.skillTree.includes(n.id);
        const reachable = n.parents.some(pid => meta.skillTree.includes(pid));
        
        this.ctx.beginPath();
        const size = n.type === 'mechanic' || n.type === 'unlock' ? 12 : n.type === 'passive' ? 8 : 5;
        this.ctx.arc(n.x, n.y, this.selectedNode === n ? size + 3 : size, 0, Math.PI*2);
        
        if (unlocked) {
          this.ctx.fillStyle = '#ffd700';
          this.ctx.shadowBlur = 10; this.ctx.shadowColor = '#ffd700';
        } else if (reachable) {
          this.ctx.fillStyle = '#555';
          this.ctx.strokeStyle = '#ffd700';
          this.ctx.lineWidth = 1;
          this.ctx.stroke();
          this.ctx.shadowBlur = 0;
        } else {
          this.ctx.fillStyle = '#222';
          this.ctx.shadowBlur = 0;
        }
        
        if (n.type === 'unlock') {
             this.ctx.strokeStyle = '#a020f0';
             this.ctx.lineWidth = 2;
             this.ctx.stroke();
        }
        
        if (this.selectedNode === n) {
             this.ctx.strokeStyle = '#fff';
             this.ctx.lineWidth = 2;
             this.ctx.stroke();
        }
        
        this.ctx.fill();
        this.ctx.shadowBlur = 0;
      });

      this.ctx.restore();
      requestAnimationFrame(() => this.draw());
    }
  }

  // --- ENTITIES ---
  // --- GAME ENTITIES ---
  class Entity {
    dead = false;
    constructor(public pos: Vector, public radius: number, public color: string) {}
    update(dt: number) {}
    draw(ctx: CanvasRenderingContext2D) {}
  }
  
  class FloatingText {
    life = 0.8;
    vel = new Vector(0, -50);
    constructor(public pos: Vector, public text: string, public color: string) {}
    update(dt: number) {
        this.pos = this.pos.add(this.vel.mult(dt));
        this.life -= dt;
    }
    draw(ctx: CanvasRenderingContext2D) {
        ctx.globalAlpha = Math.max(0, this.life);
        ctx.fillStyle = this.color;
        ctx.font = 'bold 20px Orbitron';
        ctx.fillText(this.text, this.pos.x, this.pos.y);
        ctx.globalAlpha = 1.0;
    }
  }

  class Particle extends Entity {
    life = 1.0;
    age = 0;
    value = 1;
    lootData?: { setId: string, bonusCount: number }; // New field for specific loot
    constructor(pos: Vector, public vel: Vector, color: string, public size: number, public type: 'vfx' | 'xp' | 'core' | 'fake_hp' | 'fake_shield' | 'fake_xp' | 'loot' | 'merchant_signal' | 'rune' = 'vfx', value: number = 1) {
      super(pos, size, color);
      this.value = value;
    }
    update(dt: number) {
      if (this.type === 'xp' || this.type === 'core' || this.type === 'loot') {
          // Magnet logic
          const dir = game.player.pos.sub(this.pos);
          const dist = dir.mag();
          let range = 150 + (game.player.magnet * 50);
          if (this.type === 'core') range = 300; // Cores have bigger magnet
          if (this.type === 'loot') range = 400; // Loot has huge magnet
          
          if (dist < range) {
              this.vel = this.vel.add(dir.normalize().mult(1500 * dt));
          }
          this.vel = this.vel.mult(0.95); // Friction
      }
      
      this.pos = this.pos.add(this.vel.mult(dt));
      
      if (this.type === 'vfx') this.life -= dt * 2;
      // XP doesn't die by time, only by pickup
      if (this.life <= 0) this.dead = true;
      
      // Safety cleanup for uncollected items (60 seconds)
      this.age += dt;
      if (this.type !== 'vfx' && this.age > 60) this.dead = true;
    }
    draw(ctx: CanvasRenderingContext2D) {
      ctx.globalAlpha = this.life;
      ctx.fillStyle = this.color;
      if (this.type === 'core' || this.type === 'xp') {
        ctx.shadowBlur = 10; ctx.shadowColor = '#ffd700';
        ctx.beginPath(); ctx.moveTo(this.pos.x, this.pos.y-8); ctx.lineTo(this.pos.x+8, this.pos.y); ctx.lineTo(this.pos.x, this.pos.y+8); ctx.lineTo(this.pos.x-8, this.pos.y); ctx.fill();
        ctx.shadowBlur = 0;
        return;
      }
      if (this.type.startsWith('fake')) {
         ctx.font = '20px Arial';
         const icon = this.type === 'fake_hp' ? '♥' : this.type === 'fake_shield' ? '🛡️' : '💎';
         ctx.fillText(icon, this.pos.x - 10, this.pos.y + 5);
         return;
      }
      if (this.type === 'loot') {
         ctx.font = '20px Arial';
         ctx.shadowBlur = 10; ctx.shadowColor = '#fff';
         ctx.fillText('📦', this.pos.x - 10, this.pos.y + 5);
         return;
      }
      if (this.type === 'merchant_signal') {
         ctx.font = '24px Arial';
         ctx.shadowBlur = 15; ctx.shadowColor = '#0f0';
         ctx.fillText('💲', this.pos.x - 12, this.pos.y + 8);
         return;
      }
      if (this.type === 'rune') {
         ctx.font = '20px Arial';
         ctx.shadowBlur = 10; ctx.shadowColor = '#0ff';
         ctx.fillText('ᛟ', this.pos.x - 10, this.pos.y + 5);
         return;
      }
      ctx.beginPath(); ctx.arc(this.pos.x, this.pos.y, this.radius, 0, Math.PI*2); ctx.fill();
      ctx.globalAlpha = 1.0;
    }
  }

  // --- ENEMY STRUCTURES ---
  class EnemyStructure extends Entity {
      hp: number;
      maxHp: number;
      timer = 0;
      
      constructor(pos: Vector, public type: 'turret' | 'camp') {
          super(pos, 20, type === 'turret' ? '#f00' : '#a020f0');
          this.hp = type === 'turret' ? 200 : 300;
          this.maxHp = this.hp;
          // Scale HP with wave
          const scale = 1 + Math.pow(game.director.wave, 2.2) * 0.02;
          this.hp *= scale * selectedDifficulty;
          this.maxHp *= scale;
      }

      update(dt: number) {
          this.timer -= dt;
          if (this.type === 'turret') {
              if (this.timer <= 0) {
                  this.timer = 2.0;
                  const dir = game.player.pos.sub(this.pos).normalize();
                  const scale = 1 + Math.pow(game.director.wave, 2.2) * 0.02;
                  const dmg = 15 * scale * selectedDifficulty;
                  game.projectiles.push(new Projectile(this.pos, dir.mult(400), dmg, 'bullet', 'enemy'));
              }
          } else if (this.type === 'camp') {
              if (this.timer <= 0) {
                  this.timer = 3.0;
                  
                  // 1% Chance for Boss
                  if (Math.random() < 0.01) {
                      const bosses = ['boss1', 'boss2', 'boss3', 'boss4', 'boss5', 'boss6', 'boss7'];
                      const bossId = bosses[Math.floor(Math.random() * bosses.length)];
                      game.spawnEnemy(bossId, false, this.pos, '#ff0000', 3.0);
                      game.texts.push(new FloatingText(this.pos, "АНОМАЛИЯ В ЛАГЕРЕ!", "#f00"));
                  } else {
                      // Spawn critter
                      const critter = new Enemy(this.pos.add(new Vector(Math.random()*20-10, Math.random()*20-10)), 'critter', game.director.wave, false);
                      game.enemies.push(critter);
                  }
              }
          }
      }

      draw(ctx: CanvasRenderingContext2D) {
          ctx.fillStyle = this.color;
          if (this.type === 'turret') {
              ctx.fillRect(this.pos.x-15, this.pos.y-15, 30, 30);
              // Gun barrel
              const dir = game.player.pos.sub(this.pos).normalize();
              ctx.beginPath(); ctx.moveTo(this.pos.x, this.pos.y); 
              ctx.lineTo(this.pos.x + dir.x*25, this.pos.y + dir.y*25);
              ctx.lineWidth = 4; ctx.strokeStyle = '#500'; ctx.stroke();
          } else {
              // Camp (Triangle/Tent)
              ctx.beginPath();
              ctx.moveTo(this.pos.x, this.pos.y - 20);
              ctx.lineTo(this.pos.x + 20, this.pos.y + 20);
              ctx.lineTo(this.pos.x - 20, this.pos.y + 20);
              ctx.fill();
          }
          // HP Bar
          const pct = Math.max(0, Math.min(1, this.hp / this.maxHp));
          ctx.fillStyle = '#333'; ctx.fillRect(this.pos.x-15, this.pos.y-25, 30, 4);
          ctx.fillStyle = '#f00'; ctx.fillRect(this.pos.x-15, this.pos.y-25, 30*pct, 4);
      }
  }

  // --- PROJECTILES ---
  class Projectile extends Entity {
    homing = false;
    bounces = 0;
    constructor(pos: Vector, public vel: Vector, public dmg: number, public type: 'bullet'|'rocket'|'laser' = 'bullet', public team: 'player'|'enemy'|'invader' = 'player', public owner?: Entity) {
      super(pos, type === 'rocket' ? 8 : 4, team === 'player' ? '#0ff' : '#f00');
    }
    update(dt: number) {
      this.pos = this.pos.add(this.vel.mult(dt));
      // Bounds check (despawn if too far)
      if (this.pos.x < -100 || this.pos.x > CANVAS_W + 100 || this.pos.y < -100 || this.pos.y > CANVAS_H + 100) this.dead = true;
      
      // Weather: Wind
      if (game.director.weather === 'wind') this.pos.x += 100 * dt; // Reduced wind effect on projectiles
    }
    draw(ctx: CanvasRenderingContext2D) {
      ctx.fillStyle = this.color;
      if (this.type === 'rocket') {
         ctx.shadowBlur = 10; ctx.shadowColor = this.color;
      }
      ctx.beginPath(); ctx.arc(this.pos.x, this.pos.y, this.radius, 0, Math.PI*2); ctx.fill();
      ctx.shadowBlur = 0;
    }
  }

