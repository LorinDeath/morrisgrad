      document.getElementById('asc-icon-input')?.addEventListener('change', async (e) => {
          const input = e.target as HTMLInputElement;
          if (input.files && input.files[0]) {
                const file = input.files[0];

                // 1. Проверка размера файла
                if (file.size > 2 * 1024 * 1024) {
                    alert("Файл слишком большой! Максимум 2 МБ.");
                    input.value = '';
                    return;
                }

                // 2. Проверка пропорций и разрешения
                const objectUrl = URL.createObjectURL(file);
                const img = new Image();
                img.onload = async () => {
                    if (img.width > 3000 || img.height > 3000) {
                        alert("Изображение слишком большое! Максимальный размер 3000x3000 пикселей.");
                        input.value = '';
                        URL.revokeObjectURL(objectUrl);
                        return;
                    }
                    if (img.width !== img.height) {
                        alert("Изображение должно быть квадратным (пропорции 1:1).");
                        input.value = '';
                        URL.revokeObjectURL(objectUrl);
                        return;
                    }

                    // Если все проверки пройдены, сжимаем и сохраняем
                    try {
                        this.ascensionIconFile = await this.compressImage(file);
                    } catch (err) {
                        console.error("Ошибка сжатия изображения:", err);
                        this.ascensionIconFile = file; // Используем оригинал в случае ошибки
                    } finally {
                        URL.revokeObjectURL(objectUrl);
                    }
                };
                img.src = objectUrl;
          }
      });

      document.getElementById('btn-ascension-confirm')?.addEventListener('click', async () => {
          if (!this.selectedAscensionItem) return;
          if (meta.bossCurrency < 1) {
              alert("Недостаточно Ядер!");
              return;
          }

          // Logic for Corrupted Item Ascension
          const isCorrupted = this.selectedAscensionItem.isCorrupted;
          let setMult = 3.0; // Default +200%
          let baseMult = 0.1; // Default -90%

          if (isCorrupted) {
              if (!confirm("ВНИМАНИЕ: Вы пытаетесь возвысить ЗАРАЖЁННЫЙ предмет.\nЕго сетовые улучшения будут уменьшены в 2 раза (100% вместо 200%), а базовые параметры снижены сильнее.\nВы уверены?")) {
                  return;
              }
              setMult = 2.0; // +100%
              baseMult = 0.05; // -95% (Two times lower than 0.1)
          }
          
          if (!confirm("Вы уверены? Весь прогресс будет сброшен, а предмет перенесен в профиль.")) return;
          
          const nameInput = document.getElementById('asc-name-input') as HTMLInputElement;
          const customName = nameInput.value.trim();
          
          if (customName && !/^[a-zA-Zа-яА-Я0-9\s]+$/.test(customName)) {
              alert("Имя: только буквы, цифры и пробелы!");
              return;
          }

          const btn = document.getElementById('btn-ascension-confirm') as HTMLButtonElement;
          btn.disabled = true;
          btn.innerText = "ВОЗВЫШЕНИЕ...";
          
          // Check if Immutable Set (T1-T34)
          const isImmutable = this.selectedAscensionItem.setId && IMMUTABLE_SETS.includes(this.selectedAscensionItem.setId);
          
          // Prepare Item
          const item = JSON.parse(JSON.stringify(this.selectedAscensionItem)); // Clone
          if (customName) item.name = customName;
          item.id = `asc_${Date.now()}_${Math.floor(Math.random()*1000)}`;
          // Mark as corrupted locally so it can be identified for later upload
          item.isCorrupted = true;
          
          // Apply Transformations
          if (isImmutable) {
              // T1-T34: Never change stats or set name. But they get infected (saved as corrupted).
          } else {
              // Normal Ascension Logic
              // 1. Set Stats
              if (item.setStats) {
                  for (const key in item.setStats) {
                      item.setStats[key] *= setMult;
                      item.setStats[key] = roundStat(key, item.setStats[key]);
                  }
              }
              // 2. Standard Stats
              if (item.stats) {
                  for (const key in item.stats) {
                      item.stats[key] *= baseMult;
                      item.stats[key] = roundStat(key, item.stats[key]);
                      if (item.stats[key] <= 0) delete item.stats[key];
                  }
              }
              // 3. Change Set ID
              if (item.setId) {
                  const newSet = ASCENDED_SETS[Math.floor(Math.random() * ASCENDED_SETS.length)];
                  item.setId = newSet;
              }
          }
          
          // Collect ALL other Corrupted items to return them
          const returnedItems: Item[] = [];
          const allItems = [...meta.inventory, meta.equipment.weapon, meta.equipment.armor, meta.equipment.chip];
          allItems.forEach(i => {
              if (i && i.isCorrupted && i !== this.selectedAscensionItem) {
                  // Return as is, just remove flag if needed or keep it. 
                  // Usually returning to site means it's just an item again.
                  const rescue = JSON.parse(JSON.stringify(i));
                  // rescue.isCorrupted = false; // Optional: clean them or keep them corrupted on site? Request says "returns to user as they became".
                  returnedItems.push(rescue);
              }
          });

          try {
              // Create fresh meta state (Reset Game)
              const newMeta: MetaData = { 
                bestScore: meta.bestScore, // Preserve High Score
                currency: 0, 
                bossCurrency: 0,
                upgrades: { startHp: 0, baseDmg: 0, moveSpeed: 0, fireRate: 0, magnet: 0, luck: 0, knockback: 0 },
                skillTree: ['root'],
                unlocks: [], 
                inventory: [],
                equipment: { weapon: null, armor: null, chip: null },
                username: meta.username
              };

              // Add Ascended Item
              newMeta.inventory.push(item);
              
              // Add Returned Items
              if (returnedItems.length > 0) {
                  newMeta.inventory.push(...returnedItems);
              }

              // Save to LocalStorage
              localStorage.setItem(META_KEY, JSON.stringify(newMeta));
              
              const returnMsg = returnedItems.length > 0 ? `\nТакже сохранено заражённых предметов: ${returnedItems.length}` : '';
              alert(`ВОЗВЫШЕНИЕ ЗАВЕРШЕНО!\nПредмет "${item.name}" сохранен в инвентарь (Заражённый).\nМир будет перезагружен.${returnMsg}`);
              
              window.location.reload();
          } catch (e) {
              console.error(e);
              alert("Ошибка при сохранении данных возвышения.");
              btn.disabled = false;
              btn.innerText = "ВОЗВЫСИТЬ (1 ЯДРО)";
          }
      });
      
      // Modal Buttons
      document.getElementById('btn-modal-yes')?.addEventListener('click', () => this.confirmUpgrade());
      document.getElementById('btn-modal-no')?.addEventListener('click', () => this.hideConfirmModal());

      // Tree Logic
      document.getElementById('btn-tree')?.addEventListener('click', () => {
        this.state = 'TREE';
        this.setScreen('tree-screen');
        if (!this.treeRenderer) {
          this.treeRenderer = new SkillTreeRenderer();
          this.treeRenderer.draw();
          
          // Delegate click for dynamic button
          document.getElementById('tree-tooltip')?.addEventListener('click', (e) => {
              if ((e.target as HTMLElement).id === 'btn-unlock-node' && this.treeRenderer?.selectedNode) {
                  this.treeRenderer.tryUnlock(this.treeRenderer.selectedNode);
                  this.treeRenderer.updateTooltip(); // Refresh UI
              }
          });
        }
      });
      document.getElementById('btn-tree-back')?.addEventListener('click', () => {
        this.state = 'MENU';
        this.setScreen('menu-screen');
        updateMenuStats();
      });
    }

    // Helper for compression
    async compressImage(file: File): Promise<File> {
        return new Promise((resolve, reject) => {
            const reader = new FileReader();
            reader.readAsDataURL(file);
            reader.onload = (event) => {
                const img = new Image();
                img.src = event.target?.result as string;
                img.onload = () => {
                    const canvas = document.createElement('canvas');
                    const MAX_WIDTH = 3000;
                    const MAX_HEIGHT = 3000;
                    let width = img.width;
                    let height = img.height;

                    if (width > height) {
                        if (width > MAX_WIDTH) { height *= MAX_WIDTH / width; width = MAX_WIDTH; }
                    } else {
                        if (height > MAX_HEIGHT) { width *= MAX_HEIGHT / height; height = MAX_HEIGHT; }
                    }

                    canvas.width = width;
                    canvas.height = height;
                    const ctx = canvas.getContext('2d');
                    ctx?.drawImage(img, 0, 0, width, height);

                    canvas.toBlob((blob) => {
                        if (!blob) return reject(new Error('Canvas error'));
                        const newFile = new File([blob], file.name.replace(/\.[^/.]+$/, ".jpg"), {
                            type: 'image/jpeg',
                            lastModified: Date.now(),
                        });
                        resolve(newFile);
                    }, 'image/jpeg', 0.8);
                };
            };
            reader.onerror = (err) => reject(err);
        });
    }

    renderAscensionUI() {
        const preview = document.getElementById('asc-preview-content');
        const confirmBtn = document.getElementById('btn-ascension-confirm');
        const uploadSec = document.getElementById('asc-upload-section');
        
        if (preview) preview.innerHTML = "Выберите надетый предмет слева...";
        if (confirmBtn) confirmBtn.style.display = 'none';
        if (uploadSec) uploadSec.classList.add('hidden');
        
        ['weapon', 'armor', 'chip'].forEach(slot => {
            const el = document.getElementById(`asc-slot-${slot}`);
            if (!el) return;
            const item = meta.equipment[slot as keyof typeof meta.equipment];
            
            el.className = 'equip-slot'; // Reset
            if (this.selectedAscensionItem === item && item) el.classList.add('selected-upgrade');
            
            if (item) {
                const iconHtml = (item.icon && item.icon.startsWith('http')) 
                    ? `<img src="${item.icon}" style="width: 30px; height: 30px; object-fit: cover; border-radius: 4px; display:inline-block; vertical-align:middle; margin-right:5px;">` 
                    : item.icon;
                el.innerHTML = `${iconHtml} <span style="color:#fff">${item.name}</span><br><span style="font-size:0.6rem; color:${this.getItemColor(item.rarity)}">${item.rarity.toUpperCase()}</span>`;
                if (item.isCorrupted) {
                    el.innerHTML += `<br><span style="color:#ff00ff; font-size:0.6rem;">[ЗАРАЖЁН]</span>`;
                    el.style.borderColor = '#ff00ff';
                }
                el.classList.add('filled');
                el.onclick = () => {
                    this.selectedAscensionItem = item;
                    this.renderAscensionUI(); // Re-render to show selection
                    this.updateAscensionPreview(item);
                };
            } else {
                el.innerHTML = "ПУСТО";
                el.onclick = null;
                el.classList.remove('filled');
            }
        });
    }

    updateAscensionPreview(item: Item) {
        const preview = document.getElementById('asc-preview-content');
        const confirmBtn = document.getElementById('btn-ascension-confirm');
        const uploadSec = document.getElementById('asc-upload-section');
        
        if (confirmBtn) confirmBtn.style.display = 'block';
        if (uploadSec) uploadSec.classList.remove('hidden');
        
        if (!preview) return;
        
        const isCorrupted = item.isCorrupted;
        const setMult = isCorrupted ? 2.0 : 3.0; // 100% vs 200%
        const baseMult = isCorrupted ? 0.05 : 0.1; // -95% vs -90%
        
        const iconHtml = (item.icon && item.icon.startsWith('http')) 
            ? `<img src="${item.icon}" style="width: 60px; height: 60px; object-fit: cover; border-radius: 6px; display: block; margin: 0 auto 10px auto; border: 1px solid ${this.getItemColor(item.rarity)}">` 
            : `<div style="font-size: 3rem; margin-bottom: 10px;">${item.icon}</div>`;

        let html = `<div style="text-align:center;">${iconHtml}</div><div style="color:${this.getItemColor(item.rarity)}; font-size:1.2rem; margin-bottom:10px;">${item.name}</div>`;
        
        if (isCorrupted) {
            html += `<div style="color:#ff00ff; font-weight:bold; margin-bottom:10px; border:1px solid #ff00ff; padding:5px;">⚠️ ЗАРАЖЁННЫЙ ПРЕДМЕТ ⚠️<br><span style="font-size:0.7rem; color:#fff;">ШТРАФ ВОЗВЫШЕНИЯ: СТАТЫ СНИЖЕНЫ, БОНУС СЕТА УМЕНЬШЕН</span></div>`;
        }

        html += `<div style="color:#f00; font-weight:bold; margin-bottom:5px;">ИЗМЕНЕНИЯ:</div>`;
        
        // Stats
        if (item.stats) {
            for (const [key, val] of Object.entries(item.stats)) {
                const name = STAT_NAMES[key] || key.toUpperCase();
                const newVal = val * baseMult;
                html += `<div style="display:flex; justify-content:space-between; color:#888;"><span>${name}</span> <span>${val.toFixed(1)} ➝ <span style="color:#f00">${newVal.toFixed(1)}</span></span></div>`;
            }
        }
        
        // Set
        if (item.setId) {
            const pct = isCorrupted ? "+100% (x2)" : "+200%";
            html += `<div style="margin-top:10px; color:#0f0;">СЕТОВЫЕ БОНУСЫ (${pct}):</div>`;
            html += `<div style="color:#a020f0; font-style:italic;">СЕТ ИЗМЕНИТСЯ НА СЛУЧАЙНЫЙ ИЗ 9 ВЫСШИХ</div>`;
            if (item.setStats) {
                for (const [key, val] of Object.entries(item.setStats)) {
                    const name = STAT_NAMES[key] || key.toUpperCase();
                    const newVal = val * setMult;
                    html += `<div style="display:flex; justify-content:space-between; color:#0f0;"><span>${name}</span> <span>${val.toFixed(1)} ➝ <span style="color:#0f0; font-weight:bold;">${newVal.toFixed(1)}</span></span></div>`;
                }
            }
        } else {
            html += `<div style="margin-top:10px; color:#888;">НЕТ СЕТА - БОНУСОВ НЕ БУДЕТ</div>`;
        }
        
        preview.innerHTML = html;
    }
      
    handleMouseMove(e: MouseEvent) {
        const rect = this.canvas.getBoundingClientRect();
        const scaleX = CANVAS_W / rect.width;
        const scaleY = CANVAS_H / rect.height;
        mouse.pos.x = (e.clientX - rect.left) * scaleX;
        mouse.pos.y = (e.clientY - rect.top) * scaleY;
    }

    destroy() {
        window.removeEventListener('mousemove', this.boundMouseMove);
        window.removeEventListener('mousedown', this.boundMouseDown);
        if (animationFrameId) cancelAnimationFrame(animationFrameId);
        gameInstance = null;
    }

    getItemTooltip(item: Item) {
        let parts = [];
        
        // Stats
        if (Object.keys(item.stats).length > 0) {
            parts.push("--- ХАРАКТЕРИСТИКИ ---");
            for (const [key, val] of Object.entries(item.stats)) {
                const name = STAT_NAMES[key] || key.toUpperCase();
                let fmtVal = `+${val.toFixed(1)}`;
                if (['crit', 'cooldown', 'area', 'lifesteal', 'curse', 'slow', 'frag', 'projSpeed'].includes(key)) {
                    fmtVal = `+${(val*100).toFixed(1)}%`;
                } else if (key === 'dodge') {
                    fmtVal = `+${(val*100).toFixed(1)}`;
                }
                parts.push(` • ${name}: ${fmtVal}`);
            }
        }
        
        // Set
        if (item.setId) {
            parts.push("");
            
            // Check active count based on currently equipped items
            const equip = meta.equipment;
            let count = 0;
            [equip.weapon, equip.armor, equip.chip].forEach(eq => {
                if (eq && eq.setId === item.setId) count++;
            });
            
            const isActive = count >= 3;
            const statusIcon = isActive ? "✅" : "🔒";
            const statusText = isActive ? "АКТИВНО" : "НЕАКТИВНО";
            const setName = SET_TRANSLATIONS[item.setId] || item.setId.toUpperCase();
            
            parts.push(`--- СЕТ: ${setName} (${count}/3) ---`);
            if (isActive && item.isCorrupted) parts.push(`(ЗАРАЖЁННЫЙ БОНУС x2)`);
            
            if (item.setStats) {
                for (const [key, val] of Object.entries(item.setStats)) {
                    const name = STAT_NAMES[key] || key.toUpperCase();
                    let effectiveVal = val;
                    if (isActive && item.isCorrupted) effectiveVal *= 2;

                    let fmtVal = `+${effectiveVal.toFixed(1)}`;
                    if (['crit', 'cooldown', 'area', 'lifesteal', 'curse', 'slow', 'frag', 'projSpeed'].includes(key)) {
                        fmtVal = `+${(effectiveVal*100).toFixed(1)}%`;
                    } else if (key === 'dodge') {
                        fmtVal = `+${(effectiveVal*100).toFixed(1)}`;
                    }
                    parts.push(` ${statusIcon} ${name}: ${fmtVal}`);
                }
            }
        }
        
        return parts.join('\n');
    }

    getItemDesc(item: Item) {
        if (item.desc) return item.desc;
        // Fallback generator if desc is missing or for dynamic updates
        const parts = [];
        if (item.level && item.level > 0) parts.push(`[Lvl ${item.level}]`);
        if (item.modified) parts.push(`(MOD)`);
        if (item.isCorrupted) parts.push(`[ЗАРАЖЁН]`);
        if (item.setId) {
            const setName = SET_TRANSLATIONS[item.setId] || item.setId.toUpperCase();
            parts.push(`[СЕТОВЫЙ: ${setName}]`);
            for (const [key, val] of Object.entries(item.setStats || {})) {
                let fmtVal = `+${val.toFixed(1)}`;
                if (['crit', 'cooldown', 'area', 'lifesteal', 'curse', 'slow', 'frag', 'projSpeed'].includes(key)) {
                    fmtVal = `+${(val*100).toFixed(1)}%`;
                } else if (key === 'dodge') {
                    fmtVal = `+${(val*100).toFixed(1)}`;
                }
                parts.push(`✅ ${STAT_NAMES[key] || key} ${fmtVal} (СЕТ)`);
            }
        }
        for (const [key, val] of Object.entries(item.stats)) {
            const name = STAT_NAMES[key] || key.toUpperCase();
            let fmtVal = `+${val.toFixed(1)}`;
            if (['crit', 'cooldown', 'area', 'lifesteal', 'curse', 'slow', 'frag', 'projSpeed'].includes(key)) {
                fmtVal = `+${(val*100).toFixed(1)}%`;
            } else if (key === 'dodge') {
                fmtVal = `+${(val*100).toFixed(1)}`;
            }
            parts.push(`${name} ${fmtVal}`);
        }
        return parts.join(', ');
    }
    
    showItemTooltip(e: MouseEvent, text: string) {
        const el = document.getElementById('item-tooltip');
        if (!el) return;
        el.innerHTML = text.replace(/\n/g, '<br>');
        el.style.left = (e.clientX + 15) + 'px';
        el.style.top = (e.clientY + 15) + 'px';
        el.classList.remove('hidden');
    }

    hideItemTooltip() {
        const el = document.getElementById('item-tooltip');
        if (el) el.classList.add('hidden');
    }
    
    renderProfile() {
        const container = document.getElementById('profile-stats');
        if (!container) return;
        
        // Create a dummy player to calculate stats
        const p = new Player();

        let critDisplay = `${(p.critChance * 100).toFixed(1)}%`;
        if (p.critChance > 1) {
            const tier = Math.floor(p.critChance);
            const tierNames = ['', 'СВЕРХ', 'МЕГА', 'ГИГА', 'ТЕРРА', 'ПЕТА', 'ЭКСА'];
            const name = tierNames[Math.min(tier, tierNames.length-1)] || `TIER ${tier}`;
            critDisplay += ` (${name}-КРИТ)`;
        }
        
        const stats = [
            { name: 'Здоровье (HP)', val: `${Math.round(p.hp)} / ${Math.round(p.maxHp)}` },
            { name: 'Урон', val: Math.round(p.damage) },
            { name: 'Скорость', val: Math.round(p.speed) },
            { name: 'Шанс Крита', val: critDisplay },
            { name: 'Сила Крита', val: `x${p.critMult.toFixed(1)}` },
            { name: 'Скорострельность', val: `${(1/p.fireRate).toFixed(1)} выстр/сек` },
            { name: 'Мультивыстрел', val: `x${p.multishot}` },
            { name: 'Регенерация', val: `${p.regen.toFixed(1)} HP/сек` },
            { name: 'Вампиризм', val: `${(p.lifesteal * 100).toFixed(1)}% от урона` },
            { name: 'Шанс Уклонения', val: `${((Math.max(0, p.dodge) / (Math.max(0, p.dodge) + 1)) * 100).toFixed(1)}%` },
            { name: 'Шипы (Возврат)', val: `${p.thorns.toFixed(1)} + ${(p.thornsPct*100).toFixed(0)}%` },
            { name: 'Магнит (Радиус)', val: `${p.magnet}%` },
            { name: 'Удача', val: p.luck },
            { name: 'Отталкивание', val: p.knockback },
            { name: 'Бонус XP', val: `x${p.xpMult.toFixed(2)}` },
            { name: 'Урон по Боссам', val: `x${p.bossDmgMult.toFixed(2)}` },
            { name: 'Урон по Элите', val: `x${p.eliteDmgMult.toFixed(2)}` },
            { name: 'Дроны', val: p.droneCount },
            { name: 'Разброс пуль', val: `${p.spread.toFixed(1)}°` },
            { name: 'Скорость пуль', val: `x${p.projSpeedMult.toFixed(2)}` },
            { name: 'Шанс Осколков', val: `${(p.fragChance * 100).toFixed(1)}%` },
            { name: 'Вход. Урон (Метка)', val: `x${p.damageTakenMult.toFixed(2)}` },
            { name: 'Замедление', val: `${((1 - p.moveSpeedMult) * 100).toFixed(1)}%` }
        ];
        
        container.innerHTML = stats.map(s => 
            `<div class="stat-row"><span class="stat-name">${s.name}</span><div class="stat-dots"></div><span class="stat-val">${s.val}</span></div>`
        ).join('');
    }

    renderInventory() {
        const grid = document.getElementById('inv-grid');
        if (!grid) return;
        grid.innerHTML = '';
        
        // Render Equipped
        const equip = meta.equipment;
        let setCounts: Record<string, number> = {};
        [equip.weapon, equip.armor, equip.chip].forEach(item => {
            if (item && item.setId) setCounts[item.setId] = (setCounts[item.setId] || 0) + 1;
        });

        ['weapon', 'armor', 'chip'].forEach(slot => {
            const el = document.getElementById(`slot-${slot}`);
            if (!el) return;
            const item = meta.equipment[slot as keyof typeof meta.equipment];
            
            // Reset classes
            el.className = 'equip-slot';
            if (this.upgradeTargetSlot === slot) el.classList.add('selected-upgrade');
            
            if (item && item.setId) {
                const count = setCounts[item.setId] || 0;
                if (count >= 3) el.classList.add('set-active');
                else if (count >= 2) el.classList.add('set-connected');
            }
            
            if (item) {
                const desc = this.getItemDesc(item); // Dynamic desc
                const nameColor = item.setId ? '#0f0' : '#fff';
                
                const iconHtml = (item.icon && item.icon.startsWith('http')) 
                    ? `<img src="${item.icon}" style="width: 30px; height: 30px; object-fit: cover; border-radius: 4px; display:inline-block; vertical-align:middle; margin-right:5px;">` 
                    : item.icon;

                el.innerHTML = `${iconHtml} <span style="color:${nameColor}">${item.name}</span><br><span style="font-size:0.6rem; color:${this.getItemColor(item.rarity)}">${item.rarity.toUpperCase()}</span><br><span style="font-size:0.55rem; color:#aaa">${desc}</span>`;
                
                // Active Set Count for Tooltip
                let setCountStr = "";
                if (item.setId) {
                    setCountStr = `\n(АКТИВНО: ${setCounts[item.setId] || 0}/3)`;
                }
                
                const tooltipText = `${item.name}\n${item.rarity.toUpperCase()}\n[Lvl ${item.level || 0}]${setCountStr}\n\n${this.getItemTooltip(item)}`;
                
                el.onmouseenter = (e) => this.showItemTooltip(e, tooltipText);
                el.onmousemove = (e) => this.showItemTooltip(e, tooltipText);
                el.onmouseleave = () => this.hideItemTooltip();
                
                el.classList.add('filled');
                
                el.onclick = () => {
                    if (this.upgradeTargetSlot === slot) {
                        this.upgradeTargetSlot = null; // Deselect
                    } else {
                        this.upgradeTargetSlot = slot; // Select for upgrade
                    }
                    this.renderInventory();
                };
            } else {
                el.innerHTML = "ПУСТО";
                el.onclick = null;
                el.onmouseenter = null;
                el.onmousemove = null;
                el.onmouseleave = null;
            }
        });

        // Render Bag
        let itemsToShow = [...meta.inventory]; // Copy for sorting
        const container = document.querySelector('.inv-grid-container');
        const h3 = container?.querySelector('h3');
        
        const getRank = (i: Item) => {
            let r = RARITIES.indexOf(i.rarity);
            if (i.setId) r += 100; // Sets are highest priority
            return r;
        };

        if (this.upgradeTargetSlot) {
            container?.classList.add('upgrade-mode');
            if (h3) h3.innerText = "ВЫБЕРИТЕ ПРЕДМЕТ ДЛЯ ПОГЛОЩЕНИЯ (10% СТАТ)";
        } else if (this.inventoryMode === 'upload') {
            container?.classList.add('upgrade-mode');
            if (h3) h3.innerText = "ВЫБЕРИТЕ ЗАРАЖЁННЫЙ ПРЕДМЕТ";
        } else {
            container?.classList.remove('upgrade-mode');
            if (h3) h3.innerText = "ХРАНИЛИЩЕ";
        }

        // Filter logic
        if (this.upgradeTargetSlot) {
            const targetItem = meta.equipment[this.upgradeTargetSlot as keyof typeof meta.equipment];
            if (targetItem) {
                itemsToShow = itemsToShow.filter(i => i.type === targetItem.type);
            }
            // Sort: Worst to Best (Ascending) for upgrades
            itemsToShow.sort((a, b) => getRank(a) - getRank(b));
        } else {
            container?.classList.remove('upgrade-mode');
            if (h3) h3.innerText = "ХРАНИЛИЩЕ ДАННЫХ";
            // Sort: Best to Worst (Descending) for normal view
            itemsToShow.sort((a, b) => getRank(b) - getRank(a));
        }

        itemsToShow.forEach((item) => {
            // Find original index in meta.inventory to splice correctly
            const realIdx = meta.inventory.indexOf(item);
            
            const div = document.createElement('div');
            div.className = `inv-item rarity-${item.rarity}`;
            
            const iconHtml = (item.icon && item.icon.startsWith('http')) 
                ? `<img src="${item.icon}" style="width: 40px; height: 40px; object-fit: cover; border-radius: 4px;">` 
                : `<div style="font-size:1.5rem">${item.icon}</div>`;
            div.innerHTML = `<div style="display:flex; justify-content:center; align-items:center; height:45px;">${iconHtml}</div><div>${item.name}</div>`;
            
            if (item.setId) {
                div.classList.add('set-item');
                if (item.isCorrupted) div.classList.add('corrupted'); // Add corrupted class to set items too
                div.style.color = '#0f0';
            } else if (item.isCorrupted) {
                div.classList.add('corrupted');
                div.style.color = '#ff00ff';
            } else {
                div.style.color = this.getItemColor(item.rarity);
            }
            
            // Active Set Count for Tooltip
            let setCountStr = "";
            if (item.setId) {
                setCountStr = `\n(АКТИВНО: ${setCounts[item.setId] || 0}/3)`;
            }
            let tooltip = `${item.name}\n${item.rarity.toUpperCase()}\n[Lvl ${item.level || 0}]${setCountStr}\n\n${this.getItemTooltip(item)}`;
            
            div.onmouseenter = (e) => this.showItemTooltip(e, tooltip);
            div.onmousemove = (e) => this.showItemTooltip(e, tooltip);
            div.onmouseleave = () => this.hideItemTooltip();
            
            // Preview in tooltip
            if (this.upgradeTargetSlot) {
                const gains: string[] = [];
                for (const [key, val] of Object.entries(item.stats)) {
                    const name = STAT_NAMES[key] || key.toUpperCase();
                    const gainVal = val * 0.1;
                    let fmtVal = `+${gainVal.toFixed(2)}`;
                    if (['crit', 'cooldown', 'area', 'lifesteal', 'curse', 'slow', 'frag', 'projSpeed'].includes(key)) {
                        fmtVal = `+${(gainVal*100).toFixed(2)}%`;
                    } else if (key === 'dodge') {
                        fmtVal = `+${(gainVal*100).toFixed(2)}`;
                    }
                    gains.push(`${name} ${fmtVal}`);
                }
                tooltip += `\n\n[ПРИ ПОГЛОЩЕНИИ]:\n${gains.join('\n')}`;
                // Update tooltip content for upgrade mode
                div.onmouseenter = (e) => this.showItemTooltip(e, tooltip);
                div.style.cursor = 'crosshair';
            }
            
            div.onclick = () => {
                if (this.upgradeTargetSlot) {
                    // UPGRADE LOGIC
                    this.showConfirmModal(item, realIdx);
                } else if (this.inventoryMode === 'upload') {
                    // UPLOAD LOGIC
                    if (item.isCorrupted) {
                        this.showUploadModal(item, realIdx);
                    } else {
                        alert("Можно отправлять только заражённые предметы!");
                    }
                } else {
                    // EQUIP LOGIC
                    const current = meta.equipment[item.type];
                    if (current) meta.inventory.push(current);
                    meta.equipment[item.type] = item;
                    meta.inventory.splice(realIdx, 1);
                    this.renderInventory();
                }
            };
            grid.appendChild(div);
        });
    }

    showUploadModal(item: Item, idx: number) {
        const modal = document.getElementById('modal-confirm');
        const msg = document.getElementById('modal-msg');
        const preview = document.getElementById('modal-preview');
        if (!modal || !msg || !preview) return;

        // Setup for Upload
        this.pendingUpgradeItem = item;
        this.pendingUpgradeIdx = idx;
        
        msg.innerHTML = `<h3 style="color:#0f0">ОТПРАВКА В БАЗУ</h3>Вы хотите перенести этот предмет в глобальную базу данных?<br>Он будет удален из локального сохранения.`;
        
        const iconHtml = (item.icon && item.icon.startsWith('http')) ? `<img src="${item.icon}" style="width:60px; height:60px; object-fit:cover;">` : `<div style="font-size:2rem">${item.icon}</div>`;
        
        let statsHtml = '';
        for (const [key, val] of Object.entries(item.stats)) {
             statsHtml += `<div>${STAT_NAMES[key]||key}: ${val}</div>`;
        }
        if (item.setId) statsHtml += `<div style="color:#0f0">СЕТ: ${SET_TRANSLATIONS[item.setId]||item.setId}</div>`;

        preview.innerHTML = `
            <div style="display:flex; gap:15px; align-items:center;">
                <div class="inv-item rarity-${item.rarity}" style="width:80px; height:80px; display:flex; align-items:center; justify-content:center;">
                    ${iconHtml}
                </div>
                <div style="text-align:left;">
                    <div style="color:${this.getItemColor(item.rarity)}; font-weight:bold;">${item.name}</div>
                    <div style="font-size:0.8rem; color:#aaa;">${statsHtml}</div>
                </div>
            </div>
        `;
        
        modal.classList.remove('hidden');
    }

    showConfirmModal(item: Item, idx: number) {
        const modal = document.getElementById('modal-confirm');
        const msg = document.getElementById('modal-msg');
        const preview = document.getElementById('modal-preview');
        if (!modal || !msg || !preview) return;

        // Get target item
        const targetSlot = this.upgradeTargetSlot;
        if (!targetSlot) return;
        const target = meta.equipment[targetSlot as keyof typeof meta.equipment];
        if (!target) return;

        this.pendingUpgradeItem = item;
        this.pendingUpgradeIdx = idx;

        const targetIcon = (target.icon && target.icon.startsWith('http')) ? `<img src="${target.icon}" style="width:100%; height:100%; object-fit:cover;">` : `<div style="font-size:1.5rem">${target.icon}</div>`;
        const itemIcon = (item.icon && item.icon.startsWith('http')) ? `<img src="${item.icon}" style="width:100%; height:100%; object-fit:cover;">` : `<div style="font-size:1.5rem">${item.icon}</div>`;

        // Visual comparison UI
        msg.innerHTML = `
            <div style="display:flex; align-items:center; justify-content:center; gap:15px; margin-bottom:10px;">
                <div class="inv-item rarity-${target.rarity}" style="width:60px; height:60px; pointer-events:none; border-width:2px; display:flex; align-items:center; justify-content:center; overflow:hidden;">
                    ${targetIcon}
                </div>
                <div style="font-size:2rem; color:#0f0; animation:pulse 1s infinite;">⬅</div>
                <div class="inv-item rarity-${item.rarity}" style="width:60px; height:60px; pointer-events:none; border-width:2px; display:flex; align-items:center; justify-content:center; overflow:hidden;">
                    ${itemIcon}
                </div>
            </div>
            <div style="font-size:0.9rem; color:#ccc; margin-bottom:5px;">
                ПРИЕМНИК (Получит статы): <span style="color:${this.getItemColor(target.rarity)}">${target.name}</span>
            </div>
            <div style="font-size:0.8rem; color:#666;">
                ДОНОР (Будет уничтожен): <span style="color:${this.getItemColor(item.rarity)}">${item.name}</span>
            </div>
            ${target.setId ? `<div style="color:#0f0; font-size:0.7rem; margin-top:5px;">ЦЕЛЬ: СЕТ ${(SET_TRANSLATIONS[target.setId] || target.setId).toUpperCase()}</div>` : ''}
            ${item.setId ? `<div style="color:#0f0; font-size:0.7rem; margin-top:2px;">ИСТОЧНИК: СЕТ ${(SET_TRANSLATIONS[item.setId] || item.setId).toUpperCase()}</div>` : ''}
            ${target.setId && target.setId === item.setId ? `<div style="color:#0f0; font-weight:bold;">СОВПАДЕНИЕ СЕТА! БОНУСЫ БУДУТ УЛУЧШЕНЫ</div>` : ''}
            ${target.setId && item.setId && target.setId !== item.setId ? `<div style="color:#f00; font-weight:bold;">РАЗНЫЕ СЕТЫ! СЕТОВЫЕ БОНУСЫ НЕ ПЕРЕЙДУТ</div>` : ''}
        `;
        
        // Calculate preview
        const gains: string[] = [];
        for (const [key, val] of Object.entries(item.stats)) {
            const name = STAT_NAMES[key] || key.toUpperCase();
            const gainVal = val * 0.1;
            let fmtVal = `+${gainVal.toFixed(2)}`;
            if (['crit', 'cooldown', 'area', 'lifesteal', 'curse', 'slow', 'frag', 'projSpeed'].includes(key)) {
                fmtVal = `+${(gainVal*100).toFixed(2)}%`;
            } else if (key === 'dodge') {
                fmtVal = `+${(gainVal*100).toFixed(2)}`;
            }
            
            // Current val
            const currentVal = target.stats[key] || 0;
            let fmtCurrent = `${currentVal.toFixed(1)}`;
            if (['crit', 'cooldown', 'area', 'lifesteal', 'curse', 'slow', 'frag', 'projSpeed'].includes(key)) {
                fmtCurrent = `${(currentVal*100).toFixed(1)}%`;
            } else if (key === 'dodge') {
                fmtCurrent = `${(currentVal*100).toFixed(1)}`;
            }

            gains.push(`
                <div style="display:flex; justify-content:space-between; border-bottom:1px solid #333; padding:2px 0;">
                    <span style="color:#aaa">${name}</span>
                    <span>${fmtCurrent} <span style="color:#0f0; font-weight:bold;">${fmtVal}</span></span>
                </div>
            `);
        }
        
        // Set Stats Preview
        if (target.setId) {
            gains.push(`<div style="color:#0f0; margin-top:5px; border-top:1px dashed #333;">СЕТОВЫЕ БОНУСЫ:</div>`);
            
            Object.keys(target.setStats || {}).forEach(key => {
                const name = STAT_NAMES[key] || key.toUpperCase();
                const current = target.setStats?.[key] || 0;
                let added = 0;
                if (item.setId === target.setId && item.setStats?.[key]) {
                    added = item.setStats[key] * 0.1;
                }
                
                const valStr = added > 0 
                   ? `${current.toFixed(2)} <span style="color:#0f0; font-weight:bold;">+${added.toFixed(2)}</span>`
                   : `${current.toFixed(2)}`;

                gains.push(`
                   <div style="display:flex; justify-content:space-between; color:#aaa;">
                       <span>${name}</span><span>${valStr}</span>
                   </div>
               `);
            });
        }
        
        preview.innerHTML = `<div style="background:#000; padding:10px; border:1px solid #333; text-align:left;">${gains.join('')}</div>`;
        modal.classList.remove('hidden');
    }

    confirmUpgrade() {
        if (!this.pendingUpgradeItem || this.pendingUpgradeIdx === -1) return;
        
        // Handle Upload Mode
        if (this.inventoryMode === 'upload') {
            const item = this.pendingUpgradeItem;
            const idx = this.pendingUpgradeIdx;
            
            // Send to API
            fetch('/api/inventory', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ items: [item] })
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    alert("Предмет успешно отправлен!");
                    meta.inventory.splice(idx, 1);
                    saveMeta();
                    this.renderInventory();
                } else {
                    alert("Ошибка отправки: " + (data.error || "Unknown"));
                }
            })
            .catch(err => alert("Ошибка сети"));
            
            this.hideConfirmModal();
            return;
        }

        // Handle Upgrade Mode
        if (!this.upgradeTargetSlot) return;
        
        const target = meta.equipment[this.upgradeTargetSlot as keyof typeof meta.equipment];
        const item = this.pendingUpgradeItem;
        
        if (target) {
            // Absorb
            // Standard Stats (Limit 5)
            for (const [key, val] of Object.entries(item.stats)) {
                if (target.stats[key]) {
                    target.stats[key] = roundStat(key, target.stats[key] + val * 0.1);
                } else {
                    // Add new stat if limit not reached
                    if (Object.keys(target.stats).length < 5) {
                        const newVal = roundStat(key, val * 0.1);
                        if (newVal > 0) target.stats[key] = newVal;
                    }
                }
            }
            
            // Set Stats (Only if same set)
            if (target.setId && item.setId && target.setId === item.setId && target.setStats && item.setStats) {
                for (const [key, val] of Object.entries(item.setStats)) {
                    // Only upgrade existing set stats
                    if (target.setStats[key] !== undefined) {
                        target.setStats[key] = roundStat(key, target.setStats[key] + val * 0.1);
                    }
                }
            }
            // Update Level & Modified
            target.level = (target.level || 0) + 1;
            target.modified = true;
            target.desc = undefined; // Force description regeneration
            
            // Consume
            meta.inventory.splice(this.pendingUpgradeIdx, 1);
            
            // Save & Render
            saveMeta();
            this.renderInventory();
        }
        
        this.hideConfirmModal();
    }

    hideConfirmModal() {
        const modal = document.getElementById('modal-confirm');
        if (modal) modal.classList.add('hidden');
        this.pendingUpgradeItem = null;
        this.pendingUpgradeIdx = -1;
    }

    getItemColor(rarity: string) {
        const colors: Record<string, string> = {
            common: '#fff',
            rare: '#00f',
            epic: '#a020f0',
            legendary: '#ffd700',
            mythic: '#ff3333',
            divine: '#00ffff'
        };
        return colors[rarity] || '#fff';
    }

    startLoop() {
      if (animationFrameId) cancelAnimationFrame(animationFrameId);
      
      const loop = (now: number) => {
        const dt = Math.min((now - lastTime) / 1000, 0.1);
        lastTime = now;

        if (gameInstance === this) {
          this.update(dt);
          this.draw();
          animationFrameId = requestAnimationFrame(loop);
        }
      };
      animationFrameId = requestAnimationFrame(loop);
    }
  }

  // --- GLOBALS (Bottom) ---
  let lastTime = 0;

  document.addEventListener('astro:page-load', () => {
    loadMeta();
    if (gameInstance) {
        gameInstance.destroy();
    }
    new Game();
  });

</script>