  class Enemy extends Entity {
    hp: number;
    maxHp: number;
    shield: number = 0;
    maxShield: number = 0;
    damage: number;
    config: EnemyConfig;
    
    shootTimer = 0;
    dashTimer = 0;
    isDashing = false;
    healTimer = 0;
    specialTimer = 0;
    isStealthed = false;
    flankOffset = Math.random() * 100; // Unique movement pattern
    offScreenTimer = 0;
    spawnFade = 0; // Opacity for spawn animation
    angle = 0; // Facing angle
    
    overrideDir: Vector | null = null; // For dodging/dashing
    hitCooldown = 0; // Attack cooldown for collision
    
    // Special Props
    cageActive = false;
    cageRadius = 300;
    walls: { pos: Vector, size: Vector, angle: number }[] = [];

    constructor(pos: Vector, typeId: string, level: number, public elite: boolean) {
      super(pos, 15, '#f00');
      this.config = ENEMIES[typeId] || ENEMIES['basic_weak'];
      
      // Rebalance Scaling: Polynomial instead of Exponential to fix Wave 111+
      // Old: 1.2^111 = 600,000,000x (Impossible) -> New: 111^2.2 * 0.02 = ~640x
      const scale = 1 + Math.pow(level, 2.2) * 0.02;
      this.hp = this.config.hp * scale * selectedDifficulty;
      this.maxHp = this.hp;
      
      let baseDmg = 10;
      if (typeId.includes('boss')) baseDmg = 40; // Bosses hit MUCH harder
      
      this.damage = baseDmg * scale * selectedDifficulty; // Damage Scaling
      this.radius = this.config.radius;
      this.color = this.config.color;
      
      if (elite) {
        this.shield = this.maxHp; // Shield layer
        this.maxShield = this.maxHp;
        this.radius *= 1.2;
        this.damage *= 1.5; // Elite bosses hit even harder
      }
    }

    update(dt: number) {
      if (this.hitCooldown > 0) this.hitCooldown -= dt;
      // Spawn Fade-in (0 to 1 in 0.3s)
      if (this.spawnFade < 1) this.spawnFade = Math.min(1, this.spawnFade + dt / 0.3);

      if (!game.player.dead) {
        let dir = game.player.pos.sub(this.pos).normalize();
        let speed = this.config.speed;
        
        // Override direction if dodging or controlled
        if (this.overrideDir) {
            dir = this.overrideDir;
        }

        // Weather: Rain slows enemies
        if (game.director.weather === 'rain') speed *= 0.8; // Less slow than before
        
        // Weather: Wind pushes enemies
        if (game.director.weather === 'wind') this.pos.x += 50 * dt; // Reduced wind push
        
        // Anomaly: Turbo
        if (game.director.activeAnomaly?.type === 'turbo') speed *= 1.5;
        
        // Builder Behavior: Keep distance and hide
        if (this.config.type === 'builder') {
             const dist = game.player.pos.sub(this.pos).mag();
             if (dist < 500) {
                 // Run away from player (Kiting)
                 dir = this.pos.sub(game.player.pos).normalize();
             } else {
                 // Stay put (Behind the lines)
                 speed = 0;
             }
        }

        // Flanking Logic (Fast units & Ninja)
        if (this.config.id.includes('fast') || this.config.id.includes('ninja') || this.config.id.includes('vampire')) {
             const toPlayer = game.player.pos.sub(this.pos);
             const dist = toPlayer.mag();
             if (dist > 100) { // Only flank when approaching
                 const perp = new Vector(-toPlayer.y, toPlayer.x).normalize();
                 // Sine wave flanking based on time and unique offset
                 const flankFactor = Math.sin(performance.now() / 400 + this.flankOffset); 
                 dir = toPlayer.normalize().add(perp.mult(flankFactor * 0.6)).normalize();
             }
        }

        // Cage Master Logic
        if (this.config.type === 'cage_master') {
            const dist = game.player.pos.sub(this.pos).mag();
            if (!this.cageActive) {
                // Chase mode: Fast & Invulnerable
                speed = this.config.speed; // 450
                if (dist < 150) {
                    this.cageActive = true;
                    game.texts.push(new FloatingText(this.pos, "КЛЕТКА!", "#00f"));
                    game.screenShake = 10;
                    game.spawnParticles(this.pos, '#00f', 20);
                }
            } else {
                // Active mode: Slow & Vulnerable
                speed = 50;
                // Chaotic movement
                this.angle += (Math.random() - 0.5) * 0.5;
                dir = new Vector(Math.cos(this.angle), Math.sin(this.angle));
                
                // Deactivate if player escapes
                if (dist > this.cageRadius + 50) {
                    this.cageActive = false;
                    game.texts.push(new FloatingText(this.pos, "СБРОС!", "#fff"));
                }
            }
        }

        // Wall Runner Logic
        if (this.config.type === 'wall_runner') {
            // Erratic movement
            if (Math.random() < 0.05) {
                const a = Math.random() * Math.PI * 2;
                this.overrideDir = new Vector(Math.cos(a), Math.sin(a));
            }
            if (this.overrideDir) dir = this.overrideDir;
            
            this.specialTimer -= dt;
            if (this.specialTimer <= 0) {
                this.specialTimer = 3.0;
                // Place wall
                const wallDist = 40;
                const wallPos = this.pos.add(dir.mult(wallDist));
                // Wall perpendicular to look dir
                const wallAngle = Math.atan2(dir.y, dir.x) + Math.PI/2;
                this.walls.push({ pos: wallPos, size: new Vector(80, 6), angle: wallAngle });
                game.spawnParticles(wallPos, '#00ff88', 5);
            }
        }

        // Rotation Logic
        const targetAngle = Math.atan2(dir.y, dir.x);
        if (this.config.type === 'shielder') {
            // Slow rotation for shielder
            const diff = targetAngle - this.angle;
            // Normalize angle diff
            const d = Math.atan2(Math.sin(diff), Math.cos(diff));
            this.angle += Math.sign(d) * Math.min(Math.abs(d), 0.8 * dt); // Slower turn speed
        } else {
            this.angle = targetAngle;
        }

        // Ranged Logic
        if (this.config.type === 'ranged') {
            const dist = game.player.pos.sub(this.pos).mag();
            if (dist < 300) speed = -100; // Kite faster
            else if (dist < 500) speed = 0; // Stand and shoot
            
            this.shootTimer -= dt;
            if (this.shootTimer <= 0 && dist < 600) {
                this.shootTimer = 2.0;
                // Actual projectile
                // Predictive Aiming
                const timeToHit = dist / 300;
                const predictedPos = game.player.pos.add(game.player.vel.mult(timeToHit * 0.5)); // 50% prediction accuracy
                const shotDir = predictedPos.sub(this.pos).normalize();
                game.projectiles.push(new Projectile(this.pos, shotDir.mult(300), this.damage, 'bullet', 'enemy'));
            }
        }
        
        // Charger Logic
        if (this.config.type === 'charger' || this.config.type === 'boss_psycho') {
            this.dashTimer -= dt;
            
            // 1. Dodge Logic (Smart AI)
            if (!this.isDashing && this.dashTimer <= 0) {
                for(const p of game.projectiles) {
                    if (p.team === 'player' && p.pos.sub(this.pos).mag() < 150) {
                        // Check if bullet is moving towards us
                        const toMe = this.pos.sub(p.pos).normalize();
                        if (p.vel.normalize().dot(toMe) > 0.7) {
                            // DODGE!
                            this.isDashing = true;
                            this.dashTimer = 1.5; // Cooldown
                            // Dash perpendicular to bullet
                            const perp = new Vector(-p.vel.y, p.vel.x).normalize();
                            // Pick side away from player or random
                            const side = Math.random() > 0.5 ? 1 : -1;
                            this.overrideDir = perp.mult(side);
                            speed = 800; // Fast dodge
                            game.texts.push(new FloatingText(this.pos, "DODGE!", "#0ff"));
                            break;
                        }
                    }
                }
            }

            // 2. Ram Attack
            if (this.dashTimer <= 0) {
                this.isDashing = true;
                this.dashTimer = this.config.type === 'boss_psycho' ? 2.0 : 4.0;
                speed = this.config.type === 'boss_psycho' ? 900 : 700;
                this.overrideDir = game.player.pos.sub(this.pos).normalize(); // Lock direction
                game.spawnParticles(this.pos, '#fff', 5);
            }
            
            // Dash Duration
            if (this.isDashing) {
                if (this.dashTimer > (this.config.type === 'boss_psycho' ? 1.5 : 3.5)) {
                    // Dashing phase (0.5s)
                    speed = this.config.type === 'boss_psycho' ? 900 : 700;
                } else {
                    this.isDashing = false;
                    this.overrideDir = null; // Release control
                }
            }

            // 3. Stealth & Shooting (The "Scumbag" part)
            this.specialTimer -= dt;
            if (this.specialTimer <= 0) {
                if (Math.random() > 0.5) {
                    // Stealth Mode
                    this.isStealthed = true;
                    this.specialTimer = 2.0; // Stay hidden
                    game.texts.push(new FloatingText(this.pos, "STEALTH", "#888"));
                } else {
                    // Shoot
                    this.isStealthed = false;
                    this.specialTimer = 3.0;
                    const shotDir = game.player.pos.sub(this.pos).normalize();
                    game.projectiles.push(new Projectile(this.pos, shotDir.mult(400), this.damage, 'bullet', 'enemy'));
                }
            }
        }
        
        // Healer Logic
        if (this.config.type === 'healer') {
            this.healTimer -= dt;
            if (this.healTimer <= 0) {
                this.healTimer = 1.0;
                // Find injured friend
                const friend = game.enemies.find(e => e !== this && e.hp < e.maxHp && e.pos.sub(this.pos).mag() < 200);
                if (friend) {
                    friend.hp = Math.min(friend.maxHp, friend.hp + 20);
                    game.spawnParticles(friend.pos, '#0f0', 5);
                }
            }
        }
        
        // Exploder Logic
        if (this.config.type === 'exploder') {
            if (this.pos.sub(game.player.pos).mag() < this.radius + game.player.radius + 10) {
                 this.hp = 0; // Die
                 game.player.hp -= this.damage * 2; // Scale with difficulty
                 game.screenShake = 20;
                 game.spawnParticles(this.pos, '#ff8800', 20);
                 game.texts.push(new FloatingText(this.pos, "BOOM!", "#f00"));
                 game.onEnemyDeath(this); // Trigger death logic
                 if (game.player.hp <= 0) game.gameOver(`ВЗРЫВ: ${this.config.id.toUpperCase()}`);
            }
        }
        
        // Tank Heavy: Ground Slam (Mini Boss 3)
        if (this.config.id === 'tank_heavy') {
            const dist = game.player.pos.sub(this.pos).mag();
            if (dist < 150) {
                speed = 0; // Stop to slam
                this.specialTimer -= dt;
                if (this.specialTimer <= 0) {
                    this.specialTimer = 3.0; // Cooldown
                    game.screenShake = 10;
                    game.spawnParticles(this.pos, '#fff', 20);
                    // AOE Damage
                    if (dist < 100) {
                        game.player.hp -= this.damage * 1.5;
                        game.texts.push(new FloatingText(game.player.pos, "CRUSH!", "#f00"));
                        game.updateHud();
                        if (game.player.hp <= 0) game.gameOver(`РАЗДАВЛЕН: ${this.config.id.toUpperCase()}`);
                    }
                }
            } else {
                // Reset timer if player runs away so it's ready next time
                if (this.specialTimer < 1.0) this.specialTimer = 1.0; 
            }
        }
        
        // Vampire: Bat Swarm (Mini Boss 5)
        if (this.config.id === 'vampire') {
            this.specialTimer -= dt;
            if (this.specialTimer <= 0) {
                this.specialTimer = 3.0;
                // Shoot 3 projectiles spread
                const baseAngle = Math.atan2(dir.y, dir.x);
                for(let i=-1; i<=1; i++) {
                    const a = baseAngle + i * 0.4;
                    const v = new Vector(Math.cos(a), Math.sin(a)).mult(300);
                    game.projectiles.push(new Projectile(this.pos, v, 8, 'bullet', 'enemy'));
                }
            }
        }

        // Summoner Logic (Regular & Boss)
        if (this.config.type === 'summoner' || this.config.type === 'boss_summoner') {
            this.specialTimer -= dt;
            if (this.specialTimer <= 0) {
                this.specialTimer = this.config.type === 'boss_summoner' ? 3.0 : 6.0;
                const type = this.config.type === 'boss_summoner' ? 'basic_norm' : 'basic_weak';
                // Spawn minion nearby
                const offset = new Vector(Math.random()*60-30, Math.random()*60-30);
                const minion = new Enemy(this.pos.add(offset), type, game.director.wave, false);
                game.enemies.push(minion);
                game.spawnParticles(this.pos, '#a020f0', 10);
            }
        }
        
        // Builder Logic
        if (this.config.type === 'builder') {
            this.specialTimer -= dt;
            if (this.specialTimer <= 0) {
                this.specialTimer = 15.0; // Build every 15s
                // Stop to build
                speed = 0;
                setTimeout(() => {
                    if (this.dead) return;
                    const type = this.config.id === 'builder_turret' ? 'turret' : 'camp';
                    game.enemyStructures.push(new EnemyStructure(this.pos, type));
                    game.texts.push(new FloatingText(this.pos, "BUILDING!", "#fff"));
                    game.spawnParticles(this.pos, '#fff', 10);
                }, 1000); // 1s delay
            }
            // Enforce stop during build animation
            if (this.specialTimer > 14.0) speed = 0;
        }

        // Stealth Logic
        if (this.config.type === 'stealth') {
            this.specialTimer -= dt;
            if (this.specialTimer <= 0) {
                this.isStealthed = !this.isStealthed;
                this.specialTimer = this.isStealthed ? 2.0 : 3.0; // 2s hidden, 3s visible
            }
        }

        // Boss Sniper Logic
        if (this.config.type === 'boss_sniper') {
            this.specialTimer -= dt;
            if (this.specialTimer <= 0) this.specialTimer = 4.0;
            
            // Shoot at specific timing (e.g. at 1.0s remaining)
            if (this.specialTimer <= 1.0 && this.specialTimer > 0.9) {
                 const shotDir = game.player.pos.sub(this.pos).normalize();
                 game.projectiles.push(new Projectile(this.pos, shotDir.mult(1200), this.damage * 3, 'laser', 'enemy'));
                 this.specialTimer = 0.9; // Prevent multi-shot
                 game.screenShake = 10;
            }
        }

        // Boss Tank Logic (Shield Regen)
        if (this.config.type === 'boss_tank') {
            this.specialTimer -= dt;
            if (this.specialTimer <= 0) {
                this.specialTimer = 10.0;
                this.shield = Math.min(this.maxShield, this.shield + this.maxShield * 0.3);
                game.texts.push(new FloatingText(this.pos, "SHIELD UP", "#00f"));
            }
        }

        // Boss Charger Logic (Fire Trail)
        if (this.config.type === 'boss_charger') {
            this.dashTimer -= dt;
            if (this.dashTimer <= 0) { this.isDashing = true; this.dashTimer = 2.5; speed = 700; }
            if (this.dashTimer > 2.0) { speed = 700; game.spawnParticles(this.pos, '#ff5500', 1); } // Trail
            else this.isDashing = false;
        }

        // Boss Hell Logic (Spiral)
        if (this.config.type === 'boss_hell') {
            this.specialTimer -= dt;
            if (this.specialTimer <= 0) {
                this.specialTimer = 0.15;
                const angle = performance.now() / 150;
                const vel1 = new Vector(Math.cos(angle), Math.sin(angle)).mult(300);
                const vel2 = new Vector(Math.cos(angle + Math.PI), Math.sin(angle + Math.PI)).mult(300);
                game.projectiles.push(new Projectile(this.pos, vel1, this.damage, 'bullet', 'enemy'));
                game.projectiles.push(new Projectile(this.pos, vel2, this.damage, 'bullet', 'enemy'));
            }
        }
        
        // Boss 7: Psycho Triangle
        if (this.config.type === 'boss_psycho') {
            // Bullet Hell Spiral
            this.shootTimer -= dt;
            if (this.shootTimer <= 0) {
                this.shootTimer = 0.1;
                const angle = performance.now() / 100;
                const v = new Vector(Math.cos(angle), Math.sin(angle)).mult(400);
                game.projectiles.push(new Projectile(this.pos, v, this.damage, 'bullet', 'enemy'));
                const v2 = new Vector(Math.cos(angle+Math.PI), Math.sin(angle+Math.PI)).mult(400);
                game.projectiles.push(new Projectile(this.pos, v2, this.damage, 'bullet', 'enemy'));
            }
            
            // Random Teleport/Stealth
            if (Math.random() < 0.01 && !this.isStealthed) {
                this.isStealthed = true;
                setTimeout(() => { this.isStealthed = false; }, 1500);
                // Teleport near player
                const offset = new Vector((Math.random()-0.5)*400, (Math.random()-0.5)*400);
                this.pos = game.player.pos.add(offset);
                game.spawnParticles(this.pos, '#ff00ff', 20);
            }
        }

        this.pos = this.pos.add(dir.mult(speed * dt));

        // Boundary Check (Keep inside map)
        this.pos.x = Math.max(this.radius, Math.min(CANVAS_W - this.radius, this.pos.x));
        this.pos.y = Math.max(this.radius, Math.min(CANVAS_H - this.radius, this.pos.y));
      }
      
      // Separation (prevent stacking)
      game.enemies.forEach(other => {
        if (other === this) return;
        const dist = other.pos.sub(this.pos).mag();
        if (dist < this.radius + other.radius) {
          const push = this.pos.sub(other.pos).normalize().mult(50 * dt);
          this.pos = this.pos.add(push);
        }
      });
    }

    draw(ctx: CanvasRenderingContext2D) {
      ctx.save();
      ctx.translate(this.pos.x, this.pos.y);
      
      // Body Rotation Scope
      ctx.save();
      if (this.config.type !== 'shielder') ctx.rotate(this.angle); // Shielder rotates in update logic, others visual only
      
      ctx.globalAlpha = this.spawnFade * (this.isStealthed ? 0.2 : 1.0);

      ctx.fillStyle = this.color;
      ctx.shadowBlur = 10; ctx.shadowColor = this.color;
      
      if (this.config.type === 'melee') {
        ctx.fillRect(-this.radius, -this.radius, this.radius*2, this.radius*2);
      } else if (this.config.type === 'charger') {
        ctx.beginPath(); ctx.moveTo(0, -this.radius); ctx.lineTo(this.radius, this.radius); ctx.lineTo(-this.radius, this.radius); ctx.fill();
      } else if (this.config.type === 'healer') {
        ctx.font = '20px Arial'; ctx.fillStyle='#fff'; ctx.fillText('+', -5, 5);
      } else if (this.config.type === 'exploder') {
        // Pulsing
        const s = 1 + Math.sin(performance.now()/100)*0.2;
        ctx.scale(s, s);
        ctx.beginPath(); ctx.arc(0, 0, this.radius, 0, Math.PI*2); ctx.fill();
      } else if (this.config.id.includes('boss')) {
        ctx.beginPath(); 
        const spikes = 8;
        for(let i=0; i<spikes*2; i++) {
            const r = i%2===0 ? this.radius : this.radius/2;
            const a = (Math.PI*2 * i) / (spikes*2) + performance.now()/500;
            ctx.lineTo(Math.cos(a)*r, Math.sin(a)*r);
        }
        ctx.fill();
      } else {
        ctx.beginPath(); ctx.arc(0, 0, this.radius, 0, Math.PI*2); ctx.fill();
      }
      
      ctx.restore(); // End Body Rotation

      // Shielder Shield
      if (this.config.type === 'shielder') {
          ctx.rotate(this.angle); // Apply rotation for shield drawing
          ctx.beginPath();
          ctx.arc(0, 0, this.radius + 8, -Math.PI/3, Math.PI/3); // 120 degree arc
          ctx.strokeStyle = '#00ffff';
          ctx.lineWidth = 4;
          ctx.stroke();
          ctx.rotate(-this.angle); // Reset for bars
      }
      
      // Cage Master Visuals
      if (this.config.type === 'cage_master') {
          if (this.cageActive) {
              ctx.beginPath();
              ctx.arc(0, 0, this.cageRadius, 0, Math.PI*2);
              ctx.strokeStyle = `rgba(0, 0, 255, ${0.5 + Math.sin(performance.now()/200)*0.2})`;
              ctx.lineWidth = 5;
              ctx.stroke();
              // Floor effect
              ctx.fillStyle = 'rgba(0, 0, 255, 0.05)';
              ctx.fill();
          } else {
              // Shield icon when invulnerable
              ctx.strokeStyle = '#fff'; ctx.lineWidth = 2;
              ctx.beginPath(); ctx.arc(0, 0, this.radius + 5, 0, Math.PI*2); ctx.stroke();
          }
      }

      // Wall Runner Walls
      if (this.config.type === 'wall_runner') {
          ctx.restore(); // Go to world space
          ctx.save(); // Save again for walls
          this.walls.forEach(w => {
              ctx.translate(w.pos.x, w.pos.y);
              ctx.rotate(w.angle);
              ctx.fillStyle = 'rgba(0, 255, 136, 0.6)';
              ctx.shadowBlur = 10; ctx.shadowColor = '#00ff88';
              ctx.fillRect(-w.size.x/2, -w.size.y/2, w.size.x, w.size.y);
              ctx.shadowBlur = 0;
              ctx.rotate(-w.angle);
              ctx.translate(-w.pos.x, -w.pos.y);
          });
          ctx.restore(); // Back to world space
          ctx.save(); // Back to enemy local space for bars
          ctx.translate(this.pos.x, this.pos.y);
      }

      // Boss Sniper Laser Warning
      if (this.config.type === 'boss_sniper' && this.specialTimer > 1.0 && this.specialTimer < 2.5) {
          ctx.restore(); ctx.save(); // Reset transform to draw line in world space
          ctx.beginPath();
          ctx.moveTo(this.pos.x, this.pos.y);
          ctx.lineTo(game.player.pos.x, game.player.pos.y);
          ctx.strokeStyle = `rgba(255, 0, 0, ${Math.random()})`;
          ctx.lineWidth = 1;
          ctx.stroke();
          ctx.translate(this.pos.x, this.pos.y); // Restore for bars
      }
      
      // Regular Sniper Laser Warning (Mini Boss 2)
      if (this.config.id === 'sniper' && this.shootTimer < 0.5 && this.shootTimer > 0) {
          ctx.restore(); ctx.save();
          ctx.beginPath();
          ctx.moveTo(this.pos.x, this.pos.y);
          ctx.lineTo(game.player.pos.x, game.player.pos.y);
          ctx.strokeStyle = 'rgba(255, 0, 0, 0.5)';
          ctx.lineWidth = 1;
          ctx.setLineDash([5, 5]);
          ctx.stroke();
          ctx.translate(this.pos.x, this.pos.y);
      }
      
      // HP Bar under enemy
      const hpPct = Math.min(1, Math.max(0, this.hp / this.maxHp));
      ctx.fillStyle = '#333'; ctx.fillRect(-20, 25, 40, 4);
      ctx.fillStyle = '#f00'; ctx.fillRect(-20, 25, 40 * hpPct, 4);
      
      // Shield Bar
      if (this.shield > 0) {
          const shPct = this.shield / this.maxShield;
          ctx.fillStyle = '#ffd700'; ctx.fillRect(-20, 21, 40 * shPct, 4);
      }
      
      ctx.restore();
    }

    isVisible() {
        return this.pos.x >= 0 && this.pos.x <= CANVAS_W && this.pos.y >= 0 && this.pos.y <= CANVAS_H;
    }
  }

  class Invader extends Enemy {
      name: string;
      className: string;
      abilityTimer = 0;
      
      constructor(pos: Vector, level: number) {
          super(pos, 'basic_norm', level, true); // Base config
          this.config = { ...this.config, type: 'invader', speed: 200 + Math.random() * 100, color: '#ff0000', id: 'invader' };
          
          this.name = CHAT_USERNAMES[Math.floor(Math.random() * CHAT_USERNAMES.length)];
          const cls = CLASSES[Math.floor(Math.random() * CLASSES.length)];
          this.className = cls.name;
          
          // Stats scaling (Max 2x player)
          const p = game.player;
          const mult = 0.5 + Math.random() * 1.5;
          this.hp = p.maxHp * mult;
          this.maxHp = this.hp;
          this.damage = p.damage * mult;
          this.shield = this.maxHp; // Invaders always have shield equal to HP
          this.maxShield = this.maxHp;
          this.radius = 20;
      }
      
      override update(dt: number) {
        if (this.hitCooldown > 0) this.hitCooldown -= dt;
        // Spawn Fade-in
        if (this.spawnFade < 1) this.spawnFade = Math.min(1, this.spawnFade + dt / 0.3);

        // Find Target (Player or other Enemy)
        let target: Entity = game.player;
        let minD = this.pos.sub(game.player.pos).mag();
        
        // Check for other enemies to attack
        for (const e of game.enemies) {
            if (e === this) continue;
            const d = this.pos.sub(e.pos).mag();
            if (d < minD) {
                minD = d;
                target = e;
            }
        }
        
        const dist = minD;
        const dir = target.pos.sub(this.pos).normalize();
        
        // Movement AI
        let moveDir = dir;
        if (dist < 150) moveDir = dir.mult(-1); // Kite
        else if (dist > 300) moveDir = dir; // Chase
        else moveDir = new Vector(dir.y, -dir.x); // Strafe
        
        // Bounds
        this.pos = this.pos.add(moveDir.mult(this.config.speed * dt));
        this.pos.x = Math.max(20, Math.min(CANVAS_W - 20, this.pos.x));
        this.pos.y = Math.max(20, Math.min(CANVAS_H - 20, this.pos.y));
        
        // Shooting
        this.shootTimer -= dt;
        if (this.shootTimer <= 0 && dist < 600) {
            this.shootTimer = 0.5; // Fire rate
            const shotDir = target.pos.sub(this.pos).normalize();
            // Add spread
            const angle = Math.atan2(shotDir.y, shotDir.x) + (Math.random()-0.5)*0.2;
            const vel = new Vector(Math.cos(angle), Math.sin(angle)).mult(500);
            
            game.projectiles.push(new Projectile(this.pos, vel, this.damage, 'bullet', 'invader', this));
        }
        
        // Ability Usage
        this.abilityTimer -= dt;
        if (this.abilityTimer <= 0) {
            this.abilityTimer = 5 + Math.random() * 10;
            this.useAbility();
        }

        // Separation (prevent stacking)
        game.enemies.forEach(other => {
            if (other === this) return;
            const d = other.pos.sub(this.pos).mag();
            if (d < this.radius + other.radius) {
                const push = this.pos.sub(other.pos).normalize().mult(50 * dt);
                this.pos = this.pos.add(push);
            }
        });
      }
      
      useAbility() {
        game.texts.push(new FloatingText(this.pos, "ABILITY!", "#ff0"));
        game.spawnParticles(this.pos, '#ff0', 10);
        const roll = Math.random();
        if (roll < 0.33) {
            this.hp = Math.min(this.maxHp, this.hp + this.maxHp * 0.3); // Heal
        } else if (roll < 0.66) {
            // Dash
            const dir = new Vector(Math.random()-0.5, Math.random()-0.5).normalize();
            this.pos = this.pos.add(dir.mult(200));
        } else {
            // AoE
            game.projectiles.push(new Projectile(this.pos, new Vector(0,0), this.damage*2, 'rocket', 'invader', this));
        }
      }
      
      override draw(ctx: CanvasRenderingContext2D) {
          super.draw(ctx);
          // Draw Name
          ctx.fillStyle = '#f00';
          ctx.font = '10px Orbitron';
          ctx.textAlign = 'center';
          ctx.fillText(this.name, this.pos.x, this.pos.y - 30);
          ctx.fillStyle = '#fff';
          ctx.font = '8px Arial';
          ctx.fillText(`[${this.className}]`, this.pos.x, this.pos.y - 40);
      }
  }

  // --- NEW ENTITIES ---
  class Drone extends Entity {
      angle = 0;
      shootTimer = 0;
      constructor(public owner: Player, public offset: number) {
          super(owner.pos, 8, '#00ff00');
      }
      update(dt: number) {
          this.angle += 2 * dt;
          this.pos.x = this.owner.pos.x + Math.cos(this.angle + this.offset) * 60;
          this.pos.y = this.owner.pos.y + Math.sin(this.angle + this.offset) * 60;
          
          this.shootTimer -= dt;
          if (this.shootTimer <= 0) {
              // Find nearest target
              let target = null;
              let minD = 300;
              for(const e of game.enemies) {
                  const d = e.pos.sub(this.pos).mag();
                  if (d < minD) { minD = d; target = e; }
              }
              if (target) {
                   const dir = target.pos.sub(this.pos).normalize();
                   game.projectiles.push(new Projectile(this.pos, dir.mult(600), 5 * this.owner.droneDmgMult, 'bullet', 'player'));
                   this.shootTimer = 1.0;
              }
          }
      }
      draw(ctx: CanvasRenderingContext2D) {
          ctx.fillStyle = this.color;
          ctx.beginPath(); ctx.arc(this.pos.x, this.pos.y, this.radius, 0, Math.PI*2); ctx.fill();
      }
  }

  class Turret extends Entity {
      life = 20;
      shootTimer = 0;
      constructor(pos: Vector) { super(pos, 15, '#aaa'); }
      update(dt: number) {
          this.life -= dt;
          if (this.life <= 0) this.dead = true;
          this.shootTimer -= dt;
          if (this.shootTimer <= 0) {
              // Shoot nearest
              let target = null; let minD = 400;
              for(const e of game.enemies) {
                  const d = e.pos.sub(this.pos).mag();
                  if (d < minD) { minD = d; target = e; }
              }
              if (target) {
                  const dir = target.pos.sub(this.pos).normalize();
                  game.projectiles.push(new Projectile(this.pos, dir.mult(700), 8, 'bullet', 'player'));
                  this.shootTimer = 0.5;
              }
          }
      }
      draw(ctx: CanvasRenderingContext2D) {
          ctx.fillStyle = '#444'; ctx.fillRect(this.pos.x-10, this.pos.y-10, 20, 20);
          ctx.fillStyle = '#0f0'; ctx.fillRect(this.pos.x-5, this.pos.y-15, 10, 10); // Head
      }
  }

  class Mine extends Entity {
      constructor(pos: Vector) { super(pos, 10, '#ff0000'); }
      update(dt: number) {
          for(const e of game.enemies) {
              if (e.pos.sub(this.pos).mag() < 30) {
                  this.dead = true;
                  e.hp -= 50;
                  game.spawnParticles(this.pos, '#ff0000', 10);
                  game.screenShake = 10;
                  game.texts.push(new FloatingText(this.pos, "BOOM", "#f00"));
              }
          }
      }
      draw(ctx: CanvasRenderingContext2D) {
          ctx.fillStyle = '#f00';
          ctx.beginPath(); ctx.arc(this.pos.x, this.pos.y, this.radius, 0, Math.PI*2); ctx.fill();
          // Blink
          if (Math.floor(Date.now() / 200) % 2 === 0) {
              ctx.fillStyle = '#fff';
              ctx.beginPath(); ctx.arc(this.pos.x, this.pos.y, 3, 0, Math.PI*2); ctx.fill();
          }
      }
  }

  // --- PLAYER ---
  class Player extends Entity {
    vel: Vector = new Vector(0,0);
    hp: number;
    maxHp: number;
    xp: number = 0;
    maxXp: number = 100;
    level: number = 1;
    
    // Stats
    speed = 300;
    fireRate = 0.2;
    damage = 10;
    multishot = 1;
    regen = 0;
    knockback = 0;
    weapon: 'blaster' | 'shotgun' | 'laser' | 'rocket' | 'plasma' = 'blaster';
    
    // Tree Stats
    critChance = 0;
    critMult = 1.5;
    aoeRadius = 1.0;
    bossDmgMult = 1.0;
    eliteDmgMult = 1.0;
    lifesteal = 0;
    thorns = 0;
    thornsPct = 0;
    dodge = 0;
    xpMult = 1.0;
    extraLives = 0;
    ricochet = false;
    homing = false;
    lightning = false;
    execute = false;
    magnet = 0;
    luck = 0;
    
    heat = 0;
    maxHeat = 100;
    isOverheated = false;
    overheatTimer = 0;
    heatDmgBonus = 0.5; // 50% max bonus by default
    heatCooling = 80;
    heatGenMult = 1.0;
    
    // New Params
    spread = 0; // Degrees
    projSpeedMult = 1.0;
    fragChance = 0;
    damageTakenMult = 1.0; // Curse
    moveSpeedMult = 1.0; // Slow (if < 1)
    
    droneDmgMult = 1.0;
    classSkillCdReduction = 0;
    mineCdReduction = 0;
    
    // New Mechanics
    drones: Drone[] = [];
    turretCooldown = 0;
    mineCooldown = 0;
    synergyBonus = 0;
    droneCount = 0;
    turretDuration = 20;
    runeDurationMult = 1.0;
    questRewardMult = 1.0;
    merchantDiscount = 0.0;
    activeRunes: { type: string, timer: number }[] = [];
    
    // Class Specific
    sniperShot = false;
    isStealthed = false;
    
    dashCooldownMax = 3.0;
    cooldownMult = 1.0;

    shootTimer = 0;
    
    // Ultimates
    dashCooldown = 0;
    nukeCooldown = 0;

    constructor() {
      super(new Vector(CANVAS_W/2, CANVAS_H/2), 20, '#0ff');
      // Apply Meta Upgrades
      this.maxHp = 100 + (meta.upgrades.startHp * 10);
      this.damage = 10 + (meta.upgrades.baseDmg * 2);
      this.speed = 300 + (meta.upgrades.moveSpeed * 10);
      this.fireRate = 0.2 * Math.pow(0.95, meta.upgrades.fireRate);
      this.knockback = meta.upgrades.knockback * 50;
      this.magnet = meta.upgrades.magnet;
      this.luck = meta.upgrades.luck;
      
      // Class Bonuses
      if (selectedClass === 'engineer') {
          this.droneCount += 1;
          this.damage *= 0.8;
      } else if (selectedClass === 'psycho') {
          this.damage *= 1.5;
          this.maxHp *= 0.7;
          this.speed *= 1.2;
      } else if (selectedClass === 'sniper') {
          this.damage *= 2.0;
          this.fireRate *= 0.5; // Slower
          this.critChance += 0.2;
      } else if (selectedClass === 'tank') {
          this.maxHp *= 2.0;
          this.speed *= 0.8;
          this.thorns += 5;
      } else if (selectedClass === 'scout') {
          this.speed *= 1.3;
          this.dodge += 0.2;
          this.maxHp *= 0.7;
      } else if (selectedClass === 'mage') {
          this.damage *= 1.2;
          this.maxHp *= 0.8;
      } else if (selectedClass === 'summoner') {
          this.damage *= 0.5;
          this.droneCount += 2;
      } else if (selectedClass === 'gambler') {
          this.luck += 50;
          this.critMult += 1.5; // x3 total
          this.critChance += 0.1;
          this.damage *= 0.8;
      } else if (selectedClass === 'ninja') {
          this.speed *= 1.2;
          this.dodge += 0.1;
          this.damage *= 1.2; // Melee focus implied
      } else if (selectedClass === 'cyborg') {
          this.regen += 2;
          if (meta.unlocks.includes('w_laser')) {
              this.weapon = 'laser'; // Starts with laser if unlocked
          }
      }
      // Marine is default
      
      // Apply Tree Upgrades
      meta.skillTree.forEach(id => {
        const node = TREE_NODES.find(n => n.id === id);
        if (node) node.effect(this);
      });
      
      this.hp = this.maxHp;
      
      // Apply Equipment Stats (RPG)
      const equip = meta.equipment;
      
      try {
          let setCounts: Record<string, number> = {};
          
          // Count Sets
          [equip.weapon, equip.armor, equip.chip].forEach(item => {
              if (item && item.setId) {
                  setCounts[item.setId] = (setCounts[item.setId] || 0) + 1;
              }
          });
          
          [equip.weapon, equip.armor, equip.chip].forEach(item => {
              if (item && item.stats) {
                  if (item.stats.hp) this.maxHp += item.stats.hp;
                  if (item.stats.dmg) this.damage += item.stats.dmg;
                  if (item.stats.spd) this.speed += item.stats.spd;
                  if (item.stats.crit) this.critChance += item.stats.crit;
                  if (item.stats.cooldown) this.cooldownMult *= (1 - item.stats.cooldown);
                  if (item.stats.area) this.aoeRadius += item.stats.area;
                  if (item.stats.regen) this.regen += item.stats.regen;
                  if (item.stats.luck) this.luck += item.stats.luck;
                  if (item.stats.lifesteal) this.lifesteal += item.stats.lifesteal;
                  if (item.stats.dodge) this.dodge += item.stats.dodge;
                  if (item.stats.thorns) this.thorns += item.stats.thorns;
                  if (item.stats.knockback) this.knockback += item.stats.knockback;
                  if (item.stats.magnet) this.magnet += item.stats.magnet;
                  if (item.stats.multishot) this.multishot += item.stats.multishot;
              }
              
              // Apply Set Bonuses if active (3 items)
              // NOTE: We only READ setStats here, we do NOT generate them.
              if (item && item.setId && item.setStats && setCounts[item.setId] >= 3) {
                  const isCorrupted = item.isCorrupted; // Check corruption for x2 bonus
                  for (const [key, val] of Object.entries(item.setStats)) {
                      let bonus = val;
                      if (isCorrupted) bonus *= 2; // Double bonus for corrupted item

                      if (key === 'hp') this.maxHp += bonus;
                      if (key === 'dmg') this.damage += bonus;
                      if (key === 'spd') this.speed += bonus;
                      if (key === 'crit') this.critChance += bonus;
                      if (key === 'cooldown') this.cooldownMult *= (1 - bonus);
                      if (key === 'area') this.aoeRadius += bonus;
                      if (key === 'regen') this.regen += bonus;
                      if (key === 'luck') this.luck += bonus;
                      if (key === 'lifesteal') this.lifesteal += bonus;
                      if (key === 'dodge') this.dodge += bonus;
                      if (key === 'thorns') this.thorns += bonus;
                      if (key === 'spread') this.spread += bonus;
                      if (key === 'projSpeed') this.projSpeedMult += bonus;
                      if (key === 'frag') this.fragChance += bonus;
                      if (key === 'curse') this.damageTakenMult += bonus;
                      if (key === 'slow') this.moveSpeedMult *= (1 - bonus);
                  }
              }
          });
          
          // Synergy Bonus (3 items of same rarity)
          Object.values(setCounts).forEach(count => {
              if (count >= 3) this.synergyBonus = 0.5; // +50% Damage
          });
          this.damage *= (1 + this.synergyBonus);
      } catch (e) {
          console.error("Error applying equipment stats:", e);
      }
      
      
      this.hp = this.maxHp; // Heal to full with new max
    }

    update(dt: number) {
      // Movement
      let input = new Vector(0,0);
      // e.code is physical key. KeyW is W on QWERTY and Ц on JCUKEN.
      if (keys['KeyW'] || keys['ArrowUp']) input.y -= 1;
      if (keys['KeyS'] || keys['ArrowDown']) input.y += 1;
      if (keys['KeyA'] || keys['ArrowLeft']) input.x -= 1;
      if (keys['KeyD'] || keys['ArrowRight']) input.x += 1;
      
      if (input.mag() > 0) input = input.normalize();
      
      // Physics: Acceleration & Friction based on Stats
      // We want MaxSpeed to equal this.speed.
      // Formula: MaxSpeed = Accel / Friction.
      // So, Accel = this.speed * Friction.
      const friction = 8.0; // Damping factor (higher = snappier movement)
      const accel = this.speed * this.moveSpeedMult * friction;
      
      this.vel = this.vel.add(input.mult(accel * dt));
      this.vel = this.vel.sub(this.vel.mult(friction * dt)); // Apply drag

      // Weather: Rain slows player
      if (game.director.weather === 'rain') this.vel = this.vel.mult(0.85); // More slippery/slow
      
      this.pos = this.pos.add(this.vel.mult(dt));

      // Bounds
      // Anomaly: Zero G (Bouncy walls?) - No, just keep bounds
      this.pos.x = Math.max(20, Math.min(CANVAS_W - 20, this.pos.x));
      this.pos.y = Math.max(20, Math.min(CANVAS_H - 20, this.pos.y));

      // Cage Constraint (Cage Master)
      game.enemies.forEach(e => {
          if (e.config.type === 'cage_master' && e.cageActive) {
              const dist = this.pos.sub(e.pos).mag();
              const limit = e.cageRadius - this.radius;
              if (dist > limit) {
                  // Clamp position inside
                  const dir = this.pos.sub(e.pos).normalize();
                  this.pos = e.pos.add(dir.mult(limit));
              }
          }
      });

      // Dash Ultimate
      if (this.dashCooldown > 0) this.dashCooldown -= dt;
      if (keys['Space'] && this.dashCooldown <= 0 && meta.unlocks.includes('ult_dash')) {
          this.dashCooldown = this.dashCooldownMax * this.cooldownMult;
          const dashDir = this.vel.mag() > 0 ? this.vel.normalize() : new Vector(1,0);
          this.pos = this.pos.add(dashDir.mult(150));
          game.spawnParticles(this.pos, '#0ff', 10);
      }

      // Nuke Ultimate
      if (this.nukeCooldown > 0) this.nukeCooldown -= dt;
      if (keys['KeyF'] && this.nukeCooldown <= 0 && meta.unlocks.includes('ult_nuke')) {
          this.nukeCooldown = 60.0 * this.cooldownMult;
          game.triggerNuke();
      }
      
      // Turret (E)
      if (this.turretCooldown > 0) this.turretCooldown -= dt;
      if (keys['KeyE'] && this.turretCooldown <= 0 && selectedClass === 'psycho') {
          this.turretCooldown = 15.0 * this.cooldownMult; // Cooldown
          game.turrets.push(new Turret(this.pos));
          game.texts.push(new FloatingText(this.pos, "ТУРЕЛЬ", "#0f0"));
      }

      // Mine (Q)
      if (this.mineCooldown > 0) this.mineCooldown -= dt;
      if (keys['KeyQ'] && this.mineCooldown <= 0 && selectedClass === 'psycho') {
          this.mineCooldown = Math.max(1.0, 5.0 - this.mineCdReduction) * this.cooldownMult;
          game.mines.push(new Mine(this.pos));
          game.texts.push(new FloatingText(this.pos, "МИНА", "#f00"));
      }
      
      // Class Skills (E)
      if (keys['KeyE'] && this.turretCooldown <= 0) {
          if (selectedClass === 'sniper') {
              this.turretCooldown = Math.max(2.0, 10.0 - this.classSkillCdReduction) * this.cooldownMult;
              this.sniperShot = true;
              game.texts.push(new FloatingText(this.pos, "ТОЧНЫЙ ВЫСТРЕЛ", "#f00"));
          } else if (selectedClass === 'tank') {
              this.turretCooldown = Math.max(5.0, 20.0 - this.classSkillCdReduction) * this.cooldownMult;
              this.hp += 100; // Temp heal/shield
              game.texts.push(new FloatingText(this.pos, "ЩИТ", "#00f"));
          } else if (selectedClass === 'scout') {
              this.turretCooldown = Math.max(1.0, 5.0 - this.classSkillCdReduction) * this.cooldownMult;
              const dashDir = this.vel.mag() > 0 ? this.vel.normalize() : new Vector(1,0);
              this.pos = this.pos.add(dashDir.mult(250)); // Super dash
              game.spawnParticles(this.pos, '#ff0', 10);
          } else if (selectedClass === 'mage') {
              this.turretCooldown = Math.max(3.0, 10.0 - this.classSkillCdReduction) * this.cooldownMult;
              // Nova
              for(let i=0; i<20; i++) {
                  const a = (Math.PI*2/20)*i;
                  const v = new Vector(Math.cos(a), Math.sin(a)).mult(500);
                  game.projectiles.push(new Projectile(this.pos, v, this.damage*2, 'bullet', 'player'));
              }
              game.texts.push(new FloatingText(this.pos, "КОЛЬЦО ОГНЯ", "#f00"));
          } else if (selectedClass === 'summoner') {
              this.turretCooldown = Math.max(5.0, 15.0 - this.classSkillCdReduction) * this.cooldownMult;
              game.turrets.push(new Turret(this.pos)); // Reuse turret
              game.texts.push(new FloatingText(this.pos, "ПОДКРЕПЛЕНИЕ", "#0f0"));
          } else if (selectedClass === 'gambler') {
              this.turretCooldown = Math.max(5.0, 15.0 - this.classSkillCdReduction) * this.cooldownMult;
              const roll = Math.random();
              if (roll < 0.33) {
                  this.damage *= 2; setTimeout(() => this.damage /= 2, 10000);
                  game.texts.push(new FloatingText(this.pos, "УРОН x2", "#ffd700"));
              } else if (roll < 0.66) {
                  this.speed *= 1.5; setTimeout(() => this.speed /= 1.5, 10000);
                  game.texts.push(new FloatingText(this.pos, "СКОРОСТЬ x1.5", "#0ff"));
              } else {
                  game.texts.push(new FloatingText(this.pos, "ПУСТО...", "#888"));
              }
          } else if (selectedClass === 'ninja') {
              this.turretCooldown = Math.max(5.0, 15.0 - this.classSkillCdReduction) * this.cooldownMult;
              this.isStealthed = true;
              game.texts.push(new FloatingText(this.pos, "ИСЧЕЗНОВЕНИЕ", "#fff"));
              setTimeout(() => this.isStealthed = false, 3000);
          } else if (selectedClass === 'cyborg') {
              this.turretCooldown = Math.max(5.0, 20.0 - this.classSkillCdReduction) * this.cooldownMult;
              const oldRate = this.fireRate;
              this.fireRate *= 0.2; // Super fast
              game.texts.push(new FloatingText(this.pos, "ОВЕРДРАЙВ", "#f00"));
              setTimeout(() => {
                  this.fireRate = oldRate;
                  this.isOverheated = true;
                  this.overheatTimer = 3.0;
                  this.heat = this.maxHeat;
                  game.texts.push(new FloatingText(this.pos, "ПЕРЕГРЕВ", "#f00"));
              }, 5000);
          }
      }
      
      // Regen
      if (this.regen > 0 && this.hp < this.maxHp) {
          this.hp += this.regen * dt;
      }
      
      // Rune: Regen
      if (this.activeRunes.some(r => r.type === 'regen')) this.hp = Math.min(this.maxHp, this.hp + 10 * dt);

      // Heat Logic
      if (this.isOverheated) {
          this.overheatTimer -= dt;
          if (this.overheatTimer <= 0) {
              this.isOverheated = false;
              this.heat = 0;
              game.texts.push(new FloatingText(this.pos, "ОСТЫЛ", "#0f0"));
          }
      } else {
          // Decay heat when not shooting
          if (this.heat > 0 && this.shootTimer <= 0) {
              let cooling = this.heatCooling;
              // Anomaly: Cryo
              if (game.director.activeAnomaly?.type === 'cryo') cooling *= 5;
              
              this.heat = Math.max(0, this.heat - cooling * dt);
          }
      }

      // Shooting
      this.shootTimer -= dt;
      if (mouse.down && this.shootTimer <= 0) {
        if (!this.isOverheated) {
            this.shoot();
            let rate = this.fireRate;
            // Rune: Haste
            if (this.activeRunes.some(r => r.type === 'haste')) rate *= 0.5;
            this.shootTimer = rate;
        } else {
            // Jammed effect (optional visual feedback)
            if (Math.random() < 0.1) game.texts.push(new FloatingText(this.pos, "КЛИН!", "#888"));
            this.shootTimer = 0.2; // Rate limit jam messages
        }
      }
      
      // Drones
      this.drones.forEach(d => d.update(dt));
      // Sync drones count
      if (this.drones.length < this.droneCount) {
          this.drones.push(new Drone(this, (Math.PI * 2 / (this.droneCount || 1)) * this.drones.length));
      } else if (this.drones.length > this.droneCount) {
          this.drones.pop();
      }
      
      // Runes
      for (let i = this.activeRunes.length - 1; i >= 0; i--) {
          this.activeRunes[i].timer -= dt;
          if (this.activeRunes[i].timer <= 0) {
              this.activeRunes.splice(i, 1);
          }
      }
    }

    shoot() {
      const dir = mouse.pos.sub(this.pos).normalize();
      
      // Anomaly: Cryo (No Heat Gen)
      let heatMult = this.heatGenMult;
      if (game.director.activeAnomaly?.type === 'cryo') heatMult = 0;
      
      // Heat & Damage Bonus
      let heatAdd = 2; // Base heat
      if (this.weapon === 'shotgun') heatAdd = 5;
      if (this.weapon === 'rocket') heatAdd = 8;
      if (this.weapon === 'laser') heatAdd = 1;
      if (this.weapon === 'plasma') heatAdd = 1.5;
      this.heat += heatAdd * heatMult;

      const heatBonus = 1 + (this.heat / this.maxHeat) * this.heatDmgBonus;
      const dmg = Math.max(1, this.damage * heatBonus); // Ensure positive damage

      // Sniper Shot
      if (this.sniperShot) {
          this.sniperShot = false;
          // Logic handled in projectile creation (crit/pierce)
      }

      if (this.heat >= this.maxHeat) {
          this.isOverheated = true;
          this.overheatTimer = 2.0; // 2 seconds jam
          game.texts.push(new FloatingText(this.pos, "ПЕРЕГРЕВ!", "#f00"));
          game.screenShake = 5;
      }
      
      // Combo Overload Bonus (Fire Rate handled in update, here maybe visual?)
      let speedMult = 1.0;
      if (game.combo >= 50) speedMult = 1.5; // Faster projectiles in overload
      
      const spreadRad = this.spread * (Math.PI / 180);

      if (this.weapon === 'blaster') {
          for(let i=0; i<this.multishot; i++) {
            const angle = Math.atan2(dir.y, dir.x) + (i - (this.multishot-1)/2) * 0.1 + (Math.random() - 0.5) * spreadRad;
            const vel = new Vector(Math.cos(angle), Math.sin(angle)).mult(800 * speedMult);
            const p = new Projectile(this.pos, vel, dmg);
            if (this.homing) p.homing = true;
            if (this.ricochet) p.bounces = 1;
            game.projectiles.push(p);
          }
      } else if (this.weapon === 'shotgun') {
          for(let i=0; i<this.multishot + 4; i++) {
            const angle = Math.atan2(dir.y, dir.x) + (Math.random()-0.5) * 0.5 + (Math.random() - 0.5) * spreadRad;
            const vel = new Vector(Math.cos(angle), Math.sin(angle)).mult((700 + Math.random()*200) * speedMult);
            const p = new Projectile(this.pos, vel, dmg * 0.6);
            if (this.ricochet) p.bounces = 1;
            game.projectiles.push(p);
          }
      } else if (this.weapon === 'rocket') {
          for(let i=0; i<this.multishot; i++) {
              const angle = Math.atan2(dir.y, dir.x) + (i - (this.multishot-1)/2) * 0.15 + (Math.random() - 0.5) * spreadRad;
              const vel = new Vector(Math.cos(angle), Math.sin(angle)).mult(500 * speedMult);
              const p = new Projectile(this.pos, vel, dmg * 3 * this.aoeRadius, 'rocket');
              if (this.homing) p.homing = true;
              game.projectiles.push(p);
          }
      } else if (this.weapon === 'laser') {
          // Laser is fast and pierces (handled in collision)
          for(let i=0; i<this.multishot; i++) {
             const angle = Math.atan2(dir.y, dir.x) + (i - (this.multishot-1)/2) * 0.05 + (Math.random() - 0.5) * spreadRad;
             const vel = new Vector(Math.cos(angle), Math.sin(angle)).mult(1500 * speedMult);
             game.projectiles.push(new Projectile(this.pos, vel, dmg * 0.8, 'laser'));
          }
      } else if (this.weapon === 'plasma') {
          for(let i=0; i<this.multishot; i++) {
             const angle = Math.atan2(dir.y, dir.x) + (i - (this.multishot-1)/2) * 0.08 + (Math.random()-0.5)*0.1 + (Math.random() - 0.5) * spreadRad;
             const vel = new Vector(Math.cos(angle), Math.sin(angle)).mult(900 * speedMult);
             const p = new Projectile(this.pos, vel, dmg * 0.7, 'bullet'); // Re-use bullet visual but purple
             p.color = '#a020f0';
             if (this.homing) p.homing = true;
             if (this.ricochet) p.bounces = 1;
             game.projectiles.push(p);
          }
      }
      
      // Recoil
      // Apply Projectile Speed Multiplier to all just created projectiles
      // We can't easily access them here without refactoring, so we apply it at creation above.
      // Wait, I missed applying this.projSpeedMult in the blocks above.
      // Fixed in the diffs above by adding * this.projSpeedMult to velocity.
      
      this.vel = this.vel.sub(dir.mult(100));
    }

    gainXp(amount: number) {
      this.xp += amount * this.xpMult;
      if (this.xp >= this.maxXp) {
        this.xp -= this.maxXp;
        this.level++;
        
        // Evolution at Level 10
        if (this.level === 10) {
            game.texts.push(new FloatingText(this.pos, "ЭВОЛЮЦИЯ ОРУЖИЯ!", "#ffd700"));
            this.damage *= 1.5;
            this.multishot += 1;
        }
        
        this.maxXp *= 1.2;
        game.triggerLevelUp();
      }
      game.updateHud();
    }

    draw(ctx: CanvasRenderingContext2D) {
      ctx.save();
      ctx.translate(this.pos.x, this.pos.y);
      
      // Rotate towards mouse
      const angle = Math.atan2(mouse.pos.y - this.pos.y, mouse.pos.x - this.pos.x);
      ctx.rotate(angle);

      ctx.fillStyle = '#000';
      ctx.strokeStyle = '#0ff';
      ctx.lineWidth = 3;
      ctx.shadowBlur = 15; ctx.shadowColor = '#0ff';
      
      // Triangle shape
      ctx.beginPath();
      ctx.moveTo(20, 0);
      ctx.lineTo(-15, 15);
      ctx.lineTo(-15, -15);
      ctx.closePath();
      ctx.fill();
      ctx.stroke();

      ctx.restore();
      
      // Combo Overload Aura
      if (game.combo >= 50) {
          ctx.shadowBlur = 20; ctx.shadowColor = '#0ff';
          ctx.beginPath(); ctx.arc(this.pos.x, this.pos.y, 25, 0, Math.PI*2); ctx.strokeStyle = `rgba(0,255,255,${Math.random()})`; ctx.stroke();
      }
      
      // Heat Bar under player
      if (this.heat > 0 || this.isOverheated) {
          ctx.save();
          ctx.translate(this.pos.x, this.pos.y);
          
          const w = 40;
          const h = 4;
          const y = 30;
          
          // Background
          ctx.fillStyle = 'rgba(0,0,0,0.5)';
          ctx.fillRect(-w/2, y, w, h);
          
          // Fill
          let pct = this.heat / this.maxHeat;
          let color = '#ffaa00';
          
          if (this.isOverheated) {
              color = '#f00';
              // Show cooldown progress (shrinking bar)
              pct = this.overheatTimer / 2.0; 
          }
          
          ctx.fillStyle = color;
          ctx.fillRect(-w/2, y, w * pct, h);
          
          // Border
          ctx.strokeStyle = '#000';
          ctx.lineWidth = 1;
          ctx.strokeRect(-w/2, y, w, h);
          
          ctx.restore();
      }
      
      // Draw Drones
      this.drones.forEach(d => d.draw(ctx));
      
      // Draw Evolution Aura (Level 10+)
      if (this.level >= 10) {
          ctx.strokeStyle = `hsl(${Date.now()/10 % 360}, 100%, 50%)`;
          ctx.lineWidth = 2;
          ctx.beginPath(); ctx.arc(this.pos.x, this.pos.y, 25, 0, Math.PI*2); ctx.stroke();
      }
      if (this.isStealthed) {
          ctx.globalAlpha = 0.5;
          ctx.beginPath(); ctx.arc(this.pos.x, this.pos.y, 25, 0, Math.PI*2); ctx.stroke();
      }
    }
  }

  // --- PORTAL SYSTEM ---
  class Portal extends Entity {
      maxTime: number;
      timer: number;
      isBoss: boolean;

      constructor(pos: Vector, public enemyId: string, public elite: boolean, duration: number, color: string) {
          super(pos, 5, color);
          this.maxTime = duration;
          this.timer = duration;
          this.isBoss = enemyId.includes('boss');
      }

      update(dt: number) {
          // Boss Logic: Speed up if map is clear and observer is broke
          if (this.isBoss) {
              if (game.enemies.length === 0) {
                  this.timer -= dt * 10; // Speed up significantly if map is clear
              }
          }

          this.timer -= dt;
          if (this.timer <= 0) {
              this.dead = true;
              // Spawn the actual enemy
              if (this.enemyId === 'invader') {
                  const inv = new Invader(this.pos, game.director.wave);
                  game.enemies.push(inv);
              } else {
                  const e = new Enemy(this.pos, this.enemyId, game.director.wave, this.elite);
                  game.enemies.push(e);
              }
          }
      }

      draw(ctx: CanvasRenderingContext2D) {
          const progress = 1 - (Math.max(0, this.timer) / this.maxTime);
          const size = 10 + (30 * progress);
          ctx.strokeStyle = this.color;
          ctx.lineWidth = 3 + Math.sin(performance.now() / 100) * 1;
          ctx.beginPath(); ctx.arc(this.pos.x, this.pos.y, size, 0, Math.PI*2); ctx.stroke();
          
          // Rotating inner ring
          ctx.save();
          ctx.translate(this.pos.x, this.pos.y);
          ctx.rotate(performance.now() / 200);
          ctx.setLineDash([5, 5]);
          ctx.beginPath(); ctx.arc(0, 0, size * 0.7, 0, Math.PI*2); ctx.stroke();
          ctx.restore();
      }
  }

  // --- OBSERVER ---
  // --- DIRECTOR (OBSERVER) SYSTEM ---
  class Director {
    wave = 1;
    
    // Resource System
    currentInfluence = 0;
    baseWaveInfluence = 100; // Starting budget
    nextWaveSalary = 0; // Accumulates for next wave
    
    // Mood System
    mood: 'kind' | 'neutral' | 'angry' | 'insane' | 'cursed' = 'neutral';
    moodTimer = 0;
    moodResetTimer = 0; // Timer to reset mood back to kind
    
    // State
    nextWaveTimer = 0;
    bossSpawnedThisWave = false;
    raidBossActive = false;
    chatTimer = 0;
    nextChatInterval = 5;
    holidayTimer = 0;
    holidayPickups = 0;
    spawnTickTimer = 0;
    formationCooldown = 0;
    
    tactic: 'neutral' | 'swarm' | 'siege' | 'blitz' | 'ambush' | 'encircle' | 'pincer' | 'cross' | 'box' | 'column' | 'vanguard' | 'flank' | 'grid' | 'boss_rush' | 'elite_squad' | 'sniper_line' = 'neutral';
    isSaving = false; // Flag to skip turn and save influence
    savingTimer = 0; // Failsafe timer
    thought = "НАБЛЮДАЮ...";
    tacticTimer = 0;
    analyzeTimer = 0;
    playerPositions: Vector[] = [];
    
    activeQuest: { type: 'kill'|'collect'|'combo'|'survive', desc: string, target: number, current: number, reward: number } | null = null;
    weather: 'clear' | 'rain' | 'wind' | 'fog' = 'clear';
    weatherTimer = 0;
    invasionTimer = 0;
    
    activeAnomaly: { type: string, name: string, duration: number } | null = null;
    anomalyCooldown = 30; // First anomaly after 30s
    
    recentKills: number[] = []; // Timestamps of kills
    
    constructor(private game: Game) {}

    startWave() {
      // Reset influence for Wave Raids to ensure progression
      if (this.game.mode === 'raid' && this.game.activeRaid?.type === 'wave') {
          this.baseWaveInfluence = 100 + (this.wave * 20);
      } else if (this.wave > 1) {
          this.baseWaveInfluence = Math.floor(this.baseWaveInfluence * 1.2);
      } else {
          this.baseWaveInfluence = 100; // Reset for wave 1
      }
      
      // Refill
      this.currentInfluence += this.baseWaveInfluence + this.nextWaveSalary;
      this.nextWaveSalary = 0;
      this.bossSpawnedThisWave = false;
      
      // MANDATORY SPAWN: 5 Mobs at start of wave
      const basics = Object.values(ENEMIES).filter(e => e.cost <= 25 && !e.id.includes('boss') && !e.id.includes('invader'));
      if (basics.length > 0) {
          for(let i=0; i<5; i++) {
              const mob = basics[Math.floor(Math.random() * basics.length)];
              this.payAndSpawn(mob, undefined);
          }
      }
      
      // Boss Wave Check (Every 5th wave) - Free Spawn
      if (this.wave % 5 === 0) {
          const bossId = `boss${Math.min(7, Math.ceil(this.wave/5))}`; // Updated to include boss7
          this.game.spawnEnemy(bossId, false, undefined, undefined, 5.0); // Fixed 5s spawn for guaranteed boss
          this.bossSpawnedThisWave = true;
      }
      
      this.game.texts.push(new FloatingText(new Vector(CANVAS_W/2, CANVAS_H/2), `ВОЛНА ${this.wave}`, "#fff"));
      this.thought = "НОВАЯ ВОЛНА...";
      this.updateUI();
    }

    reportKill() {
        this.recentKills.push(Date.now());
        if (this.activeQuest && this.activeQuest.type === 'kill') {
            this.activeQuest.current++;
            this.updateUI();
        }
    }
    
    reportCollect() {
        if (this.activeQuest && this.activeQuest.type === 'collect') {
            this.activeQuest.current++;
            this.updateUI();
        }
    }

    startRaid() {
        this.wave = 1;
        
        // Если это Boss Rush с числовым ID (например "111"), устанавливаем волну равной ID
        if (this.game.activeRaid && this.game.activeRaid.type === 'boss_rush') {
            const waveNum = parseInt(this.game.activeRaid.id);
            if (!isNaN(waveNum)) {
                this.wave = waveNum;
            }
        }

        this.currentInfluence = 0;
        this.nextWaveSalary = 0;
        
        if (this.game.activeRaid?.type === 'wave') {
            this.startWave();
            return;
        }
        
        // Spawn Boss for Boss Rush
        if (this.game.activeRaid && this.game.activeRaid.type === 'boss_rush' && this.game.activeRaid.bossId) {
            this.currentInfluence = 2000; // Boost for boss fight
            this.game.spawnEnemy(this.game.activeRaid.bossId, true, undefined, '#ff0000', 5.0);
            this.game.texts.push(new FloatingText(new Vector(CANVAS_W/2, CANVAS_H/2), "ЦЕЛЬ ОБНАРУЖЕНА", "#f00"));
        }
        this.updateUI();
    }

    update(dt: number) {
      // Fake Chat Simulation
      this.chatTimer += dt;
      if (this.chatTimer >= this.nextChatInterval) {
          this.game.addChatMessage();
          this.chatTimer = 0;
          this.nextChatInterval = 4 + Math.random() * 26;
      }

      // Raid Logic
      if (this.game.mode === 'raid') {
          if (this.game.activeRaid?.type === 'boss_rush') {
              return; // Skip standard logic for boss rush (victory handled on kill)
          }
      }

      // Check if we saved enough
      if (this.isSaving) {
          this.savingTimer += dt;
          const target = this.getTacticCost(this.tactic);
          
          // Credit Mechanic: Allow going into debt up to -200 if close
          const creditLimit = 200;
          
          if (this.currentInfluence >= target - creditLimit) {
              this.isSaving = false;
              this.savingTimer = 0;
              this.game.texts.push(new FloatingText(this.game.player.pos, "ПОЛНАЯ МОЩНОСТЬ!", "#f00"));
              this.thought = "АТАКА!";
              this.game.screenShake = 20;
              this.formationCooldown = 0; // Attack immediately
          } else if (this.savingTimer > 30) {
              // Failsafe: Stuck saving for too long
              this.isSaving = false;
              this.tactic = 'neutral';
              this.thought = "СЛИШКОМ ДОЛГО...";
          }
      }
      
      // Tactic Timer
      if (this.tacticTimer > 0) {
          this.tacticTimer -= dt;
      }
      
      // Analyze Player Behavior
      this.analyzeTimer += dt;
      if (this.analyzeTimer >= 1.0) {
          this.analyzeTimer = 0;
          this.playerPositions.push(this.game.player.pos);
          if (this.playerPositions.length > 5) this.playerPositions.shift(); // Keep last 5 seconds
          this.thought = "АНАЛИЗ ПОВЕДЕНИЯ...";
          this.analyzePlayer();
      }

      // 1. Mood Logic (Dynamic based on kills)
      const now = Date.now();
      // Keep kills within 1.0s window (increased from 0.3s to make combos possible)
      // Optimization: Remove old kills without creating new array
      while (this.recentKills.length > 0 && now - this.recentKills[0] >= 1000) {
          this.recentKills.shift();
      }
      const burstCount = this.recentKills.length;

      // Determine target mood based on burst
      if (burstCount >= 50) {
          this.setMood('cursed', 10.0);
      } else if (burstCount >= 21) {
          this.setMood('insane', 5.0); // Stay insane for 5s
      } else if (burstCount >= 11) {
          this.setMood('angry', 4.0);
      } else if (burstCount >= 2) {
          this.setMood('neutral', 3.0);
      }

      // Mood Decay
      if (this.moodResetTimer > 0) {
          this.moodResetTimer -= dt;
          if (this.moodResetTimer <= 0) {
              this.mood = 'kind'; // Default fallback
              this.updateUI();
          }
      }

      // Quest Logic
      if (!this.activeQuest && Math.random() < 0.001) { // Rare chance for quest
          const types = ['kill', 'collect', 'combo', 'survive'];
          const type = types[Math.floor(Math.random() * types.length)];
          let count = 10;
          let desc = "";
          
          if (type === 'kill') { count = 10 + Math.floor(Math.random() * 10); desc = `УБИТЬ ${count} ВРАГОВ`; }
          else if (type === 'collect') { count = 5 + Math.floor(Math.random() * 5); desc = `СОБРАТЬ ${count} ЯДЕР`; }
          else if (type === 'combo') { count = 20 + Math.floor(Math.random() * 30); desc = `КОМБО x${count}`; }
          else if (type === 'survive') { count = 30; desc = `ВЫЖИТЬ ${count} СЕК`; }
          
          this.activeQuest = { type: type as any, desc, target: count, current: 0, reward: 100 * this.game.player.questRewardMult };
          this.game.texts.push(new FloatingText(new Vector(CANVAS_W/2, 100), "НОВЫЙ КОНТРАКТ", "#ffd700"));
          this.updateUI();
      }
      
      if (this.activeQuest) {
          if (this.activeQuest.type === 'survive') {
              this.activeQuest.current += dt;
          } else if (this.activeQuest.type === 'combo') {
              this.activeQuest.current = this.game.combo;
          }
          this.updateUI();
      }
      
      if (this.activeQuest && this.activeQuest.current >= this.activeQuest.target) {
          this.game.score += Math.floor(this.activeQuest.reward);
          this.game.currencyCollected += 50;
          this.game.texts.push(new FloatingText(new Vector(CANVAS_W/2, 100), "КОНТРАКТ ВЫПОЛНЕН", "#0f0"));
          this.activeQuest = null;
          this.updateUI();
      }

      // Weather Logic
      this.weatherTimer -= dt;
      if (this.weatherTimer <= 0) {
          this.weatherTimer = 30 + Math.random() * 60;
          const weathers: any[] = ['clear', 'rain', 'wind', 'fog'];
          this.weather = weathers[Math.floor(Math.random() * weathers.length)];
          if (this.weather !== 'clear') {
              this.game.texts.push(new FloatingText(new Vector(CANVAS_W/2, 150), `ПОГОДА: ${this.weather.toUpperCase()}`, "#0ff"));
          }
      }

      // Invasion Logic (1% chance every 5s)
      this.invasionTimer += dt;
      if (this.invasionTimer >= 5.0) {
          this.invasionTimer = 0;
          if (Math.random() < 0.005) {
              const count = Math.floor(Math.random() * 4) + 1;
              this.game.texts.push(new FloatingText(new Vector(CANVAS_W/2, 100), "ВТОРЖЕНИЕ ИГРОКОВ!", "#f00"));
              for(let i=0; i<count; i++) {
                  this.game.spawnEnemy('invader', true, undefined, '#ff0000');
              }
          }
      }

      // Anomaly Logic
      // Note: Raid mode returns early above, so we are always in endless mode here.
      this.anomalyCooldown -= dt;
      if (this.anomalyCooldown <= 0) {
         this.triggerAnomaly();
         this.anomalyCooldown = 45 + Math.random() * 30; // Next in 45-75s
      }
      
      if (this.activeAnomaly) {
          this.activeAnomaly.duration -= dt;
          if (this.activeAnomaly.duration <= 0) {
              this.game.texts.push(new FloatingText(new Vector(CANVAS_W/2, 250), "СИСТЕМА В НОРМЕ", "#0f0"));
              this.activeAnomaly = null;
          }
      }

      // Resource Gain (Every 5s)
      this.moodTimer += dt;
      if (this.moodTimer >= 5) {
        this.distributeInfluence();
        this.moodTimer = 0;
      }

      // 2. Spawning Logic (Spend Influence)
      if (this.currentInfluence > 0) {
          this.processSpawning(dt);
      }
      
      // Raid Victory Check (Wave Raid)
      if (this.game.mode === 'raid' && this.game.activeRaid?.type === 'wave') {
          if (this.wave > this.game.activeRaid.target) {
              this.game.victory();
              return;
          }
      }

      // 3. Wave Cycling Logic
      // "Ran out of energy? ... begins next wave"
      if ((this.currentInfluence < 10 || this.isSaving) && !this.game.enemies.some(e => e.isVisible() && e.config.type !== 'invader')) { // Wait for clear (ignoring invaders)
          this.nextWaveTimer += dt;
          const delay = this.isSaving ? 0.5 : 2.0; // Fast skip if saving
          if (this.nextWaveTimer > delay) {
              this.wave++;
              this.nextWaveTimer = 0;
              this.startWave();
              
              // Check Raid Victory after wave increment
              if (this.game.mode === 'raid' && this.game.activeRaid?.type === 'wave' && this.wave > this.game.activeRaid.target) {
                  this.game.victory();
              }
          }
      } else {
          this.nextWaveTimer = 0;
      }
    }
    
    analyzePlayer() {
        if (this.playerPositions.length < 2) return;
        
        // Calc average movement speed (pixels per second approx)
        let totalDist = 0;
        for(let i=1; i<this.playerPositions.length; i++) {
            totalDist += this.playerPositions[i].sub(this.playerPositions[i-1]).mag();
        }
        const avgSpeed = totalDist / this.playerPositions.length; 
        
        // Only switch tactic if timer expired
        if (this.tacticTimer > 0) return;
        
        // Logic: Choose Tactic
        let newTactic: any = 'neutral';
        
        // 30% Chance to pick random tactic regardless of player behavior (Chaos factor)
        if (Math.random() < 0.3) {
             const allTactics = ['siege', 'blitz', 'swarm', 'ambush', 'pincer', 'flank', 'grid', 'elite_squad'];
             // Filter out expensive ones if poor
             const affordable = allTactics.filter(t => this.getTacticCost(t) <= this.currentInfluence + 200);
             if (affordable.length > 0) newTactic = affordable[Math.floor(Math.random() * affordable.length)];
        } 
        else if (avgSpeed < 50) {
            // Camper: Surround or bombard
            const opts = ['siege', 'encircle', 'box', 'grid'];
            newTactic = opts[Math.floor(Math.random() * opts.length)];
        } else if (avgSpeed > 250) {
            // Runner: Intercept or Flank
            const opts = ['blitz', 'ambush', 'flank', 'pincer', 'vanguard'];
            newTactic = opts[Math.floor(Math.random() * opts.length)];
        } else if (this.recentKills.length > 15) {
            // High DPS: Overwhelm or Spread out
            const opts = ['swarm', 'cross', 'column'];
            newTactic = opts[Math.floor(Math.random() * opts.length)];
        } else if (avgSpeed < 150 && Math.random() < 0.3) {
            // Moderate speed -> Snipers
            newTactic = 'sniper_line';
        } else if (this.wave >= 5 && Math.random() < 0.15) {
            // Advanced Tactics
            newTactic = 'boss_rush';
        } else if (this.wave >= 3 && Math.random() < 0.2) {
            // Elite Squad
            newTactic = 'elite_squad';
        } else {
            // Random variation even in neutral
            const roll = Math.random();
            if (roll < 0.1) newTactic = 'pincer';
            else if (roll < 0.2) newTactic = 'cross';
            else if (roll < 0.3) newTactic = 'vanguard';
            else newTactic = 'neutral';
        }
        
        // --- ADAPTATION: Don't pick tactics we can't afford anytime soon ---
        let cost = this.getTacticCost(newTactic);
        // If cost is significantly higher than what we have (e.g. > 300 deficit), 
        // and we aren't in a "rich" mood (Insane/Cursed), downgrade.
        if (cost > this.currentInfluence + 300 && this.mood !== 'insane' && this.mood !== 'cursed') {
            // Try to pick a cheaper alternative
            if (newTactic === 'boss_rush') newTactic = 'elite_squad';
            else if (newTactic === 'elite_squad') newTactic = 'swarm';
            else if (['siege', 'blitz', 'ambush'].includes(newTactic)) newTactic = 'neutral';
        }

        if (this.tactic !== newTactic && newTactic !== 'neutral') {
            this.game.texts.push(new FloatingText(this.game.player.pos, `ТАКТИКА: ${newTactic.toUpperCase()}`, "#ff00ff"));
        }
        this.tactic = newTactic;
        this.tacticTimer = 15 + Math.random() * 15; // Tactic lasts 15-30 seconds
        
        // Check Saving
        cost = this.getTacticCost(this.tactic);
        this.isSaving = false;
        this.savingTimer = 0;
        const totalFunds = this.currentInfluence + this.nextWaveSalary;

        // Save if we can afford it next wave (with salary) OR if we are close (>50%)
        if (cost > 0 && this.currentInfluence < cost && (totalFunds >= cost || this.currentInfluence > cost * 0.5)) {
            this.isSaving = true;
            this.thought = "КОПЛЮ РЕСУРСЫ...";
            this.game.texts.push(new FloatingText(this.game.player.pos, "НАКОПЛЕНИЕ СИЛ...", "#f00"));
        }
    }
    
    triggerAnomaly() {
        const types = [
            { type: 'turbo', name: 'ТУРБО РЕЖИМ', duration: 15 },
            { type: 'zero_g', name: 'СБОЙ ГРАВИТАЦИИ', duration: 15 },
            { type: 'berserk', name: 'ПРОТОКОЛ: БЕРСЕРК', duration: 10 },
            { type: 'cryo', name: 'КРИО-ОХЛАЖДЕНИЕ', duration: 10 }
        ];
        this.activeAnomaly = types[Math.floor(Math.random()*types.length)];
        this.game.texts.push(new FloatingText(new Vector(CANVAS_W/2, 200), `АНОМАЛИЯ: ${this.activeAnomaly.name}`, "#ff00ff"));
        this.game.screenShake = 20;
    }
    
    setMood(newMood: 'kind' | 'neutral' | 'angry' | 'insane' | 'cursed', duration: number) {
      const tiers = { kind: 0, neutral: 1, angry: 2, insane: 3, cursed: 4 };
      // Only upgrade mood or refresh timer if same tier
      if (tiers[newMood] >= tiers[this.mood]) {
          // Cursed Trigger Effect
          if (newMood === 'cursed' && this.mood !== 'cursed') {
              const penalty = this.baseWaveInfluence * 3;
              this.game.score -= penalty;
              this.currentInfluence += penalty;
              this.game.texts.push(new FloatingText(new Vector(CANVAS_W/2, CANVAS_H/2), "НАКАЗАНИЕ!", "#f00"));
              this.game.screenShake = 30;
          }
          
          this.mood = newMood;
          this.moodResetTimer = duration;
          this.updateUI();
      }
    }
    
    distributeInfluence() {
      // BUDGET CALCULATION (Every 5 seconds)
      
      // 1. Base Income (25% of wave base influence)
      const baseIncome = Math.floor(this.baseWaveInfluence * 0.25);
      
      // 2. Mood Multiplier
      let moodMult = 1.0;
      if (this.mood === 'kind') moodMult = 0.5;      // 50% Income
      if (this.mood === 'neutral') moodMult = 1.0;   // 100% Income
      if (this.mood === 'angry') moodMult = 1.5;     // 150% Income
      if (this.mood === 'insane') moodMult = 2.0;    // 200% Income
      if (this.mood === 'cursed') moodMult = 3.0;    // 300% Income
      
      const totalIncome = Math.floor(baseIncome * moodMult);
      this.nextWaveSalary += totalIncome;
      
      // Visuals
      const color = totalIncome >= baseIncome ? "#f00" : "#0f0";
      this.thought = `БЮДЖЕТ: +${totalIncome}`;
      this.game.texts.push(new FloatingText(new Vector(CANVAS_W/2, 120), `ЗАРПЛАТА: +${totalIncome}`, color));

      // --- AI DEVELOPMENT & SAVING CHECK ---
      
      // 1. React to losing points in Kind mood
      // If income is too low to sustain operations
      if (this.mood === 'kind' && totalIncome < 20) {
          if (this.currentInfluence < 50) {
              // Not enough resources to be kind
              this.setMood('neutral', 15.0);
              this.game.texts.push(new FloatingText(new Vector(CANVAS_W/2, 150), "ДОБРОТА НЕ ОКУПАЕТСЯ...", "#fff"));
          }
      }

      // 2. Check if Saving is viable (Character Check)
      if (this.isSaving) {
          const target = this.getTacticCost(this.tactic);
          // If we are far from target and income is low/negative
          if (this.currentInfluence + this.nextWaveSalary < target * 0.8) {
              if (totalIncome <= 0 || (target - (this.currentInfluence + this.nextWaveSalary)) / Math.max(1, totalIncome) > 4) { 
                  this.isSaving = false;
                  this.tactic = 'neutral';
                  this.game.texts.push(new FloatingText(this.game.player.pos, "СЛИШКОМ ДОРОГО...", "#888"));
                  this.thought = "ОТМЕНА ПЛАНА...";
              }
          }
      }
      
      this.updateUI();
    }
    
    processSpawning(dt: number) {
        // Cursed Mood: Dump everything on bosses
        if (this.mood === 'cursed') {
            const bosses = Object.values(ENEMIES).filter(e => e.id.includes('boss') && e.cost <= this.currentInfluence);
            if (bosses.length > 0) {
                const boss = bosses[Math.floor(Math.random() * bosses.length)];
                this.payAndSpawn(boss, undefined, '#ff0000');
                return;
            } else {
                // If can't afford boss, spawn elites
                const elites = Object.values(ENEMIES).filter(e => e.cost * 2 <= this.currentInfluence);
                if (elites.length > 0) {
                    this.payAndSpawn(elites[Math.floor(Math.random() * elites.length)], undefined, '#ff0000');
                    return;
                }
            }
        }

        // If saving for a big attack, stop spawning to end wave faster
        if (this.isSaving) {
            this.thought = "ПРОПУСКАЮ ХОД (КОПЛЮ)...";
            return;
        }

        this.spawnTickTimer += dt;
        if (this.spawnTickTimer < 0.5) return; // Tick every 0.5s
        this.spawnTickTimer = 0;
        
        const isTactical = this.tactic !== 'neutral';

        // 0. Formation Attack (Smart Move)
        this.formationCooldown -= dt;
        
        // AGGRESSION: If rich, cooldown faster to spend resources immediately
        if (this.currentInfluence > 600) {
            this.formationCooldown -= dt * 2; // 3x speed total
        }

        const formationThreshold = isTactical ? 50 : 150; // Lower threshold if tactical to execute faster
        
        if (this.formationCooldown <= 0 && this.currentInfluence > formationThreshold) {
            if (this.trySpawnFormation()) {
                this.formationCooldown = isTactical ? 5 + Math.random() * 3 : 8 + Math.random() * 5; // Faster cooldown if tactical
                this.thought = "РЕАЛИЗАЦИЯ ТАКТИКИ...";
                return; // Skip regular spawn to save influence for next big move
            }
        }

        // 1. Idle Check (Thinking) - Director takes pauses
        let idleChance = 0.3; 
        if (this.mood === 'kind') idleChance = 0.6;
        if (this.mood === 'neutral') idleChance = 0.4;
        if (this.mood === 'angry') idleChance = 0.2;
        if (this.mood === 'insane') idleChance = 0.05;

        if (Math.random() < idleChance) return;
        
        this.thought = "БЕСПОКОЯЩИЙ ОГОНЬ...";

        // Determine batch size (1-10) based on mood
        let maxBatch = 2;
        if (this.mood === 'neutral') maxBatch = 4;
        if (this.mood === 'angry') maxBatch = 7;
        if (this.mood === 'insane') maxBatch = 10;
        
        let isSurge = false;
        // Chance for a "Surge" (Dump) - small chance to spawn more
        if (Math.random() < 0.02 && this.currentInfluence > 500) {
             isSurge = true;
             maxBatch = 15;
             this.game.texts.push(new FloatingText(new Vector(CANVAS_W/2, 150), "SURGE DETECTED", "#f00"));
        }

        // Chance to force an expensive buy (High Roller)
        // If mood is Insane, he likes spending more.
        let expensiveChance = 0.1;
        if (this.mood === 'angry') expensiveChance = 0.2;
        if (this.mood === 'insane') expensiveChance = 0.4;
        
        const forceExpensive = Math.random() < expensiveChance;

        let count = Math.floor(Math.random() * maxBatch) + 1;
        if (forceExpensive) count = 1; // Buy one big thing
        if (isSurge) count = 15; // Override
        
        // Spending Cap: Don't spend more than ~15% of current influence per tick
        const startInfluence = this.currentInfluence;
        // Reduced to 5% to prevent rapid draining
        const spendCap = Math.max(20, this.currentInfluence * 0.05);
        
        // If we are NOT saving, we spend freely. No reserves.
        const canSpend = true;

        for(let i=0; i<count; i++) {
             // If not a surge AND not forcing expensive, respect the spending cap
             if (!isSurge && !forceExpensive && startInfluence - this.currentInfluence >= spendCap) break;

             const available = Object.values(ENEMIES).filter(e => {
                // Boss logic: allow after wave 10 with low chance
                if (e.id.includes('boss')) {
                    if (this.wave <= 10) return false;
                    if (Math.random() > 0.02) return false; // 2% chance to consider boss
                    // Limit active bosses
                    if (this.game.enemies.some(ex => ex.config.id.includes('boss'))) return false;
                }
                
                // Critters only allowed in Swarm tactic
                if (e.id === 'critter' && this.tactic !== 'swarm') return false;
                
                if (e.unlockReq && !meta.unlocks.includes(e.unlockReq)) return false;
                return e.cost <= this.currentInfluence;
            });

            if (available.length === 0 || (!canSpend && !forceExpensive)) {
                // If we have influence but can't afford anything (and influence is low-ish), 
                // dump it to 0 to trigger next wave.
                if (this.currentInfluence < 50) this.currentInfluence = 0;
                break;
            }

            // Logic for picking enemy
            let enemy;
            if (forceExpensive) {
                // Filter for expensive ones (top 30% of affordable)
                available.sort((a, b) => b.cost - a.cost);
                const topCount = Math.max(1, Math.floor(available.length * 0.3));
                const pool = available.slice(0, topCount);
                enemy = pool[Math.floor(Math.random() * pool.length)];
            } else {
                // Tactic Bias
                let pool = available;
                if (this.tactic === 'siege') {
                    const siegeUnits = available.filter(e => ['ranged', 'tank', 'exploder', 'boss_sniper'].includes(e.type));
                    if (siegeUnits.length > 0) pool = siegeUnits;
                } else if (this.tactic === 'blitz') {
                    const blitzUnits = available.filter(e => ['fast', 'charger', 'vampire', 'boss_charger'].includes(e.type) || e.speed > 200);
                    if (blitzUnits.length > 0) pool = blitzUnits;
                } else if (this.tactic === 'ambush') {
                    const ambushUnits = available.filter(e => ['stealth', 'fast', 'ninja'].includes(e.type));
                    if (ambushUnits.length > 0) pool = ambushUnits;
                } else if (this.tactic === 'encircle') {
                    const blitzUnits = available.filter(e => ['fast', 'charger', 'vampire', 'boss_charger'].includes(e.type) || e.speed > 200);
                    if (blitzUnits.length > 0) pool = blitzUnits;
                } else if (this.tactic === 'swarm') {
                    const swarmUnits = available.filter(e => e.cost < 20);
                    if (swarmUnits.length > 0) pool = swarmUnits;
                }
                
                enemy = pool[Math.floor(Math.random() * pool.length)];
            }

            this.payAndSpawn(enemy, undefined);
            
            if (forceExpensive) break; // Only one expensive purchase per tick
        }
    }
    
    trySpawnFormation() {
        let type: 'circle' | 'line' | 'wedge' | 'pincer' | 'cross' | 'box' | 'column' | 'vanguard' | 'flank' | 'grid' | 'boss' | 'sniper_line' = 'circle';
        let enemyId = 'basic_weak';
        let count = 5;
        
        // Choose formation based on tactic
        if (this.tactic === 'siege') {
            type = 'line';
            enemyId = Math.random() > 0.5 ? 'tank_norm' : 'ranged_norm';
            count = 4;
        } else if (this.tactic === 'blitz') {
            type = 'wedge';
            enemyId = 'fast_norm';
            count = 6;
        } else if (this.tactic === 'ambush') {
            type = 'circle'; // Ambush uses circle logic but offset (see below)
            enemyId = 'ninja';
            count = 3;
        } else if (this.tactic === 'swarm') {
            type = 'circle';
            // If rich, dump critters
            if (this.currentInfluence > 200) {
                 enemyId = 'critter';
                 count = Math.min(40, Math.floor(this.currentInfluence / 5)); // Zerg Rush
                 // Add Cage Master to swarm
                 if (Math.random() < 0.3 && this.currentInfluence > 350) {
                     this.payAndSpawn(ENEMIES['cage_master'], undefined, '#00f');
                 }
            } else {
                 enemyId = 'basic_weak';
                 count = 12;
            }
        } else if (this.tactic === 'encircle') {
            type = 'circle';
            enemyId = 'fast_weak';
            count = 12;
        } else if (this.tactic === 'pincer') {
            type = 'pincer'; enemyId = 'fast_weak'; count = 8;
        } else if (this.tactic === 'cross') {
            type = 'cross'; enemyId = 'ranged_weak'; count = 4;
        } else if (this.tactic === 'box') {
            type = 'box'; enemyId = 'tank_weak'; count = 4;
        } else if (this.tactic === 'column') {
            type = 'column'; enemyId = 'charger_weak'; count = 5;
        } else if (this.tactic === 'vanguard') {
            type = 'vanguard'; enemyId = 'tank_norm'; count = 3;
        } else if (this.tactic === 'flank') {
            type = 'flank'; enemyId = 'vampire'; count = 6;
        } else if (this.tactic === 'grid') {
            type = 'grid'; enemyId = 'exploder'; count = 9;
        } else {
            // Special Tactics
            if (this.tactic === 'boss_rush') {
                const bosses = Object.values(ENEMIES).filter(e => e.id.includes('boss'));
                // Try to find affordable boss, otherwise random
                const affordable = bosses.filter(b => b.cost <= this.currentInfluence);
                const pool = affordable.length > 0 ? affordable : bosses;
                const boss = pool[Math.floor(Math.random() * pool.length)];
                this.payAndSpawn(boss, undefined, '#ffd700');
                return true;
            } else if (this.tactic === 'elite_squad') {
                type = 'wedge'; enemyId = 'tank_heavy'; count = 3;
            } else if (this.tactic === 'sniper_line') {
                type = 'line'; enemyId = 'sniper'; count = 3;
            }
            
            // Neutral - random small formation
            if (Math.random() > 0.7) return false;
            type = 'wedge';
            enemyId = 'basic_norm';
            count = 3;
        }

        // --- ADAPTIVE COST LOGIC ---
        let config = ENEMIES[enemyId];
        if (!config) return false;
        
        // 1. Downgrade Unit if too expensive
        if (this.currentInfluence < config.cost * count) {
             const downgrades: Record<string, string> = {
                'tank_heavy': 'tank_norm', 'tank_norm': 'tank_weak',
                'fast_norm': 'fast_weak',
                'ranged_norm': 'ranged_weak',
                'charger_norm': 'charger_weak',
                'basic_strong': 'basic_norm', 'basic_norm': 'basic_weak',
                'ninja': 'fast_norm', 'vampire': 'fast_norm'
            };
            if (downgrades[enemyId]) {
                const cheaperId = downgrades[enemyId];
                if (ENEMIES[cheaperId] && this.currentInfluence >= ENEMIES[cheaperId].cost * count) {
                    enemyId = cheaperId;
                    config = ENEMIES[enemyId];
                }
            }
        }
        
        // 2. Reduce Count if still too expensive (min 3)
        if (this.currentInfluence < config.cost * count) {
            const affordable = Math.floor(this.currentInfluence / config.cost);
            if (affordable >= 3) {
                count = affordable;
            } else {
                return false; // Can't afford even minimal tactic
            }
        }
        // ---------------------------
        
        // Execute Formation
        const playerPos = this.game.player.pos;
        const playerVel = this.game.player.vel;
        const leadDist = 500;
        
        // Calculate Center
        let center = playerPos.add(new Vector(0,0)); // Clone
        if (['wedge', 'line', 'column', 'vanguard', 'pincer', 'flank'].includes(type)) {
            // Predict movement
            const moveDir = playerVel.mag() > 10 ? playerVel.normalize() : new Vector(Math.random()-0.5, Math.random()-0.5).normalize();
            center = playerPos.add(moveDir.mult(leadDist));
        } else if (this.tactic === 'ambush') {
            // Spawn BEHIND player
            const moveDir = playerVel.mag() > 10 ? playerVel.normalize() : new Vector(1,0);
            center = playerPos.sub(moveDir.mult(300)); // Behind
            type = 'wedge'; // Use wedge formation for ambush
        }
        
        // Clamp bounds
        center.x = Math.max(50, Math.min(CANVAS_W - 50, center.x));
        center.y = Math.max(50, Math.min(CANVAS_H - 50, center.y));
        
        for(let i=0; i<count; i++) {
            let pos = new Vector(0,0);
            if (type === 'circle' || this.tactic === 'encircle') {
                const angle = (Math.PI * 2 / count) * i;
                pos = playerPos.add(new Vector(Math.cos(angle), Math.sin(angle)).mult(300));
            } else if (type === 'line') {
                const perp = new Vector(-playerVel.y, playerVel.x).normalize();
                pos = center.add(perp.mult((i - (count-1)/2) * 60));
            } else if (type === 'wedge') {
                const dir = playerVel.mag() > 0 ? playerVel.normalize() : new Vector(1,0);
                const right = new Vector(-dir.y, dir.x);
                const row = Math.floor(i/2);
                const side = i%2===0 ? 1 : -1;
                pos = center.add(dir.mult(-row * 40)).add(right.mult(side * row * 40));
            } else if (type === 'pincer') {
                const dir = playerVel.mag() > 0 ? playerVel.normalize() : new Vector(1,0);
                const right = new Vector(-dir.y, dir.x);
                const side = i % 2 === 0 ? 1 : -1;
                // Two parallel lines on sides
                pos = center.add(right.mult(side * 250)).add(dir.mult((Math.floor(i/2) - 1) * 50));
            } else if (type === 'cross') {
                const angle = (Math.PI * 2 / 4) * i;
                pos = playerPos.add(new Vector(Math.cos(angle), Math.sin(angle)).mult(200));
            } else if (type === 'box') {
                const angle = (Math.PI * 2 / 4) * i + Math.PI/4; // Corners
                pos = playerPos.add(new Vector(Math.cos(angle), Math.sin(angle)).mult(250));
            } else if (type === 'column') {
                const dir = playerVel.mag() > 0 ? playerVel.normalize() : new Vector(1,0);
                // Line along movement direction
                pos = center.add(dir.mult((i - (count-1)/2) * 80));
            } else if (type === 'vanguard') {
                const dir = playerVel.mag() > 0 ? playerVel.normalize() : new Vector(1,0);
                const right = new Vector(-dir.y, dir.x);
                // Inverted wedge in front
                pos = center.add(dir.mult(100)).add(right.mult((i - (count-1)/2) * 60));
            } else if (type === 'flank') {
                const dir = playerVel.mag() > 0 ? playerVel.normalize() : new Vector(1,0);
                const right = new Vector(-dir.y, dir.x);
                const side = i % 2 === 0 ? 1 : -1;
                // Behind and to the sides
                pos = playerPos.sub(dir.mult(100)).add(right.mult(side * (150 + Math.floor(i/2)*50)));
            } else if (type === 'grid') {
                const gridSize = 3;
                const spacing = 80;
                const x = (i % gridSize - 1) * spacing;
                const y = (Math.floor(i / gridSize) - 1) * spacing;
                pos = playerPos.add(new Vector(x, y));
            } else if (type === 'sniper_line') {
                // Line far away
                const dir = playerVel.mag() > 0 ? playerVel.normalize() : new Vector(1,0);
                pos = playerPos.add(dir.mult(400)).add(new Vector(-dir.y, dir.x).mult((i-1)*100));
            }
            this.payAndSpawn(config, pos, '#ffd700'); // Yellow Portal for Tactics
        }
        
        this.game.texts.push(new FloatingText(center, `ФОРМАЦИЯ: ${type.toUpperCase()}`, "#ff00ff"));
        return true;
    }
    
    spawnRandom(available: EnemyConfig[]) {
        const enemy = available[Math.floor(Math.random() * available.length)];
        this.payAndSpawn(enemy, undefined);
    }
    
    payAndSpawn(config: EnemyConfig, pos?: Vector, portalColor?: string) {
        let cost = config.cost;
        let elite = false;
        
        // Elite chance
        if (Math.random() < 0.1 && this.currentInfluence > cost * 2) {
            elite = true;
            cost *= 2;
        }
        
        if (!pos) {
             const padding = 40;
             if (Math.random() > 0.5) {
                pos = new Vector(Math.random() > 0.5 ? padding : CANVAS_W - padding, Math.random() * (CANVAS_H - padding*2) + padding);
             } else {
                pos = new Vector(Math.random() * (CANVAS_W - padding*2) + padding, Math.random() > 0.5 ? padding : CANVAS_H - padding);
             }
        }

        this.currentInfluence -= cost;
        this.game.spawnEnemy(config.id, elite, pos, portalColor);
        
        if (config.type === 'builder') {
             const count = 4 + Math.floor(Math.random() * 2);
             for(let i=0; i<count; i++) {
                 const angle = (Math.PI * 2 / count) * i;
                 const offset = new Vector(Math.cos(angle), Math.sin(angle)).mult(40);
                 this.game.spawnEnemy('shielder', false, pos.add(offset), '#0088ff');
             }
        }

        this.updateUI();
    }

    getTacticCost(t: string) {
        if (t === 'boss_rush') return 800;
        if (t === 'elite_squad') return 400;
        if (t === 'swarm' || t === 'encircle') return 100;
        if (t === 'blitz') return 150;
        if (t === 'neutral') return 0; // Never save for neutral
        return 300; // Default for others
    }

    updateUI() {
      const faceEl = document.getElementById('obs-face');
      const moodEl = document.getElementById('obs-mood');
      if (!faceEl || !moodEl) return;
      
      const config = {
        kind: { face: '😇', text: 'ДОБРЫЙ', color: '#0f0' },
        neutral: { face: '😐', text: 'НЕЙТРАЛЬНЫЙ', color: '#fff' },
        angry: { face: '😠', text: 'ЗЛОЙ', color: '#ff8800' },
        insane: { face: '👿', text: 'БЕЗУМНЫЙ', color: '#f00' },
        cursed: { face: '☠️', text: 'ПРОКЛЯТЫЙ', color: '#800080' }
      };
      
      const c = config[this.mood];
      faceEl.innerText = c.face;
      moodEl.innerText = c.text;
      moodEl.style.color = c.color;
      
      const salaryText = this.nextWaveSalary > 0 ? ` (+${this.nextWaveSalary})` : '';
      document.getElementById('obs-influence')!.innerText = `ВЛИЯНИЕ: ${Math.floor(this.currentInfluence)}${salaryText}`;
      
      // Show Thought
      const thoughtEl = document.getElementById('obs-thought');
      if (thoughtEl) thoughtEl.innerText = `МЫСЛИ: ${this.thought}`;

      // Show Goal
      const goalEl = document.getElementById('obs-goal');
      if (goalEl) {
          if (this.isSaving) {
              const target = this.getTacticCost(this.tactic);
              goalEl.innerText = `ЦЕЛЬ: ${this.getTacticName(this.tactic)} (${Math.floor(this.currentInfluence)}/${target})`;
              goalEl.style.color = '#ffd700';
          } else if (this.tactic !== 'neutral') {
              goalEl.innerText = `ЦЕЛЬ: ИСПОЛНЕНИЕ`;
              goalEl.style.color = '#0f0';
          } else {
              goalEl.innerText = `ЦЕЛЬ: ДАВЛЕНИЕ`;
              goalEl.style.color = '#aaa';
          }
      }
      
      // Show Tactic
      let tacticText = "НЕТ";
      let tacticColor = "#666";
      
      // Only show tactic if we are NOT saving (meaning we are executing or ready to execute)
      if (!this.isSaving && this.tactic !== 'neutral') {
          tacticText = this.getTacticName(this.tactic);
          tacticColor = "#0f0"; // Active
      } else if (this.isSaving) {
          tacticText = "ПОДГОТОВКА...";
          tacticColor = "#888";
      }
      
      const tacticEl = document.getElementById('obs-tactic');
      if (tacticEl) tacticEl.innerHTML = `ТАКТИКА: <span style="color:${tacticColor}">${tacticText}</span>`;

      // Show Weather
      const weatherMap: Record<string, string> = { 'clear': 'ЯСНО', 'rain': 'ДОЖДЬ', 'wind': 'ВЕТЕР', 'fog': 'ТУМАН' };
      const weatherEl = document.getElementById('obs-weather');
      if (weatherEl) {
          const wText = weatherMap[this.weather] || 'ЯСНО';
          const wColor = this.weather === 'clear' ? '#666' : '#0ff';
          weatherEl.innerHTML = `ПОГОДА: <span style="color:${wColor}">${wText}</span>`;
      }

      // Show Anomaly
      const anomalyEl = document.getElementById('obs-anomaly');
      if (anomalyEl) {
          if (this.activeAnomaly) {
              anomalyEl.innerHTML = `АНОМАЛИЯ: <span style="color:#ff00ff" class="blink">${this.activeAnomaly.name}</span>`;
          } else {
              anomalyEl.innerHTML = `АНОМАЛИЯ: <span style="color:#444">НЕТ</span>`;
          }
      }

      if (this.activeQuest) document.getElementById('hud-quest-text')!.innerText = `${this.activeQuest.desc} (${this.activeQuest.current}/${this.activeQuest.target})`;
    }

    getTacticName(t: string) {
        const map: Record<string, string> = {
            'siege': 'ОСАДА', 'blitz': 'ПЕРЕХВАТ', 'swarm': 'РОЙ',
            'ambush': 'ЗАСАДА', 'encircle': 'ОКРУЖЕНИЕ', 'pincer': 'КЛЕЩИ',
            'cross': 'КРЕСТ', 'box': 'КОРОБКА', 'column': 'КОЛОННА',
            'vanguard': 'АВАНГАРД', 'flank': 'ФЛАНГ', 'grid': 'РЕШЕТКА',
            'boss_rush': 'БОСС', 'elite_squad': 'ЭЛИТА', 'sniper_line': 'СНАЙПЕРЫ',
            'neutral': 'НЕТ'
        };
        return map[t] || 'НЕТ';
    }
  }

  // --- LEADERBOARD SYSTEM ---
  async function fetchLeaderboard() {
      try {
          const res = await fetch('/api/scores_nl');
          const data = await res.json();
          
          renderLbList('lb-daily', data.daily);
          renderLbList('lb-weekly', data.weekly);
      } catch (e) {
          console.error("Failed to fetch leaderboard", e);
      }
  }

  function renderLbList(id: string, list: any[]) {
      const el = document.getElementById(id);
      if (!el) return;
      if (!list || list.length === 0) {
          el.innerHTML = '<div class="text-center text-gray-500">Нет записей</div>';
          return;
      }
      el.innerHTML = list.map((item, i) => `
          <div class="lb-item ${item.name === meta.username ? 'me' : ''}">
              <span class="rank">#${i+1}</span>
              <span class="name">${item.name}</span>
              <span class="score">${item.score}</span>
          </div>
      `).join('');
  }

  async function checkAndSubmitScore(score: number) {
      try {
          const res = await fetch('/api/scores_nl');
          const data = await res.json();
          
          const dailyMin = data.daily.length < 5 ? 0 : data.daily[data.daily.length-1].score;
          const weeklyMin = data.weekly.length < 5 ? 0 : data.weekly[data.weekly.length-1].score;
          
          if (score > dailyMin || score > weeklyMin) {
              // Show Input
              const inputDiv = document.getElementById('highscore-input');
              if (inputDiv) inputDiv.classList.remove('hidden');
          }
      } catch (e) {
          console.error("Check score failed", e);
      }
  }

  async function postScore(name: string, score: number) {
      await fetch('/api/scores_nl', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, score })
      });
  }

  // --- MAIN GAME CLASS ---
  class Game {
    canvas: HTMLCanvasElement;
    ctx: CanvasRenderingContext2D;
    
    player: Player;
    enemies: Enemy[] = [];
    enemyStructures: EnemyStructure[] = [];
    portals: Portal[] = [];
    turrets: Turret[] = [];
    mines: Mine[] = [];
    projectiles: Projectile[] = [];
    particles: Particle[] = [];
    texts: FloatingText[] = [];
    
    state: 'MENU' | 'PLAYING' | 'GAMEOVER' | 'TREE' = 'MENU';
    mode: 'endless' | 'raid' = 'endless';
    score = 0;
    currencyCollected = 0;
    coresCollected = 0;
    
    lootFound: Item[] = [];
    screenShake = 0;
    treeRenderer: SkillTreeRenderer | null = null;
    director: Director;
    
    // In-Game Upgrade State
    pendingUpgrades = 0;
    activeUpgradeChoices: any[] = [];
    activeRaid: RaidMission | null = null;
    lastMode: 'endless' | 'raid' = 'endless';
    lastRaidId?: string;
    upgradeTargetSlot: string | null = null;
    pendingUpgradeItem: Item | null = null;
    pendingUpgradeIdx: number = -1;
    inventoryMode: 'equip' | 'upload' = 'equip';
    
    // Ascension State
    selectedAscensionItem: Item | null = null;
    ascensionIconFile: File | null = null;

    // Combo System
    combo = 0;
    comboTimer = 0;
    
    private boundMouseMove: (e: MouseEvent) => void;
    private boundMouseDown: (e: MouseEvent) => void;

    constructor() {
      gameInstance = this; // Set singleton
      game = this;
      this.canvas = document.getElementById('game-canvas') as HTMLCanvasElement;
      this.ctx = this.canvas.getContext('2d')!;
      this.director = new Director(this);
      
      try {
          this.player = new Player(); // Temp init
      } catch (e) {
          console.error("Player init failed, resetting meta", e);
          localStorage.removeItem(META_KEY);
          loadMeta();
          this.player = new Player();
      }
      
      // Bind handlers for cleanup
      this.boundMouseMove = this.handleMouseMove.bind(this);
      this.boundMouseDown = () => { mouse.down = true; };
      
      this.setupInputs();
      
      // Start Loop
      lastTime = performance.now();
      this.startLoop();
    }

    start(mode: 'endless' | 'raid' = 'endless', raidId?: string) {
      this.mode = mode;
      this.lastMode = mode;
      this.lastRaidId = raidId;
      this.player = new Player();
      this.portals = [];
      this.enemies = [];
      this.enemyStructures = [];
      this.turrets = [];
      this.mines = [];
      this.projectiles = [];
      this.particles = [];
      this.texts = [];
      this.score = 0;
      this.currencyCollected = 0;
      this.coresCollected = 0;
      this.lootFound = [];
      this.pendingUpgrades = 0;
      this.upgradeTargetSlot = null;
      this.pendingUpgradeItem = null;
      this.pendingUpgradeIdx = -1;
      this.combo = 0;
      this.comboTimer = 0;
      this.activeUpgradeChoices = [];
      this.state = 'PLAYING';
      
      if (mode === 'raid' && raidId) {
          this.activeRaid = RAIDS.find(r => r.id === raidId) || null;
      } else {
          this.activeRaid = null;
      }
      
      this.director = new Director(this);
      
      if (mode === 'raid') this.director.startRaid();
      else this.director.startWave();
      
      this.setScreen('hud-screen');
      document.getElementById('observer-ui')?.classList.remove('hidden');
      this.updateHud();
      this.addChatMessage("System", "Welcome to Server NEON_01. PvP is disabled.", "system");
      this.updateUpgradeUI();
      
      // Remove focus from UI buttons so Spacebar doesn't trigger them
      if (document.activeElement instanceof HTMLElement) document.activeElement.blur();
    }

    update(dt: number) {
      if (this.state !== 'PLAYING') return;

      this.director.update(dt);
      
      // Combo Decay
      if (this.combo > 0) {
          this.comboTimer -= dt;
          if (this.comboTimer <= 0) {
              this.combo = 0;
              this.updateHud();
          }
      }

      this.player.update(dt);
      this.portals.forEach(p => p.update(dt));
      this.turrets.forEach(t => t.update(dt));
      this.mines.forEach(m => m.update(dt));
      
      // Update Entities
      this.projectiles.forEach(p => {
          // Homing Logic
          if (p.homing && p.team === 'player') {
              let target = null;
              let minD = 400;
              for(const e of this.enemies) {
                  if (e.dead) continue;
                  const d = e.pos.sub(p.pos).mag();
                  if (d < minD) { minD = d; target = e; }
              }
              if (target) {
                  const desired = target.pos.sub(p.pos).normalize();
                  const current = p.vel.normalize();
                  const steer = desired.sub(current).mult(5 * dt);
                  p.vel = current.add(steer).normalize().mult(p.vel.mag());
              }
          }
          p.update(dt);
      });
      
      this.enemies.forEach(e => e.update(dt));
      this.enemyStructures.forEach(s => s.update(dt));
      this.particles.forEach(p => p.update(dt));
      this.texts.forEach(t => t.update(dt));

      // XP Pickup
      this.particles.forEach(p => {
          if (!p.dead && (p.type === 'xp' || p.type === 'core' || p.type.startsWith('fake') || p.type === 'loot' || p.type === 'merchant_signal' || p.type === 'rune')) {
              if (p.pos.sub(this.player.pos).mag() < 30) {
                  p.dead = true;
                  if (p.type === 'xp') {
                    this.player.gainXp(10 * p.value);
                    const comboMult = 1 + (this.combo * 0.01); // 1% per combo
                    const waveMult = 1 + (this.director.wave * 0.02); // 2% per wave
                    this.score += Math.floor(10 * selectedDifficulty * p.value * comboMult * waveMult);
                    this.currencyCollected += Math.floor(1 * selectedDifficulty * p.value);
                  } else if (p.type === 'core') {
                    const amount = p.value * selectedDifficulty;
                    this.coresCollected += amount;
                    this.texts.push(new FloatingText(this.player.pos, `+${amount} ЯДЕР`, "#ffd700"));
                    this.director.reportCollect();
                  } else if (p.type === 'loot') {
                    const item = this.generateLoot(p.lootData?.setId, p.lootData?.bonusCount);
                    this.lootFound.push(item);
                    this.texts.push(new FloatingText(this.player.pos, `ЛУТ: ${item.name}`, "#0ff"));
                    this.addChatMessage("System", `Получено: [${item.name}] (${item.desc})`, "system");
                  } else if (p.type.startsWith('fake')) {
                    // Holiday Trap
                    this.director.holidayPickups++;
                    if (this.director.holidayPickups > 2) {
                        this.gameOver("НИКАКОГО ПРАЗДНИКА!!!");
                    } else {
                        const msgs = ["ВКУСНО?", "ЕЩЕ?", "МАЛО?"];
                        this.texts.push(new FloatingText(this.player.pos, msgs[Math.floor(Math.random()*msgs.length)], "#ff00ff"));
                    }
                  } else if (p.type === 'merchant_signal') {
                      this.state = 'MENU'; // Pause
                      this.setScreen('merchant-screen');
                      this.generateMerchantItems();
                  } else if (p.type === 'rune') {
                      const types = ['power', 'haste', 'regen'];
                      const rType = types[Math.floor(Math.random()*types.length)];
                      this.player.activeRunes.push({ type: rType, timer: 30 * this.player.runeDurationMult });
                      this.texts.push(new FloatingText(this.player.pos, `РУНА: ${rType.toUpperCase()}`, "#0ff"));
                  }
              }
          }
      });

      // Collisions: Projectile vs Enemy
      for (let i = this.projectiles.length - 1; i >= 0; i--) {
        const p = this.projectiles[i];
        let hit = false;
        for (const e of this.enemies) {
          // Collision Logic
          let canHit = false;
          if (p.team === 'player') canHit = true;
          else if (p.team === 'invader' && p.owner !== e) canHit = true;
          else if (p.team === 'enemy' && e.config.type === 'invader') canHit = true;
          
          if (!canHit) continue;
          
          // CAGE MASTER LOGIC
          if (e.config.type === 'cage_master') {
              if (!e.cageActive) {
                  // Invulnerable when running
                  if (p.pos.sub(e.pos).mag() < e.radius + p.radius) {
                      p.dead = true;
                      this.texts.push(new FloatingText(p.pos, "IMMUNE", "#888"));
                      hit = true;
                      break;
                  }
                  continue;
              }
              // Check Cage Rim Collision (Blocks projectiles entering/exiting)
              const distToCenter = p.pos.sub(e.pos).mag();
              if (Math.abs(distToCenter - e.cageRadius) < 15) {
                  p.dead = true;
                  this.spawnParticles(p.pos, '#00f', 3);
                  hit = true;
                  break;
              }
          }

          // WALL RUNNER LOGIC
          if (e.config.type === 'wall_runner') {
              for (const w of e.walls) {
                  // Simple distance check to wall center (approximate)
                  if (p.pos.sub(w.pos).mag() < 40) { // 40 is approx half width
                      p.dead = true;
                      this.spawnParticles(p.pos, '#00ff88', 3);
                      hit = true;
                      break;
                  }
              }
              if (hit) break;
          }
          
          // SHIELD CHECK
          if (e.config.type === 'shielder') {
              const dist = p.pos.sub(e.pos).mag();
              // Check collision with shield (radius + visual offset)
              if (dist < e.radius + 15 + p.radius) {
                  // Vector from enemy to projectile
                  const toProj = p.pos.sub(e.pos).normalize();
                  // Enemy facing vector
                  const facing = new Vector(Math.cos(e.angle), Math.sin(e.angle));
                  // Dot product: 1 = front, -1 = back
                  const dot = toProj.dot(facing);
                  
                  // If hitting from front (approx 120 degrees cone)
                  if (dot > 0.5) {
                      p.dead = true;
                      this.spawnParticles(p.pos, '#00ffff', 3);
                      this.texts.push(new FloatingText(p.pos, "BLOCKED", "#0ff"));
                      hit = true;
                      break; // Stop processing this projectile
                  }
              }
          }
          
          // TRUE INVULNERABILITY CHECK
          if (e.isStealthed) continue;
          
          if (p.pos.sub(e.pos).mag() < e.radius + p.radius) {
            // Crit logic
            let dmg = p.dmg;
            dmg = Math.max(0, dmg); // Safety clamp against healing
            if (e.config.id.includes('boss')) dmg *= this.player.bossDmgMult;

            // --- CRIT SYSTEM (Multi-Tier) ---
            const totalCritChance = this.player.critChance;
            let critTier = Math.floor(totalCritChance);
            const remainder = totalCritChance - critTier;
            if (Math.random() < remainder) critTier++;

            let isCrit = critTier > 0;
            let critColor = '#fff';
            
            if (isCrit) {
                // Tier 1: x1, Tier 2: x2, Tier 3: x4... (Nerfed from x4 exponential)
                const tierMult = Math.pow(2, Math.max(0, critTier - 1));
                dmg *= this.player.critMult * tierMult;
                
                // Visuals
                if (critTier === 1) { critColor = '#ff0'; } // Yellow
                else if (critTier === 2) { critColor = '#f00'; this.screenShake = 2; } // Red (Super)
                else if (critTier === 3) { critColor = '#a020f0'; this.screenShake = 5; } // Purple (Mega)
                else { critColor = '#0ff'; this.screenShake = 10; } // Cyan (Giga)
            }

            // Frag Logic
            if (this.player.fragChance > 0 && Math.random() < this.player.fragChance) {
                for(let k=0; k<3; k++) {
                    const a = Math.random() * Math.PI * 2;
                    const dir = new Vector(Math.cos(a), Math.sin(a));
                    const v = dir.mult(300);
                    // Small shrapnel
                    // Spawn OUTSIDE the enemy to prevent instant self-hit
                    this.projectiles.push(new Projectile(e.pos.add(dir.mult(e.radius + 5)), v, dmg * 0.3, 'bullet', 'player'));
                }
                this.spawnParticles(e.pos, '#ffaa00', 5);
            }

            // Shield Logic
            if (e.shield > 0) {
                e.shield -= dmg;
                if (e.shield < 0) {
                    e.hp += e.shield; // Overflow to HP
                    e.shield = 0;
                }
            } else {
                e.hp -= dmg;
            }
            
            // Rocket AoE
            if (p.type === 'rocket') {
                this.spawnParticles(p.pos, '#ff5500', 10 * this.player.aoeRadius);
                this.enemies.forEach(subE => {
                    if (subE.pos.sub(p.pos).mag() < 100 * this.player.aoeRadius) {
                        subE.hp -= dmg * 0.5;
                    }
                });
                this.screenShake = 10;
            }

            // Knockback (Projectile Impact)
            if (this.player.knockback > 0 && e.shield <= 0 && !e.config.id.includes('boss')) {
                const push = p.vel.normalize().mult(this.player.knockback * 0.05); // Apply knockback force
                e.pos = e.pos.add(push);
            }
            
            // Lifesteal
            if (this.player.lifesteal > 0) {
                const heal = dmg * this.player.lifesteal;
                this.player.hp = Math.min(this.player.maxHp, this.player.hp + heal);
            }
            
            // Execute
            if (this.player.execute && !e.config.id.includes('boss') && e.hp < e.maxHp * 0.2) {
                dmg = e.hp + 100; // Kill
                this.texts.push(new FloatingText(e.pos, "EXECUTE", "#f00"));
            }
            
            // Lightning
            if (this.player.lightning && Math.random() < 0.3) {
                let count = 0;
                this.enemies.forEach(other => {
                    if (other !== e && !other.dead && count < 3 && other.pos.sub(e.pos).mag() < 200) {
                        other.hp -= dmg * 0.5;
                        this.spawnParticles(other.pos, '#0ff', 2); // Zap visual
                        if (other.hp <= 0 && !other.dead) {
                            this.onEnemyDeath(other);
                        }
                        count++;
                    }
                });
            }
            
            let dmgText = Math.floor(dmg).toString();
            if (critTier >= 2) dmgText += "!";
            if (critTier >= 3) dmgText += "!";
            
            this.texts.push(new FloatingText(e.pos, dmgText, critColor));
            
            hit = true;
            this.spawnParticles(e.pos, e.color, 3);
            if (e.hp <= 0) {
              this.onEnemyDeath(e);
            }
            
            // Ricochet Logic
            if (this.player.ricochet && p.bounces > 0) {
                p.bounces--;
                // Find nearest other enemy
                let target = null;
                let minD = 500;
                for(const other of this.enemies) {
                    if (other === e || other.dead) continue;
                    const d = other.pos.sub(p.pos).mag();
                    if (d < minD) { minD = d; target = other; }
                }
                if (target) {
                    p.vel = target.pos.sub(p.pos).normalize().mult(p.vel.mag());
                    // Don't kill projectile
                    hit = false; // Hack to keep it alive in loop logic if we were removing it
                    // But we need to ensure it doesn't hit 'e' again immediately. 
                    // Simple fix: move it slightly towards new target
                    p.pos = p.pos.add(p.vel.normalize().mult(e.radius + 5));
                } else {
                    p.dead = true;
                }
            } else {
                p.dead = true;
            }
            
            break;
          }
        }
      }

      // Collisions: Projectile vs Enemy Structure
      for (let i = this.projectiles.length - 1; i >= 0; i--) {
          const p = this.projectiles[i];
          if (p.dead || p.team !== 'player') continue;
          
          for (const s of this.enemyStructures) {
              if (p.pos.sub(s.pos).mag() < 25) {
                  s.hp -= p.dmg;
                  p.dead = true;
                  this.spawnParticles(s.pos, '#fff', 2);
                  if (s.hp <= 0) {
                      s.dead = true;
                      this.spawnParticles(s.pos, '#ff0000', 10);
                      this.texts.push(new FloatingText(s.pos, "DESTROYED", "#f00"));
                  }
                  break;
              }
          }
      }

      // Collisions: Enemy Projectiles vs Player
      this.projectiles.forEach(p => {
          if ((p.team === 'enemy' || p.team === 'invader') && !this.player.dead) {
              if (p.pos.sub(this.player.pos).mag() < this.player.radius + p.radius) {
                  this.player.hp -= p.dmg * this.player.damageTakenMult; // Apply Curse
                  p.dead = true;
                  this.screenShake = 5;
                  if (this.player.hp <= 0) {
                      let killer = "ВРАЖЕСКИЙ СНАРЯД";
                      if (p.team === 'invader') killer = "ИГРОК-ЗАХВАТЧИК";
                      if (p.type === 'laser') killer = "ЛАЗЕРНЫЙ ЛУЧ";
                      this.gameOver(killer);
                  }
                  this.updateHud();
              }
          }
      });

      // Collisions: Enemy vs Player
      if (!this.player.dead) {
        for (const e of this.enemies) {
          if (e.pos.sub(this.player.pos).mag() < e.radius + this.player.radius) {
            
            // Push back
            const pushDir = this.player.pos.sub(e.pos).normalize();
            this.player.vel = this.player.vel.add(pushDir.mult(300));
            
            // Attack Logic (Gated by Cooldown)
            if (e.hitCooldown <= 0) {
                // Dodge
                const effectiveDodge = Math.max(0, this.player.dodge) / (Math.max(0, this.player.dodge) + 1);
                if (Math.random() < effectiveDodge) {
                    this.texts.push(new FloatingText(this.player.pos, "DODGE", "#0ff"));
                    e.hitCooldown = 0.5; // Cooldown on miss
                    continue;
                }
                
                // Apply Damage
                this.player.hp -= e.damage * this.player.damageTakenMult;
                if (this.director.activeAnomaly?.type === 'berserk') this.player.hp -= 10;
                
                this.screenShake = 15;
                this.spawnParticles(this.player.pos, '#fff', 10);

                // Thorns & Effects (Only if not stealthed)
                if (!e.isStealthed) {
                    // Thorns
                    if (this.player.thorns > 0 || this.player.thornsPct > 0) {
                        const thornDmg = this.player.thorns + (e.damage * this.player.thornsPct);
                        e.hp -= thornDmg;
                        this.texts.push(new FloatingText(e.pos, `-${Math.floor(thornDmg)}`, "#888"));
                        if (e.hp <= 0 && !e.dead) {
                            this.onEnemyDeath(e);
                        }
                    }
                    
                    // Knockback Enemy (if no shield)
                    if (e.shield <= 0) {
                        let kb = this.player.knockback + 10;
                        // Anomaly: Zero G
                        if (this.director.activeAnomaly?.type === 'zero_g') kb *= 3;
                        e.pos = e.pos.sub(pushDir.mult(kb));
                    }
                    
                    // Vampire Heal
                    if (e.config.type === 'vampire') {
                        e.hp = Math.min(e.maxHp, e.hp + 10);
                        this.texts.push(new FloatingText(e.pos, "+HP", "#f0f"));
                    }
                } else {
                    // Stealthed hit logic (Surprise attack)
                    // Already took damage above, just skip thorns/knockback
                }
                
                e.hitCooldown = 0.5; // 2 hits per second max
            }

            if (this.player.hp <= 0) {
              this.gameOver(`УБИТ: ${e.config.id.toUpperCase()}`);
            }
            this.updateHud();
          }
        }
      }

      // Cleanup
      // Optimization: Use reverse loop splice instead of filter to reduce GC
      for (let i = this.projectiles.length - 1; i >= 0; i--) {
          if (this.projectiles[i].dead) this.projectiles.splice(i, 1);
      }
      for (let i = this.enemies.length - 1; i >= 0; i--) {
          const e = this.enemies[i];
          // Safety net for immortal/glitched mobs (NaN check)
          if (e.hp <= 0 || isNaN(e.hp) || isNaN(e.pos.x) || isNaN(e.pos.y)) {
              if (!e.dead) {
                  // If NaN, force kill silently. If HP<=0, trigger death logic.
                  if (isNaN(e.hp) || isNaN(e.pos.x) || isNaN(e.pos.y)) e.dead = true;
                  else this.onEnemyDeath(e);
              }
          }
          
          if (this.enemies[i].dead) this.enemies.splice(i, 1);
      }
      for (let i = this.enemyStructures.length - 1; i >= 0; i--) if (this.enemyStructures[i].dead) this.enemyStructures.splice(i, 1);
      for (let i = this.portals.length - 1; i >= 0; i--) if (this.portals[i].dead) this.portals.splice(i, 1);
      for (let i = this.turrets.length - 1; i >= 0; i--) if (this.turrets[i].dead) this.turrets.splice(i, 1);
      for (let i = this.mines.length - 1; i >= 0; i--) if (this.mines[i].dead) this.mines.splice(i, 1);
      for (let i = this.particles.length - 1; i >= 0; i--) {
          if (this.particles[i].dead) this.particles.splice(i, 1);
      }
      for (let i = this.texts.length - 1; i >= 0; i--) {
          if (this.texts[i].life <= 0) this.texts.splice(i, 1);
      }

      // Shake decay
      if (this.screenShake > 0) this.screenShake -= dt * 30;
      if (this.screenShake < 0) this.screenShake = 0;
    }

    draw() {
      if (this.state === 'TREE') return; // Canvas handled by TreeRenderer

      // Clear
      this.ctx.fillStyle = '#050505';
      this.ctx.fillRect(0, 0, CANVAS_W, CANVAS_H);

      // Grid Background
      this.ctx.strokeStyle = '#1a1a1a';
      this.ctx.lineWidth = 2;
      this.ctx.beginPath();
      for(let x=0; x<CANVAS_W; x+=100) { this.ctx.moveTo(x,0); this.ctx.lineTo(x,CANVAS_H); }
      for(let y=0; y<CANVAS_H; y+=100) { this.ctx.moveTo(0,y); this.ctx.lineTo(CANVAS_W,y); }
      this.ctx.stroke();

      this.ctx.save();
      
      // Screen Shake
      if (this.screenShake > 0) {
        const dx = (Math.random() - 0.5) * this.screenShake;
        const dy = (Math.random() - 0.5) * this.screenShake;
        this.ctx.translate(dx, dy);
      }

      this.portals.forEach(p => p.draw(this.ctx));
      this.particles.forEach(p => p.draw(this.ctx));
      this.projectiles.forEach(p => p.draw(this.ctx));
      this.enemies.forEach(e => e.draw(this.ctx));
      this.enemyStructures.forEach(s => s.draw(this.ctx));
      this.turrets.forEach(t => t.draw(this.ctx));
      this.mines.forEach(m => m.draw(this.ctx));
      this.texts.forEach(t => t.draw(this.ctx));
      if (!this.player.dead && this.state === 'PLAYING') this.player.draw(this.ctx);
      
      // Weather Overlay
      if (this.director.weather === 'rain') {
          this.ctx.strokeStyle = 'rgba(100, 100, 255, 0.4)';
          this.ctx.lineWidth = 1;
          this.ctx.beginPath();
          // Draw 100 random rain drops
          for(let i=0; i<100; i++) {
              const x = Math.random() * CANVAS_W;
              const y = Math.random() * CANVAS_H;
              const len = 15 + Math.random() * 20;
              const angle = Math.PI / 2 + (Math.random() - 0.5) * 0.4; // Slight angle variation
              this.ctx.moveTo(x, y);
              this.ctx.lineTo(x + Math.cos(angle)*len, y + Math.sin(angle)*len);
          }
          this.ctx.stroke();
      } else if (this.director.weather === 'fog') {
          this.ctx.fillStyle = 'rgba(200,200,200,0.3)'; // Thicker fog
          this.ctx.fillRect(0,0,CANVAS_W,CANVAS_H);
      }

      this.ctx.restore();

      // Chromatic Aberration on heavy shake
      if (this.screenShake > 10) {
        // const imageData = this.ctx.getImageData(0,0,CANVAS_W,CANVAS_H);
        // Heavy operation, do sparingly or optimize (skipped for performance in this snippet)
        // Instead, draw a red overlay
        this.ctx.fillStyle = 'rgba(255,0,0,0.1)';
        this.ctx.fillRect(0,0,CANVAS_W,CANVAS_H);
      }
    }

    // --- RPG SYSTEMS ---
    generateLoot(setId?: string, setBonusCount?: number): Item {
        const type = ITEM_TYPES[Math.floor(Math.random() * ITEM_TYPES.length)] as any;
        const rarityRoll = Math.random() + (this.player.luck * 0.01); // Luck bonus
        let rarity: any = 'common';
        if (rarityRoll > 0.99) rarity = 'divine';
        else if (rarityRoll > 0.97) rarity = 'mythic';
        else if (rarityRoll > 0.90) rarity = 'legendary';
        else if (rarityRoll > 0.75) rarity = 'epic';
        else if (rarityRoll > 0.5) rarity = 'rare';
        
        const icons = { weapon: '⚔️', armor: '🛡️', chip: '💾' };
        const names = { weapon: ['Rifle', 'Repeater', 'Cannon'], armor: ['Plate', 'Shield', 'Suit'], chip: ['CPU', 'RAM', 'Drive'] };
        const suffixes = { common: 'v1', rare: 'Pro', epic: 'Elite', legendary: 'GOD', mythic: 'OMEGA', divine: 'ZERO' };
        
        const name = `${names[type][Math.floor(Math.random()*3)]} ${suffixes[rarity] || 'v1'}`;
        
        const mult = { common: 1, rare: 2, epic: 4, legendary: 8, mythic: 16, divine: 32 };
        const m = mult[rarity];
        
        const isWeakSet = setId && IMMUTABLE_SETS.includes(setId);
        const stats: any = {};
        const setStats: any = {};
        
        // Helper to add stat
        const addStat = (key: string, base: number, isPct: boolean = false) => {
            const val = isPct ? Math.random() * base * m : Math.floor(Math.random() * base * m) + 1;
            const rounded = roundStat(key, val);
            if (rounded > 0) stats[key] = rounded;
        };

        if (type === 'weapon') { 
            addStat('dmg', 3);
            // Nerfed crit: 0.5% base -> 4% at legendary (x8)
            if (Math.random() > 0.5) addStat('crit', 0.005, true); 
            if (Math.random() > 0.7) addStat('cooldown', 0.02, true);
            if (Math.random() > 0.8) addStat('area', 0.1, true);
            if (Math.random() > 0.85) addStat('knockback', 10);
            if (Math.random() > 0.9) addStat('lifesteal', 0.005, true);
            if (Math.random() > 0.95) addStat('multishot', 0.5); // Rare multishot
        }
        if (type === 'armor') { 
            addStat('hp', 15);
            if (Math.random() > 0.5) addStat('regen', 1);
            if (Math.random() > 0.7) addStat('spd', 5);
            if (Math.random() > 0.8) addStat('luck', 5);
            if (Math.random() > 0.8) addStat('dodge', 0.02, true);
            if (Math.random() > 0.8) addStat('thorns', 5);
        }
        if (type === 'chip') { 
            // Chips are versatile
            const keys = ['spd', 'crit', 'cooldown', 'luck', 'area', 'magnet', 'dodge', 'lifesteal', 'spread', 'projSpeed', 'frag', 'curse', 'slow'];
            const k1 = keys[Math.floor(Math.random()*keys.length)];
            
            const isPct = !['spd', 'luck', 'magnet'].includes(k1);
            const baseVal = isPct ? (k1 === 'crit' ? 0.005 : 0.02) : 5;
            
            addStat(k1, baseVal, isPct);
            
            if (Math.random() > 0.5) {
                 const k2 = keys[Math.floor(Math.random()*keys.length)];
                 const isPct2 = !['spd', 'luck', 'magnet'].includes(k2);
                 const baseVal2 = isPct2 ? (k2 === 'crit' ? 0.005 : 0.02) : 5;
                 if (k2 !== k1) addStat(k2, baseVal2, isPct2);
            }
        }
        
        // Set Generation
        if (setId && setBonusCount) {
            const keys = ['dmg', 'hp', 'crit', 'spd', 'cooldown', 'luck', 'area', 'regen', 'lifesteal', 'dodge', 'thorns'];
            for(let i=0; i<setBonusCount; i++) {
                const k = keys[Math.floor(Math.random() * keys.length)];
                const isPct = !['spd', 'luck', 'hp', 'dmg', 'regen', 'thorns'].includes(k);
                let base = isPct ? 0.01 : 5; // Nerfed base for sets (was 0.05 / 10)
                if (isWeakSet) base *= 0.5; // Weak sets have lower values
                const val = isPct ? Math.random() * base * m : Math.floor(Math.random() * base * m) + 1;
                const current = setStats[k] || 0;
                setStats[k] = roundStat(k, current + val);
            }
        }
        
        // Chance for Debuff / Negative Stat for ALL items (including Sets)
        let debuffChance = 0.3;
        if (isWeakSet) debuffChance = 0.7; // Higher chance for weak sets
        
        if (Math.random() < debuffChance) {
            const badKeys = ['curse', 'slow', 'spread'];
            const k3 = badKeys[Math.floor(Math.random() * badKeys.length)];
            // Add a "bad" stat (positive value for curse/slow/spread is bad)
            if (k3 === 'spread') stats[k3] = roundStat(k3, (stats[k3] || 0) + 10);
            if (k3 === 'curse') stats[k3] = roundStat(k3, (stats[k3] || 0) + 0.1);
            if (k3 === 'slow') stats[k3] = roundStat(k3, (stats[k3] || 0) + 0.1);
        }

        // 10% Global Chance for Corruption
        const isCorrupted = Math.random() < 0.1;
        
        return { id: Math.random().toString(36).substr(2,9), name, desc: undefined, type, rarity, stats, icon: icons[type], level: 0, modified: false, setId, setStats, source: "Neon Protocol", isCorrupted };
    }

    generateMerchantItems() {
        const container = document.getElementById('merchant-items');
        if (!container) return;
        container.innerHTML = '';
        
        for(let i=0; i<3; i++) {
            const item = this.generateLoot();
            const price = Math.floor(100 * (1 - this.player.merchantDiscount));
            const el = document.createElement('div');
            el.className = 'mini-card';
            const iconHtml = (item.icon && item.icon.startsWith('http')) ? `<img src="${item.icon}" style="width: 40px; height: 40px; object-fit: cover;">` : item.icon;
            
            el.innerHTML = `<div class="icon">${iconHtml}</div><div class="name">${item.name}</div><div class="desc">Цена: ${price}</div>`;
            el.onclick = () => {
                if (this.currencyCollected >= price) {
                    this.currencyCollected -= price;
                    meta.inventory.push(item);
                    el.remove();
                }
            };
            container.appendChild(el);
        }
    }

    addChatMessage(name?: string, msg?: string, type: 'user'|'system' = 'user') {
        if (!name) name = CHAT_USERNAMES[Math.floor(Math.random() * CHAT_USERNAMES.length)];
        if (!msg) msg = CHAT_PHRASES[Math.floor(Math.random() * CHAT_PHRASES.length)];
        
        const log = document.getElementById('chat-log');
        if (log) {
            const line = document.createElement('div');
            line.className = `chat-msg ${type}`;
            line.innerHTML = type === 'system' ? `[SYSTEM]: ${msg}` : `<span class="name">[${name}]:</span> ${msg}`;
            log.appendChild(line);
            // Оставляем только 5 последних сообщений
            while (log.children.length > 5) {
                log.removeChild(log.firstChild!);
            }
        }
    }

    spawnEnemy(typeId: string, elite: boolean, pos?: Vector, portalColor?: string, durationOverride?: number) {
      if (!pos) {
          // Random edge position
          // Spawn strictly at edges (with padding for radius)
          const padding = 40;
          if (Math.random() > 0.5) {
            pos = new Vector(Math.random() > 0.5 ? padding : CANVAS_W - padding, Math.random() * (CANVAS_H - padding*2) + padding);
          } else {
            pos = new Vector(Math.random() * (CANVAS_W - padding*2) + padding, Math.random() > 0.5 ? padding : CANVAS_H - padding);
          }
      }
      
      let duration = durationOverride || (1 + Math.random() * 2); // 1-3 seconds for normal mobs
      let color = portalColor || '#0ff';
      
      if ((typeId.includes('boss') || typeId === 'invader') && !durationOverride) {
         duration = 10 + Math.random() * 50; // 10-60 seconds for bosses
         color = '#a020f0'; // Purple
         this.texts.push(new FloatingText(new Vector(CANVAS_W/2, 200), "ВНИМАНИЕ: БОСС", "#f00"));
         this.screenShake = 30;
      }
      
      if (typeId === 'invader') {
          duration = 10;
          color = '#ff0000';
      }
      
      // Boss Rush immediate spawn
      if (this.mode === 'raid' && this.activeRaid?.type === 'boss_rush' && typeId.includes('boss')) {
          duration = 3.0;
      }

      // Create Portal instead of immediate spawn
      this.portals.push(new Portal(pos, typeId, elite, duration, color));
    }

    triggerNuke() {
        this.screenShake = 50;
        const nukeDmg = 1000 + (this.player.damage * 20); // Scaled damage instead of instant kill
        
        this.enemies.forEach(e => {
            e.hp -= nukeDmg;
            
            // Push back to create space
            let pushDir = e.pos.sub(this.player.pos).normalize();
            if (pushDir.x === 0 && pushDir.y === 0) pushDir = new Vector(1, 0);
            
            e.pos = e.pos.add(pushDir.mult(400));

            this.spawnParticles(e.pos, '#fff', 5);
            this.texts.push(new FloatingText(e.pos, Math.floor(nukeDmg).toString(), "#fff"));
            
            if (e.hp <= 0) this.onEnemyDeath(e);
        });
    }

    spawnHolidayItem() {
        const types = ['fake_hp', 'fake_shield', 'fake_xp'];
        const type = types[Math.floor(Math.random() * types.length)] as any;
        const offset = new Vector((Math.random()-0.5)*300, (Math.random()-0.5)*300);
        this.particles.push(new Particle(this.player.pos.add(offset), new Vector(0,0), '#fff', 10, type));
    }

    spawnParticles(pos: Vector, color: string, count: number, type: 'vfx' | 'xp' | 'core' | 'fake_hp' | 'fake_shield' | 'fake_xp' | 'loot' | 'merchant_signal' | 'rune' = 'vfx', value: number = 1, lootData?: {setId: string, bonusCount: number}) {
      let particleCount = count;
      let particleValue = value;
      let particleSize = type === 'xp' ? 6 : Math.random() * 3 + 1;

      // XP Optimization
      if (type === 'xp') {
          if (count >= 50) { // Boss
              particleCount = 5;
              particleValue = 10;
              particleSize = 12;
          } else if (count >= 5) { // Elite
              particleCount = 1;
              particleValue = 5;
              particleSize = 9;
          }
      }

      for(let i=0; i<particleCount; i++) {
        const angle = Math.random() * Math.PI * 2;
        const speed = Math.random() * 200 + 50;
        const vel = new Vector(Math.cos(angle), Math.sin(angle)).mult(speed);
        const p = new Particle(pos, vel, color, particleSize, type, particleValue);
        if (lootData) p.lootData = lootData;
        this.particles.push(p);
      }
    }

    triggerLevelUp() {
      this.pendingUpgrades++;
      this.texts.push(new FloatingText(this.player.pos, "НОВЫЙ УРОВЕНЬ!", "#ffd700"));
      
      if (this.activeUpgradeChoices.length === 0) {
          this.generateUpgradeChoices();
      }
      this.updateUpgradeUI();
    }
    
    generateUpgradeChoices() {
      const container = document.getElementById('ingame-cards');
      if (!container) return;
      container.innerHTML = '';
      this.activeUpgradeChoices = [];

      const upgrades: { id: string; name: string; desc: string; icon: string; action: () => void }[] = [
        { id: 'dmg', name: 'УСИЛЕНИЕ УРОНА', desc: '+5 Урона', icon: '⚔️', action: () => this.player.damage += 5 },
        { id: 'spd', name: 'ЛОВКОСТЬ', desc: '+10% Скорости', icon: '⚡', action: () => this.player.speed *= 1.1 },
        { id: 'hp', name: 'РЕМОНТ', desc: 'Лечение 50 HP', icon: '♥', action: () => this.player.hp = Math.min(this.player.maxHp, this.player.hp + 50) },
        { id: 'multi', name: 'МУЛЬТИВЫСТРЕЛ', desc: '+1 Снаряд', icon: '💥', action: () => this.player.multishot += 1 },
        { id: 'rate', name: 'СКОРОСТРЕЛЬНОСТЬ', desc: '+15% Скорости стрельбы', icon: '🔫', action: () => this.player.fireRate *= 0.85 }
      ];
      
      // Add Weapon Upgrades if unlocked
      if (meta.unlocks.includes('w_shotgun')) {
          if (this.player.weapon === 'shotgun') {
              upgrades.push({ id: 'w_shot_up', name: 'ТЮНИНГ: ДРОБОВИК', desc: '+1 Дробь, +10% Урона', icon: '🧨', action: () => { this.player.multishot += 1; this.player.damage *= 1.1; } });
          } else {
              upgrades.push({ id: 'w_shot', name: 'ДРОБОВИК', desc: 'Сменить оружие', icon: '🧨', action: () => { this.player.weapon = 'shotgun'; this.player.fireRate = 0.8; } });
          }
      }
      
      if (meta.unlocks.includes('w_rocket')) {
          if (this.player.weapon === 'rocket') {
              upgrades.push({ id: 'w_rock_up', name: 'ТЮНИНГ: РАКЕТЫ', desc: '+20% Радиус, +10% Урона', icon: '🚀', action: () => { this.player.aoeRadius *= 1.2; this.player.damage *= 1.1; } });
          } else {
              upgrades.push({ id: 'w_rock', name: 'РАКЕТНИЦА', desc: 'Сменить оружие', icon: '🚀', action: () => { this.player.weapon = 'rocket'; this.player.fireRate = 1.0; } });
          }
      }
      
      if (meta.unlocks.includes('w_laser')) {
          if (this.player.weapon === 'laser') {
              upgrades.push({ id: 'w_las_up', name: 'ТЮНИНГ: ЛАЗЕР', desc: '+15% Скорострельности', icon: '🔦', action: () => { this.player.fireRate *= 0.85; } });
          } else {
              upgrades.push({ id: 'w_las', name: 'ЛАЗЕР', desc: 'Сменить оружие', icon: '🔦', action: () => { this.player.weapon = 'laser'; this.player.fireRate = 0.4; } });
          }
      }
      
      if (meta.unlocks.includes('w_plasma')) {
          if (this.player.weapon === 'plasma') {
              upgrades.push({ id: 'w_plas_up', name: 'ТЮНИНГ: ПЛАЗМА', desc: '+1 Снаряд, +5% Урона', icon: '🟣', action: () => { this.player.multishot += 1; this.player.damage *= 1.05; } });
          } else {
              upgrades.push({ id: 'w_plas', name: 'ПЛАЗМА', desc: 'Сменить оружие', icon: '🟣', action: () => { this.player.weapon = 'plasma'; this.player.fireRate = 0.15; } });
          }
      }

      // Pick 3 random
      for(let i=0; i<3; i++) {
        const u = upgrades[Math.floor(Math.random() * upgrades.length)];
        this.activeUpgradeChoices.push(u);
        
        const card = document.createElement('div');
        card.className = 'mini-card';
        card.innerHTML = `<div class="key-hint">${i+1}</div><div class="icon">${u.icon}</div><div class="name">${u.name}</div><div class="desc">${u.desc}</div>`;
        card.onclick = () => this.selectUpgrade(i);
        container.appendChild(card);
      }
    }

    selectUpgrade(index: number) {
        if (index < 0 || index >= this.activeUpgradeChoices.length) return;
        const u = this.activeUpgradeChoices[index];
        u.action();
        this.pendingUpgrades--;
        this.activeUpgradeChoices = []; // Clear current
        if (this.pendingUpgrades > 0) {
            this.generateUpgradeChoices();
        }
        this.updateUpgradeUI();
    }
    
    updateUpgradeUI() {
        const ui = document.getElementById('ingame-upgrades');
        const countEl = document.getElementById('pending-count');
        if (!ui || !countEl) return;
        
        if (this.pendingUpgrades > 0 || this.activeUpgradeChoices.length > 0) {
            ui.classList.remove('hidden');
            countEl.innerText = this.pendingUpgrades > 1 ? `(+${this.pendingUpgrades-1})` : '';
        } else {
            ui.classList.add('hidden');
        }
    }

    onEnemyDeath(e: Enemy) {
        if (e.dead) return;
        e.dead = true;

        // Invader Rewards
        if (e.config.type === 'invader') {
            const inv = e as Invader;
            this.addChatMessage("System", `Игрок ${inv.name} был уничтожен!`, "system");
            // Item Reward
            const item = this.generateLoot();
            meta.inventory.push(item);
            this.texts.push(new FloatingText(e.pos, `ЛУТ: ${item.name}`, "#0f0"));
            // Core Reward
            const cores = Math.floor(Math.random() * 9) + 2; // 2-10
            meta.bossCurrency += cores;
            this.texts.push(new FloatingText(e.pos, `+${cores} ЯДЕР`, "#ffd700"));
        }

        // Spawn XP
        this.director.reportKill(); // Report kill for mood logic
        
        // Combo Logic
        this.combo++;
        this.comboTimer = 2.5;
        const comboEl = document.getElementById('hud-combo-count');
        if (comboEl) {
            comboEl.classList.remove('pulse');
            void comboEl.offsetWidth; // trigger reflow
            comboEl.classList.add('pulse');
        }
        
        const dropCount = e.config.id.includes('boss') ? 50 : (e.elite ? 5 : 1);
        this.spawnParticles(e.pos, '#0f0', dropCount, 'xp');
        
        // Boss Drop
        if (e.config.id.includes('boss')) {
            // Boss drops cores equal to wave number
            this.spawnParticles(e.pos, '#ffd700', 1, 'core', this.director.wave);
            this.screenShake = 20;
            // Boss Loot Drop
            this.spawnParticles(e.pos, '#fff', 1, 'loot');
            this.addChatMessage("Global", `Игрок ${meta.username} уничтожил ${e.config.id}!`, "system");
            
            // Raid Victory Condition
            if (this.mode === 'raid' && this.activeRaid && e.config.id === this.activeRaid.bossId) {
                setTimeout(() => this.victory(), 2000);
            }
        } else {
            // 1% Chance for Core from regular mobs
            if (Math.random() < 0.01) {
                this.spawnParticles(e.pos, '#ffd700', 1, 'core', 1);
            }
            if (e.elite && Math.random() < 0.3) {
                this.spawnParticles(e.pos, '#fff', 1, 'loot');
            }

            // T-Series Drops (Weak Sets)
            const roll = Math.random();
            // T34: 0.0001% (0.000001)
            if (roll < 0.000001) this.spawnParticles(e.pos, '#00ffff', 1, 'loot', 1, { setId: 't34', bonusCount: 34 });
            // T4: 0.1% (0.001)
            else if (roll < 0.001) this.spawnParticles(e.pos, '#ff3333', 1, 'loot', 1, { setId: 't4', bonusCount: 4 });
            // T3: 0.5% (0.005)
            else if (roll < 0.005) this.spawnParticles(e.pos, '#ffd700', 1, 'loot', 1, { setId: 't3', bonusCount: 3 });
            // T2: 1% (0.01)
            else if (roll < 0.01) this.spawnParticles(e.pos, '#a020f0', 1, 'loot', 1, { setId: 't2', bonusCount: 2 });
            // T1: 2% (0.02)
            else if (roll < 0.02) this.spawnParticles(e.pos, '#fff', 1, 'loot', 1, { setId: 't1', bonusCount: 1 });
        }
        
        // Rune Drop (Elite)
        if (e.elite && Math.random() < 0.2) {
            this.spawnParticles(e.pos, '#00ffff', 1, 'rune');
        }
    }

    gameOver(killer?: string) {
      // Extra Lives
      if (this.player.extraLives > 0) {
          this.player.extraLives--;
          this.player.hp = this.player.maxHp;
          this.texts.push(new FloatingText(this.player.pos, "REVIVED!", "#fff"));
          this.triggerNuke(); // Clear screen on revive
          return;
      }
    
      // Auto-collect everything on screen before ending
      this.autoCollectAll();

      this.state = 'GAMEOVER';
      this.player.dead = true;
      
      // Release controls
      for(const k in keys) delete keys[k];
      mouse.down = false;
      
      // Hide previous input if any
      const inputDiv = document.getElementById('highscore-input');
      if (inputDiv) inputDiv.classList.add('hidden');
      
      const reasonEl = document.getElementById('go-reason');
      if (reasonEl) {
          reasonEl.innerText = killer ? `ПРИЧИНА: ${killer}` : "ПРИЧИНА: НЕИЗВЕСТНО";
      }
      
      // Save Meta
      meta.currency += this.currencyCollected;
      meta.bossCurrency += this.coresCollected;
      // Save Loot
      if (this.lootFound.length > 0) {
          meta.inventory.push(...this.lootFound);
          this.texts.push(new FloatingText(this.player.pos, `SAVED ${this.lootFound.length} ITEMS`, "#fff"));
      }
      if (this.score > meta.bestScore) meta.bestScore = this.score;
      saveMeta();

      // Submit to Global Leaderboard
      checkAndSubmitScore(this.score);

      document.getElementById('go-score')!.innerText = this.score.toString();
      document.getElementById('go-currency')!.innerText = this.currencyCollected.toString();
      document.getElementById('go-cores')!.innerText = this.coresCollected.toString();
      
      // Show Loot List
      const lootList = document.getElementById('go-loot-list');
      if (lootList) {
          lootList.innerHTML = this.lootFound.length > 0 
            ? this.lootFound.map(i => `<div style="color:${this.getItemColor(i.rarity)}">${i.name}</div>`).join('')
            : "НЕТ ПРЕДМЕТОВ";
      }

      this.setScreen('gameover-screen');
    }

    victory() {
        this.autoCollectAll(); // Collect pending drops
        this.state = 'GAMEOVER'; // Stop updates
        
        // Save Loot collected during run
        if (this.lootFound.length > 0) {
            meta.inventory.push(...this.lootFound);
            this.texts.push(new FloatingText(this.player.pos, `SAVED ${this.lootFound.length} ITEMS`, "#fff"));
        }

        // Save collected currency/cores (Fix: previously ignored on victory)
        meta.currency += this.currencyCollected;
        meta.bossCurrency += this.coresCollected;

        let rewardText = "";
        if (this.activeRaid) {
            const lvl = this.activeRaid.rewardLevel;
            
            if (this.activeRaid.type === 'wave') {
                const currency = 100 * lvl * 5;
                const cores = 5 * lvl;
                meta.currency += currency;
                meta.bossCurrency += cores;
                
                // 1-3 Items
                const count = Math.floor(Math.random() * 3) + 1;
                for(let i=0; i<count; i++) meta.inventory.push(this.generateLoot());
                
                rewardText = `${currency} ОСКОЛКОВ, ${cores} ЯДЕР, ${count} ПРЕДМЕТОВ`;
            } else if (this.activeRaid.type === 'boss_rush') {
                // Set Item
                const item = this.generateLoot(this.activeRaid.setId, this.activeRaid.setBonusCount);
                item.rarity = 'rare'; // Min rare for raid
                
                // Если предмет выпал зараженным (10% шанс), он становится Возвышенным (меняет сет)
                if (item.isCorrupted && item.setId && !IMMUTABLE_SETS.includes(item.setId)) {
                    const newSet = ASCENDED_SETS[Math.floor(Math.random() * ASCENDED_SETS.length)];
                    item.setId = newSet;
                }

                meta.inventory.push(item);
                rewardText = `ПРЕДМЕТ: ${item.name}`;
            }
            saveMeta();
        }
        
        document.getElementById('vic-reward')!.innerText = rewardText;
        this.setScreen('victory-screen');
    }

    autoCollectAll() {
        this.particles.forEach(p => {
            if (!p.dead && (p.type === 'xp' || p.type === 'core' || p.type === 'loot')) {
                p.dead = true;
                if (p.type === 'xp') {
                    this.player.gainXp(10 * p.value);
                    const comboMult = 1 + (this.combo * 0.01);
                    const waveMult = 1 + (this.director.wave * 0.02);
                    this.score += Math.floor(10 * selectedDifficulty * p.value * comboMult * waveMult);
                    this.currencyCollected += Math.floor(1 * selectedDifficulty * p.value);
                } else if (p.type === 'core') {
                    this.coresCollected += p.value * selectedDifficulty;
                } else if (p.type === 'loot') {
                    const item = this.generateLoot();
                    this.lootFound.push(item);
                }
            }
        });
        
        // Also collect from active portals if boss rush (instant kill reward logic fallback)
        // But usually boss death handles spawn.
        // If boss died but particles were flying, the loop above catches them.
        
        // Update stats one last time
        if (this.director.activeQuest && this.director.activeQuest.type === 'collect') {
            // Force complete if close? No, fair play.
            this.director.updateUI();
        }
    }

    updateHud() {
      document.getElementById('hud-score')!.innerText = this.score.toString();
      document.getElementById('hud-level')!.innerText = this.player.level.toString();
      document.getElementById('hud-wave')!.innerText = this.director.wave.toString();
      document.getElementById('hud-enemies')!.innerText = this.enemies.length.toString();
      
      const hpPct = (this.player.hp / this.player.maxHp) * 100;
      document.getElementById('hud-hp-bar')!.style.width = `${Math.max(0, hpPct)}%`;
      document.getElementById('hud-hp-text')!.innerText = `${Math.max(0, Math.ceil(this.player.hp))}/${Math.ceil(this.player.maxHp)}`;
      
      // Projectile Count
      const projEl = document.getElementById('hud-proj-count');
      if (projEl) projEl.innerText = `x${this.player.multishot} СНАРЯДОВ`;
      
      const heatPct = (this.player.heat / this.player.maxHeat) * 100;
      const heatBar = document.getElementById('hud-heat-bar');
      if (heatBar) {
          heatBar.style.width = `${Math.min(100, heatPct)}%`;
          if (this.player.isOverheated) heatBar.classList.add('overheated');
          else heatBar.classList.remove('overheated');
      }
      
      // Toggle Skills HUD based on class
      const skillsHud = document.querySelector('.skills-hud') as HTMLElement;
      // Always show skills HUD now as all classes have skills
      if (skillsHud) skillsHud.style.display = 'flex';
      
      // Skills CD
      const qPct = Math.max(0, this.player.mineCooldown / (5.0 * this.player.cooldownMult)) * 100;
      const ePct = Math.max(0, this.player.turretCooldown / (15.0 * this.player.cooldownMult)) * 100;
      document.getElementById('cd-q')!.style.height = `${qPct}%`;
      document.getElementById('cd-e')!.style.height = `${ePct}%`;
      
      const xpPct = (this.player.xp / this.player.maxXp) * 100;
      document.getElementById('hud-xp-bar')!.style.width = `${xpPct}%`;
      document.getElementById('hud-xp-text')!.innerText = `XP: УРОВЕНЬ ${this.player.level}`;
      
      // Combo UI
      const comboContainer = document.getElementById('hud-combo-container');
      const comboCount = document.getElementById('hud-combo-count');
      if (comboContainer && comboCount) {
          if (this.combo > 1) comboContainer.classList.remove('hidden');
          else comboContainer.classList.add('hidden');
          comboCount.innerText = `x${this.combo}` + (this.combo >= 50 ? ' ПЕРЕГРУЗКА!' : '');
          if (this.combo >= 50) comboCount.style.color = '#0ff';
          else comboCount.style.color = '#ffd700';
      }
      
      const questContainer = document.getElementById('hud-quest-container');
      if (questContainer) {
          if (this.director.activeQuest) {
              questContainer.classList.remove('hidden');
              const q = this.director.activeQuest;
              document.getElementById('hud-quest-text')!.innerText = `${q.desc} (${Math.floor(q.current)}/${q.target})`;
          }
          else questContainer.classList.add('hidden');
      }
    }

    renderClassSelector() {
        const list = document.getElementById('char-list');
        const nameDisplay = document.getElementById('char-name-display');
        const descDisplay = document.getElementById('char-desc-display');
        const confirmBtn = document.getElementById('btn-char-confirm') as HTMLButtonElement;
        
        if (!list || !nameDisplay || !descDisplay) return;
        
        list.innerHTML = '';
        
        CLASSES.forEach(cls => {
            const btn = document.createElement('div');
            btn.className = 'char-btn';
            const isUnlocked = !cls.unlock || meta.unlocks.includes(cls.unlock);
            
            // Check if this class is currently selected
            if (cls.id === selectedClass) {
                btn.classList.add('selected');
                nameDisplay.innerText = cls.name;
                descDisplay.innerText = cls.desc;
                if (confirmBtn) confirmBtn.disabled = !isUnlocked;
            }
            
            btn.innerHTML = `
                <div style="font-weight:bold; color:${isUnlocked ? '#fff' : '#666'}">${isUnlocked ? cls.name : 'ЗАКРЫТО'}</div>
                <div style="font-size:0.7rem; color:#888">${isUnlocked ? 'ОПЕРАТОР' : 'ТРЕБУЕТСЯ РАЗБЛОКИРОВКА'}</div>
            `;
            
            if (!isUnlocked) {
                btn.classList.add('locked');
            } else {
                btn.onclick = (e) => {
                    document.querySelectorAll('.char-btn').forEach(b => b.classList.remove('selected'));
                    btn.classList.add('selected');
                    selectedClass = cls.id;
                    nameDisplay.innerText = cls.name;
                    descDisplay.innerText = cls.desc;
                    if (confirmBtn) confirmBtn.disabled = false;
                };
            }
            list.appendChild(btn);
        });
    }

    setScreen(id: string) {
      document.querySelectorAll('.screen').forEach(el => el.classList.add('hidden'));
      document.querySelectorAll('.screen').forEach(el => el.classList.remove('active'));
      const el = document.getElementById(id);
      if (el) {
        el.classList.remove('hidden');
        el.classList.add('active');
      }
      
      // Hide Observer UI if not playing
      if (id !== 'hud-screen') {
         document.getElementById('observer-ui')?.classList.add('hidden');
      }
    }

