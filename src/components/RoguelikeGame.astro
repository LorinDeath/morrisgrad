  class Enemy extends Entity {
    hp: number;
    maxHp: number;
    shield: number = 0;
    maxShield: number = 0;
    damage: number;
    config: EnemyConfig;
    
    shootTimer = 0;
    dashTimer = 0;
    isDashing = false;
    healTimer = 0;
    specialTimer = 0;
    isStealthed = false;

    constructor(pos: Vector, typeId: string, level: number, public elite: boolean) {
      super(pos, 15, '#f00');
      this.config = ENEMIES[typeId] || ENEMIES['basic_weak'];
      
      const scale = 1 + (level * 0.1);
      this.hp = this.config.hp * scale * selectedDifficulty; // Difficulty Scaling
      this.maxHp = this.hp;
      this.damage = 10 * scale * selectedDifficulty; // Damage Scaling
      this.radius = this.config.radius;
      this.color = this.config.color;
      
      if (elite) {
        this.shield = this.maxHp; // Shield layer
        this.maxShield = this.maxHp;
        this.radius *= 1.2;
      }
    }

    update(dt: number) {
      if (!game.player.dead) {
        const dir = game.player.pos.sub(this.pos).normalize();
        let speed = this.config.speed;
        
        // Ranged Logic
        if (this.config.type === 'ranged') {
            const dist = game.player.pos.sub(this.pos).mag();
            if (dist < 300) speed = -50; // Kite
            else if (dist < 500) speed = 0; // Stand and shoot
            
            this.shootTimer -= dt;
            if (this.shootTimer <= 0 && dist < 600) {
                this.shootTimer = 2.0;
                // Actual projectile
                const shotDir = game.player.pos.sub(this.pos).normalize();
                game.projectiles.push(new Projectile(this.pos, shotDir.mult(300), this.damage, 'bullet', 'enemy'));
            }
        }
        
        // Charger Logic
        if (this.config.type === 'charger') {
            this.dashTimer -= dt;
            if (this.dashTimer <= 0) {
                this.isDashing = true;
                this.dashTimer = 3.0;
                speed = 600;
            }
            if (this.dashTimer > 2.5) speed = 600; // Dash for 0.5s
            else this.isDashing = false;
        }
        
        // Healer Logic
        if (this.config.type === 'healer') {
            this.healTimer -= dt;
            if (this.healTimer <= 0) {
                this.healTimer = 1.0;
                // Find injured friend
                const friend = game.enemies.find(e => e !== this && e.hp < e.maxHp && e.pos.sub(this.pos).mag() < 200);
                if (friend) {
                    friend.hp = Math.min(friend.maxHp, friend.hp + 20);
                    game.spawnParticles(friend.pos, '#0f0', 5);
                }
            }
        }
        
        // Exploder Logic
        if (this.config.type === 'exploder') {
            if (this.pos.sub(game.player.pos).mag() < this.radius + game.player.radius + 10) {
                 this.hp = 0; // Die
                 game.player.hp -= 30;
                 game.screenShake = 20;
                 game.spawnParticles(this.pos, '#ff8800', 20);
                 game.texts.push(new FloatingText(this.pos, "BOOM!", "#f00"));
            }
        }

        // Summoner Logic (Regular & Boss)
        if (this.config.type === 'summoner' || this.config.type === 'boss_summoner') {
            this.specialTimer -= dt;
            if (this.specialTimer <= 0) {
                this.specialTimer = this.config.type === 'boss_summoner' ? 3.0 : 6.0;
                const type = this.config.type === 'boss_summoner' ? 'basic_norm' : 'basic_weak';
                // Spawn minion nearby
                const offset = new Vector(Math.random()*60-30, Math.random()*60-30);
                const minion = new Enemy(this.pos.add(offset), type, game.director.wave, false);
                game.enemies.push(minion);
                game.spawnParticles(this.pos, '#a020f0', 10);
            }
        }

        // Stealth Logic
        if (this.config.type === 'stealth') {
            this.specialTimer -= dt;
            if (this.specialTimer <= 0) {
                this.isStealthed = !this.isStealthed;
                this.specialTimer = this.isStealthed ? 2.0 : 3.0; // 2s hidden, 3s visible
            }
        }

        // Boss Sniper Logic
        if (this.config.type === 'boss_sniper') {
            this.specialTimer -= dt;
            if (this.specialTimer <= 0) this.specialTimer = 4.0;
            
            // Shoot at specific timing (e.g. at 1.0s remaining)
            if (this.specialTimer <= 1.0 && this.specialTimer > 0.9) {
                 const shotDir = game.player.pos.sub(this.pos).normalize();
                 game.projectiles.push(new Projectile(this.pos, shotDir.mult(1200), this.damage * 3, 'laser', 'enemy'));
                 this.specialTimer = 0.9; // Prevent multi-shot
                 game.screenShake = 10;
            }
        }

        // Boss Tank Logic (Shield Regen)
        if (this.config.type === 'boss_tank') {
            this.specialTimer -= dt;
            if (this.specialTimer <= 0) {
                this.specialTimer = 10.0;
                this.shield = Math.min(this.maxShield, this.shield + this.maxShield * 0.3);
                game.texts.push(new FloatingText(this.pos, "SHIELD UP", "#00f"));
            }
        }

        // Boss Charger Logic (Fire Trail)
        if (this.config.type === 'boss_charger') {
            this.dashTimer -= dt;
            if (this.dashTimer <= 0) { this.isDashing = true; this.dashTimer = 2.5; speed = 700; }
            if (this.dashTimer > 2.0) { speed = 700; game.spawnParticles(this.pos, '#ff5500', 1); } // Trail
            else this.isDashing = false;
        }

        // Boss Hell Logic (Spiral)
        if (this.config.type === 'boss_hell') {
            this.specialTimer -= dt;
            if (this.specialTimer <= 0) {
                this.specialTimer = 0.15;
                const angle = performance.now() / 150;
                const vel1 = new Vector(Math.cos(angle), Math.sin(angle)).mult(300);
                const vel2 = new Vector(Math.cos(angle + Math.PI), Math.sin(angle + Math.PI)).mult(300);
                game.projectiles.push(new Projectile(this.pos, vel1, this.damage, 'bullet', 'enemy'));
                game.projectiles.push(new Projectile(this.pos, vel2, this.damage, 'bullet', 'enemy'));
            }
        }

        this.pos = this.pos.add(dir.mult(speed * dt));
      }
      
      // Separation (prevent stacking)
      game.enemies.forEach(other => {
        if (other === this) return;
        const dist = other.pos.sub(this.pos).mag();
        if (dist < this.radius + other.radius) {
          const push = this.pos.sub(other.pos).normalize().mult(50 * dt);
          this.pos = this.pos.add(push);
        }
      });
    }

    draw(ctx: CanvasRenderingContext2D) {
      ctx.save();
      ctx.translate(this.pos.x, this.pos.y);
      
      if (this.isStealthed) {
          ctx.globalAlpha = 0.2;
      }

      ctx.fillStyle = this.color;
      ctx.shadowBlur = 10; ctx.shadowColor = this.color;
      
      if (this.config.type === 'melee') {
        ctx.fillRect(-this.radius, -this.radius, this.radius*2, this.radius*2);
      } else if (this.config.type === 'charger') {
        ctx.beginPath(); ctx.moveTo(0, -this.radius); ctx.lineTo(this.radius, this.radius); ctx.lineTo(-this.radius, this.radius); ctx.fill();
      } else if (this.config.type === 'healer') {
        ctx.font = '20px Arial'; ctx.fillStyle='#fff'; ctx.fillText('+', -5, 5);
      } else if (this.config.type === 'exploder') {
        // Pulsing
        const s = 1 + Math.sin(performance.now()/100)*0.2;
        ctx.scale(s, s);
        ctx.beginPath(); ctx.arc(0, 0, this.radius, 0, Math.PI*2); ctx.fill();
      } else if (this.config.id.includes('boss')) {
        ctx.beginPath(); 
        const spikes = 8;
        for(let i=0; i<spikes*2; i++) {
            const r = i%2===0 ? this.radius : this.radius/2;
            const a = (Math.PI*2 * i) / (spikes*2) + performance.now()/500;
            ctx.lineTo(Math.cos(a)*r, Math.sin(a)*r);
        }
        ctx.fill();
      } else {
        ctx.beginPath(); ctx.arc(0, 0, this.radius, 0, Math.PI*2); ctx.fill();
      }

      // Boss Sniper Laser Warning
      if (this.config.type === 'boss_sniper' && this.specialTimer > 1.0 && this.specialTimer < 2.5) {
          ctx.restore(); ctx.save(); // Reset transform to draw line in world space
          ctx.beginPath();
          ctx.moveTo(this.pos.x, this.pos.y);
          ctx.lineTo(game.player.pos.x, game.player.pos.y);
          ctx.strokeStyle = `rgba(255, 0, 0, ${Math.random()})`;
          ctx.lineWidth = 1;
          ctx.stroke();
          ctx.translate(this.pos.x, this.pos.y); // Restore for bars
      }
      
      // HP Bar under enemy
      const hpPct = this.hp / this.maxHp;
      ctx.fillStyle = '#333'; ctx.fillRect(-20, 25, 40, 4);
      ctx.fillStyle = '#f00'; ctx.fillRect(-20, 25, 40 * hpPct, 4);
      
      // Shield Bar
      if (this.shield > 0) {
          const shPct = this.shield / this.maxShield;
          ctx.fillStyle = '#ffd700'; ctx.fillRect(-20, 21, 40 * shPct, 4);
      }
      
      ctx.restore();
    }
  }

  // --- PLAYER ---
  class Player extends Entity {
    vel: Vector = new Vector(0,0);
    hp: number;
    maxHp: number;
    xp: number = 0;
    maxXp: number = 100;
    level: number = 1;
    
    // Stats
    speed = 300;
    fireRate = 0.2;
    damage = 10;
    multishot = 1;
    regen = 0;
    knockback = 0;
    weapon: 'blaster' | 'shotgun' | 'laser' | 'rocket' | 'plasma' = 'blaster';
    
    // Tree Stats
    critChance = 0;
    critMult = 1.5;
    aoeRadius = 1.0;
    bossDmgMult = 1.0;
    lifesteal = 0;
    thorns = 0;
    thornsPct = 0;
    dodge = 0;
    xpMult = 1.0;
    extraLives = 0;
    ricochet = false;
    homing = false;
    lightning = false;
    execute = false;
    
    dashCooldownMax = 3.0;
    cooldownMult = 1.0;

    shootTimer = 0;
    
    // Ultimates
    dashCooldown = 0;
    nukeCooldown = 0;

    constructor() {
      super(new Vector(CANVAS_W/2, CANVAS_H/2), 20, '#0ff');
      // Apply Meta Upgrades
      this.maxHp = 100 + (meta.upgrades.startHp * 10);
      this.damage = 10 + (meta.upgrades.baseDmg * 2);
      this.speed = 300 + (meta.upgrades.moveSpeed * 10);
      this.fireRate = 0.2 * Math.pow(0.95, meta.upgrades.fireRate);
      this.knockback = meta.upgrades.knockback * 50;
      
      // Apply Tree Upgrades
      meta.skillTree.forEach(id => {
        const node = TREE_NODES.find(n => n.id === id);
        if (node) node.effect(this);
      });
      
      this.hp = this.maxHp;
      
      // Apply Equipment Stats (RPG)
      const equip = meta.equipment;
      [equip.weapon, equip.armor, equip.chip].forEach(item => {
          if (item && item.stats) {
              if (item.stats.hp) this.maxHp += item.stats.hp;
              if (item.stats.dmg) this.damage += item.stats.dmg;
              if (item.stats.spd) this.speed += item.stats.spd;
              if (item.stats.crit) this.critChance += item.stats.crit;
          }
      });
      this.hp = this.maxHp; // Heal to full with new max
    }

    update(dt: number) {
      // Movement
      let input = new Vector(0,0);
      // e.code is physical key. KeyW is W on QWERTY and Ц on JCUKEN.
      if (keys['KeyW'] || keys['ArrowUp']) input.y -= 1;
      if (keys['KeyS'] || keys['ArrowDown']) input.y += 1;
      if (keys['KeyA'] || keys['ArrowLeft']) input.x -= 1;
      if (keys['KeyD'] || keys['ArrowRight']) input.x += 1;
      
      if (input.mag() > 0) input = input.normalize();
      
      // Smooth acceleration
      this.vel = this.vel.add(input.mult(2000 * dt)); // Acceleration
      this.vel = this.vel.mult(0.90); // Friction
      
      this.pos = this.pos.add(this.vel.mult(dt));

      // Bounds
      this.pos.x = Math.max(20, Math.min(CANVAS_W - 20, this.pos.x));
      this.pos.y = Math.max(20, Math.min(CANVAS_H - 20, this.pos.y));

      // Dash Ultimate
      if (this.dashCooldown > 0) this.dashCooldown -= dt;
      if (keys['Space'] && this.dashCooldown <= 0 && meta.unlocks.includes('ult_dash')) {
          this.dashCooldown = this.dashCooldownMax * this.cooldownMult;
          const dashDir = this.vel.mag() > 0 ? this.vel.normalize() : new Vector(1,0);
          this.pos = this.pos.add(dashDir.mult(150));
          game.spawnParticles(this.pos, '#0ff', 10);
      }

      // Nuke Ultimate
      if (this.nukeCooldown > 0) this.nukeCooldown -= dt;
      if (keys['KeyF'] && this.nukeCooldown <= 0 && meta.unlocks.includes('ult_nuke')) {
          this.nukeCooldown = 60.0 * this.cooldownMult;
          game.triggerNuke();
      }
      
      // Regen
      if (this.regen > 0 && this.hp < this.maxHp) {
          this.hp += this.regen * dt;
      }

      // Shooting
      this.shootTimer -= dt;
      if (mouse.down && this.shootTimer <= 0) {
        this.shoot();
        this.shootTimer = this.fireRate;
      }
    }

    shoot() {
      const dir = mouse.pos.sub(this.pos).normalize();
      
      if (this.weapon === 'blaster') {
          for(let i=0; i<this.multishot; i++) {
            const angle = Math.atan2(dir.y, dir.x) + (i - (this.multishot-1)/2) * 0.1;
            const vel = new Vector(Math.cos(angle), Math.sin(angle)).mult(800);
            const p = new Projectile(this.pos, vel, this.damage);
            if (this.homing) p.homing = true;
            if (this.ricochet) p.bounces = 1;
            game.projectiles.push(p);
          }
      } else if (this.weapon === 'shotgun') {
          for(let i=0; i<this.multishot + 4; i++) {
            const angle = Math.atan2(dir.y, dir.x) + (Math.random()-0.5) * 0.5;
            const vel = new Vector(Math.cos(angle), Math.sin(angle)).mult(700 + Math.random()*200);
            const p = new Projectile(this.pos, vel, this.damage * 0.6);
            if (this.ricochet) p.bounces = 1;
            game.projectiles.push(p);
          }
      } else if (this.weapon === 'rocket') {
          const vel = dir.mult(500);
          const p = new Projectile(this.pos, vel, this.damage * 3 * this.aoeRadius, 'rocket');
          if (this.homing) p.homing = true;
          game.projectiles.push(p);
      } else if (this.weapon === 'laser') {
          // Laser is fast and pierces (handled in collision)
          for(let i=0; i<this.multishot; i++) {
             const angle = Math.atan2(dir.y, dir.x) + (i - (this.multishot-1)/2) * 0.05;
             const vel = new Vector(Math.cos(angle), Math.sin(angle)).mult(1500);
             game.projectiles.push(new Projectile(this.pos, vel, this.damage * 0.8, 'laser'));
          }
      } else if (this.weapon === 'plasma') {
          for(let i=0; i<this.multishot; i++) {
             const angle = Math.atan2(dir.y, dir.x) + (i - (this.multishot-1)/2) * 0.08 + (Math.random()-0.5)*0.1;
             const vel = new Vector(Math.cos(angle), Math.sin(angle)).mult(900);
             const p = new Projectile(this.pos, vel, this.damage * 0.7, 'bullet'); // Re-use bullet visual but purple
             p.color = '#a020f0';
             if (this.homing) p.homing = true;
             if (this.ricochet) p.bounces = 1;
             game.projectiles.push(p);
          }
      }
      
      // Recoil
      this.vel = this.vel.sub(dir.mult(100));
    }

    gainXp(amount: number) {
      this.xp += amount * this.xpMult;
      if (this.xp >= this.maxXp) {
        this.xp -= this.maxXp;
        this.level++;
        this.maxXp *= 1.2;
        game.triggerLevelUp();
      }
      game.updateHud();
    }

    draw(ctx: CanvasRenderingContext2D) {
      ctx.save();
      ctx.translate(this.pos.x, this.pos.y);
      
      // Rotate towards mouse
      const angle = Math.atan2(mouse.pos.y - this.pos.y, mouse.pos.x - this.pos.x);
      ctx.rotate(angle);

      ctx.fillStyle = '#000';
      ctx.strokeStyle = '#0ff';
      ctx.lineWidth = 3;
      ctx.shadowBlur = 15; ctx.shadowColor = '#0ff';
      
      // Triangle shape
      ctx.beginPath();
      ctx.moveTo(20, 0);
      ctx.lineTo(-15, 15);
      ctx.lineTo(-15, -15);
      ctx.closePath();
      ctx.fill();
      ctx.stroke();

      ctx.restore();
    }
  }

  // --- OBSERVER ---
  // --- DIRECTOR (OBSERVER) SYSTEM ---
  class Director {
    wave = 1;
    
    // Resource System
    currentInfluence = 0;
    baseWaveInfluence = 100; // Starting budget
    
    // Mood System
    mood: 'kind' | 'neutral' | 'angry' | 'insane' = 'neutral';
    moodTimer = 0;
    moodResetTimer = 0; // Timer to reset mood back to kind
    
    // State
    nextWaveTimer = 0;
    bossSpawnedThisWave = false;
    raidBossActive = false;
    chatTimer = 0;
    holidayTimer = 0;
    holidayPickups = 0;
    spawnTickTimer = 0;
    
    recentKills: number[] = []; // Timestamps of kills
    
    constructor(private game: Game) {}

    startWave() {
      // "Receives 20% more influence" (scaling base)
      if (this.wave > 1) {
          this.baseWaveInfluence = Math.floor(this.baseWaveInfluence * 1.2);
      } else {
          this.baseWaveInfluence = 100; // Reset for wave 1
      }
      
      // Refill
      this.currentInfluence += this.baseWaveInfluence;
      this.bossSpawnedThisWave = false;
      
      // Boss Wave Check (Every 5th wave) - Free Spawn
      if (this.wave % 5 === 0) {
          const bossId = `boss${Math.min(5, Math.ceil(this.wave/5))}`;
          this.game.spawnEnemy(bossId, false);
          this.bossSpawnedThisWave = true;
      }
      
      this.game.texts.push(new FloatingText(new Vector(CANVAS_W/2, CANVAS_H/2), `ВОЛНА ${this.wave}`, "#fff"));
      this.updateUI();
    }

    reportKill() {
        this.recentKills.push(Date.now());
    }

    startRaid() {
        this.wave = this.game.activeRaid ? this.game.activeRaid.minLevel : 666; // Use raid level for scaling
        this.currentInfluence = 1000 + (this.wave * 5); // High budget for raid minions
        this.raidBossActive = true;
        
        // Spawn Boss
        if (this.game.activeRaid) {
            this.game.spawnEnemy(this.game.activeRaid.bossId, false);
            this.game.texts.push(new FloatingText(new Vector(CANVAS_W/2, CANVAS_H/2), "ЦЕЛЬ ОБНАРУЖЕНА", "#f00"));
        }
        this.updateUI();
    }

    update(dt: number) {
      // Fake Chat Simulation
      this.chatTimer += dt;
      if (this.chatTimer > 0.5 + Math.random() * 5.5) {
          this.game.addChatMessage();
          this.chatTimer = 0;
      }

      // Raid Logic
      if (this.game.mode === 'raid') {
          this.processSpawning(dt); // Spawn minions to annoy player
          return; // Skip wave cycling and mood logic for raids
      }

      // 1. Mood Logic (Dynamic based on kills)
      const now = Date.now();
      // Keep kills within 0.3s window
      // Optimization: Remove old kills without creating new array
      while (this.recentKills.length > 0 && now - this.recentKills[0] >= 300) {
          this.recentKills.shift();
      }
      const burstCount = this.recentKills.length;

      // Determine target mood based on burst
      if (burstCount >= 5) {
          this.setMood('insane', 5.0); // Stay insane for 5s
      } else if (burstCount >= 3) {
          this.setMood('angry', 4.0);
      } else if (burstCount >= 2) {
          this.setMood('neutral', 3.0);
      }

      // Mood Decay
      if (this.moodResetTimer > 0) {
          this.moodResetTimer -= dt;
          if (this.moodResetTimer <= 0) {
              this.mood = 'kind'; // Default fallback
              this.updateUI();
          }
      }

      // Resource Gain (Every 5s)
      this.moodTimer += dt;
      if (this.moodTimer >= 5) {
        this.distributeInfluence();
        this.moodTimer = 0;
      }

      // 2. Spawning Logic (Spend Influence)
      if (this.currentInfluence > 0) {
          this.processSpawning(dt);
      }

      // 3. Wave Cycling Logic
      // "Ran out of energy? ... begins next wave"
      if (this.currentInfluence < 10 && this.game.enemies.length === 0) { // Wait for clear
          this.nextWaveTimer += dt;
          if (this.nextWaveTimer > 2.0) { // 2 seconds delay between waves
              this.wave++;
              this.nextWaveTimer = 0;
              this.startWave();
          }
      } else {
          this.nextWaveTimer = 0;
      }
    }
    
    setMood(newMood: 'kind' | 'neutral' | 'angry' | 'insane', duration: number) {
      const tiers = { kind: 0, neutral: 1, angry: 2, insane: 3 };
      // Only upgrade mood or refresh timer if same tier
      if (tiers[newMood] >= tiers[this.mood]) {
          this.mood = newMood;
          this.moodResetTimer = duration;
          this.updateUI();
      }
    }
    
    distributeInfluence() {
      // "Mood gives/takes influence % of points received in this wave"
      // This runs every 5 seconds
      
      const tiers = { kind: 0, neutral: 1, angry: 2, insane: 3 };
      
      // "Mood gives/takes influence % of points received in this wave"
      let moodMult = 0;
      if (this.mood === 'kind') moodMult = -0.05;    // Lose 5%
      if (this.mood === 'neutral') moodMult = 0;
      if (this.mood === 'angry') moodMult = 0.80;    // Gain 80%
      if (this.mood === 'insane') moodMult = 1.50;   // Gain 150%
      
      const moodBonus = Math.floor(this.baseWaveInfluence * moodMult);
      this.currentInfluence += moodBonus;
      if (this.currentInfluence < 0) this.currentInfluence = 0; // Prevent negative influence
      
      if (moodBonus !== 0) {
         const color = moodBonus > 0 ? "#f00" : "#0f0";
         this.game.texts.push(new FloatingText(new Vector(CANVAS_W/2, 120), `MOOD: ${moodBonus}`, color));
      }
      
      this.updateUI();
    }
    
    processSpawning(dt: number) {
        // Filter available enemies
        if (this.game.mode === 'raid' && this.currentInfluence < 10) {
            this.currentInfluence += 5 * dt; // Slow recharge in raid
            return;
        }

        this.spawnTickTimer += dt;
        if (this.spawnTickTimer < 0.5) return; // Tick every 0.5s
        this.spawnTickTimer = 0;

        // Determine batch size (1-10) based on mood
        let maxBatch = 3;
        if (this.mood === 'angry') maxBatch = 6;
        if (this.mood === 'insane') maxBatch = 10;
        
        // Chance for a "Surge" (Dump) - small chance to spawn more
        if (Math.random() < 0.05 && this.currentInfluence > 500) {
             maxBatch = 15;
             this.game.texts.push(new FloatingText(new Vector(CANVAS_W/2, 150), "SURGE DETECTED", "#f00"));
        }

        const count = Math.floor(Math.random() * maxBatch) + 1;

        for(let i=0; i<count; i++) {
             if (this.currentInfluence <= 10) break; // Keep a small buffer or break if empty

             const available = Object.values(ENEMIES).filter(e => {
                // Boss logic: allow after wave 10 with low chance
                if (e.id.includes('boss')) {
                    if (this.wave <= 10) return false;
                    if (Math.random() > 0.02) return false; // 2% chance to consider boss
                    // Limit active bosses
                    if (this.game.enemies.some(ex => ex.config.id.includes('boss'))) return false;
                }
                
                if (e.unlockReq && !meta.unlocks.includes(e.unlockReq)) return false;
                return e.cost <= this.currentInfluence;
            });

            if (available.length === 0) {
                // If we have influence but can't afford anything (and influence is low-ish), 
                // dump it to 0 to trigger next wave.
                if (this.currentInfluence < 50) this.currentInfluence = 0;
                break;
            }

            // Pick random
            const enemy = available[Math.floor(Math.random() * available.length)];
            this.payAndSpawn(enemy);
        }
    }
    
    spawnRandom(available: EnemyConfig[]) {
        const enemy = available[Math.floor(Math.random() * available.length)];
        this.payAndSpawn(enemy);
    }
    
    payAndSpawn(config: EnemyConfig) {
        let cost = config.cost;
        let elite = false;
        
        // Elite chance
        if (Math.random() < 0.1 && this.currentInfluence > cost * 2) {
            elite = true;
            cost *= 2;
        }
        
        this.currentInfluence -= cost;
        this.game.spawnEnemy(config.id, elite);
        this.updateUI();
    }

    updateUI() {
      const faceEl = document.getElementById('obs-face');
      const moodEl = document.getElementById('obs-mood');
      if (!faceEl || !moodEl) return;
      
      const config = {
        kind: { face: '😇', text: 'ДОБРЫЙ', color: '#0f0' },
        neutral: { face: '😐', text: 'НЕЙТРАЛЬНЫЙ', color: '#fff' },
        angry: { face: '😠', text: 'ЗЛОЙ', color: '#ff8800' },
        insane: { face: '👿', text: 'БЕЗУМНЫЙ', color: '#f00' }
      };
      
      const c = config[this.mood];
      faceEl.innerText = c.face;
      moodEl.innerText = c.text;
      moodEl.style.color = c.color;
      document.getElementById('obs-influence')!.innerText = `ВЛИЯНИЕ: ${Math.floor(this.currentInfluence)}`;
    }
  }

  // --- LEADERBOARD SYSTEM ---
  async function fetchLeaderboard() {
      try {
          const res = await fetch('/api/scores_nl');
          const data = await res.json();
          
          renderLbList('lb-daily', data.daily);
          renderLbList('lb-weekly', data.weekly);
      } catch (e) {
          console.error("Failed to fetch leaderboard", e);
      }
  }

  function renderLbList(id: string, list: any[]) {
      const el = document.getElementById(id);
      if (!el) return;
      if (!list || list.length === 0) {
          el.innerHTML = '<div class="text-center text-gray-500">Нет записей</div>';
          return;
      }
      el.innerHTML = list.map((item, i) => `
          <div class="lb-item ${item.name === meta.username ? 'me' : ''}">
              <span class="rank">#${i+1}</span>
              <span class="name">${item.name}</span>
              <span class="score">${item.score}</span>
          </div>
      `).join('');
  }

  async function checkAndSubmitScore(score: number) {
      try {
          const res = await fetch('/api/scores_nl');
          const data = await res.json();
          
          const dailyMin = data.daily.length < 5 ? 0 : data.daily[data.daily.length-1].score;
          const weeklyMin = data.weekly.length < 5 ? 0 : data.weekly[data.weekly.length-1].score;
          
          if (score > dailyMin || score > weeklyMin) {
              // Show Input
              const inputDiv = document.getElementById('highscore-input');
              if (inputDiv) inputDiv.classList.remove('hidden');
          }
      } catch (e) {
          console.error("Check score failed", e);
      }
  }

  async function postScore(name: string, score: number) {
      await fetch('/api/scores_nl', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, score })
      });
  }

  // --- MAIN GAME CLASS ---
  class Game {
    canvas: HTMLCanvasElement;
    ctx: CanvasRenderingContext2D;
    
    player: Player;
    enemies: Enemy[] = [];
    projectiles: Projectile[] = [];
    particles: Particle[] = [];
    texts: FloatingText[] = [];
    
    state: 'MENU' | 'PLAYING' | 'GAMEOVER' | 'TREE' = 'MENU';
    mode: 'endless' | 'raid' = 'endless';
    score = 0;
    currencyCollected = 0;
    coresCollected = 0;
    
    lootFound: Item[] = [];
    screenShake = 0;
    treeRenderer: SkillTreeRenderer | null = null;
    director: Director;
    
    // In-Game Upgrade State
    pendingUpgrades = 0;
    activeUpgradeChoices: any[] = [];
    activeRaid: RaidMission | null = null;
    lastMode: 'endless' | 'raid' = 'endless';
    lastRaidId?: string;
    
    private boundMouseMove: (e: MouseEvent) => void;
    private boundMouseDown: (e: MouseEvent) => void;

    constructor() {
      gameInstance = this; // Set singleton
      game = this;
      this.canvas = document.getElementById('game-canvas') as HTMLCanvasElement;
      this.ctx = this.canvas.getContext('2d')!;
      this.director = new Director(this);
      this.player = new Player(); // Temp init
      
      // Bind handlers for cleanup
      this.boundMouseMove = this.handleMouseMove.bind(this);
      this.boundMouseDown = () => { mouse.down = true; };
      
      this.setupInputs();
      
      // Start Loop
      lastTime = performance.now();
      this.startLoop();
    }

    start(mode: 'endless' | 'raid' = 'endless', raidId?: string) {
      this.mode = mode;
      this.lastMode = mode;
      this.lastRaidId = raidId;
      this.player = new Player();
      this.enemies = [];
      this.projectiles = [];
      this.particles = [];
      this.texts = [];
      this.score = 0;
      this.currencyCollected = 0;
      this.coresCollected = 0;
      this.lootFound = [];
      this.pendingUpgrades = 0;
      this.activeUpgradeChoices = [];
      this.state = 'PLAYING';
      
      if (mode === 'raid' && raidId) {
          this.activeRaid = RAIDS.find(r => r.id === raidId) || null;
      } else {
          this.activeRaid = null;
      }
      
      this.director = new Director(this);
      
      if (mode === 'raid') this.director.startRaid();
      else this.director.startWave();
      
      this.setScreen('hud-screen');
      document.getElementById('observer-ui')?.classList.remove('hidden');
      this.updateHud();
      this.addChatMessage("System", "Welcome to Server NEON_01. PvP is disabled.", "system");
      this.updateUpgradeUI();
    }

    update(dt: number) {
      if (this.state !== 'PLAYING') return;

      this.director.update(dt);

      this.player.update(dt);
      
      // Update Entities
      this.projectiles.forEach(p => {
          // Homing Logic
          if (p.homing && p.team === 'player') {
              let target = null;
              let minD = 400;
              for(const e of this.enemies) {
                  if (e.dead) continue;
                  const d = e.pos.sub(p.pos).mag();
                  if (d < minD) { minD = d; target = e; }
              }
              if (target) {
                  const desired = target.pos.sub(p.pos).normalize();
                  const current = p.vel.normalize();
                  const steer = desired.sub(current).mult(5 * dt);
                  p.vel = current.add(steer).normalize().mult(p.vel.mag());
              }
          }
          p.update(dt);
      });
      
      this.enemies.forEach(e => e.update(dt));
      this.particles.forEach(p => p.update(dt));
      this.texts.forEach(t => t.update(dt));

      // XP Pickup
      this.particles.forEach(p => {
          if (!p.dead && (p.type === 'xp' || p.type === 'core' || p.type.startsWith('fake') || p.type === 'loot')) {
              if (p.pos.sub(this.player.pos).mag() < 30) {
                  p.dead = true;
                  if (p.type === 'xp') {
                    this.player.gainXp(10);
                    this.score += 10 * selectedDifficulty;
                    this.currencyCollected += 1 * selectedDifficulty;
                  } else if (p.type === 'core') {
                    this.coresCollected += 1 * selectedDifficulty;
                    this.texts.push(new FloatingText(this.player.pos, "+1 ЯДРО", "#ffd700"));
                  } else if (p.type === 'loot') {
                    const item = this.generateLoot();
                    this.lootFound.push(item);
                    this.texts.push(new FloatingText(this.player.pos, `ЛУТ: ${item.name}`, "#0ff"));
                    this.addChatMessage("System", `Получено: [${item.name}] (${item.desc})`, "system");
                  } else if (p.type.startsWith('fake')) {
                    // Holiday Trap
                    this.director.holidayPickups++;
                    if (this.director.holidayPickups > 2) {
                        this.gameOver("НИКАКОГО ПРАЗДНИКА!!!");
                    } else {
                        const msgs = ["ВКУСНО?", "ЕЩЕ?", "МАЛО?"];
                        this.texts.push(new FloatingText(this.player.pos, msgs[Math.floor(Math.random()*msgs.length)], "#ff00ff"));
                    }
                  }
              }
          }
      });

      // Collisions: Projectile vs Enemy
      for (let i = this.projectiles.length - 1; i >= 0; i--) {
        const p = this.projectiles[i];
        let hit = false;
        for (const e of this.enemies) {
          // Player bullets hit enemies
          if (p.team !== 'player') continue;
          
          if (p.pos.sub(e.pos).mag() < e.radius + p.radius) {
            // Crit logic
            let dmg = p.dmg;
            if (e.config.id.includes('boss')) dmg *= this.player.bossDmgMult;
            
            let isCrit = Math.random() < this.player.critChance;
            if (isCrit) dmg *= this.player.critMult;
            
            // Shield Logic
            if (e.shield > 0) {
                e.shield -= dmg;
                if (e.shield < 0) {
                    e.hp += e.shield; // Overflow to HP
                    e.shield = 0;
                }
            } else {
                e.hp -= dmg;
            }
            
            // Rocket AoE
            if (p.type === 'rocket') {
                this.spawnParticles(p.pos, '#ff5500', 10 * this.player.aoeRadius);
                this.enemies.forEach(subE => {
                    if (subE.pos.sub(p.pos).mag() < 100 * this.player.aoeRadius) {
                        subE.hp -= dmg * 0.5;
                    }
                });
                this.screenShake = 10;
            }
            
            // Lifesteal
            if (this.player.lifesteal > 0) {
                const heal = dmg * this.player.lifesteal;
                this.player.hp = Math.min(this.player.maxHp, this.player.hp + heal);
            }
            
            // Execute
            if (this.player.execute && !e.config.id.includes('boss') && e.hp < e.maxHp * 0.2) {
                dmg = e.hp + 100; // Kill
                this.texts.push(new FloatingText(e.pos, "EXECUTE", "#f00"));
            }
            
            // Lightning
            if (this.player.lightning && Math.random() < 0.3) {
                let count = 0;
                this.enemies.forEach(other => {
                    if (other !== e && !other.dead && count < 3 && other.pos.sub(e.pos).mag() < 200) {
                        other.hp -= dmg * 0.5;
                        this.spawnParticles(other.pos, '#0ff', 2); // Zap visual
                        count++;
                    }
                });
            }
            
            this.texts.push(new FloatingText(e.pos, Math.floor(dmg).toString(), isCrit ? '#ff0' : '#fff'));
            hit = true;
            this.spawnParticles(e.pos, e.color, 3);
            if (e.hp <= 0) {
              e.dead = true;
              // Spawn XP
              this.director.reportKill(); // Report kill for mood logic
              const dropCount = e.config.id.includes('boss') ? 50 : (e.elite ? 5 : 1);
              this.spawnParticles(e.pos, '#0f0', dropCount, 'xp');
              // Boss Drop
              if (e.config.id.includes('boss')) {
                this.spawnParticles(e.pos, '#ffd700', 1, 'core');
                this.screenShake = 20;
                // Boss Loot Drop
                this.spawnParticles(e.pos, '#fff', 1, 'loot');
                this.addChatMessage("Global", `Игрок ${meta.username} уничтожил ${e.config.id}!`, "system");
                
                // Raid Victory Condition
                if (this.mode === 'raid' && this.activeRaid && e.config.id === this.activeRaid.bossId) {
                    setTimeout(() => this.victory(), 2000);
                }
              } else if (e.elite && Math.random() < 0.3) {
                this.spawnParticles(e.pos, '#fff', 1, 'loot');
              }
              this.screenShake = 5;
            }
            
            // Ricochet Logic
            if (this.player.ricochet && p.bounces > 0) {
                p.bounces--;
                // Find nearest other enemy
                let target = null;
                let minD = 500;
                for(const other of this.enemies) {
                    if (other === e || other.dead) continue;
                    const d = other.pos.sub(p.pos).mag();
                    if (d < minD) { minD = d; target = other; }
                }
                if (target) {
                    p.vel = target.pos.sub(p.pos).normalize().mult(p.vel.mag());
                    // Don't kill projectile
                    hit = false; // Hack to keep it alive in loop logic if we were removing it
                    // But we need to ensure it doesn't hit 'e' again immediately. 
                    // Simple fix: move it slightly towards new target
                    p.pos = p.pos.add(p.vel.normalize().mult(e.radius + 5));
                } else {
                    p.dead = true;
                }
            } else {
                p.dead = true;
            }
            
            break;
          }
        }
      }

      // Collisions: Enemy Projectiles vs Player
      this.projectiles.forEach(p => {
          if (p.team === 'enemy' && !this.player.dead) {
              if (p.pos.sub(this.player.pos).mag() < this.player.radius + p.radius) {
                  this.player.hp -= p.dmg;
                  p.dead = true;
                  this.screenShake = 5;
                  if (this.player.hp <= 0) {
                      this.gameOver();
                  }
                  this.updateHud();
              }
          }
      });

      // Collisions: Enemy vs Player
      if (!this.player.dead) {
        for (const e of this.enemies) {
          if (e.pos.sub(this.player.pos).mag() < e.radius + this.player.radius) {
            // Dodge
            if (Math.random() < this.player.dodge) {
                this.texts.push(new FloatingText(this.player.pos, "DODGE", "#0ff"));
                continue;
            }
          
            this.player.hp -= 10; // Flat dmg
            this.screenShake = 15;
            this.spawnParticles(this.player.pos, '#fff', 10);
            
            // Push back
            const pushDir = this.player.pos.sub(e.pos).normalize();
            this.player.vel = this.player.vel.add(pushDir.mult(300));
            
            // Thorns
            if (this.player.thorns > 0 || this.player.thornsPct > 0) {
                const thornDmg = this.player.thorns + (10 * this.player.thornsPct);
                e.hp -= thornDmg;
                this.texts.push(new FloatingText(e.pos, `-${Math.floor(thornDmg)}`, "#888"));
            }
            
            // Knockback Enemy (if no shield)
            if (e.shield <= 0) {
                e.pos = e.pos.sub(pushDir.mult(this.player.knockback + 10));
            }
            
            // Vampire Heal
            if (e.config.type === 'vampire') {
                e.hp = Math.min(e.maxHp, e.hp + 10);
                this.texts.push(new FloatingText(e.pos, "+HP", "#f0f"));
            }

            if (this.player.hp <= 0) {
              this.gameOver();
            }
            this.updateHud();
          }
        }
      }

      // Cleanup
      // Optimization: Use reverse loop splice instead of filter to reduce GC
      for (let i = this.projectiles.length - 1; i >= 0; i--) {
          if (this.projectiles[i].dead) this.projectiles.splice(i, 1);
      }
      for (let i = this.enemies.length - 1; i >= 0; i--) {
          if (this.enemies[i].dead) this.enemies.splice(i, 1);
      }
      for (let i = this.particles.length - 1; i >= 0; i--) {
          if (this.particles[i].dead) this.particles.splice(i, 1);
      }
      for (let i = this.texts.length - 1; i >= 0; i--) {
          if (this.texts[i].life <= 0) this.texts.splice(i, 1);
      }

      // Shake decay
      if (this.screenShake > 0) this.screenShake -= dt * 30;
      if (this.screenShake < 0) this.screenShake = 0;
    }

    draw() {
      if (this.state === 'TREE') return; // Canvas handled by TreeRenderer

      // Clear
      this.ctx.fillStyle = '#050505';
      this.ctx.fillRect(0, 0, CANVAS_W, CANVAS_H);

      // Grid Background
      this.ctx.strokeStyle = '#1a1a1a';
      this.ctx.lineWidth = 2;
      this.ctx.beginPath();
      for(let x=0; x<CANVAS_W; x+=100) { this.ctx.moveTo(x,0); this.ctx.lineTo(x,CANVAS_H); }
      for(let y=0; y<CANVAS_H; y+=100) { this.ctx.moveTo(0,y); this.ctx.lineTo(CANVAS_W,y); }
      this.ctx.stroke();

      this.ctx.save();
      
      // Screen Shake
      if (this.screenShake > 0) {
        const dx = (Math.random() - 0.5) * this.screenShake;
        const dy = (Math.random() - 0.5) * this.screenShake;
        this.ctx.translate(dx, dy);
      }

      this.particles.forEach(p => p.draw(this.ctx));
      this.projectiles.forEach(p => p.draw(this.ctx));
      this.enemies.forEach(e => e.draw(this.ctx));
      this.texts.forEach(t => t.draw(this.ctx));
      if (!this.player.dead && this.state === 'PLAYING') this.player.draw(this.ctx);

      this.ctx.restore();

      // Chromatic Aberration on heavy shake
      if (this.screenShake > 10) {
        // const imageData = this.ctx.getImageData(0,0,CANVAS_W,CANVAS_H);
        // Heavy operation, do sparingly or optimize (skipped for performance in this snippet)
        // Instead, draw a red overlay
        this.ctx.fillStyle = 'rgba(255,0,0,0.1)';
        this.ctx.fillRect(0,0,CANVAS_W,CANVAS_H);
      }
    }

    // --- RPG SYSTEMS ---
    generateLoot(): Item {
        const type = ITEM_TYPES[Math.floor(Math.random() * ITEM_TYPES.length)] as any;
        const rarityRoll = Math.random();
        let rarity: any = 'common';
        if (rarityRoll > 0.95) rarity = 'legendary';
        else if (rarityRoll > 0.8) rarity = 'epic';
        else if (rarityRoll > 0.6) rarity = 'rare';
        
        const icons = { weapon: '⚔️', armor: '🛡️', chip: '💾' };
        const names = { weapon: ['Rifle', 'Repeater', 'Cannon'], armor: ['Plate', 'Shield', 'Suit'], chip: ['CPU', 'RAM', 'Drive'] };
        const suffixes = { common: 'v1', rare: 'Pro', epic: 'Elite', legendary: 'GOD' };
        
        const name = `${names[type][Math.floor(Math.random()*3)]} ${suffixes[rarity]}`;
        
        const mult = { common: 1, rare: 2, epic: 4, legendary: 8 };
        const m = mult[rarity];
        
        let desc = "";
        const stats: any = {};
        if (type === 'weapon') { 
            stats.dmg = Math.floor(Math.random() * 5 * m) + 1; 
            stats.crit = Math.random() * 0.05 * m; 
            desc = `Урон +${stats.dmg}` + (stats.crit > 0 ? `, Крит +${(stats.crit*100).toFixed(0)}%` : '');
        }
        if (type === 'armor') { 
            stats.hp = Math.floor(Math.random() * 20 * m) + 10; 
            stats.spd = Math.floor(Math.random() * 10 * m); 
            desc = `HP +${stats.hp}` + (stats.spd > 0 ? `, Скор +${stats.spd}` : '');
        }
        if (type === 'chip') { 
            stats.spd = Math.floor(Math.random() * 20 * m); 
            stats.crit = Math.random() * 0.05 * m; 
            desc = `Скор +${stats.spd}` + (stats.crit > 0 ? `, Крит +${(stats.crit*100).toFixed(0)}%` : '');
        }
        
        return { id: Math.random().toString(36).substr(2,9), name, desc, type, rarity, stats, icon: icons[type] };
    }

    addChatMessage(name?: string, msg?: string, type: 'user'|'system' = 'user') {
        if (!name) name = CHAT_USERNAMES[Math.floor(Math.random() * CHAT_USERNAMES.length)];
        if (!msg) msg = CHAT_PHRASES[Math.floor(Math.random() * CHAT_PHRASES.length)];
        
        const log = document.getElementById('chat-log');
        if (log) {
            const line = document.createElement('div');
            line.className = `chat-msg ${type}`;
            line.innerHTML = type === 'system' ? `[SYSTEM]: ${msg}` : `<span class="name">[${name}]:</span> ${msg}`;
            log.appendChild(line);
            // Оставляем только 5 последних сообщений
            while (log.children.length > 5) {
                log.removeChild(log.firstChild!);
            }
        }
    }

    spawnEnemy(typeId: string, elite: boolean) {
      // Random edge position
      let pos = new Vector(0,0);
      if (Math.random() > 0.5) {
        pos.x = Math.random() > 0.5 ? -50 : CANVAS_W + 50;
        pos.y = Math.random() * CANVAS_H;
      } else {
        pos.x = Math.random() * CANVAS_W;
        pos.y = Math.random() > 0.5 ? -50 : CANVAS_H + 50;
      }
      
      const enemy = new Enemy(pos, typeId, this.director.wave, elite);
      
      if (typeId.includes('boss')) {
         this.texts.push(new FloatingText(new Vector(CANVAS_W/2, 200), "ВНИМАНИЕ: БОСС", "#f00"));
         this.screenShake = 30;
      }

      this.enemies.push(enemy);
    }

    triggerNuke() {
        this.screenShake = 50;
        this.enemies.forEach(e => {
            e.hp = 0;
            this.spawnParticles(e.pos, '#fff', 5);
        });
    }

    spawnHolidayItem() {
        const types = ['fake_hp', 'fake_shield', 'fake_xp'];
        const type = types[Math.floor(Math.random() * types.length)] as any;
        const offset = new Vector((Math.random()-0.5)*300, (Math.random()-0.5)*300);
        this.particles.push(new Particle(this.player.pos.add(offset), new Vector(0,0), '#fff', 10, type));
    }

    spawnParticles(pos: Vector, color: string, count: number, type: 'vfx' | 'xp' | 'core' | 'loot' = 'vfx') {
      for(let i=0; i<count; i++) {
        const angle = Math.random() * Math.PI * 2;
        const speed = Math.random() * 200 + 50;
        const vel = new Vector(Math.cos(angle), Math.sin(angle)).mult(speed);
        this.particles.push(new Particle(pos, vel, color, type === 'xp' ? 6 : Math.random() * 3 + 1, type));
      }
    }

    triggerLevelUp() {
      this.pendingUpgrades++;
      this.texts.push(new FloatingText(this.player.pos, "НОВЫЙ УРОВЕНЬ!", "#ffd700"));
      
      if (this.activeUpgradeChoices.length === 0) {
          this.generateUpgradeChoices();
      }
      this.updateUpgradeUI();
    }
    
    generateUpgradeChoices() {
      const container = document.getElementById('ingame-cards');
      if (!container) return;
      container.innerHTML = '';
      this.activeUpgradeChoices = [];

      const upgrades: { id: string; name: string; desc: string; icon: string; action: () => void }[] = [
        { id: 'dmg', name: 'УСИЛЕНИЕ УРОНА', desc: '+5 Урона', icon: '⚔️', action: () => this.player.damage += 5 },
        { id: 'spd', name: 'ЛОВКОСТЬ', desc: '+10% Скорости', icon: '⚡', action: () => this.player.speed *= 1.1 },
        { id: 'hp', name: 'РЕМОНТ', desc: 'Лечение 50 HP', icon: '♥', action: () => this.player.hp = Math.min(this.player.maxHp, this.player.hp + 50) },
        { id: 'multi', name: 'МУЛЬТИВЫСТРЕЛ', desc: '+1 Снаряд', icon: '💥', action: () => this.player.multishot += 1 },
        { id: 'rate', name: 'СКОРОСТРЕЛЬНОСТЬ', desc: '+15% Скорости стрельбы', icon: '🔫', action: () => this.player.fireRate *= 0.85 }
      ];
      
      // Add Weapon Upgrades if unlocked
      if (meta.unlocks.includes('w_shotgun')) upgrades.push({ id: 'w_shot', name: 'ДРОБОВИК', desc: 'Сменить оружие', icon: '🧨', action: () => { this.player.weapon = 'shotgun'; this.player.fireRate = 0.8; } });
      if (meta.unlocks.includes('w_rocket')) upgrades.push({ id: 'w_rock', name: 'РАКЕТНИЦА', desc: 'Сменить оружие', icon: '🚀', action: () => { this.player.weapon = 'rocket'; this.player.fireRate = 1.0; } });
      if (meta.unlocks.includes('w_laser')) upgrades.push({ id: 'w_las', name: 'ЛАЗЕР', desc: 'Сменить оружие', icon: '🔦', action: () => { this.player.weapon = 'laser'; this.player.fireRate = 0.4; } });
      if (meta.unlocks.includes('w_plasma')) upgrades.push({ id: 'w_plas', name: 'ПЛАЗМА', desc: 'Сменить оружие', icon: '🟣', action: () => { this.player.weapon = 'plasma'; this.player.fireRate = 0.15; } });

      // Pick 3 random
      for(let i=0; i<3; i++) {
        const u = upgrades[Math.floor(Math.random() * upgrades.length)];
        this.activeUpgradeChoices.push(u);
        
        const card = document.createElement('div');
        card.className = 'mini-card';
        card.innerHTML = `<div class="icon">${u.icon}</div><div class="name">${u.name}</div><div class="desc">${u.desc}</div>`;
        card.onclick = () => {
          u.action();
          this.pendingUpgrades--;
          this.activeUpgradeChoices = []; // Clear current
          if (this.pendingUpgrades > 0) {
              this.generateUpgradeChoices();
          }
          this.updateUpgradeUI();
        };
        container.appendChild(card);
      }
    }
    
    updateUpgradeUI() {
        const ui = document.getElementById('ingame-upgrades');
        const countEl = document.getElementById('pending-count');
        if (!ui || !countEl) return;
        
        if (this.pendingUpgrades > 0 || this.activeUpgradeChoices.length > 0) {
            ui.classList.remove('hidden');
            countEl.innerText = this.pendingUpgrades > 1 ? `(+${this.pendingUpgrades-1})` : '';
        } else {
            ui.classList.add('hidden');
        }
    }

    gameOver(reason?: string) {
      // Extra Lives
      if (this.player.extraLives > 0) {
          this.player.extraLives--;
          this.player.hp = this.player.maxHp;
          this.texts.push(new FloatingText(this.player.pos, "REVIVED!", "#fff"));
          this.triggerNuke(); // Clear screen on revive
          return;
      }
    
      this.state = 'GAMEOVER';
      this.player.dead = true;
      
      // Release controls
      for(const k in keys) delete keys[k];
      mouse.down = false;
      
      // Hide previous input if any
      const inputDiv = document.getElementById('highscore-input');
      if (inputDiv) inputDiv.classList.add('hidden');
      
      if (reason) {
          const h1 = document.querySelector('#gameover-screen h1');
          if (h1) h1.innerHTML = reason;
      } else {
          const h1 = document.querySelector('#gameover-screen h1');
          if (h1) h1.innerHTML = "КРИТИЧЕСКИЙ СБОЙ";
      }
      
      // Save Meta
      meta.currency += this.currencyCollected;
      meta.bossCurrency += this.coresCollected;
      // Save Loot
      if (this.lootFound.length > 0) {
          meta.inventory.push(...this.lootFound);
          this.texts.push(new FloatingText(this.player.pos, `SAVED ${this.lootFound.length} ITEMS`, "#fff"));
      }
      if (this.score > meta.bestScore) meta.bestScore = this.score;
      saveMeta();

      // Submit to Global Leaderboard
      checkAndSubmitScore(this.score);

      document.getElementById('go-score')!.innerText = this.score.toString();
      document.getElementById('go-currency')!.innerText = this.currencyCollected.toString();
      document.getElementById('go-cores')!.innerText = this.coresCollected.toString();
      this.setScreen('gameover-screen');
    }

    victory() {
        this.state = 'GAMEOVER'; // Stop updates
        
        // Save Loot collected during run
        if (this.lootFound.length > 0) {
            meta.inventory.push(...this.lootFound);
            this.texts.push(new FloatingText(this.player.pos, `SAVED ${this.lootFound.length} ITEMS`, "#fff"));
        }

        let rewardText = "";
        if (this.activeRaid) {
            const r = this.activeRaid.reward;
            if (r.type === 'currency') {
                meta.currency += r.amount || 0;
                rewardText = `${r.amount} ОСКОЛКОВ`;
            } else if (r.type === 'core') {
                meta.bossCurrency += r.amount || 0;
                rewardText = `${r.amount} ЯДЕР`;
            } else if (r.type === 'item') {
                const item = this.generateLoot();
                item.rarity = 'rare'; // Min rare for raid
                meta.inventory.push(item);
                rewardText = `ПРЕДМЕТ: ${item.name}`;
            }
            saveMeta();
        }
        
        document.getElementById('vic-reward')!.innerText = rewardText;
        this.setScreen('victory-screen');
    }

    updateHud() {
      document.getElementById('hud-score')!.innerText = this.score.toString();
      document.getElementById('hud-level')!.innerText = this.player.level.toString();
      document.getElementById('hud-wave')!.innerText = this.director.wave.toString();
      
      const hpPct = (this.player.hp / this.player.maxHp) * 100;
      document.getElementById('hud-hp-bar')!.style.width = `${Math.max(0, hpPct)}%`;
      document.getElementById('hud-hp-text')!.innerText = `${Math.max(0, Math.ceil(this.player.hp))}/${Math.ceil(this.player.maxHp)}`;
      
      const xpPct = (this.player.xp / this.player.maxXp) * 100;
      document.getElementById('hud-xp-bar')!.style.width = `${xpPct}%`;
    }

    setScreen(id: string) {
      document.querySelectorAll('.screen').forEach(el => el.classList.add('hidden'));
      document.querySelectorAll('.screen').forEach(el => el.classList.remove('active'));
      const el = document.getElementById(id);
      if (el) {
        el.classList.remove('hidden');
        el.classList.add('active');
      }
      
      // Hide Observer UI if not playing
      if (id !== 'hud-screen') {
         document.getElementById('observer-ui')?.classList.add('hidden');
      }
    }

    setupInputs() {
      // Note: Keyboard listeners are now global (see top of script)
      // We only attach canvas-specific mouse tracking here
      
      // Mouse tracking relative to canvas scaling (Moved to window to prevent freezing over UI)
      window.addEventListener('mousemove', this.boundMouseMove);
      window.addEventListener('mousedown', this.boundMouseDown);

      // UI Buttons
      document.getElementById('btn-start')?.addEventListener('click', () => {
          this.setScreen('difficulty-screen');
          const grid = document.querySelector('.diff-grid')!;
          grid.innerHTML = '';
          const diffs = [1, 2, 4, 8, 16, 32, 64];
          diffs.forEach(d => {
              const btn = document.createElement('button');
              btn.className = 'diff-btn';
              btn.innerText = `x${d}`;
              
              // Check unlock
              let unlocked = d === 1;
              if (d > 1 && meta.unlocks.includes(`diff_x${d}`)) unlocked = true;
              
              if (unlocked) {
                  btn.classList.add('unlocked');
                  btn.onclick = () => {
                      selectedDifficulty = d;
                      this.start();
                  };
                  btn.onmouseenter = () => {
                      document.getElementById('diff-desc')!.innerText = `МНОЖИТЕЛЬ НАГРАД: x${d} | ВРАГИ: +${(d-1)*100}% HP`;
                  };
              }
              grid.appendChild(btn);
          });
      });
      
      document.getElementById('btn-diff-back')?.addEventListener('click', () => this.setScreen('menu-screen'));
      document.getElementById('btn-restart')?.addEventListener('click', () => this.start(this.lastMode, this.lastRaidId));
      document.getElementById('btn-menu')?.addEventListener('click', () => {
        this.state = 'MENU';
        this.setScreen('menu-screen');
        updateMenuStats();
      });
      
      // Raid UI
      document.getElementById('btn-raids')?.addEventListener('click', () => {
          this.setScreen('raid-screen');
          const list = document.getElementById('raid-list')!;
          list.innerHTML = '';
          RAIDS.forEach(r => {
              const el = document.createElement('div');
              el.className = 'raid-card';
              const rewardStr = r.reward.type === 'item' ? 'СЛУЧАЙНЫЙ ПРЕДМЕТ' : `${r.reward.amount} ${r.reward.type === 'currency' ? 'ОСКОЛКОВ' : 'ЯДЕР'}`;
              el.innerHTML = `
                <div class="raid-info"><h3>${r.name}</h3><p>${r.desc}</p></div>
                <div class="raid-reward"><div style="font-size:0.7rem; color:#888">НАГРАДА</div><div class="val">${rewardStr}</div></div>
              `;
              el.onclick = () => this.start('raid', r.id);
              list.appendChild(el);
          });
      });
      document.getElementById('btn-raid-back')?.addEventListener('click', () => this.setScreen('menu-screen'));
      document.getElementById('btn-vic-menu')?.addEventListener('click', () => {
        this.state = 'MENU';
        this.setScreen('menu-screen');
        updateMenuStats();
      });
      
      // Leaderboard UI
      document.getElementById('btn-leaderboard')?.addEventListener('click', () => {
          this.setScreen('leaderboard-screen');
          fetchLeaderboard();
      });
      document.getElementById('btn-lb-back')?.addEventListener('click', () => {
          this.setScreen('menu-screen');
      });
      
      // Score Submit
      document.getElementById('btn-submit-score')?.addEventListener('click', () => {
          const input = document.getElementById('player-name-input') as HTMLInputElement;
          const name = input.value.trim().toUpperCase();
          
          if (name.length >= 2 && name.length <= 6 && /^[A-Z]+$/.test(name)) {
              postScore(name, this.score);
              document.getElementById('highscore-input')?.classList.add('hidden');
              alert("РЕКОРД ОТПРАВЛЕН!");
          } else {
              alert("ИМЯ: 2-6 ЛАТИНСКИХ БУКВ");
          }
      });

      // Window Controls
      document.getElementById('win-close')?.addEventListener('click', () => {
          window.location.href = '/games';
      });
      document.getElementById('win-maximize')?.addEventListener('click', () => {
          const el = document.getElementById('app-window');
          if (!document.fullscreenElement) el?.requestFullscreen();
          else document.exitFullscreen();
      });

      // Shop Logic Generic
      const types = ['hp', 'dmg', 'spd', 'rate', 'mag', 'luck', 'knock'];
      const keys = ['startHp', 'baseDmg', 'moveSpeed', 'fireRate', 'magnet', 'luck', 'knockback'];
      types.forEach((t, i) => {
          document.getElementById(`btn-upg-${t}`)?.addEventListener('click', () => {
              const key = keys[i] as keyof typeof meta.upgrades;
              const cost = getCost(key as any, meta.upgrades[key]);
              if (meta.currency >= cost) {
                  meta.currency -= cost;
                  meta.upgrades[key]++;
                  saveMeta();
              }
          });
      });

      // Core Shop Screen
      document.getElementById('btn-open-core')?.addEventListener('click', () => {
          this.setScreen('core-screen');
          updateMenuStats();
      });
      document.getElementById('btn-core-back')?.addEventListener('click', () => {
          this.setScreen('menu-screen');
          updateMenuStats();
      });

      // Inventory Logic
      document.getElementById('btn-inventory')?.addEventListener('click', () => {
          this.setScreen('inventory-screen');
          this.renderInventory();
      });
      document.getElementById('btn-inv-back')?.addEventListener('click', () => {
          this.setScreen('menu-screen');
          saveMeta();
      });

      // Tree Logic
      document.getElementById('btn-tree')?.addEventListener('click', () => {
        this.state = 'TREE';
        this.setScreen('tree-screen');
        if (!this.treeRenderer) {
          this.treeRenderer = new SkillTreeRenderer();
          this.treeRenderer.draw();
          
          // Delegate click for dynamic button
          document.getElementById('tree-tooltip')?.addEventListener('click', (e) => {
              if ((e.target as HTMLElement).id === 'btn-unlock-node' && this.treeRenderer?.selectedNode) {
                  this.treeRenderer.tryUnlock(this.treeRenderer.selectedNode);
                  this.treeRenderer.updateTooltip(); // Refresh UI
              }
          });
        }
      });
      document.getElementById('btn-tree-back')?.addEventListener('click', () => {
        this.state = 'MENU';
        this.setScreen('menu-screen');
        updateMenuStats();
      });
    }

    handleMouseMove(e: MouseEvent) {
        const rect = this.canvas.getBoundingClientRect();
        const scaleX = CANVAS_W / rect.width;
        const scaleY = CANVAS_H / rect.height;
        mouse.pos.x = (e.clientX - rect.left) * scaleX;
        mouse.pos.y = (e.clientY - rect.top) * scaleY;
    }

    destroy() {
        window.removeEventListener('mousemove', this.boundMouseMove);
        window.removeEventListener('mousedown', this.boundMouseDown);
        if (animationFrameId) cancelAnimationFrame(animationFrameId);
        gameInstance = null;
    }

    getItemDesc(item: Item) {
        if (item.desc) return item.desc;
        const parts = [];
        if (item.stats.dmg) parts.push(`Урон +${item.stats.dmg}`);
        if (item.stats.hp) parts.push(`HP +${item.stats.hp}`);
        if (item.stats.spd) parts.push(`Скор +${item.stats.spd}`);
        if (item.stats.crit) parts.push(`Крит +${(item.stats.crit*100).toFixed(1)}%`);
        return parts.join(', ');
    }

    renderInventory() {
        const grid = document.getElementById('inv-grid');
        if (!grid) return;
        grid.innerHTML = '';
        
        // Render Equipped
        ['weapon', 'armor', 'chip'].forEach(slot => {
            const el = document.getElementById(`slot-${slot}`);
            if (!el) return;
            const item = meta.equipment[slot as keyof typeof meta.equipment];
            if (item) {
                const desc = item.desc || this.getItemDesc(item);
                el.innerHTML = `${item.icon} ${item.name}<br><span style="font-size:0.6rem; color:${this.getItemColor(item.rarity)}">${item.rarity.toUpperCase()}</span><br><span style="font-size:0.55rem; color:#aaa">${desc}</span>`;
                el.classList.add('filled');
                el.onclick = () => {
                    meta.inventory.push(item);
                    meta.equipment[slot as any] = null;
                    this.renderInventory();
                };
            } else {
                el.innerHTML = "ПУСТО";
                el.classList.remove('filled');
                el.onclick = null;
            }
        });

        // Render Bag
        meta.inventory.forEach((item, idx) => {
            const div = document.createElement('div');
            div.className = `inv-item rarity-${item.rarity}`;
            div.innerHTML = `<div style="font-size:1.5rem">${item.icon}</div><div>${item.name}</div>`;
            div.style.color = this.getItemColor(item.rarity);
            
            const desc = item.desc || this.getItemDesc(item);
            div.title = `${item.name}\n${item.rarity.toUpperCase()}\n\n${desc}`;
            
            div.onclick = () => {
                // Equip
                const current = meta.equipment[item.type];
                if (current) meta.inventory.push(current);
                meta.equipment[item.type] = item;
                meta.inventory.splice(idx, 1);
                this.renderInventory();
            };
            grid.appendChild(div);
        });
    }

    getItemColor(rarity: string) {
        return rarity === 'legendary' ? '#ffd700' : rarity === 'epic' ? '#a020f0' : rarity === 'rare' ? '#00f' : '#fff';
    }

    startLoop() {
      if (animationFrameId) cancelAnimationFrame(animationFrameId);
      
      const loop = (now: number) => {
        const dt = Math.min((now - lastTime) / 1000, 0.1);
        lastTime = now;

        if (gameInstance === this) {
          this.update(dt);
          this.draw();
          animationFrameId = requestAnimationFrame(loop);
        }
      };
      animationFrameId = requestAnimationFrame(loop);
    }
  }

  // --- GLOBALS (Bottom) ---
  let lastTime = 0;

  document.addEventListener('astro:page-load', () => {
    loadMeta();
    if (gameInstance) {
        gameInstance.destroy();
    }
    new Game();
  });

</script>