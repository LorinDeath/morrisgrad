    { id: 'r7', name: 'СЕКТОР 777', desc: 'Уровень угрозы: 777', bossId: 'boss2', reward: { type: 'currency', amount: 10000 }, minLevel: 777 },
    { id: 'r8', name: 'СЕКТОР 888', desc: 'Уровень угрозы: 888', bossId: 'boss3', reward: { type: 'core', amount: 20 }, minLevel: 888 },
