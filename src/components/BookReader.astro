---
import type { BookData, Chapter } from '../utils/fb2';

interface Props {
  book?: BookData;
  books?: BookData[];
}

const { book, books = [] } = Astro.props;
const allBooks = books.length > 0 ? books : (book ? [book] : []);
const initialBook = book || allBooks[0];
---

<!-- Модальный Art Deco ридер книг вселенной -->
<div id="morris-book-modal" class="book-modal-backdrop" aria-hidden="true">
  <div class="book-modal-window" role="dialog" aria-label="Читалка книг МоррисГрад">
    
    <!-- Декоративная арт-деко рама -->
    <div class="deco-frame-corner top-left"></div>
    <div class="deco-frame-corner top-right"></div>
    <div class="deco-frame-corner bottom-left"></div>
    <div class="deco-frame-corner bottom-right"></div>

    <!-- Верхняя панель управления ридером -->
    <header class="reader-toolbar">
      <div class="toolbar-left">
        <!-- Выбор книги (если доступно несколько) -->
        {allBooks.length > 1 && (
          <div class="book-selector-wrap">
            <select id="book-select-dropdown" class="book-select-dropdown" aria-label="Выберите книгу">
              {allBooks.map((b, idx) => (
                <option value={b.id}>{b.title}</option>
              ))}
            </select>
          </div>
        )}

        <button id="book-btn-toc" class="toolbar-btn active" title="Открыть оглавление">
          <span class="btn-icon">📜</span>
          <span class="btn-label">Содержание</span>
        </button>
        <span class="toolbar-divider"></span>
        <button id="book-btn-read" class="toolbar-btn" title="Вернуться к чтению">
          <span class="btn-icon">📖</span>
          <span class="btn-label">Книга</span>
        </button>
      </div>

      <div class="toolbar-center">
        <span id="reader-top-book-title" class="book-mini-title">{initialBook?.title}</span>
        <span id="current-chapter-chip" class="chapter-chip hidden">Пролог</span>
      </div>

      <div class="toolbar-right">
        <!-- Размер шрифта -->
        <div class="font-controls" title="Размер шрифта">
          <button id="font-decrease" class="font-btn" aria-label="Уменьшить шрифт">A-</button>
          <button id="font-increase" class="font-btn" aria-label="Увеличить шрифт">A+</button>
        </div>
        <span class="toolbar-divider"></span>
        <!-- Закрыть ридер -->
        <button id="book-close-btn" class="close-reader-btn" aria-label="Закрыть книгу" title="Закрыть (Esc)">
          ✕
        </button>
      </div>
    </header>

    <!-- Индикатор прогресса чтения -->
    <div class="reading-progress-track">
      <div id="reading-progress-bar" class="reading-progress-bar"></div>
    </div>

    <!-- Основная область контента ридера -->
    <div class="reader-viewport" id="reader-viewport">
      
      <!-- ===================================================================
           ВИД 1: ОГЛАВЛЕНИЕ (TABLE OF CONTENTS)
           =================================================================== -->
      <section id="view-toc" class="reader-view toc-view active">
        <div class="toc-header-art">
          <div class="artdeco-filigree">
            <span class="filigree-line"></span>
            <span class="filigree-glyph">❖ ⚜ ❖</span>
            <span class="filigree-line"></span>
          </div>

          <h2 id="toc-main-title" class="toc-main-title">{initialBook?.title}</h2>
          <p id="toc-series-tag" class="toc-series-tag">✦ {initialBook?.series} // Том {initialBook?.seriesNumber} ✦</p>
          <p id="toc-author" class="toc-author">Автор: <strong id="toc-author-name">{initialBook?.author}</strong></p>

          <!-- Быстрый выбор книги цикла -->
          {allBooks.length > 1 && (
            <div class="cycle-tabs-bar">
              <span class="cycle-label">Книги цикла:</span>
              <div class="cycle-tabs">
                {allBooks.map((b, idx) => (
                  <button 
                    class={`cycle-tab-btn ${idx === 0 ? 'active' : ''}`} 
                    data-book-id={b.id}
                  >
                    {b.title}
                  </button>
                ))}
              </div>
            </div>
          )}

          <div class="book-quick-stats">
            <span id="stat-chapters" class="stat-pill"><span class="stat-icon">📜</span> {initialBook?.totalChapters} глав</span>
            <span id="stat-words" class="stat-pill"><span class="stat-icon">🖋</span> {initialBook?.totalWords?.toLocaleString('ru-RU')} слов</span>
            <span id="stat-time" class="stat-pill"><span class="stat-icon">⏱</span> ~{initialBook?.totalReadingTimeMinutes} мин чтения</span>
          </div>
        </div>

        <!-- Краткое описание книги с обложкой из FB2 -->
        <div class="toc-annotation-card">
          <div class="annotation-cover">
            <img id="toc-cover-img" src={initialBook?.coverImage} alt={initialBook?.title} class="annotation-img" loading="lazy" />
            <div class="annotation-cover-glow"></div>
            <div class="annotation-spine"></div>
          </div>
          <div class="annotation-body">
            <h3 class="annotation-heading">Аннотация летописи</h3>
            <div id="toc-annotation-content" class="annotation-text" set:html={initialBook?.annotationHtml || initialBook?.annotation} />
            <div class="annotation-cta">
              <button id="btn-start-reading-lead" class="btn-start-reading" data-chapter="0">
                <span class="btn-rune">✦</span> Читать с первой главы →
              </button>
            </div>
          </div>
        </div>

        <div class="toc-section-divider">
          <span class="divider-line"></span>
          <span class="divider-text">СОДЕРЖАНИЕ И ХРОНИКИ</span>
          <span class="divider-line"></span>
        </div>

        <!-- Контейнер глав (наполняется динамически) -->
        <div id="chapters-list-container" class="chapters-grid">
          {initialBook?.chapters.map((ch, idx) => (
            <article class="chapter-card" data-chapter={idx}>
              <div class="ch-badge-num">
                <span class="ch-num-val">{String(idx + 1).padStart(2, '0')}</span>
              </div>
              <div class="ch-main-info">
                <h4 class="ch-title">{ch.title}</h4>
                <p class="ch-snippet">{ch.snippet}</p>
                <div class="ch-meta">
                  <span class="ch-meta-item">⏱ ~{ch.readingTimeMinutes} мин</span>
                  <span class="ch-meta-item">·</span>
                  <span class="ch-meta-item">{ch.paragraphsCount} абзацев</span>
                </div>
              </div>
              <div class="ch-action">
                <span class="ch-arrow">→</span>
              </div>
            </article>
          ))}
        </div>
      </section>

      <!-- ===================================================================
           ВИД 2: ЧТЕНИЕ ГЛАВЫ (BOOK READER CHAPTER VIEW)
           =================================================================== -->
      <section id="view-chapter" class="reader-view chapter-view">
        <article class="book-page-parchment">
          
          <!-- Заголовок главы в стиле Арт-Деко -->
          <div class="chapter-page-header">
            <div class="deco-ornament-top">
              <span class="orn-line"></span>
              <span class="orn-diamond">◆</span>
              <span class="orn-symbol">❖</span>
              <span class="orn-diamond">◆</span>
              <span class="orn-line"></span>
            </div>
            
            <span id="current-chapter-num-display" class="chapter-num-label">ГЛАВА I</span>
            <h1 id="current-chapter-title-display" class="chapter-page-title">Пролог</h1>
            
            <div class="chapter-meta-line">
              <span id="current-chapter-time-display">~5 мин чтения</span>
              <span class="meta-sep">✦</span>
              <span id="current-chapter-book-display" class="meta-author">{initialBook?.title} // {initialBook?.author}</span>
            </div>

            <div class="deco-ornament-bot">
              <span class="orn-line"></span>
              <span class="orn-glyph">⚜</span>
              <span class="orn-line"></span>
            </div>
          </div>

          <!-- Текст главы -->
          <div id="chapter-text-container" class="book-body-content">
            <!-- Динамически наполняется клиентским скриптом -->
          </div>

          <!-- Нижняя навигация между главами -->
          <nav class="chapter-navigation-footer">
            <button id="btn-prev-chapter" class="chapter-nav-btn prev-btn" disabled>
              <span class="nav-arrow">←</span>
              <span class="nav-text">Предыдущая</span>
            </button>

            <button id="btn-back-to-toc" class="chapter-nav-btn toc-btn">
              <span class="nav-icon">📜</span>
              <span class="nav-text">Оглавление</span>
            </button>

            <button id="btn-next-chapter" class="chapter-nav-btn next-btn">
              <span class="nav-text">Следующая</span>
              <span class="nav-arrow">→</span>
            </button>
          </nav>

          <div class="book-page-end-mark">
            <span>❖ ❖ ❖</span>
          </div>

        </article>
      </section>

    </div>
  </div>
</div>

<script define:vars={{ allBooksJson: allBooks }}>
  // Клиентский модуль управления арт-деко читалкой для нескольких книг
  (function initMultiBookReader() {
    const books = allBooksJson || [];
    if (!books.length) return;

    let activeBookIndex = 0;
    let currentChapterIndex = 0;
    let currentFontSize = 1.05; // rem
    const minFont = 0.85;
    const maxFont = 1.35;

    const modal = document.getElementById('morris-book-modal');
    const viewport = document.getElementById('reader-viewport');
    const viewToc = document.getElementById('view-toc');
    const viewChapter = document.getElementById('view-chapter');
    const btnToc = document.getElementById('book-btn-toc');
    const btnRead = document.getElementById('book-btn-read');
    const closeBtn = document.getElementById('book-close-btn');
    const chip = document.getElementById('current-chapter-chip');
    const progressBar = document.getElementById('reading-progress-bar');
    const dropdown = document.getElementById('book-select-dropdown');
    const topBookTitle = document.getElementById('reader-top-book-title');

    // Элементы оглавления
    const tocMainTitle = document.getElementById('toc-main-title');
    const tocSeriesTag = document.getElementById('toc-series-tag');
    const tocAuthorName = document.getElementById('toc-author-name');
    const tocCoverImg = document.getElementById('toc-cover-img');
    const tocAnnotationContent = document.getElementById('toc-annotation-content');
    const statChapters = document.getElementById('stat-chapters');
    const statWords = document.getElementById('stat-words');
    const statTime = document.getElementById('stat-time');
    const chaptersContainer = document.getElementById('chapters-list-container');
    const btnStartReadingLead = document.getElementById('btn-start-reading-lead');

    // Элементы чтения
    const chNumDisplay = document.getElementById('current-chapter-num-display');
    const chTitleDisplay = document.getElementById('current-chapter-title-display');
    const chTimeDisplay = document.getElementById('current-chapter-time-display');
    const chBookDisplay = document.getElementById('current-chapter-book-display');
    const textContainer = document.getElementById('chapter-text-container');
    const btnPrev = document.getElementById('btn-prev-chapter');
    const btnNext = document.getElementById('btn-next-chapter');
    const btnBackToToc = document.getElementById('btn-back-to-toc');

    const fontDec = document.getElementById('font-decrease');
    const fontInc = document.getElementById('font-increase');

    function getActiveBook() {
      return books[activeBookIndex] || books[0];
    }

    function openModal() {
      if (!modal) return;
      modal.classList.add('active');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      if (!modal) return;
      modal.classList.remove('active');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      if (window.location.hash.startsWith('#book') || window.location.hash.startsWith('#chapter')) {
        history.replaceState(null, '', window.location.pathname + window.location.search);
      }
    }

    function switchToView(viewName) {
      if (!viewToc || !viewChapter || !btnToc || !btnRead) return;

      if (viewName === 'toc') {
        viewToc.classList.add('active');
        viewChapter.classList.remove('active');
        btnToc.classList.add('active');
        btnRead.classList.remove('active');
        if (chip) chip.classList.add('hidden');
        if (progressBar) progressBar.style.width = '0%';
        if (viewport) viewport.scrollTop = 0;
      } else {
        viewToc.classList.remove('active');
        viewChapter.classList.add('active');
        btnToc.classList.remove('active');
        btnRead.classList.add('active');
        if (chip) chip.classList.remove('hidden');
        if (viewport) viewport.scrollTop = 0;
      }
    }

    function renderTocForBook(book) {
      if (!book) return;

      if (topBookTitle) topBookTitle.textContent = book.title;
      if (tocMainTitle) tocMainTitle.textContent = book.title;
      if (tocSeriesTag) tocSeriesTag.textContent = `✦ ${book.series} // Том ${book.seriesNumber} ✦`;
      if (tocAuthorName) tocAuthorName.textContent = book.author;
      if (tocCoverImg) {
        tocCoverImg.src = book.coverImage;
        tocCoverImg.alt = book.title;
      }
      if (tocAnnotationContent) {
        tocAnnotationContent.innerHTML = book.annotationHtml || `<p>${book.annotation}</p>`;
      }
      if (statChapters) statChapters.innerHTML = `<span class="stat-icon">📜</span> ${book.totalChapters} глав`;
      if (statWords) statWords.innerHTML = `<span class="stat-icon">🖋</span> ${book.totalWords.toLocaleString('ru-RU')} слов`;
      if (statTime) statTime.innerHTML = `<span class="stat-icon">⏱</span> ~${book.totalReadingTimeMinutes} мин чтения`;

      // Обновление селектора и табов
      if (dropdown) dropdown.value = book.id;
      document.querySelectorAll('.cycle-tab-btn').forEach((tab) => {
        if (tab.getAttribute('data-book-id') === book.id) {
          tab.classList.add('active');
        } else {
          tab.classList.remove('active');
        }
      });

      // Перерисовка списка глав
      if (chaptersContainer) {
        let chHtml = '';
        book.chapters.forEach((ch, idx) => {
          chHtml += `
            <article class="chapter-card" data-chapter="${idx}">
              <div class="ch-badge-num">
                <span class="ch-num-val">${String(idx + 1).padStart(2, '0')}</span>
              </div>
              <div class="ch-main-info">
                <h4 class="ch-title">${ch.title}</h4>
                <p class="ch-snippet">${ch.snippet || ''}</p>
                <div class="ch-meta">
                  <span class="ch-meta-item">⏱ ~${ch.readingTimeMinutes} мин</span>
                  <span class="ch-meta-item">·</span>
                  <span class="ch-meta-item">${ch.paragraphsCount} абзацев</span>
                </div>
              </div>
              <div class="ch-action">
                <span class="ch-arrow">→</span>
              </div>
            </article>
          `;
        });
        chaptersContainer.innerHTML = chHtml;

        // Повторное привязывание кликов
        chaptersContainer.querySelectorAll('.chapter-card').forEach((el) => {
          el.addEventListener('click', (e) => {
            const idx = parseInt(e.currentTarget.getAttribute('data-chapter') || '0', 10);
            loadChapter(idx);
          });
        });
      }
    }

    function switchBook(bookIdOrIndex, targetChapter = 0, openToc = false) {
      if (typeof bookIdOrIndex === 'string') {
        const foundIdx = books.findIndex(b => b.id === bookIdOrIndex);
        activeBookIndex = foundIdx !== -1 ? foundIdx : 0;
      } else if (typeof bookIdOrIndex === 'number') {
        activeBookIndex = Math.max(0, Math.min(bookIdOrIndex, books.length - 1));
      }

      const book = getActiveBook();
      renderTocForBook(book);

      if (openToc) {
        switchToView('toc');
      } else {
        loadChapter(targetChapter);
      }
    }

    function loadChapter(index) {
      const book = getActiveBook();
      if (!book || !book.chapters.length) return;

      currentChapterIndex = Math.max(0, Math.min(index, book.chapters.length - 1));
      const ch = book.chapters[currentChapterIndex];

      if (chNumDisplay) {
        chNumDisplay.textContent = `ЛЕТОПИСЬ #${currentChapterIndex + 1} ИЗ ${book.totalChapters}`;
      }
      if (chTitleDisplay) {
        chTitleDisplay.textContent = ch.title;
      }
      if (chTimeDisplay) {
        chTimeDisplay.textContent = `~${ch.readingTimeMinutes} мин чтения • ${ch.paragraphsCount} абзацев`;
      }
      if (chBookDisplay) {
        chBookDisplay.textContent = `${book.title} // ${book.author}`;
      }
      if (chip) {
        chip.textContent = ch.title.length > 25 ? ch.title.substring(0, 22) + '...' : ch.title;
      }

      if (textContainer) {
        let html = '';
        let dropCapApplied = false;

        ch.paragraphs.forEach((p) => {
          if (!dropCapApplied && p.startsWith('<p>') && !p.includes('book-divider') && !p.includes('book-epigraph')) {
            const rawContent = p.replace(/^<p>/i, '').replace(/<\/p>$/i, '').trim();
            const firstChar = rawContent.charAt(0);
            const remaining = rawContent.slice(1);
            html += `<p class="has-drop-cap"><span class="drop-cap">${firstChar}</span>${remaining}</p>`;
            dropCapApplied = true;
          } else {
            html += p;
          }
        });

        textContainer.innerHTML = html;
        textContainer.style.fontSize = `${currentFontSize}rem`;
      }

      if (btnPrev) btnPrev.disabled = currentChapterIndex === 0;
      if (btnNext) btnNext.disabled = currentChapterIndex === book.chapters.length - 1;

      if (progressBar) {
        const pct = Math.round(((currentChapterIndex + 1) / book.totalChapters) * 100);
        progressBar.style.width = `${pct}%`;
      }

      switchToView('chapter');
      history.replaceState(null, '', `#book-${book.id}-chapter-${currentChapterIndex + 1}`);
    }

    // Слушатель выбора книги из селектора
    if (dropdown) {
      dropdown.addEventListener('change', (e) => {
        switchBook(e.target.value, 0, true);
      });
    }

    // Слушатели табов цикла
    document.querySelectorAll('.cycle-tab-btn').forEach((tab) => {
      tab.addEventListener('click', (e) => {
        const bId = e.currentTarget.getAttribute('data-book-id');
        switchBook(bId, 0, true);
      });
    });

    if (btnStartReadingLead) {
      btnStartReadingLead.addEventListener('click', () => loadChapter(0));
    }

    // Привязываем клики по карточкам глав при первой инициализации
    if (chaptersContainer) {
      chaptersContainer.querySelectorAll('.chapter-card').forEach((el) => {
        el.addEventListener('click', (e) => {
          const idx = parseInt(e.currentTarget.getAttribute('data-chapter') || '0', 10);
          loadChapter(idx);
        });
      });
    }

    // Тулбар навигации
    if (btnToc) btnToc.addEventListener('click', () => switchToView('toc'));
    if (btnRead) btnRead.addEventListener('click', () => switchToView('chapter'));
    if (btnBackToToc) btnBackToToc.addEventListener('click', () => switchToView('toc'));

    if (btnPrev) {
      btnPrev.addEventListener('click', () => {
        if (currentChapterIndex > 0) loadChapter(currentChapterIndex - 1);
      });
    }

    if (btnNext) {
      btnNext.addEventListener('click', () => {
        const book = getActiveBook();
        if (currentChapterIndex < book.chapters.length - 1) loadChapter(currentChapterIndex + 1);
      });
    }

    if (closeBtn) closeBtn.addEventListener('click', closeModal);
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });
    }

    // Клавиатура
    document.addEventListener('keydown', (e) => {
      if (!modal || !modal.classList.contains('active')) return;
      if (e.key === 'Escape') closeModal();
      if (viewChapter && viewChapter.classList.contains('active')) {
        if (e.key === 'ArrowLeft' && currentChapterIndex > 0) {
          loadChapter(currentChapterIndex - 1);
        } else if (e.key === 'ArrowRight') {
          const book = getActiveBook();
          if (currentChapterIndex < book.chapters.length - 1) {
            loadChapter(currentChapterIndex + 1);
          }
        }
      }
    });

    // Шрифт
    if (fontInc) {
      fontInc.addEventListener('click', () => {
        if (currentFontSize < maxFont) {
          currentFontSize += 0.08;
          if (textContainer) textContainer.style.fontSize = `${currentFontSize}rem`;
        }
      });
    }
    if (fontDec) {
      fontDec.addEventListener('click', () => {
        if (currentFontSize > minFont) {
          currentFontSize -= 0.08;
          if (textContainer) textContainer.style.fontSize = `${currentFontSize}rem`;
        }
      });
    }

    // Глобальная функция для открытия из любой точки страницы
    window.openMorrisBook = function(bookId = 'obitel-smerti', targetChapter = 0, openToc = false) {
      openModal();
      switchBook(bookId, targetChapter, openToc);
    };

    // Привязка всех data-open-book на странице
    document.querySelectorAll('[data-open-book]').forEach((trigger) => {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        const bId = trigger.getAttribute('data-book-id') || 'obitel-smerti';
        const mode = trigger.getAttribute('data-book-mode') || 'read';
        const ch = parseInt(trigger.getAttribute('data-target-chapter') || '0', 10);
        openModal();
        switchBook(bId, ch, mode === 'toc');
      });
    });

    // Обработка прямого хэша в URL
    function checkUrlHash() {
      const hash = window.location.hash;
      if (!hash) return;

      if (hash === '#book' || hash === '#book-toc') {
        openModal();
        switchBook('obitel-smerti', 0, true);
        return;
      }

      // Проверка хэша формата #book-[id] или #book-[id]-chapter-[N]
      for (const b of books) {
        if (hash.startsWith(`#book-${b.id}`)) {
          openModal();
          const matchChapter = hash.match(new RegExp(`#book-${b.id}-chapter-(\\d+)`));
          if (matchChapter) {
            const chNum = parseInt(matchChapter[1], 10) - 1;
            switchBook(b.id, Math.max(0, chNum), false);
          } else {
            switchBook(b.id, 0, true);
          }
          return;
        }
      }

      // Простой хэш #chapter-N для книги по умолчанию
      if (hash.startsWith('#chapter-')) {
        const chNum = parseInt(hash.replace('#chapter-', ''), 10) - 1;
        if (!isNaN(chNum) && chNum >= 0) {
          openModal();
          switchBook('obitel-smerti', chNum, false);
        }
      }
    }

    checkUrlHash();
    window.addEventListener('hashchange', checkUrlHash);
  })();
</script>

<style>
  /* =========================================================================
     МОДАЛЬНОЕ ОКНО И АРТ-ДЕКО ОФОРМЛЕНИЕ МУЛЬТИ-РИДЕРА КНИГ
     ========================================================================= */
  .book-modal-backdrop {
    position: fixed;
    inset: 0;
    z-index: 99999;
    background: rgba(4, 2, 8, 0.88);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.35s cubic-bezier(0.2, 0.8, 0.2, 1), visibility 0.35s ease;
    padding: 1.5rem;
  }

  .book-modal-backdrop.active {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .book-modal-window {
    position: relative;
    width: 100%;
    max-width: 960px;
    height: 92vh;
    background: linear-gradient(180deg, #0e0717 0%, #07030d 100%);
