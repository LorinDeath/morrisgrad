---
// Оболочка форума: шапка раздела, переключатели вида, общие стили и клиентский скрипт (без фреймворков).
import Layout from "../../layouts/Layout.astro";
interface Props { title: string; viewer: any; active?: string; wide?: boolean }
const { title, viewer, active = "", wide = false } = Astro.props;
const isMod = viewer?.role === "admin" || viewer?.role === "moderator";
const links = [
  ["feed", "/forum", "Лента"],
  ["sections", "/forum/sections", "Разделы"],
  ["rules", "/forum/rules", "Правила"],
];
---
<Layout title={`${title} — Форум МоррисГрада`}>
  <div class="forum" id="forum-root" data-uid={viewer?.uid ? String(viewer.user?.pid ?? 1) : ""} data-role={viewer?.role || ""}>
    <script is:inline>
      (function () { try { var r = document.currentScript.parentElement; if (localStorage.getItem("forum_compact") === "1") r.classList.add("f-compact"); if (localStorage.getItem("forum_light") === "1") r.classList.add("f-light"); } catch (e) {} })();
    </script>
    <div class={`f-wrap${wide ? " f-wrap-wide" : ""}`}>
      <div class="f-top">
        <a href="/forum" class="f-brand"><span class="f-brand-rune">❖</span> Форум <span class="f-brand-sub">МоррисГрада</span></a>
        <nav class="f-nav" aria-label="Форум">
          {links.map(([k, href, label]) => <a href={href} class={`f-nav-a${active === k ? " on" : ""}`}>{label}</a>)}
          {viewer?.uid && <a href={`/forum/u/${viewer.user?.pid ?? ""}`} class={`f-nav-a${active === "me" ? " on" : ""}`}>Мой профиль</a>}
          {isMod && <a href="/forum/admin" class={`f-nav-a f-nav-admin${active === "admin" ? " on" : ""}`}>Модерация</a>}
        </nav>
        <div class="f-top-right">
          <button type="button" class="f-tog" data-toggle="compact" title="Компактный вид (как на старых WAP-форумах)">▤ <span>Компактно</span></button>
          <button type="button" class="f-tog" data-toggle="light" title="Светлая тема форума">◐ <span>Светлая</span></button>
          <a href="/forum/new" class="f-btn f-btn-primary f-write">✎ Написать</a>
        </div>
      </div>
      {viewer?.ban && <div class="f-alert f-alert-warn">Вы временно не можете писать на форуме{viewer.ban.until ? ` — до ${new Date(viewer.ban.until).toLocaleString("ru-RU", { timeZone: "Europe/Kiev" })}` : " (бессрочно)"}{viewer.ban.reason ? `. Причина: ${viewer.ban.reason}` : ""}. Читать можно.</div>}
      <slot />
    </div>

    <dialog class="f-dialog" id="f-report-dialog">
      <form data-astro-reload method="dialog" class="f-dialog-body" data-report-form>
        <h3>Пожаловаться</h3>
        <p class="f-muted">Жалоба уйдёт модераторам. Автор не узнает, кто пожаловался.</p>
        <div class="f-radio-list">
          <label><input type="radio" name="reason" value="Оскорбления" checked /> Оскорбления, травля</label>
          <label><input type="radio" name="reason" value="Мат / грубость" /> Мат, грубость</label>
          <label><input type="radio" name="reason" value="Спам / реклама" /> Спам, реклама</label>
          <label><input type="radio" name="reason" value="Личные данные" /> Чужие личные данные</label>
          <label><input type="radio" name="reason" value="Другое" /> Другое</label>
        </div>
        <textarea name="note" maxlength="200" rows="2" placeholder="Комментарий (необязательно)"></textarea>
        <div class="f-dialog-actions"><button value="cancel" class="f-btn">Отмена</button><button value="ok" class="f-btn f-btn-danger">Отправить жалобу</button></div>
      </form>
    </dialog>
    <dialog class="f-dialog" id="f-ban-dialog">
      <form data-astro-reload method="dialog" class="f-dialog-body" data-ban-form>
        <h3>Ограничить на форуме</h3>
        <p class="f-muted">Пользователь сможет читать, но не сможет писать, оценивать и загружать картинки.</p>
        <select name="minutes">
          <option value="60">1 час</option><option value="1440" selected>1 сутки</option><option value="10080">7 дней</option><option value="43200">30 дней</option><option value="0">Бессрочно</option>
        </select>
        <input name="reason" maxlength="200" placeholder="Причина (видна пользователю)" />
        <div class="f-dialog-actions"><button value="cancel" class="f-btn">Отмена</button><button value="ok" class="f-btn f-btn-danger">Ограничить</button></div>
      </form>
    </dialog>
    <div class="f-toast" id="f-toast" role="status" aria-live="polite"></div>
  </div>
</Layout>

<script>
  import "../../scripts/forum";
</script>

<style is:global>
  .forum {
    --f-bg: rgba(18, 14, 20, 0.86);
    --f-bg2: rgba(26, 20, 30, 0.9);
    --f-line: rgba(201, 168, 108, 0.16);
    --f-line2: #2a2030;
    --f-text: var(--text-main);
    --f-muted: var(--text-muted);
    --f-dim: var(--text-dim);
    --f-acc: var(--accent-gold);
    --f-red: var(--accent-crimson);
    --f-radius: 12px;
    color: var(--f-text);
    font-family: var(--font-body);
  }
  .forum.f-light {
    --f-bg: #fbf7f1; --f-bg2: #f3ece2; --f-line: #e3d6c3; --f-line2: #e3d6c3;
    --f-text: #2a2024; --f-muted: #6d5e58; --f-dim: #8d7f78; --f-acc: #8a5a1c; --f-red: #be123c;
  }
  .forum.f-light .f-wrap { background: #efe7db; border-radius: 16px; }
  .forum.f-light h1, .forum.f-light h2, .forum.f-light h3 { color: #2a2024; }
  .forum [hidden] { display: none !important; }
  .f-wrap { max-width: 1180px; margin: 0 auto; padding: 1.4rem 1.2rem 3rem; }
  .f-wrap-wide { max-width: 1280px; }
  .forum a { color: inherit; }
  .f-muted { color: var(--f-muted); font-size: .9rem; }
  .f-top { display: flex; align-items: center; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.2rem; padding: .7rem 1rem; background: var(--f-bg); border: 1px solid var(--f-line); border-radius: var(--f-radius); }
  .f-brand { font-family: var(--font-heading); font-size: 1.25rem; text-decoration: none; color: var(--f-acc) !important; white-space: nowrap; }
  .f-brand-rune { color: var(--f-red); }
  .f-brand-sub { color: var(--f-muted); font-size: .85rem; }
  .f-nav { display: flex; gap: 4px; flex-wrap: wrap; flex: 1; }
  .f-nav-a { padding: 6px 12px; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: .9rem; color: var(--f-muted) !important; border: 1px solid transparent; }
  .f-nav-a:hover { color: var(--f-acc) !important; border-color: var(--f-line); }
  .f-nav-a.on { color: var(--f-text) !important; background: var(--f-bg2); border-color: var(--f-line); }
  .f-nav-admin { color: #4ade80 !important; }
  .f-top-right { display: flex; gap: 6px; align-items: center; }
  .f-tog { background: transparent; border: 1px solid var(--f-line); color: var(--f-muted); border-radius: 8px; padding: 6px 9px; cursor: pointer; font: inherit; font-size: .8rem; }
  .f-tog.on, .f-tog:hover { color: var(--f-acc); border-color: var(--f-acc); }
  .f-btn { display: inline-flex; align-items: center; gap: 6px; padding: 8px 14px; border-radius: 9px; border: 1px solid var(--f-line); background: var(--f-bg2); color: var(--f-text) !important; text-decoration: none; font: inherit; font-weight: 600; font-size: .9rem; cursor: pointer; transition: .15s; }
  .f-btn:hover { border-color: var(--f-acc); color: var(--f-acc) !important; }
  .f-btn:disabled { opacity: .5; cursor: default; }
  .f-btn-primary { background: linear-gradient(135deg, rgba(225,29,72,.85), #9f1239); border-color: var(--f-red); color: #fff !important; }
  .f-btn-primary:hover { color: #fff !important; box-shadow: 0 0 14px var(--crimson-glow); border-color: var(--f-acc); }
  .f-btn-danger { border-color: var(--f-red); color: var(--f-red) !important; }
  .f-btn-s { padding: 4px 9px; font-size: .8rem; border-radius: 7px; }
  .f-alert { padding: .8rem 1rem; border-radius: 10px; border: 1px solid var(--f-line); background: var(--f-bg); margin-bottom: 1rem; }
  .f-alert-warn { border-color: rgba(251, 191, 36, .5); color: #fbbf24; }
  .f-alert-info { border-color: rgba(96, 165, 250, .4); }

  .f-grid { display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 1.2rem; align-items: start; }
  .f-side { display: flex; flex-direction: column; gap: 1rem; position: sticky; top: 70px; }
  .f-box { background: var(--f-bg); border: 1px solid var(--f-line); border-radius: var(--f-radius); padding: 1rem; }
  .f-box h3 { margin: 0 0 .7rem; font-size: 1rem; color: var(--f-acc); }
  .f-tabs { display: flex; gap: 4px; margin-bottom: 1rem; background: var(--f-bg); border: 1px solid var(--f-line); border-radius: var(--f-radius); padding: 5px; }
  .f-tab { flex: 1; text-align: center; padding: 8px 10px; border-radius: 8px; text-decoration: none; font-weight: 600; color: var(--f-muted) !important; font-size: .92rem; }
  .f-tab.on { background: var(--f-bg2); color: var(--f-text) !important; box-shadow: inset 0 -2px 0 var(--f-red); }
  .f-h1 { font-size: 1.6rem; margin: 0 0 .3rem; }
  .f-crumbs { font-size: .85rem; color: var(--f-muted); margin-bottom: .6rem; }
  .f-crumbs a { text-decoration: none; color: var(--f-acc) !important; }

  /* --- карточки ленты (DTF) --- */
  .f-feed { display: flex; flex-direction: column; gap: 1rem; }
  .f-card { background: var(--f-bg); border: 1px solid var(--f-line); border-radius: var(--f-radius); padding: 1rem 1.1rem .8rem; transition: border-color .15s; }
  .f-card:hover { border-color: rgba(201,168,108,.35); }
  .f-card-pinned { border-left: 3px solid var(--f-acc); }
  .f-card-hidden { opacity: .6; }
  .f-card-head { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; font-size: .82rem; color: var(--f-muted); }
  .f-chip { text-decoration: none; padding: 2px 8px; border-radius: 999px; background: var(--f-bg2); border: 1px solid var(--f-line); color: var(--f-text) !important; font-weight: 600; }
  .f-dot { color: var(--f-dim); }
  .f-badge { padding: 1px 7px; border-radius: 999px; border: 1px solid var(--f-line); font-size: .75rem; }
  .f-badge-feat { color: #fbbf24; border-color: rgba(251,191,36,.45); }
  .f-badge-warn { color: #f87171; border-color: rgba(248,113,113,.45); }
  .f-card-link { text-decoration: none; display: block; }
  .f-card-title { font-family: var(--font-body) !important; letter-spacing: 0 !important; font-size: 1.22rem; font-weight: 700; margin: .55rem 0 .35rem; line-height: 1.3; color: var(--f-text) !important; }
  .f-card-article .f-card-title { font-size: 1.4rem; }
  .f-kind { font-size: .7rem; vertical-align: middle; margin-right: 8px; padding: 2px 7px; border-radius: 6px; background: rgba(192,132,252,.15); color: var(--energy-purple); border: 1px solid var(--purple-border); text-transform: uppercase; letter-spacing: .5px; }
  .f-card-excerpt { margin: 0 0 .6rem; color: var(--f-muted); line-height: 1.5; font-size: .95rem; }
  .f-card-cover { margin: .4rem -1.1rem .2rem; background: #0006; max-height: 420px; overflow: hidden; display: flex; justify-content: center; }
  .f-card-cover img { width: 100%; max-height: 420px; object-fit: cover; display: block; }
  .f-card-foot { display: flex; align-items: center; gap: 14px; margin-top: .6rem; font-size: .88rem; }
  .f-like { display: inline-flex; align-items: center; gap: 5px; background: transparent; border: 1px solid var(--f-line); border-radius: 999px; padding: 4px 12px; color: var(--f-muted); cursor: pointer; font: inherit; transition: .15s; }
  .f-like:hover { color: var(--f-red); border-color: var(--f-red); }
  .f-like.on { color: #fff; background: rgba(225,29,72,.8); border-color: var(--f-red); }
  .f-like.pop .f-heart { animation: f-pop .3s; }
  @keyframes f-pop { 50% { transform: scale(1.5); } }
  .f-cc { text-decoration: none; color: var(--f-muted) !important; }
  .f-cc:hover { color: var(--f-acc) !important; }

  /* автор */
  .f-author { display: inline-flex; align-items: center; gap: 6px; min-width: 0; }
  .f-ava { width: 22px; height: 22px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: .72rem; font-weight: 700; color: #fff !important; text-decoration: none; background: hsl(var(--h) 45% 32%); border: 1px solid hsl(var(--h) 50% 50% / .6); flex: none; position: relative; overflow: hidden; }
  .f-ava-geo { position: absolute; inset: 14%; width: 72%; height: 72%; fill: hsl(var(--h) 60% 62% / .38); shape-rendering: crispEdges; }
  .f-ava-ch { position: relative; text-shadow: 0 1px 2px rgba(0,0,0,.6); line-height: 1; }
  .f-ava-img { background: #120d14; }
  .f-ava-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .f-ava-row { display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; }
  .f-crop { display: flex; gap: 1rem; align-items: flex-start; flex-wrap: wrap; margin-top: 1rem; padding-top: 1rem; border-top: 1px dashed var(--f-line2); }
  .f-crop-frame { width: 200px; height: 200px; border-radius: 50%; overflow: hidden; border: 2px solid var(--accent-gold); box-shadow: 0 0 0 4px rgba(0,0,0,.35); flex: none; touch-action: none; cursor: grab; background: repeating-conic-gradient(#221a26 0 25%, #1a141d 0 50%) 0 0 / 16px 16px; }
  .f-crop-frame canvas { width: 100%; height: 100%; display: block; }
  .f-team { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: .6rem; margin: .6rem 0 1.2rem; }
  .f-team-item { display: flex; gap: .6rem; align-items: center; padding: .55rem .7rem; border: 1px solid var(--f-line); border-radius: 10px; text-decoration: none !important; color: inherit !important; background: rgba(255,255,255,.02); }
  .f-team-item:hover { border-color: var(--f-acc); }
  .f-author-m .f-ava { width: 34px; height: 34px; font-size: .95rem; }
  .f-author-l .f-ava { width: 84px; height: 84px; font-size: 2.3rem; }
  .f-author-txt { display: inline-flex; align-items: center; gap: 6px; flex-wrap: wrap; }
  .f-nick { font-weight: 700; text-decoration: none; color: var(--f-text) !important; }
  .f-nick:hover { color: var(--f-acc) !important; }
  .f-rank { font-size: .72rem; color: var(--f-acc); border: 1px solid var(--f-line); border-radius: 5px; padding: 0 5px; }
  .f-role { font-size: .7rem; padding: 0 6px; border-radius: 5px; font-weight: 700; }
  .f-role-admin { background: rgba(225,29,72,.85); color: #fff; }
  .f-role-moderator { background: rgba(34,197,94,.8); color: #04130a; }
  .f-astats { font-size: .75rem; color: var(--f-dim); }

  /* классический список разделов (WAP) */
  .f-sec-table { background: var(--f-bg); border: 1px solid var(--f-line); border-radius: var(--f-radius); overflow: hidden; }
  .f-sec-row { display: grid; grid-template-columns: 44px minmax(0, 1fr) 110px minmax(0, 240px); gap: 12px; align-items: center; padding: .8rem 1rem; border-top: 1px solid var(--f-line2); text-decoration: none; }
  .f-sec-row:first-child { border-top: 0; }
  .f-sec-row:hover { background: var(--f-bg2); }
  .f-sec-head { font-size: .75rem; text-transform: uppercase; letter-spacing: 1px; color: var(--f-dim); padding: .5rem 1rem; }
  .f-sec-icon { font-size: 1.6rem; text-align: center; }
  .f-sec-title { font-weight: 700; color: var(--f-text); font-size: 1.02rem; }
  .f-sec-desc { color: var(--f-muted); font-size: .85rem; }
  .f-sec-cnt { font-size: .82rem; color: var(--f-muted); text-align: center; line-height: 1.4; }
  .f-sec-cnt b { color: var(--f-text); }
  .f-sec-last { font-size: .8rem; color: var(--f-muted); overflow: hidden; }
  .f-sec-last span { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .f-sec-last b { color: var(--f-text); font-weight: 600; }
  .f-sec-mini { display: flex; flex-direction: column; }
  .f-sec-mini a { display: flex; justify-content: space-between; gap: 8px; padding: 6px 0; border-top: 1px dashed var(--f-line2); text-decoration: none; font-size: .9rem; }
  .f-sec-mini a:first-child { border-top: 0; }
  .f-sec-mini small { color: var(--f-dim); white-space: nowrap; }

  /* список тем раздела (WAP-строки) */
  .f-rows { background: var(--f-bg); border: 1px solid var(--f-line); border-radius: var(--f-radius); overflow: hidden; }
  .f-row { display: grid; grid-template-columns: minmax(0, 1fr) 90px minmax(0, 190px); gap: 12px; padding: .7rem 1rem; border-top: 1px solid var(--f-line2); align-items: center; }
  .f-row:first-child { border-top: 0; }
  .f-row-title { font-weight: 700; text-decoration: none; color: var(--f-text) !important; }
  .f-row-title:hover { color: var(--f-acc) !important; }
  .f-row-meta { font-size: .78rem; color: var(--f-muted); margin-top: 3px; display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
  .f-row-cnt { font-size: .8rem; color: var(--f-muted); text-align: center; }
  .f-row-last { font-size: .78rem; color: var(--f-muted); }
  .f-pager { display: flex; justify-content: center; gap: 8px; margin: 1.2rem 0; }

  /* компактный режим */
  .f-compact .f-card { padding: .55rem .8rem; border-radius: 8px; }
  .f-compact .f-feed { gap: 4px; }
  .f-compact .f-card-excerpt, .f-compact .f-card-cover { display: none; }
  .f-compact .f-card { display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "title foot" "head foot"; align-items: center; column-gap: 10px; }
  .f-compact .f-card-link { grid-area: title; }
  .f-compact .f-card-head { grid-area: head; font-size: .75rem; }
  .f-compact .f-card-foot { grid-area: foot; margin: 0; }
  .f-compact .f-card-title { font-size: 1rem !important; margin: 0; }
  .f-compact .f-card-title::before { content: "» "; color: var(--f-red); }
  .f-compact .f-cc-word { display: none; }
  .f-compact .f-post-body { font-size: .95rem; }

  /* тема */
  .f-post { background: var(--f-bg); border: 1px solid var(--f-line); border-radius: var(--f-radius); padding: 1.3rem 1.5rem; }
  .f-post-title { font-family: var(--font-body) !important; letter-spacing: 0 !important; font-size: 2rem; line-height: 1.2; margin: .6rem 0 1rem; color: var(--f-text) !important; }
  .f-post-cover { margin: 0 -1.5rem 1rem; }
  .f-post-cover img { width: 100%; max-height: 520px; object-fit: cover; display: block; }
  .f-post-body { font-size: 1.05rem; line-height: 1.7; overflow-wrap: anywhere; }
  .f-post-body h2, .f-post-body h3, .f-post-body h4 { font-family: var(--font-body) !important; letter-spacing: 0 !important; margin: 1.4em 0 .5em; color: var(--f-text) !important; }
  .f-post-body p { margin: 0 0 1em; }
  .f-post-body a { color: var(--f-acc) !important; }
  .f-post-body img { max-width: 100%; height: auto; border-radius: 8px; }
  .f-post-body figure { margin: 1.2em 0; text-align: center; }
  .f-post-body figcaption { font-size: .85rem; color: var(--f-muted); margin-top: .4em; }
  .f-post-body blockquote { margin: 1em 0; padding: .6em 1em; border-left: 3px solid var(--f-acc); background: var(--f-bg2); border-radius: 0 8px 8px 0; color: var(--f-muted); }
  .f-post-body pre { background: #0008; padding: .8em 1em; border-radius: 8px; overflow-x: auto; font-size: .88rem; }
  .f-post-body code { background: #0006; padding: .1em .35em; border-radius: 4px; font-size: .9em; }
  .forum.f-light .f-post-body pre, .forum.f-light .f-post-body code { background: #e8dccb; }
  .f-spoiler { background: var(--f-text); color: transparent; border-radius: 4px; cursor: pointer; padding: 0 3px; }
  .f-spoiler.open { background: var(--f-bg2); color: inherit; }
  .f-yt { position: relative; aspect-ratio: 16/9; background: #000; border-radius: 10px; overflow: hidden; margin: 1em 0; cursor: pointer; }
  .f-yt img { width: 100%; height: 100%; object-fit: cover; opacity: .85; }
  .f-yt iframe { width: 100%; height: 100%; border: 0; }
  .f-yt-play { position: absolute; inset: 0; margin: auto; width: 72px; height: 50px; border-radius: 12px; border: 0; background: rgba(225,29,72,.9); color: #fff; font-size: 1.4rem; cursor: pointer; }
  .f-sig { margin-top: 1.2rem; padding-top: .6rem; border-top: 1px dashed var(--f-line2); font-size: .82rem; color: var(--f-dim); font-style: italic; }
  .f-actions { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; margin-top: 1rem; }
  .f-link { background: none; border: 0; padding: 2px 4px; color: var(--f-muted); cursor: pointer; font: inherit; font-size: .82rem; text-decoration: none; }
  .f-link:hover { color: var(--f-acc); }
  .f-link-danger:hover { color: var(--f-red); }
