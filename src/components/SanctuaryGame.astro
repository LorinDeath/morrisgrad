    // --- RAYCAST HOVER CHECK ---
    function checkRaycastHover() {
      if (!raycaster || !camera || !relicsGroup) return;

      const inspectHint = document.getElementById('inspect-hint');
      const crosshair = document.getElementById('crosshair');

      raycaster.setFromCamera(mousePos || new THREE.Vector2(0, 0), camera);

      // 1. Check Relics
      const relicHits = raycaster.intersectObjects(relicsGroup.children, true);
      if (relicHits.length > 0 && relicHits[0].distance < 14.0) {
        let hit = relicHits[0].object;
        while (hit && !hit.userData?.isRelic && hit.parent) {
          hit = hit.parent;
        }
        if (hit && hit.userData?.relicData) {
          const r = hit.userData.relicData;
          if (!r.discovered) {
            hoveredRelic = r;
            hoveredNPC = null;
            if (inspectHint) {
              inspectHint.style.display = 'block';
              inspectHint.textContent = `[Клик / E] Собрать: ${r.name}`;
            }
            if (crosshair) crosshair.classList.add('inspecting');
            return;
          }
        }
      }

      // 2. Check NPCs
      if (npcGroup) {
        const npcHits = raycaster.intersectObjects(npcGroup.children, true);
        if (npcHits.length > 0 && npcHits[0].distance < 9.0) {
          let hit = npcHits[0].object;
          while (hit && !hit.userData?.isNPC && hit.parent) {
            hit = hit.parent;
          }
          if (hit && hit.userData?.npcData) {
            hoveredNPC = hit.userData.npcData;
            hoveredRelic = null;
            if (inspectHint) {
              inspectHint.style.display = 'block';
              inspectHint.textContent = `[Клик / E] Поговорить: ${hoveredNPC.name} (${hoveredNPC.title})`;
            }
            if (crosshair) crosshair.classList.add('inspecting');
            return;
          }
        }
      }

      hoveredRelic = null;
      hoveredNPC = null;
      if (inspectHint) inspectHint.style.display = 'none';
      if (crosshair) crosshair.classList.remove('inspecting');
    }

    // --- INPUT HANDLERS SETUP ---
    function setupInputHandlers(canvas: HTMLCanvasElement) {
      // 1. Keyboard
      window.addEventListener('keydown', (e) => {
        keys[e.code] = true;
        if (e.code === 'Space') {
          doJump();
          e.preventDefault();
        } else if (e.code === 'KeyZ') {
          isZoomed = true;
        } else if (e.code === 'KeyH') {
          triggerFireflyGuide();
        } else if (e.code === 'KeyC') {
          toggleCameraMode();
        } else if (e.code === 'KeyJ') {
          modalJournal?.classList.add('active');
        } else if (e.code === 'KeyP') {
          togglePhotoMode();
        } else if (e.code === 'KeyO') {
          modalSettings?.classList.add('active');
        } else if (e.code === 'KeyM') {
          toggleAmbiance();
        } else if (e.code === 'KeyE') {
          checkInteractionClick();
        } else if (e.code === 'Escape') {
          closeModals();
        }
      });

      window.addEventListener('keyup', (e) => {
        keys[e.code] = false;
        if (e.code === 'KeyZ') {
          isZoomed = false;
        }
      });

      // 2. Mouse / Canvas Controls
      let dragStartX = 0, dragStartY = 0;
      canvas.addEventListener('mousedown', (e) => {
        if (e.button === 2) {
          isZoomed = true;
          e.preventDefault();
          return;
        }
        if (e.button === 0) {
          isMouseDown = true;
          lastMouseX = e.clientX;
          lastMouseY = e.clientY;
          dragStartX = e.clientX;
          dragStartY = e.clientY;
        }
      });

      window.addEventListener('mouseup', (e) => {
        if (e.button === 2) {
          isZoomed = false;
        }
        if (e.button === 0) {
          isMouseDown = false;
          const movedDist = Math.hypot(e.clientX - dragStartX, e.clientY - dragStartY);
          if (movedDist < 6) {
            checkInteractionClick();
          }
        }
      });

      canvas.addEventListener('contextmenu', (e) => e.preventDefault());

      window.addEventListener('mousemove', (e) => {
        if (cameraMode === 'walk' && isMouseDown) {
          const dx = e.clientX - lastMouseX;
          const dy = e.clientY - lastMouseY;
          lastMouseX = e.clientX;
          lastMouseY = e.clientY;
          playerYaw -= dx * 0.0035;
          playerPitch = Math.max(-1.3, Math.min(1.3, playerPitch - dy * 0.0032));
        }
      });

      // 3. Touch Drag Look on Canvas
      let activeTouchId: number | null = null;
      let touchStartX = 0, touchStartY = 0;
      canvas.addEventListener('touchstart', (e) => {
        if (e.touches.length > 0 && activeTouchId === null) {
          const t = e.touches[0];
          activeTouchId = t.identifier;
          lastMouseX = t.clientX;
          lastMouseY = t.clientY;
          touchStartX = t.clientX;
          touchStartY = t.clientY;
          isMouseDown = true;
        }
      }, { passive: false });

      window.addEventListener('touchmove', (e) => {
        if (isMouseDown && cameraMode === 'walk') {
          for (let i = 0; i < e.touches.length; i++) {
            const t = e.touches[i];
            if (t.identifier === activeTouchId) {
              const dx = t.clientX - lastMouseX;
              const dy = t.clientY - lastMouseY;
              lastMouseX = t.clientX;
              lastMouseY = t.clientY;
              playerYaw -= dx * 0.004;
              playerPitch = Math.max(-1.3, Math.min(1.3, playerPitch - dy * 0.0035));
              break;
            }
          }
        }
      }, { passive: true });

      window.addEventListener('touchend', (e) => {
        for (let i = 0; i < e.changedTouches.length; i++) {
          if (e.changedTouches[i].identifier === activeTouchId) {
            isMouseDown = false;
            activeTouchId = null;
            const movedDist = Math.hypot(e.changedTouches[i].clientX - touchStartX, e.changedTouches[i].clientY - touchStartY);
            if (movedDist < 10) {
              checkInteractionClick();
            }
            break;
          }
        }
      });

      // 4. Mobile Virtual Joystick
      const joystickZone = document.getElementById('mobile-joystick-zone');
      const joystickHandle = document.getElementById('joystick-handle');
      if (joystickZone && joystickHandle) {
        let joyTouchId: number | null = null;
        let joyCenterX = 0, joyCenterY = 0;

        joystickZone.addEventListener('touchstart', (e) => {
          if (e.touches.length > 0 && joyTouchId === null) {
            const t = e.touches[0];
            joyTouchId = t.identifier;
            const rect = joystickZone.getBoundingClientRect();
            joyCenterX = rect.left + rect.width / 2;
            joyCenterY = rect.top + rect.height / 2;
            e.stopPropagation();
          }
        }, { passive: false });

        window.addEventListener('touchmove', (e) => {
          if (joyTouchId !== null) {
            for (let i = 0; i < e.touches.length; i++) {
              const t = e.touches[i];
              if (t.identifier === joyTouchId) {
                const maxRadius = 38;
                let dx = t.clientX - joyCenterX;
                let dy = t.clientY - joyCenterY;
                const dist = Math.hypot(dx, dy);
                if (dist > maxRadius) {
                  dx = (dx / dist) * maxRadius;
                  dy = (dy / dist) * maxRadius;
                }
                joystickHandle.style.transform = `translate(${dx}px, ${dy}px)`;
                joystickVector.x = dx / maxRadius;
                joystickVector.y = dy / maxRadius;
                break;
              }
            }
          }
        }, { passive: true });

        const resetJoy = () => {
          joyTouchId = null;
          joystickHandle.style.transform = 'translate(0px, 0px)';
          joystickVector.x = 0;
          joystickVector.y = 0;
        };
        window.addEventListener('touchend', resetJoy);
        window.addEventListener('touchcancel', resetJoy);
      }

      // 5. Tool Belt Buttons
      btnToolJump?.addEventListener('click', () => doJump());
      btnToolZoom?.addEventListener('click', () => {
        isZoomed = !isZoomed;
        playTone(isZoomed ? 600 : 400, 0.05, 'sine');
      });
      btnToolFirefly?.addEventListener('click', () => triggerFireflyGuide());
      btnToolCam?.addEventListener('click', () => toggleCameraMode());
      btnToolJournal?.addEventListener('click', () => modalJournal?.classList.add('active'));

      // 6. Window Resize Handler
      window.addEventListener('resize', () => {
        if (!renderer || !camera) return;
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
      });
    }

    // --- MAIN RENDER / ANIMATION LOOP ---
    let lastTime = performance.now();

    function animate(now: number) {
      requestAnimationFrame(animate);

      if (!renderer || !scene || !camera) return;

      try {
        const delta = Math.min((now - lastTime) / 1000, 0.1);
        lastTime = now;

        // 1. Move Player in Walk Mode
        if (cameraMode === 'walk') {
          const foundCount = RELICS_DATA.filter(r => r.discovered).length;
          const relicSpeedBonus = 1.0 + (foundCount * 0.025); // +2.5% per relic found
          let curSpeedMult = relicSpeedBonus;
          if (playerSpeedBuffTimer > 0) {
            playerSpeedBuffTimer -= delta;
            curSpeedMult *= playerSpeedBuff;
          }
          const baseSpeed = isZoomed ? 4.8 : 8.8;
          const speed = baseSpeed * curSpeedMult;
          let moveX = 0;
          let moveZ = 0;

          if (keys['Space']) {
            doJump();
          }

          if (keys['KeyW'] || keys['ArrowUp']) moveZ -= 1;
          if (keys['KeyS'] || keys['ArrowDown']) moveZ += 1;
          if (keys['KeyA'] || keys['ArrowLeft']) moveX -= 1;
          if (keys['KeyD'] || keys['ArrowRight']) moveX += 1;

          moveX += joystickVector.x;
          moveZ += joystickVector.y;

          if (moveX !== 0 || moveZ !== 0) {
            const angle = Math.atan2(moveX, moveZ);
            const totalSpeed = speed * delta;
            const forward = new THREE.Vector3(
              Math.sin(playerYaw + angle),
              0,
              Math.cos(playerYaw + angle)
            );

            const curGround = getTerrainHeight(playerPos.x, playerPos.z);
            const targetStepX = forward.x * totalSpeed;
            const targetStepZ = forward.z * totalSpeed;
            const nextX = playerPos.x + targetStepX;
            const nextZ = playerPos.z + targetStepZ;
            const nextGround = getTerrainHeight(nextX, nextZ);

            // Probe ahead 0.6m in movement direction to detect near-vertical cliff walls
            const probeDist = 0.6;
            const probeX = playerPos.x + forward.x * probeDist;
            const probeZ = playerPos.z + forward.z * probeDist;
            const probeGround = getTerrainHeight(probeX, probeZ);
            const probeRise = probeGround - curGround;

            // Cliff wall stops the player only if steep vertical rise > 0.9m (over 60 degrees)
            const isCliffWall = probeRise > 0.9;
            const canPass = !isCliffWall || (!isGrounded && playerPos.y - EYE_HEIGHT >= nextGround - 0.4);

            if (canPass) {
              playerPos.x = nextX;
              playerPos.z = nextZ;
            } else {
              // Slide along mountain base: test X and Z separately
              const probeXOnly = playerPos.x + forward.x * probeDist;
              const riseX = getTerrainHeight(probeXOnly, playerPos.z) - curGround;
              if (riseX <= 0.9) {
                playerPos.x = nextX;
              }

              const probeZOnly = playerPos.z + forward.z * probeDist;
              const riseZ = getTerrainHeight(playerPos.x, probeZOnly) - curGround;
              if (riseZ <= 0.9) {
                playerPos.z = nextZ;
              }
            }

            // Resolve collision with trees, boulders, and obstacles (capsule radius 0.35)
            resolveColliders(playerPos, 0.35);

            // Smooth push with NPCs so neither clips through the other
            for (const npc of forestNPCs) {
              if (!npc.model) continue;
              const dx = playerPos.x - npc.pos.x;
              const dz = playerPos.z - npc.pos.z;
              const d = Math.hypot(dx, dz);
              const npcRadius = 0.45 * (npc.scale || 0.8);
              if (d < npcRadius + 0.35 && d > 0.001) {
                const push = (npcRadius + 0.35 - d);
                playerPos.x += (dx / d) * push;
                playerPos.z += (dz / d) * push;
              }
            }
          }

          // STRICT GROUND CLAMP: Player is NEVER allowed to sink under the terrain!
          const groundY = getTerrainHeight(playerPos.x, playerPos.z);
          const targetEyeY = groundY + EYE_HEIGHT;

          if (isGrounded) {
            playerPos.y = targetEyeY;
            playerVerticalVelocity = 0;
          } else {
            // Airborne jump / gravity fall
            playerVerticalVelocity -= GRAVITY * delta;
            playerPos.y += playerVerticalVelocity * delta;

            if (playerPos.y <= targetEyeY) {
              playerPos.y = targetEyeY;
              playerVerticalVelocity = 0;
              isGrounded = true;
              playTone(180, 0.05, 'triangle', 0.15); // soft landing thump
            }
          }

          camera.position.set(playerPos.x, playerPos.y, playerPos.z);
          camera.rotation.order = 'YXZ';
          camera.rotation.y = playerYaw;
          camera.rotation.x = playerPitch;

          if (compassNeedle) {
            const deg = (playerYaw * (180 / Math.PI)) % 360;
            compassNeedle.style.transform = `translateX(-50%) rotate(${deg}deg)`;
          }

          // Active Compass Relic Ping Radar
          if (compassRelicPing) {
            let closestRelic: RelicDef | null = null;
            let closestDist = 999999;
            for (const r of RELICS_DATA) {
              if (r.discovered) continue;
              const d = Math.hypot(r.pos[0] - playerPos.x, r.pos[2] - playerPos.z);
              if (d < closestDist) {
                closestDist = d;
                closestRelic = r;
              }
            }

            if (closestRelic && closestDist < 300) {
              compassRelicPing.style.opacity = Math.max(0.3, 1.0 - closestDist / 300).toFixed(2);
              const angleToRelic = Math.atan2(closestRelic.pos[0] - playerPos.x, closestRelic.pos[2] - playerPos.z);
              let relAngle = angleToRelic - playerYaw;
              while (relAngle < -Math.PI) relAngle += Math.PI * 2;
              while (relAngle > Math.PI) relAngle -= Math.PI * 2;
              const px = 50 + (relAngle / Math.PI) * 45;
              compassRelicPing.style.left = `${Math.max(5, Math.min(95, px))}%`;
            } else {
              compassRelicPing.style.opacity = '0';
            }
          }

          // Detect Biome Transition & Trigger Banner
          const activeBiome = getBiome(playerPos.x, playerPos.z);
          if (activeBiome !== currentBiome) {
            currentBiome = activeBiome;
            onBiomeChanged(activeBiome);
          }
        } else if (controls && controls.enabled) {
          controls.update();
        }

        // Smooth Zoom transition
        const targetFov = isZoomed ? 28 : 65;
        camera.fov += (targetFov - camera.fov) * 0.15;
        camera.updateProjectionMatrix();

        // Keep sky dome centered on camera at all times (eliminates black sphere artifact)
        if (skyMesh) {
          skyMesh.position.set(camera.position.x, camera.position.y - 10, camera.position.z);
        }

        // Infinite Minecraft-style Chunk Update
        updateChunks();

        // 2. Animate Relics (Floating & Bobbing & Beacon Pulse)
        if (relicsGroup) {
          relicsGroup.children.forEach((relicObj: any, idx: number) => {
            if (relicObj.visible && relicObj.userData?.coreMesh) {
              const timeOffset = now * 0.002 + idx;
              relicObj.position.y = relicObj.userData.initialY + Math.sin(timeOffset) * 0.16;
              relicObj.userData.coreMesh.rotation.y += 0.015;
              if (relicObj.userData.haloMesh) {
                relicObj.userData.haloMesh.rotation.z += 0.02;
              }
            }
          });
        }

        // Animate Campfire light flickering
        for (const cf of campfiresList) {
          cf.light.intensity = cf.baseIntensity + Math.sin(now * 0.01 + cf.timeOffset) * 0.35 + (Math.random() - 0.5) * 0.15;
        }

        // Animate Rubber Ducks floating on river
        for (const dp of duckPropsList) {
          dp.sprite.position.y = dp.baseY + Math.sin(now * 0.003 + dp.timeOffset) * 0.08;
        }

        // Dynamic sun shadow centering on player
        if (dirLight && cameraMode === 'walk') {
          dirLight.position.set(playerPos.x + 35, 60, playerPos.z + 25);
          dirLight.target.position.set(playerPos.x, playerPos.y, playerPos.z);
          dirLight.target.updateMatrixWorld();
        }

        // Drift Fluffy Clouds across the Sky Dome
        for (const cl of skyCloudsList) {
          cl.sprite.position.x += cl.speed * delta;
          if (cl.sprite.position.x - playerPos.x > 320) {
            cl.sprite.position.x -= 640;
          }
        }

        // --- DYNAMIC RANDOM WORLD EVENTS (Every 60-80s) ---
        worldEventTimer -= delta;
        if (worldEventTimer <= 0) {
          worldEventTimer = 65.0 + Math.random() * 25.0;
          const eventRoll = Math.random();

          if (eventRoll < 0.32) {
            // EVENT 1: METEOR SHOWER / STARFALL
            activeEvent = 'METEOR_SHOWER';
            playHarmonicChime(783.99);
            setTimeout(() => playHarmonicChime(1046.50), 180);
            showWhisper('🌠 ЗВЕЗДОПАД! На холме рощи упала яркая звезда — найдите её осколок!');

            // Spawn Starlight Blessing on ground ahead
            if (starlightPickup && meteorShowerGroup) meteorShowerGroup.remove(starlightPickup);
            const ang = playerYaw + (Math.random() - 0.5) * 0.8;
            const starX = playerPos.x + Math.sin(ang) * 28;
            const starZ = playerPos.z + Math.cos(ang) * 28;
            const starY = getTerrainHeight(starX, starZ);

            starlightPickup = new THREE.Group();
            starlightPickup.position.set(starX, starY + 0.8, starZ);
            const starSpr = createTinySwordsProp(THREE, '/Tiny Swords/Terrain/Resources/Gold/Gold Stones/Gold Stone 4_Highlight.png', 2.2, 2.2, 0.4, false);
            starlightPickup.add(starSpr);
            const starLt = new THREE.PointLight(0xfff088, 2.0, 10);
            starlightPickup.add(starLt);
            starlightPickup.userData = { isStarlight: true, expireTimer: 55.0 };
            meteorShowerGroup.add(starlightPickup);

          } else if (eventRoll < 0.65) {
            // EVENT 2: SPORE AWAKENING / FAIRY DANCE
            activeEvent = 'SPORE_DANCE';
            playHarmonicChime(659.25);
            playerSpeedBuff = 1.45;
            playerSpeedBuffTimer = 45.0;
            showWhisper('🍃 ТАНЕЦ ДУХОВ: Ветер наполнился волшебной пыльцой (+45% к скорости бега и легкий прыжок)!');

          } else {
            // EVENT 3: FACTION DUEL SKIRMISH
            activeEvent = 'SKIRMISH';
            playSwordClang();
            setTimeout(() => playSwordClang(), 220);
            showWhisper('⚔️ СТЫЧКА ЧЕМПИОНОВ: Воины рощи сошлись в поединке чести у границы биома!');
          }
        }

        // Check Starlight Shard pickup
        if (starlightPickup && meteorShowerGroup) {
          starlightPickup.userData.expireTimer -= delta;
          starlightPickup.rotation.y += 0.03;
          const dToStar = Math.hypot(playerPos.x - starlightPickup.position.x, playerPos.z - starlightPickup.position.z);
          if (dToStar < 2.5) {
            meteorShowerGroup.remove(starlightPickup);
            starlightPickup = null;
            playerSpeedBuff = 1.55;
            playerSpeedBuffTimer = 50.0;
            playRelicFanfare();
            showWhisper('✨ Вы подобрали Осколок Звезды: Скорость +55% на 50 секунд и чутье на реликвии!');
          } else if (starlightPickup.userData.expireTimer <= 0) {
            meteorShowerGroup.remove(starlightPickup);
            starlightPickup = null;
          }
        }

        // 3. Update KayKit NPCs (patrol & gentle passing)
        updateNPCs(delta, playerPos, THREE);

        // 4. Animate Floating Magical Spores & Fireflies (following player view)
        if (particlesGroup) {
          particlesGroup.position.set(playerPos.x, 0, playerPos.z);
          const positions = particlesGroup.geometry.attributes.position.array;
          for (let i = 0; i < positions.length; i += 3) {
            positions[i] += Math.sin(now * 0.0008 + i) * 0.01;
            positions[i + 1] += Math.sin(now * 0.0012 + i) * 0.015;
            positions[i + 2] += Math.cos(now * 0.0008 + i) * 0.01;
            if (positions[i + 1] > 18) positions[i + 1] = 0.5;
            if (positions[i + 1] < 0.3) positions[i + 1] = 16;
          }
          particlesGroup.geometry.attributes.position.needsUpdate = true;
        }

        // 5. Raycast check for hover
        checkRaycastHover();

        // 6. Render
        renderer.render(scene, camera);
      } catch (err) {
        console.error('Render loop error:', err);
      }
    }
  }
</script>
