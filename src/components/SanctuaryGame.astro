    function fade(t: number) { return t * t * t * (t * (t * 6 - 15) + 10); }
    function lerp(t: number, a: number, b: number) { return a + t * (b - a); }
    function grad(hash: number, x: number, y: number) {
      const h = hash & 7;
      const u = h < 4 ? x : y;
      const v = h < 4 ? y : x;
      return ((h & 1) === 0 ? u : -u) + ((h & 2) === 0 ? v : -v);
    }
    function perlin2D(x: number, y: number): number {
      const X = Math.floor(x) & 255;
      const Y = Math.floor(y) & 255;
      const xf = x - Math.floor(x);
      const yf = y - Math.floor(y);
      const u = fade(xf);
      const v = fade(yf);
      const aa = permTable[permTable[X] + Y];
      const ab = permTable[permTable[X] + Y + 1];
      const ba = permTable[permTable[X + 1] + Y];
      const bb = permTable[permTable[X + 1] + Y + 1];
      return lerp(v, lerp(u, grad(aa, xf, yf), grad(ba, xf - 1, yf)), lerp(u, grad(ab, xf, yf - 1), grad(bb, xf - 1, yf - 1)));
    }
    function fbm(x: number, y: number, octaves = 3): number {
      let val = 0, amp = 1, freq = 1, totalAmp = 0;
      for (let i = 0; i < octaves; i++) {
        val += perlin2D(x * freq, y * freq) * amp;
        totalAmp += amp;
        amp *= 0.5;
        freq *= 2.0;
      }
      return val / totalAmp;
    }

    function getBiome(x: number, z: number): BiomeType {
      const dist = Math.hypot(x, z - 18);
      if (dist < 70) return 'MEADOW';

      const sOffX = ((worldSeed * 37) % 3000) - 1500;
      const sOffZ = ((worldSeed * 73) % 3000) - 1500;

      const temp = fbm((x + sOffX) * 0.00085 + 120, (z + sOffZ) * 0.00085 + 120, 2);
      const moist = fbm((x + sOffX) * 0.00085 - 120, (z + sOffZ) * 0.00085 - 120, 2);
      const weird = fbm((x + sOffX) * 0.00075 + 350, (z + sOffZ) * 0.00075 - 350, 2);
      const riverVal = Math.abs(fbm((x + sOffX) * 0.0011, (z + sOffZ) * 0.0011, 2));

      if (riverVal < 0.04) return 'RIVER_VALLEY';
      if (weird > 0.17) return 'DEAD_FOREST';
      if (temp > 0.08 && moist > 0.08) return 'FAIRY_GLADE';
      if (temp > 0.02 && moist <= 0.08) return 'MEADOW';
      if (temp < -0.03 && moist >= -0.16) return 'TAIGA';
      if (moist > 0.12) return 'MYSTIC_GROVE';
      return 'CRAGS';
    }

    function getTerrainHeight(x: number, z: number): number {
      const sOffX = ((worldSeed * 37) % 3000) - 1500;
      const sOffZ = ((worldSeed * 73) % 3000) - 1500;

      let h = fbm((x + sOffX) * 0.0055, (z + sOffZ) * 0.0055, 3) * 6.5;
      h += fbm((x + sOffX) * 0.014 + 100, (z + sOffZ) * 0.014 + 100, 2) * 2.2;

      const cragWeight = Math.max(0, Math.min(1, (fbm((x + sOffX) * 0.004 + 250, (z + sOffZ) * 0.004 + 250, 2) - 0.05) * 4.0));
      if (cragWeight > 0) {
        h += cragWeight * 5.5;
      }

      const riverNoise = Math.abs(fbm((x + sOffX) * 0.006 - 150, (z + sOffZ) * 0.006 - 150, 2));
      if (riverNoise < 0.08) {
        const riverDepth = (1.0 - riverNoise / 0.08);
        h -= riverDepth * riverDepth * 2.2;
      }

      const centerDist = Math.hypot(x, z - 18);
      if (centerDist < 20) {
        const factor = centerDist / 20;
        h *= (factor * factor);
      }

      return h * hillAmplitudeMultiplier;
    }

    // --- COLLISION SYSTEM: CIRCLE COLLIDERS FOR OBJECTS ---
    interface WorldCollider {
      x: number;
      z: number;
      radius: number;
    }
    const worldColliders: WorldCollider[] = [];

    function resolveColliders(pos: { x: number; z: number }, radius = 0.35): void {
      for (let iter = 0; iter < 3; iter++) {
        let collided = false;
        for (let i = 0; i < worldColliders.length; i++) {
          const col = worldColliders[i];
          const dx = pos.x - col.x;
          const dz = pos.z - col.z;
          const minDist = col.radius + radius;
          const distSq = dx * dx + dz * dz;

          if (distSq < minDist * minDist && distSq > 0.00001) {
            const dist = Math.sqrt(distSq);
            const overlap = minDist - dist;
            pos.x += (dx / dist) * overlap;
            pos.z += (dz / dist) * overlap;
            collided = true;
          }
        }
        if (!collided) break;
      }
    }

    // Lush Painterly Ghibli-Style Grass Texture (Smooth strokes, zero spotted polka-dots)
    function createStylizedGrassTexture(THREE: any) {
      const canvas = document.createElement('canvas');
      canvas.width = 1024;
      canvas.height = 1024;
      const ctx = canvas.getContext('2d');
      if (!ctx) return new THREE.MeshStandardMaterial({ color: 0x3d6837 });

      // 1. Base vibrant meadow gradient
      const baseGrad = ctx.createRadialGradient(512, 512, 60, 512, 512, 720);
      baseGrad.addColorStop(0, '#3f7035');
      baseGrad.addColorStop(0.5, '#38652f');
      baseGrad.addColorStop(1, '#315928');
      ctx.fillStyle = baseGrad;
      ctx.fillRect(0, 0, 1024, 1024);

      // 2. Broad organic watercolor wash patches (eliminates mechanical patterns)
      for (let i = 0; i < 90; i++) {
        const px = Math.random() * 1024;
        const py = Math.random() * 1024;
        const pr = Math.random() * 140 + 40;
        const pGrad = ctx.createRadialGradient(px, py, 0, px, py, pr);
        const hue = Math.random();
        if (hue < 0.35) {
          pGrad.addColorStop(0, 'rgba(38, 68, 29, 0.42)');
          pGrad.addColorStop(1, 'rgba(38, 68, 29, 0)');
        } else if (hue < 0.72) {
          pGrad.addColorStop(0, 'rgba(74, 128, 60, 0.38)');
          pGrad.addColorStop(1, 'rgba(74, 128, 60, 0)');
        } else {
          pGrad.addColorStop(0, 'rgba(52, 94, 42, 0.32)');
          pGrad.addColorStop(1, 'rgba(52, 94, 42, 0)');
        }
        ctx.fillStyle = pGrad;
        ctx.beginPath();
        ctx.arc(px, py, pr, 0, Math.PI * 2);
        ctx.fill();
      }

      // 3. Delicate slanted painterly grass blade strokes
      ctx.lineCap = 'round';
      for (let i = 0; i < 4800; i++) {
        const bx = Math.random() * 1024;
        const by = Math.random() * 1024;
        const bladeLen = Math.random() * 12 + 6;
        const slant = (Math.random() - 0.5) * 6;
        const seed = Math.random();

        if (seed < 0.38) {
          ctx.strokeStyle = 'rgba(78, 140, 64, 0.48)';
          ctx.lineWidth = Math.random() * 2 + 1;
        } else if (seed < 0.75) {
          ctx.strokeStyle = 'rgba(44, 80, 35, 0.52)';
          ctx.lineWidth = Math.random() * 2 + 1;
        } else {
          ctx.strokeStyle = 'rgba(105, 172, 88, 0.35)';
          ctx.lineWidth = Math.random() * 1.5 + 0.8;
        }

        ctx.beginPath();
        ctx.moveTo(bx, by);
        ctx.quadraticCurveTo(bx + slant * 0.5, by - bladeLen * 0.6, bx + slant, by - bladeLen);
        ctx.stroke();
      }

      // 4. Subtle tiny wildflower petals (soft specks of daisy ivory, buttercup yellow, pale blue)
      for (let i = 0; i < 380; i++) {
        const fx = Math.random() * 1024;
        const fy = Math.random() * 1024;
        const fKind = Math.random();
        if (fKind < 0.45) {
          ctx.fillStyle = 'rgba(255, 248, 220, 0.55)';
        } else if (fKind < 0.8) {
          ctx.fillStyle = 'rgba(255, 218, 90, 0.5)';
        } else {
          ctx.fillStyle = 'rgba(180, 210, 255, 0.45)';
        }
        ctx.beginPath();
        ctx.arc(fx, fy, Math.random() * 1.6 + 1.0, 0, Math.PI * 2);
        ctx.fill();
      }

      const tex = new THREE.CanvasTexture(canvas);
      tex.wrapS = THREE.RepeatWrapping;
      tex.wrapT = THREE.RepeatWrapping;
      tex.repeat.set(10, 10);
      tex.anisotropy = 8;
      tex.needsUpdate = true;
      return tex;
    }

    // Soft Radial Aura Texture for Magical Fireflies & Forest Dust (No square pixels!)
    function createSparkleTexture(THREE: any) {
      const canvas = document.createElement('canvas');
      canvas.width = 64;
      canvas.height = 64;
      const ctx = canvas.getContext('2d');
      if (!ctx) return null;

      const grad = ctx.createRadialGradient(32, 32, 0, 32, 32, 32);
      grad.addColorStop(0, 'rgba(255, 255, 255, 1.0)');
      grad.addColorStop(0.25, 'rgba(255, 238, 140, 0.85)');
      grad.addColorStop(0.55, 'rgba(255, 190, 50, 0.35)');
      grad.addColorStop(0.8, 'rgba(255, 150, 20, 0.08)');
      grad.addColorStop(1, 'rgba(255, 140, 0, 0)');

      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, 64, 64);

      const tex = new THREE.CanvasTexture(canvas);
      tex.needsUpdate = true;
      return tex;
    }

    // Atmospheric Sky Dome Canvas Gradient with Zenith-to-Horizon Haze & Stars
    function createSkyTexture(THREE: any, topColor: string, midColor: string, horizColor: string, addStars = false) {
      const canvas = document.createElement('canvas');
      canvas.width = 512;
      canvas.height = 512;
      const ctx = canvas.getContext('2d');
      if (!ctx) return null;

      const grad = ctx.createLinearGradient(0, 0, 0, 512);
      grad.addColorStop(0, topColor);
      grad.addColorStop(0.55, midColor);
      grad.addColorStop(1, horizColor);
      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, 512, 512);

      if (addStars) {
        for (let i = 0; i < 240; i++) {
          const sx = Math.random() * 512;
          const sy = Math.random() * 320;
          const sr = Math.random() * 1.4 + 0.4;
          const op = Math.random() * 0.7 + 0.3;
          ctx.fillStyle = `rgba(255, 255, 255, ${op})`;
          ctx.beginPath();
          ctx.arc(sx, sy, sr, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      const tex = new THREE.CanvasTexture(canvas);
      tex.needsUpdate = true;
      return tex;
    }

