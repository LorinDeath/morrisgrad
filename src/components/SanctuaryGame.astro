        playHarmonicChime(523.25);
        setTimeout(() => showMenu(), 1100);
        return;
      }

      // Download missing items
      if (statusText) statusText.textContent = `Загрузка 3D-моделей и текстур (${missingUrls.length} шт.)...`;

      let loadedCount = cachedCount;
