          }
        } catch (err) {
          console.warn('Error loading Rig_Medium animations:', err);
        }
      }
    }

    function chunkHash(cx: number, cz: number, seed: number): number {
      let h = Math.imul(cx ^ 0x45d9f3b, 0x27d4eb2d) ^ Math.imul(cz ^ 0x31b79a5, 0x165667b1) ^ (seed ^ worldSeed);
      h = Math.imul(h ^ (h >>> 15), 0x2c1b3c6d);
      h = Math.imul(h ^ (h >>> 12), 0x297a2d39);
      h = Math.imul(h ^ (h >>> 13), 1274126177);
      return ((h ^ (h >>> 16)) >>> 0) / 4294967296;
    }

    // Helper to transition NPC animation safely
    function setNPCState(npc: ForestNPC, newState: 'PATROL' | 'REST' | 'INSPECT' | 'DUEL' | 'TALKING') {
      if (npc.state === newState) return;
      const prevAction = npc.currentAction;
      npc.state = newState;
      let nextAction = npc.walkAction;

      if (newState === 'PATROL') {
        nextAction = npc.walkAction;
      } else if (newState === 'REST') {
        nextAction = npc.idleAction || npc.walkAction;
      } else if (newState === 'INSPECT') {
        nextAction = npc.attackAction || npc.idleAction || npc.walkAction;
      } else if (newState === 'DUEL') {
        nextAction = npc.idleAction || npc.walkAction;
      } else if (newState === 'TALKING') {
        nextAction = npc.idleAction || npc.walkAction;
      }

      if (prevAction && nextAction && prevAction !== nextAction) {
        prevAction.fadeOut(0.2);
        nextAction.reset().fadeIn(0.2).play();
        npc.currentAction = nextAction;
      }
    }

    // Procedural NPC Spawner with Factions, Combat AI, and Visual Scales
    function spawnProceduralNPC(cx: number, cz: number, chunkNPCs: ForestNPC[], THREE: any) {
      if (!gltfLoaderInstance) return;

      const originX = cx * CHUNK_SIZE;
      const originZ = cz * CHUNK_SIZE;
      const spawnX = originX + chunkHash(cx, cz, 101) * (CHUNK_SIZE - 12) + 6;
      const spawnZ = originZ + chunkHash(cx, cz, 102) * (CHUNK_SIZE - 12) + 6;
      const spawnY = getTerrainHeight(spawnX, spawnZ);

      const sizeRoll = chunkHash(cx, cz, 201);
      let scaleCategory: 'tiny' | 'normal' | 'giant' = 'normal';
      let scale = 0.8;
      let speed = 2.1;

      if (sizeRoll < 0.22) {
        scaleCategory = 'tiny';
        scale = 0.38 + chunkHash(cx, cz, 202) * 0.12;
        speed = 1.8;
      } else if (sizeRoll > 0.78) {
        scaleCategory = 'giant';
        scale = 1.5 + chunkHash(cx, cz, 202) * 0.45;
        speed = 2.3;
      } else {
        scaleCategory = 'normal';
        scale = 0.75 + chunkHash(cx, cz, 202) * 0.14;
        speed = 2.05;
      }

      const charFiles = ['Knight.glb', 'Ranger.glb', 'Mage.glb', 'Barbarian.glb', 'Rogue.glb', 'Rogue_Hooded.glb'];
      const fileIdx = Math.floor(chunkHash(cx, cz, 301) * charFiles.length);
      const chosenFile = charFiles[fileIdx];
      const charBuffer = characterBuffers[chosenFile];
      if (!charBuffer) return;

      // Assign Faction
      let faction: 'blue' | 'red' | 'black' | 'purple' | 'green' = 'blue';
      if (chosenFile.includes('Knight')) faction = 'blue';
      else if (chosenFile.includes('Barbarian')) faction = 'red';
      else if (chosenFile.includes('Rogue')) faction = 'black';
      else if (chosenFile.includes('Mage')) faction = 'purple';
      else if (chosenFile.includes('Ranger')) faction = 'green';

      let name = 'Странник';
      let title = 'Путник';
      let greetMsg = 'Приветствую тебя в заповедных землях!';

      if (scaleCategory === 'tiny') {
        const tinyNames = ['Гномик Финн', 'Крошка Пип', 'Барли Малыш', 'Шустрый Нил', 'Лесная Искорка'];
        const tinyTitles = ['[Гномик]', '[Крошечный Чародей]', '[Юркий Следопыт]', '[Маленький Травник]'];
        const tinyPhrases = [
          'Осторожно, путник! Не наступи на меня — я собираю лесную пыльцу!',
          'Для тебя этот холм — пустяк, а для меня — великая гора!',
          'В роще спрятано 24 священных реликвии! Светлячок на клавишу H чувствует их сияние.'
        ];
        name = tinyNames[Math.floor(chunkHash(cx, cz, 401) * tinyNames.length)];
        title = tinyTitles[Math.floor(chunkHash(cx, cz, 402) * tinyTitles.length)];
        greetMsg = tinyPhrases[Math.floor(chunkHash(cx, cz, 403) * tinyPhrases.length)];
      } else if (scaleCategory === 'giant') {
        const giantNames = ['Голиаф', 'Имир Древний', 'Вульфгар', 'Громобой', 'Торвальд Скалолом'];
        const giantTitles = ['[Лесной Великан]', '[Титан Скал]', '[Исполин Пустошей]', '[Древний Страж]'];
        const giantPhrases = [
          'ГР-Р-М... Твои шаги легки, путник. Я топчу эти холмы уже третье столетие.',
          'Смотри на горизонт — биомы раскинулись на сотни шагов вдаль.',
          'Священные реликвии древней рощи пробуждают силу. Ищи золотые лучи маяков!'
        ];
        name = giantNames[Math.floor(chunkHash(cx, cz, 401) * giantNames.length)];
        title = giantTitles[Math.floor(chunkHash(cx, cz, 402) * giantTitles.length)];
        greetMsg = giantPhrases[Math.floor(chunkHash(cx, cz, 403) * giantPhrases.length)];
      } else {
        const normNames = ['Сэр Роланд', 'Элария', 'Мерлиндис', 'Бранн', 'Снифф', 'Капитан Вальтер', 'Охотник Торн', 'Кеael'];
        const normTitles = ['[Рыцарь Рощи]', '[Охотница]', '[Чародейка]', '[Следопыт]', '[Хранитель Рун]', '[Бродяга]'];
        const normPhrases = [
          'Приветствую! Этот биом огромен — шагай вперед, прислушиваясь к шепоту рощи.',
          'Если встретишь воинов враждующих кланов — держись поодаль, они скрещивают клинки!',
          'Нажми [E], когда подойдешь ближе, и я поделюсь направлением к ближайшей реликвии.'
        ];
        name = normNames[Math.floor(chunkHash(cx, cz, 401) * normNames.length)];
        title = normTitles[Math.floor(chunkHash(cx, cz, 402) * normTitles.length)];
        greetMsg = normPhrases[Math.floor(chunkHash(cx, cz, 403) * normPhrases.length)];
      }

      gltfLoaderInstance.parse(charBuffer.slice(0), '/KayKit/Characters/gltf/', (gltf: any) => {
        try {
          const model = gltf.scene;
          model.scale.set(scale, scale, scale);

          model.traverse((child: any) => {
            if (child.isMesh) {
              child.castShadow = true;
              child.receiveShadow = true;
              if (child.material) {
                child.material.roughness = 0.65;
                child.material.metalness = 0.1;
              }
            }
          });

          const pos = new THREE.Vector3(spawnX, spawnY, spawnZ);
          model.position.copy(pos);

          let mixer = null;
          let walkAction = null;
          let idleAct = null;
          let atkAct = null;
          let hitAct = null;

          if (walkClip) {
            mixer = new THREE.AnimationMixer(model);
            walkAction = mixer.clipAction(walkClip);
            const timeScaleMult = scaleCategory === 'tiny' ? 0.9 : (scaleCategory === 'giant' ? 0.38 : 0.58);
            walkAction.setEffectiveTimeScale(speed * timeScaleMult);
            walkAction.play();

            if (idleClip) idleAct = mixer.clipAction(idleClip);
            if (attackClip) atkAct = mixer.clipAction(attackClip);
            if (hitClip) hitAct = mixer.clipAction(hitClip);
          }

          const wpRadius = 12 + chunkHash(cx, cz, 501) * 10;
          const waypoints = [
            { x: spawnX + wpRadius, z: spawnZ },
            { x: spawnX, z: spawnZ + wpRadius },
            { x: spawnX - wpRadius, z: spawnZ },
            { x: spawnX, z: spawnZ - wpRadius }
          ];

          const npcDataObj: ForestNPC = {
            id: `npc_${cx}_${cz}_${Math.floor(Math.random()*1000)}`,
            name,
            title,
            file: chosenFile,
            faction,
            scale,
            voicePitch: 523,
            model,
            mixer,
            walkAction,
            idleAction: idleAct,
            attackAction: atkAct,
            hitAction: hitAct,
            currentAction: walkAction,
            state: 'PATROL',
            stateTimer: 0,
            duelOpponent: null,
            duelTimer: 0,
            duelRounds: 0,
            duelCooldown: 10 + chunkHash(cx, cz, 606) * 20,
            pos,
            yaw: chunkHash(cx, cz, 601) * Math.PI * 2,
            waypoints,
            currentWp: 0,
            speed,
            greetCooldown: 0,
            greetMsg,
            passOffset: chunkHash(cx, cz, 701) < 0.5 ? 1.0 : -1.0
          };

          model.userData = {
            isNPC: true,
            npcData: npcDataObj
          };

          npcGroup.add(model);
          forestNPCs.push(npcDataObj);
          chunkNPCs.push(npcDataObj);

          const col: WorldCollider = { x: spawnX, z: spawnZ, radius: 0.6 * scale };
          worldColliders.push(col);
        } catch (e) {
          console.warn('Error instantiating chunk NPC:', e);
        }
      });
    }

    // --- INFINITE CHUNK GENERATION WITH VAST BIOMES, TINY SWORDS & SACRED BEACONS ---
    function createChunk(cx: number, cz: number): void {
      const key = `${cx},${cz}`;
      if (activeChunks.has(key)) return;

      const chunkGroup = new THREE.Group();
      const chunkColliders: WorldCollider[] = [];

      // 1. Terrain Mesh for this chunk
      const segs = 20;
      const groundGeo = new THREE.PlaneGeometry(CHUNK_SIZE, CHUNK_SIZE, segs, segs);
      groundGeo.rotateX(-Math.PI / 2);

      const originX = cx * CHUNK_SIZE;
      const originZ = cz * CHUNK_SIZE;
      const centerX = originX + CHUNK_SIZE / 2;
      const centerZ = originZ + CHUNK_SIZE / 2;

      chunkGroup.position.set(centerX, 0, centerZ);

      const posAttr = groundGeo.attributes.position;
      for (let i = 0; i < posAttr.count; i++) {
        const lx = posAttr.getX(i);
        const lz = posAttr.getZ(i);
        const wx = centerX + lx;
        const wz = centerZ + lz;
        posAttr.setY(i, getTerrainHeight(wx, wz));
      }
      groundGeo.computeVertexNormals();

      const chunkGroundMesh = new THREE.Mesh(groundGeo, groundMat);
      chunkGroundMesh.receiveShadow = true;
      chunkGroup.add(chunkGroundMesh);

      // 2. Biome & Flora Generation
      const biome = getBiome(centerX, centerZ);
      let seed = 1;

      // Helper to add 3D Stylized entity to chunk
      const chunkPlacedTrees: { x: number; z: number }[] = [];
      function addChunkObject(modelName: string, wx: number, wz: number, scale: number, isTree: boolean, isRock: boolean) {
        const model = loaded3DModels[modelName];
        if (!model) return;
        const wy = getTerrainHeight(wx, wz);
        const clone = model.clone(true);
        const s = scale * (0.85 + chunkHash(cx, cz, seed++) * 0.3);
        clone.scale.set(s, s, s);
        const yOffset = isTree ? -0.35 : (isRock ? -0.2 : 0);
        clone.position.set(wx - centerX, wy + yOffset, wz - centerZ);
        clone.rotation.y = chunkHash(cx, cz, seed++) * Math.PI * 2;
        chunkGroup.add(clone);

        if (isTree) {
          chunkPlacedTrees.push({ x: wx, z: wz });
          const col: WorldCollider = { x: wx, z: wz, radius: 0.35 * s };
          chunkColliders.push(col);
          worldColliders.push(col);
        } else if (isRock) {
          const col: WorldCollider = { x: wx, z: wz, radius: 0.42 * s };
          chunkColliders.push(col);
          worldColliders.push(col);
        }
      }

      // Helper to place Tiny Swords 2.5D building or landmark
      function addBuilding(relPath: string, wx: number, wz: number, w: number, h: number, colRadius: number) {
        const wy = getTerrainHeight(wx, wz);
        const prop = createTinySwordsProp(THREE, relPath, w, h, 0, true);
        prop.position.set(wx - centerX, wy, wz - centerZ);
        chunkGroup.add(prop);
        const col: WorldCollider = { x: wx, z: wz, radius: colRadius };
        chunkColliders.push(col);
        worldColliders.push(col);
      }

      // 3. Biome-specific Settlements & Atmospheric Tiny Swords Props
      const settlementRoll = chunkHash(cx, cz, 888);
      const isSettlement = settlementRoll < 0.28 && Math.hypot(cx, cz) > 1.2;

      if (biome === 'MEADOW') {
        if (isSettlement) {
          // Blue Faction Hamlet
          addBuilding('/Tiny Swords/Buildings/Blue Buildings/House1.png', centerX - 6, centerZ - 6, 7.0, 7.0, 2.5);
          addBuilding('/Tiny Swords/Buildings/Blue Buildings/Archery.png', centerX + 8, centerZ + 6, 8.0, 7.0, 2.8);
          // Grazing sheep
          for (let i = 0; i < 3; i++) {
            const sx = originX + 10 + i * 9;
            const sz = originZ + 12 + (i % 2) * 8;
            const sy = getTerrainHeight(sx, sz);
            const sheep = createTinySwordsProp(THREE, '/Tiny Swords/Terrain/Resources/Meat/Sheep/Sheep_Idle.png', 1.8, 1.5, 0.4, false);
            sheep.position.set(sx - centerX, sy, sz - centerZ);
            chunkGroup.add(sheep);
          }
          // Gold Stones
          const gx = centerX + 12;
          const gz = centerZ - 10;
          const gy = getTerrainHeight(gx, gz);
          const gold = createTinySwordsProp(THREE, '/Tiny Swords/Terrain/Resources/Gold/Gold Stones/Gold Stone 1.png', 2.0, 1.8, 0.4, false);
          gold.position.set(gx - centerX, gy, gz - centerZ);
          chunkGroup.add(gold);
        }
      } else if (biome === 'TAIGA') {
        if (isSettlement) {
          // Lumberjack Camp & Campfire
          const fx = centerX;
          const fz = centerZ;
          const fy = getTerrainHeight(fx, fz);
          const fireSpr = createTinySwordsProp(THREE, '/Tiny Swords/Particle FX/Fire_01.png', 1.8, 2.0, 0.5, false);
          fireSpr.position.set(fx - centerX, fy, fz - centerZ);
          chunkGroup.add(fireSpr);

          const fireLight = new THREE.PointLight(0xff7722, 1.6, 9);
          fireLight.position.set(fx - centerX, fy + 0.9, fz - centerZ);
          chunkGroup.add(fireLight);
          campfiresList.push({ light: fireLight, baseIntensity: 1.6, timeOffset: cx + cz });

          // Stumps & Wood resource
          const stump = createTinySwordsProp(THREE, '/Tiny Swords/Terrain/Resources/Wood/Trees/Stump 1.png', 1.6, 1.6, 0.3, false);
          stump.position.set(fx - centerX + 3.5, fy, fz - centerZ + 2.5);
          chunkGroup.add(stump);

          const wood = createTinySwordsProp(THREE, '/Tiny Swords/Terrain/Resources/Wood/Wood Resource/Wood Resource.png', 2.6, 2.0, 0.4, false);
          wood.position.set(fx - centerX - 4.5, fy, fz - centerZ - 2.0);
          chunkGroup.add(wood);
        }
      } else if (biome === 'MYSTIC_GROVE') {
        if (isSettlement) {
          // Purple Sanctuary Monastery
          addBuilding('/Tiny Swords/Buildings/Purple Buildings/Monastery.png', centerX, centerZ, 8.5, 8.0, 3.2);
          addBuilding('/Tiny Swords/Buildings/Purple Buildings/Tower.png', centerX + 10, centerZ - 8, 5.5, 10.5, 2.2);

          const mLight = new THREE.PointLight(0xaa44ff, 1.8, 12);
          mLight.position.set(0, getTerrainHeight(centerX, centerZ) + 2.5, 0);
          chunkGroup.add(mLight);
        }
      } else if (biome === 'DEAD_FOREST') {
        if (isSettlement) {
          // Black Faction Rogue Fort
          addBuilding('/Tiny Swords/Buildings/Black Buildings/Barracks.png', centerX - 5, centerZ - 5, 8.5, 8.0, 3.0);
          addBuilding('/Tiny Swords/Buildings/Black Buildings/Tower.png', centerX + 9, centerZ + 7, 5.5, 10.5, 2.2);
        }
      } else if (biome === 'CRAGS') {
        if (isSettlement) {
          // Red Faction Mountain Stronghold
          addBuilding('/Tiny Swords/Buildings/Red Buildings/Castle.png', centerX, centerZ, 11.0, 10.0, 4.0);
          addBuilding('/Tiny Swords/Buildings/Red Buildings/Tower.png', centerX - 10, centerZ + 8, 5.5, 10.5, 2.2);
        }
      } else if (biome === 'FAIRY_GLADE') {
        if (isSettlement) {
          // Whimsical Fairytale Cottage
          addBuilding('/Tiny Swords/Buildings/Yellow Buildings/House3.png', centerX, centerZ, 6.5, 6.5, 2.4);
          addBuilding('/Tiny Swords/Buildings/Yellow Buildings/Monastery.png', centerX - 8, centerZ - 6, 7.5, 7.5, 2.8);
        }
      } else if (biome === 'RIVER_VALLEY') {
        // River stones, splashes, and floating rubber ducks!
        for (let i = 0; i < 2; i++) {
          const rx = originX + 12 + i * 18;
          const rz = originZ + 14 + (i % 2) * 16;
          const ry = getTerrainHeight(rx, rz);
          const duck = createTinySwordsProp(THREE, '/Tiny Swords/Terrain/Decorations/Rubber Duck/Rubber duck.png', 1.2, 1.2, 0.35, false);
          duck.position.set(rx - centerX, ry, rz - centerZ);
          chunkGroup.add(duck);
          duckPropsList.push({ sprite: duck, baseY: ry, timeOffset: cx * 3 + cz * 7 + i });

          const splash = createTinySwordsProp(THREE, '/Tiny Swords/Particle FX/Water Splash.png', 1.6, 1.4, 0.2, false);
          splash.position.set(rx - centerX + 1.2, ry - 0.1, rz - centerZ + 0.8);
          chunkGroup.add(splash);
        }
      }

      // 4. Populate 3D Foliage & Flora
      let baseTreeCount = 2;
      let baseRockCount = 1;
      let baseFloraCount = 6;

      if (biome === 'MEADOW') {
        baseTreeCount = 1; baseFloraCount = 10;
      } else if (biome === 'TAIGA') {
        baseTreeCount = 5; baseFloraCount = 7;
      } else if (biome === 'MYSTIC_GROVE') {
        baseTreeCount = 4; baseFloraCount = 8;
      } else if (biome === 'DEAD_FOREST') {
        baseTreeCount = 3; baseRockCount = 3; baseFloraCount = 4;
      } else if (biome === 'FAIRY_GLADE') {
        baseTreeCount = 2; baseFloraCount = 12;
      } else if (biome === 'CRAGS') {
        baseTreeCount = 1; baseRockCount = 5; baseFloraCount = 2;
      } else if (biome === 'RIVER_VALLEY') {
        baseTreeCount = 1; baseRockCount = 3; baseFloraCount = 6;
      }

      const numTrees = Math.round(baseTreeCount * foliageDensityMultiplier);
      const numRocks = Math.round(baseRockCount * foliageDensityMultiplier);
      const numFlora = Math.round(baseFloraCount * foliageDensityMultiplier);

      // Trees
      for (let t = 0; t < numTrees; t++) {
        const tx = originX + chunkHash(cx, cz, seed++) * (CHUNK_SIZE - 6) + 3;
        const tz = originZ + chunkHash(cx, cz, seed++) * (CHUNK_SIZE - 6) + 3;
        if (Math.hypot(tx, tz - 18) < 14) continue;

        let tooClose = false;
        for (const pt of chunkPlacedTrees) {
          if (Math.hypot(tx - pt.x, tz - pt.z) < 7.5) { tooClose = true; break; }
        }
        if (tooClose) continue;

        let treeFile = 'CommonTree_1.gltf';
        let treeScale = 2.2;
        if (biome === 'TAIGA') {
          const pList = ['Pine_1.gltf', 'Pine_2.gltf', 'Pine_3.gltf', 'Pine_5.gltf'];
          treeFile = pList[Math.floor(chunkHash(cx, cz, seed++) * pList.length)];
          treeScale = 2.4;
        } else if (biome === 'MYSTIC_GROVE') {
          const mList = ['TwistedTree_1.gltf', 'TwistedTree_2.gltf', 'TwistedTree_3.gltf', 'TwistedTree_5.gltf'];
          treeFile = mList[Math.floor(chunkHash(cx, cz, seed++) * mList.length)];
          treeScale = 2.2;
        } else if (biome === 'DEAD_FOREST') {
          const dList = ['DeadTree_1.gltf', 'DeadTree_2.gltf', 'DeadTree_3.gltf', 'DeadTree_4.gltf'];
          treeFile = dList[Math.floor(chunkHash(cx, cz, seed++) * dList.length)];
          treeScale = 2.0;
        } else if (biome === 'CRAGS') {
          treeFile = chunkHash(cx, cz, seed++) < 0.6 ? 'DeadTree_1.gltf' : 'Pine_5.gltf';
          treeScale = 1.9;
        } else if (biome === 'FAIRY_GLADE') {
          treeFile = chunkHash(cx, cz, seed++) < 0.5 ? 'CommonTree_2.gltf' : 'CommonTree_3.gltf';
          treeScale = 2.3;
        } else {
          treeFile = chunkHash(cx, cz, seed++) < 0.5 ? 'CommonTree_1.gltf' : 'CommonTree_5.gltf';
          treeScale = 2.1;
        }
        addChunkObject(treeFile, tx, tz, treeScale, true, false);
      }

      // Rocks
      for (let r = 0; r < numRocks; r++) {
        const rx = originX + chunkHash(cx, cz, seed++) * (CHUNK_SIZE - 6) + 3;
        const rz = originZ + chunkHash(cx, cz, seed++) * (CHUNK_SIZE - 6) + 3;
        const rList = ['Rock_Medium_1.gltf', 'Rock_Medium_2.gltf', 'Rock_Medium_3.gltf'];
        const rFile = rList[Math.floor(chunkHash(cx, cz, seed++) * rList.length)];
        addChunkObject(rFile, rx, rz, 2.0, false, true);
      }

      // Flora
      for (let f = 0; f < numFlora; f++) {
        const fx = originX + chunkHash(cx, cz, seed++) * (CHUNK_SIZE - 4) + 2;
        const fz = originZ + chunkHash(cx, cz, seed++) * (CHUNK_SIZE - 4) + 2;
        let floraFile = 'Clover_1.gltf';
        let fScale = 1.6;

        if (biome === 'MEADOW') {
          const fList = ['Flower_3_Group.gltf', 'Flower_4_Group.gltf', 'Bush_Common_Flowers.gltf', 'Clover_1.gltf', 'Clover_2.gltf'];
          floraFile = fList[Math.floor(chunkHash(cx, cz, seed++) * fList.length)];
        } else if (biome === 'TAIGA') {
          const fList = ['Fern_1.gltf', 'Grass_Common_Tall.gltf', 'Pebble_Round_1.gltf'];
          floraFile = fList[Math.floor(chunkHash(cx, cz, seed++) * fList.length)];
        } else if (biome === 'MYSTIC_GROVE') {
          const fList = ['Mushroom_Common.gltf', 'Mushroom_Laetiporus.gltf', 'Fern_1.gltf', 'Bush_Common.gltf', 'Petal_1.gltf'];
          floraFile = fList[Math.floor(chunkHash(cx, cz, seed++) * fList.length)];
        } else if (biome === 'DEAD_FOREST') {
          const fList = ['Pebble_Round_1.gltf', 'Pebble_Round_3.gltf', 'DeadTree_3.gltf'];
          floraFile = fList[Math.floor(chunkHash(cx, cz, seed++) * fList.length)];
          fScale = 1.2;
        } else if (biome === 'FAIRY_GLADE') {
          const fList = ['Bush_Common_Flowers.gltf', 'Flower_4_Group.gltf', 'Flower_3_Single.gltf', 'Flower_4_Single.gltf', 'Petal_1.gltf', 'Clover_1.gltf'];
          floraFile = fList[Math.floor(chunkHash(cx, cz, seed++) * fList.length)];
          fScale = 1.8;
        } else {
          floraFile = 'Pebble_Round_3.gltf';
          fScale = 1.3;
        }
        addChunkObject(floraFile, fx, fz, fScale, false, false);
      }

      // 5. PROCEDURAL SACRED RELIC SPAWNING (STRICTLY UNCOLLECTED RELICS ONLY!)
      let spawnedChunkRelicId: string | null = null;
      const isRelicChunk = chunkHash(cx, cz, 777) < 0.28 && Math.hypot(cx, cz) >= 1.2;
      if (isRelicChunk) {
        // Filter strictly relics that have NEVER been discovered AND are not already active in another chunk
        const availableRelics = RELICS_DATA.filter(r => !r.discovered && !activeSpawnedRelics.has(r.id));
        if (availableRelics.length > 0) {
          const biomeMatches = availableRelics.filter(r => r.biome === biome);
          const pool = biomeMatches.length > 0 ? biomeMatches : availableRelics;
          const relic = pool[Math.floor(chunkHash(cx, cz, 888) * pool.length)];

          const rx = originX + CHUNK_SIZE * 0.5 + (chunkHash(cx, cz, 901) - 0.5) * 22;
          const rz = originZ + CHUNK_SIZE * 0.5 + (chunkHash(cx, cz, 902) - 0.5) * 22;
          const ry = getTerrainHeight(rx, rz);
          relic.pos = [rx, 0.8, rz];

          spawnSingleRelic(THREE, relic, chunkGroup, centerX, centerZ);
          spawnedChunkRelicId = relic.id;
          activeSpawnedRelics.set(relic.id, relic.mesh);
        }
      }

      // Check if any legacy fixed uncollected relic falls in this chunk
      for (const relic of RELICS_DATA) {
        if (!relic.discovered && !relic.mesh && !activeSpawnedRelics.has(relic.id) &&
            relic.pos[0] >= originX && relic.pos[0] < originX + CHUNK_SIZE &&
            relic.pos[2] >= originZ && relic.pos[2] < originZ + CHUNK_SIZE) {
          spawnSingleRelic(THREE, relic, chunkGroup, centerX, centerZ);
          activeSpawnedRelics.set(relic.id, relic.mesh);
          spawnedChunkRelicId = relic.id;
        }
      }

      // 6. Spawn procedural wandering or sparring NPCs in this chunk (~42% chance)
      const chunkNPCs: ForestNPC[] = [];
      if (chunkHash(cx, cz, 4444) < 0.42 && Math.hypot(cx, cz) > 1.2) {
        spawnProceduralNPC(cx, cz, chunkNPCs, THREE);
        // If settlement, spawn a sparring second NPC!
        if (isSettlement && chunkHash(cx, cz, 5555) < 0.65) {
          spawnProceduralNPC(cx, cz, chunkNPCs, THREE);
        }
      }

      chunksGroup.add(chunkGroup);
      activeChunks.set(key, { cx, cz, key, group: chunkGroup, colliders: chunkColliders, npcs: chunkNPCs, relicId: spawnedChunkRelicId });
    }

    function updateChunks(forceRebuild = false) {
      if (isChunkUpdating && !forceRebuild) return;
      isChunkUpdating = true;

      const pCX = Math.floor(playerPos.x / CHUNK_SIZE);
      const pCZ = Math.floor(playerPos.z / CHUNK_SIZE);

      if (forceRebuild) {
        activeChunks.forEach((cData) => {
          chunksGroup.remove(cData.group);
          if (cData.relicId) activeSpawnedRelics.delete(cData.relicId);
        });
        activeChunks.clear();
        worldColliders.length = 0;
        forestNPCs.length = 0;
        while (npcGroup.children.length > 0) {
          npcGroup.remove(npcGroup.children[0]);
        }
        campfiresList.length = 0;
        duckPropsList.length = 0;
      }

      const keepKeys = new Set<string>();
      for (let dx = -renderDistanceChunks; dx <= renderDistanceChunks; dx++) {
        for (let dz = -renderDistanceChunks; dz <= renderDistanceChunks; dz++) {
          if (dx * dx + dz * dz <= renderDistanceChunks * renderDistanceChunks) {
            const cx = pCX + dx;
            const cz = pCZ + dz;
            const key = `${cx},${cz}`;
            keepKeys.add(key);
            createChunk(cx, cz);
          }
        }
      }

      activeChunks.forEach((cData, key) => {
        if (!keepKeys.has(key)) {
          chunksGroup.remove(cData.group);
          if (cData.npcs) {
            for (const n of cData.npcs) {
              npcGroup.remove(n.model);
              const idx = forestNPCs.indexOf(n);
              if (idx !== -1) forestNPCs.splice(idx, 1);
            }
          }
          if (cData.colliders) {
            for (const col of cData.colliders) {
              const cIdx = worldColliders.indexOf(col);
              if (cIdx !== -1) worldColliders.splice(cIdx, 1);
            }
          }
          if (cData.relicId) {
            const rel = RELICS_DATA.find(r => r.id === cData.relicId);
            if (rel && !rel.discovered) {
              activeSpawnedRelics.delete(cData.relicId);
              if (rel.mesh) {
                relicsGroup.remove(rel.mesh);
                rel.mesh = null;
              }
            }
          }
          activeChunks.delete(key);
        }
      });

      const maxVisDist = renderDistanceChunks * CHUNK_SIZE;
      if (scene && scene.fog) {
        scene.fog.near = maxVisDist * 0.45;
        scene.fog.far = maxVisDist * 0.98;
      }

      isChunkUpdating = false;
    }

    // Spawn Single Relic with Golden Altar & Vertical Light Beacon
    function spawnSingleRelic(THREE: any, relic: RelicDef, parentGroup: any, chunkCenterX: number, chunkCenterZ: number) {
      try {
        const relicObj = new THREE.Group();
        const groundY = getTerrainHeight(relic.pos[0], relic.pos[2]);
        const spawnY = groundY + relic.pos[1];
        relicObj.position.set(relic.pos[0] - chunkCenterX, spawnY, relic.pos[2] - chunkCenterZ);

        // 1. Stone Altar Pedestal
        const altarModel = loaded3DModels['RockPath_Round_Wide.gltf'] || loaded3DModels['Pebble_Round_1.gltf'];
        if (altarModel) {
          const altar = altarModel.clone(true);
          altar.position.set(0, -0.65, 0);
          altar.scale.set(1.6, 1.2, 1.6);
          relicObj.add(altar);
        }

        // 2. 3D Model of the Sacred Relic
        const modelProto = loaded3DModels[relic.modelFile];
        if (modelProto) {
          const model = modelProto.clone(true);
          model.scale.set(relic.scale, relic.scale, relic.scale);
          model.castShadow = true;
          relicObj.add(model);
        }

        // 3. Golden Halo Ring
        const haloGeo = new THREE.RingGeometry(0.75, 0.95, 18);
        const haloMat = new THREE.MeshBasicMaterial({
          color: 0xffd700,
          side: THREE.DoubleSide,
          transparent: true,
          opacity: 0.6
        });
        const halo = new THREE.Mesh(haloGeo, haloMat);
        halo.rotation.x = Math.PI / 2;
        relicObj.add(halo);

        // 4. Point Light
        const light = new THREE.PointLight(0xffd700, 1.5, 7);
        relicObj.add(light);

        // 5. Vertical Golden Light Beacon (Shoots 45m into the sky, visible between trees!)
        const beamGeo = new THREE.CylinderGeometry(0.2, 0.5, 45, 12, 1, true);
        beamGeo.translate(0, 22.5, 0);
        const beamMat = new THREE.MeshBasicMaterial({
          color: 0xffe066,
          transparent: true,
          opacity: 0.28,
          side: THREE.DoubleSide,
          depthWrite: false
        });
        const beamMesh = new THREE.Mesh(beamGeo, beamMat);
        relicObj.add(beamMesh);

        relicObj.userData = {
          isRelic: true,
          relicData: relic,
          coreMesh: relicObj,
          haloMesh: halo,
          initialY: spawnY
        };

        if (relic.discovered) {
          relicObj.visible = false;
        }

        relic.mesh = relicObj;
        relicsGroup.add(relicObj);
        parentGroup.add(relicObj);
      } catch (err) {
        console.warn(`Error spawning relic ${relic.id}:`, err);
      }
    }

