    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    cursor: pointer;
    backdrop-filter: blur(8px);
    transition: all 0.2s;
  }

  .hud-icon-btn:hover {
    border-color: #ffd700;
    transform: scale(1.06);
    box-shadow: 0 0 15px rgba(255, 215, 0, 0.4);
  }

  .relic-counter-pill {
    background: rgba(15, 23, 42, 0.85);
    border: 1.5px solid rgba(212, 175, 55, 0.5);
    padding: 6px 16px;
    border-radius: 20px;
    display: flex;
    align-items: center;
    gap: 6px;
    font-weight: 800;
    font-size: 0.95rem;
    cursor: pointer;
    backdrop-filter: blur(8px);
    box-shadow: 0 0 15px rgba(212, 175, 55, 0.2);
    transition: all 0.2s;
  }

  .relic-counter-pill:hover {
    transform: scale(1.04);
    box-shadow: 0 0 20px rgba(255, 215, 0, 0.5);
  }

  .relic-gem-icon {
    font-size: 1.1rem;
    filter: drop-shadow(0 0 6px #ffd700);
  }

  .relic-num {
    color: #ffd700;
    font-size: 1.15rem;
  }
  .relic-total {
    color: #94a3b8;
    font-size: 0.85rem;
  }

  /* Compass */
  .hud-compass-wrap {
    position: relative;
    width: 180px;
    height: 32px;
    background: rgba(15, 23, 42, 0.75);
    border: 1px solid rgba(212, 175, 55, 0.4);
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: space-around;
    padding: 0 14px;
    backdrop-filter: blur(8px);
    overflow: hidden;
  }

  .compass-marker {
    font-size: 0.75rem;
    font-weight: 800;
    color: #94a3b8;
  }
  .compass-marker.marker-n {
    color: #ffd700;
  }

  .compass-needle {
    position: absolute;
    width: 2px;
    height: 14px;
    background: #ffd700;
    left: 50%;
    transform: translateX(-50%);
    box-shadow: 0 0 6px #ffd700;
  }

  .compass-relic-ping {
    position: absolute;
    width: 6px;
    height: 6px;
    background: #34d399;
    border-radius: 50%;
    top: 50%;
    transform: translateY(-50%);
    box-shadow: 0 0 8px #34d399;
    display: none;
  }

  /* Whisper Toast */
  .whisper-avatar {
    width: 38px;
    height: 38px;
    border-radius: 8px;
    border: 1.5px solid #ffd700;
    object-fit: cover;
    background: rgba(15, 23, 42, 0.85);
    box-shadow: 0 0 12px rgba(255, 215, 0, 0.45);
    flex-shrink: 0;
  }

  .hud-whisper {
    display: none;
    align-items: center;
    gap: 12px;
    position: absolute;
    top: 75px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(15, 23, 42, 0.88);
    border: 1px solid rgba(212, 175, 55, 0.5);
    color: #ffd700;
    padding: 6px 18px;
    border-radius: 20px;
    font-size: 0.85rem;
    backdrop-filter: blur(8px);
    z-index: 30;
    animation: fadeInOut 4s forwards;
    pointer-events: none;
    box-shadow: 0 0 20px rgba(0, 0, 0, 0.5);
  }

  @keyframes fadeInOut {
    0% { opacity: 0; transform: translate(-50%, -10px); }
    15% { opacity: 1; transform: translate(-50%, 0); }
    85% { opacity: 1; transform: translate(-50%, 0); }
    100% { opacity: 0; transform: translate(-50%, -10px); }
  }

  /* Biome Badge Pill in HUD */
  .hud-pill-btn.biome-pill {
    background: rgba(16, 185, 129, 0.18);
    border-color: rgba(52, 211, 153, 0.4);
    color: #6ee7b7;
    font-weight: 700;
  }

  /* Biome Discovery Floating Banner */
  .hud-biome-banner {
    position: absolute;
    top: 85px;
    left: 50%;
    transform: translateX(-50%);
    background: linear-gradient(135deg, rgba(15, 23, 42, 0.95) 0%, rgba(30, 41, 59, 0.98) 100%);
    border: 1.5px solid rgba(212, 175, 55, 0.7);
    border-radius: 16px;
    padding: 12px 28px;
    text-align: center;
    backdrop-filter: blur(14px);
    z-index: 35;
    pointer-events: none;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.8), 0 0 25px rgba(212, 175, 55, 0.3);
    animation: bannerPop 4.5s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .biome-banner-crest {
    font-size: 0.72rem;
    font-weight: 800;
    color: #ffd700;
    letter-spacing: 2px;
    margin-bottom: 2px;
    text-shadow: 0 0 10px rgba(255, 215, 0, 0.6);
  }

  .biome-banner-title {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    font-size: 1.35rem;
    font-weight: 900;
    color: #fff;
    margin-bottom: 3px;
    letter-spacing: 1px;
  }

  .biome-banner-desc {
    font-size: 0.82rem;
    color: #cbd5e1;
    font-style: italic;
    font-family: system-ui, sans-serif;
  }

  @keyframes bannerPop {
    0% { opacity: 0; transform: translate(-50%, -20px) scale(0.92); }
    12% { opacity: 1; transform: translate(-50%, 0) scale(1); }
    82% { opacity: 1; transform: translate(-50%, 0) scale(1); }
    100% { opacity: 0; transform: translate(-50%, -15px) scale(0.96); }
  }

  /* Journal Tabs & Atlas Grid */
  .journal-nav-tabs {
    display: flex;
    gap: 8px;
    margin-bottom: 1rem;
  }

  .journal-tab-btn {
    flex: 1;
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: #94a3b8;
    padding: 8px 14px;
    border-radius: 10px;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
  }

  .journal-tab-btn.active {
    background: rgba(212, 175, 55, 0.15);
    border-color: #ffd700;
    color: #ffd700;
  }

  .atlas-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 12px;
    overflow-y: auto;
    padding: 4px;
    margin-bottom: 1.2rem;
  }

  .atlas-card {
    background: rgba(8, 12, 22, 0.75);
    border: 1.5px solid rgba(255, 255, 255, 0.12);
    border-radius: 12px;
    padding: 12px;
    text-align: left;
    transition: all 0.2s;
  }

  .atlas-card:hover {
    border-color: #ffd700;
    transform: translateY(-2px);
  }

  .atlas-card-header {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 6px;
  }

  .atlas-card-icon {
    font-size: 1.6rem;
  }

  .atlas-card-title {
    font-size: 0.95rem;
    font-weight: 800;
    color: #ffd700;
  }

  .atlas-card-desc {
    font-size: 0.78rem;
    color: #cbd5e1;
    line-height: 1.35;
    margin-bottom: 8px;
    font-family: system-ui, sans-serif;
  }

  .atlas-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
  }

  .atlas-tag {
    background: rgba(255, 255, 255, 0.08);
    border-radius: 6px;
    padding: 2px 6px;
    font-size: 0.7rem;
    color: #94a3b8;
  }

  /* Bottom Tool Belt */
  .game-hud-bottom {
    position: absolute;
    bottom: 25px;
    left: 20px;
    right: 20px;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    pointer-events: none;
    z-index: 30;
  }
  .game-hud-bottom * {
    pointer-events: auto;
  }

  .hud-tool-belt {
    display: flex;
    gap: 12px;
    background: rgba(15, 23, 42, 0.85);
    border: 1.5px solid rgba(255, 255, 255, 0.15);
    padding: 8px 16px;
    border-radius: 20px;
    backdrop-filter: blur(10px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
  }

  .tool-btn {
    position: relative;
    background: rgba(30, 41, 59, 0.7);
    border: 1.5px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 8px 14px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    color: #e2e8f0;
    cursor: pointer;
    min-width: 80px;
    transition: all 0.2s;
    overflow: hidden;
  }

  .tool-btn:hover {
    border-color: #ffd700;
    transform: translateY(-3px);
    box-shadow: 0 6px 15px rgba(0, 0, 0, 0.4), 0 0 15px rgba(212, 175, 55, 0.3);
  }

  .tool-btn.active {
    background: rgba(212, 175, 55, 0.2);
    border-color: #ffd700;
  }

  .tool-icon {
    font-size: 1.3rem;
  }
  .tool-title {
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.5px;
  }
  .tool-key {
    font-size: 0.62rem;
    color: #94a3b8;
    font-family: system-ui, sans-serif;
  }

  .tool-cooldown {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: #ffd700;
    width: 0%;
    transition: width 0.1s linear;
  }

  /* Mobile Joystick */
  .mobile-joystick-zone {
    position: absolute;
    bottom: 10px;
    left: 10px;
    width: 120px;
    height: 120px;
    display: none;
    align-items: center;
    justify-content: center;
    pointer-events: auto;
  }

  @media (max-width: 900px), (pointer: coarse) {
    .mobile-joystick-zone {
      display: flex;
    }
  }

  .joystick-base {
    position: relative;
    width: 90px;
    height: 90px;
    background: rgba(15, 23, 42, 0.6);
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    touch-action: none;
  }

  .joystick-handle {
    width: 40px;
    height: 40px;
    background: rgba(212, 175, 55, 0.8);
    border: 2px solid #ffd700;
    border-radius: 50%;
    box-shadow: 0 0 10px rgba(255, 215, 0, 0.5);
    transition: transform 0.05s ease-out;
  }

  /* MODALS */
  .modal-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(6, 9, 14, 0.82);
    display: none;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    z-index: 100;
    backdrop-filter: blur(10px);
    animation: fadeInModal 0.3s ease-out;
  }

  @keyframes fadeInModal {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .modal-backdrop.active {
    display: flex;
  }

  .modal-card {
    position: relative;
    background: rgba(15, 23, 42, 0.94);
    border: 1.5px solid rgba(212, 175, 55, 0.6);
    border-radius: 20px;
    padding: 2.2rem;
    max-width: 520px;
    width: 100%;
    text-align: center;
    box-shadow: 0 0 50px rgba(0, 0, 0, 0.9), 0 0 30px rgba(212, 175, 55, 0.2);
    animation: scaleInCard 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  @keyframes scaleInCard {
    from { transform: scale(0.92) translateY(15px); }
    to { transform: scale(1) translateY(0); }
  }

  .modal-close-btn {
    position: absolute;
    top: 14px;
    right: 18px;
    background: none;
    border: none;
    color: #94a3b8;
    font-size: 1.8rem;
    cursor: pointer;
    line-height: 1;
    transition: color 0.2s;
  }
  .modal-close-btn:hover {
    color: #ffd700;
  }

  /* Relic Found Card */
  .relic-card {
    border-color: #ffd700;
    background: radial-gradient(circle at top, rgba(212, 175, 55, 0.15) 0%, rgba(15, 23, 42, 0.96) 80%);
  }

  .relic-preview-container {
    position: relative;
    width: 100px;
    height: 100px;
    margin: 0 auto 1.2rem auto;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .relic-3d-ring {
    position: absolute;
    inset: -6px;
    border: 2px dashed #ffd700;
    border-radius: 50%;
    animation: rotateRing 10s linear infinite;
  }

  .relic-big-emblem {
    font-size: 3.2rem;
    filter: drop-shadow(0 0 15px #ffd700);
    animation: pulseGem 2s infinite alternate ease-in-out;
  }

  @keyframes pulseGem {
    from { transform: scale(0.95); filter: drop-shadow(0 0 10px #ffd700); }
    to { transform: scale(1.1); filter: drop-shadow(0 0 25px #ffd700); }
  }

  .relic-perk-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: linear-gradient(135deg, rgba(16, 185, 129, 0.25), rgba(212, 175, 55, 0.25));
    border: 1px solid rgba(52, 211, 153, 0.6);
    color: #ffd700;
    border-radius: 20px;
    padding: 6px 18px;
    font-size: 0.88rem;
    font-weight: 700;
    margin: 0.8rem auto 0 auto;
    text-shadow: 0 0 10px rgba(255, 215, 0, 0.5);
    box-shadow: 0 0 15px rgba(52, 211, 153, 0.2);
  }

  .relic-discovery-tag {
    font-size: 0.75rem;
    font-weight: 800;
    color: #34d399;
    letter-spacing: 2px;
    margin-bottom: 4px;
  }

  .relic-name {
    font-size: 1.8rem;
    font-weight: 900;
    color: #ffd700;
    margin: 0 0 4px 0;
  }

  .relic-location {
    font-size: 0.85rem;
    color: #94a3b8;
    margin-bottom: 1.2rem;
    font-family: system-ui, sans-serif;
  }

  .relic-lore {
    font-size: 0.95rem;
    color: #cbd5e1;
    line-height: 1.6;
    margin-bottom: 1.5rem;
    font-style: italic;
  }

  .relic-progress-stat {
    display: flex;
    justify-content: center;
    gap: 8px;
    font-size: 0.85rem;
    color: #94a3b8;
    margin-bottom: 1.5rem;
  }
  .relic-progress-stat b {
    color: #ffd700;
  }

  /* Journal Modal */
  .journal-card {
    max-width: 840px;
    width: 95%;
    max-height: 88vh;
    display: flex;
    flex-direction: column;
    text-align: left;
    padding: 1.8rem;
  }

  .journal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.4rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .journal-title-wrap {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .journal-title-wrap h2 {
    margin: 0;
    font-size: 1.3rem;
    color: #ffd700;
    letter-spacing: 1px;
  }

  .journal-status-pill {
    background: rgba(212, 175, 55, 0.15);
    border: 1px solid rgba(212, 175, 55, 0.4);
    color: #ffd700;
    padding: 4px 14px;
    border-radius: 20px;
    font-size: 0.85rem;
  }

  .journal-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 12px;
    overflow-y: auto;
    padding: 4px;
    margin-bottom: 1.2rem;
  }

  .journal-item-card {
    background: rgba(8, 12, 22, 0.7);
    border: 1.5px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: all 0.2s;
    cursor: pointer;
  }

  .journal-item-card:hover {
    border-color: #ffd700;
    transform: translateY(-2px);
  }

  .journal-item-card.discovered {
    border-color: rgba(212, 175, 55, 0.5);
    background: rgba(212, 175, 55, 0.08);
  }

  .journal-item-icon {
    font-size: 2rem;
    margin-bottom: 6px;
  }

  .journal-item-card.undiscovered .journal-item-icon {
    filter: grayscale(1) opacity(0.35);
  }

  .journal-item-name {
    font-size: 0.9rem;
    font-weight: 800;
    color: #ffd700;
    margin-bottom: 4px;
  }

  .journal-item-card.undiscovered .journal-item-name {
    color: #94a3b8;
  }

  .journal-item-hint {
    font-size: 0.75rem;
    color: #64748b;
    line-height: 1.3;
    font-family: system-ui, sans-serif;
  }

  .journal-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 1rem;
    flex-wrap: wrap;
    gap: 12px;
  }

  .journal-hint {
    font-size: 0.8rem;
    color: #94a3b8;
    margin: 0;
    max-width: 500px;
    line-height: 1.4;
  }

  /* Time & Atmosphere Modal */
  .time-options-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
    margin: 1.5rem 0;
  }

  .time-card-item {
    background: rgba(8, 12, 22, 0.75);
    border: 1.5px solid rgba(255, 255, 255, 0.12);
    border-radius: 14px;
    padding: 16px;
    text-align: center;
    cursor: pointer;
    transition: all 0.2s;
  }

  .time-card-item:hover {
    border-color: #ffd700;
    transform: translateY(-2px);
  }

  .time-card-item.active {
    border-color: #ffd700;
    background: rgba(212, 175, 55, 0.12);
    box-shadow: 0 0 20px rgba(212, 175, 55, 0.25);
  }

  .tod-preview {
    font-size: 2.2rem;
    margin-bottom: 6px;
  }

  .time-card-item h3 {
    margin: 0 0 6px 0;
    font-size: 1.05rem;
    color: #ffd700;
  }

  .time-card-item p {
    margin: 0;
    font-size: 0.78rem;
    color: #94a3b8;
    line-height: 1.4;
    font-family: system-ui, sans-serif;
  }

  /* Guide Modal */
  .guide-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
    margin: 1.5rem 0;
    text-align: left;
  }

  .guide-item {
    background: rgba(8, 12, 22, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 14px;
  }

  .guide-ico {
    font-size: 1.6rem;
    display: block;
    margin-bottom: 6px;
  }

  .guide-item h4 {
    margin: 0 0 4px 0;
    color: #ffd700;
    font-size: 0.95rem;
  }

  .guide-item p {
    margin: 0;
    font-size: 0.8rem;
    color: #cbd5e1;
    line-height: 1.4;
    font-family: system-ui, sans-serif;
  }

  /* Settings Modal Card */
  .world-setup-card {
    max-width: 620px;
    width: 100%;
    background: rgba(15, 23, 42, 0.95);
    border: 1.5px solid rgba(212, 175, 55, 0.6);
    border-radius: 20px;
    padding: 2.2rem 2rem;
    box-shadow: 0 0 50px rgba(0, 0, 0, 0.8), 0 0 30px rgba(212, 175, 55, 0.2);
    backdrop-filter: blur(16px);
  }

  .setup-crest {
    font-size: 2.4rem;
    display: block;
    margin-bottom: 0.5rem;
    filter: drop-shadow(0 0 10px rgba(255, 215, 0, 0.6));
  }

  .seed-input-row {
    display: flex;
    gap: 10px;
    margin-top: 6px;
  }

  .seed-input {
    flex: 1;
    background: rgba(8, 12, 22, 0.8);
    border: 1.5px solid rgba(212, 175, 55, 0.4);
    border-radius: 10px;
    padding: 10px 14px;
    color: #ffd700;
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: 1px;
    outline: none;
    font-family: monospace;
  }

  .seed-input:focus {
    border-color: #ffd700;
    box-shadow: 0 0 12px rgba(255, 215, 0, 0.4);
  }

  .seed-btn-random {
    background: rgba(30, 41, 59, 0.8);
    border: 1.5px solid rgba(255, 255, 255, 0.2);
    border-radius: 10px;
    color: #e2e8f0;
    font-weight: 700;
    padding: 10px 18px;
    cursor: pointer;
    transition: all 0.2s;
  }

  .seed-btn-random:hover {
    border-color: #ffd700;
    color: #fff;
  }

  .setup-lock-notice {
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(52, 211, 153, 0.35);
    border-radius: 12px;
    padding: 10px 14px;
    font-size: 0.8rem;
    color: #cbd5e1;
    line-height: 1.4;
    margin-top: 10px;
  }

  .settings-card {
    max-width: 580px;
    text-align: left;
    padding: 2rem;
  }
  .settings-content-grid {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    margin: 1.4rem 0 1.8rem;
    max-height: 60vh;
    overflow-y: auto;
    padding-right: 4px;
  }
  .setting-group {
    background: rgba(8, 12, 22, 0.65);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 12px 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .setting-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .setting-title {
    color: #e2e8f0;
    font-size: 0.92rem;
    font-weight: 700;
  }
  .setting-value {
    color: #ffd700;
    font-size: 0.85rem;
    font-weight: 800;
  }
  .setting-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
