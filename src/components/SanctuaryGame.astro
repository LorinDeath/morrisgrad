    // --- STEP 1: PRELOADER & CACHE CHECK ---
    async function verifyAndLoadAssets() {
      if (statusText) statusText.textContent = 'Проверка кэша 3D-ресурсов в браузере...';

      let cache: Cache | null = null;
      try {
        if ('caches' in window) {
          cache = await window.caches.open(CACHE_NAME);
        }
      } catch (err) {
        console.warn('Cache API unavailable', err);
      }

      const total = ASSETS_TO_CACHE.length;
      let cachedCount = 0;
      const missingUrls: string[] = [];

      if (cache) {
        for (let i = 0; i < total; i++) {
          const url = ASSETS_TO_CACHE[i];
          try {
            const match = await cache.match(url);
            if (match) {
              cachedCount++;
            } else {
              missingUrls.push(url);
            }
          } catch {
            missingUrls.push(url);
          }
          const pct = Math.round(((i + 1) / total) * 30);
          if (progressFill) progressFill.style.width = `${pct}%`;
          if (progressPercent) progressPercent.textContent = `${pct}%`;
          if (progressCounter) progressCounter.textContent = `${i + 1} / ${total}`;
          if (progressFileInfo) progressFileInfo.textContent = `Сканирование: ${url.split('/').pop()}`;
        }
      } else {
        missingUrls.push(...ASSETS_TO_CACHE);
      }

      if (cachedCount === total && total > 0) {
        if (progressFill) progressFill.style.width = '100%';
        if (progressPercent) progressPercent.textContent = '100%';
        if (progressFileInfo) progressFileInfo.textContent = 'Все 3D-модели и текстуры готовы в кэше!';
