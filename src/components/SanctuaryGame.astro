    // Tiny Swords Texture Cache & Prop Builders
    const tinySwordsTexCache: Record<string, any> = {};
    function getTinySwordsTexture(THREE: any, relPath: string) {
      if (!tinySwordsTexCache[relPath]) {
        const ldr = new THREE.TextureLoader();
        const tex = ldr.load(relPath);
        tex.magFilter = THREE.NearestFilter;
        tex.minFilter = THREE.LinearMipmapLinearFilter;
        tinySwordsTexCache[relPath] = tex;
      }
      return tinySwordsTexCache[relPath];
    }

    function createTinySwordsProp(THREE: any, relPath: string, width: number, height: number, yOffset = 0, isCross = false) {
      const tex = getTinySwordsTexture(THREE, relPath);
      if (isCross) {
        const grp = new THREE.Group();
        const geo = new THREE.PlaneGeometry(width, height);
        geo.translate(0, height / 2 + yOffset, 0);
        const mat = new THREE.MeshBasicMaterial({
          map: tex,
          transparent: true,
          alphaTest: 0.15,
          side: THREE.DoubleSide
        });
        const p1 = new THREE.Mesh(geo, mat);
        const p2 = new THREE.Mesh(geo, mat);
        p2.rotation.y = Math.PI / 2;
        p1.castShadow = true;
        p2.castShadow = true;
        p1.receiveShadow = true;
        p2.receiveShadow = true;
        grp.add(p1);
        grp.add(p2);
        return grp;
      } else {
        const mat = new THREE.SpriteMaterial({ map: tex, transparent: true, alphaTest: 0.15 });
        const spr = new THREE.Sprite(mat);
        spr.scale.set(width, height, 1);
        spr.center.set(0.5, yOffset / height + 0.5);
        return spr;
      }
    }

