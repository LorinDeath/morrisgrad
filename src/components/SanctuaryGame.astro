    // --- FIREFLY RELIC GUIDE ---
    function triggerFireflyGuide() {
      if (fireflyCooldownTimer > 0) return;
      const undiscovered = RELICS_DATA.filter(r => !r.discovered);
      if (undiscovered.length === 0) {
        showWhisper('✨ Все 24 реликвии рощи собраны! Лес сияет древней магией.');
        return;
      }
      let nearest = undiscovered[0];
      let minDist = 999999;
      for (const r of undiscovered) {
        const d = Math.hypot(r.pos[0] - playerPos.x, r.pos[2] - playerPos.z);
        if (d < minDist) {
          minDist = d;
          nearest = r;
        }
      }
      const dx = nearest.pos[0] - playerPos.x;
      const dz = nearest.pos[2] - playerPos.z;
      let dir = 'север';
      if (Math.abs(dx) > Math.abs(dz)) {
        dir = dx > 0 ? 'восток' : 'запад';
      } else {
        dir = dz > 0 ? 'юг' : 'север';
      }
      showWhisper(`✨ Светлячок указывает на ${dir}: «${nearest.name}» сокрыта в ~${Math.round(minDist)} м! ${nearest.hint}`);
      playHarmonicChime(740);

      fireflyCooldownTimer = 12.0;
      if (fireflyCooldown) {
        fireflyCooldown.style.width = '100%';
        const interval = setInterval(() => {
          fireflyCooldownTimer -= 0.5;
          if (fireflyCooldownTimer <= 0) {
            clearInterval(interval);
            fireflyCooldown.style.width = '0%';
          } else {
            fireflyCooldown.style.width = `${(fireflyCooldownTimer / 12.0) * 100}%`;
          }
        }, 500);
      }
    }

