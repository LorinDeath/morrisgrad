    // --- ADVANCED NPC AI: PATROL, DUELING COMBAT, GATHERING, & PLAYER INTERACTION ---
    function updateNPCs(delta: number, playerPos: { x: number; y: number; z: number }, THREE: any) {
      for (const npc of forestNPCs) {
        if (!npc.model) continue;

        if (npc.greetCooldown > 0) npc.greetCooldown -= delta;
        if (npc.duelCooldown > 0) npc.duelCooldown -= delta;

        // 1. TALKING STATE (Facing player, giving hint/blessing)
        if (npc.state === 'TALKING') {
          npc.stateTimer -= delta;
          const distToPlayer = Math.hypot(playerPos.x - npc.pos.x, playerPos.z - npc.pos.z);
          if (npc.stateTimer <= 0 || distToPlayer > 4.5) {
            setNPCState(npc, 'PATROL');
          } else {
            // Turn smoothly towards player
            const toPlayerYaw = Math.atan2(playerPos.x - npc.pos.x, playerPos.z - npc.pos.z);
            let diff = toPlayerYaw - npc.yaw;
            while (diff < -Math.PI) diff += Math.PI * 2;
            while (diff > Math.PI) diff -= Math.PI * 2;
            npc.yaw += diff * Math.min(1.0, delta * 5.0);
            npc.model.rotation.y = npc.yaw;
          }
          if (npc.mixer) npc.mixer.update(delta);
          continue;
        }

        // 2. DUELING COMBAT STATE (Two bots fighting each other)
        if (npc.state === 'DUEL') {
          const opponent = npc.duelOpponent;
          if (!opponent || !opponent.model || opponent.state !== 'DUEL') {
            setNPCState(npc, 'PATROL');
            npc.duelOpponent = null;
            if (npc.mixer) npc.mixer.update(delta);
            continue;
          }

          // Face opponent
          const dx = opponent.pos.x - npc.pos.x;
          const dz = opponent.pos.z - npc.pos.z;
          const targetYaw = Math.atan2(dx, dz);
          let diff = targetYaw - npc.yaw;
          while (diff < -Math.PI) diff += Math.PI * 2;
          while (diff > Math.PI) diff -= Math.PI * 2;
          npc.yaw += diff * Math.min(1.0, delta * 6.0);
          npc.model.rotation.y = npc.yaw;

          // Keep combat distance (~1.8m)
          const combatDist = Math.hypot(dx, dz);
          if (combatDist > 2.3) {
            npc.pos.x += (dx / combatDist) * npc.speed * 0.6 * delta;
            npc.pos.z += (dz / combatDist) * npc.speed * 0.6 * delta;
          } else if (combatDist < 1.4 && combatDist > 0.01) {
            npc.pos.x -= (dx / combatDist) * npc.speed * 0.5 * delta;
            npc.pos.z -= (dz / combatDist) * npc.speed * 0.5 * delta;
          }

          npc.duelTimer -= delta;
          if (npc.duelTimer <= 0) {
            // Lunge and strike!
            if (npc.attackAction) {
              npc.attackAction.reset().play();
            }
            playSwordClang();

            // Reaction on opponent
            if (opponent.hitAction) {
              opponent.hitAction.reset().play();
            }

            npc.duelRounds--;
            if (npc.duelRounds > 0) {
              npc.duelTimer = 1.3 + Math.random() * 0.8;
            } else {
              // Duel concludes with mutual salute
              showWhisper(`⚔️ Поединок завершен! ${npc.name} и ${opponent.name} отсалютовали клинками!`);
              playHarmonicChime(587.33);

              npc.duelCooldown = 45.0;
              opponent.duelCooldown = 45.0;
              setNPCState(npc, 'REST');
              setNPCState(opponent, 'REST');
              npc.stateTimer = 4.0;
              opponent.stateTimer = 4.0;
              npc.duelOpponent = null;
              opponent.duelOpponent = null;
            }
          }

          npc.pos.y = getTerrainHeight(npc.pos.x, npc.pos.z);
          npc.model.position.set(npc.pos.x, npc.pos.y, npc.pos.z);
          if (npc.mixer) npc.mixer.update(delta);
          continue;
        }

        // 3. REST / INSPECT STATE
        if (npc.state === 'REST' || npc.state === 'INSPECT') {
          npc.stateTimer -= delta;
          if (npc.stateTimer <= 0) {
            setNPCState(npc, 'PATROL');
          }
          if (npc.mixer) npc.mixer.update(delta);
          continue;
        }

        // 4. PATROL STATE (Advance along route and search for rivals)
        const currentWp = npc.waypoints[npc.currentWp];
        const targetX = currentWp.x;
        const targetZ = currentWp.z;

        const distToWp = Math.hypot(targetX - npc.pos.x, targetZ - npc.pos.z);
        if (distToWp < 3.0) {
          npc.currentWp = (npc.currentWp + 1) % npc.waypoints.length;
          // Chance to pause at waypoint for a scenic rest
          if (Math.random() < 0.22) {
            setNPCState(npc, 'REST');
            npc.stateTimer = 3.5 + Math.random() * 3.5;
            if (npc.mixer) npc.mixer.update(delta);
            continue;
          }
        }

        let steerX = targetX - npc.pos.x;
        let steerZ = targetZ - npc.pos.z;
        const steerLen = Math.hypot(steerX, steerZ) || 1;
        steerX /= steerLen;
        steerZ /= steerLen;

        // CHECK FOR OPPOSING NPC TO TRIGGER A SPARRING DUEL!
        if (npc.duelCooldown <= 0) {
          for (const other of forestNPCs) {
            if (other === npc || !other.model || other.state !== 'PATROL' || other.duelCooldown > 0) continue;
            const distToOther = Math.hypot(other.pos.x - npc.pos.x, other.pos.z - npc.pos.z);
            if (distToOther < 5.2) {
              const isRival = (npc.faction !== other.faction) || (npc.faction === 'blue' && Math.random() < 0.35);
              if (isRival) {
                // INITIATE DUEL!
                setNPCState(npc, 'DUEL');
                setNPCState(other, 'DUEL');
                npc.duelOpponent = other;
                other.duelOpponent = npc;
                npc.duelRounds = 3 + Math.floor(Math.random() * 2);
                other.duelRounds = npc.duelRounds;
                npc.duelTimer = 0.8 + Math.random() * 0.4;
                other.duelTimer = npc.duelTimer + 1.2;

                showWhisper(`⚔️ Поединок чести! ${npc.name} (${npc.title}) скрестил оружие с ${other.name} (${other.title})!`);
                playSwordClang();
                break;
              }
            }
          }
          if (npc.state === 'DUEL') {
            if (npc.mixer) npc.mixer.update(delta);
            continue;
          }
        }

        // Steer around player if blocking
        const distToPlayer = Math.hypot(playerPos.x - npc.pos.x, playerPos.z - npc.pos.z);
        if (distToPlayer < 3.8 && distToPlayer > 0.01) {
          const toPlayerX = (playerPos.x - npc.pos.x) / distToPlayer;
          const toPlayerZ = (playerPos.z - npc.pos.z) / distToPlayer;
          const dot = steerX * toPlayerX + steerZ * toPlayerZ;

          if (dot > 0.25) {
            const perpX = -toPlayerZ * npc.passOffset;
            const perpZ = toPlayerX * npc.passOffset;
            steerX = steerX * 0.4 + perpX * 0.6;
            steerZ = steerZ * 0.4 + perpZ * 0.6;
            const newLen = Math.hypot(steerX, steerZ) || 1;
            steerX /= newLen;
            steerZ /= newLen;
          }

          if (distToPlayer < 3.2 && npc.greetCooldown <= 0) {
            npc.greetCooldown = 50.0;
            showWhisper(`${npc.name} (${npc.title}): «${npc.greetMsg}»`);
            playHarmonicChime(587.33);
          }
        }

        npc.pos.x += steerX * npc.speed * delta;
        npc.pos.z += steerZ * npc.speed * delta;
        resolveColliders(npc.pos, 0.45);

        const targetYaw = Math.atan2(steerX, steerZ);
        let diff = targetYaw - npc.yaw;
        while (diff < -Math.PI) diff += Math.PI * 2;
        while (diff > Math.PI) diff -= Math.PI * 2;
        npc.yaw += diff * Math.min(1.0, delta * 4.0);

        npc.pos.y = getTerrainHeight(npc.pos.x, npc.pos.z);
        npc.model.position.set(npc.pos.x, npc.pos.y, npc.pos.z);
        npc.model.rotation.y = npc.yaw;

        if (npc.mixer) npc.mixer.update(delta);
      }

      // NPC vs NPC physical avoidance
      for (let i = 0; i < forestNPCs.length; i++) {
        for (let j = i + 1; j < forestNPCs.length; j++) {
          const a = forestNPCs[i];
          const b = forestNPCs[j];
          if (!a.model || !b.model || a.state === 'DUEL' || b.state === 'DUEL') continue;
          const dx = a.pos.x - b.pos.x;
          const dz = a.pos.z - b.pos.z;
          const d = Math.hypot(dx, dz);
          if (d < 1.3 && d > 0.001) {
            const push = (1.3 - d) * 0.5;
            a.pos.x += (dx / d) * push;
            a.pos.z += (dz / d) * push;
            b.pos.x -= (dx / d) * push;
            b.pos.z -= (dz / d) * push;
          }
        }
      }
    }

    // --- INTERACTIVE NPC CONVERSATION (RELIC CLUES & SPEED BLESSINGS) ---
    function talkToNPC(npc: ForestNPC) {
      if (!npc) return;
      setNPCState(npc, 'TALKING');
      npc.stateTimer = 8.0;
      npc.yaw = Math.atan2(playerPos.x - npc.pos.x, playerPos.z - npc.pos.z);
      if (npc.model) npc.model.rotation.y = npc.yaw;

      playHarmonicChime(587.33);

      // Pick thematic avatar for dialogue toast
      let avatarUrl = '/Tiny Swords/UI Elements/UI Elements/Human Avatars/Avatars_01.png';
      if (npc.file.includes('Ranger')) avatarUrl = '/Tiny Swords/UI Elements/UI Elements/Human Avatars/Avatars_04.png';
      else if (npc.file.includes('Mage')) avatarUrl = '/Tiny Swords/UI Elements/UI Elements/Human Avatars/Avatars_07.png';
      else if (npc.file.includes('Barbarian')) avatarUrl = '/Tiny Swords/UI Elements/UI Elements/Human Avatars/Avatars_10.png';
      else if (npc.file.includes('Rogue')) avatarUrl = '/Tiny Swords/UI Elements/UI Elements/Human Avatars/Avatars_18.png';
      else if (npc.scale < 0.6) avatarUrl = '/Tiny Swords/UI Elements/UI Elements/Human Avatars/Avatars_22.png';
      else if (npc.scale > 1.3) avatarUrl = '/Tiny Swords/UI Elements/UI Elements/Human Avatars/Avatars_16.png';

      // Find nearest undiscovered relic to provide precise guidance
      let nearestRelic: RelicDef | null = null;
      let minDist = 999999;
      for (const r of RELICS_DATA) {
        if (r.discovered) continue;
        const d = Math.hypot(r.pos[0] - playerPos.x, r.pos[2] - playerPos.z);
        if (d < minDist) { minDist = d; nearestRelic = r; }
      }

      if (nearestRelic && minDist < 350) {
        const dx = nearestRelic.pos[0] - playerPos.x;
        const dz = nearestRelic.pos[2] - playerPos.z;
        const angle = Math.atan2(dx, dz);
        let dirName = 'северу';
        if (angle > -Math.PI / 8 && angle <= Math.PI / 8) dirName = 'югу';
        else if (angle > Math.PI / 8 && angle <= 3 * Math.PI / 8) dirName = 'юго-западу';
        else if (angle > 3 * Math.PI / 8 && angle <= 5 * Math.PI / 8) dirName = 'западу';
        else if (angle > 5 * Math.PI / 8 && angle <= 7 * Math.PI / 8) dirName = 'северо-западу';
        else if (angle > -3 * Math.PI / 8 && angle <= -Math.PI / 8) dirName = 'юго-востоку';
        else if (angle > -5 * Math.PI / 8 && angle <= -3 * Math.PI / 8) dirName = 'востоку';
        else if (angle > -7 * Math.PI / 8 && angle <= -5 * Math.PI / 8) dirName = 'северо-востоку';

        showWhisper(`${npc.name} (${npc.title}): «Я чувствую сияние «${nearestRelic.name}»! Ступай к ${dirName}, примерно ${Math.round(minDist)} шагов. ${nearestRelic.hint}»`, avatarUrl);
      } else {
        playerSpeedBuff = 1.35;
        playerSpeedBuffTimer = 45.0;
        showWhisper(`${npc.name} (${npc.title}): «Да сопутствует тебе ветер! Прими Благословение Леса (+35% к скорости на 45 сек)!»`, avatarUrl);
      }
    }

    function checkInteractionClick() {
      if (hoveredRelic && !hoveredRelic.discovered) {
        hoveredRelic.discovered = true;
        if (hoveredRelic.mesh) {
          hoveredRelic.mesh.visible = false;
        }
        activeSpawnedRelics.delete(hoveredRelic.id);

        try {
          const discoveredIds = RELICS_DATA.filter(r => r.discovered).map(r => r.id);
          localStorage.setItem('morrisgrad_relics_v2', JSON.stringify(discoveredIds));
        } catch (e) {
          console.warn(e);
        }

        updateRelicCounters();
        playRelicFanfare();
        showRelicModal(hoveredRelic);

        const totalFound = RELICS_DATA.filter(r => r.discovered).length;
        if (totalFound === RELICS_DATA.length) {
          setTimeout(() => showVictoryModal(), 1800);
        }
      } else if (hoveredNPC) {
        talkToNPC(hoveredNPC);
      }
    }

    function showRelicModal(relic: RelicDef) {
      if (!modalRelicFound) return;
      if (relicCardIcon) relicCardIcon.textContent = relic.icon;
      if (relicModalTitle) relicModalTitle.textContent = relic.name;
      if (relicModalLocation) relicModalLocation.textContent = `📍 ${relic.location}`;
      if (relicModalLore) relicModalLore.textContent = relic.lore;
      
      const perkText = document.getElementById('relic-modal-perk-text');
      if (perkText) perkText.textContent = relic.perk || '⚡ Постоянный бонус к силе Святилища!';

      const count = RELICS_DATA.filter(r => r.discovered).length;
      if (relicModalCounter) relicModalCounter.textContent = `${count} / ${RELICS_DATA.length}`;

      modalRelicFound.classList.add('active');
    }

    btnRelicCollect?.addEventListener('click', () => {
      if (modalRelicFound) modalRelicFound.classList.remove('active');
      playTone(660, 0.08, 'sine');
    });

    function renderBiomeAtlas() {
      if (!journalBiomesGrid) return;
      journalBiomesGrid.innerHTML = '';

      Object.values(BIOME_DEFS).forEach(b => {
        const isCurrent = b.id === currentBiome;
        const card = document.createElement('div');
        card.className = `atlas-card ${isCurrent ? 'active' : ''}`;
        card.innerHTML = `
          <div class="atlas-card-header">
            <span class="atlas-card-icon">${b.icon}</span>
            <div>
              <div class="atlas-card-title">${b.name}</div>
              ${isCurrent ? '<span style="font-size: 0.7rem; color: #34d399; font-weight: 700;">● Текущий биом</span>' : ''}
            </div>
          </div>
          <div class="atlas-card-desc">${b.desc}</div>
          <div class="atlas-card-tags">
            <span class="atlas-tag">${b.id === 'DEAD_FOREST' ? 'Сухостой и скалы' : (b.id === 'TAIGA' ? 'Вековые сосны' : (b.id === 'MYSTIC_GROVE' ? 'Светящиеся грибы' : (b.id === 'CRAGS' ? 'Острые пики' : (b.id === 'FAIRY_GLADE' ? 'Цветущие сады' : 'Дубрава и клевер'))))}</span>
            <span class="atlas-tag">Бесконечные чанки</span>
          </div>
        `;
        journalBiomesGrid.appendChild(card);
