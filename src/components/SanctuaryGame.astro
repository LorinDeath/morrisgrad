    // --- TIME OF DAY / ATMOSPHERE ---
    function applyTimeOfDay(tod: string) {
      currentTimeOfDay = tod;
      if (!scene) return;

      if (menuTodLabel) {
        const labels: Record<string, string> = {
          noon: 'Золотой полдень',
          sunset: 'Закатный бриз',
          night: 'Лунная сказка',
          fog: 'Утренний туман'
        };
        menuTodLabel.textContent = labels[tod] || tod;
      }

      if (hudTodIcon && hudTodName) {
        if (tod === 'noon') {
          hudTodIcon.textContent = '☀️';
          hudTodName.textContent = 'Полдень';
        } else if (tod === 'sunset') {
          hudTodIcon.textContent = '🌅';
          hudTodName.textContent = 'Закат';
        } else if (tod === 'night') {
          hudTodIcon.textContent = '🌙';
          hudTodName.textContent = 'Ночь';
        } else if (tod === 'fog') {
          hudTodIcon.textContent = '🌫️';
          hudTodName.textContent = 'Туман';
        }
      }

      if (tod === 'noon') {
        if (skyMesh?.material) {
          skyMesh.material.map = createSkyTexture(THREE, '#1e5f96', '#4e92c2', '#a8cbdb');
          skyMesh.material.fog = false;
          skyMesh.material.needsUpdate = true;
        }
        if (scene?.fog) scene.fog.color.setHex(0xa8cbdb);
        if (scene?.background) scene.background.setHex(0xa8cbdb);
        if (renderer) renderer.setClearColor(0xa8cbdb, 1);
        if (dirLight) {
          dirLight.color.setHex(0xfffaea);
          dirLight.intensity = 1.4;
        }
        if (hemiLight) {
          hemiLight.color.setHex(0xf8fcff);
          hemiLight.groundColor.setHex(0x354b30);
          hemiLight.intensity = 0.9;
        }
        if (particlesGroup?.material) particlesGroup.material.color.setHex(0xffe680);
      } else if (tod === 'sunset') {
        if (skyMesh?.material) {
          skyMesh.material.map = createSkyTexture(THREE, '#472449', '#c45335', '#f29a52');
          skyMesh.material.fog = false;
          skyMesh.material.needsUpdate = true;
        }
        if (scene?.fog) scene.fog.color.setHex(0xd47348);
        if (scene?.background) scene.background.setHex(0xd47348);
        if (renderer) renderer.setClearColor(0xd47348, 1);
        if (dirLight) {
          dirLight.color.setHex(0xffaa48);
          dirLight.intensity = 1.3;
        }
        if (hemiLight) {
          hemiLight.color.setHex(0xf49d6e);
          hemiLight.groundColor.setHex(0x283845);
          hemiLight.intensity = 0.85;
        }
        if (particlesGroup?.material) particlesGroup.material.color.setHex(0xffb74d);
      } else if (tod === 'night') {
        if (skyMesh?.material) {
          skyMesh.material.map = createSkyTexture(THREE, '#030712', '#0a1428', '#142240', true);
          skyMesh.material.fog = false;
          skyMesh.material.needsUpdate = true;
        }
        if (scene?.fog) scene.fog.color.setHex(0x0a1428);
        if (scene?.background) scene.background.setHex(0x0a1428);
        if (renderer) renderer.setClearColor(0x0a1428, 1);
        if (dirLight) {
          dirLight.color.setHex(0x64b5f6);
          dirLight.intensity = 0.55;
        }
        if (hemiLight) {
          hemiLight.color.setHex(0x1a2f55);
          hemiLight.groundColor.setHex(0x0a1220);
          hemiLight.intensity = 0.5;
        }
        if (particlesGroup?.material) particlesGroup.material.color.setHex(0x4ef0d0);
      } else if (tod === 'fog') {
        if (skyMesh?.material) {
          skyMesh.material.map = createSkyTexture(THREE, '#869ba3', '#b0c2c5', '#d6e2df');
          skyMesh.material.fog = false;
          skyMesh.material.needsUpdate = true;
        }
        if (scene?.fog) scene.fog.color.setHex(0xd6e2df);
        if (scene?.background) scene.background.setHex(0xd6e2df);
        if (renderer) renderer.setClearColor(0xd6e2df, 1);
        if (dirLight) {
          dirLight.color.setHex(0xfbf6e6);
          dirLight.intensity = 0.95;
        }
        if (hemiLight) {
          hemiLight.color.setHex(0xe5ecea);
          hemiLight.groundColor.setHex(0x424945);
          hemiLight.intensity = 0.8;
        }
        if (particlesGroup?.material) particlesGroup.material.color.setHex(0xf0c88a);
      }
    }

