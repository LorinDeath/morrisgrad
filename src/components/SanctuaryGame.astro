<script>
  // SanctuaryGame Client Engine with Direct glTF Parser
  // Robust Auto-Init: immediately runs even if DOMContentLoaded already fired
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', () => initSanctuary());
  } else {
    initSanctuary();
  }

  document.addEventListener('astro:page-load', () => {
    const container = document.getElementById('sanctuary-wrapper');
    if (container) container.dataset.initialized = 'false';
    initSanctuary();
  });

  // Await Three.js global instance
  async function getThreeInstance(): Promise<any> {
    while (!(window as any).THREE) {
      await new Promise(r => setTimeout(r, 40));
    }
    return (window as any).THREE;
  }

  // --- NATIVE DETERMINISTIC GLTF 2.0 PARSER ---
  const gltfModelCache: Record<string, any> = {};
  const gltfTextureCache: Record<string, any> = {};

  async function loadStylizedGLTF(THREE: any, gltfPath: string): Promise<any> {
    if (gltfModelCache[gltfPath]) {
      return gltfModelCache[gltfPath].clone(true);
    }

    const basePath = gltfPath.substring(0, gltfPath.lastIndexOf('/') + 1);
    const gltfRes = await fetch(gltfPath);
    if (!gltfRes.ok) throw new Error(`HTTP error ${gltfRes.status} on ${gltfPath}`);
    const json = await gltfRes.json();

    // 1. Fetch Binary Buffers
    const buffers: ArrayBuffer[] = [];
    for (const b of json.buffers) {
      const binRes = await fetch(basePath + b.uri);
      if (!binRes.ok) throw new Error(`HTTP error on buffer ${b.uri}`);
      const buf = await binRes.arrayBuffer();
      buffers.push(buf);
    }

    // 2. Texture Loader
    const textureLoader = new THREE.TextureLoader();
    function getTexture(texIndex: number) {
      if (texIndex === undefined || texIndex === null) return null;
      const texDef = json.textures?.[texIndex];
      if (!texDef) return null;
      const imgDef = json.images?.[texDef.source];
      if (!imgDef || !imgDef.uri) return null;
      const fullUri = basePath + imgDef.uri;

      if (!gltfTextureCache[fullUri]) {
        const tex = textureLoader.load(fullUri);
        tex.flipY = false;
        tex.wrapS = THREE.RepeatWrapping;
        tex.wrapT = THREE.RepeatWrapping;
        gltfTextureCache[fullUri] = tex;
      }
      return gltfTextureCache[fullUri];
    }

    // 3. Materials
    const materials: any[] = [];
    if (json.materials) {
      for (const m of json.materials) {
        const pbr = m.pbrMetallicRoughness || {};
        const baseColorTex = getTexture(pbr.baseColorTexture?.index);
        const normalTex = getTexture(m.normalTexture?.index);

        const isLeaves = m.name?.includes('Leaves') || m.alphaMode === 'MASK';
        const mat = new THREE.MeshStandardMaterial({
          name: m.name || '',
          map: baseColorTex,
          normalMap: normalTex,
          roughness: pbr.roughnessFactor ?? 0.85,
          metalness: pbr.metallicFactor ?? 0.05,
          alphaTest: isLeaves ? (m.alphaCutoff ?? 0.25) : 0,
          side: (m.doubleSided || isLeaves) ? THREE.DoubleSide : THREE.FrontSide,
          transparent: m.alphaMode === 'BLEND'
        });
        materials.push(mat);
      }
    }

    // 4. Accessor extraction
    function getAccessorData(accIndex: number) {
      const acc = json.accessors[accIndex];
      const bv = json.bufferViews[acc.bufferView];
      const buf = buffers[bv.buffer || 0];
      const byteOffset = (bv.byteOffset || 0) + (acc.byteOffset || 0);

      const typeSizeMap: Record<string, number> = {
        SCALAR: 1,
        VEC2: 2,
        VEC3: 3,
        VEC4: 4
      };
      const numComponents = typeSizeMap[acc.type] || 1;
      const totalComponents = acc.count * numComponents;

      if (acc.componentType === 5126) {
        return new Float32Array(buf, byteOffset, totalComponents);
      } else if (acc.componentType === 5123) {
        return new Uint16Array(buf, byteOffset, totalComponents);
      } else if (acc.componentType === 5125) {
        return new Uint32Array(buf, byteOffset, totalComponents);
      } else if (acc.componentType === 5121) {
        return new Uint8Array(buf, byteOffset, totalComponents);
      }
      return null;
    }

    // 5. Construct THREE Group
    const root = new THREE.Group();
    root.name = json.nodes?.[0]?.name || json.meshes?.[0]?.name || 'GLTF_Model';

    const meshDef = json.meshes?.[0];
    if (meshDef && meshDef.primitives) {
      for (const prim of meshDef.primitives) {
        const geo = new THREE.BufferGeometry();

        // POSITION
        if (prim.attributes.POSITION !== undefined) {
          const posData = getAccessorData(prim.attributes.POSITION);
          if (posData) geo.setAttribute('position', new THREE.BufferAttribute(posData, 3));
        }
        // NORMAL
        if (prim.attributes.NORMAL !== undefined) {
          const normData = getAccessorData(prim.attributes.NORMAL);
          if (normData) geo.setAttribute('normal', new THREE.BufferAttribute(normData, 3));
        }
        // TEXCOORD_0
        if (prim.attributes.TEXCOORD_0 !== undefined) {
          const uvData = getAccessorData(prim.attributes.TEXCOORD_0);
          if (uvData) geo.setAttribute('uv', new THREE.BufferAttribute(uvData, 2));
        }
        // COLOR_0
        if (prim.attributes.COLOR_0 !== undefined) {
          const colorData = getAccessorData(prim.attributes.COLOR_0);
          const acc = json.accessors[prim.attributes.COLOR_0];
          const itemSize = acc.type === 'VEC4' ? 4 : 3;
          if (colorData) geo.setAttribute('color', new THREE.BufferAttribute(colorData, itemSize));
        }
        // INDICES
        if (prim.indices !== undefined) {
          const indexData = getAccessorData(prim.indices);
          if (indexData) geo.setIndex(new THREE.BufferAttribute(indexData, 1));
        }

        geo.computeVertexNormals();

        const mat = materials[prim.material] || new THREE.MeshStandardMaterial({ color: 0x4a7c59, roughness: 0.8 });
        const mesh = new THREE.Mesh(geo, mat);
        mesh.castShadow = true;
        mesh.receiveShadow = true;
        root.add(mesh);
      }
    }

    gltfModelCache[gltfPath] = root;
    return root.clone(true);
  }

