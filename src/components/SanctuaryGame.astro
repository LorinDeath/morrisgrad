        const loadAnimSafely = (url: string) => {
          return new Promise((resolve) => {
            const timer = setTimeout(() => {
              console.warn('Animation load timeout for', url);
              resolve(null);
            }, 3000);
            gltfLoaderInstance.load(
              url,
              (g: any) => { clearTimeout(timer); resolve(g); },
              undefined,
              (err: any) => { clearTimeout(timer); console.warn('Animation error for', url, err); resolve(null); }
