---
// SanctuaryGame.astro - 3D Hidden Object & Zen Exploration Game with Stylized Assets
---

<div id="sanctuary-wrapper" class="sanctuary-container">
  <!-- 1. RESOURCE VERIFICATION & PRELOADER SCREEN -->
  <div id="screen-preloader" class="screen active">
    <div class="preloader-backdrop">
      <div class="preloader-blur-bg"></div>
      <div class="floating-sparks" id="preloader-sparks"></div>
    </div>

    <div class="preloader-card">
      <div class="emblem-container">
        <div class="emblem-ring"></div>
        <div class="emblem-icon">🌲</div>
      </div>

      <h1 class="preloader-title">ЗАПОВЕДНЫЙ ЛЕС</h1>
      <p class="preloader-subtitle">ТАЙНЫ ДРЕВНЕЙ РОЩИ • 3D ПОИСК ПРЕДМЕТОВ</p>

      <div class="preloader-status-box">
        <div class="status-indicator">
          <span class="status-pulse"></span>
          <span id="preloader-status-text">Проверка кэша 3D-ресурсов игры на устройстве...</span>
        </div>

        <div class="progress-bar-container">
          <div id="preloader-progress-fill" class="progress-bar-fill" style="width: 0%;"></div>
        </div>

        <div class="progress-details">
          <span id="preloader-percent">0%</span>
          <span id="preloader-file-info">Инициализация...</span>
          <span id="preloader-counter">0 / 0</span>
        </div>
      </div>

      <!-- Notification Toast Area inside Preloader -->
      <div id="preloader-notification" class="preloader-notification" style="display: none;">
        <span class="notif-icon">✨</span>
        <div class="notif-text">
          <b id="notif-heading">Ресурсы проверены!</b>
          <span id="notif-sub">Все 3D-модели деревьев, трав и реликвий сохранены в кэш.</span>
        </div>
      </div>

      <div class="preloader-actions" id="preloader-actions" style="display: none;">
        <button id="btn-preloader-continue" class="btn-primary-golden">
          <span>ВОЙТИ В ГЛАВНОЕ МЕНЮ</span>
          <span class="btn-arrow">→</span>
        </button>
      </div>

      <div class="preloader-tip">
        <span>💡 Совет: В роще спрятано 24 священных реликвии из мира Stylized: древние грибы, редкий клевер, рунные камни и парящие лепестки.</span>
      </div>
    </div>
  </div>

  <!-- 2. MAIN MENU SCREEN -->
  <div id="screen-menu" class="screen">
    <div class="menu-backdrop">
      <div class="menu-bg-art"></div>
      <div class="menu-vignette"></div>
      <div class="menu-particles" id="menu-particles"></div>
    </div>

    <div class="menu-content">
      <div class="menu-header">
        <div class="game-badge">3D ПОИСК ПРЕДМЕТОВ • НАСТОЯЩИЕ STYLIZED АССЕТЫ</div>
        <h1 class="game-main-title">ЗАПОВЕДНЫЙ ЛЕС</h1>
        <p class="game-tagline">Погрузитесь в атмосферу спокойствия, древних сказаний и таинственных находок</p>
      </div>

      <!-- Quick status indicator -->
      <div class="cache-badge">
        <span class="cache-dot"></span>
        <span>Локальные 3D-модели активны (Кэш: 100%)</span>
      </div>

      <div class="menu-nav-grid">
        <button id="btn-menu-start" class="menu-btn primary-start" onclick="window.__openSanctuaryWorldSetup && window.__openSanctuaryWorldSetup()">
          <span class="btn-icon">🌿</span>
          <div class="btn-label-group">
            <span class="btn-main-label">НАЧАТЬ ПРИКЛЮЧЕНИЕ</span>
            <span class="btn-desc-label">Исследовать живой 3D-лес и найти 24 священные реликвии</span>
          </div>
        </button>

        <button id="btn-menu-journal" class="menu-btn secondary-btn">
          <span class="btn-icon">📖</span>
          <div class="btn-label-group">
            <span class="btn-main-label">КНИГА РЕЛИКВИЙ</span>
            <span class="btn-desc-label">Найдено: <b id="menu-relics-count">0 / 24</b></span>
          </div>
        </button>

        <button id="btn-menu-time" class="menu-btn secondary-btn">
          <span class="btn-icon">🌅</span>
          <div class="btn-label-group">
            <span class="btn-main-label">АТМОСФЕРА И ВРЕМЯ</span>
            <span class="btn-desc-label" id="menu-tod-label">Золотой полдень</span>
          </div>
        </button>

        <button id="btn-menu-guide" class="menu-btn secondary-btn">
          <span class="btn-icon">🧭</span>
          <div class="btn-label-group">
            <span class="btn-main-label">УПРАВЛЕНИЕ И СОВЕТЫ</span>
            <span class="btn-desc-label">Зум, светлячок-гид, фото-режим</span>
          </div>
        </button>
      </div>

      <!-- Audio & settings toggles -->
      <div class="menu-footer-bar">
        <button id="btn-menu-audio-toggle" class="icon-toggle active" title="Переключить эмбиент">
          <span id="menu-audio-icon">🎵</span> <span id="menu-audio-text">Звуки природы: ВКЛ</span>
        </button>
        <button id="btn-menu-zen-toggle" class="icon-toggle active" title="Релакс режим">
          <span>🧘</span> <span id="menu-zen-text">Дзен-режим: БЕЗ СПЕШКИ</span>
        </button>
        <button id="btn-menu-settings" class="icon-toggle" title="Настройки генерации и графики">
          <span>⚙️</span> <span>Настройки мира</span>
        </button>
        <button id="btn-menu-reset-cache" class="icon-toggle subtle" title="Очистить кэш игры">
          <span>🔄</span> <span>Перепроверить кэш</span>
        </button>
      </div>
    </div>
  </div>

  <!-- 3. MAIN GAMEPLAY SCREEN (3D CANVAS + HUD) -->
  <div id="screen-game" class="screen">
    <!-- WebGL Canvas -->
    <div id="canvas-container" class="canvas-container">
      <canvas id="three-canvas"></canvas>
    </div>

    <!-- Center Reticle / Cursor -->
    <div id="crosshair" class="crosshair">
      <div class="crosshair-dot"></div>
      <div class="crosshair-ring"></div>
      <div class="crosshair-inspect-hint" id="inspect-hint">Нажмите для сбора реликвии</div>
    </div>

    <!-- Top Navigation & Compass HUD -->
    <div class="game-hud-top">
      <div class="hud-left-group">
        <a href="/games" class="hud-pill-btn" title="Вернуться к каталогу игр">
          <span>← К мини-играм</span>
        </a>
        <button id="btn-hud-menu" class="hud-pill-btn" title="Выйти в меню">
          <span>🏠 Меню</span>
        </button>
        <button id="btn-hud-tod" class="hud-pill-btn" title="Сменить время суток">
          <span id="hud-tod-icon">☀️</span> <span id="hud-tod-name">Полдень</span>
        </button>
        <div id="hud-biome-badge" class="hud-pill-btn biome-pill" title="Текущий биом">
          <span id="hud-biome-icon">🌿</span> <span id="hud-biome-name">Изумрудная Дубрава</span>
        </div>
      </div>

      <!-- Compass Bar -->
      <div class="hud-compass-wrap">
        <div class="compass-marker marker-n">С</div>
        <div class="compass-marker marker-e">В</div>
        <div class="compass-marker marker-s">Ю</div>
        <div class="compass-marker marker-w">З</div>
        <div class="compass-needle" id="compass-needle"></div>
        <div class="compass-relic-ping" id="compass-relic-ping" title="Близость реликвии"></div>
      </div>

      <div class="hud-right-group">
        <div class="relic-counter-pill" id="btn-hud-journal-pill" title="Открыть журнал реликвий">
          <span class="relic-gem-icon">💎</span>
          <span class="relic-num" id="hud-relic-count">0</span>
          <span class="relic-total">/ 24</span>
        </div>
        <button id="btn-hud-settings" class="hud-icon-btn" title="Настройки мира (O)">⚙️</button>
        <button id="btn-hud-photo" class="hud-icon-btn" title="Фото-режим (P)">📷</button>
        <button id="btn-hud-audio" class="hud-icon-btn" title="Звуки природы (M)">🎵</button>
        <button id="btn-hud-pause" class="hud-icon-btn" title="Пауза">⏸️</button>
      </div>
    </div>

    <!-- Biome Discovery Floating Banner -->
    <div id="hud-biome-banner" class="hud-biome-banner" style="display: none;">
      <div class="biome-banner-crest">✨ НОВЫЙ БИОМ ✨</div>
      <div class="biome-banner-title">
        <span id="banner-biome-icon">🌿</span>
        <span id="banner-biome-name">Изумрудная Дубрава</span>
      </div>
      <div id="banner-biome-desc" class="biome-banner-desc">Благодатный край вековых дубов и цветущих полян</div>
    </div>

    <!-- Floating Toast / Whisper message -->
    <div id="hud-whisper" class="hud-whisper" style="display: none;">
      <img id="whisper-avatar" class="whisper-avatar" src="" style="display: none;" />
      <span id="whisper-text">Шепот ветра направляет ваш взор...</span>
    </div>

    <!-- World Construction Loader overlay inside Game -->
    <div id="world-loading-overlay" class="world-loading-overlay" style="display: none;">
      <div class="world-loading-spinner"></div>
      <div class="world-loading-text" id="world-loading-text">Высаживание 3D-леса и расстановка реликвий...</div>
    </div>

    <!-- Bottom Controls & Tool Belt -->
    <div class="game-hud-bottom">
      <!-- Mobile Virtual Joystick Zone (Visible on Touch devices) -->
      <div id="mobile-joystick-zone" class="mobile-joystick-zone">
        <div id="joystick-base" class="joystick-base">
          <div id="joystick-handle" class="joystick-handle"></div>
        </div>
      </div>

      <!-- Tool buttons -->
      <div class="hud-tool-belt">
        <button id="btn-tool-jump" class="tool-btn" title="Прыжок (Пробел)">
          <span class="tool-icon">⬆️</span>
          <span class="tool-title">ПРЫЖОК</span>
          <span class="tool-key">Пробел</span>
        </button>

        <button id="btn-tool-zoom" class="tool-btn" title="Фокусировка взгляда (ПКМ или Z)">
          <span class="tool-icon">🔍</span>
          <span class="tool-title">ФОКУС</span>
          <span class="tool-key">Z / ПКМ</span>
        </button>

        <button id="btn-tool-firefly" class="tool-btn" title="Светлячок-проводник (H)">
          <span class="tool-icon">✨</span>
          <span class="tool-title">СВЕТЛЯЧОК</span>
          <span class="tool-key">H (Подсказка)</span>
          <div id="firefly-cooldown-fill" class="tool-cooldown"></div>
        </button>

        <button id="btn-tool-cam" class="tool-btn" title="Сменить режим камеры (C)">
          <span class="tool-icon" id="cam-tool-icon">🚶</span>
          <span class="tool-title" id="cam-tool-title">ПРОГУЛКА</span>
          <span class="tool-key">Клавиша C</span>
        </button>

        <button id="btn-tool-journal" class="tool-btn" title="Книга находок (J)">
          <span class="tool-icon">📖</span>
          <span class="tool-title">КНИГА</span>
          <span class="tool-key">Клавиша J</span>
        </button>
      </div>
    </div>
  </div>

  <!-- 4. RELIC DISCOVERED MODAL CARD -->
  <div id="modal-relic-found" class="modal-backdrop">
    <div class="modal-card relic-card">
      <div class="card-glow"></div>
      <div class="card-confetti" id="relic-confetti"></div>

      <div class="relic-preview-container">
        <div class="relic-3d-ring"></div>
        <div id="relic-card-icon" class="relic-big-emblem">🍄</div>
      </div>

      <div class="relic-card-header">
        <div class="relic-discovery-tag">СВЯЩЕННАЯ РЕЛИКВИЯ НАЙДЕНА!</div>
        <h2 id="relic-modal-title" class="relic-name">Золотистый Трутовик</h2>
        <div id="relic-modal-location" class="relic-location">📍 Старая Роща • На стволе вековой сосны</div>
      </div>

      <p id="relic-modal-lore" class="relic-lore">
        Редчайший древесный гриб из чащи Альказака. Согласно преданиям лесных монахов, его свечение указывает на скрытые в земле родники.
      </p>

      <div id="relic-modal-perk" class="relic-perk-badge">
        <span class="perk-icon">⚡</span>
        <span id="relic-modal-perk-text">Бонус: Скорость бега увеличена!</span>
      </div>

      <div class="relic-progress-stat">
        <span>Прогресс исследования:</span>
        <b id="relic-modal-counter">1 / 24</b>
      </div>

      <div class="relic-card-actions">
        <button id="btn-relic-collect" class="btn-primary-golden">
          <span>СОХРАНИТЬ В КНИГУ</span>
        </button>
      </div>
    </div>
  </div>

  <!-- 5. RELIC JOURNAL MODAL -->
  <div id="modal-journal" class="modal-backdrop">
    <div class="modal-card journal-card">
      <button class="modal-close-btn" id="btn-close-journal">&times;</button>

      <div class="journal-header">
        <div class="journal-title-wrap">
          <span class="journal-icon">📖</span>
          <h2>КНИГА РЕЛИКВИЙ ЗАПОВЕДНОЙ РОЩИ</h2>
        </div>
        <div class="journal-status-pill">
          Найдено: <b id="journal-found-count">0</b> из 12
        </div>
      </div>

      <!-- Journal Tabs -->
      <div class="journal-nav-tabs">
        <button class="journal-tab-btn active" id="tab-btn-relics">💎 Реликвии (24)</button>
        <button class="journal-tab-btn" id="tab-btn-biomes">🗺️ Атлас Биомов (7)</button>
      </div>

      <div class="journal-grid" id="journal-relics-grid">
        <!-- Rendered via JS -->
      </div>

      <div class="journal-grid atlas-grid" id="journal-biomes-grid" style="display: none;">
        <!-- Rendered via JS -->
      </div>

      <div class="journal-footer">
        <p class="journal-hint">💡 Нажимайте на найденные реликвии, чтобы прочесть их тайную историю. Ненайденные реликвии содержат подсказки о месте их сокрытия.</p>
        <button id="btn-journal-back" class="btn-secondary">ВЕРНУТЬСЯ В ЛЕС</button>
      </div>
    </div>
  </div>

    <!-- 5.5 WORLD SETUP / EXPEDITION PARAMS MODAL -->
  <div id="modal-world-setup" class="modal-backdrop">
    <div class="modal-card world-setup-card">
      <button class="modal-close-btn" id="btn-close-world-setup">&times;</button>
      
      <div class="setup-header">
        <span class="setup-crest">🧭</span>
        <h2>ПАРАМЕТРЫ ЭКСПЕДИЦИИ</h2>
        <p class="modal-sub">Настройте мир перед погружением. Сид и рельеф фиксируются на всё путешествие.</p>
      </div>

      <div class="setup-grid">
        <!-- 1. World Seed -->
        <div class="setting-group seed-group">
          <div class="setting-header">
            <span class="setting-title">🎲 Сид генерации мира</span>
            <span class="setting-sub-hint">Определяет ландшафт, реки, рощи и алтари</span>
          </div>
          <div class="seed-input-row">
            <input type="text" id="input-world-seed" class="seed-input" value="749210" maxlength="12" />
            <button id="btn-random-seed" class="seed-btn-random" title="Сгенерировать случайный сид">🎲 Случайный</button>
          </div>
        </div>

        <!-- 2. Terrain Scale -->
        <div class="setting-group">
          <div class="setting-header">
            <span class="setting-title">⛰️ Рельеф и высота холмов</span>
            <span class="setting-value" id="setup-val-terrain">Живописные холмы (1.0x)</span>
          </div>
          <div class="setting-pills" id="setup-pills-terrain">
            <button class="pill-option" data-val="0.6">Мягкие равнины (0.6x)</button>
            <button class="pill-option active" data-val="1.0">Живописные холмы (1.0x)</button>
            <button class="pill-option" data-val="1.5">Высокие утесы (1.5x)</button>
          </div>
        </div>

        <!-- 3. Foliage Density -->
        <div class="setting-group">
          <div class="setting-header">
            <span class="setting-title">🌲 Густота растительности</span>
            <span class="setting-value" id="setup-val-foliage">Сбалансированная</span>
          </div>
          <div class="setting-pills" id="setup-pills-foliage">
            <button class="pill-option" data-val="0.5">Разреженная</button>
            <button class="pill-option active" data-val="1.0">Сбалансированная</button>
            <button class="pill-option" data-val="1.6">Густая</button>
            <button class="pill-option" data-val="2.2">Пышная чаща</button>
          </div>
        </div>

        <!-- 4. Game Mode -->
        <div class="setting-group">
          <div class="setting-header">
            <span class="setting-title">⚔️ Стиль экспедиции</span>
            <span class="setting-value" id="setup-val-mode">Живое приключение</span>
          </div>
          <div class="setting-pills" id="setup-pills-mode">
            <button class="pill-option active" data-val="adventure">⚔️ Живое приключение (дуэли и турниры)</button>
            <button class="pill-option" data-val="zen">🧘 Дзен-созерцание (мирный лес)</button>
          </div>
        </div>

        <!-- Lock Warning Notice -->
        <div class="setup-lock-notice">
          <span>🔒 Сид, масштаб холмов и густота растительности фиксируются на всю экспедицию. Во время игры можно будет настраивать только дальность прорисовки чанков (для оптимизации FPS).</span>
        </div>
      </div>

      <div class="modal-actions-single" style="margin-top: 1.5rem;">
        <button id="btn-confirm-start-game" class="btn-primary-golden">
          <span>🌲 ОТПРАВИТЬСЯ В ЗАПОВЕДНЫЙ ЛЕС</span>
          <span class="btn-arrow">→</span>
        </button>
      </div>
    </div>
  </div>

  <!-- 6. TIME & ATMOSPHERE MODAL -->
  <div id="modal-time" class="modal-backdrop">
    <div class="modal-card time-card">
      <button class="modal-close-btn" id="btn-close-time">&times;</button>
      <h2>ВЫБОР ВРЕМЕНИ СУТОК И АТМОСФЕРЫ</h2>
      <p class="modal-sub">Настройте освещение, краски неба и настроение леса</p>

      <div class="time-options-grid">
        <div class="time-card-item active" data-tod="noon">
          <div class="tod-preview noon-preview">☀️</div>
          <h3>Золотой Полдень</h3>
          <p>Яркое ласковое солнце, теплая изумрудная листва и золотистые пылинки в воздухе.</p>
        </div>

        <div class="time-card-item" data-tod="sunset">
          <div class="tod-preview sunset-preview">🌅</div>
          <h3>Закатный Бриз</h3>
          <p>Пурпурно-янтарный горизонт, длинные бархатные тени и романтичный закатный покой.</p>
        </div>

        <div class="time-card-item" data-tod="night">
          <div class="tod-preview night-preview">🌙</div>
          <h3>Лунная Сказка</h3>
          <p>Глубокая синяя ночь, мерцающие светлячки, биолюминесценция грибов и звездное небо.</p>
        </div>

        <div class="time-card-item" data-tod="fog">
          <div class="tod-preview fog-preview">🌫️</div>
          <h3>Утренний Туман</h3>
          <p>Пастельные рассветные лучи, пробивающиеся сквозь клубящуюся прохладную дымку.</p>
        </div>
      </div>

      <div class="modal-actions-single">
        <button id="btn-apply-time" class="btn-primary-golden">ПРИМЕНИТЬ АТМОСФЕРУ</button>
      </div>
    </div>
  </div>

  <!-- 8. WORLD GENERATION & GRAPHICS SETTINGS MODAL -->
  <div id="modal-settings" class="modal-backdrop">
    <div class="modal-card settings-card">
      <button class="modal-close-btn" id="btn-close-settings">&times;</button>
      <h2>НАСТРОЙКИ МИРА И ГРАФИКИ</h2>
      <p class="modal-sub">Бесконечная генерация чанков, дальность прорисовки и густота растительности</p>

      <div class="settings-content-grid">
        <!-- 1. Render Distance -->
        <div class="setting-group">
          <div class="setting-header">
            <span class="setting-title">🔭 Дальность прорисовки</span>
            <span class="setting-value" id="val-render-dist">4 чанка (190 м)</span>
          </div>
          <div class="setting-pills" id="group-render-dist">
            <button class="pill-option" data-val="2">2 (Близко • 100м)</button>
            <button class="pill-option active" data-val="4">4 (Баланс • 190м)</button>
            <button class="pill-option" data-val="6">6 (Далеко • 290м)</button>
            <button class="pill-option" data-val="8">8 (Ультра • 390м)</button>
          </div>
        </div>

        <!-- 2. Foliage Density -->
        <div class="setting-group">
          <div class="setting-header">
            <span class="setting-title">🌲 Густота растительности</span>
            <span class="setting-value" id="val-foliage-density">Сбалансированная</span>
          </div>
