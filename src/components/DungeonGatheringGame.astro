  }

  .perk-card {
    background: rgba(30, 41, 59, 0.7);
    border: 2px solid #475569;
    border-radius: 12px;
    padding: 1.2rem 1rem;
    cursor: pointer;
    text-align: center;
    transition: all 0.2s ease;
    display: flex;
    flex-direction: column;
    align-items: center;
    pointer-events: auto;
  }

  .perk-card:hover {
    transform: translateY(-4px);
