  .modal-ribbon.meta { background: #0284c7; }
  .modal-ribbon.defeat { background: #b91c1c; }
  .modal-ribbon.victory { background: #15803d; }

  .modal-heading {
    margin: 0 0 0.4rem 0;
    color: #ffd700;
    font-size: 1.5rem;
    font-weight: 900;
  }

  .text-defeat { color: #ef4444; }
  .text-victory { color: #4ade80; }

  .modal-sub {
    color: #94a3b8;
    font-size: 0.82rem;
    margin-bottom: 1.2rem;
    line-height: 1.4;
  }

  .shop-items-grid, .meta-upgrades-grid, .relics-list-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.8rem;
    margin-bottom: 1rem;
