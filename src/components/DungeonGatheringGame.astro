  }

  .mode-select-row, .difficulty-select-row {
    display: flex;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 0.4rem;
  }

  .diff-chip {
    background: rgba(30, 41, 59, 0.7);
    border: 1.5px solid #475569;
    color: #cbd5e1;
    padding: 6px 14px;
    border-radius: 16px;
    font-size: 0.78rem;
    font-weight: 800;
    cursor: pointer;
    transition: all 0.15s;
    pointer-events: auto;
  }

  .diff-chip:hover {
    border-color: #ffd700;
    color: #ffd700;
  }

  .diff-chip.active {
    background: #ffd700;
    color: #000;
    border-color: #fef08a;
    box-shadow: 0 0 15px rgba(255, 215, 0, 0.4);
  }

  .diff-chip[data-diff="nightmare"].active {
    background: #ef4444;
    color: #fff;
    border-color: #fca5a5;
    box-shadow: 0 0 15px rgba(239, 68, 68, 0.5);
  }

  .diff-chip[data-diff="inferno"].active {
    background: linear-gradient(135deg, #7c3aed 0%, #dc2626 100%);
    color: #fff;
    border-color: #f43f5e;
    box-shadow: 0 0 18px rgba(220, 38, 38, 0.6);
  }

  .diff-hud-badge {
    display: inline-block;
    font-size: 0.55rem;
    font-weight: 900;
    padding: 1px 6px;
    border-radius: 10px;
    background: #334155;
    color: #facc15;
    border: 1px solid #64748b;
    vertical-align: middle;
    margin-left: 4px;
  }

</style>

<script>
  import { loadDungeonAssets, type DungeonAssets } from './dungeon/assets';
  import { DungeonAudio } from './dungeon/audio';
  import { DungeonEngine } from './dungeon/engine';
  import { getRandomPerks, applyPerk, ALL_PERKS } from './dungeon/perks';
  import type { PlayerStats, Enemy, HeroClass, GameMode, DifficultyLevel, MetaUpgrades, ShopKeeper, StartingLoadoutWeapon, StartingPack, Relic, GroundRelic } from './dungeon/types';

  let isInitialized = false;

  function initGame() {
    const root = document.getElementById('dungeon-game-root');
    if (!root || isInitialized) return;
    isInitialized = true;

    const canvas = document.getElementById('game-canvas') as HTMLCanvasElement;
    const minimapCanvas = document.getElementById('minimap-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    let loadedAssets: DungeonAssets | null = null;
    loadDungeonAssets().then((res) => {
      loadedAssets = res;
      ensureEngine().catch(console.warn);
    });

    const audio = new DungeonAudio();

    // Screens
    const screenMenu = document.getElementById('screen-menu');
    const screenGame = document.getElementById('screen-game');

    // Modals
    const modalPerk = document.getElementById('modal-perk');
    const modalPause = document.getElementById('modal-pause');
    const modalGameOver = document.getElementById('modal-gameover');
    const modalVictory = document.getElementById('modal-victory');
    const modalShop = document.getElementById('modal-shop');
    const modalRelics = document.getElementById('modal-relics');
    const modalMeta = document.getElementById('modal-meta');
    const modalCharSheet = document.getElementById('modal-character-sheet');
    const btnShowCharSheet = document.getElementById('btn-show-charsheet');
    const btnCloseCharSheet = document.getElementById('btn-close-charsheet');

    const perkCardsGrid = document.getElementById('perk-cards-grid');
    const shopItemsGrid = document.getElementById('shop-items-grid');
    const relicsListGrid = document.getElementById('relics-list-grid');
    const metaUpgradesGrid = document.getElementById('meta-upgrades-grid');
    const modalRelicSwap = document.getElementById('modal-relic-swap');
    const swapFoundRelicCard = document.getElementById('swap-found-relic-card');
    const swapHeroClassLabel = document.getElementById('swap-hero-class-label');
    const swapSlotsGrid = document.getElementById('swap-slots-grid');
    const btnLeaveRelic = document.getElementById('btn-leave-relic');

    const hudRelicsBar = document.getElementById('hud-relics-bar');
    const hudUltimateBox = document.getElementById('hud-ultimate-box');
    const ultPctDisplay = document.getElementById('ultimate-pct-display');
    const ultChargeBar = document.getElementById('ultimate-charge-bar');

    // Starting Loadout selectors
    const startWeaponStorageKey = 'dungeon_start_weapon';
    const startPackStorageKey = 'dungeon_start_pack';

    let selectedStartingWeapon: StartingLoadoutWeapon = (localStorage.getItem(startWeaponStorageKey) as StartingLoadoutWeapon) || 'default';
    let selectedStartingPack: StartingPack = (localStorage.getItem(startPackStorageKey) as StartingPack) || 'none';

    const selectStartWeapon = document.getElementById('select-start-weapon') as HTMLSelectElement | null;
    if (selectStartWeapon) {
      selectStartWeapon.value = selectedStartingWeapon;
      selectStartWeapon.addEventListener('change', () => {
        selectedStartingWeapon = selectStartWeapon.value as StartingLoadoutWeapon;
        localStorage.setItem(startWeaponStorageKey, selectedStartingWeapon);
      });
    }

    const selectStartPack = document.getElementById('select-start-pack') as HTMLSelectElement | null;
    if (selectStartPack) {
      selectStartPack.value = selectedStartingPack;
      selectStartPack.addEventListener('change', () => {
        selectedStartingPack = selectStartPack.value as StartingPack;
        localStorage.setItem(startPackStorageKey, selectedStartingPack);
      });
    }

    // HUD Elements
    const hudLvl = document.getElementById('hud-hero-lvl');
    const hudHeroName = document.getElementById('hud-hero-name');
    const hudHeroAvatar = document.getElementById('hud-hero-avatar');
    const hudHearts = document.getElementById('hud-hearts-container');
    const hudXp = document.getElementById('hud-hero-xp');
    const hudXpText = document.getElementById('hud-hero-xp-text');
    const hudFloorNum = document.getElementById('hud-floor-num');
    const hudFloorDesc = document.getElementById('hud-floor-desc');
    const hudBossWrap = document.getElementById('hud-boss-wrap');
    const hudBossHp = document.getElementById('hud-boss-hp');
    const resGold = document.getElementById('res-gold-val');
    const resBlue = document.getElementById('res-blue-val');
    const potHpBadge = document.getElementById('pot-hp-count');
    const potSpeedBadge = document.getElementById('pot-speed-count');
    const potPowerBadge = document.getElementById('pot-power-count');
    const dashCdOverlay = document.getElementById('dash-cooldown-overlay');
    const skillCdOverlay = document.getElementById('skill-cooldown-overlay');
    const skillIconDisplay = document.getElementById('skill-icon-display');
    const notificationToast = document.getElementById('hud-notification');
    const promptToast = document.getElementById('hud-interaction-prompt');

    // LocalStorage keys
    const statsStorageKey = 'dungeon_gathering_record';
    const metaStorageKey = 'dungeon_gathering_meta';

    let selectedClass: HeroClass = 'zombie';
    let selectedMode: GameMode = 'campaign';
    let selectedDifficulty: DifficultyLevel = 'normal';
    let engine: DungeonEngine | null = null;

    const loadMeta = (): { blueCoins: number; upgrades: MetaUpgrades } => {
      try {
        const raw = localStorage.getItem(metaStorageKey);
        return raw
          ? JSON.parse(raw)
          : {
              blueCoins: 0,
              upgrades: {
                extraHearts: 0,
                extraDamage: 0,
                extraGold: 0,
                extraLight: 0,
                extraPotions: 0,
                vampireMastery: 0,
                critMastery: 0,
                greedMastery: 0,
                spectralDiscount: 0,
                soulMagnet: 0,
              },
            };
      } catch {
        return {
          blueCoins: 0,
          upgrades: {
            extraHearts: 0,
            extraDamage: 0,
            extraGold: 0,
            extraLight: 0,
            extraPotions: 0,
            vampireMastery: 0,
            critMastery: 0,
            greedMastery: 0,
            spectralDiscount: 0,
            soulMagnet: 0,
          },
        };
      }
    };

    const saveMeta = (data: { blueCoins: number; upgrades: MetaUpgrades }) => {
      try {
        localStorage.setItem(metaStorageKey, JSON.stringify(data));
        updateMetaDisplay();
      } catch {}
    };

    const loadSavedStats = () => {
      try {
        const raw = localStorage.getItem(statsStorageKey);
        return raw ? JSON.parse(raw) : { floor: 1, kills: 0, gold: 0 };
      } catch {
        return { floor: 1, kills: 0, gold: 0 };
      }
    };

    const saveStats = (stats: { floor: number; kills: number; gold: number; blueCoins: number }) => {
      try {
        const prev = loadSavedStats();
        const updated = {
          floor: Math.max(prev.floor, stats.floor),
          kills: prev.kills + stats.kills,
          gold: Math.max(prev.gold, stats.gold),
        };
        localStorage.setItem(statsStorageKey, JSON.stringify(updated));

        const meta = loadMeta();
        meta.blueCoins += stats.blueCoins;
        saveMeta(meta);

        updateMenuStats();
      } catch {}
    };

    const updateMenuStats = () => {
      const s = loadSavedStats();
      const elF = document.getElementById('stat-high-floor');
      const elK = document.getElementById('stat-high-kills');
      const elG = document.getElementById('stat-high-gold');
      if (elF) elF.textContent = String(s.floor);
      if (elK) elK.textContent = String(s.kills);
      if (elG) elG.textContent = String(s.gold);
    };

    const updateMetaDisplay = () => {
      const m = loadMeta();
      const elB1 = document.getElementById('meta-blue-coins-val');
      const elB2 = document.getElementById('meta-modal-blue-val');
      if (elB1) elB1.textContent = String(m.blueCoins);
      if (elB2) elB2.textContent = String(m.blueCoins);
    };

    updateMenuStats();
    updateMetaDisplay();


    const updateHudBadges = () => {
      const modeIcon = document.getElementById('hud-mode-icon');
      const diffBadge = document.getElementById('hud-diff-badge');

      if (modeIcon) {
        modeIcon.textContent =
          selectedMode === 'tutorial'
            ? '🎓'
            : selectedMode === 'boss_rush'
            ? '⚔️'
            : selectedMode === 'endless'
            ? '♾️'
            : '🏰';
      }

      if (diffBadge) {
        const diffLabels: Record<DifficultyLevel, { text: string; bg: string; color: string }> = {
          easy: { text: 'НОВИЧОК', bg: '#064e3b', color: '#6ee7b7' },
          normal: { text: 'НОРМА', bg: '#1e293b', color: '#facc15' },
          nightmare: { text: 'КОШМАР', bg: '#7f1d1d', color: '#fca5a5' },
          inferno: { text: 'ИНФЕРНО', bg: '#581c87', color: '#f43f5e' },
        };
        const d = diffLabels[selectedDifficulty] || diffLabels.normal;
        diffBadge.textContent = d.text;
        diffBadge.style.backgroundColor = d.bg;
        diffBadge.style.color = d.color;
      }
    };

    // Difficulty chips handlers
    document.querySelectorAll('.diff-chip').forEach((chip) => {
      chip.addEventListener('click', (e) => {
        e.preventDefault();
        document.querySelectorAll('.diff-chip').forEach((c) => c.classList.remove('active'));
        chip.classList.add('active');
        selectedDifficulty = (chip.getAttribute('data-diff') as DifficultyLevel) || 'normal';
      });
    });

    // Mode chips handlers
    document.querySelectorAll('.mode-chip').forEach((chip) => {
      chip.addEventListener('click', (e) => {
        e.preventDefault();
        document.querySelectorAll('.mode-chip').forEach((c) => c.classList.remove('active'));
        chip.classList.add('active');
        selectedMode = (chip.getAttribute('data-mode') as GameMode) || 'campaign';
      });
    });

    // Class selection handler with localStorage persistence
    const classStorageKey = 'dungeon_gathering_selected_class';
    const savedClass = localStorage.getItem(classStorageKey) as HeroClass;
    if (savedClass && ['zombie', 'paladin', 'sorcerer', 'berserker', 'assassin'].includes(savedClass)) {
      selectedClass = savedClass;
    }

    document.querySelectorAll('.class-card').forEach((card) => {
      const cls = card.getAttribute('data-class');
      if (cls === selectedClass) {
        card.classList.add('active');
      } else {
        card.classList.remove('active');
      }

      card.addEventListener('click', (e) => {
        e.preventDefault();
        document.querySelectorAll('.class-card').forEach((c) => c.classList.remove('active'));
        card.classList.add('active');
        selectedClass = (card.getAttribute('data-class') as HeroClass) || 'zombie';
        localStorage.setItem(classStorageKey, selectedClass);
      });
    });

    let notifTimeout: any = null;
    const showNotification = (text: string) => {
      if (!notificationToast) return;
      notificationToast.textContent = text;
      notificationToast.classList.add('show');
      if (notifTimeout) clearTimeout(notifTimeout);
      notifTimeout = setTimeout(() => {
        notificationToast.classList.remove('show');
      }, 2500);
    };

    const bottomEvolutionAlert = document.getElementById('hud-bottom-evolution');
    const bottomEvolutionText = document.getElementById('bottom-evolution-text');
    let evolutionTimeout: any = null;

    const showBottomEvolution = (text: string) => {
      if (!bottomEvolutionAlert || !bottomEvolutionText) return;
      bottomEvolutionText.textContent = text;
      bottomEvolutionAlert.classList.add('show');
      if (evolutionTimeout) clearTimeout(evolutionTimeout);
      evolutionTimeout = setTimeout(() => {
        bottomEvolutionAlert.classList.remove('show');
      }, 5500);
    };

    // Engine initialization helper
    const ensureEngine = async () => {
      if (!loadedAssets) {
        loadedAssets = await loadDungeonAssets();
      }

      if (!engine) {
        engine = new DungeonEngine(
          canvas,
          loadedAssets,
          audio,
          {
            onStatsUpdate: (player: PlayerStats, boss?: Enemy | null) => {
              if (hudLvl) hudLvl.textContent = String(player.level);
              if (hudHeroName) {
                const names: Record<HeroClass, string> = {
                  zombie: 'Зомби-Ренегат',
                  paladin: 'Паладин Пепла',
                  sorcerer: 'Теневой Адепт',
                  berserker: 'Кровавый Берсерк',
                  assassin: 'Ассасин Тени',
                };
                hudHeroName.textContent = names[player.heroClass] || 'Герой';
              }

              if (skillIconDisplay) {
                const icons: Record<HeroClass, string> = {
                  zombie: '🧪',
                  paladin: '🛡️',
                  sorcerer: '🔮',
                  berserker: '🪓',
                  assassin: '🗡️',
                };
                skillIconDisplay.textContent = icons[player.heroClass] || '⚡';
              }

              if (hudHeroAvatar) {
                if (player.heroClass === 'paladin') {
                  hudHeroAvatar.style.filter = 'sepia(0.9) hue-rotate(5deg) saturate(3)';
                } else if (player.heroClass === 'sorcerer') {
                  hudHeroAvatar.style.filter = 'hue-rotate(240deg) saturate(2.4)';
                } else if (player.heroClass === 'berserker') {
                  hudHeroAvatar.style.filter = 'hue-rotate(320deg) saturate(3.5)';
                } else if (player.heroClass === 'assassin') {
                  hudHeroAvatar.style.filter = 'brightness(0.7) contrast(1.6) hue-rotate(160deg)';
                } else {
                  hudHeroAvatar.style.filter = 'none';
                }
              }

              if (hudFloorNum) hudFloorNum.textContent = String(player.floor);
              if (hudFloorDesc) {
                hudFloorDesc.textContent =
                  player.floor === 3
                    ? 'Трон Нечестивого Колосса'
                    : player.floor === 6
                    ? 'Катакомбы Чумного Палача'
                    : player.floor === 10
                    ? 'Цитадель Архи-Лича'
                    : 'Темные Катакомбы';
              }
              if (resGold) resGold.textContent = String(player.gold);
              if (resBlue) resBlue.textContent = String(player.blueCoins);

              if (potHpBadge) potHpBadge.textContent = String(player.potions.hp);
              if (potSpeedBadge) potSpeedBadge.textContent = String(player.potions.speed);
              if (potPowerBadge) potPowerBadge.textContent = String(player.potions.power);

              if (hudXp && hudXpText) {
                const pct = Math.min(100, (player.xp / player.nextLevelXp) * 100);
                hudXp.style.width = `${pct}%`;
                hudXpText.textContent = `${player.xp} / ${player.nextLevelXp} XP`;
              }

              if (dashCdOverlay) {
                const cdPct = player.dashTimer > 0 ? (player.dashTimer / player.dashCooldown) * 100 : 0;
                dashCdOverlay.style.height = `${cdPct}%`;
              }

              if (skillCdOverlay) {
                const sPct =
                  player.specialSkillTimer > 0
                    ? (player.specialSkillTimer / player.specialSkillCooldown) * 100
                    : 0;
                skillCdOverlay.style.height = String(sPct) + '%';
              }

              // Update Relics Bar in HUD
              if (hudRelicsBar) {
                let rHtml = '';
                for (let s = 0; s < player.relicSlotsCount; s++) {
                  const r = player.relics[s];
                  if (r) {
                    rHtml += '<div class="hud-relic-slot" title="' + r.name + ': ' + r.desc + '">' + r.icon + '</div>';
                  } else {
                    rHtml += '<div class="hud-relic-slot empty" title="Свободный слот под реликвию">+</div>';
                  }
                }
                hudRelicsBar.innerHTML = rHtml;
              }

              // Update Ultimate HUD Box
              if (hudUltimateBox && ultPctDisplay && ultChargeBar) {
                const uPct = Math.round(player.ultimateCharge);
                ultPctDisplay.textContent = uPct + '%';
                ultChargeBar.style.width = uPct + '%';
                if (uPct >= 100 || player.isUltimateActive) {
                  hudUltimateBox.classList.add('ready');
                } else {
                  hudUltimateBox.classList.remove('ready');
                }
              }

    function getHeartSvg(state: 'full' | 'half' | 'empty'): string {
      const bD = "M2,2h4v1h-4zM10,2h4v1h-4zM1,3h1v1h-1zM6,3h1v1h-1zM9,3h1v1h-1zM14,3h1v1h-1zM0,4h1v1h-1zM7,4h2v1h-2zM15,4h1v1h-1zM0,5h1v1h-1zM15,5h1v1h-1zM0,6h1v1h-1zM15,6h1v1h-1zM1,7h1v1h-1zM14,7h1v1h-1zM1,8h1v1h-1zM14,8h1v1h-1zM2,9h1v1h-1zM13,9h1v1h-1zM3,10h1v1h-1zM12,10h1v1h-1zM4,11h1v1h-1zM11,11h1v1h-1zM5,12h1v1h-1zM10,12h1v1h-1zM6,13h1v1h-1zM9,13h1v1h-1zM7,14h2v1h-2z";
      if (state === 'full') {
        return '<svg class="heart-icon full" viewBox="0 0 16 16" width="16" height="16">' +
          '<path d="' + bD + '" fill="#450a0a"/>' +
          '<path d="M4,3h2v1h-2zM10,3h4v1h-4zM1,4h1v1h-1zM4,4h3v1h-3zM9,4h6v1h-6zM1,5h14v1h-14zM1,6h14v1h-14zM2,7h12v1h-12zM2,8h12v1h-12zM3,9h10v1h-10zM4,10h8v1h-8zM5,11h6v1h-6zM6,12h4v1h-4zM7,13h2v1h-2z" fill="#ef4444"/>' +
          '<path d="M2,3h2v1h-2zM2,4h2v1h-2z" fill="#fca5a5"/>' +
        '</svg>';
      } else if (state === 'half') {
        return '<svg class="heart-icon half" viewBox="0 0 16 16" width="16" height="16">' +
          '<path d="' + bD + '" fill="#1e1b4b"/>' +
          '<path d="M4,3h2v1h-2zM1,4h1v1h-1zM4,4h3v1h-3zM1,5h7v1h-7zM1,6h7v1h-7zM2,7h6v1h-6zM2,8h6v1h-6zM3,9h5v1h-5zM4,10h4v1h-4zM5,11h3v1h-3zM6,12h2v1h-2zM7,13h1v1h-1z" fill="#ef4444"/>' +
          '<path d="M2,3h2v1h-2zM2,4h2v1h-2z" fill="#fca5a5"/>' +
          '<path d="M10,3h4v1h-4zM9,4h6v1h-6zM8,5h7v1h-7zM8,6h7v1h-7zM8,7h6v1h-6zM8,8h6v1h-6zM8,9h5v1h-5zM8,10h4v1h-4zM8,11h3v1h-3zM8,12h2v1h-2zM8,13h1v1h-1z" fill="#1e293b"/>' +
        '</svg>';
      } else {
        return '<svg class="heart-icon empty" viewBox="0 0 16 16" width="16" height="16">' +
          '<path d="' + bD + '" fill="#0f172a"/>' +
          '<path d="M4,3h2v1h-2zM10,3h4v1h-4zM1,4h1v1h-1zM4,4h3v1h-3zM9,4h6v1h-6zM1,5h14v1h-14zM1,6h14v1h-14zM2,7h12v1h-12zM2,8h12v1h-12zM3,9h10v1h-10zM4,10h8v1h-8zM5,11h6v1h-6zM6,12h4v1h-4zM7,13h2v1h-2z" fill="#1e293b"/>' +
        '</svg>';
      }
    }

              if (hudHearts) {
                let heartsHtml = '';
                const totalHearts = Math.ceil(player.maxHp / 2);
                for (let h = 0; h < totalHearts; h++) {
                  const heartHp = player.hp - h * 2;
                  if (heartHp >= 2) {
                    heartsHtml += getHeartSvg('full');
                  } else if (heartHp === 1) {
                    heartsHtml += getHeartSvg('half');
                  } else {
                    heartsHtml += getHeartSvg('empty');
                  }
                }
                hudHearts.innerHTML = heartsHtml;
              }

              if (hudBossWrap && hudBossHp) {
                if (boss && !boss.isDead) {
                  hudBossWrap.style.display = 'block';
                  const bPct = Math.max(0, Math.min(100, (boss.hp / boss.maxHp) * 100));
                  hudBossHp.style.width = `${bPct}%`;
                } else {
                  hudBossWrap.style.display = 'none';
                }
              }
            },

            onLevelUp: () => {
              if (!modalPerk || !perkCardsGrid || !engine) return;
              perkCardsGrid.innerHTML = '';
              const perks = getRandomPerks(3, engine.player);

              perks.forEach((perk) => {
                const card = document.createElement('div');
                card.className = `perk-card ${perk.rarity}`;
                card.innerHTML = `
                  <div class="perk-icon">${perk.icon}</div>
                  <div class="perk-title">${perk.name}</div>
                  <div class="perk-desc">${perk.desc}</div>
                `;
                card.addEventListener('click', () => {
                  if (engine) {
                    applyPerk(perk, engine.player);
                    modalPerk.classList.remove('active');
                    engine.resume();
                    showNotification(`БЛАГОСЛОВЕНИЕ: ${perk.name}!`);
                  }
                });
                perkCardsGrid.appendChild(card);
              });

              modalPerk.classList.add('active');
            },

            onGameOver: (stats) => {
              saveStats(stats);
              if (modalGameOver) {
                const f = document.getElementById('go-floor-val');
                const k = document.getElementById('go-kills-val');
                const g = document.getElementById('go-gold-val');
                const b = document.getElementById('go-blue-val');
                if (f) f.textContent = String(stats.floor);
                if (k) k.textContent = String(stats.kills);
                if (g) g.textContent = String(stats.gold);
                if (b) b.textContent = `+${stats.blueCoins} 💎`;
                modalGameOver.classList.add('active');
              }
            },

            onVictory: (stats) => {
              saveStats(stats);
              if (modalVictory) {
                const ribbon = modalVictory.querySelector('.modal-ribbon');
                const heading = modalVictory.querySelector('.modal-heading');
                const sub = modalVictory.querySelector('.modal-sub');

                if (selectedMode === 'tutorial') {
                  if (ribbon) ribbon.textContent = 'КУРС МОЛОДОГО БОЙЦА';
                  if (heading) heading.textContent = 'ТРЕНИРОВКА ЗАВЕРШЕНА!';
                  if (sub) sub.textContent = 'Вы изучили все основы движения, стрельбы сферами и магии! Катакомбы ждут вашего подвига!';
                } else if (selectedMode === 'boss_rush') {
                  if (ribbon) ribbon.textContent = 'ВЕЛИЧАЙШИЙ ТРИУМФ';
                  if (heading) heading.textContent = 'БОСС-РАШ ПОКОРЁН!';
                  if (sub) sub.textContent = 'Невероятно! Все 5 владык катакомб пали под натиском вашей мощи!';
                } else {
                  if (ribbon) ribbon.textContent = 'ВЕЛИКИЙ ТРИУМФ';
                  if (heading) heading.textContent = 'ВЛАДЫКА СКЛЕПА ПОВЕРЖЕН!';
                  if (sub) sub.textContent = 'Катакомбы очищены от скверны! Легенда о вашем подвиге разнеслась по всему МоррисГраду!';
                }

                const f = document.getElementById('vic-floor-val');
                const k = document.getElementById('vic-kills-val');
                const g = document.getElementById('vic-gold-val');
                const b = document.getElementById('vic-blue-val');
                if (f) f.textContent = String(stats.floor);
                if (k) k.textContent = String(stats.kills);
                if (g) g.textContent = String(stats.gold);
                if (b) b.textContent = `+${stats.blueCoins} 💎`;
                modalVictory.classList.add('active');
              }
            },

            onNotify: (text: string) => {
              showNotification(text);
            },

            onEvolutionNotify: (text: string) => {
              showBottomEvolution(text);
            },

            
            onRelicFound: (gr: GroundRelic) => {
              if (engine) engine.pause();
              if (!modalRelicSwap || !swapFoundRelicCard || !swapSlotsGrid || !engine) return;

              const r = gr.relic;
              const rColor = r.rarity === 'legendary' ? '#fb923c' : r.rarity === 'epic' ? '#c084fc' : '#38bdf8';

              swapFoundRelicCard.innerHTML = `
                <div class="found-relic-icon" style="color: ${rColor}">${r.icon}</div>
                <div class="found-relic-info">
                  <h3>${r.name}</h3>
                  <span class="found-relic-rarity" style="background: ${rColor}33; color: ${rColor}; border: 1px solid ${rColor}">
                    ${r.rarity.toUpperCase()} РЕЛИКВИЯ
                  </span>
                  <div class="found-relic-desc">${r.desc}</div>
                </div>
              `;

              if (swapHeroClassLabel) {
                const classSlotNames: Record<HeroClass, string> = {
                  sorcerer: 'Маг (3 слота)',
                  berserker: 'Берсерк (1 слот)',
                  zombie: 'Зомби (2 слота)',
                  paladin: 'Паладин (2 слота)',
                  assassin: 'Ассасин (2 слота)',
                };
                swapHeroClassLabel.textContent = classSlotNames[engine.player.heroClass] || '2 слота';
              }

              swapSlotsGrid.innerHTML = '';
              const slotsCount = engine.player.relicSlotsCount;

              for (let s = 0; s < slotsCount; s++) {
                const curRelic = engine.player.relics[s];
                const slotCard = document.createElement('div');
                slotCard.className = 'swap-slot-card';

                if (curRelic) {
                  slotCard.innerHTML = `
                    <div class="swap-slot-header">СЛОТ ${s + 1} (ЗАНЯТ)</div>
                    <div class="swap-current-relic">
                      <span style="font-size: 1.5rem;">${curRelic.icon}</span>
                      <b>${curRelic.name}</b>
                      <small style="color: #94a3b8; font-size: 0.65rem;">${curRelic.desc.substring(0, 45)}...</small>
                    </div>
                    <button class="btn-assign-slot" style="background: #ef4444; color: #fff;">
                      🔄 ЗАМЕНИТЬ
                    </button>
                  `;
                } else {
                  slotCard.innerHTML = `
                    <div class="swap-slot-header">СЛОТ ${s + 1} (СВОБОДЕН)</div>
                    <div class="swap-current-relic" style="opacity: 0.5;">
                      <span style="font-size: 1.5rem;">➕</span>
                      <i>Пустой слот</i>
                    </div>
                    <button class="btn-assign-slot">
                      ⬇️ ПОМЕСТИТЬ
                    </button>
                  `;
                }

                const btn = slotCard.querySelector('.btn-assign-slot') as HTMLButtonElement;
                btn.addEventListener('click', () => {
                  if (engine) {
                    engine.equipRelic(s, gr.relic, gr.id);
                    modalRelicSwap.classList.remove('active');
                    engine.resume();
                  }
                });

                swapSlotsGrid.appendChild(slotCard);
              }

              modalRelicSwap.classList.add('active');
            },

            onUltimateTrigger: (name: string) => {
              showNotification(name);
            },

            onPrompt: (text: string | null) => {
              if (!promptToast) return;
              if (text) {
                promptToast.textContent = text;
                promptToast.style.display = 'block';
              } else {
                promptToast.style.display = 'none';
              }
            },

            onShopOpen: (shop: ShopKeeper) => {
              if (engine) engine.pause();
              if (!modalShop || !shopItemsGrid) return;
              shopItemsGrid.innerHTML = '';

              shop.items.forEach((item) => {
                const card = document.createElement('div');
                card.className = 'shop-item-card';
                card.innerHTML = `
                  <div class="item-left">
                    <span class="item-icon">${item.icon}</span>
                    <div>
                      <div class="item-title">${item.name}</div>
                      <div class="item-desc">${item.desc}</div>
                    </div>
                  </div>
                  <button class="btn-buy-item" data-cost="${item.cost}">${item.cost} 🪙</button>
                `;

                const btn = card.querySelector('.btn-buy-item') as HTMLButtonElement;
                btn.addEventListener('click', () => {
                  if (engine && engine.player.gold >= item.cost) {
                    engine.player.gold -= item.cost;
                    audio.playShopBuy();

                    if (item.id === 'pot_hp') engine.player.potions.hp++;
                    else if (item.id === 'pot_speed') engine.player.potions.speed++;
                    else if (item.id === 'pot_power') engine.player.potions.power++;
                    else if (item.id === 'stat_heart') {
                      engine.player.maxHp += 2;
                      engine.player.hp += 2;
                    } else if (item.id === 'stat_blade') {
                      engine.player.damage += 5;
                    } else if (item.id === 'stat_boots') {
                      engine.player.speed += 20;
                    } else if (item.id === 'soul_pack') {
                      engine.player.blueCoins += 2;
                    }

                    showNotification(`КУПЛЕНО: ${item.name}!`);
                    btn.disabled = true;
                    btn.textContent = 'КУПЛЕНО';
                    btn.style.opacity = '0.5';
                  } else {
                    showNotification('НЕДОСТАТОЧНО ЗОЛОТА!');
                  }
                });

                shopItemsGrid.appendChild(card);
              });

              modalShop.classList.add('active');
            },
          },
          minimapCanvas
        );
      }
    };

    // Close Shop
    const btnCloseShop = document.getElementById('btn-close-shop');
    if (btnCloseShop) {
      btnCloseShop.addEventListener('click', () => {
        if (modalShop) modalShop.classList.remove('active');
      if (modalRelicSwap) modalRelicSwap.classList.remove('active');
        if (engine) engine.resume();
      });
    }

    // Relic Inventory

    
    if (btnLeaveRelic) {
      btnLeaveRelic.addEventListener('click', () => {
        if (modalRelicSwap) modalRelicSwap.classList.remove('active');
        if (engine) engine.resume();
      });
    }

    if (hudUltimateBox) {
      hudUltimateBox.addEventListener('click', () => {
        if (engine) engine.triggerUltimate();
      });
    }

    // Character Sheet (Tab) Logic
    const updateCharacterSheet = () => {
      if (!engine) return;
      const p = engine.player;
      const wpn = p.equippedWeapon;

      const elLvl = document.getElementById('cs-hero-level');
      if (elLvl) elLvl.textContent = String(p.level);

      const elName = document.getElementById('cs-hero-name');
      if (elName) {
        const classNames: Record<HeroClass, string> = {
          zombie: 'Зомби-Ренегат',
          paladin: 'Паладин Пепла',
          sorcerer: 'Теневой Адепт',
          berserker: 'Кровавый Берсерк',
          assassin: 'Ассасин Тени',
        };
        elName.textContent = classNames[p.heroClass] || 'Пробуждённый';
      }

      const elHp = document.getElementById('cs-hp');
      if (elHp) elHp.textContent = `${p.hp} / ${p.maxHp}`;

      const elDmg = document.getElementById('cs-damage');
      if (elDmg) {
        const dps = (p.damage / p.attackCooldown).toFixed(0);
        elDmg.textContent = `${p.damage} (${dps} DPS)`;
      }

      const elAtkSpd = document.getElementById('cs-atk-speed');
      if (elAtkSpd) elAtkSpd.textContent = `${(1 / p.attackCooldown).toFixed(1)} /сек (${p.attackCooldown.toFixed(2)}с)`;

      const elArmor = document.getElementById('cs-armor');
      if (elArmor) elArmor.textContent = `${p.armor} (снижение урона)`;

      const elCrit = document.getElementById('cs-crit-chance');
      if (elCrit) elCrit.textContent = `${Math.round(p.critChance * 100)}%`;

      const elCritM = document.getElementById('cs-crit-mult');
      if (elCritM) elCritM.textContent = `${p.critMult.toFixed(1)}x`;

      const elVamp = document.getElementById('cs-lifesteal');
      if (elVamp) elVamp.textContent = `${Math.round(p.lifestealChance * 100)}%`;

      const elSpd = document.getElementById('cs-speed');
      if (elSpd) elSpd.textContent = `${Math.round(p.speed)}`;

      const elLight = document.getElementById('cs-light');
      if (elLight) elLight.textContent = `+${Math.round(p.bonusLightRadius)} px`;

      const elKills = document.getElementById('cs-kills');
      if (elKills) elKills.textContent = `${engine.totalKills}`;

      
      // Active Relics list in Character Sheet
      const relicsGrid = document.getElementById('cs-relics-grid');
      const synBadge = document.getElementById('cs-synergy-badge');
      if (relicsGrid) {
        let rGridHtml = '';
        for (let s = 0; s < p.relicSlotsCount; s++) {
          const r = p.relics[s];
          if (r) {
            rGridHtml += `
              <div class="cs-relic-chip" title="${r.desc}">
                <span>${r.icon}</span>
                <b>${r.name}</b>
              </div>
            `;
          } else {
            rGridHtml += `
              <div class="cs-relic-chip" style="opacity: 0.4; border-style: dashed;">
                <span>➕</span>
                <i>Слот ${s + 1} свободен</i>
              </div>
            `;
          }
        }
        relicsGrid.innerHTML = rGridHtml;
      }

      if (synBadge) {
        if (p.activeSynergy) {
          synBadge.style.display = 'block';
          synBadge.textContent = p.activeSynergy;
        } else {
          synBadge.style.display = 'none';
        }
      }

      // Equipped Weapon Card
      const wpnCard = document.getElementById('cs-weapon-card');
      if (wpnCard && wpn) {
        const rarities: Record<string, { main: string; glow: string; label: string }> = {
          common: { main: '#e2e8f0', glow: 'rgba(226, 232, 240, 0.4)', label: 'Обычное' },
          magic: { main: '#38bdf8', glow: 'rgba(56, 189, 248, 0.6)', label: 'Магическое' },
          rare: { main: '#facc15', glow: 'rgba(250, 204, 21, 0.7)', label: 'Редкое' },
          legendary: { main: '#fb923c', glow: 'rgba(251, 146, 60, 0.9)', label: 'Легендарное' },
        };
        const rarityInfo = rarities[wpn.rarity] || rarities.common;

        let affixesHtml = '';
        if (wpn.affixes.length === 0) {
          affixesHtml = '<div class="cs-no-affix">Обычное оружие без зачарований</div>';
        } else {
          affixesHtml = wpn.affixes
            .map(
              (a) =>
                `<div class="cs-affix-row">
                  <span class="cs-affix-name">• ${a.name}:</span>
                  <span class="cs-affix-desc">${a.desc}</span>
                </div>`
            )
            .join('');
        }

        const projDesc = wpn.projectile
          ? `<div class="cs-wpn-stat-row">
              <span>🔮 Снаряд:</span>
              <b>${wpn.projectile.isMagicOrb ? 'Магическая Сфера' : 'Стрела'} (Пробивает ${wpn.projectile.pierce}${wpn.projectile.multishot ? ` x${wpn.projectile.multishot}` : ''})</b>
            </div>`
          : '';

        wpnCard.innerHTML = `
          <div class="cs-wpn-header" style="border-color: ${rarityInfo.main}; box-shadow: 0 0 15px ${rarityInfo.glow};">
            <div class="cs-wpn-icon-wrap">${wpn.svgIcon}</div>
            <div class="cs-wpn-title-col">
              <h4 class="cs-wpn-name" style="color: ${rarityInfo.main}">${wpn.name} +${wpn.level}</h4>
              <span class="cs-wpn-rarity-badge" style="background: ${rarityInfo.glow}; color: ${rarityInfo.main}; border-color: ${rarityInfo.main}">
                ${rarityInfo.label.toUpperCase()} • ${wpn.type.toUpperCase()}
              </span>
            </div>
          </div>
          <div class="cs-wpn-stats-body">
            <div class="cs-wpn-stat-row"><span>⚔️ Базовый урон:</span> <b>${wpn.bonusDamage}</b></div>
            <div class="cs-wpn-stat-row"><span>⚡ Задержка атаки:</span> <b>${wpn.attackCooldown.toFixed(2)} с</b></div>
            <div class="cs-wpn-stat-row"><span>📏 Радиус действия:</span> <b>${wpn.attackRange} px</b></div>
            ${projDesc}
          </div>
          <div class="cs-wpn-affixes-box">
            <div class="cs-affixes-title">МАГИЧЕСКИЕ АФФИКСЫ И МОДИФИКАТОРЫ:</div>
            ${affixesHtml}
          </div>
        `;
      }

      // Perks list
      const perksContainer = document.getElementById('cs-perks-list');
      if (perksContainer) {
        if (p.perks.length === 0) {
          perksContainer.innerHTML = '<div class="cs-no-affix">Благословения ещё не получены. Повышайте уровень в бою!</div>';
        } else {
          perksContainer.innerHTML = p.perks
            .map((perkId) => {
              const perk = ALL_PERKS.find((item) => item.id === perkId);
              if (!perk) return '';
              return `
                <div class="cs-perk-chip" title="${perk.desc}">
                  <span class="chip-icon">${perk.icon}</span>
                  <div class="chip-text">
                    <b>${perk.name}</b>
                    <small>${perk.desc}</small>
                  </div>
                </div>
              `;
            })
            .join('');
        }
      }
    };

    const toggleCharacterSheet = () => {
      if (!modalCharSheet || !engine) return;
      const isOpen = modalCharSheet.classList.contains('active');
      if (isOpen) {
        modalCharSheet.classList.remove('active');
        engine.resume();
      } else {
        engine.pause();
        updateCharacterSheet();
        modalCharSheet.classList.add('active');
      }
    };

    if (btnShowCharSheet) btnShowCharSheet.addEventListener('click', toggleCharacterSheet);
    if (btnCloseCharSheet) btnCloseCharSheet.addEventListener('click', toggleCharacterSheet);

    const btnShowRelics = document.getElementById('btn-show-relics');
    if (btnShowRelics) {
      btnShowRelics.addEventListener('click', () => {
        if (engine) engine.pause();
        if (!modalRelics || !relicsListGrid) return;
        relicsListGrid.innerHTML = '';

        if (!engine || engine.player.perks.length === 0) {
          relicsListGrid.innerHTML =
            '<div style="grid-column: 1/-1; text-align: center; color: #94a3b8; padding: 2rem;">Пока нет собранных благословений. Повышайте уровень в бою!</div>';
        } else {
          engine.player.perks.forEach((pid) => {
            const p = ALL_PERKS.find((x) => x.id === pid);
            if (p) {
              const card = document.createElement('div');
              card.className = 'relic-item-card';
              card.innerHTML = `
                <div class="item-left">
                  <span class="item-icon">${p.icon}</span>
                  <div>
                    <div class="item-title">${p.name}</div>
                    <div class="item-desc">${p.desc}</div>
                  </div>
                </div>
              `;
              relicsListGrid.appendChild(card);
            }
          });
        }
        modalRelics.classList.add('active');
      });
    }

    const btnCloseRelics = document.getElementById('btn-close-relics');
    if (btnCloseRelics) {
      btnCloseRelics.addEventListener('click', () => {
        if (modalRelics) modalRelics.classList.remove('active');
        if (engine) engine.resume();
      });
    }

    // Meta Altar
    const btnOpenMeta = document.getElementById('btn-open-meta');
    if (btnOpenMeta) {
      btnOpenMeta.addEventListener('click', (e) => {
        e.preventDefault();
        if (!modalMeta || !metaUpgradesGrid) return;
        renderMetaGrid();
        modalMeta.classList.add('active');
      });
    }

    const btnCloseMeta = document.getElementById('btn-close-meta');
    if (btnCloseMeta) {
      btnCloseMeta.addEventListener('click', (e) => {
        e.preventDefault();
        if (modalMeta) modalMeta.classList.remove('active');
      });
    }

    const renderMetaGrid = () => {
      if (!metaUpgradesGrid) return;
      metaUpgradesGrid.innerHTML = '';
      const meta = loadMeta();

      const upgradesList = [
        {
          key: 'extraHearts' as keyof MetaUpgrades,
          name: 'Стойкость Духа',
          desc: '+1 сердце (2 HP) на старте каждого похода.',
          max: 3,
          costs: [5, 10, 20],
          icon: '💖',
        },
        {
          key: 'extraDamage' as keyof MetaUpgrades,
          name: 'Закалка Клинка',
          desc: '+3 базового урона для всех атак.',
          max: 3,
          costs: [4, 9, 18],
          icon: '🗡️',
        },
        {
          key: 'extraGold' as keyof MetaUpgrades,
          name: 'Тайник Грабителя',
          desc: 'Старт с +35 золотыми монетами.',
          max: 3,
          costs: [3, 7, 15],
          icon: '🪙',
        },
        {
          key: 'extraLight' as keyof MetaUpgrades,
          name: 'Глаз Бездны',
          desc: '+25% к радиусу света фонаря и видимости.',
          max: 2,
          costs: [4, 12],
          icon: '👁️',
        },
        {
          key: 'extraPotions' as keyof MetaUpgrades,
          name: 'Пояс Алхимика',
          desc: 'Старт с +1 зельем здоровья и +1 зельем мощи.',
          max: 2,
          costs: [6, 16],
          icon: '🧪',
        },
        {
          key: 'vampireMastery' as keyof MetaUpgrades,
          name: 'Кровавая Жатва',
          desc: '+5% к шансу похищения здоровья при каждом ударе.',
          max: 3,
          costs: [5, 12, 25],
          icon: '🩸',
        },
        {
          key: 'critMastery' as keyof MetaUpgrades,
          name: 'Интуиция Смерти',
          desc: '+4% к шансу крита и увеличение критического множителя.',
          max: 3,
          costs: [4, 10, 22],
          icon: '🎯',
        },
        {
          key: 'spectralDiscount' as keyof MetaUpgrades,
          name: 'Спектральная Скидка',
          desc: 'Снижает цены на товары в лавке торговца на 15% за уровень.',
          max: 2,
          costs: [6, 18],
          icon: '🏷️',
        },
        {
          key: 'soulMagnet' as keyof MetaUpgrades,
          name: 'Магнит Душ',
          desc: 'Притягивает золотые монеты и синие души с увеличенной дистанции.',
          max: 2,
          costs: [5, 15],
          icon: '🧲',
        },

      ];

      upgradesList.forEach((upg) => {
        const lvl = meta.upgrades[upg.key];
        const cost = upg.costs[lvl];
        const isMax = lvl >= upg.max;

        const card = document.createElement('div');
        card.className = 'meta-item-card';
        card.innerHTML = `
          <div class="item-left">
            <span class="item-icon">${upg.icon}</span>
            <div>
              <div class="item-title">${upg.name} (${lvl}/${upg.max})</div>
              <div class="item-desc">${upg.desc}</div>
            </div>
          </div>
          <button class="btn-buy-item" ${isMax ? 'disabled' : ''}>
            ${isMax ? 'МАКС.' : `${cost} 💎`}
          </button>
        `;

        if (!isMax) {
          const btn = card.querySelector('.btn-buy-item') as HTMLButtonElement;
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            if (meta.blueCoins >= cost) {
              meta.blueCoins -= cost;
              meta.upgrades[upg.key]++;
              saveMeta(meta);
              audio.playShopBuy();
              renderMetaGrid();
            } else {
              showNotification('НЕДОСТАТОЧНО СИНИХ ДУШ!');
            }
          });
        }

        metaUpgradesGrid.appendChild(card);
      });

      updateMetaDisplay();
    };

    // Start Button
    const btnStart = document.getElementById('btn-start-game') as HTMLButtonElement | null;
    if (btnStart) {
      btnStart.addEventListener('click', async (e) => {
        e.preventDefault();
        if (btnStart.disabled) return;
        btnStart.disabled = true;
        audio.init();

        const btnMainText = btnStart.querySelector('.btn-main-text');
        if (btnMainText) btnMainText.textContent = 'ВХОД В СКЛЕП...';

        try {
          await ensureEngine();

          if (screenMenu) screenMenu.classList.remove('active');
          if (screenGame) screenGame.classList.add('active');

          if (engine) {
            const meta = loadMeta();
            engine.setHeroClass(selectedClass);
            engine.setGameMode(selectedMode);
            engine.setDifficulty(selectedDifficulty);
            engine.setMetaUpgrades(meta.upgrades);
            engine.setStartingLoadout(selectedStartingWeapon, selectedStartingPack);
            engine.initFloor(1, true);
            engine.start();
            updateHudBadges();
          }
        } catch (err) {
          console.error('Failed to launch game engine:', err);
        } finally {
          if (btnMainText) btnMainText.textContent = 'СПУСТИТЬСЯ В СКЛЕП';
          btnStart.disabled = false;
        }
      });
    }

    // Sound toggle
    const btnSound = document.getElementById('btn-toggle-sound');
    if (btnSound) {
      btnSound.addEventListener('click', () => {
        const isMuted = audio.toggleMute();
        btnSound.textContent = isMuted ? '🔇' : '🔊';
      });
    }

    // Pause button
    const btnPause = document.getElementById('btn-pause');
    if (btnPause) {
      btnPause.addEventListener('click', () => {
        if (engine) engine.pause();
        if (modalPause) modalPause.classList.add('active');
      });
    }

    const btnResume = document.getElementById('btn-resume');
    if (btnResume) {
      btnResume.addEventListener('click', () => {
        if (modalPause) modalPause.classList.remove('active');
        if (engine) engine.resume();
      });
    }

    const restartGame = () => {
      if (modalPause) modalPause.classList.remove('active');
      if (modalGameOver) modalGameOver.classList.remove('active');
      if (modalVictory) modalVictory.classList.remove('active');
      if (modalPerk) modalPerk.classList.remove('active');
      if (modalShop) modalShop.classList.remove('active');
      if (modalRelics) modalRelics.classList.remove('active');
      if (modalCharSheet) modalCharSheet.classList.remove('active');
      if (screenMenu) screenMenu.classList.remove('active');
      if (screenGame) screenGame.classList.add('active');

      if (engine) {
        const meta = loadMeta();
        engine.setHeroClass(selectedClass);
        engine.setGameMode(selectedMode);
        engine.setDifficulty(selectedDifficulty);
        engine.setMetaUpgrades(meta.upgrades);
        engine.setStartingLoadout(selectedStartingWeapon, selectedStartingPack);
        engine.initFloor(1, true);
        engine.resume();
        updateHudBadges();
      }
    };

    const btnRestart = document.getElementById('btn-restart');
    if (btnRestart) btnRestart.addEventListener('click', restartGame);

    const btnTryAgain = document.getElementById('btn-try-again');
    if (btnTryAgain) btnTryAgain.addEventListener('click', restartGame);

    const btnVicRestart = document.getElementById('btn-vic-restart');
    if (btnVicRestart) btnVicRestart.addEventListener('click', restartGame);

    const returnToMenu = () => {
      if (engine) engine.stop();
      if (modalPause) modalPause.classList.remove('active');
      if (modalGameOver) modalGameOver.classList.remove('active');
      if (modalVictory) modalVictory.classList.remove('active');
      if (modalShop) modalShop.classList.remove('active');
      if (modalRelics) modalRelics.classList.remove('active');
      if (modalCharSheet) modalCharSheet.classList.remove('active');
      if (screenGame) screenGame.classList.remove('active');
      if (screenMenu) screenMenu.classList.add('active');
      updateMenuStats();
      updateMetaDisplay();
    };

    const btnToMenu = document.getElementById('btn-to-menu');
    if (btnToMenu) btnToMenu.addEventListener('click', returnToMenu);

    const btnGoMenu = document.getElementById('btn-go-menu');
    if (btnGoMenu) btnGoMenu.addEventListener('click', returnToMenu);

    const btnVicMenu = document.getElementById('btn-vic-menu');
    if (btnVicMenu) btnVicMenu.addEventListener('click', returnToMenu);

    // Potions & Skills Clicks
    const slotHp = document.getElementById('slot-pot-hp');
    if (slotHp) slotHp.addEventListener('click', () => engine?.usePotion('hp'));

    const slotSpeed = document.getElementById('slot-pot-speed');
    if (slotSpeed) slotSpeed.addEventListener('click', () => engine?.usePotion('speed'));

    const slotPower = document.getElementById('slot-pot-power');
    if (slotPower) slotPower.addEventListener('click', () => engine?.usePotion('power'));

    const hudDash = document.getElementById('hud-dash-box');
    if (hudDash) hudDash.addEventListener('click', () => engine?.performDash());

    const hudSkill = document.getElementById('hud-skill-box');
    if (hudSkill) hudSkill.addEventListener('click', () => engine?.performSpecialSkill());

    window.addEventListener('resize', () => engine?.resizeCanvas());

    // Input Listeners
    window.addEventListener('keydown', (e) => {
      if (!engine) return;
      engine.keys.add(e.code);

      if (e.code === 'Tab') {
        e.preventDefault();
        toggleCharacterSheet();
        return;
      } else if (e.code === 'Escape') {
        if (modalCharSheet?.classList.contains('active')) {
          toggleCharacterSheet();
          return;
        }
      }

      if (e.code === 'KeyM') {
        if (modalPause?.classList.contains('active')) {
          modalPause.classList.remove('active');
          engine.resume();
        } else {
          engine.pause();
          modalPause?.classList.add('active');
        }
      } else if (e.code === 'KeyI') {
        btnShowRelics?.click();
      } else if (e.code === 'KeyR') {
        engine.triggerUltimate();
      } else if (e.code === 'KeyQ') {
        engine.performSpecialSkill();
      } else if (e.code === 'Digit1') {
        engine.usePotion('hp');
      } else if (e.code === 'Digit2') {
        engine.usePotion('speed');
      } else if (e.code === 'Digit3') {
        engine.usePotion('power');
      } else if (e.code === 'Space' || e.code === 'ShiftLeft' || e.code === 'ShiftRight') {
        engine.performDash();
      }
    });

    window.addEventListener('keyup', (e) => {
      if (engine) engine.keys.delete(e.code);
    });

    const updateMousePos = (e: MouseEvent) => {
      if (!engine) return;
      const rect = canvas.getBoundingClientRect();
      const zoom = engine.camera.zoom;
      engine.mouse.x = e.clientX - rect.left;
      engine.mouse.y = e.clientY - rect.top;

      engine.mouse.worldX =
        (engine.mouse.x - rect.width / 2) / zoom + engine.camera.x;
      engine.mouse.worldY =
        (engine.mouse.y - rect.height / 2) / zoom + engine.camera.y;
    };

    canvas.addEventListener('mousemove', updateMousePos);

    canvas.addEventListener('mousedown', (e) => {
      if (!engine) return;
      updateMousePos(e); // Sync aim coordinates immediately on click!

      if (e.button === 0) {
        engine.mouse.isDown = true;
        engine.performAttack();
      } else if (e.button === 2) {
        e.preventDefault();
        engine.performSpecialSkill();
      }
    });

    window.addEventListener('mouseup', () => {
      if (engine) engine.mouse.isDown = false;
    });

    canvas.addEventListener('contextmenu', (e) => e.preventDefault());

    // Mobile Virtual Joystick
    const joystickBase = document.getElementById('virtual-joystick');
    const joystickThumb = document.getElementById('joystick-knob');
    if (joystickBase && joystickThumb) {
      let touchId: number | null = null;
      let startX = 0;
      let startY = 0;

      joystickBase.addEventListener('touchstart', (e) => {
        if (!engine) return;
        const touch = e.changedTouches[0];
        touchId = touch.identifier;
        const rect = joystickBase.getBoundingClientRect();
        startX = rect.left + rect.width / 2;
        startY = rect.top + rect.height / 2;
        engine.touchMove.active = true;
      });

      const handleTouchMove = (e: TouchEvent) => {
        if (touchId === null || !engine) return;
        for (let i = 0; i < e.changedTouches.length; i++) {
          const t = e.changedTouches[i];
          if (t.identifier === touchId) {
            const dx = t.clientX - startX;
            const dy = t.clientY - startY;
            const dist = Math.hypot(dx, dy);
            const maxDist = 35;
            const clampedDist = Math.min(dist, maxDist);
            const angle = Math.atan2(dy, dx);

            const knobX = Math.cos(angle) * clampedDist;
            const knobY = Math.sin(angle) * clampedDist;

            joystickThumb.style.transform = `translate(${knobX}px, ${knobY}px)`;
            engine.touchMove.dx = dx / (dist || 1);
            engine.touchMove.dy = dy / (dist || 1);
          }
        }
      };

      const handleTouchEnd = (e: TouchEvent) => {
        if (touchId === null || !engine) return;
        for (let i = 0; i < e.changedTouches.length; i++) {
          if (e.changedTouches[i].identifier === touchId) {
            touchId = null;
            engine.touchMove.active = false;
            engine.touchMove.dx = 0;
            engine.touchMove.dy = 0;
            joystickThumb.style.transform = 'translate(0px, 0px)';
          }
        }
      };

      window.addEventListener('touchmove', handleTouchMove, { passive: true });
      window.addEventListener('touchend', handleTouchEnd);
      window.addEventListener('touchcancel', handleTouchEnd);
    }

    const touchAtk = document.getElementById('touch-btn-attack');
    if (touchAtk) touchAtk.addEventListener('touchstart', () => engine?.performAttack());

    const touchSkill = document.getElementById('touch-btn-skill');
    if (touchSkill) touchSkill.addEventListener('touchstart', () => engine?.performSpecialSkill());

    const touchDash = document.getElementById('touch-btn-dash');
    if (touchDash) touchDash.addEventListener('touchstart', () => engine?.performDash());

    const touchPot = document.getElementById('touch-btn-potion');
    if (touchPot) touchPot.addEventListener('touchstart', () => engine?.usePotion('hp'));
  }

  // Support both DOMContentLoaded and astro:page-load seamlessly
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initGame);
  } else {
    initGame();
  }
  document.addEventListener('astro:page-load', () => {
    isInitialized = false;
    initGame();
  });
</script>
