---
// DungeonGatheringGame.astro - "Dungeon Gathering: Катакомбы Склепа v2.5"
// Ультимативный Action-Роглайт с классами, режимами, мета-прогрессией и магазином
---

<div id="dungeon-game-root" class="dungeon-game-root">
  <!-- START / MENU SCREEN -->
  <div id="screen-menu" class="game-screen active">
    <div class="menu-overlay">
      <div class="menu-header-ribbon">
        <span class="ribbon-text">DUNGEON GATHERING • МОРРИСГРАД</span>
      </div>

      <div class="title-emblem-wrap">
        <img
          src="/Dungeon%20Gathering%20Free%20Version/Zombies%201.1%20portraits%2016x16.png"
          alt="Zombie Hero"
          class="menu-hero-emblem"
        />
        <h1 class="game-title">КАТАКОМБЫ СКЛЕПА</h1>
        <div class="game-subtitle">ПРОЦЕДУРНЫЙ ACTION-РОГЛАЙТ</div>
      </div>

      <!-- Mode Selection -->
      <div class="mode-select-section">
        <div class="section-label">РЕЖИМ ИГРЫ:</div>
        <div class="mode-select-row">
          <button class="mode-chip active" data-mode="campaign">
            🏰 Кампания (12 этажей, 4 биома)
          </button>
          <button class="mode-chip" data-mode="boss_rush">
            ⚔️ Босс-Раш (5 арен)
          </button>
          <button class="mode-chip" data-mode="endless">
            ♾️ Бесконечный Спуск
          </button>
          <button class="mode-chip" data-mode="tutorial">
            🎓 Обучение (Полигон)
          </button>
        </div>
      </div>

      <!-- Difficulty Selection -->
      <div class="difficulty-select-section">
        <div class="section-label">СЛОЖНОСТЬ СПУСКА:</div>
        <div class="difficulty-select-row">
          <button class="diff-chip" data-diff="easy">
            🟢 Новичок (-25% урона, +зелья)
          </button>
          <button class="diff-chip active" data-diff="normal">
            🟡 Нормально (Классика)
          </button>
          <button class="diff-chip" data-diff="nightmare">
            🔴 Кошмар (+35% урона, +50% душ)
          </button>
          <button class="diff-chip" data-diff="inferno">
            💀 Инферно (Смертельный, x2 душ!)
          </button>
        </div>
      </div>

      <!-- Class Selection -->
      <div class="class-select-section">
        <div class="section-label">ВЫБЕРИТЕ КЛАСС ГЕРОЯ:</div>
        <div class="classes-grid">
          <div class="class-card active" data-class="zombie">
            <div class="class-icon">🧟</div>
            <div class="class-name">Зомби-Ренегат</div>
            <div class="class-perk">Вампиризм 20%, когти, «Чумной Взрыв»</div>
          </div>
          <div class="class-card" data-class="paladin">
            <div class="class-icon">🛡️</div>
            <div class="class-name">Паладин Пепла</div>
            <div class="class-perk">+2 сердца (10 HP), святой меч, «Освященный Вихрь»</div>
          </div>
          <div class="class-card" data-class="sorcerer">
            <div class="class-icon">🔮</div>
            <div class="class-name">Теневой Адепт</div>
            <div class="class-perk">Дальний бой сферами душ, «Вспышка Пустоты»</div>
          </div>
          <div class="class-card" data-class="berserker">
            <div class="class-icon">🪓</div>
            <div class="class-name">Кровавый Берсерк</div>
            <div class="class-perk">Урон +12, двойные секиры, «Вихрь Безумия»</div>
          </div>
          <div class="class-card" data-class="assassin">
            <div class="class-icon">🗡️</div>
            <div class="class-name">Ассасин Тени</div>
            <div class="class-perk">Скорость +30%, крит 35%, «Веер Клинков»</div>
          </div>
        </div>
      </div>


      <!-- Starting Loadout (Gear & Pack) -->
      <div class="loadout-select-section">
        <div class="section-label">СТАРТОВОЕ СНАРЯЖЕНИЕ & НАБОР:</div>
        <div class="loadout-row">
          <div class="loadout-group">
            <label for="select-start-weapon" class="loadout-label">⚔️ Оружие:</label>
            <select id="select-start-weapon" class="loadout-select">
              <option value="default">Классическое классовое</option>
              <option value="plasma_wand">🔮 Плазменный Жезл (Сферы x2, взрыв)</option>
              <option value="claymore">🗡️ Двуручный Клеймор (+14 Урона, Таран)</option>
              <option value="daggers">🗡️ Кинжалы Вихря (+35% Скорость, Вампиризм)</option>
              <option value="astral_blaster">🌌 Астральный Пульсар (Тройной залп, Легендарный)</option>
            </select>
          </div>

          <div class="loadout-group">
            <label for="select-start-pack" class="loadout-label">🎒 Припасы:</label>
            <select id="select-start-pack" class="loadout-select">
              <option value="none">Без набора (Хардкор)</option>
              <option value="traveler_purse">🪙 Сумка Странника (+60 золота)</option>
              <option value="medic_kit">🧪 Походная Аптечка (+2 ХП, +1 Скорость)</option>
              <option value="sharpening_scroll">📜 Свиток Заточки (Оружие +1, +5 Урона)</option>
              <option value="light_amulet">🕯️ Амулет Света (+70 px обзор)</option>
              <option value="orb_resonator">🔮 Резонатор Энергии (+6 Урон сфер)</option>
            </select>
          </div>
        </div>
      </div>

      <div class="menu-actions">
        <button id="btn-start-game" class="btn-primary-action">
          <span class="btn-main-text">СПУСТИТЬСЯ В СКЛЕП</span>
          <span class="btn-sub-text">НАЧАТЬ ПОХОД</span>
        </button>

        <button id="btn-open-meta" class="btn-meta-action">
          🏛️ АЛТАРЬ НАСЛЕДИЯ (<span id="meta-blue-coins-val">0</span> 💎)
        </button>
      </div>

      <div class="menu-hotkeys-help">
        <div class="hotkey-col"><b>WASD / Стрелки</b> — Движение</div>
        <div class="hotkey-col"><b>ЛКМ</b> — Атака / 3-хит комбо</div>
        <div class="hotkey-col"><b>ПКМ / Q</b> — Классовый спец-навык</div>
        <div class="hotkey-col"><b>Пробел / Shift</b> — Рывок</div>
        <div class="hotkey-col"><b>Tab</b> — Характеристики & Оружие</div>
        <div class="hotkey-col"><b>1, 2, 3</b> — Зелья (ХП/Скорость/Мощь)</div>
        <div class="hotkey-col"><b>E / F</b> — Взаимодействие (Торговец/Алтарь)</div>
      </div>

      <div class="menu-quick-stats">
        <span>🏆 Лучший этаж: <b id="stat-high-floor">1</b></span>
        <span>💀 Уничтожено монстров: <b id="stat-high-kills">0</b></span>
        <span>🪙 Рекорд золота: <b id="stat-high-gold">0</b></span>
      </div>
    </div>
  </div>

  <!-- MAIN GAME CANVAS & WORLD -->
  <div id="screen-game" class="game-screen">
    <!-- Top HUD Bar -->
    <header class="hud-header">
      <div class="hud-left">
        <a href="/games" class="hud-exit-link" title="Выйти в меню всех мини-игр">← К играм</a>
        <div class="hero-status-pill">
          <img
            id="hud-hero-avatar"
            src="/Dungeon%20Gathering%20Free%20Version/Zombies%201.1%20portraits%2016x16.png"
            alt="Hero Avatar"
            class="hero-avatar"
          />
          <div class="hero-info-col">
            <div class="hero-name-row">
              <span id="hud-hero-name" class="hero-title">Пробуждённый</span>
              <span class="hero-lvl">Ур. <b id="hud-hero-lvl">1</b></span>
            </div>
            <div id="hud-hearts-container" class="hearts-container"></div>
            <div class="bar-track xp-track">
              <div id="hud-hero-xp" class="bar-fill xp-fill" style="width: 0%;"></div>
              <span id="hud-hero-xp-text" class="bar-text">0 / 30 XP</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Center Floor & Boss Display -->
      <div class="hud-center">
        <div class="floor-badge-box">
          <div class="floor-title">
            <span id="hud-mode-icon">🏰</span> ЭТАЖ <span id="hud-floor-num">1</span>
            <span id="hud-diff-badge" class="diff-hud-badge">НОРМА</span>
          </div>
          <div id="hud-floor-desc" class="floor-desc">Темные Катакомбы</div>
        </div>

        <div id="hud-boss-wrap" class="boss-hud-bar" style="display: none;">
          <div id="hud-boss-name" class="boss-title">ВЛАДЫКА СКЛЕПА</div>
          <div class="bar-track boss-track">
            <div id="hud-boss-hp" class="bar-fill boss-fill" style="width: 100%;"></div>
          </div>
        </div>
      </div>

      <!-- Resources & Controls Right -->
      <div class="hud-right">
        <div class="resources-row">
          <div class="res-item gold" title="Золотые монеты">
            <img
              src="/Dungeon%20Gathering%20Free%20Version/Coin%20Gif.gif"
              alt="Gold"
              class="res-icon"
            />
            <span id="res-gold-val">0</span>
          </div>
          <div class="res-item blue-coin" title="Синие монеты душ">
            <img
              src="/Dungeon%20Gathering%20Free%20Version/BlueCoin%20Gif.gif"
              alt="Blue Coin"
              class="res-icon"
            />
            <span id="res-blue-val">0</span>
          </div>
        </div>

        <button id="btn-show-charsheet" class="hud-mini-btn" title="Характеристики и оружие (Tab)">
          📊
        </button>
        <button id="btn-show-relics" class="hud-mini-btn" title="Собранные реликвии (I)">
          📜
        </button>
        <button id="btn-toggle-sound" class="hud-mini-btn" title="Звук">🔊</button>
        <button id="btn-pause" class="hud-mini-btn" title="Пауза">⏸️</button>
      </div>
    </header>

    <!-- Canvas Playfield -->
    <div id="canvas-wrapper" class="canvas-wrapper">
      <canvas id="game-canvas"></canvas>

      <!-- Mini-map Radar -->
      <div class="minimap-container">
        <canvas id="minimap-canvas" width="130" height="130"></canvas>
        <div class="minimap-title">КАРТА СКЛЕПА</div>
      </div>

      <!-- Interaction Prompt -->
      <div id="hud-interaction-prompt" class="interaction-prompt" style="display: none;">
        [E] ВЗАИМОДЕЙСТВИЕ
      </div>

      <!-- Potion Belt, Skill & Dash HUD Bottom -->
      <div class="bottom-action-hud">
        <div class="potion-slot" id="slot-pot-hp" title="Зелье Здоровья (Клавиша 1)">
          <img
            src="/Dungeon%20Gathering%20Free%20Version/Potion%201.png"
            alt="HP Potion"
            class="potion-img"
          />
          <span class="slot-key">1</span>
          <span id="pot-hp-count" class="pot-badge">1</span>
        </div>

        <div class="potion-slot" id="slot-pot-speed" title="Зелье Скорости (Клавиша 2)">
          <img
            src="/Dungeon%20Gathering%20Free%20Version/Potion%203.png"
            alt="Speed Potion"
            class="potion-img"
          />
          <span class="slot-key">2</span>
          <span id="pot-speed-count" class="pot-badge">1</span>
        </div>

        <div class="potion-slot" id="slot-pot-power" title="Зелье Мощи (Клавиша 3)">
          <img
            src="/Dungeon%20Gathering%20Free%20Version/Potion%206.png"
            alt="Power Potion"
            class="potion-img"
          />
          <span class="slot-key">3</span>
          <span id="pot-power-count" class="pot-badge">0</span>
        </div>

        <!-- Special Skill Slot -->
        <div class="skill-indicator" id="hud-skill-box" title="Классовое Умение (ПКМ / Q)">
          <span id="skill-icon-display" class="skill-icon">⚡</span>
          <span class="skill-text">НАВЫК (Q)</span>
          <div id="skill-cooldown-overlay" class="skill-cd-mask"></div>
        </div>


        <!-- Relics Slots HUD -->
        <div class="hud-relics-container" id="hud-relics-box" title="Активные реликвии спутника">
          <span class="relics-bar-label">РЕЛИКВИИ:</span>
          <div id="hud-relics-bar" class="hud-relics-bar"></div>
        </div>

        <!-- Ultimate Button Slot (Isaac style!) -->
        <div class="ultimate-indicator" id="hud-ultimate-box" title="УЛЬТА: СУДНЫЙ ДЕНЬ (Нажмите R / Клик)">
          <div class="ultimate-icon-wrap">
            <span id="ultimate-icon-display" class="ultimate-icon">💥</span>
          </div>
          <div class="ultimate-text-col">
            <span class="ultimate-title">УЛЬТА (R)</span>
            <span id="ultimate-pct-display" class="ultimate-pct">0%</span>
          </div>
          <div id="ultimate-charge-bar" class="ultimate-charge-fill"></div>
        </div>

        <!-- Dash Slot -->
        <div class="dash-indicator" id="hud-dash-box" title="Рывок (Пробел / Shift)">
          <span class="dash-icon">💨</span>
          <span class="dash-text">РЫВОК</span>
          <div id="dash-cooldown-overlay" class="dash-cd-mask"></div>
        </div>
      </div>

      <!-- Mobile Touch Controls -->
      <div id="mobile-touch-controls" class="mobile-controls">
        <div id="virtual-joystick" class="joystick-base">
          <div id="joystick-knob" class="joystick-thumb"></div>
        </div>
        <div class="mobile-actions">
          <button id="touch-btn-attack" class="touch-action-btn btn-atk">⚔️ Удар</button>
          <button id="touch-btn-skill" class="touch-action-btn btn-skill">✨ Навык</button>
          <button id="touch-btn-dash" class="touch-action-btn btn-dash">💨 Рывок</button>
          <button id="touch-btn-potion" class="touch-action-btn btn-pot">🧪 ХП</button>
        </div>
      </div>

      <!-- Notification Toast -->
      <div id="hud-notification" class="notification-toast">
        ЭТАЖ 1: ТЕМНЫЕ КАТАКОМБЫ
      </div>

      <!-- Bottom Evolution Notification Alert Banner -->
      <div id="hud-bottom-evolution" class="bottom-evolution-alert">
        <span class="evolution-icon">⚠️</span>
        <span id="bottom-evolution-text" class="evolution-text"></span>
      </div>
    </div>
  </div>

  <!-- SHOP MODAL -->
  <div id="modal-shop" class="game-modal-overlay">
    <div class="modal-box shop-box">
      <div class="modal-ribbon shop">ЛАВКА СПЕКТРАЛЬНОГО ТОРГОВЦА</div>
      <h2 class="modal-heading">ЧЕМ ПОЖИВИТЕСЬ, ПУТНИК?</h2>
      <p class="modal-sub">
        Духи склепа ценят блестящее золото и сияющие синие души. Выберите товар:
      </p>

      <div id="shop-items-grid" class="shop-items-grid"></div>

      <div class="modal-actions-column">
        <button id="btn-close-shop" class="btn-action secondary">ЗАКРЫТЬ ЛАВКУ</button>
      </div>
    </div>
  </div>

  <!-- RELIC INVENTORY MODAL -->
  <div id="modal-relics" class="game-modal-overlay">
    <div class="modal-box relics-box">
      <div class="modal-ribbon">АРХИВ БЛАГОСЛОВЕНИЙ</div>
      <h2 class="modal-heading">СОБРАННЫЕ РЕЛИКВИИ</h2>
      <p class="modal-sub">Ваши текущие перки и пассивные усиления в этом спуске:</p>

      <div id="relics-list-grid" class="relics-list-grid"></div>

      <div class="modal-actions-column">
        <button id="btn-close-relics" class="btn-action secondary">ВЕРНУТЬСЯ В БОЙ</button>
      </div>
    </div>
  </div>

  <!-- CHARACTER & GEAR SHEET MODAL (TAB) -->
  <div id="modal-character-sheet" class="game-modal-overlay">
    <div class="modal-box charsheet-box">
      <div class="modal-ribbon meta">ХАРАКТЕРИСТИКИ ГЕРОЯ & СНАРЯЖЕНИЕ [TAB]</div>
      <div class="charsheet-content-layout">
        <!-- Left Col: Stats -->
        <div class="charsheet-stats-col">
          <div class="charsheet-hero-header">
            <img id="cs-hero-avatar" class="cs-avatar" src="/Dungeon%20Gathering%20Free%20Version/Zombies%201.1%20portraits%2016x16.png" alt="Hero" />
            <div class="cs-hero-title-box">
              <h3 id="cs-hero-name" class="cs-name">Пробуждённый</h3>
              <div class="cs-lvl-badge">Уровень <b id="cs-hero-level">1</b></div>
            </div>
          </div>

          <div class="charsheet-stats-grid">
            <div class="cs-stat-item"><span class="cs-lbl">❤️ Здоровье:</span> <b id="cs-hp" class="cs-val text-green">10 / 10</b></div>
            <div class="cs-stat-item"><span class="cs-lbl">⚔️ Урон оружия:</span> <b id="cs-damage" class="cs-val text-yellow">24</b></div>
            <div class="cs-stat-item"><span class="cs-lbl">⚡ Скорость ударов:</span> <b id="cs-atk-speed" class="cs-val text-cyan">3.6 /с</b></div>
            <div class="cs-stat-item"><span class="cs-lbl">🛡️ Броня (защита):</span> <b id="cs-armor" class="cs-val text-blue">1</b></div>
            <div class="cs-stat-item"><span class="cs-lbl">🎯 Шанс крита:</span> <b id="cs-crit-chance" class="cs-val text-yellow">25%</b></div>
            <div class="cs-stat-item"><span class="cs-lbl">💥 Сила крита:</span> <b id="cs-crit-mult" class="cs-val text-orange">2.4x</b></div>
            <div class="cs-stat-item"><span class="cs-lbl">🩸 Вампиризм:</span> <b id="cs-lifesteal" class="cs-val text-red">12%</b></div>
            <div class="cs-stat-item"><span class="cs-lbl">💨 Скорость бега:</span> <b id="cs-speed" class="cs-val text-cyan">140</b></div>
            <div class="cs-stat-item"><span class="cs-lbl">🕯️ Радиус света:</span> <b id="cs-light" class="cs-val text-yellow">+50 px</b></div>
            <div class="cs-stat-item"><span class="cs-lbl">💀 Врагов повержено:</span> <b id="cs-kills" class="cs-val text-purple">0</b></div>
          </div>


          <!-- Equipped Relics & Synergies in Tab Sheet -->
          <div class="cs-relics-section">
            <div class="cs-sec-title">ЭКИПИРОВАННЫЕ РЕЛИКВИИ:</div>
            <div id="cs-relics-grid" class="cs-relics-grid"></div>
            <div id="cs-synergy-badge" class="cs-synergy-badge" style="display: none;"></div>
          </div>

          <!-- Collected Perks list -->
          <div class="cs-perks-section">
            <div class="cs-sec-title">АКТИВНЫЕ БЛАГОСЛОВЕНИЯ & ПЕРКИ:</div>
            <div id="cs-perks-list" class="cs-perks-list"></div>
          </div>
        </div>

        <!-- Right Col: Currently Equipped Weapon -->
        <div class="charsheet-weapon-col">
          <div class="cs-sec-title">ТЕКУЩЕЕ ОРУЖИЕ:</div>
          <div id="cs-weapon-card" class="cs-weapon-card">
            <!-- Weapon details populated by JS -->
          </div>
        </div>
      </div>

      <div class="modal-actions-column">
        <button id="btn-close-charsheet" class="btn-action primary">ВЕРНУТЬСЯ В БОЙ [TAB / ESC]</button>
      </div>
    </div>
  </div>

  <!-- META-PROGRESSION ALTAR MODAL -->
  <div id="modal-meta" class="game-modal-overlay">
    <div class="modal-box meta-box">
      <div class="modal-ribbon meta">СВЯТИЛИЩЕ ВЕЧНОЙ ПАМЯТИ</div>
      <h2 class="modal-heading">АЛТАРЬ НАСЛЕДИЯ</h2>
      <p class="modal-sub">
        Потратьте сохраненные синие души (<b id="meta-modal-blue-val" style="color: #38bdf8;">0</b> 💎),
        чтобы навсегда укрепить ваших героев для всех будущих походов:
      </p>

      <div id="meta-upgrades-grid" class="meta-upgrades-grid"></div>

      <div class="modal-actions-column">
        <button id="btn-close-meta" class="btn-action primary">НАЗАД В МЕНЮ</button>
      </div>
    </div>
  </div>

  <!-- ROGUELITE LEVEL-UP PERK MODAL -->
  <div id="modal-perk" class="game-modal-overlay">
    <div class="modal-box perk-box">
      <div class="modal-ribbon">ТАЙНЫЙ АЛТАРЬ ВОЗВЫШЕНИЯ</div>
      <h2 class="modal-heading">НОВЫЙ УРОВЕНЬ! ВЫБЕРИТЕ БЛАГОСЛОВЕНИЕ</h2>
      <p class="modal-sub">
        Катакомбы откликаются на вашу силу. Выберите постоянное улучшение для текущего похода:
      </p>

      <div id="perk-cards-grid" class="perk-cards-grid"></div>
    </div>
  </div>


  <!-- RELIC SWAP MODAL (PAUSES GAME) -->
  <div id="modal-relic-swap" class="game-modal-overlay">
    <div class="modal-box relic-swap-box">
      <div class="modal-ribbon legendary">АРТЕФАКТ ДРЕВНИХ</div>
      <h2 class="modal-heading">НАЙДЕНА РЕЛИКВИЯ!</h2>
      <p class="modal-sub">
