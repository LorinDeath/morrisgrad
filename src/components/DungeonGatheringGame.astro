    background: rgba(255, 215, 0, 0.15);
    box-shadow: 0 8px 25px rgba(255, 215, 0, 0.3);
  }

  .perk-card.rare { border-color: #38bdf8; }
  .perk-card.epic { border-color: #c084fc; }
  .perk-card.legendary { border-color: #f59e0b; }

  .perk-icon { font-size: 2.4rem; margin-bottom: 0.5rem; }
  .perk-title { font-size: 1rem; font-weight: 800; color: #f8fafc; margin-bottom: 0.4rem; }
  .perk-desc { font-size: 0.75rem; color: #cbd5e1; line-height: 1.4; }

  .modal-actions-column {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    max-width: 280px;
    margin: 1.2rem auto 0 auto;
  }

  .btn-action {
    padding: 10px 22px;
    border-radius: 25px;
    font-weight: 800;
    cursor: pointer;
    font-size: 0.9rem;
    transition: all 0.15s;
    border: 2px solid transparent;
    pointer-events: auto;
  }

  .btn-action.primary {
    background: #ffd700;
    color: #000;
    border-color: #fef08a;
  }
  .btn-action.primary:hover {
    transform: scale(1.04);
    box-shadow: 0 0 20px rgba(255, 215, 0, 0.6);
  }

  .btn-action.warning {
    background: #dc2626;
