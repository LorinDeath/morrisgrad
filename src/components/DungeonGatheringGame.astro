    background: rgba(255, 215, 0, 0.1);
  }

  .item-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .item-icon { font-size: 1.6rem; }
  .item-title { font-size: 0.88rem; font-weight: 800; color: #f8fafc; }
  .item-desc { font-size: 0.68rem; color: #94a3b8; margin-top: 2px; }

  .btn-buy-item {
    background: #ffd700;
    color: #000;
    border: none;
    border-radius: 8px;
    padding: 6px 12px;
    font-weight: 800;
    font-size: 0.78rem;
    cursor: pointer;
    white-space: nowrap;
    transition: transform 0.15s;
    pointer-events: auto;
  }

