  .floor-title {
    font-size: 0.92rem;
    font-weight: 900;
    color: #ffd700;
  }

  .floor-desc {
    font-size: 0.65rem;
    color: #94a3b8;
  }

  .boss-hud-bar {
    width: 250px;
    background: rgba(15, 23, 42, 0.95);
    border: 2px solid #a855f7;
    border-radius: 8px;
    padding: 4px 8px;
    text-align: center;
    box-shadow: 0 0 20px rgba(168, 85, 247, 0.5);
  }

  .boss-title {
    font-size: 0.68rem;
    font-weight: 900;
    color: #f472b6;
    letter-spacing: 1px;
    margin-bottom: 2px;
  }

  .resources-row {
    display: flex;
    align-items: center;
    gap: 8px;
    background: rgba(15, 23, 42, 0.92);
    border: 2px solid rgba(255, 215, 0, 0.5);
    border-radius: 12px;
    padding: 6px 12px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.7);
  }

  .res-item {
    display: flex;
    align-items: center;
    gap: 5px;
    font-weight: 800;
    font-size: 0.88rem;
  }

  .res-item.gold { color: #fde047; }
  .res-item.blue-coin { color: #38bdf8; }

  .res-icon {
    width: 18px;
    height: 18px;
    image-rendering: pixelated;
  }

  .hud-mini-btn {
    background: rgba(15, 23, 42, 0.9);
    border: 1.5px solid #475569;
    color: #fff;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    cursor: pointer;
    font-size: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s;
    pointer-events: auto;
  }

  .hud-mini-btn:hover {
    border-color: #ffd700;
    transform: translateY(-2px);
  }

  /* CANVAS PLAYFIELD */
  .canvas-wrapper {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  #game-canvas {
    display: block;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
  }

  /* Mini-map */
  .minimap-container {
    position: absolute;
    top: 85px;
    right: 15px;
    background: rgba(10, 15, 25, 0.92);
    border: 2px solid #ffd700;
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.8);
    pointer-events: auto;
  }

  #minimap-canvas {
    display: block;
    background: #0f172a;
    image-rendering: pixelated;
  }

  .minimap-title {
    font-size: 0.62rem;
    text-align: center;
    background: #000;
    color: #ffd700;
    font-weight: 800;
    padding: 2px 0;
  }

  /* Prompt */
  .interaction-prompt {
    position: absolute;
    bottom: 85px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(15, 23, 42, 0.94);
    border: 2px solid #ffd700;
    color: #ffd700;
    padding: 6px 18px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 800;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.8);
    z-index: 100;
    letter-spacing: 0.5px;
    animation: prompt-pulse 1.5s infinite;
  }

  @keyframes prompt-pulse {
    0%, 100% { opacity: 0.9; transform: translateX(-50%) scale(1); }
    50% { opacity: 1; transform: translateX(-50%) scale(1.04); }
  }

  /* Bottom HUD */
  .bottom-action-hud {
    position: absolute;
    bottom: 18px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 10px;
    z-index: 100;
    pointer-events: auto;
  }

  .potion-slot {
    position: relative;
    width: 48px;
    height: 48px;
    background: rgba(15, 23, 42, 0.94);
    border: 2px solid #ffd700;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.8);
    transition: transform 0.15s;
    pointer-events: auto;
  }

  .potion-slot:hover {
    transform: translateY(-3px) scale(1.05);
  }

  .potion-img {
    width: 26px;
    height: 26px;
    image-rendering: pixelated;
  }

  .slot-key {
    position: absolute;
    top: 2px;
    left: 4px;
    font-size: 0.62rem;
    font-weight: 900;
    color: #94a3b8;
  }

  .pot-badge {
    position: absolute;
    bottom: 2px;
    right: 4px;
    font-size: 0.72rem;
    font-weight: 900;
    color: #ffd700;
  }

  .skill-indicator, .dash-indicator {
    position: relative;
    width: 62px;
    height: 48px;
    background: rgba(15, 23, 42, 0.94);
    border: 2px solid #a855f7;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    overflow: hidden;
    pointer-events: auto;
  }

  .dash-indicator { border-color: #38bdf8; }

  .skill-icon, .dash-icon { font-size: 1rem; }
  .skill-text { font-size: 0.52rem; font-weight: 900; color: #c084fc; }
  .dash-text { font-size: 0.52rem; font-weight: 900; color: #38bdf8; }

  .skill-cd-mask, .dash-cd-mask {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.75);
    height: 0%;
    transition: height 0.1s linear;
  }

  .notification-toast {
    position: absolute;
    top: 85px;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(15, 23, 42, 0.94);
    border: 2px solid #ffd700;
    border-radius: 20px;
    padding: 6px 20px;
    font-weight: 800;
    font-size: 0.85rem;
    color: #ffd700;
    pointer-events: none;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.8);
    opacity: 0;
    transition: opacity 0.3s;
  }

  .notification-toast.show { opacity: 1; }

  .bottom-evolution-alert {
    position: absolute;
    bottom: 25px;
    left: 50%;
    transform: translateX(-50%) translateY(20px);
    background: linear-gradient(135deg, rgba(15, 6, 28, 0.96), rgba(30, 10, 50, 0.94));
    border: 2px solid #c084fc;
    border-radius: 8px;
    padding: 8px 24px;
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 800;
    font-size: 0.9rem;
    color: #f5d0fe;
    box-shadow: 0 0 25px rgba(192, 132, 252, 0.5), inset 0 0 15px rgba(147, 51, 234, 0.3);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s ease, transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    z-index: 85;
    text-shadow: 0 0 8px rgba(192, 132, 252, 0.8);
    max-width: 90%;
    text-align: center;
  }
  .bottom-evolution-alert.show {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
  .bottom-evolution-alert .evolution-icon {
    font-size: 1.25rem;
    animation: pulse-warn 1s infinite alternate;
  }
  @keyframes pulse-warn {
    from { transform: scale(1); filter: drop-shadow(0 0 4px #e11d48); }
    to { transform: scale(1.25); filter: drop-shadow(0 0 12px #f43f5e); }
  }

  /* Mobile Touch Controls */
  .mobile-controls {
    display: none;
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 90;
  }

  @media (pointer: coarse), (max-width: 800px) {
    .mobile-controls { display: block; }
  }

  .joystick-base {
    position: absolute;
    bottom: 25px;
    left: 25px;
    width: 100px;
    height: 100px;
    background: rgba(255, 255, 255, 0.12);
    border: 2px solid rgba(255, 255, 255, 0.3);
    border-radius: 50%;
    pointer-events: auto;
  }

  .joystick-thumb {
    position: absolute;
    top: 25px;
    left: 25px;
    width: 50px;
    height: 50px;
    background: rgba(255, 215, 0, 0.6);
    border-radius: 50%;
    border: 2px solid #ffd700;
    pointer-events: none;
  }

  .mobile-actions {
    position: absolute;
    bottom: 20px;
    right: 20px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    pointer-events: auto;
  }

  .touch-action-btn {
    width: 54px;
    height: 54px;
    border-radius: 50%;
    font-weight: 900;
    font-size: 0.75rem;
    cursor: pointer;
    pointer-events: auto;
  }

  .btn-atk { background: #ef4444; border: 2px solid #fca5a5; color: #fff; }
  .btn-skill { background: #8b5cf6; border: 2px solid #d8b4fe; color: #fff; }
  .btn-dash { background: #0284c7; border: 2px solid #7dd3fc; color: #fff; }
  .btn-pot { background: #16a34a; border: 2px solid #86efac; color: #fff; }

  /* MODALS - display: none when inactive completely removes click hijacking! */
  .game-modal-overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.85);
    backdrop-filter: blur(6px);
    display: none;
    justify-content: center;
    align-items: center;
    z-index: 1000;
    opacity: 0;
    pointer-events: none;
  }

  .game-modal-overlay.active {
    display: flex;
    opacity: 1;
    pointer-events: auto;
  }

  .modal-box {
    background: linear-gradient(180deg, #141824 0%, #090c14 100%);
    border: 3px solid #ffd700;
    border-radius: 16px;
    padding: 1.8rem;
    max-width: 760px;
    width: 90%;
    text-align: center;
    position: relative;
    box-shadow: 0 0 50px rgba(255, 215, 0, 0.35);
    max-height: 90vh;
    overflow-y: auto;
  }

  .modal-ribbon {
    display: inline-block;
    background: #d97706;
    color: #fff;
