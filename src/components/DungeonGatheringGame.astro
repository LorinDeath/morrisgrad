  }

  .btn-action.secondary {
    background: transparent;
    border-color: #64748b;
    color: #cbd5e1;
  }
  .btn-action.secondary:hover {
    border-color: #ffd700;
    color: #ffd700;
  }

  .gameover-stats-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.8rem;
    background: rgba(0, 0, 0, 0.4);
