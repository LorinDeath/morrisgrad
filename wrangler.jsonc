{
  "main": "@astrojs/cloudflare/entrypoints/server",
  "name": "morrisgrad",
  "compatibility_date": "2026-01-07",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  // 1. Добавляем переменные здесь, чтобы они не стирались при деплое
  "vars": {
    "PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_test_bWlnaHR5LXN0YXJsaW5nLTY4LmNsZXJrLmFjY291bnRzLmRldiQ",
    // CSP со script-src (src/lib/csp.ts): "report-only" — только отчёты (по умолчанию), "enforce" — блокировать, "off" — выключить
    "CSP_MODE": "report-only"
  },

  "kv_namespaces": [
    {
      "binding": "MORRISGRAD_DB", // Старое имя из кода игры
      "id": "e49e4b6d81ff4560be9f75ef2efba84e"
    }
  ],

  // 2. Переносим твой ID из KV в D1 (настоящая база данных)
  "d1_databases": [
    {
      "binding": "PROFILES_DB",
      "database_name": "morrisgrad_db",
      "database_id": "76aa36d3-74b2-4b1c-bdfb-88100666317c" 
    }
  ],

  // 3. Добавляем R2 для хранения аватарок
  "r2_buckets": [
    {
      "binding": "AVATARS_BUCKET",
      "bucket_name": "morrisgrad-avatars"
    },
    {
      "binding": "ITEMICONS_BUCKET",
      "bucket_name": "itemicons"
    },
    {
      "binding": "konkursbook",
      "bucket_name": "konkursbook"
    },
    {
      "binding": "ARTCOLLECTION_BUCKET",
      "bucket_name": "artcollection"
    },
    {
      // Картинки форума (/api/forum/media/*). Бакет нужно создать до деплоя: wrangler r2 bucket create morrisgrad-forum-media
      "binding": "FORUM_MEDIA",
      "bucket_name": "morrisgrad-forum-media"
    }
  ],

  // Лимиты анонимных записей по IP (src/lib/antiabuse.ts LIMITS — держать в синхроне). Счёт ведёт Cloudflare, IP не храним.
  // namespace_id — любое уникальное в аккаунте число; создаётся при деплое, отдельной настройки не требует.
  "ratelimits": [
    { "name": "RL_SCORES", "namespace_id": "4101", "simple": { "limit": 6, "period": 60 } },
    { "name": "RL_KONKURS", "namespace_id": "4102", "simple": { "limit": 2, "period": 60 } },
    { "name": "RL_CHAT", "namespace_id": "4103", "simple": { "limit": 20, "period": 60 } }
  ],

  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  }
}