      z-index: 1;
    }

    #css3d-container {
      z-index: 2;
      pointer-events: none;
    }

    /* Защитный слой во время свайпа для 100% считывания движения над iframe */
    #drag-shield {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 999;
      display: none;
      background: transparent;
    }

    .ui-layer {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
