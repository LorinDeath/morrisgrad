          <button id="btn-modal-ok" class="btn-small" style="border-color:#fff; color:#fff;">ХОРОШО</button>
        </div>
      </div>
      
      <!-- Global Item Tooltip -->
      <div id="item-tooltip" class="item-tooltip hidden"></div>

    </div>
  </div>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700;900&display=swap');

  /* Window Container */
  .app-window {
    position: relative;
    width: 100%;
    aspect-ratio: 1040 / 720;
    margin: 20px auto;
    max-width: 1040px;
    background: #050505;
    border: 2px solid #0ff;
    border-radius: 12px;
    box-shadow: 0 0 40px rgba(0, 255, 255, 0.15);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    z-index: 10;
    font-family: 'Orbitron', sans-serif;
  }

  /* Fullscreen Fixes */
  :global(:fullscreen) #app-window {
    width: 100vw !important;
    height: 100vh !important;
    max-width: none !important;
    margin: 0 !important;
    border: none;
    border-radius: 0;
  }
  :global(:fullscreen) canvas {
    width: 100%;
    height: 100%;
    object-fit: contain; /* Preserves aspect ratio */
  }

  .window-header {
    height: 36px;
    background: #111;
    border-bottom: 1px solid #333;
