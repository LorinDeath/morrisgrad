                name: "Допрос в Церкви Нави и Стирание Кода",
                subtitle: "Казнь Тифани и Триумф Лорин",
                short: "Лорин раздавила голографический таймер воскрешения голыми руками, влюбив в себя Ликёра.",
                full: `<p>Бог Велес привел Лорин в Церковь. Когда Тифани обезглавили и над ней зажегся таймер воскрешения, Лорин сжала кулак и уничтожила интерфейс, безвозвратно стерев её душу.</p>`
            },

            // ANOMALIES & ARTIFACTS
            {
                id: "black_crown",
                category: "anomalies",
                name: "Чёрная Корона",
                subtitle: "Высший Артефакт Мироздания",
                short: "Дарует абсолютную власть над 7 стихиями. Доступна лишь Хранителю V Порядка.",
                full: `<p>Высший реликварный предмет. Лишь маг, подчинивший все 7 стихий, может прикоснуться к ней. Свела с ума отца Лорин и Мэл.</p>`
            },
            {
                id: "glitch_dagger",
                category: "anomalies",
                name: "Глитчный Ледяной Кинжал",
                subtitle: "Оружие Ликёра Владолларса",
                short: "Клинок из льда, покрытый пульсирующими черными цифровыми аномалиями. Ломает код игры.",
                full: `<p>Артефакт, полученный Ликёром. Змеится цифровым вирусом, способным ломать таймеры воскрешения.</p>`,
                theme: "cyan"
            },
            {
                id: "black_guns",
                category: "anomalies",
                name: "Три Чёрных Пистолета",
                subtitle: "Оружие из «Фрактала Бабочки»",
                short: "Всего 3 единицы в мире. Пули убивают не только аватар в МоррисГраде, но и человека в реальном мире.",
                full: `<p>Огнестрельное оружие из другого мира. 1-й пистолет изъят в Гринпойсе, 2-й был у отца Лорин, 3-й спрятан самой Лорин.</p>`
            },
            {
                id: "drone_letter",
                category: "anomalies",
                name: "Бумажное Письмо из Реальности",
                subtitle: "Послание Сына Мариэль",
                short: "Настоящая физическая бумага, доставленная дроном сквозь купол с реального острова Альказак в Тихом океане.",
                full: `<p>Доказывает, что реальный физический остров Альказак и цифровая матрица МоррисГрада слились.</p>`
            }
        ];

        // CURRENT ACTIVE TAB
        let currentTab = 'lore';

        // RENDER SECTION CARDS
        function renderCategoryCards() {
            const categories = ['characters', 'factions', 'events', 'anomalies'];
            categories.forEach(cat => {
                const grid = document.getElementById(cat + 'Grid');
                if (!grid) return;
                const items = ALL_ARTICLES.filter(x => x.category === cat);
                grid.innerHTML = items.map(item => createCardHTML(item)).join('');
            });
        }

        function createCardHTML(item) {
            return `
                <div class="card ${item.theme === 'red' ? 'red-theme' : item.theme === 'cyan' ? 'cyan-theme' : ''}" onclick="openModal('${item.id}')">
                    <div>
                        <h3>${item.name}</h3>
                        <div class="subtitle">${item.subtitle}</div>
                        <p>${item.short}</p>
                    </div>
                    <div class="tags">
                        ${item.tags ? item.tags.map(t => `<span class="tag">${t}</span>`).join('') : ''}
                    </div>
                </div>
            `;
        }

        // TAB SWITCHING
        function switchTab(tabId) {
            currentTab = tabId;
            document.getElementById('searchInput').value = '';
            document.getElementById('searchResultsView').style.display = 'none';

            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.classList.toggle('active', btn.getAttribute('data-tab') === tabId);
            });

            document.querySelectorAll('.section-content').forEach(sec => {
                sec.classList.toggle('active', sec.id === tabId);
            });
        }

        // GLOBAL SEARCH ENGINE (FIXED & 100% RELIABLE)
        function handleGlobalSearch() {
            const query = document.getElementById('searchInput').value.trim().toLowerCase();
            const resultsView = document.getElementById('searchResultsView');
            const resultsGrid = document.getElementById('searchResultsGrid');
            const infoText = document.getElementById('searchInfoText');

            if (!query) {
                resultsView.style.display = 'none';
                document.getElementById(currentTab).classList.add('active');
                return;
            }

            // Hide all tab sections while search is active
            document.querySelectorAll('.section-content').forEach(sec => sec.classList.remove('active'));
            resultsView.style.display = 'block';

            // Filter all articles in database
            const matches = ALL_ARTICLES.filter(item => {
                const searchCorpus = (item.name + ' ' + item.subtitle + ' ' + item.short + ' ' + item.full + ' ' + (item.tags ? item.tags.join(' ') : '')).toLowerCase();
                return searchCorpus.includes(query);
            });

            if (matches.length > 0) {
                infoText.innerText = `Найдено материалов: ${matches.length}`;
                resultsGrid.innerHTML = matches.map(item => createCardHTML(item)).join('');
            } else {
                infoText.innerText = `По запросу «${query}» ничего не найдено.`;
                resultsGrid.innerHTML = '<p style="color: var(--text-muted); grid-column: 1/-1;">Попробуйте изменить поисковый запрос (например: Лорин, Кинжал, Альказак, Велес).</p>';
            }
        }

        // MODALS
        function openModal(id) {
            const item = ALL_ARTICLES.find(x => x.id === id);
            if (!item) return;

            document.getElementById('modalTitle').innerText = item.name;
            document.getElementById('modalSubtitle').innerText = item.subtitle;
            document.getElementById('modalBody').innerHTML = item.full;
            document.getElementById('modalOverlay').classList.add('active');
        }

        function closeModal() {
            document.getElementById('modalOverlay').classList.remove('active');
        }

        // RELATIONS MAP
        const relationsMap = {
            lorin: `
                <h3>Лорин Дэт / Мариэль — Карта Связей</h3>
                <p><strong>Королева Мэл:</strong> Родная сестра по биологическому отцу. Мэл искренне ненавидит Лорин, считая её причиной безумия отца, а Лорин бережет сестру и скрывает истинное родство.</p>
                <p><strong>Ликёр Владолларс:</strong> Преклоняется перед её способностью стирать цифровой код. Считает её единственным божеством в этом «театре».</p>
                <p><strong>YFrite:</strong> Приёмный отец, передавший ей обязанность вести Летопись.</p>
                <p><strong>Бог Велес:</strong> Древний союзник и арбитр, привлекающий её к ликвидации системных сбоев.</p>
            `,
            liker: `
                <h3>Ликёр Владолларс — Карта Связей</h3>
                <p><strong>Лорин Дэт:</strong> Объект его маньякального поклонения и исследований.</p>
                <p><strong>Инквизиция:</strong> Презирает их как «актеров и фармеров». Убил инквизитора вирусным кодом с одного слова «Убить!».</p>
            `,
            kavega: `
                <h3>Кавега («Пламя Нулевого Дня») — Карта Связей</h3>
                <p><strong>Королева Мэл:</strong> Провел с ней рейд в Ледяной Данж и заметил фиолетовые искры Адского пламени в её душе.</p>
                <p><strong>Нофорд:</strong> Близкий напарник, постоянно выслушивающий его шутки.</p>
            `,
            nofourd: `
                <h3>Нофорд («Детектив Смерти») — Карта Связей</h3>
                <p><strong>Служанка Кьют:</strong> Влюблен без памяти, планирует свадьбу.</p>
                <p><strong>Листаф Элфдид:</strong> Гордится отцом, вырезавшим Аезер.</p>
            `,
            mel: `
                <h3>Королева Мэл — Карта Связей</h3>
                <p><strong>Лорин Дэт:</strong> Считает её врагом №1, не подозревая об их родстве.</p>
                <p><strong>Кавега:</strong> Уважает его за молчаливую поддержку в походе.</p>
            `,
            yfrite: `
                <h3>YFrite (Йфрайт) — Карта Связей</h3>
                <p><strong>Лорин:</strong> Завещал ей собирать хроники в магический свиток.</p>
            `,
            cute: `
                <h3>Служанка Кьют — Карта Связей</h3>
                <p><strong>Нофорд:</strong> Принимает его ухаживания, вопреки диссонансу между замковой службой и историей Аезера.</p>
            `,
            petr: `
                <h3>Пётр — Карта Связей</h3>
                <p><strong>Клан «Обитель Смерти»:</strong> Могучая боевая опора, Рыцарь смерти V Порядка.</p>
            `,
            morris: `
                <h3>Лидер Моррис — Карта Связей</h3>
                <p><strong>Дар Дэмиург и Лорин:</strong> Руководит покупкой замка и финансовыми делами.</p>
            `,
            veles: `
                <h3>Бог Велес — Карта Связей</h3>
                <p><strong>Лорин & Ликёр:</strong> Контролирует баланс Нави и следит за системными аномалиями.</p>
            `
        };

        function showRelation(id) {
            document.getElementById('relationResult').innerHTML = relationsMap[id] || '<p>Данные о связях отсутствуют...</p>';
        }

        // INITIALIZATION
        renderCategoryCards();
    </script>
</body>
</html>
