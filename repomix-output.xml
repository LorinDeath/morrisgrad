ion": "Нофорд отличается жизнерадостным и кокетливым нравом, оживляющим Замок Обители."}, {"question": "Какое отношение демонстрирует Мариэль к постоянному кокетству Нофорда?", "options": ["Строгое, вежливое, но холодное требование соблюдать границы", "Влюбленность и отвесы смешками", "Ярость и приказы о казни", "Полное игнорирование"], "correct": 0, "explanation": "Мариэль вежливо, но твердо просит Нофорда покинуть покои, сохраняя дистанцию."}, {"question": "Каким словом Ликёр охарактеризовал Божество, написавшее для него судьбу маньяка?", "options": ["«Бездарный графоман, создающий дешевое кино»", "«Великий гений литературы»", "«Мудрый создатель»", "«Справедливый судья»"], "correct": 0, "explanation": "Ликёр с садистской иронией возмущается безвкусием Создателя, называя его бездарным графоманом."}]}};

        let currentQuizData = [];
        let currentQuizModeKey = '';
        let currentQuestionIdx = 0;
        let score = 0;
        let userAnswers = [];

        const startScreen = document.getElementById('start-screen');
        const quizScreen = document.getElementById('quiz-screen');
        const resultsScreen = document.getElementById('results-screen');

        const nextBtn = document.getElementById('next-btn');
        const restartBtn = document.getElementById('restart-btn');

        const questionCounter = document.getElementById('question-counter');
        const scoreCounter = document.getElementById('score-counter');
        const progressBar = document.getElementById('progress-bar');
        const categoryTag = document.getElementById('category-tag');
        const questionText = document.getElementById('question-text');
        const optionsContainer = document.getElementById('options-container');

        const explanationBox = document.getElementById('explanation-box');
        const explanationIcon = document.getElementById('explanation-icon');
        const explanationTitle = document.getElementById('explanation-title');
        const explanationText = document.getElementById('explanation-text');

        const scoreNumber = document.getElementById('score-number');
        const scoreCircleProgress = document.getElementById('score-circle-progress');
        const rankTitle = document.getElementById('rank-title');
        const rankSubtitle = document.getElementById('rank-subtitle');
        const reviewList = document.getElementById('review-list');

        // Sound FX Synthesizer
        class SoundFX {
            constructor() { this.ctx = null; }
            init() { if (!this.ctx) this.ctx = new (window.AudioContext || window.webkitAudioContext)(); }
            playClick() {
                if (!this.ctx) return;
                const osc = this.ctx.createOscillator(), gain = this.ctx.createGain();
                osc.type = 'sine';
                osc.frequency.setValueAtTime(400, this.ctx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(800, this.ctx.currentTime + 0.05);
                gain.gain.setValueAtTime(0.1, this.ctx.currentTime);
                gain.gain.exponentialRampToValueAtTime(0.01, this.ctx.currentTime + 0.05);
                osc.connect(gain); gain.connect(this.ctx.destination);
                osc.start(); osc.stop(this.ctx.currentTime + 0.05);
            }
            playCorrect() {
                if (!this.ctx) return;
                const now = this.ctx.currentTime, osc = this.ctx.createOscillator(), gain = this.ctx.createGain();
                osc.type = 'triangle';
                osc.frequency.setValueAtTime(523.25, now);
                osc.frequency.setValueAtTime(659.25, now + 0.1);
                osc.frequency.setValueAtTime(783.99, now + 0.2);
                gain.gain.setValueAtTime(0.15, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.4);
                osc.connect(gain); gain.connect(this.ctx.destination);
                osc.start(); osc.stop(now + 0.4);
            }
            playIncorrect() {
                if (!this.ctx) return;
                const now = this.ctx.currentTime, osc = this.ctx.createOscillator(), gain = this.ctx.createGain();
                osc.type = 'sawtooth';
                osc.frequency.setValueAtTime(180, now);
                osc.frequency.linearRampToValueAtTime(110, now + 0.25);
                gain.gain.setValueAtTime(0.15, now);
                gain.gain.exponentialRampToValueAtTime(0.01, now + 0.25);
                osc.connect(gain); gain.connect(this.ctx.destination);
                osc.start(); osc.stop(now + 0.25);
            }
        }

        const audio = new SoundFX();

        // Fisher-Yates shuffle helper
        function shuffleArray(array) {
            for (let i = array.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [array[i], array[j]] = [array[j], array[i]];
            }
            return array;
        }

        function showScreen(screen) {
            document.querySelectorAll('.screen').forEach(s => s.classList.remove('active'));
            setTimeout(() => screen.classList.add('active'), 50);
        }

        function selectQuizMode(modeKey) {
            audio.init();
            audio.playClick();
            currentQuizModeKey = modeKey;
            currentQuizData = [];

            let rawQuestions = [];
            if (modeKey === 'all') {
                for (let k in quizzesData) {
                    quizzesData[k].questions.forEach(q => {
                        rawQuestions.push({...q, categoryName: quizzesData[k].title});
                    });
                }
            } else {
                quizzesData[modeKey].questions.forEach(q => {
                    rawQuestions.push({...q, categoryName: quizzesData[modeKey].title});
                });
            }

            // Тасовка порядка вопросов
            shuffleArray(rawQuestions);

            // Тасовка вариантов ответов внутри каждого вопроса
            currentQuizData = rawQuestions.map(q => {
                const shuffledOpts = [...q.options];
                const correctAnswerText = shuffledOpts[q.correct];
                
                shuffleArray(shuffledOpts);
                const newCorrectIdx = shuffledOpts.indexOf(correctAnswerText);

                return {
                    ...q,
                    options: shuffledOpts,
                    correct: newCorrectIdx
                };
            });

            currentQuestionIdx = 0;
            score = 0;
            userAnswers = [];
            showScreen(quizScreen);
            loadQuestion();
        }

        function returnToStart() {
            audio.playClick();
            scoreCircleProgress.style.strokeDashoffset = 440;
            showScreen(startScreen);
        }

        function loadQuestion() {
            const q = currentQuizData[currentQuestionIdx];
            
            questionCounter.innerText = `Вопрос ${currentQuestionIdx + 1} из ${currentQuizData.length}`;
            scoreCounter.innerText = `Счет: ${score}`;
            const progressPercent = ((currentQuestionIdx) / currentQuizData.length) * 100;
            progressBar.style.width = `${progressPercent}%`;

            categoryTag.innerText = q.categoryName;
            questionText.innerText = q.question;

            explanationBox.style.display = 'none';
            nextBtn.style.display = 'none';

            optionsContainer.innerHTML = '';
            const letters = ['A', 'B', 'C', 'D'];

            q.options.forEach((opt, idx) => {
                const btn = document.createElement('button');
                btn.className = 'option-btn';
                btn.innerHTML = `
                    <span class="option-letter">${letters[idx]}</span>
                    <span>${opt}</span>
                `;
                btn.addEventListener('click', () => handleAnswer(idx));
                optionsContainer.appendChild(btn);
            });
        }

        function handleAnswer(selectedIdx) {
            const q = currentQuizData[currentQuestionIdx];
            const allBtns = optionsContainer.querySelectorAll('.option-btn');

            allBtns.forEach(btn => btn.classList.add('disabled'));

            const isCorrect = (selectedIdx === q.correct);
            userAnswers.push({
                questionIdx: currentQuestionIdx,
                selected: selectedIdx,
                isCorrect: isCorrect
            });

            if (isCorrect) {
                score++;
                audio.playCorrect();
                allBtns[selectedIdx].classList.add('correct');
                explanationBox.className = 'explanation-box correct-box';
                explanationIcon.innerText = '✓';
                explanationTitle.innerText = 'Правильно!';
            } else {
                audio.playIncorrect();
                allBtns[selectedIdx].classList.add('incorrect');
                allBtns[q.correct].classList.add('correct');
                explanationBox.className = 'explanation-box incorrect-box';
                explanationIcon.innerText = '✕';
                explanationTitle.innerText = 'Неверно!';
            }

            scoreCounter.innerText = `Счет: ${score}`;
            explanationText.innerText = q.explanation;
            explanationBox.style.display = 'block';

            nextBtn.style.display = 'inline-flex';
        }

        function nextQuestion() {
            audio.playClick();
            currentQuestionIdx++;
            if (currentQuestionIdx < currentQuizData.length) {
                loadQuestion();
            } else {
                showResults();
            }
        }

        function showResults() {
            showScreen(resultsScreen);

            const percentage = Math.round((score / currentQuizData.length) * 100);
            scoreNumber.innerText = `${percentage}%`;

            const circumference = 440;
            const offset = circumference - (percentage / 100) * circumference;
            setTimeout(() => {
                scoreCircleProgress.style.strokeDashoffset = offset;
            }, 100);

            rankSubtitle.innerText = `Вы верно ответили на ${score} из ${currentQuizData.length} вопросов`;

            if (percentage === 100) {
                rankTitle.innerText = "👑 Хранитель Черной Короны V Порядка";
                rankTitle.style.color = "#ffc857";
            } else if (percentage >= 75) {
                rankTitle.innerText = "🔥 Высший Инквизитор Обители Смерти";
                rankTitle.style.color = "#ff2a5f";
            } else if (percentage >= 50) {
                rankTitle.innerText = "🛡️ Хранитель Купола Альказака";
                rankTitle.style.color = "#9d4edd";
            } else {
                rankTitle.innerText = "⚙️ Сломанный НПС Системы";
                rankTitle.style.color = "#a0a0ba";
            }

            reviewList.innerHTML = '';
            userAnswers.forEach((ans, i) => {
                const q = currentQuizData[ans.questionIdx];
                const item = document.createElement('div');
                item.className = `review-item ${ans.isCorrect ? 'is-correct' : 'is-incorrect'}`;

                item.innerHTML = `
                    <div class="review-q-title">${i + 1}. ${q.question}</div>
                    <div class="review-ans">
                        Ваш ответ: <span class="${ans.isCorrect ? 'text-correct' : 'text-incorrect'}">${q.options[ans.selected]}</span>
                        ${!ans.isCorrect ? `<br>Правильный ответ: <span class="text-correct">${q.options[q.correct]}</span>` : ''}
                    </div>
                `;
                reviewList.appendChild(item);
            });
        }

        nextBtn.addEventListener('click', nextQuestion);
        restartBtn.addEventListener('click', () => {
            selectQuizMode(currentQuizModeKey);
        });

        // Background Particles
        const canvas = document.getElementById('bg-canvas');
        const ctx = canvas.getContext('2d');
        let particles = [];

        function resizeCanvas() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }

        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        class Particle {
            constructor() { this.reset(); }
            reset() {
                this.x = Math.random() * canvas.width;
                this.y = Math.random() * canvas.height;
                this.size = Math.random() * 2 + 0.5;
                this.speedX = (Math.random() - 0.5) * 0.4;
                this.speedY = -Math.random() * 0.6 - 0.2;
                this.alpha = Math.random() * 0.5 + 0.2;
                this.color = Math.random() > 0.5 ? '#9d4edd' : '#ff2a5f';
            }
            update() {
                this.x += this.speedX;
                this.y += this.speedY;
                if (this.y < 0 || this.x < 0 || this.x > canvas.width) {
                    this.reset();
                    this.y = canvas.height + 10;
                }
            }
            draw() {
                ctx.save();
                ctx.globalAlpha = this.alpha;
                ctx.fillStyle = this.color;
                ctx.beginPath();
                ctx.arc(this.x, this.y, this.size, 0, Math.PI * 2);
                ctx.fill();
                ctx.restore();
            }
        }

        for (let i = 0; i < 50; i++) particles.push(new Particle());

        function animateParticles() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            particles.forEach(p => { p.update(); p.draw(); });
            requestAnimationFrame(animateParticles);
        }

        animateParticles();
    </script>
</body>
</html>
