  .quest-badge { font-size: 8px; padding: 2px 5px; border-radius: 3px; font-weight: bold; text-transform: uppercase; }
  .quest-badge.done { background: #10b981; color: #fff; }
  .quest-badge.progress { background: #3b82f6; color: #fff; }
  .desc-text { font-size: 8.5px; color: var(--text-muted); margin-top: 2px; }
</style>
</head>
<body>

<div id="app">
  <header>
    <div class="logo">Мир <span>Теней</span></div>
    <div class="header-badges">
      <div class="badge" title="Текущий уровень героя">Ур. <span id="hdr-lvl">1</span></div>
      <div class="badge matter-badge" title="Тёмная материя из аномалий">⚛️ <span id="hdr-dark-matter">0</span></div>
      <div class="badge void-badge" title="Сферы Пустоты за возвышения">🌌 <span id="hdr-void-spheres">0</span></div>
      <div class="badge talent-badge" title="Очки талантов">✨ TP: <span id="hdr-tp">0</span></div>
      <div class="badge gold-badge" title="Золото">🪙 <span id="hdr-gold">0</span></div>
    </div>
  </header>

  <nav id="main-nav">
    <button class="active" data-tab="profile" onclick="switchTab('profile')">Герой</button>
    <button data-tab="inventory" onclick="switchTab('inventory')">Рюкзак (<span id="tab-inv-cnt">0</span>)</button>
    <button data-tab="talents" onclick="switchTab('talents')">Таланты & Пустота</button>
    <button data-tab="shop" onclick="switchTab('shop')">🏪 Лавка</button>
    <button data-tab="dungeons" onclick="switchTab('dungeons')">Подземелья</button>
    <button data-tab="quests" onclick="switchTab('quests')">Квесты (<span id="tab-quest-cnt">0</span>)</button>
    <button data-tab="combat" onclick="switchTab('combat')" id="nav-combat-btn" style="display:none; color:#f87171;">⚔ БОЙ!</button>
  </nav>

  <!-- VIEW: PROFILE -->
  <div id="view-profile" class="view active">
    <h2>
      <span>Параметры и Экипировка Героя</span>
      <div>
        <button class="btn btn-sm btn-heal" onclick="usePotion()" title="Восстанавливает 50% от максимального HP">🌿 Настойка (<span id="potions-count">3</span>)</button>
        <button class="btn btn-sm btn-danger" onclick="resetSaveData()">💾 Сброс</button>
      </div>
    </h2>

    <div class="grid-2" style="margin-bottom: 6px;">
      <div class="stat-card">
        <div class="label">Здоровье героя</div>
        <div class="value" id="profile-hp-txt">120 / 120</div>
        <div class="progress-wrap"><div id="profile-hp-bar" class="progress-fill fill-hp"></div></div>
        <div class="sub-desc">Текущий и максимальный запас жизней. При падении до 0 поражение.</div>
      </div>
      <div class="stat-card">
        <div class="label">Опыт Героя</div>
        <div class="value"><span id="profile-exp-txt">0</span> / <span id="profile-exp-next">100</span> XP</div>
        <div class="progress-wrap"><div id="profile-exp-bar" class="progress-fill charge-tier-opt" style="width:0%;"></div></div>
        <div class="sub-desc">Каждый уровень повышает базовые характеристики и даёт 1 TP.</div>
      </div>
    </div>

    <!-- 14 СТАТОВ С ОПИСАНИЯМИ -->
    <div class="grid-4" style="margin-bottom: 8px;">
      <div class="stat-card"><div class="label">Атака</div><div class="value" id="stat-atk">12</div><div class="sub-desc">Базовый урон удара и скилов.</div></div>
      <div class="stat-card"><div class="label">Защита</div><div class="value" id="stat-def">4</div><div class="sub-desc">Уменьшает получаемый урон.</div></div>
      <div class="stat-card"><div class="label">Регенерация</div><div class="value" id="stat-regen" style="color:#34d399;">+1/с</div><div class="sub-desc">Пассивное восстановление HP в секунду.</div></div>
      <div class="stat-card"><div class="label">Скорость атаки</div><div class="value" id="stat-aspd" style="color:var(--accent);">+0%</div><div class="sub-desc">Ускоряет замах и снижает КД клика.</div></div>
      <div class="stat-card"><div class="label">Крит. шанс</div><div class="value" id="stat-crit">5%</div><div class="sub-desc">Шанс нанести критический удар.</div></div>
      <div class="stat-card"><div class="label">Крит. урон</div><div class="value" id="stat-crit-dmg" style="color:var(--gold);">+180%</div><div class="sub-desc">Множитель урона при крит. попадании.</div></div>
      <div class="stat-card"><div class="label">Вампиризм</div><div class="value" id="stat-vamp">0%</div><div class="sub-desc">Лечит героя на % от нанесённого урона.</div></div>
      <div class="stat-card"><div class="label">Пробитие брони</div><div class="value" id="stat-pierce">0 ед.</div><div class="sub-desc">Игнорирует прямую защиту противника.</div></div>
      <div class="stat-card"><div class="label">Срез урона</div><div class="value" id="stat-dmg-red" style="color:#38bdf8;">0%</div><div class="sub-desc">Процентное снижение любых входящих атак.</div></div>
      <div class="stat-card"><div class="label">Сила умений</div><div class="value" id="stat-sp" style="color:#38bdf8;">+2%</div><div class="sub-desc">Увеличивает урон и эффективность скилов.</div></div>
      <div class="stat-card"><div class="label">Проклятье</div><div class="value" id="stat-curse" style="color:#f43f5e;">1%</div><div class="sub-desc">Шанс превратить врага в элитного мутанта.</div></div>
      <div class="stat-card"><div class="label">Бонус золота</div><div class="value" id="stat-gold-bonus" style="color:var(--gold);">+0%</div><div class="sub-desc">Увеличивает прирост золота за монстров.</div></div>
      <div class="stat-card"><div class="label">Бонус опыта</div><div class="value" id="stat-exp-bonus" style="color:#10b981;">+0%</div><div class="sub-desc">Ускоряет получение опыта персонажем.</div></div>
      <div class="stat-card"><div class="label">Оптимум замаха</div><div class="value" id="stat-charge-opt">7.0s</div><div class="sub-desc">Время замаха для оптимального удара.</div></div>
    </div>

    <!-- АСТРОЛЯБИЯ -->
    <div class="gear-card" style="border: 1px solid var(--gold); background: rgba(245, 158, 11, 0.05); margin-bottom: 8px;">
      <div style="display:flex; justify-content:space-between; align-items:center;">
        <b style="font-size:11px; color:#fff;">🌟 АСТРОЛЯБИЯ СОЗВЕЗДИЙ (Пассивные Древа)</b>
        <span style="font-size:9px; color:var(--gold); font-weight:bold;"><span id="astrolabe-cnt-txt">0/4</span></span>
      </div>
      <div class="desc-text" style="margin-top:2px; margin-bottom:4px;">Активируйте великие созвездия за золото для получения колоссальных пассивных усилений.</div>
      <div class="astrolabe-grid">
        <div class="astrolabe-node" id="astro-node-midas">
          <div><b>🪙 Созвездие Мидаса</b><br><span style="color:var(--text-muted);">+1 Атк за каждые 50k золота в казне!</span></div>
          <button class="btn btn-sm btn-gold" id="btn-astro-midas" onclick="unlockAstrolabe('midas')">100k Зл.</button>
        </div>
        <div class="astrolabe-node" id="astro-node-chronophase">
          <div><b>⏳ Хроно-Фаза</b><br><span style="color:var(--text-muted);">Смертельный удар спасает, исцеляя на 100% + 4с бессмертия!</span></div>
          <button class="btn btn-sm btn-gold" id="btn-astro-chronophase" onclick="unlockAstrolabe('chronophase')">250k Зл.</button>
        </div>
        <div class="astrolabe-node" id="astro-node-supernova">
          <div><b>💥 Сверхновая</b><br><span style="color:var(--text-muted);">Каждый 8-й удар взрывает всех врагов на +500% урона!</span></div>
          <button class="btn btn-sm btn-gold" id="btn-astro-supernova" onclick="unlockAstrolabe('supernova')">500k Зл.</button>
        </div>
        <div class="astrolabe-node" id="astro-node-chaoslord">
          <div><b>🔮 Повелитель Хаоса</b><br><span style="color:var(--text-muted);">+30% урона герой наносит за каждого мутанта в бою!</span></div>
          <button class="btn btn-sm btn-gold" id="btn-astro-chaoslord" onclick="unlockAstrolabe('chaoslord')">1M Зл.</button>
        </div>
      </div>
    </div>

    <h2>10 Слотов Экипировки Героя (С блокировкой по уровню)</h2>
    <div class="desc-text" style="margin-bottom:6px;">
      ⚠️ <b>ВНИМАНИЕ:</b> Если уровень героя ниже требуемого, предмет <b>НЕ ДАЁТ НИКАКИХ БОНУСОВ</b> (базовые характеристики, аффиксы, руны и бонусы от звёзд равны 0)! <br>
      ⭐ Каждая закалка звездой увеличивает требуемый уровень предмета на <b>+4 Ур.</b>!
    </div>
    <div class="gear-grid" id="gear-list"></div>
  </div>

  <!-- VIEW: INVENTORY -->
  <div id="view-inventory" class="view">
    <h2>
      <span>Рюкзак Героя</span>
      <div>
        <button class="btn btn-sm btn-rune" onclick="openSynthesisModal()" title="Синтез рун и распыление предметов V+">🧪 Алтарь Синтеза</button>
        <button class="btn btn-sm btn-danger" onclick="sellJunk()" title="Автоматом продает обычное снаряжение I ранга">Продать хлам</button>
      </div>
    </h2>
    <div class="desc-text" style="margin-bottom:6px;">Чтобы надеть вещь, ваш уровень должен соответствовать минимальному уровню предмета (`Ур. Треб.`).</div>
    <div id="inventory-list"></div>
  </div>

  <!-- VIEW: TALENTS & VOID -->
  <div id="view-talents" class="view">
    <div class="gear-card" style="border: 1px solid #ec4899; background: rgba(236, 72, 153, 0.08); margin-bottom: 8px;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:3px;">
        <b style="font-size:11px; color:#fff;">🌌 ВОЗВЫШЕНИЕ ПУСТОТЫ (ПРЕСТИЖ)</b>
        <span style="font-size:9px; color:#ec4899; font-weight:bold;">Ур. <span id="transcend-lvl-badge">0</span> (+<span id="transcend-pct-badge">0</span>% ко всем статам)</span>
      </div>
      <p style="font-size:9px; color:#cbd5e1; margin-bottom:6px;">
        Сброс уровня и базовых талантов персонажа до 1 уровня. Предметы экипировки сохраняются, но их бонусы временно блокируются! Каждый ранг престижа даёт постоянный бонус +25% ко всем параметрам!
      </p>
      <button class="btn btn-charge-attack ready-over" style="width:100%; font-size:10px; margin-bottom:6px;" onclick="transcendHero()">
        🌌 СОВЕРШИТЬ ВОЗВЫШЕНИЕ (+<span id="transcend-gain-spheres">1</span> Сфер Пустоты)
      </button>

      <div style="display:grid; grid-template-columns: 1fr 1fr; gap:5px;">
        <div class="talent-node">
          <div><b>💥 Мульти-Криты</b><br><span style="color:var(--text-muted);">Криты переваливают за 100%</span><br><span id="vp-lvl-supercrit" style="color:#ec4899;">0/10</span></div>
          <button class="btn btn-sm btn-rune" onclick="upgradeVoidPerk('supercrit')">+1 (1 🌌)</button>
        </div>
        <div class="talent-node">
          <div><b>🛡 Оверхил в щит</b><br><span style="color:var(--text-muted);">Превращает избыток исцеления в Щит</span><br><span id="vp-lvl-overheal" style="color:#ec4899;">0/10</span></div>
          <button class="btn btn-sm btn-rune" onclick="upgradeVoidPerk('overheal')">+1 (1 🌌)</button>
        </div>
        <div class="talent-node">
          <div><b>⚡ Эхо Пустоты</b><br><span style="color:var(--text-muted);">Шанс мгновенно дублировать скил</span><br><span id="vp-lvl-echo" style="color:#ec4899;">0/10</span></div>
          <button class="btn btn-sm btn-rune" onclick="upgradeVoidPerk('echo')">+1 (1 🌌)</button>
        </div>
        <div class="talent-node">
          <div><b>🗡 Чистый Разлом</b><br><span style="color:var(--text-muted);">Игнорирует % истинной брони</span><br><span id="vp-lvl-truepierce" style="color:#ec4899;">0/10</span></div>
          <button class="btn btn-sm btn-rune" onclick="upgradeVoidPerk('truepierce')">+1 (1 🌌)</button>
        </div>
      </div>
    </div>

    <!-- НОВАЯ МЕХАНИКА: ГРИМУАР НАСЛЕДИЯ ПУСТОТЫ -->
    <div class="gear-card" style="border: 1px solid #38bdf8; background: rgba(56, 189, 248, 0.08); margin-bottom: 8px;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:3px;">
        <b style="font-size:11px; color:#fff;">📜 ГРИМУАР НАСЛЕДИЯ ПУСТОТЫ (Печати Престижа)</b>
        <span style="font-size:9px; color:#38bdf8; font-weight:bold;">Печати: <span id="heritage-seals-cnt">0/5</span></span>
      </div>
      <div class="desc-text" style="margin-bottom:6px;">
        Печати открываются автоматически при достижении определённых рангов Возвышения и действуют ПОСТОЯННО!
      </div>
      <div style="display:flex; flex-direction:column; gap:4px;">
        <div class="talent-node">
          <div>
            <b>1. Связь Времен (Ур. 1+)</b><br>
            <span style="color:var(--text-muted);">Слот, полностью игнорирующий требования уровня:</span>
            <select id="heritage-slot-select" onchange="setHeritageSlot(this.value)" style="margin:2px 0 0; font-size:9px; padding:2px; background:var(--bg-panel); border:1px solid var(--border); color:#fff; border-radius:3px;">
              <option value="weapon">⚔ Оружие</option>
              <option value="armor">🛡 Доспех</option>
              <option value="helm">🪖 Шлем</option>
              <option value="boots">🥾 Сапоги</option>
              <option value="amulet">📿 Амулет</option>
              <option value="ring">💍 Кольцо</option>
              <option value="belt">🥋 Пояс</option>
              <option value="cloak">🧥 Плащ</option>
              <option value="bracers">🥊 Наручи</option>
              <option value="relic">🔮 Реликвия</option>
            </select>
          </div>
          <span class="quest-badge" id="heritage-badge-1">ЗАКРЫТО</span>
        </div>
        <div class="talent-node">
          <div><b>2. Авто-Эликсир (Ур. 2+)</b><br><span style="color:var(--text-muted);">Автоматически пьёт настойку здоровья при HP &lt; 30%</span></div>
          <span class="quest-badge" id="heritage-badge-2">ЗАКРЫТО</span>
        </div>
        <div class="talent-node">
          <div><b>3. Жатва Аномалий (Ур. 3+)</b><br><span style="color:var(--text-muted);">+100% Золота и Опыта за убийство элитных мутантов</span></div>
          <span class="quest-badge" id="heritage-badge-3">ЗАКРЫТО</span>
        </div>
        <div class="talent-node">
          <div><b>4. Казнь Бездны (Ур. 4+)</b><br><span style="color:var(--text-muted);">15% шанс мгновенно выбить обычного врага в Сверхзамахе</span></div>
          <span class="quest-badge" id="heritage-badge-4">ЗАКРЫТО</span>
        </div>
        <div class="talent-node">
          <div><b>5. Эфирный Щит (Ур. 5+)</b><br><span style="color:var(--text-muted);">Каждый бой начинается со щитом, равным 100% от Max HP</span></div>
          <span class="quest-badge" id="heritage-badge-5">ЗАКРЫТО</span>
        </div>
      </div>
    </div>

    <div class="gear-card" style="border: 1px solid #c084fc; background: rgba(192, 132, 252, 0.08); margin-bottom: 8px;">
      <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:3px;">
        <b style="font-size:11px; color:#fff;">⚛️ МАТРИЦА СИНГУЛЯРНОСТИ</b>
        <span style="font-size:9px; color:#c084fc; font-weight:bold;">⚛️ <span id="matrix-matter-val">0</span> Материи</span>
      </div>
      <div class="desc-text" style="margin-bottom:4px;">Добывается с аномальных монстров. Позволяет усиливать атаки и снижать кд замаха.</div>
      <div style="display:grid; grid-template-columns: 1fr 1fr; gap:5px;">
        <div class="talent-node">
          <div><b>🌌 Плотность (+8% Урон/Пробой)</b><br><span id="dm-lvl-damage" style="color:#c084fc;">0/20</span></div>
          <button class="btn btn-sm btn-rune" onclick="upgradeMatrixPerk('damage')">+1 (5 ⚛️)</button>
        </div>
        <div class="talent-node">
          <div><b>⚡ Грави-Замах (-5% Мин. КД)</b><br><span id="dm-lvl-charge" style="color:#c084fc;">0/20</span></div>
          <button class="btn btn-sm btn-rune" onclick="upgradeMatrixPerk('charge')">+1 (5 ⚛️)</button>
        </div>
      </div>
    </div>

    <h2>
      <span>Базовые Таланты (TP: <b style="color:#38bdf8;" id="tree-tp-val">0</b>)</span>
      <button class="btn btn-sm btn-danger" onclick="resetTalents()">Сброс (100 Зл.)</button>
    </h2>

    <div class="tree-container">
      <div class="tree-branch">
        <h4>⚔ Ярость</h4>
        <div class="talent-node"><div><b>Сила</b> (+5 Атк)<br><span id="t-lvl-atk">0/5</span></div><button class="btn btn-sm" onclick="upgradeTalent('atk')">+</button></div>
        <div class="talent-node"><div><b>Пробой</b> (+6 Брони)<br><span id="t-lvl-pierce">0/5</span></div><button class="btn btn-sm" onclick="upgradeTalent('pierce')">+</button></div>
        <div class="talent-node"><div><b>Сверхмощь</b> (+25% Overcharge)<br><span id="t-lvl-over">0/5</span></div><button class="btn btn-sm" onclick="upgradeTalent('over')">+</button></div>
      </div>
      <div class="tree-branch">
        <h4>🛡 Стойкость</h4>
        <div class="talent-node"><div><b>Живучесть</b> (+50 HP)<br><span id="t-lvl-hp">0/5</span></div><button class="btn btn-sm" onclick="upgradeTalent('hp')">+</button></div>
        <div class="talent-node"><div><b>Бастион</b> (+6 Защ)<br><span id="t-lvl-def">0/5</span></div><button class="btn btn-sm" onclick="upgradeTalent('def')">+</button></div>
        <div class="talent-node"><div><b>Кровопийца</b> (+2% Вампир)<br><span id="t-lvl-vamp">0/5</span></div><button class="btn btn-sm" onclick="upgradeTalent('vamp')">+</button></div>
      </div>
      <div class="tree-branch">
        <h4>⚡ Пустота</h4>
        <div class="talent-node"><div><b>Ветер</b> (+8% ASPD)<br><span id="t-lvl-aspd">0/5</span></div><button class="btn btn-sm" onclick="upgradeTalent('aspd')">+</button></div>
        <div class="talent-node"><div><b>Точность</b> (+3% Крит)<br><span id="t-lvl-crit">0/5</span></div><button class="btn btn-sm" onclick="upgradeTalent('crit')">+</button></div>
        <div class="talent-node"><div><b>Медитация</b> (-7% КД)<br><span id="t-lvl-cd">0/5</span></div><button class="btn btn-sm" onclick="upgradeTalent('cd')">+</button></div>
      </div>
    </div>

    <h2>Способности Героя (Экипировано: <b id="equipped-skills-count">3/3</b>)</h2>
    <div id="skills-manager-list"></div>
  </div>

  <!-- VIEW: SHOP -->
  <div id="view-shop" class="view">
    <h2>🏪 Лавка Алхимика и Архимага</h2>
    <div style="display:grid; grid-template-columns: 1fr 1fr; gap:6px; margin-bottom:8px;">
      <div class="shop-card" style="border-left-color: #10b981;">
        <div class="item-header"><b>🌿 Настойка HP</b><span style="color:var(--gold);">🪙 30</span></div>
        <div class="desc-text">Восстанавливает 50% от максимального здоровья в бою.</div>
        <button class="btn btn-sm btn-heal" style="margin-top:4px;" onclick="buyPotion(1, 30)">Купить 1 шт.</button>
      </div>
      <div class="shop-card" style="border-left-color: #10b981;">
        <div class="item-header"><b>🌿 Набор Настоек (5 шт)</b><span style="color:var(--gold);">🪙 135</span></div>
        <div class="desc-text">Выгодная упаковка лечебных настоек со скидкой.</div>
        <button class="btn btn-sm btn-heal" style="margin-top:4px;" onclick="buyPotion(5, 135)">Купить пак</button>
      </div>
