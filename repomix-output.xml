          <div id="obs-thought" class="obs-stat" style="color: #fff; font-style: italic;">МЫСЛИ: -</div>
          <div id="obs-goal" class="obs-stat">ЦЕЛЬ: -</div>
          <div id="obs-influence" class="obs-stat">ВЛИЯНИЕ: 0</div>
          <div id="obs-tactic" class="obs-stat">ТАКТИКА: -</div>
          <div id="obs-weather" class="obs-stat">ПОГОДА: ЯСНО</div>
          <div id="obs-anomaly" class="obs-stat">АНОМАЛИЯ: НЕТ</div>
        </div>
      </div>

      <!-- Game Over -->
      <div id="gameover-screen" class="screen hidden">
        <h1 class="red-glow">КРИТИЧЕСКИЙ СБОЙ</h1>
        <p id="go-reason" style="color: #ff3333; margin-bottom: 20px; font-size: 1.2rem; text-transform: uppercase; text-shadow: 0 0 5px #f00;">ПРИЧИНА: НЕИЗВЕСТНО</p>
        <div class="final-stats">
          <p>СЧЕТ: <span id="go-score">0</span></p>
          <p>СОБРАНО ОСКОЛКОВ: <span id="go-currency" class="text-purple">0</span></p>
          <p>СОБРАНО ЯДЕР: <span id="go-cores" class="text-gold">0</span></p>
        </div>
        <div id="go-loot-list" class="loot-list" style="margin-bottom: 20px; max-height: 150px; overflow-y: auto; width: 100%; text-align: center; font-size: 0.8rem; color: #aaa;"></div>
        <button id="btn-restart" class="btn-primary">ПЕРЕЗАГРУЗКА</button>
        
        <!-- High Score Input -->
        <div id="highscore-input" class="highscore-input hidden">
            <p class="text-gold blink">НОВЫЙ РЕКОРД!</p>
            <input type="text" id="player-name-input" placeholder="NAME (A-Z)" maxlength="6" />
            <button id="btn-submit-score" class="btn-small">СОХРАНИТЬ</button>
        </div>

        <button id="btn-menu" class="btn-secondary">В ГЛАВНОЕ МЕНЮ</button>
      </div>

      <!-- Confirmation Modal -->
      <div id="modal-confirm" class="modal-overlay hidden">
        <div class="modal-box" style="width: 500px;">
